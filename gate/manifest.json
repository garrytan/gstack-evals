{
  "schema": 1,
  "stages": {
    "m0": [
      {
        "id": "typecheck",
        "kind": "command",
        "run": "bun run typecheck"
      },
      {
        "id": "unit",
        "kind": "command",
        "run": "bun test"
      },
      {
        "id": "wiki",
        "kind": "command",
        "run": "bun run wiki:check"
      },
      {
        "id": "errors-doc",
        "kind": "command",
        "run": "bun run errors:check"
      },
      {
        "id": "sealed",
        "kind": "command",
        "run": "gstack-pregate sealed --range \"$GATE_BASE..$GATE_HEAD\" --base \"$GATE_DEFAULT_BRANCH\" | tee /dev/stderr | grep -Eq \"^SEALED[:] clear .*policy=origin/$GATE_DEFAULT_BRANCH( |\\$)\""
      },
      {
        "id": "hygiene",
        "kind": "junit",
        "run": "bun test tests/ci/workflow-hygiene.test.ts --reporter=junit --reporter-outfile=\"$GATE_JUNIT\"",
        "tests": [
          "pins every action to a full commit sha",
          "keeps every token read-only",
          "keeps no credentials in any checkout and uses no cache or workflow_run",
          "runs pull_request_target and allow-unsafe-pr-checkout only in sealed.yml",
          "runs no merge train while a dispatch runs the head's workflow (GST-254)",
          "names no secret",
          "counts github.token as naming a secret",
          "counts secrets: inherit as naming a secret",
          "installs Bun only by the checksummed download, at one version and digest",
          "fetches gstack at one pinned commit",
          "runs the gate's command cases in ci.yml"
        ]
      }
    ],
    "m1b": [
      {
        "id": "docker-tier",
        "kind": "junit",
        "run": "GSTACK_EVALS_DOCKER=1 bun test ./tests/trial ./tests/adapters ./tests/proxy ./tests/rig ./tests/cli/preflight.test.ts ./tests/cli/doctor.test.ts --reporter=junit --reporter-outfile=\"$GATE_JUNIT\"",
        "tests": [
          "tests/trial/network.test.ts",
          "tests/trial/grader.test.ts",
          "tests/trial/image.test.ts",
          "tests/trial/foundations.test.ts",
          "tests/trial/env.test.ts",
          "tests/trial/recipe.test.ts",
          "tests/trial/lock-commit.test.ts",
          "tests/adapters/claude-code.test.ts",
          "tests/adapters/codex.test.ts",
          "tests/adapters/run-host.test.ts",
          "tests/adapters/pins.test.ts",
          "tests/proxy/metering-proxy.test.ts",
          "tests/cli/preflight.test.ts",
          "tests/cli/doctor.test.ts",
          "tests/rig/admission.test.ts",
          "tests/rig/entry.test.ts",
          "tests/rig/pins.test.ts",
          "tests/rig/rig-probes.test.ts",
          "tests/rig/tier.test.ts",
          "tests/trial/review/ceo-enforced.test.ts",
          "tests/trial/review/ceo-enforced-armed.test.ts"
        ]
      }
    ]
  },
  "gate_surface": [
    ".github/workflows/**",
    "gate/**",
    "scripts/gate.ts",
    "tests/ci/**",
    ".gstack/**",
    "package.json"
  ]
}
