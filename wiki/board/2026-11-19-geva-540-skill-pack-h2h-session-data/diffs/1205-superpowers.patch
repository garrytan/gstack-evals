@@ -0,0 +1,35 @@
+package echo
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/fstest"
+)
+
+func TestStaticFS_EncodedSlashDoesNotBypassRoute(t *testing.T) {
+	e := New()
+	e.GET("/admin/*", func(c *Context) error { return c.String(http.StatusForbidden, "forbidden") })
+	e.StaticFS("/", fstest.MapFS{
+		"admin/secret.txt": {Data: []byte("secret")},
+		"public.txt":       {Data: []byte("public")},
+	})
+
+	for _, tc := range []struct {
+		url  string
+		code int
+	}{
+		{"/admin/secret.txt", http.StatusForbidden},
+		{"/admin%2Fsecret.txt", http.StatusNotFound},
+		{"/admin%2fsecret.txt", http.StatusNotFound},
+		{"/admin%5Csecret.txt", http.StatusNotFound},
+		{"/public.txt", http.StatusOK},
+	} {
+		req := httptest.NewRequest(http.MethodGet, tc.url, nil)
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		if rec.Code != tc.code {
+			t.Errorf("%s: expected %d, got %d (%s)", tc.url, tc.code, rec.Code, rec.Body.String())
+		}
+	}
+}
