diff --git a/middleware/static_encoded_slash_test.go b/middleware/static_encoded_slash_test.go
new file mode 100644
index 0000000..727c82e
--- /dev/null
+++ b/middleware/static_encoded_slash_test.go
@@ -0,0 +1,29 @@
+package middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/fstest"
+
+	"github.com/labstack/echo/v5"
+)
+
+func TestStatic_EncodedSlashDoesNotBypassRoute(t *testing.T) {
+	e := echo.New()
+	e.Filesystem = fstest.MapFS{"admin/secret.txt": {Data: []byte("secret")}, "public.txt": {Data: []byte("public")}}
+	e.Use(StaticWithConfig(StaticConfig{Root: "."}))
+	e.GET("/admin/*", func(c *echo.Context) error { return c.String(http.StatusForbidden, "forbidden") })
+
+	for url, code := range map[string]int{
+		"/admin%2Fsecret.txt": http.StatusNotFound,
+		"/admin%5csecret.txt": http.StatusNotFound,
+		"/public.txt":         http.StatusOK,
+	} {
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, url, nil))
+		if rec.Code != code || rec.Body.String() == "secret" {
+			t.Errorf("%s: expected %d, got %d (%s)", url, code, rec.Code, rec.Body.String())
+		}
+	}
+}
