diff --git a/Tests/UnitTestsParallelizable/ViewBase/Draw/SubViewOnlyRedrawTests.cs b/Tests/UnitTestsParallelizable/ViewBase/Draw/SubViewOnlyRedrawTests.cs
new file mode 100644
index 0000000..e9f036c
--- /dev/null
+++ b/Tests/UnitTestsParallelizable/ViewBase/Draw/SubViewOnlyRedrawTests.cs
@@ -0,0 +1,318 @@
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     Regression tests: a SubView-only redraw request (<see cref="View.SubViewNeedsDraw"/>) must not escalate into a
+///     full redraw (clear viewport, text, content) of the SuperView.
+/// </summary>
+[Trait ("Category", "Output")]
+public class SubViewOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    private sealed class Counts
+    {
+        public int Cleared;
+        public int Text;
+        public int Content;
+
+        public void Reset () => Cleared = Text = Content = 0;
+    }
+
+    private static Counts Track (View view)
+    {
+        Counts c = new ();
+        view.ClearedViewport += (_, _) => c.Cleared++;
+        view.DrawingText += (_, _) => c.Text++;
+        view.DrawingContent += (_, _) => c.Content++;
+
+        return c;
+    }
+
+    /// <summary>Mimics an application iteration: reset the clip to the screen and draw the top view.</summary>
+    private static void Redraw (View top)
+    {
+        top.Layout ();
+        top.Driver!.Clip = new Region (top.Driver.Screen);
+        View.Draw ([top], false);
+    }
+
+    private static string Snapshot (IDriver driver)
+    {
+        Cell [,] contents = driver.Contents!;
+        System.Text.StringBuilder sb = new ();
+
+        for (var r = 0; r < contents.GetLength (0); r++)
+        {
+            for (var c = 0; c < contents.GetLength (1); c++)
+            {
+                sb.Append (contents [r, c].Grapheme);
+                sb.Append (contents [r, c].Attribute?.ToString ());
+            }
+
+            sb.AppendLine ();
+        }
+
+        return sb.ToString ();
+    }
+
+    [Theory]
+    [InlineData (false)]
+    [InlineData (true)]
+    public void ChildOnlyDirty_Parent_Does_Not_Clear_Or_Redraw_Text_Or_Content (bool parentHasBorder)
+    {
+        IDriver driver = CreateTestDriver (20, 10);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "Parent" };
+
+        if (parentHasBorder)
+        {
+            parent.BorderStyle = LineStyle.Single;
+        }
+
+        View child1 = new () { X = 1, Y = 1, Width = 5, Height = 1, Text = "one" };
+        View child2 = new () { X = 1, Y = 3, Width = 5, Height = 1, Text = "two" };
+        parent.Add (child1, child2);
+
+        Counts parentCounts = Track (parent);
+        Counts child1Counts = Track (child1);
+        Counts child2Counts = Track (child2);
+
+        Redraw (parent);
+        Assert.Equal (1, parentCounts.Cleared);
+        Assert.False (parent.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+
+        parentCounts.Reset ();
+        child1Counts.Reset ();
+        child2Counts.Reset ();
+
+        child1.SetNeedsDraw ();
+        Assert.False (parent.NeedsDraw);
+        Assert.True (parent.SubViewNeedsDraw);
+
+        Redraw (parent);
+
+        Assert.Equal (0, parentCounts.Cleared);
+        Assert.Equal (0, parentCounts.Text);
+        Assert.Equal (0, parentCounts.Content);
+        Assert.Equal (1, child1Counts.Cleared);
+        Assert.Equal (1, child1Counts.Text);
+        Assert.Equal (0, child2Counts.Cleared);
+        Assert.Equal (0, child2Counts.Text);
+        Assert.False (parent.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+        Assert.False (child1.NeedsDraw);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ParentDirty_Still_Clears_And_Redraws ()
+    {
+        IDriver driver = CreateTestDriver (20, 10);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "Parent" };
+        View child = new () { X = 1, Y = 1, Width = 5, Height = 1, Text = "one" };
+        parent.Add (child);
+        Counts parentCounts = Track (parent);
+        Counts childCounts = Track (child);
+
+        Redraw (parent);
+        parentCounts.Reset ();
+        childCounts.Reset ();
+
+        parent.SetNeedsDraw ();
+        Redraw (parent);
+
+        Assert.Equal (1, parentCounts.Cleared);
+        Assert.Equal (1, parentCounts.Text);
+        Assert.Equal (1, parentCounts.Content);
+        Assert.Equal (1, childCounts.Cleared);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnlyDirty_Rendered_Output_Is_Correct ()
+    {
+        IDriver driver = CreateTestDriver (12, 3);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "PPPPPPPPPPPP" };
+        View child = new () { X = 2, Y = 1, Width = 5, Height = 1, Text = "abcde" };
+        parent.Add (child);
+
+        Redraw (parent);
+
+        child.Text = "xy";
+        Redraw (parent);
+
+        DriverAssert.AssertDriverContentsAre (
+                                              """
+                                              PPPPPPPPPPPP
+                                                xy
+                                              """,
+                                              output,
+                                              driver);
+
+        // Validate at the IOutput level as well (not only Driver.Contents)
+        IOutput o = driver.GetOutput ();
+        o.Write (driver.GetOutputBuffer ());
+        string ansi = o.GetLastOutput ();
+        Assert.Contains ("xy", ansi);
+        Assert.DoesNotContain ("abcde", ansi);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Transparent_Child_Dirty_Forces_Parent_Redraw_So_No_Stale_Glyphs ()
+    {
+        IDriver driver = CreateTestDriver (12, 3);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "PPPPPPPPPPPP" };
+        View child = new ()
+        {
+            X = 0, Y = 0, Width = 6, Height = 1, Text = "abcdef",
+            ViewportSettings = ViewportSettingsFlags.Transparent
+        };
+        parent.Add (child);
+        Counts parentCounts = Track (parent);
+
+        Redraw (parent);
+        parentCounts.Reset ();
+
+        child.Text = "xy";
+        Redraw (parent);
+
+        // The parent must redraw beneath the transparent child to erase "cdef".
+        Assert.Equal (1, parentCounts.Cleared);
+
+        DriverAssert.AssertDriverContentsAre ("xyPPPPPPPPPP", output, driver);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Shadowed_Child_Redraw_Renders_Same_As_Full_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "PPPPPPPPPPPPPPPPPPPP" };
+        View child = new () { X = 1, Y = 1, Width = 8, Height = 3, Text = "child", ShadowStyle = ShadowStyles.Opaque, BorderStyle = LineStyle.Single };
+        parent.Add (child);
+
+        Redraw (parent);
+        string full = Snapshot (driver);
+
+        child.SetNeedsDraw ();
+        Redraw (parent);
+        string partial = Snapshot (driver);
+
+        Assert.Equal (full, partial);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Overlapped_Tabs_ActiveTabScroll_Does_Not_Redraw_Inactive_Pages ()
+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill () };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [3];
+        Counts [] counts = new Counts [3];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            pages [i] = new View
+            {
+                Title = $"Tab{i}",
+                CanFocus = true,
+                Width = Dim.Fill (),
+                Height = Dim.Fill (),
+                Text = string.Join ('\n', Enumerable.Range (0, 40).Select (n => $"Tab{i} line {n}"))
+            };
+            pages [i].SetContentSize (new Size (30, 40));
+            tabs.Add (pages [i]);
+            counts [i] = Track (pages [i]);
+        }
+
+        Counts tabsCounts = Track (tabs);
+
+        Redraw (root);
+
+        View active = (View)tabs.Value!;
+        Assert.Same (pages [0], active);
+
+        foreach (Counts c in counts)
+        {
+            c.Reset ();
+        }
+
+        tabsCounts.Reset ();
+
+        for (var y = 1; y <= 3; y++)
+        {
+            active.Viewport = active.Viewport with { Y = y };
+            Redraw (root);
+        }
+
+        Assert.Equal (3, counts [0].Cleared);
+        Assert.Equal (3, counts [0].Text);
+
+        for (var i = 1; i < pages.Length; i++)
+        {
+            Assert.Equal (0, counts [i].Cleared);
+            Assert.Equal (0, counts [i].Text);
+            Assert.Equal (0, counts [i].Content);
+        }
+
+        Assert.Equal (0, tabsCounts.Cleared);
+        Assert.Equal (0, tabsCounts.Content);
+
+        // Rendering is correct: active tab content visible at the scrolled position.
+        IOutput o = driver.GetOutput ();
+        o.Write (driver.GetOutputBuffer ());
+        Assert.Contains ("Tab0 line 3", o.GetLastOutput ());
+        Assert.DoesNotContain ("Tab1 line", o.GetLastOutput ());
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Tab_Title_Change_With_Transparent_Border_Renders_Same_As_Full_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (40, 8);
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill () };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [3];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            pages [i] = new View { Title = $"LongTabTitle{i}", CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill (), Text = $"Page {i}" };
+            tabs.Add (pages [i]);
+        }
+
+        Redraw (root);
+
+        pages [0].Title = "A";
+        pages [1].Title = "B";
+        Redraw (root);
+        string partial = Snapshot (driver);
+
+        root.SetNeedsDraw ();
+        Redraw (root);
+        string full = Snapshot (driver);
+
+        Assert.Equal (full, partial);
+        Assert.DoesNotContain ("LongTabTitle0", partial);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+}
