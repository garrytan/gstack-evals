+    /// <summary>
+    ///     If this View's <see cref="Border"/> is transparent, its content changing (e.g. Title or tab header layout)
+    ///     exposes cells owned by the SuperView, so the SuperView must redraw beneath it.
+    /// </summary>
+    internal void SetSuperViewNeedsDrawIfTransparentBorder ()
+    {
+        if (Border.Thickness != Thickness.Empty && Border.ViewportSettings.FastHasFlags (ViewportSettingsFlags.Transparent))
+        {
+            SuperView?.SetNeedsDraw ();
+        }
+    }
+
+    /// <summary>
+    ///     Returns <see langword="true"/> if any visible, dirty SubView has transparency (in its Viewport or any of its
+    ///     adornments). Such SubViews do not fully repaint the cells they cover, so the SuperView must clear and redraw
+    ///     its own content underneath them; otherwise stale glyphs would remain visible through the transparent areas.
+    /// </summary>
+    private bool SubViewRequiresSuperViewRedraw ()
+    {
+        if (!SubViewNeedsDraw)
+        {
+            return false;
+        }
+
+        foreach (View subview in InternalSubViews)
+        {
+            if (!subview.Visible || (!subview.NeedsDraw && !subview.SubViewNeedsDraw))
+            {
+                continue;
+            }
+
+            // NOTE: A transparent Border (e.g. Tab-mode borders) is intentionally NOT considered here. Its glyphs only
+            // change when the Title or the Border's layout changes, and those paths invalidate the SuperView directly
+            // (see Title setter and SetSuperViewNeedsDrawIfTransparentBorder). Including it would cause every redraw of
+            // a Tab page to fully redraw the Tabs container and all other (overlapped) pages.
+            if (subview.ViewportSettings.FastHasFlags (ViewportSettingsFlags.Transparent)
+                || IsTransparentAdornment (subview.Margin)
+                || IsTransparentAdornment (subview.Padding))
+            {
+                return true;
+            }
+        }
+
+        return false;
+
+        // Margin is Transparent by default; only adornments that actually occupy cells matter.
+        static bool IsTransparentAdornment (AdornmentImpl adornment) =>
+            adornment.Thickness != Thickness.Empty && adornment.ViewportSettings.FastHasFlags (ViewportSettingsFlags.Transparent);
+    }
