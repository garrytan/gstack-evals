diff --git a/db/Role.go b/db/Role.go
index a322acc..4204dfb 100644
--- a/db/Role.go
+++ b/db/Role.go
@@ -1,5 +1,7 @@
 package db
 
+import "strings"
+
 type Role struct {
 	Slug        string                `db:"slug" json:"slug" backup:"-"`
 	Name        string                `db:"name" json:"name"`
@@ -11,6 +13,30 @@ func ValidateRole(role Role) error {
 	if role.Name == "" {
 		return &ValidationError{Message: "Role name cannot be empty"}
 	}
+	if strings.TrimSpace(role.Slug) == "" {
+		return &ValidationError{Message: "Role slug cannot be empty"}
+	}
+	if IsReservedRoleSlug(role.Slug) {
+		return &ValidationError{Message: "Role slug is reserved for a built-in role"}
+	}
+	if role.Permissions < 0 || role.Permissions&^AllProjectPermissions != 0 {
+		return &ValidationError{Message: "Role permissions contain unknown bits"}
+	}
+	return nil
+}
+
+// IsReservedRoleSlug reports whether slug collides with a built-in project role.
+func IsReservedRoleSlug(slug string) bool {
+	normalized := ProjectUserRole(strings.ToLower(strings.TrimSpace(slug)))
+	return normalized == ProjectNone || normalized.IsValid()
+}
+
+// ValidateRolePermissionCeiling ensures a caller cannot create or update a role
+// granting permissions the caller does not hold themselves.
+func ValidateRolePermissionCeiling(role Role, callerPermissions ProjectUserPermission) error {
+	if role.Permissions&^callerPermissions != 0 {
+		return &ValidationError{Message: "Cannot grant permissions you do not have"}
+	}
 	return nil
 }
 
diff --git a/db/Role_test.go b/db/Role_test.go
new file mode 100644
index 0000000..c58cf4a
--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,33 @@
+package db
+
+import "testing"
+
+func TestValidateRole_RejectsReservedSlugs(t *testing.T) {
+	for _, slug := range []string{"owner", "manager", "task_runner", "guest", "Manager", " owner ", ""} {
+		if err := ValidateRole(Role{Slug: slug, Name: "x", Permissions: 1}); err == nil {
+			t.Errorf("expected slug %q to be rejected", slug)
+		}
+	}
+}
+
+func TestValidateRole_RejectsUnknownPermissionBits(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: 16}); err == nil {
+		t.Error("expected unknown bits to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: -1}); err == nil {
+		t.Error("expected negative permissions to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: AllProjectPermissions}); err != nil {
+		t.Errorf("unexpected error: %v", err)
+	}
+}
+
+func TestValidateRolePermissionCeiling(t *testing.T) {
+	mgr := ProjectManager.GetPermissions()
+	if err := ValidateRolePermissionCeiling(Role{Permissions: AllProjectPermissions}, mgr); err == nil {
+		t.Error("manager must not grant owner-only permissions")
+	}
+	if err := ValidateRolePermissionCeiling(Role{Permissions: mgr}, mgr); err != nil {
+		t.Errorf("unexpected error: %v", err)
+	}
+}
