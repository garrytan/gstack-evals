diff --git a/db/bolt/role_test.go b/db/bolt/role_test.go
new file mode 100644
index 0000000..7e2a99b
--- /dev/null
+++ b/db/bolt/role_test.go
@@ -0,0 +1,25 @@
+package bolt
+
+import (
+	"testing"
+
+	"github.com/semaphoreui/semaphore/db"
+)
+
+func TestGetProjectOrGlobalRoleBySlug_IgnoresOtherProjects(t *testing.T) {
+	store := CreateTestStore()
+	other := 2
+	_, err := store.CreateRole(db.Role{Slug: "custom", Name: "x", Permissions: db.AllProjectPermissions, ProjectID: &other})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if _, err = store.GetProjectOrGlobalRoleBySlug(1, "custom"); err != db.ErrNotFound {
+		t.Fatalf("expected ErrNotFound, got %v", err)
+	}
+
+	role, err := store.GetProjectOrGlobalRoleBySlug(2, "custom")
+	if err != nil || role.Permissions != db.AllProjectPermissions {
+		t.Fatalf("expected project role, got %v %v", role, err)
+	}
+}
