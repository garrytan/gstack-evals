 }
 
+TEST_F(LibraryTest, ParseSrvReplyCompressedTarget) {
+  /* RFC 2782: name compression must not be used for the SRV TARGET */
+  std::vector<byte> data = {
+    0x12, 0x34,  // qid
+    0x84, // response + query + AA + not-TC + not-RD
+    0x00, // not-RA + not-Z + not-AD + not-CD + rc=NoError
+    0x00, 0x01,  // num questions
+    0x00, 0x01,  // num answer RRs
+    0x00, 0x00,  // num authority RRs
+    0x00, 0x00,  // num additional RRs
+    // Question
+    0x07, 'e', 'x', 'a', 'm', 'p', 'l', 'e',
+    0x03, 'c', 'o', 'm',
+    0x00,
+    0x00, 0x21,  // type SRV
+    0x00, 0x01,  // class IN
+    // Answer 1
+    0xC0, 0x0C,  // name pointer to question
+    0x00, 0x21,  // RR type
+    0x00, 0x01,  // class IN
+    0x01, 0x02, 0x03, 0x04, // TTL
+    0x00, 0x08,  // rdata length
+    0x00, 0x0A,  // priority
+    0x00, 0x14,  // weight
+    0x00, 0x1E,  // port
+    0xC0, 0x0C,  // target: compression pointer -- prohibited
+  };
+
+  struct ares_srv_reply* srv = nullptr;
+  EXPECT_NE(ARES_SUCCESS, ares_parse_srv_reply(data.data(), (int)data.size(), &srv));
+  ASSERT_EQ(nullptr, srv);
+
+  ares_dns_record_t *dnsrec = nullptr;
+  EXPECT_NE(ARES_SUCCESS, ares_dns_parse(data.data(), data.size(), 0, &dnsrec));
+  EXPECT_EQ(nullptr, dnsrec);
+}
+
