                 SubViews.ElementAt (i).Width = Dim.Auto ();
             }
         }
+
+        // Dim.Auto (DimAutoStyle.Content) sizes this view using the Frames of the Pos.Align'd SubViews
+        // (see PosAlign.CalculateMinDimension). Newly created SubViews (e.g. when Labels/Values are set after
+        // construction) or SubViews whose Margin/Width just changed have stale Frames, so refresh them now
+        // and ensure this view (and its SuperView) re-layout.
+        Size layoutSize = App?.Screen.Size ?? new Size (2048, 2048);
+
+        foreach (View subView in SubViews)
+        {
+            subView.SetRelativeLayout (layoutSize);
+        }
+
+        SetNeedsLayout ();
     }
 
