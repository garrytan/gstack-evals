+    // Issue: Dim.Auto width not recalculated when Labels/Values set after construction
+    [Theory]
+    [InlineData (false)]
+    [InlineData (true)]
+    public void Horizontal_Labels_And_Values_Set_After_Construction_Width_Fits_All_Labels (bool setValuesFirst)
+    {
+        View superView = new () { Width = 80, Height = 10 };
+
+        OptionSelector selector = new () { Y = 2, Orientation = Orientation.Horizontal };
+
+        if (setValuesFirst)
+        {
+            selector.Values = [0, 1];
+            selector.Labels = ["IMDb (Recommended)", "TMDb"];
+        }
+        else
+        {
+            selector.Labels = ["IMDb (Recommended)", "TMDb"];
+            selector.Values = [0, 1];
+        }
+
+        superView.Add (selector);
+        superView.Layout ();
+
+        List<CheckBox> checkBoxes = selector.SubViews.OfType<CheckBox> ().ToList ();
+        Assert.Equal (2, checkBoxes.Count);
+
+        // Each checkbox is fully sized: glyph + space + text (+ right margin for all but the last)
+        Assert.Equal ("IMDb (Recommended)".Length + 2 + 2, checkBoxes [0].Frame.Width);
+        Assert.Equal ("TMDb".Length + 2, checkBoxes [1].Frame.Width);
+
+        // The selector must be wide enough to show the last checkbox in full
+        Assert.Equal (checkBoxes [1].Frame.Right, selector.Viewport.Width);
+        Assert.Equal (("IMDb (Recommended)".Length + 2) + 2 + ("TMDb".Length + 2), selector.Frame.Width);
+
+        superView.Dispose ();
+    }
+
