+++ b/packages/svelte/tests/runtime-runes/samples/async-const-destructure-if-blockers/_config.js
@@ -0,0 +1,12 @@
+import { tick } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	mode: ['async-server', 'client', 'hydrate'],
+	ssrHtml: '<p>The Data: x</p> <p>flag</p> <p>late</p>',
+
+	async test({ assert, target }) {
+		await tick();
+		assert.htmlEqual(target.innerHTML, '<p>The Data: x</p> <p>flag</p> <p>late</p>');
+	}
+});
diff --git a/packages/svelte/tests/runtime-runes/samples/async-const-destructure-if-blockers/main.svelte b/packages/svelte/tests/runtime-runes/samples/async-const-destructure-if-blockers/main.svelte
new file mode 100644
index 0000000..9263e9d
--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/async-const-destructure-if-blockers/main.svelte
@@ -0,0 +1,37 @@
+<script>
+	let d = $derived(await Promise.resolve({ data: 'x', hasData: true }));
+	let showFetchCta = $derived(d.hasData);
+	let e = $derived(await Promise.resolve({ flag: true }));
+</script>
+
+{#if d}
+	{@const { data, hasData } = d}
+
+	{#if hasData}
+		<p>The Data: {data}</p>
+	{:else if showFetchCta}
+		<p>Fetch now</p>
+	{:else}
+		<p>No data</p>
+	{/if}
+{/if}
+
+{#if e}
+	{@const { flag } = e}
+
+	{#if !showFetchCta}
+		<p>no</p>
+	{:else if flag}
+		<p>flag</p>
+	{/if}
+{/if}
+
+{#if e}
+	{@const late = await Promise.resolve(true)}
+
+	{#if !showFetchCta}
+		<p>no</p>
+	{:else if late}
+		<p>late</p>
+	{/if}
+{/if}
