diff --git a/db/Role.go b/db/Role.go
index a322acc..43c6fa6 100644
--- a/db/Role.go
+++ b/db/Role.go
@@ -11,6 +11,15 @@ func ValidateRole(role Role) error {
 	if role.Name == "" {
 		return &ValidationError{Message: "Role name cannot be empty"}
 	}
+	if role.Slug == "" {
+		return &ValidationError{Message: "Role slug cannot be empty"}
+	}
+	if ProjectUserRole(role.Slug).IsValid() {
+		return &ValidationError{Message: "Role slug is reserved for a built-in role"}
+	}
+	if role.Permissions < 0 || role.Permissions&^AllProjectPermissions != 0 {
+		return &ValidationError{Message: "Role permissions are invalid"}
+	}
 	return nil
 }
 
diff --git a/db/Role_test.go b/db/Role_test.go
new file mode 100644
index 0000000..0c6c7c3
--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,23 @@
+package db
+
+import "testing"
+
+func TestValidateRoleRejectsBuiltInSlugs(t *testing.T) {
+	for _, slug := range []string{"owner", "manager", "task_runner", "guest"} {
+		if err := ValidateRole(Role{Slug: slug, Name: "x", Permissions: 1}); err == nil {
+			t.Fatalf("expected built-in slug %q to be rejected", slug)
+		}
+	}
+}
+
+func TestValidateRoleRejectsUnknownPermissionBits(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: 1 << 10}); err == nil {
+		t.Fatal("expected unknown permission bits to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: -1}); err == nil {
+		t.Fatal("expected negative permissions to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: AllProjectPermissions}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
