@@ -111,8 +111,12 @@ func (a *App) validatedRefererRedirect(r *http.Request, referrer string) (string
 	}
 
 	redirectTarget := refURL.EscapedPath()
-	if redirectTarget == "" {
-		redirectTarget = "/"
+	// Collapse leading slashes/backslashes so the target cannot be interpreted
+	// by browsers as a protocol-relative URL (e.g. "//evil.com" or "/\evil.com")
+	redirectTarget = "/" + strings.TrimLeft(redirectTarget, "/\\")
+	if strings.HasPrefix(strings.ToLower(redirectTarget), "/%5c") || strings.HasPrefix(redirectTarget, "/%2f") ||
+		strings.HasPrefix(redirectTarget, "/%2F") {
+		return "", false
 	}
 	if refURL.RawQuery != "" {
 		redirectTarget += "?" + refURL.RawQuery
