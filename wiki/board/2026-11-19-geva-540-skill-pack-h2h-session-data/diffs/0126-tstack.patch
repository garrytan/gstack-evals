+    #[tokio::test]
+    async fn navigation_invalidates_cleared_isolated_contexts() {
+        // Navigation emits Runtime.executionContextsCleared; isolated-world
+        // context ids minted before it must stop validating (and the set must
+        // stay bounded), while other pages' contexts are untouched.
+        let mut ctx = CdpContext::new();
+        let page_id = ctx.create_page();
+        let session_id = format!("{}-session", page_id);
+        ctx.sessions.insert(session_id.clone(), page_id.clone());
+        let sid = Some(session_id.clone());
+        let other_page = ctx.create_page();
+
+        let created = handle(
+            "createIsolatedWorld",
+            &json!({ "worldName": "utility" }),
+            &mut ctx,
+            &sid,
+        )
+        .await
+        .expect("createIsolatedWorld should succeed");
