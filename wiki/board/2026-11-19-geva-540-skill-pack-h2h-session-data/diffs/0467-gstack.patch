 }
+
+func TestFormatTOMLV110(t *testing.T) {
+	data := []byte("a = {\n  b = 1,\n  c = 2,\n}\nd = \"\\e\\x41\"\n")
+
+	var actualMap map[string]any
+	assert.NoError(t, FormatTOML.Unmarshal(data, &actualMap))
+	assert.Equal(t, map[string]any{
+		"a": map[string]any{
+			"b": int64(1),
+			"c": int64(2),
+		},
+		"d": "\x1bA",
+	}, actualMap)
+
+	var actualAny any
+	assert.NoError(t, FormatTOML.Unmarshal(data, &actualAny))
+	assert.Equal(t, any(actualMap), actualAny)
+
+	type structA struct {
+		B int `toml:"b"`
+		C int `toml:"c"`
+	}
+	var actualStruct struct {
+		A structA `toml:"a"`
+		D string  `toml:"d"`
+	}
+	assert.NoError(t, FormatTOML.Unmarshal(data, &actualStruct))
+	assert.Equal(t, structA{B: 1, C: 2}, actualStruct.A)
+	assert.Equal(t, "\x1bA", actualStruct.D)
+
+	var unknownFieldStruct struct {
+		D string `toml:"d"`
+	}
+	assert.Error(t, FormatTOML.Unmarshal(data, &unknownFieldStruct))
+}
