diff --git a/internal/chezmoi/format.go b/internal/chezmoi/format.go
index 341ac66..258b1d5 100644
--- a/internal/chezmoi/format.go
+++ b/internal/chezmoi/format.go
@@ -10,6 +10,7 @@ import (
 	"slices"
 	"strings"
 
+	burntsushitoml "github.com/BurntSushi/toml"
 	"github.com/goccy/go-yaml"
 	"github.com/pelletier/go-toml/v2"
 	"github.com/tailscale/hujson"
@@ -159,7 +160,33 @@ func (formatTOML) Name() string {
 
 // Unmarshal implements Format.Unmarshal.
 func (formatTOML) Unmarshal(data []byte, value any) error {
-	decoder := toml.NewDecoder(bytes.NewReader(data))
+	// github.com/pelletier/go-toml/v2 only supports TOML v1.0.0, so parse the
+	// document with github.com/BurntSushi/toml, which supports TOML v1.1.0.
+	switch value := value.(type) {
+	case *map[string]any:
+		_, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(value)
+		return err
+	case *any:
+		var m map[string]any
+		if _, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(&m); err != nil {
+			return err
+		}
+		*value = m
+		return nil
+	}
+
+	// For other types, parse the document into a generic value, re-encode it
+	// as TOML v1.0.0, and decode it strictly so that unknown fields are
+	// still reported.
+	var m map[string]any
+	if _, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(&m); err != nil {
+		return err
+	}
+	normalizedData, err := toml.Marshal(m)
+	if err != nil {
+		return err
+	}
+	decoder := toml.NewDecoder(bytes.NewReader(normalizedData))
 	decoder.DisallowUnknownFields()
 	return decoder.Decode(value)
 }
