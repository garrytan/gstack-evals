+	// if a site block without any TLS customizations has hostnames that are
+	// covered by a wildcard in another site block's automation policy that
+	// uses certificate managers (e.g. get_certificate), then those hostnames
+	// must not get their own (default) automation policy, since it would be
+	// chosen over the wildcard policy at handshake-time and the managers would
+	// never be consulted (see issue about get_certificate with wildcards);
+	// names that are forced to be automated keep their own policy
+	if tlsApp.Automation != nil && len(defaultSiteAPs) > 0 {
+		coveredByWildcardWithManagers := func(subj string) bool {
+			for _, other := range tlsApp.Automation.Policies {
+				if _, isDefault := defaultSiteAPs[other]; isDefault || len(other.ManagersRaw) == 0 {
+					continue
+				}
+				for _, otherSubj := range other.SubjectsRaw {
+					if otherSubj != subj && strings.Contains(otherSubj, "*") &&
+						certmagic.MatchWildcard(subj, otherSubj) {
+						return true
+					}
+				}
+			}
+			return false
+		}
+		tlsApp.Automation.Policies = slices.DeleteFunc(tlsApp.Automation.Policies, func(ap *caddytls.AutomationPolicy) bool {
+			if _, ok := defaultSiteAPs[ap]; !ok {
+				return false
+			}
+			ap.SubjectsRaw = slices.DeleteFunc(ap.SubjectsRaw, func(subj string) bool {
+				if _, forced := forcedAutomatedNames[subj]; forced {
+					return false
+				}
+				return coveredByWildcardWithManagers(subj)
+			})
+			// a policy without subjects would become a catch-all, so remove it entirely
+			return len(ap.SubjectsRaw) == 0
+		})
+	}
