diff --git a/tests/libuilogic/SpellCheck/OcrFixReplaceListWithoutDictionaryTests.cs b/tests/libuilogic/SpellCheck/OcrFixReplaceListWithoutDictionaryTests.cs
new file mode 100644
index 0000000..fb050b3
--- /dev/null
+++ b/tests/libuilogic/SpellCheck/OcrFixReplaceListWithoutDictionaryTests.cs
@@ -0,0 +1,57 @@
+using System;
+using System.IO;
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+
+namespace LibUiLogicTests.SpellCheck;
+
+public class OcrFixReplaceListWithoutDictionaryTests
+{
+    private static string CreateFolderWithSpanishReplaceList()
+    {
+        var dir = Path.Combine(Path.GetTempPath(), "se_ocrfix_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(dir);
+        File.WriteAllText(Path.Combine(dir, "spa_OCRFixReplaceList.xml"),
+            "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n" +
+            "<OCRFixReplaceList><WholeWords>\n" +
+            "<!-- comment -->\n" +
+            "<Word from=\"aca\" to=\"acá\" />\n" +
+            "<Word from=\"adios\" to=\"adiós\" />\n" +
+            "<Word from=\"algun\" to=\"algún\" />\n" +
+            "<Word from=\"dia\" to=\"día\" />\n" +
+            "<Word from=\"volvere\" to=\"volveré\" />\n" +
+            "</WholeWords><PartialLines /></OCRFixReplaceList>");
+        return dir;
+    }
+
+    [Fact]
+    public void ReplaceList_IsApplied_WithoutHunspellDictionary_AndKeepsCasing()
+    {
+        var dir = CreateFolderWithSpanishReplaceList();
+        var oldFolder = SpellCheckConfig.DictionariesFolder;
+        try
+        {
+            SpellCheckConfig.DictionariesFolder = () => dir;
+
+            var subtitle = new Subtitle();
+            subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+            subtitle.Paragraphs.Add(new Paragraph("Adios.", 2000, 3000));
+            subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 4000, 5000));
+            subtitle.Paragraphs.Add(new Paragraph("ADIOS.", 6000, 7000));
+
+            IOcrFixEngine engine = new OcrFixEngine(new SpellChecker());
+            engine.Initialize(subtitle, "spa", new SpellCheckDictionaryDisplay());
+
+            Assert.Equal("Hola, acá estoy.", engine.FixOcrErrors(0, subtitle.Paragraphs[0].Text, true).GetText());
+            Assert.Equal("Adiós.", engine.FixOcrErrors(1, subtitle.Paragraphs[1].Text, true).GetText());
+            Assert.Equal("Algún día volveré.", engine.FixOcrErrors(2, subtitle.Paragraphs[2].Text, true).GetText());
+            Assert.Equal("ADIÓS.", engine.FixOcrErrors(3, subtitle.Paragraphs[3].Text, true).GetText());
+        }
+        finally
+        {
+            SpellCheckConfig.DictionariesFolder = oldFolder;
+            Directory.Delete(dir, true);
+        }
+    }
+}
