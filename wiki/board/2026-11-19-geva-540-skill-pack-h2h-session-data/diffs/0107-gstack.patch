+        /// <summary>
+        /// Replace lists are mostly written in lowercase ("adios" => "adiós"), but such words often start
+        /// a sentence ("Adios.") or are written in all caps. Look up the lowercase form and apply the
+        /// casing of the original word to the replacement.
+        /// </summary>
+        private bool TryGetCaseAdjustedReplaceWord(string word, out string result)
+        {
+            result = string.Empty;
+            if (word.Length == 0 || !char.IsUpper(word[0]))
+            {
+                return false;
+            }
+
+            var lower = word.ToLowerInvariant();
+            if (lower == word)
+            {
+                return false;
+            }
+
+            var isAllUpper = word.Length > 1 && word.ToUpperInvariant() == word;
+            var isTitleCase = word.Substring(1) == word.Substring(1).ToLowerInvariant();
+            if (!isAllUpper && !isTitleCase)
+            {
+                return false;
+            }
+
+            if (!WordReplaceList.TryGetValue(lower, out var replacement) || string.IsNullOrEmpty(replacement))
+            {
+                return false;
+            }
+
+            if (isAllUpper)
+            {
+                result = replacement.ToUpperInvariant();
+            }
+            else
+            {
+                result = char.ToUpperInvariant(replacement[0]) + replacement.Substring(1);
+            }
+
+            return result != word;
+        }
