+    static final class BinaryKeyTest extends RowCompactedSerializerTest {
+
+        private static final InternalRow[] SORTED_ROWS =
+                new InternalRow[] {
+                    GenericRow.of(null, 1),
+                    GenericRow.of(new byte[0], 1),
+                    GenericRow.of(new byte[] {0x00}, 1),
+                    GenericRow.of(new byte[] {0x7F}, 1),
+                    GenericRow.of(new byte[] {0x7F, 0x00}, 0),
+                    GenericRow.of(new byte[] {0x7F, 0x00}, 1),
+                    GenericRow.of(new byte[] {(byte) 0x80}, 1),
+                    GenericRow.of(new byte[] {(byte) 0xFF}, 1)
+                };
+
+        public BinaryKeyTest() {
+            super(getRowSerializer(), SORTED_ROWS);
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(RowType.of(DataTypes.VARBINARY(10), DataTypes.INT()));
+        }
+
+        @Test
+        public void testSliceComparatorOrdersBinaryUnsigned() {
+            RowCompactedSerializer serializer = getRowSerializer();
+            Comparator<MemorySlice> comparator = serializer.createSliceComparator();
+            for (int i = 0; i < SORTED_ROWS.length; i++) {
+                for (int j = 0; j < SORTED_ROWS.length; j++) {
+                    MemorySlice left =
+                            MemorySlice.wrap(serializer.serializeToBytes(SORTED_ROWS[i]));
+                    MemorySlice right =
+                            MemorySlice.wrap(serializer.serializeToBytes(SORTED_ROWS[j]));
+                    assertThat(Integer.signum(comparator.compare(left, right)))
+                            .as("compare row %s with row %s", i, j)
+                            .isEqualTo(Integer.compare(i, j));
+                }
+            }
+        }
+    }
