diff --git a/db/bolt/role_test.go b/db/bolt/role_test.go
new file mode 100644
index 0000000..5aaa471
--- /dev/null
+++ b/db/bolt/role_test.go
@@ -0,0 +1,28 @@
+package bolt
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/semaphoreui/semaphore/db"
+)
+
+func TestGetProjectOrGlobalRoleBySlug_Scoped(t *testing.T) {
+	store := CreateTestStore()
+	other := 2
+	if _, err := store.CreateRole(db.Role{Slug: "custom", Name: "c", Permissions: 15, ProjectID: &other}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.GetProjectOrGlobalRoleBySlug(1, "custom"); !errors.Is(err, db.ErrNotFound) {
+		t.Fatalf("role from another project must not be returned, got %v", err)
+	}
+	if _, err := store.GetProjectOrGlobalRoleBySlug(2, "custom"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.CreateRole(db.Role{Slug: "manager", Name: "pwn", Permissions: 15, ProjectID: &other}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.GetProjectOrGlobalRoleBySlug(2, "manager"); !errors.Is(err, db.ErrNotFound) {
+		t.Fatalf("built-in role must not be overridden, got %v", err)
+	}
+}
