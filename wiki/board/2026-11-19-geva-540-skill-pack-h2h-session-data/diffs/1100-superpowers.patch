diff --git a/db/Role.go b/db/Role.go
index a322acc..23fde51 100644
--- a/db/Role.go
+++ b/db/Role.go
@@ -11,6 +11,15 @@ func ValidateRole(role Role) error {
 	if role.Name == "" {
 		return &ValidationError{Message: "Role name cannot be empty"}
 	}
+	if role.Slug == "" {
+		return &ValidationError{Message: "Role slug cannot be empty"}
+	}
+	if ProjectUserRole(role.Slug).IsValid() {
+		return &ValidationError{Message: "Role slug is reserved for a built-in role"}
+	}
+	if role.Permissions&^AllProjectUserPermissions != 0 {
+		return &ValidationError{Message: "Role permissions contain unknown bits"}
+	}
 	return nil
 }
 
diff --git a/db/Role_test.go b/db/Role_test.go
new file mode 100644
index 0000000..408ddab
--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,17 @@
+package db
+
+import "testing"
+
+func TestValidateRole_ReservedSlugs(t *testing.T) {
+	for _, slug := range []string{"owner", "manager", "task_runner", "guest"} {
+		if err := ValidateRole(Role{Slug: slug, Name: "x"}); err == nil {
+			t.Fatalf("slug %q must be rejected", slug)
+		}
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: AllProjectUserPermissions}); err != nil {
+		t.Fatal(err)
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: 1 << 10}); err == nil {
+		t.Fatal("unknown permission bits must be rejected")
+	}
+}
