+++ b/tests/UI/Features/Tools/FixCommonErrors/FixCommonOcrErrorsTests.cs
@@ -0,0 +1,112 @@
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Core.Forms.FixCommonErrors;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+using Nikse.SubtitleEdit.Logic.Config;
+using System;
+using System.IO;
+using System.Text;
+
+namespace UITests.Features.Tools.FixCommonErrors;
+
+// "Fix common OCR errors using OCR replace list" made no corrections with spa_OCRFixReplaceList.xml:
+// the rule silently did nothing when no Hunspell dictionary was installed for the language, and
+// whole-word entries (e.g. "adios") did not match capitalized words ("Adios") at sentence start.
+public class FixCommonOcrErrorsTests : IDisposable
+{
+    private const string SpanishReplaceList =
+        "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n" +
+        "<OCRFixReplaceList>\n" +
+        "  <WholeWords>\n" +
+        "    <Word from=\"aca\" to=\"acá\" />\n" +
+        "    <Word from=\"adios\" to=\"adiós\" />\n" +
+        "    <Word from=\"algun\" to=\"algún\" />\n" +
+        "    <Word from=\"dia\" to=\"día\" />\n" +
+        "    <Word from=\"volvere\" to=\"volveré\" />\n" +
+        "  </WholeWords>\n" +
+        "  <PartialWordsAlways />\n" +
+        "  <PartialWords />\n" +
+        "  <PartialLines />\n" +
+        "  <PartialLinesAlways />\n" +
+        "  <BeginLines />\n" +
+        "  <EndLines />\n" +
+        "  <WholeLines />\n" +
+        "  <RegularExpressions />\n" +
+        "</OCRFixReplaceList>\n";
+
+    private readonly string _originalDictionariesFolder;
+    private readonly Func<string> _originalSpellCheckDictionariesFolder;
+    private readonly IOcrFixEngine? _originalEngine;
+    private readonly string _tempDictionariesFolder;
+
+    public FixCommonOcrErrorsTests()
+    {
+        _originalDictionariesFolder = Se.DictionariesFolder;
+        _originalSpellCheckDictionariesFolder = SpellCheckConfig.DictionariesFolder;
+        _originalEngine = FixCommonOcrErrors.OcrFixEngine;
+        _tempDictionariesFolder = Path.Combine(Path.GetTempPath(), "SeFixOcrTest_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_tempDictionariesFolder);
+        Se.DictionariesFolder = _tempDictionariesFolder;
+        SpellCheckConfig.DictionariesFolder = () => _tempDictionariesFolder;
+        File.WriteAllText(Path.Combine(_tempDictionariesFolder, "spa_OCRFixReplaceList.xml"), SpanishReplaceList, new UTF8Encoding(true));
+    }
+
+    private static Subtitle MakeSubtitle()
+    {
+        var subtitle = new Subtitle();
+        subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 2000));
+        subtitle.Paragraphs.Add(new Paragraph("Adios.", 3000, 5000));
+        subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 6000, 8000));
+        return subtitle;
+    }
+
+    private static void RunFix(Subtitle subtitle)
+    {
+        FixCommonOcrErrors.OcrFixEngine = new OcrFixEngine(new SpellChecker());
+        new FixCommonOcrErrors().Fix(subtitle, new EmptyFixCallback { Language = "es" });
+    }
+
+    private static void AssertFixed(Subtitle subtitle)
+    {
+        Assert.Equal("Hola, acá estoy.", subtitle.Paragraphs[0].Text);
+        Assert.Equal("Adiós.", subtitle.Paragraphs[1].Text);
+        Assert.Equal("Algún día volveré.", subtitle.Paragraphs[2].Text);
+    }
+
+    [Fact]
+    public void AppliesSpanishReplaceList_WhenHunspellDictionaryInstalled()
+    {
+        File.WriteAllText(Path.Combine(_tempDictionariesFolder, "es_ES.dic"), "3\nhola\nestoy\nacá\n");
+        File.WriteAllText(Path.Combine(_tempDictionariesFolder, "es_ES.aff"), "SET UTF-8\n");
+        var subtitle = MakeSubtitle();
+
+        RunFix(subtitle);
+
+        AssertFixed(subtitle);
+    }
+
+    [Fact]
+    public void AppliesSpanishReplaceList_WhenNoHunspellDictionaryInstalled()
+    {
+        var subtitle = MakeSubtitle();
+
+        RunFix(subtitle);
+
+        AssertFixed(subtitle);
+    }
+
+    public void Dispose()
+    {
+        Se.DictionariesFolder = _originalDictionariesFolder;
+        SpellCheckConfig.DictionariesFolder = _originalSpellCheckDictionariesFolder;
+        FixCommonOcrErrors.OcrFixEngine = _originalEngine;
+        try
+        {
+            Directory.Delete(_tempDictionariesFolder, recursive: true);
+        }
+        catch
+        {
+            // Best-effort cleanup.
+        }
+    }
+}
