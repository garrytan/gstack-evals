+            // Replace lists mostly hold lower-case entries (e.g. "adios" -> "adiós"), but the word
+            // is often capitalized at the start of a sentence ("Adios.") - try the lower-case form
+            // and restore the capital letter in the replacement.
+            if (word.Length > 1 && char.IsUpper(word[0]))
+            {
+                var lowerFirst = char.ToLowerInvariant(word[0]) + word.Substring(1);
+                if (GetReplaceWordExact(pre, lowerFirst, post, out var lowerResult))
+                {
+                    result = UppercaseFirstLetter(lowerResult);
+                    return true;
+                }
+            }
+
+            result = string.Empty;
+            return false;
+        }
+
+        private static string UppercaseFirstLetter(string text)
+        {
+            for (var i = 0; i < text.Length; i++)
+            {
+                if (char.IsLetter(text[i]))
+                {
+                    return text.Substring(0, i) + char.ToUpperInvariant(text[i]) + text.Substring(i + 1);
+                }
+
+                if (text[i] == '<')
+                {
+                    var end = text.IndexOf('>', i);
+                    if (end < 0)
+                    {
+                        break;
+                    }
+
+                    i = end;
+                }
+            }
+
+            return text;
+        }
