+    [Fact]
+    public void Should_Accept_Choice_Ignoring_Case_When_Comparer_Is_Set_Fluently()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Was the tool helpful?")
+                .AddChoices(["Yes", "Partially", "No"])
+                .Comparer(StringComparer.OrdinalIgnoreCase));
+
+        // Then
+        result.ShouldBe("Yes");
+    }
+
+    [Fact]
+    public void Should_Accept_Choice_Ignoring_Case_When_Comparer_Is_Passed_To_Constructor()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("PARTIALLY");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Was the tool helpful?", StringComparer.OrdinalIgnoreCase)
+                .AddChoices(["Yes", "Partially", "No"]));
+
+        // Then
+        result.ShouldBe("Partially");
+    }
+
+    [Fact]
+    public void Should_Reject_Choice_With_Different_Case_By_Default()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+        console.Input.PushTextWithEnter("No");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Was the tool helpful?")
+                .AddChoices(["Yes", "Partially", "No"]));
+
+        // Then
+        result.ShouldBe("No");
+        console.Output.ShouldContain("Please select one of the available options");
+    }
