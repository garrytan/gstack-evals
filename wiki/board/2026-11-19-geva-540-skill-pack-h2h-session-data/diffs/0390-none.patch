+
+func TestFromLogEvent_GroupedLogMatchesContains(t *testing.T) {
+	event := container.LogEvent{
+		Type: container.LogTypeGroup,
+		Message: []container.LogFragment{
+			{Message: "\x1b[32mINFO\x1b[0m first line backend"},
+			{Message: "INFO second line registros"},
+		},
+	}
+
+	nl := FromLogEvent(event)
+	assert.Equal(t, "INFO first line backend\nINFO second line registros", nl.Message)
+
+	for _, exprStr := range []string{`message contains "backend"`, `message contains "registros"`} {
+		program, err := expr.Compile(exprStr, expr.Env(types.NotificationLog{}))
+		require.NoError(t, err)
+		sub := &Subscription{LogExpression: exprStr, LogProgram: program}
+		assert.True(t, sub.MatchesLog(nl), exprStr)
+	}
+}
