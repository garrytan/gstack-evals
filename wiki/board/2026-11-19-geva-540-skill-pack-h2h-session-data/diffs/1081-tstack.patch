+
+// newHTTP3ReadTimeoutHandler enforces the readTimeout on HTTP/3 requests.
+// Contrary to HTTP/1.1 and HTTP/2, the readTimeout cannot be enforced through a connection read deadline,
+// so the request body is wrapped into a reader which is closed when the deadline is exceeded,
+// which cancels the underlying QUIC stream read.
+func newHTTP3ReadTimeoutHandler(next http.Handler, readTimeout time.Duration) http.Handler {
+	if readTimeout <= 0 {
+		return next
+	}
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		if req.Body == nil || req.Body == http.NoBody {
+			next.ServeHTTP(rw, req)
+			return
+		}
+
+		body := &deadlineBody{rc: req.Body, deadline: time.Now().Add(readTimeout)}
+		body.timer = time.AfterFunc(readTimeout, body.expire)
+		defer body.timer.Stop()
+
+		req.Body = body
+
+		next.ServeHTTP(rw, req)
+	})
+}
+
+// deadlineBody is a request body which cannot be read after its deadline.
+type deadlineBody struct {
+	rc       io.ReadCloser
+	deadline time.Time
+	timer    *time.Timer
+
+	mu      sync.Mutex
+	expired bool
+}
+
+func (b *deadlineBody) expire() {
+	b.mu.Lock()
+	b.expired = true
+	b.mu.Unlock()
+
+	// Closing the body cancels the stream read, which unblocks any pending Read call.
+	_ = b.rc.Close()
+}
+
+func (b *deadlineBody) isExpired() bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	return b.expired || !time.Now().Before(b.deadline)
+}
+
+func (b *deadlineBody) Read(p []byte) (int, error) {
+	if b.isExpired() {
+		return 0, os.ErrDeadlineExceeded
+	}
+
+	n, err := b.rc.Read(p)
+	if err != nil && !errors.Is(err, io.EOF) && b.isExpired() {
+		return n, os.ErrDeadlineExceeded
+	}
+
+	return n, err
+}
+
+func (b *deadlineBody) Close() error {
+	b.timer.Stop()
+	return b.rc.Close()
+}
