+func TestDispatchUniqueGraphAmplification(t *testing.T) {
+	// Each level references the next level fanout times, which produces
+	// fanout^depth paths through only depth+1 distinct descriptors.
+	const (
+		depth  = 20
+		fanout = 100
+	)
+	levels := make([]ocispec.Descriptor, depth+1)
+	for i := range levels {
+		levels[i] = newDesc(fmt.Sprintf("level-%d", i))
+	}
+	graph := map[digest.Digest][]ocispec.Descriptor{}
+	for i := 0; i < depth; i++ {
+		children := make([]ocispec.Descriptor, fanout)
+		for j := range children {
+			children[j] = levels[i+1]
+		}
+		graph[levels[i].Digest] = children
+	}
+	var calls atomic.Int32
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls.Add(1)
+		return graph[desc.Digest], nil
+	})
+
+	require.NoError(t, DispatchUnique(context.Background(), handler, nil, levels[0]))
+	assert.Equal(t, int32(depth+1), calls.Load())
+
+	// Repeated references still count towards the limit.
+	dup := newDesc("dup")
+	root := newDesc("root")
+	children := make([]ocispec.Descriptor, maxReferences+1)
+	for i := range children {
+		children[i] = dup
+	}
+	fan := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		if desc.Digest == root.Digest {
+			return children, nil
+		}
+		return nil, nil
+	})
+	require.ErrorIs(t, DispatchUnique(context.Background(), fan, nil, root), errdefs.ErrResourceExhausted)
+}
+
+func TestWalkReferenceLimit(t *testing.T) {
+	const (
+		depth  = 20
+		fanout = 100
+	)
+	levels := make([]ocispec.Descriptor, depth+1)
+	for i := range levels {
+		levels[i] = newDesc(fmt.Sprintf("level-%d", i))
+	}
+	graph := map[digest.Digest][]ocispec.Descriptor{}
+	for i := 0; i < depth; i++ {
+		children := make([]ocispec.Descriptor, fanout)
+		for j := range children {
+			children[j] = levels[i+1]
+		}
+		graph[levels[i].Digest] = children
+	}
+	var calls int
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls++
+		return graph[desc.Digest], nil
+	})
+	require.ErrorIs(t, Walk(context.Background(), handler, levels[0]), errdefs.ErrResourceExhausted)
+	assert.LessOrEqual(t, calls, maxReferences)
+
+	a, b := newDesc("a"), newDesc("b")
+	cycle := map[digest.Digest][]ocispec.Descriptor{a.Digest: {b}, b.Digest: {a}}
+	cyclic := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		return cycle[desc.Digest], nil
+	})
+	require.ErrorIs(t, Walk(context.Background(), cyclic, a), errdefs.ErrResourceExhausted)
+
+	small := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		if desc.Digest == a.Digest {
+			return []ocispec.Descriptor{b, b}, nil
+		}
+		return nil, nil
+	})
+	require.NoError(t, Walk(context.Background(), small, a))
+}
