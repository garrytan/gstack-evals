+++ b/pkg/proxy/proxy.go
@@ -58,8 +58,12 @@ func newTransport(clientCert, clientKeyFile, caFile string) (*http.Transport, er
 // passing them through access headers to the shard.
 func WithProxyAuthHeaders(delegate http.Handler, userHeader, groupHeader string, extraHeaderPrefix string) http.HandlerFunc {
 	return func(w http.ResponseWriter, r *http.Request) {
+		// Always strip client-supplied identity headers, even if no user is
+		// attached to the request, so that nothing forged reaches the backend.
 		if u, ok := request.UserFrom(r.Context()); ok {
 			authheaders.SetAuthHeaders(r.Header, u, userHeader, groupHeader, extraHeaderPrefix)
+		} else {
+			authheaders.StripAuthHeaders(r.Header, userHeader, groupHeader, extraHeaderPrefix)
 		}
 
 		delegate.ServeHTTP(w, r)
