@@ -0,0 +1,30 @@
+import docsifyInit from '../helpers/docsify-init.js';
+import { test, expect } from './fixtures/docsify-init-fixture.js';
+
+test.describe('Coverpage', () => {
+  test('heading id targets main content, not coverpage', async ({ page }) => {
+    await docsifyInit({
+      markdown: {
+        coverpage: '# Quick start',
+        homepage: `
+          # Quick start
+
+          ${'Lorem ipsum.\n\n'.repeat(80)}
+        `,
+      },
+    });
+
+    const coverHeading = page.locator('.cover-main #quick-start');
+    const mainHeading = page.locator('#main #quick-start');
+
+    await expect(coverHeading).toHaveCount(1);
+    await expect(mainHeading).toHaveCount(1);
+
+    await coverHeading.locator('a').click();
+
+    await expect(page).toHaveURL(/\?id=quick-start$/);
+    await expect(mainHeading).toBeFocused();
+    await expect(mainHeading).toBeInViewport();
+    await expect(coverHeading).not.toBeInViewport();
+  });
+});
