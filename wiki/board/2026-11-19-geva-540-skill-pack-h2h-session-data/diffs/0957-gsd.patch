 }
+
+func TestMergeCellsParserEmptyRef(t *testing.T) {
+	f := NewFile()
+	assert.NoError(t, f.SetCellValue("Sheet1", "A1", "v"))
+	// Replace the worksheet XML with one containing an empty merge cell reference
+	f.Sheet.Delete("xl/worksheets/sheet1.xml")
+	f.Pkg.Store("xl/worksheets/sheet1.xml", []byte(`<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData><row r="1"><c r="A1" t="inlineStr"><is><t>v</t></is></c></row></sheetData><mergeCells count="1"><mergeCell ref=""></mergeCell></mergeCells></worksheet>`))
+	f.checked = sync.Map{}
+	for _, cell := range []string{"A1", "B1", "A2"} {
+		_, err := f.GetCellValue("Sheet1", cell)
+		assert.NoError(t, err)
+		_, err = f.GetCellType("Sheet1", cell)
+		assert.NoError(t, err)
+		_, err = f.GetCellFormula("Sheet1", cell)
+		assert.NoError(t, err)
+	}
+	val, err := f.GetCellValue("Sheet1", "A1")
+	assert.NoError(t, err)
+	assert.Equal(t, "v", val)
+	assert.NoError(t, f.SetCellValue("Sheet1", "B2", 1))
+	assert.False(t, cellInRange([]int{1, 1}, nil))
+	assert.NoError(t, f.Close())
+}
