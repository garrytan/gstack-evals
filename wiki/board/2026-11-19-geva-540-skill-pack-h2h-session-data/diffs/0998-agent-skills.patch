+// Returns the position of the first `term` in `state.src` at or after `from`,
+// or -1. Results are cached per inline source, so repeated unterminated
+// openers (`<!--<!--<!--...`) do not rescan the rest of the input each time.
+function findTerminator (state: StateInline, term: string, from: number): number {
+  let cached = state.html_terminators[term]
+  if (!cached) {
+    cached = state.html_terminators[term] = { from: -1, at: -1, absentFrom: Infinity }
+  }
+
+  // Already known to be absent in the tail
+  if (from >= cached.absentFrom) { return -1 }
+  // Last found occurrence is still the next one
+  if (cached.from >= 0 && cached.from <= from && cached.at >= from) { return cached.at }
+
+  const at = state.src.indexOf(term, from)
+  if (at < 0) {
+    cached.absentFrom = from
+  } else {
+    cached.from = from
+    cached.at = at
+  }
+  return at
+}
