+        [Test]
+        public void ShowMessageBox_ShouldApplyProviderBackgroundClass()
+        {
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-background"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            _ = provider.InvokeAsync(() => service.ShowMessageBoxAsync("Title", "Message"));
+
+            provider.WaitForAssertion(() => provider.Find("div.mud-overlay-dialog").ClassList.Should().Contain("global-background"));
+        }
+
+        [Test]
+        public async Task Show_DialogOptionsBackgroundClass_ShouldOverrideProviderBackgroundClass()
+        {
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-background"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            await provider.InvokeAsync(() => service.ShowAsync<DialogOkCancel>("Title", new DialogOptions { BackgroundClass = "local-background" }));
+
+            var classList = provider.Find("div.mud-overlay-dialog").ClassList;
+            classList.Should().Contain("local-background");
+            classList.Should().NotContain("global-background");
+        }
+
