@@ -0,0 +1,64 @@
+using System.Collections.Specialized;
+
+using Quartz.Impl;
+using Quartz.Simpl;
+using Quartz.Spi;
+
+namespace Quartz.Tests.Unit.Core;
+
+[TestFixture]
+[NonParallelizable]
+public class JobFactoryAsyncLocalFlowTest
+{
+    private static readonly AsyncLocal<string> ambientValue = new();
+    private static TaskCompletionSource<string> observed = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+    [Test]
+    public async Task AsyncLocalSetInJobFactoryShouldFlowToJobExecution()
+    {
+        observed = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        var properties = new NameValueCollection
+        {
+            ["quartz.serializer.type"] = TestConstants.DefaultSerializerType,
+            ["quartz.scheduler.instanceName"] = "AsyncLocalFlowTest_" + Guid.NewGuid()
+        };
+        IScheduler scheduler = await new StdSchedulerFactory(properties).GetScheduler();
+        scheduler.JobFactory = new AmbientSettingJobFactory();
+        try
+        {
+            await scheduler.Start();
+
+            var job = JobBuilder.Create<AmbientReadingJob>().WithIdentity("job").UsingJobData("tenant", "001").Build();
+            var trigger = TriggerBuilder.Create().StartNow().Build();
+            await scheduler.ScheduleJob(job, trigger);
+
+            var completed = await Task.WhenAny(observed.Task, Task.Delay(TimeSpan.FromSeconds(10)));
+            Assert.That(completed, Is.SameAs(observed.Task), "job did not run");
+            Assert.That(await observed.Task, Is.EqualTo("001"));
+            Assert.That(ambientValue.Value, Is.Null, "ambient value must not leak to caller");
+        }
+        finally
+        {
+            await scheduler.Shutdown(true);
+        }
+    }
+
+    private sealed class AmbientSettingJobFactory : SimpleJobFactory
+    {
+        public override IJob NewJob(TriggerFiredBundle bundle, IScheduler scheduler)
+        {
+            ambientValue.Value = bundle.JobDetail.JobDataMap.GetString("tenant");
+            return base.NewJob(bundle, scheduler);
+        }
+    }
+
+    private sealed class AmbientReadingJob : IJob
+    {
+        public ValueTask Execute(IJobExecutionContext context)
+        {
+            observed.TrySetResult(ambientValue.Value ?? "<null>");
+            return default;
+        }
+    }
+}
