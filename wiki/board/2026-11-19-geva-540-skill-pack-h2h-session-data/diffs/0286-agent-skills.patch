diff --git a/tests/features/embeddables/nested-inline-embeddable-null-parent.test.ts b/tests/features/embeddables/nested-inline-embeddable-null-parent.test.ts
new file mode 100644
index 0000000..79e1860
--- /dev/null
+++ b/tests/features/embeddables/nested-inline-embeddable-null-parent.test.ts
@@ -0,0 +1,71 @@
+import { MikroORM } from '@mikro-orm/sqlite';
+import { Embeddable, Embedded, Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';
+
+@Embeddable()
+class Inner {
+  @Property({ nullable: true })
+  value?: string;
+}
+
+@Embeddable()
+class Outer {
+  @Property({ nullable: true })
+  name?: string;
+
+  @Embedded(() => Inner, { nullable: true })
+  inner?: Inner | null;
+}
+
+@Entity()
+class Parent {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Outer, { nullable: true })
+  outer?: Outer | null;
+}
+
+let orm: MikroORM;
+const queries: string[] = [];
+
+beforeAll(async () => {
+  orm = await MikroORM.init({
+    metadataProvider: ReflectMetadataProvider,
+    entities: [Parent],
+    dbName: ':memory:',
+    debug: ['query'],
+    logger: msg => queries.push(msg),
+  });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+beforeEach(() => queries.length = 0);
+
+test('insert with null parent embeddable', async () => {
+  const p = orm.em.create(Parent, { outer: null });
+  await orm.em.flush();
+  orm.em.clear();
+  expect(queries.join('\n')).not.toMatch(/`inner`/);
+  const loaded = await orm.em.findOneOrFail(Parent, p.id);
+  expect(loaded.outer).toBeNull();
+});
+
+test('update parent embeddable to null', async () => {
+  const outer = new Outer();
+  outer.name = 'n';
+  outer.inner = new Inner();
+  outer.inner.value = 'v';
+  const p = orm.em.create(Parent, { outer });
+  await orm.em.flush();
+  queries.length = 0;
+  p.outer = null;
+  await orm.em.flush();
+  orm.em.clear();
+  expect(queries.join('\n')).toMatch(/set `outer_name` = \?, `outer_inner_value` = \?/);
+  expect(queries.join('\n')).not.toMatch(/`outer_inner`[^_]/);
+  const row = await orm.em.getConnection().execute('select * from parent where id = ?', [p.id], 'get');
+  expect(row).toMatchObject({ outer_name: null, outer_inner_value: null });
+  const loaded = await orm.em.findOneOrFail(Parent, p.id);
+  expect(loaded.outer).toBeNull();
+});
