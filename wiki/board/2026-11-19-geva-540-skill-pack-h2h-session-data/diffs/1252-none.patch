+// aclAllowsRequest checks the credentials of the request against the acl
+// without writing anything to the response.
+func aclAllowsRequest(req *http.Request, acl configFile) bool {
+	if acl.Auth == "" {
+		return true
+	}
+	username, password, authOK := req.BasicAuth()
+	if !authOK {
+		return false
+	}
+	user, passwordHash, ok := strings.Cut(acl.Auth, ":")
+	if !ok {
+		return false
+	}
+	return username == user && checkPasswordHash(password, passwordHash)
+}
+
+// readACLFor resolves the effective ACL that governs read access to absPath
+// and reports whether the path is hidden by a block list.
+func (fs *FileServer) readACLFor(absPath string, isDir bool) (configFile, bool) {
+	parent := filepath.Dir(absPath)
+	name := filepath.Base(absPath)
+
+	parentACL, err := fs.findEffectiveACL(parent)
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+	}
+
+	if !isDir {
+		blocked := slices.Contains(parentACL.Block, name)
+		return parentACL, blocked
+	}
+
+	// Directory: blocked if listed as "name/" in the parent's own or effective config
+	blocked := slices.Contains(parentACL.Block, name+"/")
+	if ownParent, err := fs.findSpecialFile(parent); err == nil {
+		if slices.Contains(ownParent.Block, name+"/") {
+			blocked = true
+		}
+	}
+	acl, err := fs.findEffectiveACL(absPath)
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+	}
+	// Auth of the parent chain also applies (findEffectiveACL returns nearest only)
+	if acl.Auth == "" && parentACL.Auth != "" {
+		acl.Auth = parentACL.Auth
+	}
+	return acl, blocked
+}
