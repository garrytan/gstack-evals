+package httpserver
+
+import (
+	"archive/zip"
+	"bytes"
+	"encoding/base64"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func setupBulkACL(t *testing.T) string {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "protected")
+	require.NoError(t, os.Mkdir(p, 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(p, "secret.txt"), []byte("TOPSECRET"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(p, "blocked.txt"), []byte("BLOCKED"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "public.txt"), []byte("PUBLIC"), 0644))
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := fmt.Sprintf(`{"auth":"admin:%s","block":["blocked.txt"]}`, string(hash))
+	require.NoError(t, os.WriteFile(filepath.Join(p, ".goshs"), []byte(acl), 0644))
+	return dir
+}
+
+func zipNames(t *testing.T, body []byte) map[string]string {
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	out := map[string]string{}
+	for _, f := range zr.File {
+		rc, err := f.Open()
+		require.NoError(t, err)
+		b, _ := io.ReadAll(rc)
+		rc.Close()
+		out[f.Name] = string(b)
+	}
+	return out
+}
+
+func bulkReq(fs *FileServer, query string, auth bool) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&"+query, nil)
+	if auth {
+		r.Header.Set("Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte("admin:admin")))
+	}
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	return w
+}
+
+func TestBulk_ACL_Unauthenticated(t *testing.T) {
+	fs, cleanup := newTestFileServer(t, setupBulkACL(t))
+	defer cleanup()
+
+	require.Equal(t, http.StatusUnauthorized, bulkReq(fs, "file=/protected/secret.txt", false).Code)
+	require.Equal(t, http.StatusUnauthorized, bulkReq(fs, "file=/protected", false).Code)
+	require.Equal(t, http.StatusUnauthorized, bulkReq(fs, "file=/public.txt&file=/protected/secret.txt", false).Code)
+
+	// Walking the webroot must not include protected contents
+	w := bulkReq(fs, "file=/", false)
+	require.Equal(t, http.StatusOK, w.Code)
+	names := zipNames(t, w.Body.Bytes())
+	require.Contains(t, names, "public.txt")
+	for n, c := range names {
+		require.NotContains(t, n, "protected")
+		require.NotEqual(t, "TOPSECRET", c)
+	}
+}
+
+func TestBulk_ACL_Authenticated(t *testing.T) {
+	fs, cleanup := newTestFileServer(t, setupBulkACL(t))
+	defer cleanup()
+
+	w := bulkReq(fs, "file=/protected/secret.txt", true)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, "TOPSECRET", zipNames(t, w.Body.Bytes())["protected/secret.txt"])
+
+	require.Equal(t, http.StatusNotFound, bulkReq(fs, "file=/protected/blocked.txt", true).Code)
+	require.Equal(t, http.StatusNotFound, bulkReq(fs, "file=/protected/.goshs", true).Code)
+
+	w = bulkReq(fs, "file=/protected", true)
+	require.Equal(t, http.StatusOK, w.Code)
+	names := zipNames(t, w.Body.Bytes())
+	require.Contains(t, names, "protected/secret.txt")
+	require.NotContains(t, names, "protected/blocked.txt")
+	require.NotContains(t, names, "protected/.goshs")
+}
