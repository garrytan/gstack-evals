+    public static List<T> ConcatDistinctByReference<T>(this IEnumerable<T> first, IEnumerable<T>? second)
+        where T : class
+    {
+        return first.Concat(second ?? []).Distinct<T>(ReferenceEqualityComparer.Instance).ToList();
+    }
