+    private DateTimeOffset ToInstantNotBefore(DateTime wallClockTime, DateTimeOffset notBefore)
+    {
+        DateTimeOffset instant = new DateTimeOffset(wallClockTime, TimeZoneUtil.GetUtcOffset(wallClockTime, TimeZone));
+        if (instant < notBefore && TimeZone.IsAmbiguousTime(wallClockTime))
+        {
+            // afterTime is inside the repeated hour, so use the second occurrence of this wall clock time
+            instant = new DateTimeOffset(wallClockTime, TimeZone.GetAmbiguousTimeOffsets(wallClockTime).Min());
+        }
+        return instant;
+    }
