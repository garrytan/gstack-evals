+    [Test]
+    public void ShouldKeepHourlyFireTimesOnWallClockWhenDaylightSavingStarts()
+    {
+        var timeZone = TZConvert.GetTimeZoneInfo("W. Europe Standard Time");
+        var start = new DateTimeOffset(2020, 3, 29, 0, 0, 0, TimeSpan.FromHours(1));
+
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .StartAt(start)
+            .WithDailyTimeIntervalSchedule(x => x
+                .InTimeZone(timeZone)
+                .OnEveryDay()
+                .WithIntervalInHours(4)
+                .StartingDailyAt(new TimeOfDay(0, 0))
+                .EndingDailyAt(new TimeOfDay(11, 0)))
+            .Build();
+
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, start, start.AddHours(12));
+
+        Assert.That(fireTimes.Select(x => TimeZoneInfo.ConvertTime(x, timeZone).TimeOfDay), Is.EqualTo(new[]
+        {
+            new TimeSpan(0, 0, 0),
+            new TimeSpan(4, 0, 0),
+            new TimeSpan(8, 0, 0),
+        }).AsCollection);
+    }
+
+    [Test]
+    public void ShouldNotFireBeforeAfterTimeInsideRepeatedHourWhenDaylightSavingEnds()
+    {
+        var timeZone = TZConvert.GetTimeZoneInfo("W. Europe Standard Time");
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .StartAt(new DateTimeOffset(2020, 10, 24, 0, 0, 0, TimeSpan.Zero))
+            .WithDailyTimeIntervalSchedule(x => x
+                .InTimeZone(timeZone)
+                .OnEveryDay()
+                .WithIntervalInMinutes(30))
+            .Build();
+
+        var secondTwoAm = new DateTimeOffset(2020, 10, 25, 2, 10, 0, TimeSpan.FromHours(1));
+        Assert.That(trigger.GetFireTimeAfter(secondTwoAm), Is.EqualTo(new DateTimeOffset(2020, 10, 25, 2, 30, 0, TimeSpan.FromHours(1))));
+    }
