-	return location.pathname + location.search;
+	// a pathname beginning with `//` would be interpreted as a protocol-relative URL
+	// (i.e. a different origin) by the client, so we prefix it with a `/.` dot segment,
+	// which preserves the double slash when resolved but keeps it on the current origin
+	const pathname = location.pathname.startsWith('//')
+		? '/.' + location.pathname
+		: location.pathname;
+
+	return pathname + location.search;
