+    [Test]
+    public void TestDayLightSavingEndShouldNotProduceExtraFireTimeWithDailyInterval()
+    {
+        // DST ends on 2020-10-25 in Central Europe, making that day 25 hours long
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("W. Europe Standard Time");
+        var start = new DateTimeOffset(2020, 10, 25, 0, 0, 0, TimeSpan.FromHours(2));
+
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .WithIdentity("id")
+            .ForJob("job")
+            .StartAt(start.AddMinutes(1).AddSeconds(5))
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithIntervalInHours(24)
+                .StartingDailyAt(new TimeOfDay(0, 1, 5))
+                .EndingDailyAt(new TimeOfDay(23, 59, 59))
+                .InTimeZone(timeZoneInfo)
+                .WithMisfireHandlingInstructionDoNothing())
+            .Build();
+
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, start, start.AddDays(3));
+
+        Assert.That(fireTimes.Select(x => TimeZoneUtil.ConvertTime(x, timeZoneInfo).DateTime), Is.EqualTo(new[]
+        {
+            new DateTime(2020, 10, 25, 0, 1, 5),
+            new DateTime(2020, 10, 26, 0, 1, 5),
+            new DateTime(2020, 10, 27, 0, 1, 5),
+        }).AsCollection);
+    }
+
+    [Test]
+    public void TestDayLightSavingEndHourlyIntervalShouldNotGoBackwards()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("W. Europe Standard Time");
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .StartAt(new DateTimeOffset(2020, 10, 24, 0, 0, 0, TimeSpan.FromHours(2)))
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithInterval(15, IntervalUnit.Minute)
+                .StartingDailyAt(new TimeOfDay(0, 0))
+                .InTimeZone(timeZoneInfo))
+            .Build();
+
+        var from = new DateTimeOffset(2020, 10, 24, 22, 0, 0, TimeSpan.Zero);
+        var times = TriggerUtils.ComputeFireTimesBetween(trigger, null, from, from.AddHours(6));
+        for (int i = 1; i < times.Count; i++)
+        {
+            Assert.That(times[i], Is.GreaterThan(times[i - 1]));
+        }
+        Assert.That(times, Has.Count.LessThan(30));
+    }
+
