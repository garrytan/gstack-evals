+
+    [Theory]
+    [InlineData(DialogType.DashBothLinesWithSpace, "- How are you?\n- I'm fine.")]
+    [InlineData(DialogType.DashBothLinesWithoutSpace, "-How are you?\n-I'm fine.")]
+    [InlineData(DialogType.DashSecondLineWithSpace, "How are you?\n- I'm fine.")]
+    [InlineData(DialogType.DashSecondLineWithoutSpace, "How are you?\n-I'm fine.")]
+    public void FixDashesAndSpacesEnDash(DialogType dialogType, string expected)
+    {
+        var splitMerge = new DialogSplitMerge { DialogStyle = dialogType, TwoLetterLanguageCode = "en" };
+        var input = $"\u2013 How are you?{Environment.NewLine}\u2013 I'm fine.";
+        expected = expected.Replace("\n", Environment.NewLine);
+
+        Assert.Equal(expected, splitMerge.FixDashesAndSpaces(input));
+
+        var p = new Paragraph(input, 4000, 7000);
+        Assert.Equal(expected, splitMerge.FixDashesAndSpaces(p.Text, p, null));
+    }
+
+    [Fact]
+    public void FixDashesAndSpacesEnDashItalic()
+    {
+        var splitMerge = new DialogSplitMerge { DialogStyle = DialogType.DashBothLinesWithSpace, TwoLetterLanguageCode = "en" };
+        var result = splitMerge.FixDashesAndSpaces($"<i>\u2013How are you?</i>{Environment.NewLine}<i>\u2013I'm fine.</i>");
+        Assert.Equal($"<i>- How are you?</i>{Environment.NewLine}<i>- I'm fine.</i>", result);
+    }
+
+    [Fact]
+    public void RemoveStartDashEnDash()
+    {
+        Assert.Equal("I'm fine.", DialogSplitMerge.RemoveStartDash("\u2013 I'm fine."));
+    }
