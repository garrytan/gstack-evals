-        public static char GetAlternateDashChar() => '‐'; // Unicode En Dash (\u2010)
+        public static char GetAlternateDashChar() => '\u2010'; // Unicode Hyphen
+
+        private static readonly char[] AlternateDashChars =
+        {
+            '\u2010', // hyphen
+            '\u2011', // non-breaking hyphen
+            '\u2012', // figure dash
+            '\u2013', // en dash
+            '\u2212', // minus sign
+            '\uFE63', // small hyphen-minus
+            '\uFF0D', // fullwidth hyphen-minus
+        };
+
+        /// <summary>
+        /// Non-ASCII dash characters that are treated (and normalized) as dialog dashes.
+        /// </summary>
+        public static char[] GetAlternateDashChars() => (char[])AlternateDashChars.Clone();
+
+        public static bool IsAlternateDashChar(char c) => Array.IndexOf(AlternateDashChars, c) >= 0;
+
+        private static bool StartsWithAlternateDash(string s) => s.Length > 0 && IsAlternateDashChar(s[0]);
+
+        private static bool StartsWithAnyDash(string s) => s.Length > 0 && (s[0] == GetDashChar() || IsAlternateDashChar(s[0]));
+
+        /// <summary>
+        /// Replace a leading non-ASCII dialog dash (after tags/whitespace) with the normal dash.
+        /// </summary>
+        private static string NormalizeStartDash(string line)
+        {
+            var trimmed = line.TrimStart();
+            if (!StartsWithAlternateDash(trimmed))
+            {
+                return line;
+            }
+
+            var idx = line.Length - trimmed.Length;
+            return line.Substring(0, idx) + GetDashChar() + line.Substring(idx + 1);
+        }
 
