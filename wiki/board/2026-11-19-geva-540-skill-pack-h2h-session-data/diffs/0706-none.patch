+TEST_F(BuildTest, DyndepBuildDiscoverOutputAndDepfileInputOrderOnly) {
+  // Verify that an edge whose depfile reports as an input an implicit
+  // output discovered by a ready dyndep file is rebuilt when the edge
+  // producing that output is dirty, even if that edge is reached only
+  // via an order-only dependency visited after the depfile input.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out $out.imp\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"build dd: cp dd-in\n"
+"build tmp: touch || dd\n"
+"  dyndep = dd\n"
+"build out: touch || tmp\n"
+"  depfile = out.d\n"
+));
+  fs_.Create("dd-in",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Tick();
+  fs_.Create("tmp.imp", "");
+  fs_.Create("out", "");
+  fs_.Create("out.imp", "");
+  fs_.Create("out.d", "out: tmp.imp\n");
+  // "tmp" is missing, so its edge is dirty and will update "tmp.imp".
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("out", &err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch tmp tmp.imp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("touch out out.imp", command_runner_.commands_ran_[1]);
+}
+
