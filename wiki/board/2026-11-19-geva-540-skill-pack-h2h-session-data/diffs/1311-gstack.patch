+// hasDotSegment reports whether the given path contains a "." or ".." segment,
+// treating both "/" and "\\" as segment separators.
+func hasDotSegment(p string) bool {
+	segments := strings.FieldsFunc(p, func(r rune) bool { return r == '/' || r == '\\' })
+	for _, seg := range segments {
+		if seg == "." || seg == ".." {
+			return true
+		}
+	}
+	return false
+}
