diff --git a/test/optimizer/volatile_aggregate_dedup.test b/test/optimizer/volatile_aggregate_dedup.test
new file mode 100644
index 0000000..bcb46f9
--- /dev/null
+++ b/test/optimizer/volatile_aggregate_dedup.test
@@ -0,0 +1,41 @@
+# name: test/optimizer/volatile_aggregate_dedup.test
+# description: Identical aggregates/windows over volatile expressions must not be deduplicated
+# group: [optimizer]
+
+statement ok
+CREATE TABLE t AS FROM (VALUES (1), (1), (2), (2)) t(g);
+
+# window rewritten to aggregate + self join
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT any_value(uuid()::VARCHAR) OVER (PARTITION BY g) a,
+	       any_value(uuid()::VARCHAR) OVER (PARTITION BY g) b
+	FROM t
+);
+----
+false
+
+# physical window CSE
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT any_value(uuid()::VARCHAR) OVER (PARTITION BY g ORDER BY g ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) a,
+	       any_value(uuid()::VARCHAR) OVER (PARTITION BY g ORDER BY g ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) b
+	FROM t
+);
+----
+false
+
+# plain aggregates
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT any_value(uuid()::VARCHAR) a, any_value(uuid()::VARCHAR) b FROM t GROUP BY g
+);
+----
+false
+
+# non-volatile duplicates are still fine
+query II
+SELECT sum(g) = sum(g), count(*) FROM t GROUP BY g ORDER BY ALL;
+----
+true	2
+true	2
