+
+func TestFromLogEvent_GroupedLogMatchesStringExpression(t *testing.T) {
+	logEvent := container.LogEvent{
+		Type: container.LogTypeGroup,
+		Message: []container.LogFragment{
+			{Message: "\x1b[32mINFO\x1b[0m Sincronizado lote de 1000 registros (Total: 710000)"},
+			{Message: "INFO Sincronizado lote de 1000 registros (Total: 711000)"},
+		},
+	}
+
+	notificationLog := FromLogEvent(logEvent)
+	assert.Equal(t,
+		"INFO Sincronizado lote de 1000 registros (Total: 710000)\nINFO Sincronizado lote de 1000 registros (Total: 711000)",
+		notificationLog.Message)
+
+	program, err := expr.Compile(`message contains "711000"`, expr.Env(types.NotificationLog{}), expr.AsBool())
+	require.NoError(t, err)
+	sub := &Subscription{LogProgram: program}
+	assert.True(t, sub.MatchesLog(notificationLog), "grouped log should match expression on any fragment")
+}
