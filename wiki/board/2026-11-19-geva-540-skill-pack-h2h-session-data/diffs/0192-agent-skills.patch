+    [Test]
+    public void ReadLargerThanInternalBufferDoesNotLoseData()
+    {
+        // Reproduces "Converting WAV to MP3 truncates file length": on .NET Core
+        // Stream.CopyTo rents a 128KB buffer, and AudioFileReader (float output from
+        // 16-bit mono) asks this stream for 64KB - more than the internal circular
+        // buffer (4 seconds = 64000 bytes at 16000 bytes/sec). The excess source data
+        // was silently discarded, truncating the output.
+        const int totalLength = 726 * 1000;
+        var inputStream = new BlockAlignedWaveStream(726, totalLength);
+        var blockStream = new BlockAlignReductionStream(inputStream);
+
+        var readBuffer = new byte[65536];
+        long totalRead = 0;
+        int read;
+        while ((read = blockStream.Read(readBuffer, 0, readBuffer.Length)) > 0)
+        {
+            CheckReadBuffer(readBuffer, read, (int)totalRead);
+            totalRead += read;
+        }
+        Assert.That(totalRead, Is.EqualTo(totalLength));
+        Assert.That(blockStream.Position, Is.EqualTo(totalLength));
+    }
+
