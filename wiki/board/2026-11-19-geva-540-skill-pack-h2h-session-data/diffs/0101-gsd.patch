diff --git a/tests/UI/Features/Tools/FixCommonErrors/FixCommonOcrErrorsTests.cs b/tests/UI/Features/Tools/FixCommonErrors/FixCommonOcrErrorsTests.cs
new file mode 100644
index 0000000..b674ada
--- /dev/null
+++ b/tests/UI/Features/Tools/FixCommonErrors/FixCommonOcrErrorsTests.cs
@@ -0,0 +1,57 @@
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Core.Forms.FixCommonErrors;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+using Nikse.SubtitleEdit.Logic.Config;
+
+namespace UITests.Features.Tools.FixCommonErrors;
+
+public class FixCommonOcrErrorsTests
+{
+    [Fact]
+    public void OcrReplaceList_IsApplied_WhenNoHunspellDictionaryIsInstalled()
+    {
+        var dir = Path.Combine(Path.GetTempPath(), "se_fce_ocr_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(dir);
+        var oldSeFolder = Se.DictionariesFolder;
+        var oldConfigFolder = SpellCheckConfig.DictionariesFolder;
+        var oldEngine = FixCommonOcrErrors.OcrFixEngine;
+        try
+        {
+            // Only the replace list - no Spanish .dic/.aff (state after a clean config reset).
+            File.WriteAllText(Path.Combine(dir, "spa_OCRFixReplaceList.xml"), """
+                <?xml version="1.0" encoding="utf-8"?>
+                <ReplaceList>
+                  <WholeWords>
+                    <Word from="aca" to="acá" />
+                    <Word from="Adios" to="Adiós" />
+                    <Word from="Algun" to="Algún" />
+                    <Word from="dia" to="día" />
+                    <Word from="volvere" to="volveré" />
+                  </WholeWords>
+                </ReplaceList>
+                """);
+            Se.DictionariesFolder = dir;
+            SpellCheckConfig.DictionariesFolder = () => dir;
+            FixCommonOcrErrors.OcrFixEngine = new OcrFixEngine(new SpellChecker());
+
+            var subtitle = new Subtitle();
+            subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+            subtitle.Paragraphs.Add(new Paragraph("Adios.", 2000, 3000));
+            subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 4000, 5000));
+
+            new FixCommonOcrErrors().Fix(subtitle, new EmptyFixCallback { Language = "es" });
+
+            Assert.Equal("Hola, acá estoy.", subtitle.Paragraphs[0].Text);
+            Assert.Equal("Adiós.", subtitle.Paragraphs[1].Text);
+            Assert.Equal("Algún día volveré.", subtitle.Paragraphs[2].Text);
+        }
+        finally
+        {
+            Se.DictionariesFolder = oldSeFolder;
+            SpellCheckConfig.DictionariesFolder = oldConfigFolder;
+            FixCommonOcrErrors.OcrFixEngine = oldEngine;
+            Directory.Delete(dir, true);
+        }
+    }
+}
diff --git a/tests/libuilogic/Ocr/OcrReplaceListWithoutDictionaryTests.cs b/tests/libuilogic/Ocr/OcrReplaceListWithoutDictionaryTests.cs
new file mode 100644
index 0000000..02b64b7
--- /dev/null
+++ b/tests/libuilogic/Ocr/OcrReplaceListWithoutDictionaryTests.cs
@@ -0,0 +1,66 @@
+using System;
+using System.IO;
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+
+namespace LibUiLogicTests.Ocr;
+
+[Collection("SpellCheckConfig")]
+public class OcrReplaceListWithoutDictionaryTests
+{
+    private const string ReplaceListXml = """
+        <?xml version="1.0" encoding="utf-8"?>
+        <ReplaceList>
+          <WholeWords>
+            <Word from="aca" to="acá" />
+            <Word from="Adios" to="Adiós" />
+            <Word from="Algun" to="Algún" />
+            <Word from="dia" to="día" />
+            <Word from="volvere" to="volveré" />
+          </WholeWords>
+        </ReplaceList>
+        """;
+
+    [Fact]
+    public void ReplaceList_IsApplied_WhenNoHunspellDictionaryIsInstalled()
+    {
+        var dir = Path.Combine(Path.GetTempPath(), "se_ocr_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(dir);
+        var oldFolder = SpellCheckConfig.DictionariesFolder;
+        try
+        {
+            File.WriteAllText(Path.Combine(dir, "spa_OCRFixReplaceList.xml"), ReplaceListXml);
+            SpellCheckConfig.DictionariesFolder = () => dir;
+
+            var subtitle = new Subtitle();
+            subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+            subtitle.Paragraphs.Add(new Paragraph("Adios.", 2000, 3000));
+            subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 4000, 5000));
+
+            // No .dic in the folder -> placeholder dictionary (what Fix common errors now falls back to).
+            Assert.Empty(new SpellChecker().GetDictionaryLanguages(dir));
+            IOcrFixEngine engine = new OcrFixEngine(new SpellChecker());
+            engine.Initialize(subtitle, "spa", new SpellCheckDictionaryDisplay { Name = "spa" });
+
+            Assert.Equal("Hola, acá estoy.", engine.FixOcrErrors(0, subtitle.Paragraphs[0].Text, true).GetText());
+            Assert.Equal("Adiós.", engine.FixOcrErrors(1, subtitle.Paragraphs[1].Text, true).GetText());
+            Assert.Equal("Algún día volveré.", engine.FixOcrErrors(2, subtitle.Paragraphs[2].Text, true).GetText());
+        }
+        finally
+        {
+            SpellCheckConfig.DictionariesFolder = oldFolder;
+            Directory.Delete(dir, true);
+        }
+    }
+
+    [Fact]
+    public void LanguageAutoDetect_DetectsSpanish_ForSample()
+    {
+        var subtitle = new Subtitle();
+        subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+        subtitle.Paragraphs.Add(new Paragraph("Adios.", 2000, 3000));
+        subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 4000, 5000));
+        Assert.Equal("es", LanguageAutoDetect.AutoDetectGoogleLanguage(subtitle));
+    }
+}
