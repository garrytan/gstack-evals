+		"64:ff9b:1::/48", // NAT64 local-use prefix (RFC 8215)
+		"2001::/32",      // Teredo (RFC 4380)
+		"::/96",          // IPv4-compatible IPv6 (deprecated, RFC 4291)
+	}
+	nets := make([]*net.IPNet, 0, len(cidrs))
+	for _, c := range cidrs {
+		_, n, err := net.ParseCIDR(c)
+		if err != nil {
+			panic(err)
+		}
+		nets = append(nets, n)
+	}
+	return nets
+}()
