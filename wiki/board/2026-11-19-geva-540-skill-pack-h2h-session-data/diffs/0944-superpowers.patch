@@ -0,0 +1,150 @@
+package openapi3filter_test
+
+import (
+	"bytes"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+const arrayItemsNilSpec = `
+openapi: 3.1.0
+info: {title: t, version: 1.0.0}
+paths:
+  /f:
+    post:
+      requestBody:
+        required: true
+        content:
+          application/x-www-form-urlencoded:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /upload:
+    post:
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /hdr:
+    get:
+      responses:
+        '200':
+          description: ok
+          headers:
+            X-Tags:
+              schema: {type: array}
+  /q:
+    get:
+      parameters:
+        - name: tags
+          in: query
+          schema: {type: array}
+        - name: obj
+          in: query
+          style: deepObject
+          explode: true
+          schema:
+            type: object
+            properties:
+              list: {type: array}
+      responses:
+        '200': {description: ok}
+  /p/{tags}:
+    get:
+      parameters:
+        - name: tags
+          in: path
+          required: true
+          schema: {type: array}
+      responses:
+        '200': {description: ok}
+`
+
+func TestArrayItemsNilDoesNotPanic(t *testing.T) {
+	loader := openapi3.NewLoader()
+	doc, err := loader.LoadFromData([]byte(arrayItemsNilSpec))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(loader.Context))
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+
+	opts := &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc}
+	validate := func(t *testing.T, req *http.Request) error {
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+		var verr error
+		require.NotPanics(t, func() {
+			verr = openapi3filter.ValidateRequest(loader.Context, &openapi3filter.RequestValidationInput{
+				Request: req, PathParams: pathParams, Route: route, Options: opts,
+			})
+		})
+		return verr
+	}
+
+	t.Run("urlencoded", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodPost, "/f", strings.NewReader("tags=a"))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		require.ErrorContains(t, validate(t, req), "items")
+	})
+
+	t.Run("multipart", func(t *testing.T) {
+		var buf bytes.Buffer
+		w := multipart.NewWriter(&buf)
+		require.NoError(t, w.WriteField("tags", "a"))
+		require.NoError(t, w.Close())
+		req, _ := http.NewRequest(http.MethodPost, "/upload", &buf)
+		req.Header.Set("Content-Type", w.FormDataContentType())
+		require.ErrorContains(t, validate(t, req), "items")
+	})
+
+	t.Run("query", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/q?tags=a&tags=b", nil)
+		require.Error(t, validate(t, req))
+	})
+
+	t.Run("deepObject", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/q?obj[list][0]=a", nil)
+		require.Error(t, validate(t, req))
+	})
+
+	t.Run("path", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/p/a,b", nil)
+		require.Error(t, validate(t, req))
+	})
+
+	t.Run("response header", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/hdr", nil)
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+		var verr error
+		require.NotPanics(t, func() {
+			verr = openapi3filter.ValidateResponse(loader.Context, &openapi3filter.ResponseValidationInput{
+				RequestValidationInput: &openapi3filter.RequestValidationInput{
+					Request: req, PathParams: pathParams, Route: route, Options: opts,
+				},
+				Status: http.StatusOK,
+				Header: http.Header{"X-Tags": []string{"a,b"}},
+				Body:   io.NopCloser(strings.NewReader("")),
+			})
+		})
+		require.Error(t, verr)
+	})
+}
