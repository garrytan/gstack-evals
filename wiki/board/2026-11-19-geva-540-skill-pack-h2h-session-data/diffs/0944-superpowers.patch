+
+// errArrayItemsRequired is returned when decoding a value against an array
+// schema that does not define "items" (permitted by OpenAPI 3.1).
+var errArrayItemsRequired = errors.New("array schema must define items to be decoded")
+
+// hasArrayItems reports whether the given array schema defines a usable items schema.
+func hasArrayItems(schemaRef *openapi3.SchemaRef) bool {
+	return schemaRef != nil && schemaRef.Value != nil &&
+		schemaRef.Value.Items != nil && schemaRef.Value.Items.Value != nil
+}
