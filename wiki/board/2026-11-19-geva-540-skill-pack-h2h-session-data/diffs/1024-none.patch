diff --git a/openapi3/schema_circular_xof_test.go b/openapi3/schema_circular_xof_test.go
new file mode 100644
index 0000000..5901421
--- /dev/null
+++ b/openapi3/schema_circular_xof_test.go
@@ -0,0 +1,49 @@
+package openapi3
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestVisitJSONCircularXOF(t *testing.T) {
+	for _, kind := range []string{"allOf", "anyOf", "oneOf", "not"} {
+		t.Run(kind, func(t *testing.T) {
+			s := &Schema{
+				Type:       &Types{"object"},
+				Properties: Schemas{"name": {Value: &Schema{Type: &Types{"string"}}}},
+			}
+			other := &Schema{AllOf: SchemaRefs{{Value: s}}}
+			ref := SchemaRefs{{Value: other}}
+			switch kind {
+			case "allOf":
+				s.AllOf = ref
+			case "anyOf":
+				s.AnyOf = ref
+			case "oneOf":
+				s.OneOf = ref
+			case "not":
+				s.Not = ref[0]
+			}
+			require.NoError(t, s.Validate(t.Context()))
+			err := s.VisitJSON(map[string]any{"name": "test"})
+			if kind == "not" {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+				require.Error(t, s.VisitJSON(map[string]any{"name": 1}))
+			}
+		})
+	}
+}
+
+func TestVisitJSONRecursiveThroughProperties(t *testing.T) {
+	node := &Schema{Type: &Types{"object"}}
+	wrapper := &Schema{AllOf: SchemaRefs{{Value: node}}}
+	node.Properties = Schemas{
+		"v":    {Value: &Schema{Type: &Types{"string"}}},
+		"next": {Value: wrapper},
+	}
+	require.NoError(t, wrapper.VisitJSON(map[string]any{"v": "a", "next": map[string]any{"v": "b"}}))
+	require.Error(t, wrapper.VisitJSON(map[string]any{"v": "a", "next": map[string]any{"v": 1}}))
+}
