@@ -0,0 +1,90 @@
+package openapi3filter
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestValidateRequestCircularXOF(t *testing.T) {
+	for _, kind := range []string{"allOf", "anyOf", "oneOf"} {
+		for _, style := range []string{"", "      style: deepObject\n      explode: true\n"} {
+			t.Run(kind+style, func(t *testing.T) {
+				spec := `
+openapi: '3.0.0'
+info: { title: t, version: '1.0' }
+paths:
+  /test:
+    get:
+      parameters:
+      - name: data
+        in: query
+` + style + `        schema: { $ref: '#/components/schemas/Recursive' }
+      responses: { '200': { description: OK } }
+    post:
+      requestBody:
+        content:
+          application/x-www-form-urlencoded:
+            schema: { $ref: '#/components/schemas/Recursive' }
+      responses: { '200': { description: OK } }
+components:
+  schemas:
+    Recursive:
+      type: object
+      ` + kind + `:
+      - $ref: '#/components/schemas/Recursive'
+      properties:
+        name: { type: string }
+`
+				spec = strings.ReplaceAll(spec, "\n      style", "\n        style")
+				spec = strings.ReplaceAll(spec, "\n      explode", "\n        explode")
+				loader := openapi3.NewLoader()
+				doc, err := loader.LoadFromData([]byte(spec))
+				require.NoError(t, err)
+				require.NoError(t, doc.Validate(loader.Context))
+				router, err := gorillamux.NewRouter(doc)
+				require.NoError(t, err)
+
+				for _, req := range []*http.Request{
+					mustReq(t, http.MethodGet, "http://example.com/test?data=x", ""),
+					mustReq(t, http.MethodGet, "http://example.com/test?data[name]=x", ""),
+					mustReq(t, http.MethodPost, "http://example.com/test", "name=x"),
+				} {
+					route, pathParams, err := router.FindRoute(req)
+					require.NoError(t, err)
+					// Must return (with or without error) rather than overflow the stack.
+					_ = ValidateRequest(t.Context(), &RequestValidationInput{
+						Request: req, PathParams: pathParams, Route: route,
+					})
+				}
+			})
+		}
+	}
+}
+
+func TestParseValueCircular(t *testing.T) {
+	s := &openapi3.Schema{Type: &openapi3.Types{"string"}}
+	s.AnyOf = openapi3.SchemaRefs{{Value: s}}
+	d := &urlValuesDecoder{}
+	_, err := d.parseValue("x", &openapi3.SchemaRef{Value: s})
+	require.ErrorIs(t, err, errCircularSchema)
+
+	c := &openapi3.Schema{}
+	c.AllOf = openapi3.SchemaRefs{{Value: c}}
+	_, err = buildResObj(map[string]any{"k": "v"}, nil, "k", &openapi3.SchemaRef{Value: c})
+	require.ErrorIs(t, err, errCircularSchema)
+}
+
+func mustReq(t *testing.T, method, url, body string) *http.Request {
+	req, err := http.NewRequest(method, url, strings.NewReader(body))
+	require.NoError(t, err)
+	if body != "" {
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	}
+	return req
+}
