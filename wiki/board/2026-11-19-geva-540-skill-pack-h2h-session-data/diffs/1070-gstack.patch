diff --git a/internal/web/events_test.go b/internal/web/events_test.go
index a32c169..24204df 100644
--- a/internal/web/events_test.go
+++ b/internal/web/events_test.go
@@ -66,3 +66,45 @@ func Test_handler_streamEvents_happy(t *testing.T) {
 	abide.AssertHTTPResponse(t, t.Name(), rr.Result())
 	mockedClient.AssertExpectations(t)
 }
+
+func Test_handler_streamEvents_filtersByLabels(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	req, err := http.NewRequestWithContext(ctx, "GET", "/api/events/stream", nil)
+	require.NoError(t, err)
+
+	mockedClient := new(MockedClient)
+	visibleContainer := container.Container{
+		ID:     "visible00001",
+		Name:   "visible",
+		Host:   "localhost",
+		Labels: map[string]string{"visible": "yes"},
+		Stats:  utils.NewRingBuffer[container.ContainerStat](300),
+	}
+
+	mockedClient.On("ListContainers", mock.Anything, mock.Anything).Return([]container.Container{visibleContainer}, nil)
+	mockedClient.On("ContainerEvents", mock.Anything, mock.AnythingOfType("chan<- container.ContainerEvent")).Return(nil).Run(func(args mock.Arguments) {
+		messages := args.Get(1).(chan<- container.ContainerEvent)
+		time.Sleep(50 * time.Millisecond)
+		messages <- container.ContainerEvent{Name: "die", ActorID: "secret000001", Host: "localhost", ActorAttributes: map[string]string{"secretproject": "acme-payroll"}}
+		messages <- container.ContainerEvent{Name: "health_status: healthy", ActorID: "secret000001", Host: "localhost"}
+		messages <- container.ContainerEvent{Name: "die", ActorID: "visible00001", Host: "localhost"}
+		time.Sleep(50 * time.Millisecond)
+		cancel()
+	})
+	mockedClient.On("FindContainer", mock.Anything, mock.Anything).Return(visibleContainer, nil).Maybe()
+	mockedClient.On("Host").Return(container.Host{ID: "localhost"})
+
+	labels := container.ContainerLabels{"visible": {"yes"}}
+	manager := docker_support.NewRetriableClientManager(nil, 3*time.Second, tls.Certificate{}, docker_support.NewDockerClientService(mockedClient, labels))
+	multiHostService := docker_support.NewMultiHostService(manager, 3*time.Second)
+
+	server := CreateServer(multiHostService, nil, Config{Base: "/", Labels: labels, Authorization: Authorization{Provider: NONE}})
+
+	rr := httptest.NewRecorder()
+	server.Handler.ServeHTTP(rr, req)
+
+	body := rr.Body.String()
+	require.Contains(t, body, "visible00001")
+	require.NotContains(t, body, "secret000001")
+	require.NotContains(t, body, "acme-payroll")
+}
