@@ -113,6 +113,9 @@ public class AudioFileReader : WaveStream, ISampleProvider
     public override int Read(Span<byte> buffer)
     {
         var floatSpan = MemoryMarshal.Cast<byte, float>(buffer);
+        // only ever request whole sample frames from the underlying reader
+        int channels = sampleChannel.WaveFormat.Channels;
+        floatSpan = floatSpan.Slice(0, floatSpan.Length - (floatSpan.Length % channels));
