     }
diff --git a/tests/NAudio.Core.Tests/WaveStreams/WaveStreamCopyToTests.cs b/tests/NAudio.Core.Tests/WaveStreams/WaveStreamCopyToTests.cs
new file mode 100644
index 0000000..efcf2d2
--- /dev/null
+++ b/tests/NAudio.Core.Tests/WaveStreams/WaveStreamCopyToTests.cs
@@ -0,0 +1,143 @@
+using System;
+using System.IO;
+using System.Threading.Tasks;
+using NAudio.Utils;
+using NAudio.Wave;
+using NUnit.Framework;
+
+namespace NAudio.Core.Tests.WaveStreams;
+
+/// <summary>
+/// Stream.CopyTo on modern .NET sizes its buffer from Length - Position and rents it from the
+/// ArrayPool (power-of-two sizes), so the read sizes it issues are not block aligned. WaveStream
+/// overrides CopyTo / CopyToAsync to always read whole blocks and never trust Length.
+/// </summary>
+[TestFixture]
+[Category("UnitTest")]
+public class WaveStreamCopyToTests
+{
+    private static MemoryStream CreateWav(WaveFormat format, int seconds)
+    {
+        var ms = new MemoryStream();
+        using (var writer = new WaveFileWriter(new IgnoreDisposeStream(ms), format))
+        {
+            var data = new byte[format.AverageBytesPerSecond * seconds];
+            for (int n = 0; n < data.Length; n++)
+            {
+                data[n] = (byte)n;
+            }
+            writer.Write(data, 0, data.Length);
+        }
+        ms.Position = 0;
+        return ms;
+    }
+
+    [TestCase(8000, 16, 1)]
+    [TestCase(8000, 24, 1)]
+    [TestCase(44100, 24, 2)]
+    [TestCase(22050, 8, 1)]
+    public void CopyToCopiesAllAudioFromWaveFileReader(int sampleRate, int bits, int channels)
+    {
+        var format = new WaveFormat(sampleRate, bits, channels);
+        using var reader = new WaveFileReader(CreateWav(format, 16));
+        var dest = new MemoryStream();
+
+        reader.CopyTo(dest);
+
+        Assert.That(dest.Length, Is.EqualTo(reader.Length));
+        Assert.That(dest.Length, Is.EqualTo(format.AverageBytesPerSecond * 16));
+    }
+
+    [TestCase(8000, 24, 1)]
+    [TestCase(8000, 16, 1)]
+    public async Task CopyToAsyncCopiesAllAudioFromWaveFileReader(int sampleRate, int bits, int channels)
+    {
+        var format = new WaveFormat(sampleRate, bits, channels);
+        using var reader = new WaveFileReader(CreateWav(format, 16));
+        var dest = new MemoryStream();
+
+        await reader.CopyToAsync(dest);
+
+        Assert.That(dest.Length, Is.EqualTo(format.AverageBytesPerSecond * 16));
+    }
+
+    [TestCase(1)]
+    [TestCase(3)]
+    [TestCase(1000)]
+    public void CopyToHonoursBufferSizeButAlwaysReadsWholeBlocks(int bufferSize)
+    {
+        var format = new WaveFormat(8000, 24, 1);
+        using var reader = new WaveFileReader(CreateWav(format, 2));
+        var dest = new MemoryStream();
+
+        reader.CopyTo(dest, bufferSize);
+
+        Assert.That(dest.Length, Is.EqualTo(format.AverageBytesPerSecond * 2));
+    }
+
+    [Test]
+    public void CopyToDoesNotTruncateWhenLengthIsAnUnderestimate()
+    {
+        // a mono float stream that can only return whole samples and reports a
+        // Length of a quarter of its actual content (as estimated lengths can)
+        var stream = new UnderestimatedLengthStream(WaveFormat.CreateIeeeFloatWaveFormat(8000, 1),
+            actualBytes: 8000 * 4 * 16, reportedLength: 8000 * 4 * 4);
+        var dest = new MemoryStream();
+
+        stream.CopyTo(dest);
+
+        Assert.That(dest.Length, Is.EqualTo(8000 * 4 * 16));
+    }
+
+    [Test]
+    public void CopyToFromNearTheEndWithUnderestimatedLengthStillCopiesRemainder()
+    {
+        var stream = new UnderestimatedLengthStream(WaveFormat.CreateIeeeFloatWaveFormat(8000, 1),
+            actualBytes: 8000, reportedLength: 4000);
+        var first = new byte[4000];
+        Assert.That(stream.Read(first, 0, first.Length), Is.EqualTo(4000));
+        var dest = new MemoryStream();
+
+        // Position == Length here, so Stream's default sizing would pick a 1 byte buffer
+        stream.CopyTo(dest);
+
+        Assert.That(dest.Length, Is.EqualTo(4000));
+    }
+
+    private class UnderestimatedLengthStream : WaveStream
+    {
+        private readonly long actualBytes;
+        private readonly long reportedLength;
+        private long position;
+
+        public UnderestimatedLengthStream(WaveFormat format, long actualBytes, long reportedLength)
+        {
+            WaveFormat = format;
+            this.actualBytes = actualBytes;
+            this.reportedLength = reportedLength;
+        }
+
+        public override WaveFormat WaveFormat { get; }
+
+        public override long Length => reportedLength;
+
+        public override long Position
+        {
+            get => position;
+            set => position = value;
+        }
+
+        public override int Read(Span<byte> buffer)
+        {
+            // like AudioFileReader, only whole sample frames can be returned
+            int count = (int)Math.Min(buffer.Length, actualBytes - position);
+            count -= count % WaveFormat.BlockAlign;
+            buffer.Slice(0, count).Clear();
+            position += count;
+            return count;
+        }
+
+        public override int Read(byte[] buffer, int offset, int count)
+            => Read(buffer.AsSpan(offset, count));
+    }
+}
