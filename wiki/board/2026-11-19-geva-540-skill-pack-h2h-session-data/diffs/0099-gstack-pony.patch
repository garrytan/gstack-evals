+++ b/tests/UI/Features/Tools/FixCommonErrors/FixCommonOcrErrorsNoHunspellTests.cs
@@ -0,0 +1,53 @@
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Core.Forms.FixCommonErrors;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+using Nikse.SubtitleEdit.Logic.Config;
+using System;
+using System.IO;
+
+namespace UITests.Features.Tools.FixCommonErrors;
+
+// After a config reset the dictionaries folder holds only the bundled XML lists (no Hunspell .dic),
+// and "Fix common OCR errors" silently did nothing - the OCR replace list must still be applied.
+public class FixCommonOcrErrorsNoHunspellTests : IDisposable
+{
+    private readonly string _originalDictionariesFolder = Se.DictionariesFolder;
+    private readonly Func<string> _originalSpellCheckDictionariesFolder = SpellCheckConfig.DictionariesFolder;
+    private readonly string _temp = Path.Combine(Path.GetTempPath(), "SeOcrNoHunspell_" + Guid.NewGuid().ToString("N"));
+
+    public FixCommonOcrErrorsNoHunspellTests()
+    {
+        Directory.CreateDirectory(_temp);
+        File.WriteAllText(Path.Combine(_temp, "spa_OCRFixReplaceList.xml"),
+            "<OCRFixReplaceList><WholeWords>" +
+            "<Word from=\"aca\" to=\"acá\" /><Word from=\"Adios\" to=\"Adiós\" /><Word from=\"Algun\" to=\"Algún\" />" +
+            "<Word from=\"dia\" to=\"día\" /><Word from=\"volvere\" to=\"volveré\" />" +
+            "</WholeWords></OCRFixReplaceList>");
+        Se.DictionariesFolder = _temp;
+        SpellCheckConfig.DictionariesFolder = () => _temp;
+    }
+
+    [Fact]
+    public void ReplaceList_IsApplied_WithoutHunspellDictionary()
+    {
+        var subtitle = new Subtitle();
+        subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+        subtitle.Paragraphs.Add(new Paragraph("Adios.", 2000, 3000));
+        subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 4000, 5000));
+
+        FixCommonOcrErrors.OcrFixEngine = new OcrFixEngine(new SpellCheckManager());
+        new FixCommonOcrErrors().Fix(subtitle, new EmptyFixCallback { Language = "es" });
+
+        Assert.Equal("Hola, acá estoy.", subtitle.Paragraphs[0].Text);
+        Assert.Equal("Adiós.", subtitle.Paragraphs[1].Text);
+        Assert.Equal("Algún día volveré.", subtitle.Paragraphs[2].Text);
+    }
+
+    public void Dispose()
+    {
+        Se.DictionariesFolder = _originalDictionariesFolder;
+        SpellCheckConfig.DictionariesFolder = _originalSpellCheckDictionariesFolder;
+        try { Directory.Delete(_temp, recursive: true); } catch { /* best effort */ }
+    }
+}
