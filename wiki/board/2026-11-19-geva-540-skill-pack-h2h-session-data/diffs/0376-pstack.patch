+    [Fact]
+    public void Generic_Initialization_Checks_CheckBox_For_Value ()
+    {
+        OptionSelector<Orientation> optionSelector = new ();
+
+        Assert.Equal (Orientation.Horizontal, optionSelector.Value);
+
+        CheckBox checkBox = optionSelector.SubViews.OfType<CheckBox> ().Single (cb => cb.Value == CheckState.Checked);
+        Assert.Equal (nameof (Orientation.Horizontal), checkBox.Title);
+    }
+
+    [Fact]
+    public void Generic_Initialization_Checks_CheckBox_After_Layout ()
+    {
+        OptionSelector<Orientation> optionSelector = new ();
+        optionSelector.Layout ();
+
+        CheckBox checkBox = optionSelector.SubViews.OfType<CheckBox> ().Single (cb => cb.Value == CheckState.Checked);
+        Assert.Equal (nameof (Orientation.Horizontal), checkBox.Title);
+    }
+
+    [Fact]
+    public void TabBehavior_Set_Keeps_CheckBox_For_Value_Checked ()
+    {
+        OptionSelector optionSelector = new () { Labels = ["Option1", "Option2"], Value = 1 };
+
+        optionSelector.TabBehavior = TabBehavior.NoStop;
+
+        CheckBox checkBox = optionSelector.SubViews.OfType<CheckBox> ().Single (cb => cb.Value == CheckState.Checked);
+        Assert.Equal ("Option2", checkBox.Title);
+    }
