+    private static List<String> extractResources(Map<String, Object> event) {
+        Object raw = event.get("Resources");
+        if (raw instanceof Collection<?> c) {
+            List<String> out = new ArrayList<>(c.size());
+            for (Object o : c) {
+                if (o != null) out.add(o.toString());
+            }
+            return out;
+        }
+        if (raw instanceof String[] arr) {
+            return List.of(arr);
+        }
+        return List.of();
+    }
