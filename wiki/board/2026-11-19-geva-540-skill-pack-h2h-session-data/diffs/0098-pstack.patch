 }
 
+TEST_F(LibraryTest, ParseSrvReplyCompressedTarget) {
+  std::vector<byte> data = {
+    0x12, 0x34,  // qid
+    0x84, // response + query + AA + not-TC + not-RD
+    0x00, // not-RA + not-Z + not-AD + not-CD + rc=NoError
+    0x00, 0x01,  // num questions
+    0x00, 0x01,  // num answer RRs
+    0x00, 0x00,  // num authority RRs
+    0x00, 0x00,  // num additional RRs
+    // Question
+    0x07, 'e', 'x', 'a', 'm', 'p', 'l', 'e',
+    0x03, 'c', 'o', 'm',
+    0x00,
+    0x00, 0x21,  // type SRV
+    0x00, 0x01,  // class IN
+    // Answer 1
+    0xC0, 0x0C,  // owner name is a pointer, which RFC 1035 permits
+    0x00, 0x21,  // RR type
+    0x00, 0x01,  // class IN
+    0x01, 0x02, 0x03, 0x04, // TTL
+    0x00, 0x08,  // rdata length
+    0x00, 0x0A,  // priority
+    0x00, 0x14,  // weight
+    0x00, 0x1E,  // port
+    0xC0, 0x0C,  // target is a pointer, which RFC 2782 forbids
+  };
+
+  struct ares_srv_reply* srv = nullptr;
+  EXPECT_NE(ARES_SUCCESS, ares_parse_srv_reply(data.data(), (int)data.size(), &srv));
+  EXPECT_EQ(nullptr, srv);
+
+  ares_dns_record_t *dnsrec = nullptr;
+  EXPECT_NE(ARES_SUCCESS, ares_dns_parse(data.data(), data.size(), 0, &dnsrec));
+  EXPECT_EQ(nullptr, dnsrec);
+
+  // The same pointer is legal in an MX exchange, since RFC 1035 allows it.
+  data[32] = 0x0F;
+  data[40] = 0x04;
+  data.erase(data.begin() + 43, data.begin() + 47);
+  ASSERT_EQ(ARES_SUCCESS, ares_dns_parse(data.data(), data.size(), 0, &dnsrec));
+  const ares_dns_rr_t *rr = ares_dns_record_rr_get(dnsrec, ARES_SECTION_ANSWER, 0);
+  EXPECT_EQ(ARES_REC_TYPE_MX, ares_dns_rr_get_type(rr));
+  EXPECT_EQ("example.com", std::string(ares_dns_rr_get_str(rr, ARES_RR_MX_EXCHANGE)));
+  ares_dns_record_destroy(dnsrec);
+}
