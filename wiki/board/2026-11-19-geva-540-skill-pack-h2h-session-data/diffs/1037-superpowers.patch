+func TestNormalizedMethod(t *testing.T) {
+	for _, m := range []string{"GET", "POST", "PUT", "DELETE", "OPTIONS", "HEAD", "CONNECT", "TRACE"} {
+		if got := normalizedMethod(m); got != m {
+			t.Errorf("normalizedMethod(%q) = %q, want %q", m, got, m)
+		}
+	}
+	for _, m := range []string{"M1", "get", "PATCH", "", "FOOBAR"} {
+		if got := normalizedMethod(m); got != "other" {
+			t.Errorf("normalizedMethod(%q) = %q, want other", m, got)
+		}
