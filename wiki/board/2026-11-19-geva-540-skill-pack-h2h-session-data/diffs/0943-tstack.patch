+// arrayItemsSchema returns the items schema of an array schema.
+// OpenAPI 3.1 allows array schemas without items, which cannot be decoded
+// from raw strings, so an error is returned instead of dereferencing nil.
+func arrayItemsSchema(schemaRef *openapi3.SchemaRef) (*openapi3.SchemaRef, error) {
+	if schemaRef == nil || schemaRef.Value == nil || schemaRef.Value.Items == nil || schemaRef.Value.Items.Value == nil {
+		return nil, errors.New("array items schema is required for decoding")
+	}
+	return schemaRef.Value.Items, nil
+}
