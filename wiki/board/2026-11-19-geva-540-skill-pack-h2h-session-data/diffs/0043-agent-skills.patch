+    @Test
+    @DisplayName(
+            "targeted user interrupt returns INTERRUPTED, persists recovery and isolates sessions")
+    void targetedUserInterruptReturnsInterruptedReason() throws Exception {
+        InMemoryAgentStateStore store = new InMemoryAgentStateStore();
+        CountDownLatch subscribed = new CountDownLatch(2);
+        ReActAgent agent =
+                ReActAgent.builder()
+                        .name("asst")
+                        .sysPrompt("hi")
+                        .model(new DelayedFirstChunkModel(subscribed))
+                        .stateStore(store)
+                        .build();
+        RuntimeContext target = RuntimeContext.builder().userId("u1").sessionId("sessA").build();
+        RuntimeContext bystander = RuntimeContext.builder().userId("u1").sessionId("sessB").build();
+
+        CompletableFuture<Msg> targetFuture =
+                agent.call(List.of(userMsg("hello-a")), target)
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+        CompletableFuture<Msg> bystanderFuture =
+                agent.call(List.of(userMsg("hello-b")), bystander)
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+
+        assertTrue(subscribed.await(5, TimeUnit.SECONDS), "both model streams should start");
+        agent.interrupt("u1", "sessA", new UserMessage("stop"));
+
+        Msg interrupted = targetFuture.get(5, TimeUnit.SECONDS);
+        assertEquals(GenerateReason.INTERRUPTED, interrupted.getGenerateReason());
+        assertEquals(
+                "I noticed that you have interrupted me. What can I do for you?",
+                interrupted.getTextContent());
+
+        Msg completed = bystanderFuture.get(5, TimeUnit.SECONDS);
+        assertEquals(GenerateReason.MODEL_STOP, completed.getGenerateReason());
+        assertEquals("model reply", completed.getTextContent());
+
+        ReActAgent reborn = agent(store);
+        assertTrue(
+                allText(reborn.getAgentState("u1", "sessA"))
+                        .contains("I noticed that you have interrupted me. What can I do for you?"),
+                "interrupt recovery message should be persisted for the targeted session");
+        assertFalse(
+                allText(reborn.getAgentState("u1", "sessB"))
+                        .contains("I noticed that you have interrupted me. What can I do for you?"),
+                "non-targeted session must not receive the recovery message");
+    }
+
     private static final class DelayedFirstChunkModel extends ChatModelBase {
         private final CountDownLatch subscribed;
 
