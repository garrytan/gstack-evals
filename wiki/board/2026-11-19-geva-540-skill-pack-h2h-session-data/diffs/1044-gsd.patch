+func newIndexDesc(id string) ocispec.Descriptor {
+	d := newDesc(id)
+	d.MediaType = ocispec.MediaTypeImageIndex
+	return d
+}
+
+func TestDispatchDeduplicatesGraphNodes(t *testing.T) {
+	root := newIndexDesc("root")
+	shared := newIndexDesc("shared")
+	leaf := newDesc("leaf")
+
+	children := make([]ocispec.Descriptor, 1000)
+	for i := range children {
+		children[i] = shared
+	}
+	var sharedCalls atomic.Int32
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		switch desc.Digest {
+		case root.Digest:
+			return children, nil
+		case shared.Digest:
+			sharedCalls.Add(1)
+			return []ocispec.Descriptor{leaf}, nil
+		}
+		return nil, nil
+	})
+	require.NoError(t, DispatchUnique(context.Background(), handler, nil, root))
+	assert.Equal(t, int32(1), sharedCalls.Load())
+
+	sharedCalls.Store(0)
+	require.NoError(t, Dispatch(context.Background(), handler, nil, root))
+	assert.Equal(t, int32(len(children)), sharedCalls.Load())
+}
+
+func TestDispatchDiamondGraph(t *testing.T) {
+	// Each level references the next level twice; without deduplication
+	// this would require 2^n handler calls.
+	const levels = 30
+	nodes := make([]ocispec.Descriptor, levels)
+	for i := range nodes {
+		nodes[i] = newIndexDesc(fmt.Sprintf("level-%d", i))
+	}
+	next := map[digest.Digest][]ocispec.Descriptor{}
+	for i := 0; i < levels-1; i++ {
+		next[nodes[i].Digest] = []ocispec.Descriptor{nodes[i+1], nodes[i+1]}
+	}
+	var calls atomic.Int32
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls.Add(1)
+		return next[desc.Digest], nil
+	})
+	require.NoError(t, DispatchUnique(context.Background(), handler, nil, nodes[0]))
+	assert.Equal(t, int32(levels), calls.Load())
+
+	// Without deduplication the reference limit bounds the work.
+	calls.Store(0)
+	require.ErrorIs(t, Dispatch(context.Background(), handler, nil, nodes[0]), errdefs.ErrResourceExhausted)
+	assert.LessOrEqual(t, calls.Load(), int32(maxReferences))
+}
+
+func TestDepthLimit(t *testing.T) {
+	chain := map[digest.Digest][]ocispec.Descriptor{}
+	nodes := make([]ocispec.Descriptor, maxDepth+1)
+	for i := range nodes {
+		nodes[i] = newIndexDesc(fmt.Sprintf("depth-%d", i))
+	}
+	for i := 0; i < len(nodes)-1; i++ {
+		chain[nodes[i].Digest] = []ocispec.Descriptor{nodes[i+1]}
+	}
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		return chain[desc.Digest], nil
+	})
+	require.ErrorIs(t, Dispatch(context.Background(), handler, nil, nodes[0]), errdefs.ErrResourceExhausted)
+	require.ErrorIs(t, DispatchUnique(context.Background(), handler, nil, nodes[0]), errdefs.ErrResourceExhausted)
+	require.ErrorIs(t, Walk(context.Background(), handler, nodes[0]), errdefs.ErrResourceExhausted)
+
+	// One level shallower is accepted.
+	require.NoError(t, Dispatch(context.Background(), handler, nil, nodes[1]))
+	require.NoError(t, Walk(context.Background(), handler, nodes[1]))
+}
