+func TestBuildProxyURLRejectsTraversal(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name      string
+		namespace string
+		resource  string
+		path      string
+	}{
+		{name: "dot dot in proxy path", namespace: "default", resource: "nginx", path: "/../../../../kube-system/secrets"},
+		{name: "single dot dot in proxy path", namespace: "default", resource: "nginx", path: "/.."},
+		{name: "dot dot in middle of proxy path", namespace: "default", resource: "nginx", path: "/a/../../b"},
+		{name: "backslash dot dot in proxy path", namespace: "default", resource: "nginx", path: "/..\\..\\secrets"},
+		{name: "dot dot resource name", namespace: "default", resource: "..", path: "/"},
+		{name: "dot resource name", namespace: "default", resource: ".", path: "/"},
+		{name: "slash in resource name", namespace: "default", resource: "../../../kube-system/secrets/x", path: ""},
+		{name: "slash in resource name no dots", namespace: "default", resource: "a/b", path: ""},
+		{name: "empty resource name", namespace: "default", resource: "", path: ""},
+		{name: "slash in namespace", namespace: "default/../kube-system", resource: "nginx", path: ""},
+		{name: "dot dot namespace", namespace: "..", resource: "nginx", path: ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := buildProxyURL("https://example.com", "pods", tt.namespace, tt.resource, tt.path, "")
+			if err == nil {
+				t.Fatalf("expected error, got url %q", got)
+			}
+		})
+	}
+}
