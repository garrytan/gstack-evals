+// validateProxySegment ensures a value is a single, non-traversing path segment.
+func validateProxySegment(field, value string) error {
+	if value == "" {
+		return fmt.Errorf("invalid %s: must not be empty", field)
+	}
+	if value == "." || value == ".." || strings.ContainsAny(value, "/\\") {
+		return fmt.Errorf("invalid %s", field)
+	}
+	return nil
+}
+
+// validateProxyPath rejects dot segments that would let url.JoinPath escape the proxy prefix.
+func validateProxyPath(path string) error {
+	for _, segment := range strings.FieldsFunc(path, func(r rune) bool { return r == '/' || r == '\\' }) {
+		if segment == "." || segment == ".." {
+			return errors.New("invalid proxy path: dot segments are not allowed")
+		}
+	}
+	return nil
+}
