+package handshake
+
+import (
+	"testing"
+
+	"github.com/pion/dtls/v3/internal/ciphersuite/types"
+)
+
+func TestServerKeyExchangeEcdhePskEmptyAfterHint(t *testing.T) {
+	for _, d := range [][]byte{{0x00, 0x00}, {0x00, 0x01, 0xaa}} {
+		m := &MessageServerKeyExchange{KeyExchangeAlgorithm: types.KeyExchangeAlgorithmEcdhe | types.KeyExchangeAlgorithmPsk}
+		if err := m.Unmarshal(d); err == nil {
+			t.Fatal("expected error")
+		}
+	}
+}
