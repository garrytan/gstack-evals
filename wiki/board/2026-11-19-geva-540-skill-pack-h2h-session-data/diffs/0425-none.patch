+        /// <summary>
+        /// Get the modules that a candidate for the given reason must not conflict with.
+        /// When gathering recommendations and suggestions, optional mods
+        /// should not be hidden just because they conflict with other optional mods,
+        /// since the user will choose among them; only check them against
+        /// the mods that are definitely being installed.
+        /// </summary>
+        private IReadOnlyCollection<CkanModule> ConflictCheckModules(SelectionReason             reason,
+                                                                     RelationshipResolverOptions options)
+            => options.get_recommenders && IsOptional(reason)
+                   ? Dependencies().Concat(user_requested_mods).Distinct().ToArray()
+                   : modlist.Values;
+
+        private static bool IsOptional(SelectionReason reason)
+            => reason is SelectionReason.Recommended or SelectionReason.Suggested;
+
