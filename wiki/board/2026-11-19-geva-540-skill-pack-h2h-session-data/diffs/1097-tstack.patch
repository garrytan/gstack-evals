diff --git a/api/projects/project_middleware_test.go b/api/projects/project_middleware_test.go
new file mode 100644
index 0000000..15b1a45
--- /dev/null
+++ b/api/projects/project_middleware_test.go
@@ -0,0 +1,46 @@
+package projects
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gorilla/mux"
+	"github.com/semaphoreui/semaphore/api/helpers"
+	"github.com/semaphoreui/semaphore/db"
+	"github.com/semaphoreui/semaphore/db/bolt"
+	"github.com/semaphoreui/semaphore/pkg/tz"
+	"github.com/stretchr/testify/require"
+)
+
+// A custom role whose slug collides with a built-in role must not override
+// the built-in role's permissions (manager -> owner escalation).
+func TestProjectMiddleware_BuiltinRoleNotOverriddenByCustomRole(t *testing.T) {
+	store := bolt.CreateTestStore()
+
+	usr, err := store.CreateUser(db.UserWithPwd{Pwd: "123456", User: db.User{Email: "m@example.com", Name: "M", Username: "mgr"}})
+	require.NoError(t, err)
+	proj, err := store.CreateProject(db.Project{Created: tz.Now(), Name: "P"})
+	require.NoError(t, err)
+	_, err = store.CreateProjectUser(db.ProjectUser{ProjectID: proj.ID, UserID: usr.ID, Role: db.ProjectManager})
+	require.NoError(t, err)
+
+	// Simulate an attacker-created role row colliding with the built-in slug.
+	_, err = store.CreateRole(db.Role{Slug: string(db.ProjectManager), Name: "pwn", Permissions: db.AllProjectUserPermissions, ProjectID: &proj.ID})
+	require.NoError(t, err)
+
+	var got db.ProjectUserPermission
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got = helpers.GetFromContext(r, "permissions").(db.ProjectUserPermission)
+	})
+
+	req := httptest.NewRequest(http.MethodGet, "/api/project/1", nil)
+	req = mux.SetURLVars(req, map[string]string{"project_id": "1"})
+	req = helpers.SetContextValue(req, "store", db.Store(store))
+	req = helpers.SetContextValue(req, "user", &usr)
+	ProjectMiddleware(next).ServeHTTP(httptest.NewRecorder(), req)
+
+	require.Equal(t, db.ProjectManager.GetPermissions(), got)
+	require.Zero(t, got&db.CanUpdateProject)
+	require.Zero(t, got&db.CanManageProjectUsers)
+}
