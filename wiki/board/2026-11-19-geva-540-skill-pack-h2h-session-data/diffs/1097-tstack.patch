+package sql
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/semaphoreui/semaphore/db"
+	"github.com/semaphoreui/semaphore/pkg/tz"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSqlDb_GetProjectOrGlobalRoleBySlug_ScopedToProject(t *testing.T) {
+	store := CreateTestStore()
+
+	p1, err := store.CreateProject(db.Project{Created: tz.Now(), Name: "P1"})
+	require.NoError(t, err)
+	p2, err := store.CreateProject(db.Project{Created: tz.Now(), Name: "P2"})
+	require.NoError(t, err)
+
+	_, err = store.CreateRole(db.Role{Slug: "deployer", Name: "Deployer", Permissions: 15, ProjectID: &p2.ID})
+	require.NoError(t, err)
+
+	_, err = store.GetProjectOrGlobalRoleBySlug(p1.ID, "deployer")
+	require.True(t, errors.Is(err, db.ErrNotFound), "role from another project must not be returned")
+
+	role, err := store.GetProjectOrGlobalRoleBySlug(p2.ID, "deployer")
+	require.NoError(t, err)
+	require.Equal(t, 15, int(role.Permissions))
+}
