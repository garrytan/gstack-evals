new file mode 100644
index 0000000..dc2f148
--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,30 @@
+package db
+
+import "testing"
+
+func TestValidateRoleRejectsBuiltinSlugs(t *testing.T) {
+	for _, slug := range []ProjectUserRole{ProjectOwner, ProjectManager, ProjectTaskRunner, ProjectGuest} {
+		err := ValidateRole(Role{Slug: string(slug), Name: "pwn", Permissions: CanRunProjectTasks})
+		if err == nil {
+			t.Fatalf("expected built-in slug %q to be rejected", slug)
+		}
+	}
+}
+
+func TestValidateRoleRejectsUnknownPermissions(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "custom", Name: "c", Permissions: AllProjectUserPermissions + 1}); err == nil {
+		t.Fatal("expected unknown permission bits to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "c", Permissions: -1}); err == nil {
+		t.Fatal("expected negative permissions to be rejected")
+	}
+}
+
+func TestValidateRoleAcceptsCustomRole(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "deployer", Name: "Deployer", Permissions: AllProjectUserPermissions}); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if err := ValidateRole(Role{Slug: "", Name: "x"}); err == nil {
+		t.Fatal("expected empty slug to be rejected")
+	}
+}
