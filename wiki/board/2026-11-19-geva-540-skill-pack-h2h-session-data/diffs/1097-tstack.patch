@@ -0,0 +1,24 @@
+package bolt
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/semaphoreui/semaphore/db"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBoltDb_GetProjectOrGlobalRoleBySlug_ScopedToProject(t *testing.T) {
+	store := CreateTestStore()
+
+	otherProject := 2
+	_, err := store.CreateRole(db.Role{Slug: "deployer", Name: "Deployer", Permissions: 15, ProjectID: &otherProject})
+	require.NoError(t, err)
+
+	_, err = store.GetProjectOrGlobalRoleBySlug(1, "deployer")
+	require.True(t, errors.Is(err, db.ErrNotFound), "role from another project must not be returned")
+
+	role, err := store.GetProjectOrGlobalRoleBySlug(otherProject, "deployer")
+	require.NoError(t, err)
+	require.Equal(t, "deployer", role.Slug)
+}
