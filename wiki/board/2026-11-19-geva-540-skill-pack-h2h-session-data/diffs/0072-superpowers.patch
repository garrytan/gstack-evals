@@ -0,0 +1,59 @@
+package io.github.hectorvent.floci.services.s3;
+
+import io.quarkus.test.junit.QuarkusTest;
+import org.junit.jupiter.api.MethodOrderer;
+import org.junit.jupiter.api.Order;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.TestMethodOrder;
+
+import static io.restassured.RestAssured.given;
+import static org.hamcrest.Matchers.containsString;
+
+@QuarkusTest
+@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
+class S3DeleteBucketReplicationIntegrationTest {
+
+    private static final String BUCKET = "delete-replication-int-test";
+
+    @Test
+    @Order(1)
+    void createBucket() {
+        given().when().put("/" + BUCKET).then().statusCode(200);
+    }
+
+    @Test
+    @Order(2)
+    void deleteBucketReplicationReturns204() {
+        given().when().delete("/" + BUCKET + "?replication").then().statusCode(204);
+    }
+
+    @Test
+    @Order(3)
+    void bucketStillExistsAfterDeleteReplication() {
+        given().when().head("/" + BUCKET).then().statusCode(200);
+    }
+
+    @Test
+    @Order(4)
+    void otherUnmodelledSubResourceDeletesDoNotDeleteBucket() {
+        for (String q : new String[]{"analytics&id=a", "inventory&id=i", "metrics&id=m",
+                "intelligent-tiering&id=t", "metadataTable"}) {
+            given().when().delete("/" + BUCKET + "?" + q).then().statusCode(204);
+        }
+        given().when().head("/" + BUCKET).then().statusCode(200);
+    }
+
+    @Test
+    @Order(5)
+    void deleteBucketReplicationOnMissingBucketReturns404() {
+        given().when().delete("/no-such-bucket-replication-test?replication")
+            .then().statusCode(404).body(containsString("NoSuchBucket"));
+    }
+
+    @Test
+    @Order(6)
+    void deleteBucket() {
+        given().when().delete("/" + BUCKET).then().statusCode(204);
+        given().when().head("/" + BUCKET).then().statusCode(404);
+    }
+}
