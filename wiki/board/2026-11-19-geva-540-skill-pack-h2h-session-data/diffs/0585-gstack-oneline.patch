+// automationPolicyCoveredByWildcardManagers returns true if every subject of
+// aps[i] is covered by a wildcard subject of another policy that has certificate
+// managers configured, and none of the subjects are forced to be automated.
+func automationPolicyCoveredByWildcardManagers(i int, aps []*caddytls.AutomationPolicy, forcedAutomatedNames map[string]struct{}) bool {
+	if len(aps[i].SubjectsRaw) == 0 {
+		return false
+	}
+	for _, subj := range aps[i].SubjectsRaw {
+		if _, ok := forcedAutomatedNames[subj]; ok {
+			return false
+		}
+		covered := false
+		for j, other := range aps {
+			if j == i || len(other.ManagersRaw) == 0 {
+				continue
+			}
+			if slices.ContainsFunc(other.SubjectsRaw, func(otherSubj string) bool {
+				return strings.Contains(otherSubj, "*") && certmagic.MatchWildcard(subj, otherSubj)
+			}) {
+				covered = true
+				break
+			}
+		}
+		if !covered {
+			return false
+		}
+	}
+	return true
+}
