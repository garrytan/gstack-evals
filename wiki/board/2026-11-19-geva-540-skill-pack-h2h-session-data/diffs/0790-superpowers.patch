+import { flushSync } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	html: `<button>click</button>`,
+
+	test({ assert, target }) {
+		const btn = target.querySelector('button');
+
+		flushSync(() => btn?.click());
+		assert.htmlEqual(target.innerHTML, `<button>click</button> false`);
+
+		flushSync(() => btn?.click());
+		assert.htmlEqual(target.innerHTML, `<button>click</button>`);
+	}
+});
