+func TestEcho_StaticFS_encodedSlashDoesNotBypassGroupMiddleware(t *testing.T) {
+	e := New()
+	deny := func(next HandlerFunc) HandlerFunc {
+		return func(c *Context) error { return ErrForbidden }
+	}
+	g := e.Group("/images", deny)
+	g.GET("/*", func(c *Context) error { return c.String(http.StatusOK, "secret") })
+	e.StaticFS("/", os.DirFS("_fixture/"))
+
+	for _, u := range []string{"/images/walle.png", "/images%2Fwalle.png", "/images%2fwalle.png", "/images%5Cwalle.png"} {
+		req := httptest.NewRequest(http.MethodGet, u, nil)
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		assert.NotEqual(t, http.StatusOK, rec.Code, u)
+	}
+}
