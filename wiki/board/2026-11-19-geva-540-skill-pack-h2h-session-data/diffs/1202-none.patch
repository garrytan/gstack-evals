@@ -890,3 +896,16 @@ func sanitizeURI(uri string) string {
 	}
 	return uri
 }
+
+// containsEncodedPathSeparator checks if given (escaped) path contains percent-encoded path separators (`%2F` or `%5C`).
+func containsEncodedPathSeparator(p string) bool {
+	for i := 0; i+2 < len(p); i++ {
+		if p[i] != '%' {
+			continue
+		}
+		if (p[i+1] == '2' && (p[i+2] == 'f' || p[i+2] == 'F')) || (p[i+1] == '5' && (p[i+2] == 'c' || p[i+2] == 'C')) {
+			return true
+		}
+	}
+	return false
+}
