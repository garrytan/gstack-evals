+func TestStatic_encodedSlashInGroupWildcardIsRejected(t *testing.T) {
+	e := echo.New()
+	g := e.Group("/static")
+	g.Use(StaticWithConfig(StaticConfig{Root: "testdata/dist/public"}))
+	g.GET("/*", func(c *echo.Context) error { return echo.ErrNotFound })
+
+	req := httptest.NewRequest(http.MethodGet, "/static/assets%2Freadme.md", nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	assert.Equal(t, http.StatusNotFound, rec.Code)
+
+	req = httptest.NewRequest(http.MethodGet, "/static/assets/readme.md", nil)
+	rec = httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	assert.Equal(t, http.StatusOK, rec.Code)
+}
