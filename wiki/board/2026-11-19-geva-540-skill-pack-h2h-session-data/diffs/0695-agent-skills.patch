+using System.Collections.Specialized;
+
+using Quartz.Impl;
+using Quartz.Simpl;
+using Quartz.Spi;
+
+namespace Quartz.Tests.Unit.Core;
+
+[TestFixture]
+[NonParallelizable]
+public class JobFactoryAsyncLocalTest
+{
+    private static readonly AsyncLocal<string> tenant = new();
+
+    private sealed class TenantSettingJobFactory : SimpleJobFactory
+    {
+        public override IJob NewJob(TriggerFiredBundle bundle, IScheduler scheduler)
+        {
+            tenant.Value = bundle.JobDetail.JobDataMap.GetString("tenant");
+            return base.NewJob(bundle, scheduler);
+        }
+    }
+
+    private sealed class TenantCapturingJob : IJob
+    {
+        public static readonly TaskCompletionSource<string> Observed = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        public ValueTask Execute(IJobExecutionContext context)
+        {
+            Observed.TrySetResult(tenant.Value ?? "<null>");
+            return default;
+        }
+    }
+
+    [Test]
+    public async Task AsyncLocalSetInJobFactoryFlowsToJobExecution()
+    {
+        NameValueCollection properties = new NameValueCollection
+        {
+            ["quartz.scheduler.instanceName"] = "JobFactoryAsyncLocalTest",
+            ["quartz.serializer.type"] = TestConstants.DefaultSerializerType
+        };
+        IScheduler scheduler = await new StdSchedulerFactory(properties).GetScheduler();
+        scheduler.JobFactory = new TenantSettingJobFactory();
+
+        try
+        {
+            IJobDetail job = JobBuilder.Create<TenantCapturingJob>()
+                .WithIdentity("job")
+                .UsingJobData("tenant", "001")
+                .Build();
+            ITrigger trigger = TriggerBuilder.Create().WithIdentity("trigger").StartNow().Build();
+
+            await scheduler.ScheduleJob(job, trigger);
+            await scheduler.Start();
+
+            Task completed = await Task.WhenAny(TenantCapturingJob.Observed.Task, Task.Delay(TimeSpan.FromSeconds(10)));
+            Assert.That(completed, Is.SameAs(TenantCapturingJob.Observed.Task), "job did not run in time");
+            Assert.That(await TenantCapturingJob.Observed.Task, Is.EqualTo("001"));
+        }
+        finally
+        {
+            await scheduler.Shutdown(waitForJobsToComplete: true);
+        }
+    }
+}
