diff --git a/app/kuma-dp/pkg/dataplane/metrics/extra_labels_gatherer.go b/app/kuma-dp/pkg/dataplane/metrics/extra_labels_gatherer.go
new file mode 100644
index 0000000..4cf77ba
--- /dev/null
+++ b/app/kuma-dp/pkg/dataplane/metrics/extra_labels_gatherer.go
@@ -0,0 +1,70 @@
+package metrics
+
+import (
+	"sort"
+	"sync/atomic"
+
+	prom_client "github.com/prometheus/client_golang/prometheus"
+	io_prometheus_client "github.com/prometheus/client_model/go"
+	"github.com/prometheus/otlptranslator"
+	"google.golang.org/protobuf/proto"
+)
+
+// extraLabelsGatherer adds MeshMetric extra labels to metrics that kuma-dp
+// registers natively (e.g. DNS proxy metrics), so they carry the same
+// workload, mesh, zone and namespace labels that the OTel bridge adds to Envoy metrics.
+type extraLabelsGatherer struct {
+	inner  prom_client.Gatherer
+	labels atomic.Pointer[[]*io_prometheus_client.LabelPair]
+}
+
+var _ prom_client.Gatherer = &extraLabelsGatherer{}
+
+func newExtraLabelsGatherer(inner prom_client.Gatherer) *extraLabelsGatherer {
+	return &extraLabelsGatherer{inner: inner}
+}
+
+// setLabels translates attribute names with the same rules as the OTel
+// Prometheus exporter, so "kuma.workload" becomes "kuma_workload".
+func (g *extraLabelsGatherer) setLabels(extraLabels map[string]string) {
+	namer := otlptranslator.LabelNamer{}
+	pairs := make([]*io_prometheus_client.LabelPair, 0, len(extraLabels))
+	for k, v := range extraLabels {
+		name, err := namer.Build(k)
+		if err != nil {
+			logger.Error(err, "skipping invalid extra label", "label", k)
+			continue
+		}
+		pairs = append(pairs, &io_prometheus_client.LabelPair{Name: proto.String(name), Value: proto.String(v)})
+	}
+	g.labels.Store(&pairs)
+}
+
+func (g *extraLabelsGatherer) Gather() ([]*io_prometheus_client.MetricFamily, error) {
+	families, err := g.inner.Gather()
+	extra := g.labels.Load()
+	if extra == nil || len(*extra) == 0 {
+		return families, err
+	}
+	for _, family := range families {
+		for _, metric := range family.Metric {
+			metric.Label = withExtraLabels(metric.Label, *extra)
+		}
+	}
+	return families, err
+}
+
+func withExtraLabels(existing, extra []*io_prometheus_client.LabelPair) []*io_prometheus_client.LabelPair {
+	present := make(map[string]struct{}, len(existing))
+	for _, l := range existing {
+		present[l.GetName()] = struct{}{}
+	}
+	result := existing
+	for _, l := range extra {
+		if _, ok := present[l.GetName()]; !ok {
+			result = append(result, l)
+		}
+	}
+	sort.Slice(result, func(i, j int) bool { return result[i].GetName() < result[j].GetName() })
+	return result
+}
diff --git a/app/kuma-dp/pkg/dataplane/metrics/extra_labels_gatherer_test.go b/app/kuma-dp/pkg/dataplane/metrics/extra_labels_gatherer_test.go
