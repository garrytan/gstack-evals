@@ -0,0 +1,80 @@
+package metrics
+
+import (
+	"context"
+	"io"
+	"net"
+	"net/http"
+	"path/filepath"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	prom_client "github.com/prometheus/client_golang/prometheus"
+
+	meshmetric_plugin "github.com/kumahq/kuma/v2/pkg/plugins/policies/meshmetric/plugin/v1alpha1"
+)
+
+var _ = Describe("Hijacker MeshMetric endpoint", func() {
+	var socketPath string
+	var stop chan struct{}
+	var hijacker *Hijacker
+	var histogram prom_client.Histogram
+
+	BeforeEach(func() {
+		histogram = prom_client.NewHistogram(prom_client.HistogramOpts{
+			Name: "kuma_dp_test_dns_request_duration_seconds",
+			Help: "test",
+		})
+		Expect(prom_client.Register(histogram)).To(Succeed())
+		histogram.Observe(0.1)
+
+		socketPath = filepath.Join(GinkgoT().TempDir(), "hijacker.sock")
+		hijacker = New(socketPath, nil, false, NewAggregatedMetricsProducer(nil, false, "test"))
+		stop = make(chan struct{})
+		go func() {
+			defer GinkgoRecover()
+			Expect(hijacker.Start(stop)).To(Succeed())
+		}()
+	})
+
+	AfterEach(func() {
+		close(stop)
+		prom_client.Unregister(histogram)
+	})
+
+	scrape := func() string {
+		client := http.Client{Transport: &http.Transport{
+			DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+				return (&net.Dialer{}).DialContext(ctx, "unix", socketPath)
+			},
+		}}
+		var body string
+		Eventually(func(g Gomega) {
+			resp, err := client.Get("http://hijacker" + meshmetric_plugin.PrometheusDataplaneStatsPath)
+			g.Expect(err).ToNot(HaveOccurred())
+			defer resp.Body.Close()
+			g.Expect(resp.StatusCode).To(Equal(http.StatusOK))
+			b, err := io.ReadAll(resp.Body)
+			g.Expect(err).ToNot(HaveOccurred())
+			body = string(b)
+		}).Should(Succeed())
+		return body
+	}
+
+	It("should add extra labels to kuma-dp native metrics", func() {
+		hijacker.SetExtraLabels(map[string]string{
+			"kuma.workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"k8s_kuma_io_namespace": "kuma-demo",
+			"kuma_io_zone":          "zone-1",
+			"mesh":                  "default",
+		})
+
+		Expect(scrape()).To(ContainSubstring(
+			`kuma_dp_test_dns_request_duration_seconds_count{k8s_kuma_io_namespace="kuma-demo",kuma_io_zone="zone-1",kuma_workload="kri_wl_default_zone-1_kuma-demo_demo-app_",mesh="default"} 1`,
+		))
+	})
+
+	It("should serve native metrics without labels when none are configured", func() {
+		Expect(scrape()).To(ContainSubstring("kuma_dp_test_dns_request_duration_seconds_count 1"))
+	})
+})
