+package fsext
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A ".*" gitignore pattern must not match the walk root itself.
+func TestDotStarGitignoreDoesNotSkipRoot(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "example.txt"), []byte("x"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "another.go"), []byte("y"), 0o644))
+
+	oldWd, _ := os.Getwd()
+	require.NoError(t, os.Chdir(dir))
+	defer os.Chdir(oldWd)
+
+	for _, root := range []string{dir, "."} {
+		matches, _, err := GlobWithDoubleStar("**/*", root, 0)
+		require.NoError(t, err)
+		require.Len(t, matches, 2, "glob root %q: %v", root, matches)
+
+		files, _, err := ListDirectory(root, nil, 0)
+		require.NoError(t, err)
+		require.Len(t, files, 2, "list root %q: %v", root, files)
+	}
+}
