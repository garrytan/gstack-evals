--- /dev/null
+++ b/.changeset/quiet-beds-bind.md
@@ -0,0 +1,5 @@
+---
+'svelte': patch
+---
+
+fix: update focused input when a function binding's getter returns a stale value
diff --git a/packages/svelte/src/internal/client/dom/elements/bindings/input.js b/packages/svelte/src/internal/client/dom/elements/bindings/input.js
index 67e6ff1..24f0d58 100644
--- a/packages/svelte/src/internal/client/dom/elements/bindings/input.js
+++ b/packages/svelte/src/internal/client/dom/elements/bindings/input.js
@@ -32,10 +32,6 @@ export function bind_value(input, get, set = get) {
 		value = is_numberlike_input(input) ? to_number(value) : value;
 		set(value);
 
-		if (current_batch !== null) {
-			batches.add(current_batch);
-		}
-
 		// In runes mode, respect any validation in accessors (doesn't apply in legacy mode,
 		// because we use mutable state which ensures the render effect always runs)
 		if (runes && value !== (value = get())) {
@@ -50,6 +46,12 @@ export function bind_value(input, get, set = get) {
 				input.selectionStart = start;
 				input.selectionEnd = Math.min(end, input.value.length);
 			}
+		} else if (current_batch !== null) {
+			// The input reflects the latest value, so the resulting render effect must not
+			// overwrite it while focused. If we did reset it above (e.g. because the getter
+			// returned a stale value, as can happen inside an each block), we must allow the
+			// render effect to update the input once the new value is available.
+			batches.add(current_batch);
 		}
 	});
 
