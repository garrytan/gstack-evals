+
+func TestURI_StringEscapesTLSParameters(t *testing.T) {
+	orig := URI{
+		Scheme:     "amqps",
+		Host:       "example.com",
+		Port:       5671,
+		Username:   "guest",
+		Password:   "guest",
+		Vhost:      "/",
+		CertFile:   "/tmp/cert=foo&keyfile=/evil/path",
+		KeyFile:    "/original/key.pem",
+		CACertFile: "/ca.pem?x=1&cacertfile=/tmp/fake_ca.crt#frag",
+		ServerName: "example.com&certfile=/evil",
+	}
+	parsed, err := ParseURI(orig.String())
+	if err != nil {
+		t.Fatalf("ParseURI(%q) error: %v", orig.String(), err)
+	}
+	if parsed.CertFile != orig.CertFile {
+		t.Errorf("CertFile = %q, want %q", parsed.CertFile, orig.CertFile)
+	}
+	if parsed.KeyFile != orig.KeyFile {
+		t.Errorf("KeyFile = %q, want %q", parsed.KeyFile, orig.KeyFile)
+	}
+	if parsed.CACertFile != orig.CACertFile {
+		t.Errorf("CACertFile = %q, want %q", parsed.CACertFile, orig.CACertFile)
+	}
+	if parsed.ServerName != orig.ServerName {
+		t.Errorf("ServerName = %q, want %q", parsed.ServerName, orig.ServerName)
+	}
+}
