@@ -0,0 +1,27 @@
+amends ".../snippetTest.pkl"
+
+import "pkl:yaml"
+
+local strings = new Listing<String> {
+  "\t\\d"
+  "\\"
+  "a\\b"
+  "\\\""
+  "\n\\n"
+}
+
+facts {
+  ["round-trip"] {
+    for (s in strings) {
+      new yaml.Parser {}.parse(new YamlRenderer {}.renderValue(s)) == s
+    }
+  }
+}
+
+examples {
+  ["rendered"] {
+    for (s in strings) {
+      new YamlRenderer {}.renderValue(s)
+    }
+  }
+}
