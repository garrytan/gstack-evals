+// Test that a translated symlink can't be used to escape the destination
+func TestSymlinkEscape(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlink escape test not supported on Windows")
+	}
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	f := r.Flocal.(*Fs)
+	f.opt.FollowSymlinks = false
+	f.opt.TranslateSymlinks = true
+	f.lstat = os.Lstat
+
+	outside := t.TempDir()
+
+	put := func(remote, contents string) error {
+		src := object.NewStaticObjectInfo(remote, time.Now(), int64(len(contents)), true, nil, nil)
+		_, err := f.Put(ctx, bytes.NewBufferString(contents), src)
+		return err
+	}
+
+	for _, target := range []string{
+		outside,
+		"/etc",
+		"..",
+		"../",
+		"../escape",
+		"sub/../../escape",
+		"sub/../../../",
+		"",
+	} {
+		t.Run(fmt.Sprintf("Target=%q", target), func(t *testing.T) {
+			err := put("pwn"+fs.LinkSuffix, target)
+			require.Error(t, err)
+			_, err = os.Lstat(filepath.Join(f.root, "pwn"))
+			assert.True(t, os.IsNotExist(err), "symlink should not have been created")
+		})
+	}
+
+	// Deep links which stay inside the root are allowed
+	require.NoError(t, put("a/b/ok"+fs.LinkSuffix, "../c/../x"))
+	linkText, err := os.Readlink(filepath.Join(f.root, "a", "b", "ok"))
+	require.NoError(t, err)
+	assert.Equal(t, "../c/../x", linkText)
+	require.NoError(t, put("ok2"+fs.LinkSuffix, "sub/./file.txt"))
+
+	// A deep link escaping is not allowed
+	require.Error(t, put("a/b/bad"+fs.LinkSuffix, "../../../x"))
+
+	// Simulate a symlink to outside planted in the destination
+	// and check we don't write through it
+	require.NoError(t, os.Symlink(outside, filepath.Join(f.root, "planted")))
+	err = put("planted/authorized_keys", "ATTACKER KEY")
+	require.Error(t, err)
+	err = put("planted/deeper/authorized_keys", "ATTACKER KEY")
+	require.Error(t, err)
+	err = put("planted/x"+fs.LinkSuffix, "y")
+	require.Error(t, err)
+	entries, err := os.ReadDir(outside)
+	require.NoError(t, err)
+	assert.Empty(t, entries, "nothing should be written outside the destination")
+}
