+
+func TestSanitizeFilePath(t *testing.T) {
+	tests := []struct {
+		name    string
+		path    string
+		safedir string
+		wantErr bool
+	}{
+		{"file inside safe dir", "/packages/foo.zip", "/packages", false},
+		{"nested file inside safe dir", "/packages/ns/name", "/packages", false},
+		{"safe dir with trailing slash", "/packages/foo", "/packages/", false},
+		{"dot-dot-prefixed name inside", "/packages/..foo", "/packages", false},
+		{"sibling dir with shared prefix", "/packages-extra/evil", "/packages", true},
+		{"sibling file with shared prefix", "/packagesevil", "/packages", true},
+		{"parent dir", "/", "/packages", true},
+		{"traversal not normalized", "/packages/../etc/passwd", "/packages", true},
+		{"traversal via join", filepath.Join("/packages", "../packages-extra/evil"), "/packages", true},
+		{"outside entirely", "/etc/passwd", "/packages", true},
+		{"relative path vs absolute safedir", "packages/foo", "/packages", true},
+		{"empty path", "", "/packages", true},
+		{"empty safedir", "/packages/foo", "", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := SanitizeFilePath(tt.path, tt.safedir)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("SanitizeFilePath(%q, %q) err = %v, wantErr %v", tt.path, tt.safedir, err, tt.wantErr)
+			}
+		})
+	}
+}
