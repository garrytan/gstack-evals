+        /// <summary>
+        /// Check whether a path is the same as or inside another path,
+        /// after resolving relative segments like ".." and normalizing separators.
+        /// </summary>
+        /// <param name="path">The path that might be inside parent</param>
+        /// <param name="parent">The path that might contain path</param>
+        /// <returns>true if path is parent or a descendant of it, false otherwise</returns>
+        public static bool IsSameOrInside(string path, string parent)
+        {
+            var child = NormalizePath(Path.GetFullPath(path));
+            var root  = NormalizePath(Path.GetFullPath(parent));
+            return child.Equals(root, Platform.PathComparison)
+                   || child.StartsWith(root.EndsWith("/") ? root : $"{root}/",
+                                       Platform.PathComparison);
+        }
+
     }
 }
