diff --git a/packages/mcp-tools/src/tools/jobs/space-to-space-migration/migrationOptions.ts b/packages/mcp-tools/src/tools/jobs/space-to-space-migration/migrationOptions.ts
new file mode 100644
index 0000000..0273ab7
--- /dev/null
+++ b/packages/mcp-tools/src/tools/jobs/space-to-space-migration/migrationOptions.ts
@@ -0,0 +1,30 @@
+/**
+ * Options of contentful-export / contentful-import that control where requests
+ * (carrying the server's management token) are sent, or that load additional
+ * options from disk. These must never be controlled by tool-call arguments.
+ */
+const UNSAFE_OPTION_KEYS = [
+  'host',
+  'hostDelivery',
+  'port',
+  'insecure',
+  'proxy',
+  'rawProxy',
+  'httpAgent',
+  'httpsAgent',
+  'basePath',
+  'baseURL',
+  'config',
+  'managementToken',
+  'accessToken',
+] as const;
+
+export function stripUnsafeMigrationOptions<T extends Record<string, unknown>>(
+  args: T,
+): Omit<T, (typeof UNSAFE_OPTION_KEYS)[number]> {
+  const safe: Record<string, unknown> = { ...args };
+  for (const key of UNSAFE_OPTION_KEYS) {
+    delete safe[key];
+  }
+  return safe as Omit<T, (typeof UNSAFE_OPTION_KEYS)[number]>;
+}
