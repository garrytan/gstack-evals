+func TestBacktickInPackageComment(t *testing.T) {
+	stdout := &bytes.Buffer{}
+	stderr := &bytes.Buffer{}
+	code := ParseAndRun(stdout, stderr, nil, []string{"-d", "testdata/backtick_description", "-l"})
+	if code != 0 {
+		t.Log("stderr:", stderr)
+		t.Log("stdout:", stdout)
+		t.Fatal("unexpected code", code)
+	}
+	want := "This is a magefile, to be called with `go tool mage` (github.com/magefile/mage).\n\nTargets:"
+	if !strings.Contains(stdout.String(), want) {
+		t.Errorf("Could not find %q in output:\n%s", want, stdout.String())
+	}
+}
