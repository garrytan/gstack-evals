diff --git a/pkg/workflow/engine_version_expression.go b/pkg/workflow/engine_version_expression.go
new file mode 100644
index 0000000..946e767
--- /dev/null
+++ b/pkg/workflow/engine_version_expression.go
@@ -0,0 +1,29 @@
+package workflow
+
+import "strings"
+
+// engineVersionEnvVar is the environment variable used to pass a GitHub Actions
+// expression-valued engine version to install steps. Passing the value via an
+// environment variable (instead of interpolating it into the shell command)
+// ensures that the evaluated expression is never parsed as shell syntax,
+// preventing shell injection regardless of the expression's runtime value.
+const engineVersionEnvVar = "GH_AW_ENGINE_VERSION"
+
+// isEngineVersionExpression reports whether an engine version string contains a
+// GitHub Actions expression (e.g. "${{ inputs.engine-version }}") that must be
+// evaluated at runtime.
+func isEngineVersionExpression(version string) bool {
+	return strings.Contains(version, "${{")
+}
+
+// engineVersionEnvLines returns the YAML lines for a step-level env block that
+// exposes the given expression-valued version as engineVersionEnvVar.
+// The value is emitted as a single-quoted YAML scalar so that any characters in
+// the expression are preserved literally for GitHub Actions to evaluate.
+func engineVersionEnvLines(version string) []string {
+	quoted := "'" + strings.ReplaceAll(version, "'", "''") + "'"
+	return []string{
+		"        env:",
+		"          " + engineVersionEnvVar + ": " + quoted,
+	}
+}
diff --git a/pkg/workflow/engine_version_expression_test.go b/pkg/workflow/engine_version_expression_test.go
new file mode 100644
index 0000000..4c43f62
--- /dev/null
+++ b/pkg/workflow/engine_version_expression_test.go
@@ -0,0 +1,110 @@
+//go:build !integration
+
+package workflow
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func engineVersionStepsToString(steps []GitHubActionStep) string {
+	var sb strings.Builder
+	for _, step := range steps {
+		for _, line := range step {
+			sb.WriteString(line)
+			sb.WriteString("\n")
+		}
+	}
+	return sb.String()
+}
+
+func TestIsEngineVersionExpression(t *testing.T) {
+	assert.True(t, isEngineVersionExpression("${{ inputs.engine-version }}"))
+	assert.True(t, isEngineVersionExpression("1.${{ inputs.minor }}"))
+	assert.False(t, isEngineVersionExpression("1.2.3"))
+	assert.False(t, isEngineVersionExpression("latest"))
+	assert.False(t, isEngineVersionExpression(""))
+}
+
+func TestEngineVersionExpressionInstallSteps(t *testing.T) {
+	const expr = "${{ inputs.engine-version }}"
+
+	tests := []struct {
+		engineID    string
+		wantRunLine string
+	}{
+		{"copilot", `run: ${RUNNER_TEMP}/gh-aw/actions/install_copilot_cli.sh "${GH_AW_ENGINE_VERSION}"`},
+		{"claude", `run: npm install -g "@anthropic-ai/claude-code@${GH_AW_ENGINE_VERSION}"`},
+		{"codex", `run: npm install -g "@openai/codex@${GH_AW_ENGINE_VERSION}"`},
+		{"gemini", `run: npm install -g "@google/gemini-cli@${GH_AW_ENGINE_VERSION}"`},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.engineID, func(t *testing.T) {
+			engine, err := NewEngineRegistry().GetEngine(tt.engineID)
+			require.NoError(t, err)
+
+			data := &WorkflowData{
+				Name:         "test",
+				EngineConfig: &EngineConfig{ID: tt.engineID, Version: expr},
+			}
+			out := engineVersionStepsToString(engine.GetInstallationSteps(data))
+
+			assert.Contains(t, out, tt.wantRunLine, "install command should reference the env var")
+			assert.Contains(t, out, "GH_AW_ENGINE_VERSION: '"+expr+"'", "expression should be passed via env")
+			for line := range strings.SplitSeq(out, "\n") {
+				if strings.Contains(line, "run:") {
+					assert.NotContains(t, line, "${{", "expression must not be interpolated into a shell command: %s", line)
+				}
+			}
+		})
+	}
+}
+
+func TestEngineVersionLiteralInstallStepsUnchanged(t *testing.T) {
+	tests := []struct {
+		engineID    string
+		wantRunLine string
+	}{
+		{"copilot", "run: ${RUNNER_TEMP}/gh-aw/actions/install_copilot_cli.sh 1.2.3"},
+		{"claude", "run: npm install -g @anthropic-ai/claude-code@1.2.3"},
+		{"codex", "run: npm install -g @openai/codex@1.2.3"},
+		{"gemini", "run: npm install -g @google/gemini-cli@1.2.3"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.engineID, func(t *testing.T) {
+			engine, err := NewEngineRegistry().GetEngine(tt.engineID)
+			require.NoError(t, err)
+
+			data := &WorkflowData{
+				Name:         "test",
+				EngineConfig: &EngineConfig{ID: tt.engineID, Version: "1.2.3"},
+			}
+			out := engineVersionStepsToString(engine.GetInstallationSteps(data))
+			assert.Contains(t, out, tt.wantRunLine)
+			assert.NotContains(t, out, "GH_AW_ENGINE_VERSION")
+		})
+	}
+}
+
+func TestEngineVersionExpressionQuotesSingleQuotes(t *testing.T) {
+	lines := engineVersionEnvLines("${{ inputs.v || 'latest' }}")
+	require.Len(t, lines, 2)
+	assert.Equal(t, "          GH_AW_ENGINE_VERSION: '${{ inputs.v || ''latest'' }}'", lines[1])
+}
+
+func TestExtractEngineConfigAcceptsExpressionVersion(t *testing.T) {
+	c := NewCompiler()
+	_, config := c.ExtractEngineConfig(map[string]any{
+		"engine": map[string]any{
+			"id":      "copilot",
+			"version": "${{ inputs.engine-version }}",
+		},
+	})
+	require.NotNil(t, config)
+	assert.Equal(t, "${{ inputs.engine-version }}", config.Version)
+}
