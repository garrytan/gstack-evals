index 0000000..7ffed8b
--- /dev/null
+++ b/unstable/document.go
@@ -0,0 +1,217 @@
+package unstable
+
+import "fmt"
+
+// DocumentBuilder accumulates the root expressions of a TOML document (as
+// returned by Parser.Expression) and assembles them into a single InlineTable
+// node representing the whole document.
+//
+// Tables become nested InlineTable values, arrays of tables become Arrays of
+// InlineTable values, and dotted keys are expanded into nested tables. Every
+// KeyValue of the resulting tree has a single Key part. Leaf values are deep
+// copies of the parsed nodes and keep their Raw ranges; synthesized nodes have
+// an empty Raw range.
+//
+// DocumentBuilder does not check the document for semantic errors (such as
+// duplicate keys); callers are expected to do so before calling Add.
+type DocumentBuilder struct {
+	b       builder
+	root    *docTable
+	current *docTable
+}
+
+type docTable struct {
+	order   []*docEntry
+	entries map[string]*docEntry
+}
+
+type docEntryKind int
+
+const (
+	docLeaf docEntryKind = iota
+	docTableEntry
+	docArrayTable
+)
+
+type docEntry struct {
+	key    []byte
+	kind   docEntryKind
+	leaf   reference
+	table  *docTable
+	tables []*docTable
+}
+
+func newDocTable() *docTable {
+	return &docTable{entries: map[string]*docEntry{}}
+}
+
+func (t *docTable) get(key []byte) *docEntry {
+	return t.entries[string(key)]
+}
+
+func (t *docTable) put(e *docEntry) {
+	t.entries[string(e.key)] = e
+	t.order = append(t.order, e)
+}
+
+// subTable returns the table at key in t, creating it if needed. When key
+// refers to an array of tables, its last element is returned.
+func (t *docTable) subTable(key []byte) (*docTable, error) {
+	e := t.get(key)
+	if e == nil {
+		e = &docEntry{key: copyBytes(key), kind: docTableEntry, table: newDocTable()}
+		t.put(e)
+	}
+	switch e.kind {
+	case docTableEntry:
+		return e.table, nil
+	case docArrayTable:
+		return e.tables[len(e.tables)-1], nil
+	default:
+		return nil, fmt.Errorf("toml: key %s is already defined as a value", string(key))
+	}
+}
+
+func copyBytes(b []byte) []byte {
+	return append([]byte(nil), b...)
+}
+
+func (d *DocumentBuilder) init() {
+	if d.root == nil {
+		d.root = newDocTable()
+		d.current = d.root
+	}
+}
+
+// Add records a root expression (KeyValue, Table, or ArrayTable). The node is
+// copied, so it may be invalidated after Add returns.
+func (d *DocumentBuilder) Add(expr *Node) error {
+	d.init()
+
+	switch expr.Kind {
+	case KeyValue:
+		t := d.current
+		it := expr.Key()
+		for it.Next() {
+			k := it.Node().Data
+			if it.IsLast() {
+				if t.get(k) != nil {
+					return fmt.Errorf("toml: key %s is already defined", string(k))
+				}
+				t.put(&docEntry{key: copyBytes(k), kind: docLeaf, leaf: d.copyTree(expr.Value())})
+				return nil
+			}
+			var err error
+			t, err = t.subTable(k)
+			if err != nil {
+				return err
+			}
+		}
+	case Table:
+		t := d.root
+		it := expr.Key()
+		for it.Next() {
+			var err error
+			t, err = t.subTable(it.Node().Data)
+			if err != nil {
+				return err
+			}
+		}
+		d.current = t
+	case ArrayTable:
+		t := d.root
+		it := expr.Key()
+		for it.Next() {
+			k := it.Node().Data
+			if it.IsLast() {
+				e := t.get(k)
+				if e == nil {
+					e = &docEntry{key: copyBytes(k), kind: docArrayTable}
+					t.put(e)
+				} else if e.kind != docArrayTable {
+					return fmt.Errorf("toml: key %s is not an array of tables", string(k))
+				}
+				nt := newDocTable()
+				e.tables = append(e.tables, nt)
+				d.current = nt
+				return nil
+			}
+			var err error
+			t, err = t.subTable(k)
+			if err != nil {
+				return err
+			}
+		}
+	case Comment:
+		// ignored
+	default:
+		return fmt.Errorf("toml: unexpected expression of kind %s at document root", expr.Kind)
+	}
+	return nil
+}
+
+// Node returns the InlineTable node representing the whole document. The
+// builder must not be used after calling Node.
+func (d *DocumentBuilder) Node() *Node {
+	d.init()
+	ref := d.emitTable(d.root)
+	return d.b.NodeAt(ref)
+}
+
+func (d *DocumentBuilder) copyTree(n *Node) reference {
+	c := *n
+	c.next = 0
+	c.child = 0
+	ref := d.b.Push(c)
+
+	prev := invalidReference
+	it := n.Children()
+	for it.Next() {
+		cref := d.copyTree(it.Node())
+		if prev.Valid() {
+			d.b.Chain(prev, cref)
+		} else {
+			d.b.AttachChild(ref, cref)
+		}
+		prev = cref
+	}
+	return ref
+}
+
+func (d *DocumentBuilder) emitTable(t *docTable) reference {
+	ref := d.b.Push(Node{Kind: InlineTable})
+	prev := invalidReference
+	for _, e := range t.order {
+		kv := d.b.Push(Node{Kind: KeyValue})
+		var value reference
+		switch e.kind {
+		case docLeaf:
+			value = e.leaf
+		case docTableEntry:
+			value = d.emitTable(e.table)
+		case docArrayTable:
+			value = d.b.Push(Node{Kind: Array})
+			prevElem := invalidReference
+			for _, at := range e.tables {
+				elem := d.emitTable(at)
+				if prevElem.Valid() {
+					d.b.Chain(prevElem, elem)
+				} else {
+					d.b.AttachChild(value, elem)
+				}
+				prevElem = elem
+			}
+		}
+		key := d.b.Push(Node{Kind: Key, Data: e.key})
+		d.b.AttachChild(kv, value)
+		d.b.Chain(value, key)
+
+		if prev.Valid() {
+			d.b.Chain(prev, kv)
+		} else {
+			d.b.AttachChild(ref, kv)
+		}
+		prev = kv
+	}
+	return ref
+}
