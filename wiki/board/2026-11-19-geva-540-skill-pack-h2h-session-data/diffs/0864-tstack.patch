+// unmarshalRoot assembles the whole document into a single InlineTable node
+// and passes it to the root target's UnmarshalTOML method.
+func (d *decoder) unmarshalRoot(u unstable.Unmarshaler) error {
+	var doc unstable.DocumentBuilder
+	for d.nextExpr() {
+		expr := d.expr()
+		if _, err := d.seen.CheckExpression(expr); err != nil {
+			return err
+		}
+		if err := doc.Add(expr); err != nil {
+			return unstable.NewParserError(d.p.Raw(expr.Raw), "%w", err)
+		}
+	}
+	if err := d.p.Error(); err != nil {
+		return err
+	}
+	return u.UnmarshalTOML(doc.Node())
+}
