+// rootUnmarshaler records the document it receives as a string, preserving
+// key order.
+type rootUnmarshaler struct {
+	calls int
+	repr  string
+}
+
+func dumpNode(n *unstable.Node) string {
+	switch n.Kind {
+	case unstable.InlineTable:
+		s := "{"
+		it := n.Children()
+		first := true
+		for it.Next() {
+			kv := it.Node()
+			if !first {
+				s += ", "
+			}
+			first = false
+			k := kv.Key()
+			for k.Next() {
+				s += string(k.Node().Data)
+			}
+			s += "=" + dumpNode(kv.Value())
+		}
+		return s + "}"
+	case unstable.Array:
+		s := "["
+		it := n.Children()
+		first := true
+		for it.Next() {
+			if !first {
+				s += ", "
+			}
+			first = false
+			s += dumpNode(it.Node())
+		}
+		return s + "]"
+	default:
+		return string(n.Data)
+	}
+}
+
+func (r *rootUnmarshaler) UnmarshalTOML(value *unstable.Node) error {
+	r.calls++
+	r.repr = dumpNode(value)
+	return nil
+}
+
+func TestUnmarshal_RootCustomUnmarshaler(t *testing.T) {
+	examples := []struct {
+		desc     string
+		input    string
+		expected string
+		err      bool
+	}{
+		{desc: "empty", input: ``, expected: "{}"},
+		{desc: "simple", input: `foo = "bar"`, expected: "{foo=bar}"},
+		{
+			desc: "order, dotted keys, tables and array tables",
+			input: `z = 1
+a.b = 2
+inline = {x = 1, y = [1, 2]}
+
+[t2]
+k = "v"
+
+[t1.sub]
+k = 3
+
+[t2.deep]
+q = true
+
+[[arr]]
+n = 1
+
+[[arr]]
+n = 2
+
+[arr.sub]
+m = 3
+`,
+			expected: "{z=1, a={b=2}, inline={x=1, y=[1, 2]}, t2={k=v, deep={q=true}}, t1={sub={k=3}}, arr=[{n=1}, {n=2, sub={m=3}}]}",
+		},
+		{desc: "duplicate key", input: "a = 1\na = 2", err: true},
+		{desc: "duplicate table", input: "[a]\n[a]", err: true},
+	}
+
+	for _, e := range examples {
+		e := e
+		t.Run(e.desc, func(t *testing.T) {
+			var r rootUnmarshaler
+			err := toml.NewDecoder(bytes.NewReader([]byte(e.input))).
+				EnableUnmarshalerInterface().
+				Decode(&r)
+			if e.err {
+				assert.Error(t, err)
+				return
+			}
+			assert.NoError(t, err)
+			assert.Equal(t, 1, r.calls)
+			assert.Equal(t, e.expected, r.repr)
+		})
+	}
+
+	t.Run("not called when interface disabled", func(t *testing.T) {
+		var r rootUnmarshaler
+		err := toml.NewDecoder(bytes.NewReader([]byte(`calls = 5`))).Decode(&r)
+		assert.NoError(t, err)
+		assert.Equal(t, 0, r.calls)
+	})
+
+	t.Run("error is propagated", func(t *testing.T) {
+		var r errRootUnmarshaler
+		err := toml.NewDecoder(bytes.NewReader([]byte(`a = 1`))).
+			EnableUnmarshalerInterface().
+			Decode(&r)
+		assert.Error(t, err)
+	})
+}
+
+type errRootUnmarshaler struct{}
+
+func (errRootUnmarshaler) UnmarshalTOML(*unstable.Node) error {
+	return fmt.Errorf("boom")
+}
