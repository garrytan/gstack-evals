+// validateProxySegment ensures a route-derived value is exactly one literal path segment.
+func validateProxySegment(field, value string) error {
+	if value == "" || value == "." || value == ".." || strings.ContainsAny(value, "/\\%") {
+		return fmt.Errorf("invalid %s", field)
+	}
+	return nil
+}
+
+// splitProxyPath splits the decoded proxy sub-path into segments and rejects
+// any dot segments (including double-encoded ones) that could escape the
+// authorized pod/service proxy prefix.
+func splitProxyPath(proxyPath string) ([]string, bool, error) {
+	if strings.Contains(proxyPath, "\\") {
+		return nil, false, errors.New("invalid proxy path")
+	}
+	trailingSlash := strings.HasSuffix(proxyPath, "/")
+	var segments []string
+	for _, seg := range strings.Split(proxyPath, "/") {
+		if seg == "" {
+			continue
+		}
+		// Unescape repeatedly to catch multiply-encoded dot segments or slashes.
+		decoded := seg
+		for i := 0; i < 8; i++ {
+			next, err := url.PathUnescape(decoded)
+			if err != nil || next == decoded {
+				break
+			}
+			decoded = next
+		}
+		if decoded == "." || decoded == ".." || strings.ContainsAny(decoded, "/\\") {
+			return nil, false, errors.New("invalid proxy path")
+		}
+		segments = append(segments, seg)
+	}
+	return segments, trailingSlash, nil
+}
+
+func buildProxyURL(host, kind, namespace, name, proxyPath, rawQuery string) (string, error) {
+	if err := validateProxySegment("kind", kind); err != nil {
+		return "", err
+	}
+	if err := validateProxySegment("namespace", namespace); err != nil {
+		return "", err
+	}
+	if err := validateProxySegment("name", name); err != nil {
+		return "", err
+	}
+	segments, trailingSlash, err := splitProxyPath(proxyPath)
 	if err != nil {
 		return "", err
 	}
 
-	query, err := url.ParseQuery(rawQuery)
+	u, err := url.Parse(host)
 	if err != nil {
 		return "", err
 	}
-	u, err := url.Parse(path)
+
+	basePath := strings.TrimRight(u.Path, "/")
+	prefix := basePath + "/api/v1/namespaces/" + namespace + "/" + kind + "/" + name + "/proxy"
+	rawPrefix := strings.TrimRight(u.EscapedPath(), "/") + "/api/v1/namespaces/" +
+		url.PathEscape(namespace) + "/" + url.PathEscape(kind) + "/" + url.PathEscape(name) + "/proxy"
+
+	fullPath := prefix
+	rawPath := rawPrefix
+	for _, seg := range segments {
+		fullPath += "/" + seg
+		rawPath += "/" + url.PathEscape(seg)
+	}
+	if trailingSlash {
+		fullPath += "/"
+		rawPath += "/"
+	}
+
+	// Defense in depth: the cleaned path must remain under the authorized prefix.
+	if cleaned := path.Clean(fullPath); cleaned != prefix && !strings.HasPrefix(cleaned, prefix+"/") {
+		return "", errors.New("invalid proxy path")
+	}
+
+	query, err := url.ParseQuery(rawQuery)
 	if err != nil {
 		return "", err
 	}
+	u.Path = fullPath
+	u.RawPath = rawPath
 	u.RawQuery = query.Encode()
 	return u.String(), nil
 }
