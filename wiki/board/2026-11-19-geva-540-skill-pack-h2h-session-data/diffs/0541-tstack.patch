+package io.helidon.common.socket;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.channels.SocketChannel;
+import java.util.Arrays;
+
+import io.helidon.common.buffers.BufferData;
+
+import org.junit.jupiter.api.Test;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class NioSocketTest {
+    /**
+     * A write on a {@link SocketChannel} may be partial (even in blocking mode, e.g. when using virtual threads),
+     * all bytes must still be written in order.
+     */
+    @Test
+    void testPartialWrites() throws Exception {
+        ByteArrayOutputStream written = new ByteArrayOutputStream();
+        SocketChannel channel = mock(SocketChannel.class);
+        when(channel.write(any(ByteBuffer.class))).thenAnswer(invocation -> {
+            ByteBuffer buffer = invocation.getArgument(0);
+            // write at most 1000 bytes at a time
+            int len = Math.min(1000, buffer.remaining());
+            byte[] bytes = new byte[len];
+            buffer.get(bytes);
+            written.write(bytes);
+            return len;
+        });
+
+        byte[] data = new byte[100_000];
+        for (int i = 0; i < data.length; i++) {
+            data[i] = (byte) i;
+        }
+
+        NioSocket socket = NioSocket.server(channel, "test", "test");
+        socket.write(BufferData.create(data));
+
+        byte[] result = written.toByteArray();
+        assertThat("Number of bytes written", result.length, is(data.length));
+        assertThat("Written bytes must match", Arrays.equals(result, data), is(true));
+    }
+}
