+    @Test
+    void listUserPoolClientsReturnsOnlyClientDescriptions() {
+        ObjectNode poolReq = mapper.createObjectNode();
+        poolReq.put("PoolName", "list-clients-pool");
+        JsonNode poolBody = (JsonNode) handler.handle("CreateUserPool", poolReq, "us-east-1").getEntity();
+        String poolId = poolBody.get("UserPool").get("Id").asText();
+
+        ObjectNode clientReq = mapper.createObjectNode();
+        clientReq.put("UserPoolId", poolId);
+        clientReq.put("ClientName", "list-client");
+        clientReq.put("GenerateSecret", true);
+        JsonNode clientBody = (JsonNode) handler.handle("CreateUserPoolClient", clientReq, "us-east-1").getEntity();
+        String clientId = clientBody.get("UserPoolClient").get("ClientId").asText();
+
+        ObjectNode listReq = mapper.createObjectNode();
+        listReq.put("UserPoolId", poolId);
+        Response response = handler.handle("ListUserPoolClients", listReq, "us-east-1");
+        assertEquals(200, response.getStatus());
+
+        JsonNode clients = ((JsonNode) response.getEntity()).get("UserPoolClients");
+        assertEquals(1, clients.size());
+        JsonNode client = clients.get(0);
+        assertEquals(3, client.size());
+        assertEquals(clientId, client.get("ClientId").asText());
+        assertEquals("list-client", client.get("ClientName").asText());
+        assertEquals(poolId, client.get("UserPoolId").asText());
+        assertFalse(client.has("ClientSecret"));
+    }
