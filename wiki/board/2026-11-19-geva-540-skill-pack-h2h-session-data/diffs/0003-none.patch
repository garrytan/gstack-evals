+    it('creates msdf font textures without mipmaps', function (done) {
+        const asset = new Asset('arial', 'font', {
+            url: 'http://localhost:3210/test/assets/fonts/arial.json'
+        });
+
+        app.assets.add(asset);
+        app.assets.load(asset);
+
+        asset.ready(function () {
+            const texture = asset.resource.textures[0];
+            expect(texture.mipmaps).to.equal(false);
+            expect(texture.minFilter).to.equal(FILTER_LINEAR);
+            // texture keeps its url as name, so the font can release it from the loader cache
+            expect(app.loader.getFromCache(texture.name, 'texture')).to.equal(texture);
+            done();
+        });
+
