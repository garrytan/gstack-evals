         }).not.toThrow();
       });
     });
+    describe('regular expression denial of service', () => {
+      const payloads = [
+        '1'.repeat(40) + 'x',
+        '+' + '1'.repeat(40) + 'x',
+        '1 '.repeat(40) + 'x',
+        '1-'.repeat(40) + 'x',
+        '+1 (' + '1'.repeat(40) + 'x',
+        '1'.repeat(100_000) + 'x',
+      ];
+
+      for (const payload of payloads) {
+        test(`rejects ${JSON.stringify(payload.slice(0, 20))}... (length ${payload.length}) quickly`, () => {
+          const start = Date.now();
+          expect(() => GraphQLPhoneNumber.parseValue(payload)).toThrow(
+            /^Value is not a valid phone number/,
+          );
+          expect(() => GraphQLPhoneNumber.serialize(payload)).toThrow(
+            /^Value is not a valid phone number/,
+          );
+          expect(() =>
+            GraphQLPhoneNumber.parseLiteral({ value: payload, kind: Kind.STRING }, {}),
+          ).toThrow(/^Value is not a valid phone number/);
+          expect(Date.now() - start).toBeLessThan(100);
+        });
+      }
+    });
   });
