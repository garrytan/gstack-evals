+---
+'graphql-scalars': patch
+---
+
+PhoneNumber: guard against regular expression denial of service (GHSA-x8rm-f576-gq67) by bounding the input length before matching and keeping the pattern free of ambiguous nested quantifiers.
diff --git a/src/scalars/PhoneNumber.ts b/src/scalars/PhoneNumber.ts
index 7111608..9eaf8e5 100644
--- a/src/scalars/PhoneNumber.ts
+++ b/src/scalars/PhoneNumber.ts
@@ -1,8 +1,17 @@
 import { GraphQLScalarType, Kind } from 'graphql';
 import { createGraphQLError } from '../error.js';
 
+// NOTE: keep this pattern free of nested/ambiguous quantifiers. Patterns such as
+// /^\+?\d{1,3}(\-|\x20)?\(?\d+\)?((\-|\x20)?\d+)+$/ backtrack exponentially on
+// inputs like '1'.repeat(30) + 'x' (ReDoS, GHSA-x8rm-f576-gq67).
 const PHONE_NUMBER_REGEX = /^\+[1-9]\d{6,14}$/;
 
+// E.164 allows at most 15 digits plus the leading '+'.
+const PHONE_NUMBER_MAX_LENGTH = 16;
+
+const isValidPhoneNumber = (value: string): boolean =>
+  value.length <= PHONE_NUMBER_MAX_LENGTH && PHONE_NUMBER_REGEX.test(value);
+
 export const GraphQLPhoneNumber = /*#__PURE__*/ new GraphQLScalarType({
   name: 'PhoneNumber',
 
