+func Test_BGPUpdateDecodeLengthUnderflow(t *testing.T) {
+	cases := [][]byte{
+		// withdrawn len 1, but prefix /24 needs 4 bytes; followed by bytes that would be misparsed
+		{0x00, 0x01, 0x18, 0x0a, 0x00, 0x00, 0x00, 0x00},
+		// total path attr len 3, but ORIGIN attribute is 4 bytes; trailing byte
+		{0x00, 0x00, 0x00, 0x03, 0x40, 0x01, 0x01, 0x00},
+		// total path attr len 5, ORIGIN (4 bytes) leaves pathlen 1 with no data
+		{0x00, 0x00, 0x00, 0x05, 0x40, 0x01, 0x01, 0x00, 0x00},
+	}
+	// total path attr len 4, but first attr is 5 bytes -> pathlen wraps to 65535;
+	// a second 65534-byte attr then leaves pathlen 1 with no data left.
+	big := []byte{0x00, 0x00, 0x00, 0x04, 0xd0, 0xf0, 0x00, 0x01, 0x00, 0xd0, 0xf1, 0xff, 0xfa}
+	big = append(big, make([]byte, 65530)...)
+	cases = append(cases, big)
+	for i, c := range cases {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Fatalf("case %d: panic: %v", i, r)
+				}
+			}()
+			m := &BGPUpdate{}
+			_ = m.DecodeFromBytes(c)
+		}()
+	}
+	m := &BGPUpdate{}
+	assert.Error(t, m.DecodeFromBytes(cases[0]))
+	assert.Error(t, m.DecodeFromBytes(cases[1]))
+	assert.Error(t, m.DecodeFromBytes(big))
+}
