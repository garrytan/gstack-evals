+TEST_F(BuildTest, DyndepReadyImplicitOutputAsDepfileInputOfOrderOnlyDependent) {
+  // Verify that when an already-built dyndep file adds an implicit output
+  // to an edge, and a depfile of a dependent edge (that only has an
+  // order-only dependency on that edge) lists the implicit output as an
+  // input, then the dependent edge is rebuilt when the implicit output
+  // will be regenerated.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out $out.imp\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"build dd: cp dd-in\n"
+"build tmp: touch || dd\n"
+"  dyndep = dd\n"
+"build out: cp in || tmp\n"
+"  depfile = out.d\n"
+));
+  fs_.Create("dd-in",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("in", "");
+  fs_.Tick();
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("tmp.imp", "");
+  fs_.Tick();
+  fs_.Create("out.d", "out: tmp.imp\n");
+  fs_.Create("out", "");
+  // "tmp" is missing, so its edge is dirty and will regenerate tmp.imp.
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("out", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  EXPECT_EQ(std::vector<std::string>({ "touch tmp tmp.imp", "cp in out" }),
+            command_runner_.commands_ran_);
+}
