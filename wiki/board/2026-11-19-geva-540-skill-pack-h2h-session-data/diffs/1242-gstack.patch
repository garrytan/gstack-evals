+package utils
+import "testing"
+func TestSanitizeFilePathBoundary(t *testing.T) {
+	cases := []struct{ p, d string; ok bool }{
+		{"/packages/a", "/packages", true},
+		{"/packages/a", "/packages/", true},
+		{"/packages", "/packages", true},
+		{"/packages-extra/evil", "/packages", false},
+		{"/packagesevil", "/packages", false},
+		{"/other", "/packages", false},
+		{"/a/b", "/", true},
+	}
+	for _, c := range cases {
+		_, err := SanitizeFilePath(c.p, c.d)
+		if (err == nil) != c.ok { t.Errorf("%v: err=%v", c, err) }
+	}
+}
