+func TestStore_Push_SymlinkTraversalDisallowed(t *testing.T) {
+	content := []byte("hello world")
+	desc := func(name string) ocispec.Descriptor {
+		return ocispec.Descriptor{
+			MediaType:   "test",
+			Digest:      digest.FromBytes(content),
+			Size:        int64(len(content)),
+			Annotations: map[string]string{ocispec.AnnotationTitle: name},
+		}
+	}
+
+	tests := []struct {
+		name    string
+		setup   func(t *testing.T, workingDir, outsideDir string)
+		title   string
+		outside string
+	}{
+		{
+			name: "symlinked parent directory",
+			setup: func(t *testing.T, workingDir, outsideDir string) {
+				if err := os.Symlink(outsideDir, filepath.Join(workingDir, "out")); err != nil {
+					t.Fatal(err)
+				}
+			},
+			title:   "out/pwn.txt",
+			outside: "pwn.txt",
+		},
+		{
+			name: "symlinked nested parent directory",
+			setup: func(t *testing.T, workingDir, outsideDir string) {
+				if err := os.Symlink(outsideDir, filepath.Join(workingDir, "out")); err != nil {
+					t.Fatal(err)
+				}
+			},
+			title:   "out/a/b/pwn.txt",
+			outside: "a/b/pwn.txt",
+		},
+		{
+			name: "symlinked target file",
+			setup: func(t *testing.T, workingDir, outsideDir string) {
+				if err := os.Symlink(filepath.Join(outsideDir, "pwn.txt"), filepath.Join(workingDir, "link.txt")); err != nil {
+					t.Fatal(err)
+				}
+			},
+			title:   "link.txt",
+			outside: "pwn.txt",
+		},
+		{
+			name: "dangling symlinked parent directory",
+			setup: func(t *testing.T, workingDir, outsideDir string) {
+				if err := os.Symlink(filepath.Join(outsideDir, "missing"), filepath.Join(workingDir, "out")); err != nil {
+					t.Fatal(err)
+				}
+			},
+			title:   "out/pwn.txt",
+			outside: "missing",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			workingDir := t.TempDir()
+			outsideDir := t.TempDir()
+			tt.setup(t, workingDir, outsideDir)
+
+			s, err := New(workingDir)
+			if err != nil {
+				t.Fatal("Store.New() error =", err)
+			}
+			defer s.Close()
+
+			err = s.Push(context.Background(), desc(tt.title), bytes.NewReader(content))
+			if !errors.Is(err, ErrPathTraversalDisallowed) {
+				t.Errorf("Store.Push() error = %v, want %v", err, ErrPathTraversalDisallowed)
+			}
+			if _, err := os.Lstat(filepath.Join(outsideDir, tt.outside)); !os.IsNotExist(err) {
+				t.Errorf("file written outside working directory: %v", err)
+			}
+		})
+	}
+}
