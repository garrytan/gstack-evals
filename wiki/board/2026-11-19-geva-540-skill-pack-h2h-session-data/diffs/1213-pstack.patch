+func TestStore_Push_SymlinkWithinWorkingDir(t *testing.T) {
+	workingDir := t.TempDir()
+	if err := os.Mkdir(filepath.Join(workingDir, "real"), 0777); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("real", filepath.Join(workingDir, "link")); err != nil {
+		t.Fatal(err)
+	}
+	s, err := New(workingDir)
+	if err != nil {
+		t.Fatal("Store.New() error =", err)
+	}
+	defer s.Close()
+
+	content := []byte("hello world")
+	desc := ocispec.Descriptor{
+		MediaType:   "test",
+		Digest:      digest.FromBytes(content),
+		Size:        int64(len(content)),
+		Annotations: map[string]string{ocispec.AnnotationTitle: "link/a/foo.txt"},
+	}
+	if err := s.Push(context.Background(), desc, bytes.NewReader(content)); err != nil {
+		t.Fatal("Store.Push() error =", err)
+	}
+	got, err := os.ReadFile(filepath.Join(workingDir, "real", "a", "foo.txt"))
+	if err != nil || !bytes.Equal(got, content) {
+		t.Errorf("content = %q, err = %v, want %q", got, err, content)
+	}
+}
