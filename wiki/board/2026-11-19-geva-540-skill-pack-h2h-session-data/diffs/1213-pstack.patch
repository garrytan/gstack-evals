+// isLocalRel reports whether the relative path rel does not escape its base.
+func isLocalRel(rel string) bool {
+	rel = filepath.ToSlash(rel)
+	return rel != ".." && !strings.HasPrefix(rel, "../")
+}
+
+// evalSymlinksPartial resolves symlinks in the longest existing prefix of the
+// absolute path, and appends the remaining non-existent components.
+func evalSymlinksPartial(path string) (string, error) {
+	var rest []string
+	for {
+		resolved, err := filepath.EvalSymlinks(path)
+		if err == nil {
+			for i := len(rest) - 1; i >= 0; i-- {
+				resolved = filepath.Join(resolved, rest[i])
+			}
+			return resolved, nil
+		}
+		if !os.IsNotExist(err) {
+			return "", err
+		}
+		if _, lerr := os.Lstat(path); lerr == nil {
+			// path exists but cannot be resolved, e.g. a dangling symlink,
+			// whose destination cannot be verified.
+			return "", ErrPathTraversalDisallowed
+		}
+		parent := filepath.Dir(path)
+		if parent == path {
+			return "", err
+		}
+		rest = append(rest, filepath.Base(path))
+		path = parent
+	}
+}
