+
+type orderedKeys struct {
+	Keys []string
+}
+
+func (o *orderedKeys) UnmarshalTOML(value *unstable.Node) error {
+	if value.Kind != unstable.KeyValue {
+		return fmt.Errorf("expected KeyValue node, got %s", value.Kind)
+	}
+	var parts []string
+	for it := value.Key(); it.Next(); {
+		parts = append(parts, string(it.Node().Data))
+	}
+	o.Keys = append(o.Keys, strings.Join(parts, ".")+"="+string(value.Value().Data))
+	return nil
+}
+
+func TestUnmarshal_CustomUnmarshalerTables(t *testing.T) {
+	t.Run("root", func(t *testing.T) {
+		var d orderedKeys
+		err := toml.NewDecoder(strings.NewReader("z = 1\na.b = \"x\"\nm = 2")).
+			EnableUnmarshalerInterface().Decode(&d)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"z=1", "a.b=x", "m=2"}, d.Keys)
+	})
+
+	t.Run("table and array table", func(t *testing.T) {
+		var d struct {
+			T   orderedKeys
+			Arr []orderedKeys
+			N   int
+		}
+		doc := "n = 3\n[t]\nb = 1\na = 2\n[[arr]]\ny = 1\n[[arr]]\nx = 2\n"
+		err := toml.NewDecoder(strings.NewReader(doc)).
+			EnableUnmarshalerInterface().Decode(&d)
+		assert.NoError(t, err)
+		assert.Equal(t, 3, d.N)
+		assert.Equal(t, []string{"b=1", "a=2"}, d.T.Keys)
+		assert.Equal(t, 2, len(d.Arr))
+		assert.Equal(t, []string{"y=1"}, d.Arr[0].Keys)
+		assert.Equal(t, []string{"x=2"}, d.Arr[1].Keys)
+	})
+
+	t.Run("value node error is returned", func(t *testing.T) {
+		err := toml.NewDecoder(strings.NewReader("a = [1]")).
+			EnableUnmarshalerInterface().Decode(&struct{ A orderedKeys }{})
+		assert.Error(t, err)
+	})
+
+	t.Run("disabled", func(t *testing.T) {
+		var d orderedKeys
+		err := toml.NewDecoder(strings.NewReader("keys = [\"a\"]")).Decode(&d)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"a"}, d.Keys)
+	})
+}
