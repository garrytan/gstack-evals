     #endregion Dialog<TResult> Generic Tests
+
+    #region Scheme Tests
+
+    [Fact]
+    public void Scheme_NotRunning_Uses_Base_Scheme ()
+    {
+        using Dialog dialog = new ();
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Base), dialog.SchemeName);
+    }
+
+    [Fact]
+    public void Scheme_Running_Uses_Dialog_Scheme ()
+    {
+        using IApplication app = Application.Create ();
+        app.Init (DriverRegistry.Names.ANSI);
+
+        using Dialog dialog = new ();
+        string? schemeNameWhileRunning = null;
+        Scheme? schemeWhileRunning = null;
+
+        app.Iteration += AppOnIteration;
+        app.Run (dialog);
+        app.Iteration -= AppOnIteration;
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Dialog), schemeNameWhileRunning);
+        Assert.Equal (SchemeManager.GetScheme (Schemes.Dialog), schemeWhileRunning);
+
+        return;
+
+        void AppOnIteration (object? sender, EventArgs<IApplication?> e)
+        {
+            app.Iteration -= AppOnIteration;
+            schemeNameWhileRunning = dialog.SchemeName;
+            schemeWhileRunning = dialog.GetScheme ();
+            dialog.RequestStop ();
+        }
+    }
+
+    [Fact]
+    public void Scheme_Running_Generic_Dialog_Uses_Dialog_Scheme ()
+    {
