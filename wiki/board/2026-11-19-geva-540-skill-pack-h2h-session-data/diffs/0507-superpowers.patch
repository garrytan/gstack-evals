+    // True once SchemeName has been explicitly set by a caller (e.g. MessageBox setting the Error scheme). When true,
+    // SetStyle will not override SchemeName.
+    private bool _schemeNameExplicitlySet;
+
+    // True while SetStyle is applying the automatic (Dialog vs. Base) scheme name.
+    private bool _settingStyleSchemeName;
+
+    /// <inheritdoc/>
+    protected override void OnSchemeNameChanged (ValueChangedEventArgs<string?> args)
+    {
+        if (!_settingStyleSchemeName)
+        {
+            _schemeNameExplicitlySet = true;
+        }
+
+        base.OnSchemeNameChanged (args);
+    }
+
     private void SetStyle ()
     {
         if (IsRunning)
         {
+            SetStyleSchemeName (Schemes.Dialog);
             Arrangement |= ViewArrangement.Movable | ViewArrangement.Resizable | ViewArrangement.Overlapped;
         }
         else
         {
-            SchemeName = SchemeManager.SchemesToSchemeName (Schemes.Base);
+            SetStyleSchemeName (Schemes.Base);
 
             // strip out movable and resizable
             Arrangement &= ~(ViewArrangement.Movable | ViewArrangement.Resizable);
         }
     }
 
+    private void SetStyleSchemeName (Schemes scheme)
+    {
+        if (_schemeNameExplicitlySet)
+        {
+            return;
+        }
+
+        _settingStyleSchemeName = true;
+
+        try
+        {
+            SchemeName = SchemeManager.SchemesToSchemeName (scheme);
+        }
+        finally
+        {
+            _settingStyleSchemeName = false;
+        }
+    }
+
     // Dialogs are Modal and Focus is indicated by their Border. _drawingText ensures the
     // Text of the dialog (e.g. for a MessageBox) is always drawn using the Normal Attribute
     // instead of the Focus attribute.
