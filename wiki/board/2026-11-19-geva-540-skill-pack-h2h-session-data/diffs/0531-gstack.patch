+func TestDatasetServiceImpl_CommitProgress_EveryBatch(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	mockRepo := mock_repo.NewMockIDatasetAPI(ctrl)
+	service := &DatasetServiceImpl{repo: mockRepo}
+	processCtx := &snapshotContext{
+		spaceID:   1,
+		versionID: 1,
+		version: &entity.DatasetVersion{
+			ID:               1,
+			SpaceID:          1,
+			SnapshotStatus:   entity.SnapshotStatusUnstarted,
+			SnapshotProgress: &entity.SnapshotProgress{},
+		},
+	}
+
+	cursors := []string{"c1", "c2", "c3"}
+	var persisted []string
+	mockRepo.EXPECT().PatchVersion(gomock.Any(), gomock.Any(), gomock.Any()).
+		DoAndReturn(func(_ context.Context, patch, where *entity.DatasetVersion, _ ...repo.Option) error {
+			persisted = append(persisted, patch.SnapshotProgress.Cursor)
+			return nil
+		}).Times(len(cursors))
+
+	for i, c := range cursors {
+		processCtx.version.SnapshotProgress.Cursor = c
+		if err := service.commitProgress(context.Background(), processCtx, true); err != nil {
+			t.Fatalf("batch %d: unexpected err: %v", i, err)
+		}
+		if got := processCtx.version.UpdateVersion; got != int64(i+1) {
+			t.Fatalf("batch %d: expected update_version %d, got %d", i, i+1, got)
+		}
+	}
+	if fmt.Sprint(persisted) != fmt.Sprint(cursors) {
+		t.Fatalf("expected progress persisted for every batch %v, got %v", cursors, persisted)
+	}
+}
