+        }
+
+        crate::domains::runtime::handle("enable", &json!({}), &mut ctx, &session_id)
+            .await
+            .expect("Runtime.enable");
+        let r = crate::domains::runtime::handle(
+            "evaluate",
+            &json!({ "expression": "1", "contextId": 1 }),
+            &mut ctx,
+            &session_id,
+        )
+        .await;
+        assert!(r.is_ok(), "context 1 re-advertised by Runtime.enable must evaluate: {r:?}");
+    }
 }
