+        ctx.sessions.insert(session_id.clone().unwrap(), page_id.clone());
+
+        let first = json!({ "url": "data:text/html,<p>one</p>", "waitUntil": "load" });
+        handle("navigate", &first, &mut ctx, &session_id).await.expect("first navigate");
+        let stale = *created_context_ids(&ctx).iter().max().expect("isolated world created");
+        ctx.pending_events.clear();
+
+        let second = json!({ "url": "data:text/html,<p>two</p>", "waitUntil": "load" });
