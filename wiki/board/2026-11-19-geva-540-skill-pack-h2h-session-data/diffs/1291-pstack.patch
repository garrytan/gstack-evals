+---
+'style-dictionary': patch
+---
+
+Security fix: prevent prototype pollution in `convertTokenData` when converting token arrays or maps to objects with keys such as `{__proto__.foo}`.
diff --git a/__tests__/utils/convertTokenData.test.js b/__tests__/utils/convertTokenData.test.js
index f50aa0e..2953826 100644
--- a/__tests__/utils/convertTokenData.test.js
+++ b/__tests__/utils/convertTokenData.test.js
@@ -94,5 +94,21 @@ describe('utils', () => {
         });
       });
     });
+
+    it('should not pollute the prototype through token keys', () => {
+      const tokens = [
+        { key: '{__proto__.polluted}', value: 'malicious' },
+        { key: '{constructor.prototype.polluted}', value: 'malicious' },
+        { key: '{toString.polluted}', value: 'malicious' },
+      ];
+      const obj = convertTokenData(tokens, { output: 'object' });
+      expect(/** @type {any} */ ({}).polluted).to.be.undefined;
+      expect(/** @type {any} */ (Object).polluted).to.be.undefined;
+      expect(Object.getPrototypeOf(obj)).to.equal(Object.prototype);
+      expect(obj).to.eql({
+        constructor: { prototype: { polluted: tokens[1] } },
+        toString: { polluted: tokens[2] },
+      });
+    });
   });
 });
