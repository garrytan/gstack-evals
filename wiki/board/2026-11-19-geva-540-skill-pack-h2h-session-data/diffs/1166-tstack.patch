+	/**
+	 * Collects the string values of the server-side (trusted) configuration of
+	 * all instances of this module, grouped by their property name.
+	 * @returns {Map<string, Set<string>>} property name -> set of trusted values
+	 */
+	getTrustedConfigValues () {
+		const trusted = new Map();
+		const walk = (value, key) => {
+			if (typeof value === "string") {
+				if (key === undefined) return;
+				if (!trusted.has(key)) trusted.set(key, new Set());
+				trusted.get(key).add(value);
+			} else if (Array.isArray(value)) {
+				value.forEach((item) => walk(item, key));
+			} else if (value && typeof value === "object") {
+				Object.entries(value).forEach(([k, v]) => walk(v, k));
+			}
+		};
+		const modules = Array.isArray(config?.modules) ? config.modules : [];
+		modules.filter((m) => m && m.module === this.name).forEach((m) => walk(m.config, undefined));
+		return trusted;
+	}
+
+	/**
+	 * Replaces `**SECRET_*` placeholders in an inbound socket payload, but only
+	 * where the expanded value matches a value of the same property in this
+	 * module's server-side config. Placeholders anywhere else are left
+	 * untouched, so clients can't use the server to resolve arbitrary secrets.
+	 * @param {object} payload the inbound socket payload
+	 * @returns {object} a copy of the payload with trusted secrets expanded
+	 */
+	expandTrustedSecrets (payload) {
+		const trusted = this.getTrustedConfigValues();
+		const expand = (value, key) => {
+			if (typeof value === "string") {
+				if (key === undefined || !value.includes("**SECRET_")) return value;
+				const candidate = replaceSecretPlaceholder(value);
+				return trusted.get(key)?.has(candidate) ? candidate : value;
+			}
+			if (Array.isArray(value)) return value.map((item) => expand(item, key));
+			if (value && typeof value === "object") {
+				const result = {};
+				for (const [k, v] of Object.entries(value)) result[k] = expand(v, k);
+				return result;
+			}
+			return value;
+		};
+		return expand(JSON.parse(JSON.stringify(payload)), undefined);
+	}
+
