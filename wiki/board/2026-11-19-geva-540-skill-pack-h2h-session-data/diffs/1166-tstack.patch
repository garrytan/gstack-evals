@@ -0,0 +1,59 @@
+const NodeHelper = require("../../../js/node_helper");
+
+/**
+ * Creates a helper whose socket catch-all handler can be invoked directly.
+ * @param {string} name module name
+ * @returns {{helper: object, received: Array, send: (notification: string, payload: object) => void}} test harness
+ */
+function createHelper (name) {
+	const helper = new NodeHelper();
+	helper.setName(name);
+	const received = [];
+	helper.socketNotificationReceived = (notification, payload) => received.push({ notification, payload });
+	let onAny;
+	const fakeIo = { of: () => ({ on: (_event, cb) => cb({ onAny: (fn) => (onAny = fn) }) }) };
+	helper.setSocketIO(fakeIo);
+	return { helper, received, send: (notification, payload) => onAny(notification, payload) };
+}
+
+describe("NodeHelper socket secret placeholder handling", () => {
+	let originalConfig;
+
+	beforeEach(() => {
+		originalConfig = global.config;
+		process.env.SECRET_TEST_KEY = "real-secret-value";
+		process.env.SECRET_OTHER = "other-secret-value";
+		global.config = {
+			hideConfigSecrets: true,
+			cors: "disabled",
+			modules: [
+				{ module: "testmod", config: { apiKey: "real-secret-value", calendars: [{ url: "https://example.com/?k=real-secret-value" }] } },
+				{ module: "othermod", config: { token: "other-secret-value" } }
+			]
+		};
+	});
+
+	afterEach(() => {
+		global.config = originalConfig;
+		delete process.env.SECRET_TEST_KEY;
+		delete process.env.SECRET_OTHER;
+	});
+
+	it("expands placeholders that match the module's server-side config", () => {
+		const { received, send } = createHelper("testmod");
+		send("INIT", { apiKey: "**SECRET_TEST_KEY**", url: "https://example.com/?k=**SECRET_TEST_KEY**" });
+		expect(received[0].payload).toEqual({ apiKey: "real-secret-value", url: "https://example.com/?k=real-secret-value" });
+	});
+
+	it("does not expand placeholders in arbitrary payload fields", () => {
+		const { received, send } = createHelper("testmod");
+		send("INIT", { instanceId: "**SECRET_TEST_KEY**", nested: { id: "**SECRET_TEST_KEY**" } });
+		expect(received[0].payload).toEqual({ instanceId: "**SECRET_TEST_KEY**", nested: { id: "**SECRET_TEST_KEY**" } });
+	});
+
+	it("does not expand secrets belonging to other modules", () => {
+		const { received, send } = createHelper("testmod");
+		send("INIT", { token: "**SECRET_OTHER**", apiKey: "**SECRET_OTHER**" });
+		expect(received[0].payload).toEqual({ token: "**SECRET_OTHER**", apiKey: "**SECRET_OTHER**" });
+	});
+});
