+    [Fact]
+    public void WithGenericUserImplementedAndNamedNonGenericMappingsShouldUseNamedMappings()
+    {
+        var source = TestSourceBuilder.MapperWithBodyAndTypes(
+            """
+            [MapProperty(nameof(A.NullableStr), nameof(B.NullableStr), Use = nameof(TrimToNull))]
+            [MapProperty(nameof(A.Str), nameof(B.Str), Use = nameof(Trim))]
+            [MapProperty(nameof(A.Value), nameof(B.Value), Use = nameof(Identity))]
+            public partial B Map(A source);
+
+            private string? TrimToNull(string? input) => input;
+            private string Trim(string input) => input.Trim();
+            private T Identity<T>(T input) => input;
+            """,
+            "public class A { public string? NullableStr { get; set; } public string Str { get; set; } public int Value { get; set; } }",
+            "public class B { public string? NullableStr { get; set; } public string Str { get; set; } public int Value { get; set; } }"
+        );
+        TestHelper
+            .GenerateMapper(source)
+            .Should()
+            .HaveMapMethodBody(
+                """
+                var target = new global::B();
+                target.NullableStr = TrimToNull(source.NullableStr);
+                target.Str = Trim(source.Str);
+                target.Value = Identity<int>(source.Value);
+                return target;
+                """
+            );
+    }
