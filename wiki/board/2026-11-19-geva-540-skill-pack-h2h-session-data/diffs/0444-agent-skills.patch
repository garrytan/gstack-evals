     private static boolean areNeighborsTextChunks(TextChunk firstTextChunk, TextChunk secondTextChunk) {
-        return NodeUtils.areCloseNumbers(firstTextChunk.getTextEnd(), secondTextChunk.getTextStart(),
-            NEIGHBORS_TEXT_CHUNKS_EPSILON * firstTextChunk.getBoundingBox().getHeight());
+        // The tolerance is based on bbox height, which can be much larger than the font size
+        // for fonts with tall bounding boxes. Cap it with the word-space threshold used by
+        // TextLineProcessor, so that chunks separated by a word gap are never glued together
+        // without a space (e.g. "Evolution" + "Of" -> "EvolutionOf").
+        double epsilon = Math.min(NEIGHBORS_TEXT_CHUNKS_EPSILON * firstTextChunk.getBoundingBox().getHeight(),
+            TextChunkUtils.TEXT_LINE_SPACE_RATIO * firstTextChunk.getFontSize());
+        return NodeUtils.areCloseNumbers(firstTextChunk.getTextEnd(), secondTextChunk.getTextStart(), epsilon);
     }
