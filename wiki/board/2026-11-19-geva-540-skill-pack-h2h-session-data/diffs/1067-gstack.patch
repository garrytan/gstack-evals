+
+// StripAuthHeaders unconditionally removes all identity headers (user, group
+// and every header carrying the extra prefix) from the given header map. It
+// always strips the default X-Remote-* headers as well as the configured ones.
+func StripAuthHeaders(header http.Header, userHeader, groupHeader, extraHeaderPrefix string) {
+	prefixes := []string{strings.ToLower(DefaultExtraHeaderPrefix)}
+	if extraHeaderPrefix != "" {
+		prefixes = append(prefixes, strings.ToLower(extraHeaderPrefix))
+	}
+	header.Del(DefaultUserHeader)
+	header.Del(DefaultGroupHeader)
+	header.Del(DefaultUIDHeader)
+	if userHeader != "" {
+		header.Del(userHeader)
+	}
+	if groupHeader != "" {
+		header.Del(groupHeader)
+	}
+	for key := range header {
+		lk := strings.ToLower(key)
+		for _, p := range prefixes {
+			if strings.HasPrefix(lk, p) {
+				header.Del(key)
+				break
+			}
+		}
+	}
+}
+
+const (
+	DefaultUserHeader        = "X-Remote-User"
+	DefaultGroupHeader       = "X-Remote-Group"
+	DefaultUIDHeader         = "X-Remote-Uid"
+	DefaultExtraHeaderPrefix = "X-Remote-Extra-"
+)
diff --git a/pkg/proxy/authheaders/authheaders_test.go b/pkg/proxy/authheaders/authheaders_test.go
index 258c208..4b6cc67 100644
--- a/pkg/proxy/authheaders/authheaders_test.go
+++ b/pkg/proxy/authheaders/authheaders_test.go
@@ -142,3 +142,24 @@ func TestSetAuthHeaders_RealExtraIsEncodedAndForwarded(t *testing.T) {
 		t.Errorf("encoded extra header %q = %v, want [root:org:ws]; full headers=%v", encoded, got, h)
 	}
 }
+
+func TestStripAuthHeaders_NoUser(t *testing.T) {
+	t.Parallel()
+	h := http.Header{
+		userHeader:           {"system:admin"},
+		groupHeader:          {"system:masters"},
+		"X-Remote-Uid":       {"0"},
+		warrantHeader:        {"x"},
+		"X-Custom-Extra-Foo": {"bar"},
+		"Accept":             {"application/json"},
+	}
+	StripAuthHeaders(h, "X-Custom-User", "X-Custom-Group", "X-Custom-Extra-")
+	for _, k := range []string{userHeader, groupHeader, "X-Remote-Uid", warrantHeader, "X-Custom-Extra-Foo"} {
+		if v := h.Values(k); len(v) != 0 {
+			t.Errorf("header %q leaked: %v", k, v)
+		}
+	}
+	if h.Get("Accept") == "" {
+		t.Errorf("unrelated header removed")
+	}
+}
