+
+func TestFromLogEvent_GroupedLogMatchesContains(t *testing.T) {
+	logEvent := container.LogEvent{
+		Type: container.LogTypeGroup,
+		Message: []container.LogFragment{
+			{Message: "2026-04-11T07:46:48.304Z  INFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 710000)"},
+			{Message: "\x1b[32m2026-04-11T07:46:48.504Z  INFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 711000)\x1b[0m"},
+		},
+	}
+
+	notificationLog := FromLogEvent(logEvent)
+	msg, ok := notificationLog.Message.(string)
+	require.True(t, ok, "grouped message should be converted to a string")
+	assert.Equal(t,
+		"2026-04-11T07:46:48.304Z  INFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 710000)\n"+
+			"2026-04-11T07:46:48.504Z  INFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 711000)",
+		msg)
+
+	for _, expression := range []string{`message contains "backend"`, `message contains "711000"`} {
+		program, err := expr.Compile(expression, expr.Env(types.NotificationLog{}), expr.AsBool())
+		require.NoError(t, err)
+		sub := &Subscription{LogProgram: program}
+		assert.True(t, sub.MatchesLog(notificationLog), expression)
+	}
+}
