+        [Test]
+        public void CreateCellUsesDefaultColumnStyle()
+        {
+            IWorkbook workbook = _testDataProvider.CreateWorkbook();
+            ISheet sheet = workbook.CreateSheet();
+            ICellStyle style = workbook.CreateCellStyle();
+            style.DataFormat = workbook.CreateDataFormat().GetFormat("#,##0");
+            short defaultStyleIndex = sheet.CreateRow(0).CreateCell(1).CellStyle.Index;
+
+            sheet.SetDefaultColumnStyle(1, style);
+            IRow row = sheet.CreateRow(1);
+            ICell styled = row.CreateCell(1);
+            ICell unstyled = row.CreateCell(2);
+
+            ClassicAssert.AreEqual(style.Index, styled.CellStyle.Index);
