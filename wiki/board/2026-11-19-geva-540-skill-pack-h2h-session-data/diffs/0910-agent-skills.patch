diff --git a/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
new file mode 100644
index 0000000..f22078f
--- /dev/null
+++ b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
@@ -0,0 +1,72 @@
+'use strict';
+
+/**
+ * GHSA-x6m4-chr9-cg97 — host-realm error stacks leak absolute host paths
+ *
+ * A host-realm error (e.g. the SyntaxError thrown by the host-side
+ * transformer when sandbox code calls `eval` with malformed source) has its
+ * `.stack` formatted by Node's host formatter. Reading `.stack` through the
+ * bridge returned that string verbatim, bypassing the sandbox-side
+ * prepareStackTrace redaction added for GHSA-v27g-jcqj-v8rw.
+ *
+ * Fix: the bridge redacts every `at ...` frame line of a `stack` string read
+ * by the sandbox from a host object (get + getOwnPropertyDescriptor traps).
+ */
+
+const assert = require('assert');
+const path = require('path');
+const { VM, NodeVM } = require('../../../lib/main.js');
+
+const LIB_DIR = path.resolve(__dirname, '../../../lib');
+
+function assertNoHostLeak(stack) {
+	assert.strictEqual(typeof stack, 'string');
+	assert.ok(stack.indexOf(LIB_DIR) === -1, 'stack leaks vm2 lib path:\n' + stack);
+	assert.ok(stack.indexOf(__filename) === -1, 'stack leaks embedder path:\n' + stack);
+	assert.ok(!/node:internal|node:vm/.test(stack), 'stack leaks node internals:\n' + stack);
+	assert.ok(!/transformAndCheck|makeNiceSyntaxError/.test(stack), 'stack leaks host function names:\n' + stack);
+}
+
+describe('GHSA-x6m4-chr9-cg97 (host error stack leaks host paths)', () => {
+	it('redacts .stack of host SyntaxError from eval in default VM', () => {
+		const stack = new VM().run(`var s; try { eval("@@@ catch") } catch (e) { s = e.stack } s;`);
+		assert.ok(/^SyntaxError: /.test(stack), stack);
+		assertNoHostLeak(stack);
+	});
+
+	it('redacts .stack when string eval is disabled', () => {
+		const stack = new VM({ eval: false }).run(`var s; try { eval("@@@ catch") } catch (e) { s = e.stack } s;`);
+		assertNoHostLeak(stack);
+	});
+
+	it('redacts .stack of host SyntaxError from Function constructor', () => {
+		const stack = new VM().run(`var s; try { Function("@@@ catch") } catch (e) { s = e.stack } s;`);
+		assertNoHostLeak(stack);
+	});
+
+	it('redacts stack read via Object.getOwnPropertyDescriptor', () => {
+		const stack = new VM().run(`
+			var s; try { eval("@@@ catch") } catch (e) {
+				var d = Object.getOwnPropertyDescriptor(e, 'stack');
+				s = d.get ? d.get.call(e) : d.value;
+			} s;`);
+		assertNoHostLeak(stack);
+	});
+
+	it('redacts stack of host errors thrown by host functions', () => {
+		const vm = new VM({ sandbox: { hostFn() { throw new Error('boom'); } } });
+		const stack = vm.run(`var s; try { hostFn() } catch (e) { s = e.stack } s;`);
+		assert.ok(/^Error: boom/.test(stack), stack);
+		assertNoHostLeak(stack);
+	});
+
+	it('redacts .stack in default NodeVM', () => {
+		const stack = new NodeVM().run(`var s; try { eval("@@@ catch") } catch (e) { s = e.stack } module.exports = s;`);
+		assertNoHostLeak(stack);
+	});
+
+	it('keeps message intact', () => {
+		const msg = new VM().run(`var s; try { eval("@@@ catch") } catch (e) { s = e.message } s;`);
+		assert.strictEqual(msg, "Unexpected character '@'");
+	});
+});
