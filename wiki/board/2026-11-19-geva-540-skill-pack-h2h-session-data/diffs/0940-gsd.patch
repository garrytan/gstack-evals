--- a/cipher/cbc_hmac_test.go
+++ b/cipher/cbc_hmac_test.go
@@ -528,3 +528,43 @@ func BenchmarkDecryptAES256_CBCHMAC_1MB(b *testing.B) {
 func BenchmarkDecryptAES256_CBCHMAC_64MB(b *testing.B) {
 	benchDecryptCBCHMAC(b, 32, 67108864)
 }
+
+func TestEmptyCiphertextWithValidTag(t *testing.T) {
+	key := make([]byte, 32)
+	nonce := make([]byte, 16)
+	if _, err := io.ReadFull(rand.Reader, key); err != nil {
+		t.Fatal(err)
+	}
+	aead, err := NewCBCHMAC(key, aes.NewCipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := aead.(*cbcAEAD)
+
+	// Ciphertext consisting solely of a valid auth tag over empty content.
+	ct := ctx.computeAuthTag(nil, nonce, nil)
+	if _, err := aead.Open(nil, nonce, ct, nil); err == nil {
+		t.Error("open on empty ciphertext should fail")
+	}
+
+	if _, err := unpadBuffer([]byte{}, 16); err == nil {
+		t.Error("unpad of empty buffer should fail")
+	}
+}
+
+func TestInvalidNonceLengthOpen(t *testing.T) {
+	key := make([]byte, 32)
+	aead, err := NewCBCHMAC(key, aes.NewCipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := aead.(*cbcAEAD)
+
+	for _, n := range []int{0, 1, 15, 17, 32} {
+		nonce := make([]byte, n)
+		ct := append(make([]byte, 16), ctx.computeAuthTag(nil, nonce, make([]byte, 16))...)
+		if _, err := aead.Open(nil, nonce, ct, nil); err == nil {
+			t.Errorf("open with %d-byte nonce should fail", n)
+		}
+	}
+}
