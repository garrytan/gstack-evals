+
+// sameLogMultiIndexEntity returns two distinct, validly signed entries from
+// the same transparency log (different log indices), simulating a single
+// compromised log forging multiple entries.
+type sameLogMultiIndexEntity struct {
+	*ca.TestEntity
+	virtualSigstore *ca.VirtualSigstore
+}
+
+func (e *sameLogMultiIndexEntity) TlogEntries() ([]*tlog.Entry, error) {
+	entries, err := e.TestEntity.TlogEntries()
+	if err != nil {
+		return nil, err
+	}
+	orig := entries[0]
+	body := orig.TransparencyLogEntry().GetCanonicalizedBody()
+	logID, err := e.virtualSigstore.RekorLogID()
+	if err != nil {
+		return nil, err
+	}
+	payload := tlog.RekorPayload{
+		Body:           base64.StdEncoding.EncodeToString(body),
+		IntegratedTime: orig.IntegratedTime().Unix(),
+		LogIndex:       orig.LogIndex() + 1,
+		LogID:          logID,
+	}
+	set, err := e.virtualSigstore.RekorSignPayload(payload)
+	if err != nil {
+		return nil, err
+	}
+	second, err := tlog.NewEntry(body, payload.IntegratedTime, payload.LogIndex, []byte(orig.LogKeyID()), set, nil) //nolint:staticcheck
+	if err != nil {
+		return nil, err
+	}
+	return append(entries, second), nil
+}
+
+func TestTlogThresholdCountsUniqueLogs(t *testing.T) {
+	virtualSigstore, err := ca.NewVirtualSigstore()
+	assert.NoError(t, err)
+
+	statement := []byte(`{"_type":"https://in-toto.io/Statement/v0.1","predicateType":"customFoo","subject":[{"name":"subject","digest":{"sha256":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}}],"predicate":{}}`)
+	entity, err := virtualSigstore.Attest("foo@example.com", "issuer", statement)
+	assert.NoError(t, err)
+
+	multi := &sameLogMultiIndexEntity{TestEntity: entity, virtualSigstore: virtualSigstore}
+	entries, err := multi.TlogEntries()
+	assert.NoError(t, err)
+	assert.Len(t, entries, 2)
+
+	// both entries individually verify, so threshold 1 passes
+	_, err = verify.VerifyTlogEntry(multi, virtualSigstore, 1, true)
+	assert.NoError(t, err)
+
+	// but they come from a single log, so a threshold of 2 must not be met
+	_, err = verify.VerifyTlogEntry(multi, virtualSigstore, 2, true)
+	assert.ErrorContains(t, err, "not enough verified log entries")
+}
