+func TestVerifySignedCertificateTimestampMultipleChainsSameLog(t *testing.T) {
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	skid, err := cryptoutils.SKID(&privateKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caCert := createBaseCert(t, privateKey, skid, big.NewInt(1))
+	logID, err := getCTLogID(&privateKey.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf := embedSCTs(t, privateKey, skid, createBaseCert(t, privateKey, skid, big.NewInt(1)), []ct.SignedCertificateTimestamp{{
+		SCTVersion: ct.V1,
+		Timestamp:  12345,
+		LogID:      ct.LogID{KeyID: logID},
+	}})
+	tm := &fakeTrustedMaterial{
+		transparencyLog: map[string]*root.TransparencyLog{
+			hex.EncodeToString(logID[:]): {PublicKey: &privateKey.PublicKey},
+		},
+		cas: []root.CertificateAuthority{&root.FulcioCertificateAuthority{Root: caCert}},
+	}
+	chain := []*x509.Certificate{leaf, caCert}
+	// a single SCT verified across multiple chains counts as one log
+	chains := [][]*x509.Certificate{chain, chain}
+	assert.NoError(t, VerifySignedCertificateTimestamp(chains, 1, tm))
+	assert.Error(t, VerifySignedCertificateTimestamp(chains, 2, tm))
+}
