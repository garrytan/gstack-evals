+    /**
+     * Words positioned as separate chunks with narrow word spacing (below 0.17em, e.g. condensed
+     * fonts, justified text or negative character spacing) must still be separated by a space.
+     */
+    @Test
+    public void testProcessTextLinesInsertsSpaceForNarrowWordGap() {
+        StaticContainers.setIsIgnoreCharactersWithoutUnicode(false);
+        StaticContainers.setIsDataLoader(true);
+        List<IObject> contents = new ArrayList<>();
+        // font size 10, gap of 1.5pt (0.15em) between words
+        contents.add(new TextChunk(new BoundingBox(0, 10.0, 30.0, 40.0, 40.0),
+            "Lexical", 10, 30.0));
+        contents.add(new TextChunk(new BoundingBox(0, 41.5, 30.0, 70.0, 40.0),
+            "Search:", 10, 30.0));
+        // gap of 0.5pt (0.05em) - kerning-sized gap, no space expected
+        contents.add(new TextChunk(new BoundingBox(0, 70.5, 30.0, 80.0, 40.0),
+            "s", 10, 30.0));
+        contents = TextLineProcessor.processTextLines(contents);
+        Assertions.assertEquals(1, contents.size());
+        Assertions.assertEquals("Lexical Search:s", ((TextLine) contents.get(0)).getValue());
+    }
