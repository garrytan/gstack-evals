+
+  describe('ReDoS resistance', () => {
+    const payloads = [
+      '1'.repeat(40) + 'x',
+      '+' + '1'.repeat(40) + 'x',
+      '+1 ' + '1 '.repeat(40) + 'x',
+      '+1-' + '1-'.repeat(40) + 'x',
+      '+1 (' + '1'.repeat(40) + ')x',
+      '+' + '1'.repeat(100000) + 'x',
+    ];
+
+    test.each(payloads)('rejects adversarial input quickly (%#)', payload => {
+      const start = Date.now();
+      expect(() => GraphQLPhoneNumber.parseValue(payload)).toThrow(
+        /^Value is not a valid phone number/,
+      );
+      expect(() => GraphQLPhoneNumber.serialize(payload)).toThrow(
+        /^Value is not a valid phone number/,
+      );
+      expect(() =>
+        GraphQLPhoneNumber.parseLiteral({ value: payload, kind: Kind.STRING }, {}),
+      ).toThrow(/^Value is not a valid phone number/);
+      expect(Date.now() - start).toBeLessThan(1000);
+    });
+  });
 });
