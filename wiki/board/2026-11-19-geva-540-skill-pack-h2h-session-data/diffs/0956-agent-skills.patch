 	assert.NoError(t, err)
 }
+
+func TestMergeCellsParserEmptyRef(t *testing.T) {
+	// An empty merge cell reference must be skipped instead of panicking
+	ws := &xlsxWorksheet{MergeCells: &xlsxMergeCells{Cells: []*xlsxMergeCell{{Ref: ""}, {Ref: "B2:C3"}}}}
+	cell, err := ws.mergeCellsParser("A1")
+	assert.NoError(t, err)
+	assert.Equal(t, "A1", cell)
+	cell, err = ws.mergeCellsParser("C3")
+	assert.NoError(t, err)
+	assert.Equal(t, "B2", cell)
+
+	// Reading a cell from a workbook with an empty merge cell reference
+	f := NewFile()
+	ws2, ok := f.Sheet.Load("xl/worksheets/sheet1.xml")
+	assert.True(t, ok)
+	ws2.(*xlsxWorksheet).MergeCells = &xlsxMergeCells{Cells: []*xlsxMergeCell{{Ref: ""}}}
+	val, err := f.GetCellValue("Sheet1", "A1")
+	assert.NoError(t, err)
+	assert.Empty(t, val)
+	assert.NoError(t, f.SetCellValue("Sheet1", "A1", "x"))
+	assert.NoError(t, f.Close())
+}
+
+func TestCellInRangeEmptyRef(t *testing.T) {
+	assert.False(t, cellInRange([]int{1, 1}, nil))
+	assert.False(t, cellInRange([]int{1, 1}, []int{}))
+}
