 // cellInRange provides a function to determine if a given range is within a
 // range.
 func cellInRange(cell, ref []int) bool {
+	if len(cell) < 2 || len(ref) < 4 {
+		return false
+	}
 	return cell[0] >= ref[0] && cell[0] <= ref[2] && cell[1] >= ref[1] && cell[1] <= ref[3]
 }
 
