@@ -0,0 +1,28 @@
+using Microsoft.CodeAnalysis;
+
+namespace Riok.Mapperly.Configuration;
+
+/// <summary>
+/// A mapping configuration of a user mapping method with all its included configurations resolved.
+/// </summary>
+/// <param name="OwnConfiguration">The configuration declared directly on the method (without included configurations).</param>
+/// <param name="Configuration">The effective configuration (own configuration merged with all included configurations).</param>
+/// <param name="Included">The flattened included configurations, in the order they are applied.</param>
+internal record ResolvedMappingConfiguration(
+    MappingConfiguration OwnConfiguration,
+    MappingConfiguration Configuration,
+    IReadOnlyList<IncludedMappingConfiguration> Included
+)
+{
+    /// <summary>
+    /// Flattens this configuration into a list of method configurations to include,
+    /// starting with the own configuration of the given method followed by all its included configurations.
+    /// </summary>
+    public IEnumerable<IncludedMappingConfiguration> Flatten(IMethodSymbol method) =>
+        Included.Prepend(new IncludedMappingConfiguration(method, OwnConfiguration));
+}
+
+/// <summary>
+/// The own configuration (without includes) of an included mapping method.
+/// </summary>
+internal record IncludedMappingConfiguration(IMethodSymbol Method, MappingConfiguration Configuration);
