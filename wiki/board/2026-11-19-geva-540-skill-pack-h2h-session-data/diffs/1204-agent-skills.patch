+// HasEncodedPathSeparator checks if given (escaped) path contains percent-encoded path separator (`%2F` for `/` or
+// `%5C` for `\`) in any letter case.
+func HasEncodedPathSeparator(p string) bool {
+	for i := 0; i+2 < len(p); i++ {
+		if p[i] != '%' {
+			continue
+		}
+		switch {
+		case p[i+1] == '2' && (p[i+2] == 'f' || p[i+2] == 'F'):
+			return true
+		case p[i+1] == '5' && (p[i+2] == 'c' || p[i+2] == 'C'):
+			return true
+		}
+	}
+	return false
+}
