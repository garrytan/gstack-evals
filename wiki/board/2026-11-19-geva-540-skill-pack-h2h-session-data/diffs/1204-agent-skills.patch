+func TestEcho_StaticFS_encodedSlashDoesNotBypassRouteProtection(t *testing.T) {
+	var testCases = []struct {
+		name                   string
+		whenURL                string
+		whenUnescapePathParams bool
+		expectCode             int
+	}{
+		{name: "protected route is protected", whenURL: "/folder/index.html", expectCode: http.StatusForbidden},
+		{name: "encoded slash lowercase", whenURL: "/folder%2findex.html", expectCode: http.StatusNotFound},
+		{name: "encoded slash uppercase", whenURL: "/folder%2Findex.html", expectCode: http.StatusNotFound},
+		{name: "encoded backslash", whenURL: "/folder%5Cindex.html", expectCode: http.StatusNotFound},
+		{name: "encoded slash, router unescapes params", whenURL: "/folder%2Findex.html", whenUnescapePathParams: true, expectCode: http.StatusNotFound},
+		{name: "normal static file still served", whenURL: "/index.html", expectCode: http.StatusOK},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := New()
+			if tc.whenUnescapePathParams {
+				e.router = NewRouter(RouterConfig{UnescapePathParamValues: true})
+			}
+			deny := func(next HandlerFunc) HandlerFunc {
+				return func(c *Context) error { return ErrForbidden }
+			}
+			g := e.Group("/folder", deny)
+			g.GET("/*", func(c *Context) error { return c.String(http.StatusOK, "secret") })
+			e.StaticFS("/", os.DirFS("_fixture"))
+
+			req := httptest.NewRequest(http.MethodGet, tc.whenURL, nil)
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, req)
+
+			assert.Equal(t, tc.expectCode, rec.Code)
+			if tc.expectCode != http.StatusOK {
+				assert.NotContains(t, rec.Body.String(), "<html")
+			}
+		})
+	}
+}
