+func TestStatic_encodedSlashDoesNotBypassRouteProtection(t *testing.T) {
+	for _, whenURL := range []string{"/folder%2Findex.html", "/folder%2findex.html"} {
+		t.Run(whenURL, func(t *testing.T) {
+			e := echo.New()
+			e.Use(StaticWithConfig(StaticConfig{Root: "../_fixture"}))
+			g := e.Group("/folder", func(next echo.HandlerFunc) echo.HandlerFunc {
+				return func(c *echo.Context) error { return echo.ErrForbidden }
+			})
+			g.GET("/*", func(c *echo.Context) error { return c.String(http.StatusOK, "secret") })
+
+			req := httptest.NewRequest(http.MethodGet, whenURL, nil)
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, req)
+
