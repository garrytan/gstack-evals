diff --git a/Terminal.Gui/Views/Selectors/SelectorBase.cs b/Terminal.Gui/Views/Selectors/SelectorBase.cs
index f1f7ed1..d95c89e 100644
--- a/Terminal.Gui/Views/Selectors/SelectorBase.cs
+++ b/Terminal.Gui/Views/Selectors/SelectorBase.cs
@@ -529,6 +529,22 @@ public abstract class SelectorBase : View, IOrientation, IValue<int?>
                 SubViews.ElementAt (i).Width = Dim.Auto ();
             }
         }
+
+        if (Orientation == Orientation.Horizontal)
+        {
+            // DimAuto (our Width) sizes Pos.Align-based SubViews using their current Frame sizes
+            // (see PosAlign.CalculateMinDimension). SubViews created after construction (e.g. when Labels/Values are
+            // set later) have not been laid out yet, so their Frames are empty, which causes our auto-sized
+            // width to be too small and labels to be truncated. Ensure SubView Frames reflect their natural size.
+            Size size = App?.Screen.Size ?? new Size (2048, 2048);
+
+            foreach (View subView in SubViews)
+            {
+                subView.SetRelativeLayout (size);
+            }
+        }
+
+        SetNeedsLayout ();
     }
 
