+    [Theory]
+    [InlineData (false)]
+    [InlineData (true)]
+    public void Horizontal_LabelsAndValues_SetAfterConstruction_WidthFitsAllLabels (bool setValues)
+    {
+        View superView = new () { Width = 80, Height = 10 };
+
+        OptionSelector selector = new () { Y = 2, Orientation = Orientation.Horizontal };
+        selector.Labels = ["IMDb (Recommended)", "TMDb"];
+
+        if (setValues)
+        {
+            selector.Values = [0, 1];
+        }
+
+        superView.Add (selector);
+        superView.Layout ();
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+
+        // Each CheckBox is "(•) " + label; the first one has HorizontalSpace as its right margin.
+        int expected = "IMDb (Recommended)".Length + 2 + selector.HorizontalSpace + "TMDb".Length + 2;
+
+        Assert.Equal (expected, selector.Frame.Width);
+        Assert.Equal (selector.Frame.Width, checkBoxes [1].Frame.Right);
+    }
+
+    [Fact]
+    public void Horizontal_LabelsSetWhileHidden_WidthFitsAllLabelsWhenShown ()
+    {
+        View superView = new () { Width = 80, Height = 10 };
+
+        OptionSelector selector = new () { Orientation = Orientation.Horizontal, Visible = false };
+        superView.Add (selector);
+        superView.Layout ();
+
+        selector.Labels = ["IMDb (Recommended)", "TMDb"];
+        selector.Values = [0, 1];
+        selector.Visible = true;
+        superView.Layout ();
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        int expected = "IMDb (Recommended)".Length + 2 + selector.HorizontalSpace + "TMDb".Length + 2;
+
+        Assert.Equal (expected, selector.Frame.Width);
+        Assert.Equal (selector.Frame.Width, checkBoxes [1].Frame.Right);
+    }
