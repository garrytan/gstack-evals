--- a/index.js
+++ b/index.js
@@ -38,7 +38,12 @@ var UNSAFE_CHARS_REGEXP   = /[<>\/\u2028\u2029]/g;
 // longer contain a second `<`, every `</script` in the source is either the
 // start of its own match or is followed by a non-delimiter — and the latter
 // the tokenizer never treats as an end tag.
-var SCRIPT_CLOSE_REGEXP = /<\/script[^<>]*>|<\/script(?=[\t\n\f\r \/>])/gi;
+//
+// The bare-prefix form also matches at end of input (`$`): each function body
+// is escaped on its own, so a body ending exactly at `</script` has no
+// following character here, but the delimiter (and a later `>`) can be
+// supplied by the surrounding serialized output (GHSA-m5mm-p8h7-m29v).
+var SCRIPT_CLOSE_REGEXP = /<\/script[^<>]*>|<\/script(?=[\t\n\f\r \/>]|$)/gi;
 
 var RESERVED_SYMBOLS = ['*', 'async'];
 
