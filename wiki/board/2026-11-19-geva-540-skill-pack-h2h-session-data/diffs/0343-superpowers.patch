+        /// <summary>
+        /// Check whether a path is the same as or inside another directory,
+        /// after resolving relative paths and symbolic links where possible
+        /// </summary>
+        /// <param name="parentPath">The possible ancestor directory</param>
+        /// <param name="childPath">The possible descendant path</param>
+        /// <returns>true if childPath is parentPath or inside it, false otherwise</returns>
+        public static bool IsSameOrSubdirectory(string parentPath, string childPath)
+        {
+            var parent = CanonicalPath(parentPath);
+            for (var child = CanonicalPath(childPath);
+                 child != null;
+                 child = Path.GetDirectoryName(child))
+            {
+                if (string.Equals(child, parent, Platform.PathComparison))
+                {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        private static string CanonicalPath(string path, int depth = 0)
+        {
+            var full = Path.GetFullPath(path);
+            var parent = Path.GetDirectoryName(full);
+            if (parent == null)
+            {
+                // Root directory
+                return full;
+            }
+            full = full.TrimEnd(Path.DirectorySeparatorChar,
+                                Path.AltDirectorySeparatorChar);
+            parent = Path.GetDirectoryName(full);
+            if (parent == null)
+            {
+                return full;
+            }
+            // Follow symbolic links / junctions (with a limit to avoid loops)
+            if (depth < 40)
+            {
+                try
+                {
+                    if (Directory.Exists(full)
+                        && DirectoryLink.TryGetTarget(full, out string? target)
+                        && target is { Length: > 0 })
+                    {
+                        return CanonicalPath(Path.IsPathRooted(target)
+                                                 ? target
+                                                 : Path.Combine(parent, target),
+                                             depth + 1);
+                    }
+                }
+                catch
+                {
+                    // If we can't resolve the link, use the path as-is
+                }
+            }
+            return Path.Combine(CanonicalPath(parent, depth), Path.GetFileName(full));
+        }
