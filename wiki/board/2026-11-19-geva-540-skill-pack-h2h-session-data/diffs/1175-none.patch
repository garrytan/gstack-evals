+// validateFileName ensures the file name doesn't contain path separators or
+// traversal sequences, so that it cannot escape the destination directory.
+func validateFileName(fileName string) error {
+	if fileName == "" || fileName == "." || fileName == ".." ||
+		strings.ContainsAny(fileName, `/\`) || strings.ContainsRune(fileName, 0) ||
+		filepath.IsAbs(fileName) || filepath.VolumeName(fileName) != "" ||
+		filepath.Base(fileName) != fileName {
+		return xerrors.Errorf("%q must be a plain file name", fileName)
+	}
+	return nil
+}
