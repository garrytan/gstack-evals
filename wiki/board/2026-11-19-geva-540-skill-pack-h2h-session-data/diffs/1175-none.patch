+func TestValidateFileName(t *testing.T) {
+	for _, name := range []string{"db.tar.gz", "bundle.tar.gz", "javadb.tar.gz"} {
+		assert.NoError(t, oci.ValidateFileName(name), name)
+	}
+	for _, name := range []string{"", ".", "..", "../evil", "../../tmp/x", "/etc/passwd", `..\evil`, "a/b", "a\x00b"} {
+		assert.Error(t, oci.ValidateFileName(name), name)
+	}
+}
