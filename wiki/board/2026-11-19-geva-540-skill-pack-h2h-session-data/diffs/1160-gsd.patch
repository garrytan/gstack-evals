+
+// Test that in -l/--links mode an untrusted source can't create a
+// symlink pointing outside the destination, nor write through one.
+func TestCopySymlinkEscape(t *testing.T) {
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	defer r.Finalise()
+	when := time.Now()
+
+	outside := t.TempDir()
+
+	// Source: "evil" with a link escaping the destination and a file under it
+	r.WriteFile("evil/pwn.rclonelink", outside, when)
+	r.WriteFile("evil/rel.rclonelink", "../../..", when)
+	r.WriteFile("evil/ok.rclonelink", "pwn2/file.txt", when)
+	r.WriteFile("evil/pwn/authorized_keys", "attacker key", when)
+
+	srcF, err := NewFs(ctx, "local", filepath.Join(r.LocalName, "evil"), configmap.Simple{})
+	require.NoError(t, err)
+	dstF, err := NewFs(ctx, "local", filepath.Join(r.LocalName, "dst"), configmap.Simple{"links": "true"})
+	require.NoError(t, err)
+	require.NoError(t, dstF.Mkdir(ctx, ""))
+
+	put := func(f fs.Fs, remote, contents string) error {
+		src := object.NewStaticObjectInfo(remote, when, int64(len(contents)), true, nil, nil)
+		_, err := f.Put(ctx, strings.NewReader(contents), src)
+		return err
+	}
+
+	// Absolute target outside the destination is refused
+	err = put(dstF, "pwn.rclonelink", outside)
+	require.Error(t, err)
+	_, err = os.Lstat(filepath.Join(r.LocalName, "dst", "pwn"))
+	assert.True(t, os.IsNotExist(err))
+
+	// Relative target escaping the destination is refused
+	err = put(dstF, "rel.rclonelink", "../../..")
+	require.Error(t, err)
+
+	// Relative target inside the destination is allowed
+	require.NoError(t, put(dstF, "ok.rclonelink", "pwn2/file.txt"))
+	target, err := os.Readlink(filepath.Join(r.LocalName, "dst", "ok"))
+	require.NoError(t, err)
+	assert.Equal(t, "pwn2/file.txt", target)
+
+	// A pre-planted escaping symlink is never written through
+	require.NoError(t, os.Symlink(outside, filepath.Join(r.LocalName, "dst", "planted")))
+	err = put(dstF, "planted/authorized_keys", "attacker key")
+	require.Error(t, err)
+	_, err = os.Stat(filepath.Join(outside, "authorized_keys"))
+	assert.True(t, os.IsNotExist(err))
+
+	// A file written over a symlink replaces the symlink rather than following it
+	outsideFile := filepath.Join(outside, "victim")
+	require.NoError(t, os.WriteFile(outsideFile, []byte("orig"), 0600))
+	require.NoError(t, os.Symlink(outsideFile, filepath.Join(r.LocalName, "dst", "over")))
+	require.NoError(t, put(dstF, "over", "attacker"))
+	b, err := os.ReadFile(outsideFile)
+	require.NoError(t, err)
+	assert.Equal(t, "orig", string(b))
+
+	// Full sync of the malicious source writes nothing outside
+	err = sync.CopyDir(ctx, dstF, srcF, false)
+	assert.Error(t, err)
+	_, err = os.Stat(filepath.Join(outside, "authorized_keys"))
+	assert.True(t, os.IsNotExist(err))
+}
