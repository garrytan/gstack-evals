+// isWithinDir returns true if path p is root or is inside root.
+//
+// Both paths should be cleaned.
+func isWithinDir(root, p string) bool {
+	rel, err := filepath.Rel(root, p)
+	if err != nil {
+		return false
+	}
+	return rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
+}
+
+// checkNoSymlinkInPath checks that no existing component of dir
+// below the root of f is a symlink.
+func (f *Fs) checkNoSymlinkInPath(dir string) error {
+	root := filepath.Clean(f.root)
+	dir = filepath.Clean(dir)
+	if !isWithinDir(root, dir) {
+		return fmt.Errorf("refusing to write to %q: outside of root %q", dir, root)
+	}
+	rel, err := filepath.Rel(root, dir)
+	if err != nil || rel == "." {
+		return err
+	}
+	current := root
+	for _, part := range strings.Split(rel, string(filepath.Separator)) {
+		if part == "" {
+			continue
+		}
+		current = filepath.Join(current, part)
+		fi, err := os.Lstat(current)
+		if err != nil {
+			if os.IsNotExist(err) {
+				// Nothing further down can exist
+				return nil
+			}
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("refusing to write through symlinked directory %q", current)
+		}
+	}
+	return nil
+}
+
+// removeSymlinkBeforeWrite removes an existing symlink at o.path in
+// -l/--links mode so that writing a regular file never follows a
+// symlink which may point outside the destination.
+func (o *Object) removeSymlinkBeforeWrite() error {
+	if !o.fs.opt.TranslateSymlinks {
+		return nil
+	}
+	fi, err := os.Lstat(o.path)
+	if err != nil || fi.Mode()&os.ModeSymlink == 0 {
+		return nil
+	}
+	if removeErr := os.Remove(o.path); removeErr != nil {
+		fs.Errorf(o, "Failed to remove previous symlink: %v", removeErr)
+		return removeErr
+	}
+	return nil
+}
+
+// checkSymlinkTarget checks that the symlink target, when resolved
+// relative to the directory containing the link, stays within the
+// root of the Fs.
+//
+// This stops an untrusted source creating symlinks which point
+// outside the destination.
+func (o *Object) checkSymlinkTarget(target string) error {
+	if target == "" {
+		return fmt.Errorf("refusing to create symlink %q: empty target", o.path)
+	}
+	if strings.ContainsRune(target, 0) {
+		return fmt.Errorf("refusing to create symlink %q: target contains NUL", o.path)
+	}
+	root := filepath.Clean(o.fs.root)
+	var resolved string
+	if filepath.IsAbs(target) || filepath.VolumeName(target) != "" {
+		resolved = filepath.Clean(target)
+	} else {
+		resolved = filepath.Join(filepath.Dir(o.path), target)
+	}
+	if !isWithinDir(root, resolved) {
+		return fmt.Errorf("refusing to create symlink %q -> %q: target is outside the destination %q", o.path, target, root)
+	}
+	return nil
+}
