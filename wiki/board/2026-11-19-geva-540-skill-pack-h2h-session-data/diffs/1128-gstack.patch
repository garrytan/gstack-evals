diff --git a/pkg/proxy/httputil/proxy.go b/pkg/proxy/httputil/proxy.go
index 3cd7211..07bbe06 100644
--- a/pkg/proxy/httputil/proxy.go
+++ b/pkg/proxy/httputil/proxy.go
@@ -125,7 +125,31 @@ func rewriteRequestBuilder(target *url.URL, passHostHeader bool, preservePath bo
 		if isWebSocketUpgrade(pr.Out) {
 			cleanWebSocketHeaders(pr.Out)
 		}
+
+		// Request trailer values must never be forwarded to the backend:
+		// trailers arrive after the body, once routing and security decisions (e.g. header sanitization)
+		// have already been made.
+		// When a middleware buffers the body before the proxy (e.g. retry, buffering),
+		// the trailer values are already populated in the incoming request and would be cloned into the outgoing request.
+		// Only the declared trailer names are kept, with no values, as permitted by RFC 9110 section 6.6.2.
+		pr.Out.Trailer = stripTrailerValues(pr.In.Trailer)
+	}
+}
+
+// stripTrailerValues returns a new header containing only the declared trailer names, without any value.
+// The returned header is not shared with the incoming request,
+// so trailer values read later from the incoming body are never forwarded.
+func stripTrailerValues(trailer http.Header) http.Header {
+	if len(trailer) == 0 {
+		return nil
 	}
+
+	stripped := make(http.Header, len(trailer))
+	for name := range trailer {
+		stripped[name] = nil
+	}
+
+	return stripped
 }
 
 // copyForwardedHeader copies header that are removed by the reverseProxy when a rewriteRequest is used.
diff --git a/pkg/proxy/httputil/trailer_test.go b/pkg/proxy/httputil/trailer_test.go
index aa2ba1f..2ae7977 100644
--- a/pkg/proxy/httputil/trailer_test.go
+++ b/pkg/proxy/httputil/trailer_test.go
@@ -1,6 +1,7 @@
 package httputil
 
 import (
+	"bytes"
 	"io"
 	"net/http"
 	"net/http/httptest"
@@ -73,3 +74,68 @@ func TestRequestTrailersNotForwardedToBackend(t *testing.T) {
 
 	assert.Empty(t, backendTrailer.Get("X-Test-Trailer"))
 }
+
+// TestRequestTrailerValuesNotForwardedWhenBodyBuffered ensures that request trailer values
+// are not forwarded to the backend even when the body was fully read (e.g. by a buffering
+// or retry middleware) before reaching the proxy, which populates req.Trailer values.
+func TestRequestTrailerValuesNotForwardedWhenBodyBuffered(t *testing.T) {
+	var backendTrailer http.Header
+
+	backend := httptest.NewServer(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		_, err := io.ReadAll(req.Body)
+		require.NoError(t, err)
+
+		backendTrailer = req.Trailer.Clone()
+
+		rw.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(backend.Close)
+
+	transportManager := &transportManagerMock{
+		roundTrippers: map[string]http.RoundTripper{"default": &http.Transport{}},
+	}
+
+	backendURL, err := url.Parse(backend.URL)
+	require.NoError(t, err)
+
+	p, err := NewProxyBuilder(transportManager, nil).Build("default", backendURL, true, false, 0)
+	require.NoError(t, err)
+
+	var trailerSeenByProxy string
+	buffering := http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		body, err := io.ReadAll(req.Body)
+		require.NoError(t, err)
+
+		trailerSeenByProxy = req.Trailer.Get("X-Test-Trailer")
+
+		req.Body = io.NopCloser(bytes.NewReader(body))
+		p.ServeHTTP(rw, req)
+	})
+
+	proxy := httptest.NewServer(buffering)
+	t.Cleanup(proxy.Close)
+
+	pr, pw := io.Pipe()
+	req, err := http.NewRequest(http.MethodPost, proxy.URL, pr)
+	require.NoError(t, err)
+
+	req.Trailer = http.Header{"X-Test-Trailer": nil}
+
+	go func() {
+		_, _ = pw.Write([]byte("body data"))
+		req.Trailer.Set("X-Test-Trailer", "trailer-value")
+		_ = pw.Close()
+	}()
+
+	resp, err := http.DefaultClient.Do(req)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = resp.Body.Close() })
+
+	_, err = io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+
+	require.Equal(t, "trailer-value", trailerSeenByProxy)
+	assert.Empty(t, backendTrailer.Get("X-Test-Trailer"))
+	assert.Empty(t, backendTrailer.Values("X-Test-Trailer"))
+}
