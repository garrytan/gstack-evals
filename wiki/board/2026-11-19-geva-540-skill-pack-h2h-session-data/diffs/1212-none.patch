+// ensureNoSymlinkComponents walks each path component of rel under base and
+// returns ErrPathTraversalDisallowed if any existing component is a symbolic
+// link, since following it could escape base.
+func ensureNoSymlinkComponents(base, rel string) error {
+	rel = filepath.Clean(filepath.FromSlash(rel))
+	if rel == "." || rel == "" {
+		return nil
+	}
+	current := base
+	for _, part := range strings.Split(rel, string(filepath.Separator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		fi, err := os.Lstat(current)
+		if err != nil {
+			if os.IsNotExist(err) {
+				// remaining components do not exist yet and will be created
+				// as regular directories / files
+				return nil
+			}
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("%s: symlink in path: %w", current, ErrPathTraversalDisallowed)
+		}
+	}
+	return nil
+}
