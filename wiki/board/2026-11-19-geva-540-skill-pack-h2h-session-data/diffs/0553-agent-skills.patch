     }
 
+    [Test]
+    public void DedicatedThreadPool_ThreadsTerminate_WhenShutDown()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 2 };
+        threadPool.Initialize();
+
+        var workerThreads = new List<Thread>();
+        using var ran = new CountdownEvent(2);
+        for (var i = 0; i < 2; i++)
+        {
+            threadPool.RunInThread(() =>
+            {
+                lock (workerThreads)
+                {
+                    workerThreads.Add(Thread.CurrentThread);
+                }
+                ran.Signal();
+                return Task.CompletedTask;
+            });
+        }
+
+        Assert.That(ran.Wait(TimeSpan.FromSeconds(5)), Is.True);
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        foreach (var thread in workerThreads)
+        {
+            Assert.That(thread.Join(TimeSpan.FromSeconds(5)), Is.True, "Dedicated thread was not stopped on shutdown");
+        }
+    }
+
+    [Test]
+    public void DedicatedThreadPool_ThreadsTerminateAfterRunningJobsComplete_WhenShutDownWithoutWaiting()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread workerThread = null;
+        using var started = new ManualResetEventSlim(false);
+        using var release = new ManualResetEventSlim(false);
+        using var completed = new ManualResetEventSlim(false);
+        threadPool.RunInThread(async () =>
+        {
+            workerThread = Thread.CurrentThread;
+            started.Set();
+            release.Wait();
+            await Task.Yield();
+            completed.Set();
+        });
+
+        Assert.That(started.Wait(TimeSpan.FromSeconds(5)), Is.True);
+
+        threadPool.Shutdown(waitForJobsToComplete: false);
+
+        Assert.That(workerThread.Join(TimeSpan.FromMilliseconds(200)), Is.False, "Dedicated thread stopped while a job was still running");
+
+        release.Set();
+
+        Assert.Multiple(() =>
+        {
+            Assert.That(completed.Wait(TimeSpan.FromSeconds(5)), Is.True, "Running job was not allowed to complete");
+            Assert.That(workerThread.Join(TimeSpan.FromSeconds(5)), Is.True, "Dedicated thread was not stopped after running jobs completed");
+        });
+    }
+
     private class CustomTaskSchedulingThreadPool : TaskSchedulingThreadPool
