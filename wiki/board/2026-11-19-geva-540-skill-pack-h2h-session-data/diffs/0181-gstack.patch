diff --git a/test/sql/optimizer/test_volatile_aggregate_dedup.test b/test/sql/optimizer/test_volatile_aggregate_dedup.test
new file mode 100644
index 0000000..5993fa0
--- /dev/null
+++ b/test/sql/optimizer/test_volatile_aggregate_dedup.test
@@ -0,0 +1,35 @@
+# name: test/sql/optimizer/test_volatile_aggregate_dedup.test
+# description: Duplicate aggregate/window calls over volatile functions must not be deduplicated
+# group: [optimizer]
+
+query II
+SELECT g, any_value(uuid()::VARCHAR) OVER (PARTITION BY g) = any_value(uuid()::VARCHAR) OVER (PARTITION BY g)
+FROM (VALUES (1), (1), (2), (2)) t(g) ORDER BY g
+----
+1	false
+1	false
+2	false
+2	false
+
+query II
+SELECT g, any_value(uuid()::VARCHAR) = any_value(uuid()::VARCHAR)
+FROM (VALUES (1), (1), (2), (2)) t(g) GROUP BY g ORDER BY g
+----
+1	false
+2	false
+
+query I
+SELECT count(DISTINCT id_a) + count(DISTINCT id_b) FROM (
+	SELECT any_value(uuid()::VARCHAR) OVER (PARTITION BY g) AS id_a,
+	       any_value(uuid()::VARCHAR) OVER (PARTITION BY g) AS id_b
+	FROM (VALUES (1), (1), (2), (2)) t(g)
+) WHERE id_a <> id_b
+----
+4
+
+# non-volatile duplicates are still equal
+query I
+SELECT sum(x) OVER () = sum(x) OVER () FROM (VALUES (1), (2)) t(x)
+----
+true
+true
