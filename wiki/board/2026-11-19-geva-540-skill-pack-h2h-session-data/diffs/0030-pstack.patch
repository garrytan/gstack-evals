@@ -0,0 +1,44 @@
+import { expect } from 'chai';
+
+import { GlbParser } from '../../../src/framework/parsers/glb-parser.js';
+import { createApp } from '../../app.mjs';
+import { jsdomSetup, jsdomTeardown } from '../../jsdom.mjs';
+
+describe('GlbParser', function () {
+
+    let app;
+
+    beforeEach(function () {
+        jsdomSetup();
+        app = createApp();
+    });
+
+    afterEach(function () {
+        app?.destroy();
+        app = null;
+        jsdomTeardown();
+    });
+
+    const parseMaterials = (materials) => {
+        const gltf = { asset: { version: '2.0' }, scenes: [{ nodes: [] }], nodes: [], materials };
+        const data = new TextEncoder().encode(JSON.stringify(gltf)).buffer;
+        return new Promise((resolve, reject) => {
+            GlbParser.parse('test.gltf', '', data, app.graphicsDevice, app.assets, {}, (err, result) => {
+                if (err) reject(err); else resolve(result.materials);
+            });
+        });
+    };
+
+    describe('occlusionTexture', function () {
+
+        it('maps strength to aoIntensity', async function () {
+            const [material] = await parseMaterials([{ occlusionTexture: { index: 0, strength: 0.5 } }]);
+            expect(material.aoIntensity).to.equal(0.5);
+        });
+
+        it('defaults aoIntensity to 1 when strength is absent', async function () {
+            const [material] = await parseMaterials([{ occlusionTexture: { index: 0 } }]);
+            expect(material.aoIntensity).to.equal(1);
+        });
+    });
+});
