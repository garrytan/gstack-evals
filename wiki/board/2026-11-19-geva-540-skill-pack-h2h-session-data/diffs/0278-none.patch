+            Assert.AreEqual(style.Index, styled.CellStyle.Index);
+            Assert.AreNotEqual(style.Index, unstyled.CellStyle.Index);
+
+            IWorkbook wb2 = _testDataProvider.WriteOutAndReadBack(workbook);
+            ICell cell = wb2.GetSheetAt(0).GetRow(0).GetCell(1);
