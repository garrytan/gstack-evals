+// orderedKeys records the keys of a table in document order.
+type orderedKeys struct {
+	Keys []string
+}
+
+func (o *orderedKeys) UnmarshalTOML(node *unstable.Node) error {
+	if node.Kind != unstable.InlineTable {
+		return fmt.Errorf("expected inline table, got %s", node.Kind)
+	}
+	it := node.Children()
+	for it.Next() {
+		kv := it.Node()
+		key := kv.Key()
+		key.Next()
+		o.Keys = append(o.Keys, string(key.Node().Data)+"="+string(kv.Value().Data))
+	}
+	return nil
+}
+
+func TestUnmarshal_CustomUnmarshalerTable(t *testing.T) {
+	var root orderedKeys
+	err := toml.NewDecoder(bytes.NewReader([]byte("z = \"1\"\na = \"2\"\nm = \"3\""))).
+		EnableUnmarshalerInterface().Decode(&root)
+	assert.NoError(t, err)
+	assert.Equal(t, []string{"z=1", "a=2", "m=3"}, root.Keys)
+
+	var cfg struct {
+		Name  string
+		T     orderedKeys
+		P     *orderedKeys
+		Items []orderedKeys
+	}
+	doc := "name = \"x\"\n[t]\nb = 1\na = 2\n[p]\nc = 3\n[[items]]\nx = 1\n[[items]]\ny = 2\n"
+	err = toml.NewDecoder(bytes.NewReader([]byte(doc))).EnableUnmarshalerInterface().Decode(&cfg)
+	assert.NoError(t, err)
+	assert.Equal(t, "x", cfg.Name)
+	assert.Equal(t, []string{"b=1", "a=2"}, cfg.T.Keys)
+	assert.Equal(t, []string{"c=3"}, cfg.P.Keys)
+	assert.Equal(t, 2, len(cfg.Items))
+	assert.Equal(t, []string{"x=1"}, cfg.Items[0].Keys)
+	assert.Equal(t, []string{"y=2"}, cfg.Items[1].Keys)
+
+	// Without the option, the interface is ignored.
+	var plain orderedKeys
+	assert.NoError(t, toml.Unmarshal([]byte(`keys = ["a"]`), &plain))
+	assert.Equal(t, []string{"a"}, plain.Keys)
+}
diff --git a/unstable/unmarshaler.go b/unstable/unmarshaler.go
index 00cfd6d..d7f2b48 100644
--- a/unstable/unmarshaler.go
+++ b/unstable/unmarshaler.go
@@ -2,6 +2,44 @@ package unstable
 
 // The Unmarshaler interface may be implemented by types to customize their
 // behavior when being unmarshaled from a TOML document.
+//
+// For values, UnmarshalTOML receives the value node. For tables (including
+// the document root), it receives a synthetic InlineTable node whose children
+// are the KeyValue expressions of that table.
 type Unmarshaler interface {
 	UnmarshalTOML(value *Node) error
 }
+
+// NewInlineTable returns a new InlineTable node whose children are deep copies
+// of the given KeyValue nodes. The returned node does not depend on the
+// parser's internal storage, so it remains valid after the parser moves on to
+// the next expression.
+func NewInlineTable(keyValues []*Node) *Node {
+	b := &builder{}
+	root := b.Push(Node{Kind: InlineTable})
+	b.attachChildren(root, keyValues)
+	return b.NodeAt(root)
+}
+
+func (b *builder) clone(n *Node) reference {
+	ref := b.Push(Node{Kind: n.Kind, Raw: n.Raw, Data: n.Data})
+	var children []*Node
+	for c := n.Child(); c != nil; c = c.Next() {
+		children = append(children, c)
+	}
+	b.attachChildren(ref, children)
+	return ref
+}
+
+func (b *builder) attachChildren(parent reference, children []*Node) {
+	prev := invalidReference
+	for _, c := range children {
+		r := b.clone(c)
+		if prev.Valid() {
+			b.Chain(prev, r)
+		} else {
+			b.AttachChild(parent, r)
+		}
+		prev = r
+	}
+}
