+// tryTableUnmarshaler consumes the key-value expressions of the current table
+// and hands them to v's UnmarshalTOML method, if v implements
+// unstable.Unmarshaler and the feature is enabled.
+func (d *decoder) tryTableUnmarshaler(v reflect.Value) (bool, error) {
+	if !d.unmarshalerInterface {
+		return false, nil
+	}
+	var u unstable.Unmarshaler
+	if v.Kind() == reflect.Ptr && v.Type().Implements(unmarshalerType) {
+		if v.IsNil() {
+			v.Set(reflect.New(v.Type().Elem()))
+		}
+		u = v.Interface().(unstable.Unmarshaler)
+	} else if v.CanAddr() && v.Addr().Type().Implements(unmarshalerType) {
+		u = v.Addr().Interface().(unstable.Unmarshaler)
+	} else {
+		return false, nil
+	}
+
+	var kvs []*unstable.Node
+	for d.nextExpr() {
+		expr := d.expr()
+		if expr.Kind != unstable.KeyValue {
+			d.stashExpr()
+			break
+		}
+		if _, err := d.seen.CheckExpression(expr); err != nil {
+			return true, err
+		}
+		// Copy the expression: the parser reuses its storage for the next one.
+		kvs = append(kvs, unstable.NewInlineTable([]*unstable.Node{expr}).Child())
+	}
+	if err := d.p.Error(); err != nil {
+		return true, err
+	}
+	return true, u.UnmarshalTOML(unstable.NewInlineTable(kvs))
+}
