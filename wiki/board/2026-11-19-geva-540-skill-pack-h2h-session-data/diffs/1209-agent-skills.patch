+// ensureNoSymlinkEscape ensures that target, which is lexically within base,
+// still resolves to a location within base after evaluating symlinks.
+// Both base and target must be absolute and clean.
+func ensureNoSymlinkEscape(base, target string) error {
+	resolvedBase, err := filepath.EvalSymlinks(base)
+	if err != nil {
+		return fmt.Errorf("failed to resolve working directory %s: %w", base, err)
+	}
+
+	// find the deepest existing path of target; components beyond it do not
+	// exist yet and therefore cannot be symlinks.
+	existing := target
+	var remaining []string
+	for {
+		_, err := os.Lstat(existing)
+		if err == nil {
+			break
+		}
+		if !os.IsNotExist(err) {
+			return err
+		}
+		parent := filepath.Dir(existing)
+		if parent == existing {
+			// reached the root without finding an existing path
+			return ErrPathTraversalDisallowed
+		}
+		remaining = append(remaining, filepath.Base(existing))
+		existing = parent
+	}
+
+	resolved, err := filepath.EvalSymlinks(existing)
+	if err != nil {
+		// e.g. dangling symlinks, which would be followed on write
+		return fmt.Errorf("%s: %w", target, ErrPathTraversalDisallowed)
+	}
+	for i := len(remaining) - 1; i >= 0; i-- {
+		resolved = filepath.Join(resolved, remaining[i])
+	}
+
+	rel, err := filepath.Rel(resolvedBase, resolved)
+	if err != nil {
+		return ErrPathTraversalDisallowed
+	}
+	rel = filepath.ToSlash(rel)
+	if strings.HasPrefix(rel, "../") || rel == ".." {
+		return fmt.Errorf("%s: %w", target, ErrPathTraversalDisallowed)
+	}
+	return nil
+}
