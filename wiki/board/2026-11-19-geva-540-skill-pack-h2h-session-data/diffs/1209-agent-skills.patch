+func TestStore_File_Push_DisallowPathTraversal_Symlink(t *testing.T) {
+	tests := []struct {
+		name     string
+		title    string
+		linkName string
+		linkDir  bool
+	}{
+		{name: "symlinked parent dir", title: "out/pwn.txt", linkName: "out", linkDir: true},
+		{name: "symlinked nested parent dir", title: "out/sub/pwn.txt", linkName: "out", linkDir: true},
+		{name: "symlinked target file", title: "pwn.txt", linkName: "pwn.txt", linkDir: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			content := []byte("hello world")
+			desc := ocispec.Descriptor{
+				MediaType: "test",
+				Digest:    digest.FromBytes(content),
+				Size:      int64(len(content)),
+				Annotations: map[string]string{
+					ocispec.AnnotationTitle: tt.title,
+				},
+			}
+
+			workingDir := t.TempDir()
+			outsideDir := t.TempDir()
+			linkTarget := outsideDir
+			if !tt.linkDir {
+				linkTarget = filepath.Join(outsideDir, "pwn.txt")
+			}
+			if err := os.Symlink(linkTarget, filepath.Join(workingDir, tt.linkName)); err != nil {
+				t.Skip("symlink not supported:", err)
+			}
+
+			s, err := New(workingDir)
+			if err != nil {
+				t.Fatal("Store.New() error =", err)
+			}
+			defer s.Close()
+
+			err = s.Push(context.Background(), desc, bytes.NewReader(content))
+			if !errors.Is(err, ErrPathTraversalDisallowed) {
+				t.Errorf("Store.Push() error = %v, want %v", err, ErrPathTraversalDisallowed)
+			}
+			entries, err := os.ReadDir(outsideDir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(entries) != 0 {
+				t.Errorf("unexpected files written outside working dir: %v", entries)
+			}
+		})
+	}
+}
