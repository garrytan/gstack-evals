+    static final class BinaryTypesTest extends RowCompactedSerializerTest {
+        public BinaryTypesTest() {
+            super(getRowSerializer(), getData());
+        }
+
+        private static InternalRow[] getData() {
+            return new GenericRow[] {
+                GenericRow.of(null, null),
+                GenericRow.of(new byte[] {1, 2}, new byte[] {3}),
+                GenericRow.of(new byte[] {(byte) 0xFF}, new byte[0])
+            };
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(
+                    RowType.of(DataTypes.BINARY(2), DataTypes.VARBINARY(10)));
+        }
+
+        private static MemorySlice slice(byte[] b1, byte[] b2) {
+            return MemorySlice.wrap(getRowSerializer().serializeToBytes(GenericRow.of(b1, b2)));
+        }
+
+        @Test
+        public void testSliceComparatorWithBinaryTypes() {
+            Comparator<MemorySlice> comparator = getRowSerializer().createSliceComparator();
+
+            // equal
+            assertThat(
+                            comparator.compare(
+                                    slice(new byte[] {1, 2}, new byte[] {3}),
+                                    slice(new byte[] {1, 2}, new byte[] {3})))
+                    .isEqualTo(0);
+            // unsigned ordering: 0xFF > 0x01
+            assertThat(
+                            comparator.compare(
+                                    slice(new byte[] {1, 2}, new byte[] {3}),
+                                    slice(new byte[] {(byte) 0xFF, 0}, new byte[] {3})))
+                    .isLessThan(0);
+            // prefix is smaller
+            assertThat(
+                            comparator.compare(
+                                    slice(new byte[] {1, 2}, new byte[] {3, 4}),
+                                    slice(new byte[] {1, 2}, new byte[] {3})))
+                    .isGreaterThan(0);
+            // null first
+            assertThat(
+                            comparator.compare(
+                                    slice(new byte[] {1, 2}, null),
+                                    slice(new byte[] {1, 2}, new byte[0])))
+                    .isLessThan(0);
+        }
+    }
