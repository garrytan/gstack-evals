+TEST_F(BuildTest, DyndepReadyImplicitOutputIsOrderOnlyDepfileInput) {
+  // Verify that when a ready dyndep file is loaded while visiting an
+  // order-only input, a depfile-discovered input that it reveals to be a
+  // dirty output of that edge makes the depending edge dirty too.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out $out.imp\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"build dd: cp dd-in\n"
+"build tmp: touch tmp-in || dd\n"
+"  dyndep = dd\n"
+"build out: cp other || tmp\n"
+"  depfile = out.d\n"
+));
+  fs_.Create("dd-in",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("other", "");
+  fs_.Create("out.d", "out: tmp.imp\n");
+  fs_.Tick();
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("tmp", "");
+  fs_.Create("tmp.imp", "");
+  fs_.Create("out", "");
+  fs_.Tick();
+  fs_.Create("tmp-in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("out", &err));
+  ASSERT_EQ("", err);
+
+  // The dyndep file was loaded while scanning.
+  ASSERT_TRUE(GetNode("tmp.imp")->in_edge());
+  EXPECT_TRUE(GetNode("out")->dirty());
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch tmp tmp.imp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cp other out", command_runner_.commands_ran_[1]);
+}
