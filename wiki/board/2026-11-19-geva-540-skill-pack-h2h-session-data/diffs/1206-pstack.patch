new file mode 100644
index 0000000..7b7bbd3
--- /dev/null
+++ b/echo_static_encoded_slash_test.go
@@ -0,0 +1,47 @@
+package echo
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/fstest"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestStaticFS_EncodedSlashDoesNotBypassGroupMiddleware(t *testing.T) {
+	files := fstest.MapFS{
+		"admin/secret.txt": {Data: []byte("secret")},
+		"public.txt":       {Data: []byte("public")},
+		"a b.txt":          {Data: []byte("literal")},
+	}
+	e := New()
+	e.Group("/admin", func(next HandlerFunc) HandlerFunc {
+		return func(c *Context) error { return ErrForbidden }
+	}).GET("/*", func(c *Context) error { return c.String(http.StatusOK, "admin") })
+	e.StaticFS("/", files)
+
+	cases := []struct {
+		target string
+		code   int
+		body   string
+	}{
+		{"/public.txt", http.StatusOK, "public"},
+		{"/admin/secret.txt", http.StatusForbidden, ""},
+		{"/admin%2Fsecret.txt", http.StatusNotFound, ""},
+		{"/admin%2fsecret.txt", http.StatusNotFound, ""},
+		{"/admin%5Csecret.txt", http.StatusNotFound, ""},
+		{"/a%20b.txt", http.StatusOK, "literal"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.target, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, tc.target, nil))
+			assert.Equal(t, tc.code, rec.Code)
+			if tc.body != "" {
+				assert.Equal(t, tc.body, rec.Body.String())
+			}
+			assert.NotEqual(t, "secret", rec.Body.String())
+		})
+	}
+}
