@@ -0,0 +1,40 @@
+package middleware
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/fstest"
+
+	"github.com/labstack/echo/v5"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestStatic_GroupEncodedSlashDoesNotBypassGroupMiddleware(t *testing.T) {
+	e := echo.New()
+	e.Filesystem = fstest.MapFS{
+		"admin/secret.txt": {Data: []byte("secret")},
+		"public.txt":       {Data: []byte("public")},
+	}
+	e.Group("/admin", func(next echo.HandlerFunc) echo.HandlerFunc {
+		return func(c *echo.Context) error { return echo.ErrForbidden }
+	}).GET("/*", func(c *echo.Context) error { return c.String(http.StatusOK, "admin") })
+	e.Group("/", StaticWithConfig(StaticConfig{Root: "."})).GET("*", func(c *echo.Context) error {
+		return echo.ErrNotFound
+	})
+
+	cases := map[string]int{
+		"/public.txt":         http.StatusOK,
+		"/admin/secret.txt":   http.StatusForbidden,
+		"/admin%2Fsecret.txt": http.StatusNotFound,
+		"/admin%5Csecret.txt": http.StatusNotFound,
+	}
+	for target, code := range cases {
+		t.Run(target, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, target, nil))
+			assert.Equal(t, code, rec.Code)
+			assert.NotEqual(t, "secret", rec.Body.String())
+		})
+	}
+}
