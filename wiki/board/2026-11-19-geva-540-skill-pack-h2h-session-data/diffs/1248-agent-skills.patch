 	})
+
+	t.Run("hard link with a relative path should not resolve against CWD", func(t *testing.T) {
+		// set up a sentinel file in the process working directory
+		cwd := t.TempDir()
+		sentinelName := "sentinel.txt"
+		sentinelPath := filepath.Join(cwd, sentinelName)
+		if err := os.WriteFile(sentinelPath, []byte("secret"), 0600); err != nil {
+			t.Fatalf("failed to write sentinel: %v", err)
+		}
+		oldWd, err := os.Getwd()
+		if err != nil {
+			t.Fatalf("failed to get working directory: %v", err)
+		}
+		if err := os.Chdir(cwd); err != nil {
+			t.Fatalf("failed to change working directory: %v", err)
+		}
+		t.Cleanup(func() {
+			if err := os.Chdir(oldWd); err != nil {
+				t.Errorf("failed to restore working directory: %v", err)
+			}
+		})
+
+		tempDir := t.TempDir()
+		dirName := "base"
+		dirPath := filepath.Join(tempDir, dirName)
+		buf := make([]byte, 1024)
+
+		tarData := createTar(t, []tarEntry{
+			{name: "base/", mode: os.ModeDir | 0777},
+			{name: "base/evil_link", linkname: sentinelName, mode: 0666, isHardLink: true},
+		})
+
+		err = extractTarDirectory(dirPath, dirName, bytes.NewReader(tarData), buf, false)
+		if err != nil {
+			return // refusing to extract is acceptable
+		}
+		linkInfo, err := os.Stat(filepath.Join(dirPath, "evil_link"))
+		if err != nil {
+			return // link not created
+		}
+		sentinelInfo, err := os.Stat(sentinelPath)
+		if err != nil {
+			t.Fatalf("failed to stat sentinel: %v", err)
+		}
+		if os.SameFile(linkInfo, sentinelInfo) {
+			t.Fatal("hard link escaped the extract directory and points to a file in CWD")
+		}
+	})
+
+	t.Run("hard link with a relative path should resolve inside the extract directory", func(t *testing.T) {
+		tempDir := t.TempDir()
+		dirName := "base"
+		dirPath := filepath.Join(tempDir, dirName)
+		fileContent := "hello world"
+		buf := make([]byte, 1024)
+
+		tarData := createTar(t, []tarEntry{
+			{name: "base/", mode: os.ModeDir | 0777},
+			{name: "base/test.txt", content: fileContent, mode: 0666},
+			{name: "base/test_hardlink", linkname: "test.txt", mode: 0666, isHardLink: true},
+		})
+
+		if err := extractTarDirectory(dirPath, dirName, bytes.NewReader(tarData), buf, false); err != nil {
+			t.Fatalf("extractTarDirectory() error = %v", err)
+		}
+
+		targetInfo, err := os.Stat(filepath.Join(dirPath, "test.txt"))
+		if err != nil {
+			t.Fatalf("failed to stat target: %v", err)
+		}
+		linkInfo, err := os.Stat(filepath.Join(dirPath, "test_hardlink"))
+		if err != nil {
+			t.Fatalf("failed to stat hard link: %v", err)
+		}
+		if !os.SameFile(targetInfo, linkInfo) {
+			t.Error("hard link does not point to the target inside the extract directory")
+		}
+	})
