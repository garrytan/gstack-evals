diff --git a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
index d22b41f..7cfce8a 100644
--- a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
