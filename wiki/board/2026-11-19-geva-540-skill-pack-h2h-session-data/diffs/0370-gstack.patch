@@ -1072,3 +1072,48 @@ public class OptionSelectorTests
 
     #endregion
 }
+
+public class OptionSelectorTEnumInitTests
+{
+    private enum TestEnum
+    {
+        First,
+        Second,
+        Third
+    }
+
+    [Fact]
+    public void Generic_Fresh_Instance_First_CheckBox_Is_Checked ()
+    {
+        OptionSelector<TestEnum> selector = new ();
+
+        Assert.Equal (TestEnum.First, selector.Value);
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (3, checkBoxes.Length);
+        Assert.Equal (CheckState.Checked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [2].Value);
+    }
+
+    [Theory]
+    [InlineData (TabBehavior.TabStop)]
+    [InlineData (TabBehavior.NoStop)]
+    [InlineData (TabBehavior.TabGroup)]
+    public void Generic_TabBehavior_Set_Preserves_Checked_State (TabBehavior tabBehavior)
+    {
+        OptionSelector<TestEnum> selector = new () { TabBehavior = tabBehavior };
+
+        Assert.Equal (TestEnum.First, selector.Value);
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (CheckState.Checked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+
+        selector.Value = TestEnum.Third;
+        selector.TabBehavior = TabBehavior.NoStop == tabBehavior ? TabBehavior.TabStop : TabBehavior.NoStop;
+        checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (CheckState.UnChecked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.Checked, checkBoxes [2].Value);
+    }
+}
