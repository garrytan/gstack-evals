diff --git a/tests/issues/nested-inline-embeddable-null.test.ts b/tests/issues/nested-inline-embeddable-null.test.ts
new file mode 100644
index 0000000..ff68252
--- /dev/null
+++ b/tests/issues/nested-inline-embeddable-null.test.ts
@@ -0,0 +1,50 @@
+import { MikroORM } from '@mikro-orm/sqlite';
+import { Embeddable, Embedded, Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';
+
+@Embeddable()
+class Inner {
+  @Property({ nullable: true })
+  value?: string;
+}
+
+@Embeddable()
+class Outer {
+  @Property({ nullable: true })
+  name?: string;
+
+  @Embedded(() => Inner, { nullable: true })
+  inner?: Inner | null;
+}
+
+@Entity()
+class Parent {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Outer, { nullable: true })
+  outer?: Outer | null;
+}
+
+let orm: MikroORM;
+
+beforeAll(async () => {
+  orm = await MikroORM.init({ dbName: ':memory:', entities: [Parent], metadataProvider: ReflectMetadataProvider });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+
+test('nested inline embeddable with null parent', async () => {
+  const p = orm.em.create(Parent, { outer: { name: 'a', inner: { value: 'b' } } });
+  await orm.em.flush();
+  p.outer = null;
+  await orm.em.flush();
+  orm.em.clear();
+  const p2 = await orm.em.findOneOrFail(Parent, p.id);
+  expect(p2.outer).toBeNull();
+  const p3 = orm.em.create(Parent, { outer: null });
+  await orm.em.flush();
+  orm.em.clear();
+  const p4 = await orm.em.findOneOrFail(Parent, p3.id);
+  expect(p4.outer).toBeNull();
+});
