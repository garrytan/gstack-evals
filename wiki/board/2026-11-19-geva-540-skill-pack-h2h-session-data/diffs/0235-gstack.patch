     [Category("UnitTest")]
     public class WaveFileWriterTests
     {
+        [Test]
+        public void PcmFormatChunkShouldNotIncludeCbSize()
+        {
+            var ms = new MemoryStream();
+            using (var writer = new WaveFileWriter(new IgnoreDisposeStream(ms), new WaveFormat(44100, 16, 2)))
+            {
+                writer.Write(new byte[4], 0, 4);
+            }
+            var bytes = ms.ToArray();
+            Assert.That(System.Text.Encoding.ASCII.GetString(bytes, 12, 4), Is.EqualTo("fmt "));
+            Assert.That(BitConverter.ToInt32(bytes, 16), Is.EqualTo(16), "fmt chunk length");
+            Assert.That(System.Text.Encoding.ASCII.GetString(bytes, 36, 4), Is.EqualTo("data"));
+            Assert.That(bytes.Length, Is.EqualTo(44 + 4));
+        }
+
+        [Test]
+        public void NonPcmFormatChunkShouldIncludeCbSize()
+        {
+            var ms = new MemoryStream();
+            using (var writer = new WaveFileWriter(new IgnoreDisposeStream(ms), WaveFormat.CreateIeeeFloatWaveFormat(44100, 2)))
+            {
+                writer.Write(new byte[8], 0, 8);
+            }
+            var bytes = ms.ToArray();
+            Assert.That(BitConverter.ToInt32(bytes, 16), Is.EqualTo(18), "fmt chunk length");
+            Assert.That(BitConverter.ToInt16(bytes, 36), Is.EqualTo(0), "cbSize");
+        }
+
