+package httpserver
+
+import (
+	"archive/zip"
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func setupBulkACL(t *testing.T) (*FileServer, string) {
+	t.Helper()
+	root := t.TempDir()
+	prot := filepath.Join(root, "protected")
+	require.NoError(t, os.MkdirAll(filepath.Join(prot, "sub"), 0755))
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := `{"auth":"admin:` + string(hash) + `","block":["blocked.txt"]}`
+	require.NoError(t, os.WriteFile(filepath.Join(prot, ".goshs"), []byte(acl), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "secret.txt"), []byte("secret"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "blocked.txt"), []byte("blocked"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "sub", "deep.txt"), []byte("deep"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(root, "public.txt"), []byte("public"), 0644))
+	fs, _ := newTestFileServer(t, root)
+	return fs, root
+}
+
+func zipNames(t *testing.T, body []byte) map[string]string {
+	t.Helper()
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	out := map[string]string{}
+	for _, f := range zr.File {
+		rc, err := f.Open()
+		require.NoError(t, err)
+		b, _ := io.ReadAll(rc)
+		rc.Close()
+		out[f.Name] = string(b)
+	}
+	return out
+}
+
+func TestBulkDownload_ACLUnauthenticated(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	for _, q := range []string{
+		"/?bulk&file=/protected/secret.txt",
+		"/?bulk&file=/protected/sub/deep.txt",
+		"/?bulk&file=/protected",
+		"/?bulk&file=/",
+		"/?bulk&file=/public.txt&file=/protected/secret.txt",
+	} {
+		w := httptest.NewRecorder()
+		fs.bulkDownload(w, httptest.NewRequest(http.MethodGet, q, nil))
+		require.Equal(t, http.StatusUnauthorized, w.Code, q)
+		require.NotContains(t, w.Body.String(), "secret", q)
+	}
+}
+
+func TestBulkDownload_ACLWrongPassword(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected/secret.txt", nil)
+	r.SetBasicAuth("admin", "wrong")
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+}
+
+func TestBulkDownload_ACLAuthorizedHonorsBlock(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected&file=/protected/blocked.txt", nil)
+	r.SetBasicAuth("admin", "admin")
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	names := zipNames(t, w.Body.Bytes())
+	require.Equal(t, "secret", names["protected/secret.txt"])
+	require.Equal(t, "deep", names["protected/sub/deep.txt"])
+	require.NotContains(t, names, "protected/blocked.txt")
+	require.NotContains(t, names, "protected/.goshs")
+}
+
+func TestBulkDownload_PublicStillWorks(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, httptest.NewRequest(http.MethodGet, "/?bulk&file=/public.txt", nil))
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, "public", zipNames(t, w.Body.Bytes())["public.txt"])
+}
