+package io.agentscope.harness.agent.filesystem;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.harness.agent.filesystem.model.FileInfo;
+import io.agentscope.harness.agent.filesystem.model.GlobResult;
+import io.agentscope.harness.agent.filesystem.remote.RemoteFilesystem;
+import io.agentscope.harness.agent.filesystem.remote.store.InMemoryStore;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class RemoteFilesystemGlobTest {
+
+    private static final RuntimeContext CTX = RuntimeContext.empty();
+
+    private static List<String> globPaths(RemoteFilesystem fs, String pattern, String path) {
+        GlobResult result = fs.glob(CTX, pattern, path);
+        assertTrue(result.isSuccess());
+        return result.matches().stream().map(FileInfo::path).toList();
+    }
+
+    @Test
+    void recursiveGlobMatchesFileAtSearchRootAndNested() {
+        RemoteFilesystem fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        fs.write(CTX, "/hello.txt", "hello");
+        fs.write(CTX, "/reports/hello.txt", "hello");
+        fs.write(CTX, "/reports/archive/hello.txt", "hello");
+        fs.write(CTX, "/reports/other.md", "x");
+
+        assertEquals(
+                List.of("/hello.txt", "/reports/archive/hello.txt", "/reports/hello.txt"),
+                globPaths(fs, "**/hello.txt", "/"));
+    }
+
+    @Test
+    void recursiveWildcardGlobMatchesRootLevelFiles() {
+        RemoteFilesystem fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        fs.write(CTX, "/hello.txt", "hello");
+        fs.write(CTX, "/reports/report.txt", "r");
+        fs.write(CTX, "/reports/report.md", "r");
+
+        assertEquals(List.of("/hello.txt", "/reports/report.txt"), globPaths(fs, "**/*.txt", "/"));
+    }
+
+    @Test
+    void recursiveGlobMatchesFileAtRootOfSubdirectorySearchPath() {
+        RemoteFilesystem fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        fs.write(CTX, "/hello.txt", "hello");
+        fs.write(CTX, "/reports/hello.txt", "hello");
+        fs.write(CTX, "/reports/archive/hello.txt", "hello");
+
+        assertEquals(
+                List.of("/reports/archive/hello.txt", "/reports/hello.txt"),
+                globPaths(fs, "**/hello.txt", "/reports"));
+    }
+
+    @Test
+    void globSupportsBraceAlternationAndCharacterClasses() {
+        RemoteFilesystem fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        fs.write(CTX, "/a1.txt", "a");
+        fs.write(CTX, "/docs/b2.md", "b");
+        fs.write(CTX, "/docs/cx.md", "c");
+        fs.write(CTX, "/docs/d3.java", "d");
+
+        assertEquals(List.of("/a1.txt", "/docs/b2.md"), globPaths(fs, "**/?[0-9].{txt,md}", "/"));
+    }
+
+    @Test
+    void nonRecursiveGlobStillMatchesAtAnyDepthAsBefore() {
+        RemoteFilesystem fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        fs.write(CTX, "/a.txt", "a");
+        fs.write(CTX, "/dir/b.txt", "b");
+
+        assertEquals(List.of("/a.txt", "/dir/b.txt"), globPaths(fs, "*.txt", "/"));
+    }
+}
