+	"github.com/getkin/kin-openapi/openapi3filter"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestArrayWithoutItemsDoesNotPanic(t *testing.T) {
+	const spec = `
+openapi: 3.1.0
+info: {title: t, version: 1.0.0}
+paths:
+  /f:
+    post:
+      requestBody:
+        required: true
+        content:
+          application/x-www-form-urlencoded:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /upload:
+    post:
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /hdr/{ids}:
+    get:
+      parameters:
+        - {name: ids, in: path, required: true, schema: {type: array}}
+        - {name: q, in: query, schema: {type: array}}
+        - {name: c, in: cookie, schema: {type: array}}
+      responses:
+        '200':
+          description: ok
+          headers:
+            X-Tags:
+              schema: {type: array}
+`
+	loader := openapi3.NewLoader()
+	doc, err := loader.LoadFromData([]byte(spec))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(loader.Context))
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+	opts := &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc}
+
+	validate := func(req *http.Request) error {
+		route, pp, err := router.FindRoute(req)
+		require.NoError(t, err)
+		return openapi3filter.ValidateRequest(loader.Context, &openapi3filter.RequestValidationInput{
+			Request: req, PathParams: pp, Route: route, Options: opts,
+		})
+	}
+
+	t.Run("urlencoded", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodPost, "/f", strings.NewReader("tags=a"))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		require.NotPanics(t, func() { require.Error(t, validate(req)) })
+	})
+
+	t.Run("multipart", func(t *testing.T) {
+		var buf bytes.Buffer
+		w := multipart.NewWriter(&buf)
+		require.NoError(t, w.WriteField("tags", "a"))
+		require.NoError(t, w.Close())
+		req, _ := http.NewRequest(http.MethodPost, "/upload", &buf)
+		req.Header.Set("Content-Type", w.FormDataContentType())
+		require.NotPanics(t, func() { require.Error(t, validate(req)) })
+	})
+
+	t.Run("path query cookie params", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/hdr/a,b?q=x&q=y", nil)
+		req.AddCookie(&http.Cookie{Name: "c", Value: "a,b"})
+		require.NotPanics(t, func() { require.Error(t, validate(req)) })
+	})
+
+	t.Run("response header", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/hdr/a", nil)
+		route, pp, err := router.FindRoute(req)
+		require.NoError(t, err)
+		require.NotPanics(t, func() {
+			err := openapi3filter.ValidateResponse(loader.Context, &openapi3filter.ResponseValidationInput{
+				RequestValidationInput: &openapi3filter.RequestValidationInput{
+					Request: req, PathParams: pp, Route: route, Options: opts,
+				},
+				Status: http.StatusOK,
+				Header: http.Header{"X-Tags": []string{"a,b"}},
+				Body:   io.NopCloser(strings.NewReader("")),
+			})
+			require.Error(t, err)
+		})
+	})
+}
