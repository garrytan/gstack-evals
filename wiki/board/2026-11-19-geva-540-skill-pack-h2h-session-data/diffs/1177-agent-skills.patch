+// validateFileName ensures the given name is a single, local path element
+// so that it cannot escape the directory it is joined with.
+func validateFileName(name string) error {
+	if name == "" || name == "." || name == ".." {
+		return xerrors.Errorf("%q is not a valid file name", name)
+	}
+	if strings.ContainsAny(name, `/\`) || filepath.Base(name) != name || !filepath.IsLocal(name) {
+		return xerrors.Errorf("%q must not contain path separators", name)
+	}
+	return nil
+}
