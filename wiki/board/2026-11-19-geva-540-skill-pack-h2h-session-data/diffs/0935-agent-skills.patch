+func TestEmptyCiphertextWithValidTag(t *testing.T) {
+	key := make([]byte, 32)
+	nonce := make([]byte, 16)
+
+	aead, err := NewCBCHMAC(key, aes.NewCipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := aead.(*cbcAEAD)
+
+	// Ciphertext consisting solely of a valid auth tag over empty ciphertext.
+	ct := ctx.computeAuthTag(nil, nonce, nil)
+
+	_, err = aead.Open(nil, nonce, ct, nil)
+	if err == nil {
+		t.Error("open on empty ciphertext should fail")
+	}
+}
+
+func TestUnpadEmptyBuffer(t *testing.T) {
+	if _, err := unpadBuffer([]byte{}, aes.BlockSize); err == nil {
+		t.Error("unpad of empty buffer should fail")
+	}
+}
