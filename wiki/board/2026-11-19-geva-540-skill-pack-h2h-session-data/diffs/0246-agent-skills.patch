+
+func Test_applyFieldOverriders_EmptyPatchesReturnsErrorAndKeepsField(t *testing.T) {
+	tests := []struct {
+		name     string
+		override policyv1alpha1.FieldOverrider
+	}{
+		{
+			name:     "yaml and json omitted",
+			override: policyv1alpha1.FieldOverrider{FieldPath: "/data/config"},
+		},
+		{
+			name: "yaml and json empty arrays",
+			override: policyv1alpha1.FieldOverrider{
+				FieldPath: "/data/config",
+				YAML:      []policyv1alpha1.YAMLPatchOperation{},
+				JSON:      []policyv1alpha1.JSONPatchOperation{},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rawObj := &unstructured.Unstructured{Object: map[string]interface{}{
+				"apiVersion": "v1",
+				"kind":       "ConfigMap",
+				"data": map[string]interface{}{
+					"config": "foo: bar\n",
+				},
+			}}
+
+			err := applyFieldOverriders(rawObj, []policyv1alpha1.FieldOverrider{tt.override})
+
+			if err == nil {
+				t.Fatalf("expected an error for FieldOverrider without YAML or JSON patches, got none")
+			}
+			got, _, _ := unstructured.NestedString(rawObj.Object, "data", "config")
+			if got != "foo: bar\n" {
+				t.Fatalf("expected field to be left untouched, got %q", got)
+			}
+		})
+	}
+}
