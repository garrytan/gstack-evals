+    [Test]
+    public void TestDayLightSavingEndWithDailyHourInterval()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        // 2020-10-25 is a 25 hour day in CET (DST ends at 03:00 local time)
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .WithIdentity("id")
+            .ForJob("job")
+            .StartAt(new DateTimeOffset(2020, 10, 25, 0, 1, 5, TimeSpan.FromHours(2)))
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithIntervalInHours(24)
+                .StartingDailyAt(new TimeOfDay(0, 1, 5))
+                .EndingDailyAt(new TimeOfDay(23, 59, 59))
+                .InTimeZone(timeZoneInfo)
+                .WithMisfireHandlingInstructionDoNothing())
+            .Build();
+
+        var start = new DateTimeOffset(2020, 10, 25, 0, 0, 0, TimeSpan.FromHours(2));
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, start, start.AddDays(3));
+
+        Assert.That(fireTimes, Is.EqualTo(new[]
+        {
+            new DateTimeOffset(2020, 10, 25, 0, 1, 5, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 10, 26, 0, 1, 5, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 10, 27, 0, 1, 5, TimeSpan.FromHours(1)),
+        }));
+    }
+
+    [Test]
+    public void TestDayLightSavingStartWithHourIntervalKeepsWallClockSchedule()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        // 2020-03-29 is a 23 hour day in CET (DST starts at 02:00 local time)
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .WithIdentity("id")
+            .ForJob("job")
+            .StartAt(new DateTimeOffset(2020, 3, 29, 0, 0, 0, TimeSpan.FromHours(1)))
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithIntervalInHours(6)
+                .StartingDailyAt(new TimeOfDay(0, 0))
+                .EndingDailyAt(new TimeOfDay(23, 59, 59))
+                .InTimeZone(timeZoneInfo))
+            .Build();
+
+        var start = new DateTimeOffset(2020, 3, 29, 0, 0, 0, TimeSpan.FromHours(1));
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, start, start.AddHours(22));
+
+        Assert.That(fireTimes, Is.EqualTo(new[]
+        {
+            new DateTimeOffset(2020, 3, 29, 0, 0, 0, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 3, 29, 6, 0, 0, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 3, 29, 12, 0, 0, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 3, 29, 18, 0, 0, TimeSpan.FromHours(2)),
+        }));
+    }
