+// Regression test: pog failed to compile with `Ssl` unbound
+#[test]
+fn inline_variable_in_record_update() {
+    assert_erl!(
+        ("gleam_stdlib", "gleam/result", RESULT_MODULE),
+        "
+import gleam/result
+
+pub type Config {
+  Config(ssl: Int, port: Int)
+}
+
+pub fn set_ssl(config: Config, value: Result(Int, Nil)) -> Result(Config, Nil) {
+  use ssl <- result.try(value)
+  Ok(Config(..config, ssl:))
+}
+"
+    );
+}
+
+#[test]
+fn do_not_inline_variable_used_in_guard() {
+    assert_erl!(
+        ("gleam_stdlib", "gleam/result", RESULT_MODULE),
+        "
+import gleam/result
+
+pub fn main(value: Result(Int, Nil), other: Int) -> Result(Int, Nil) {
+  use x <- result.try(value)
+  case other {
+    _ if x > 1 -> Ok(1)
+    _ -> Ok(2)
+  }
+}
+"
+    );
+}
