+// stripTrailerValues returns a copy of the given trailer containing only the declared names, without any values.
+func stripTrailerValues(trailer http.Header) http.Header {
+	if trailer == nil {
+		return nil
+	}
+
+	stripped := make(http.Header, len(trailer))
+	for key := range trailer {
+		stripped[key] = nil
+	}
