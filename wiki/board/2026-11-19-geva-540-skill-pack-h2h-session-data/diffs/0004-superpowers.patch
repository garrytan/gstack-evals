+    // MSDF atlases must be created without mipmaps - averaging the distance channels per mip level
+    // corrupts the median and produces artifacts on minified text
+    it('creates msdf font textures without mipmaps', function (done) {
+        const asset = new Asset('arial', 'font', {
+            url: 'http://localhost:3210/test/assets/fonts/arial.json'
+        });
+
+        app.assets.add(asset);
+        app.assets.load(asset);
+
+        asset.ready(function () {
+            const texture = asset.resource.textures[0];
+            expect(texture.mipmaps).to.equal(false);
+            expect(texture.minFilter).to.equal(FILTER_LINEAR);
+            // texture name must remain the loader cache key
+            expect(app.loader.getFromCache(texture.name, 'texture')).to.equal(texture);
+            done();
+        });
+
+        asset.on('error', err => done(new Error(err)));
+    });
+
+    it('keeps mipmaps for bitmap font textures', function (done) {
+        const asset = new Asset('arial', 'font', {
+            url: 'http://localhost:3210/test/assets/fonts/arial.png'
+        }, {
+            version: 3,
+            type: 'bitmap',
+            info: { face: 'arial', maps: [{ width: 1024, height: 512 }] },
+            chars: {}
+        });
+
+        app.assets.add(asset);
+        app.assets.load(asset);
+
+        asset.ready(function () {
+            const texture = asset.resource.textures[0];
+            expect(texture.mipmaps).to.equal(true);
+            expect(texture.minFilter).to.equal(FILTER_LINEAR_MIPMAP_LINEAR);
+            done();
+        });
+
+        asset.on('error', err => done(new Error(err)));
