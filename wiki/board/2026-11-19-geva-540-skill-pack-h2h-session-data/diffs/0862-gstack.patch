+  @Test
+  fun `escapes backslashes in quoted strings`() {
+    val evaluator = Evaluator.preconfigured()
+    val module = evaluator.evaluate(ModuleSource.text("foo = \"\\t\\\\d\""))
+    val writer = StringWriter()
+    val renderer = ValueRenderers.yaml(writer, 2, true, false)
+    renderer.renderDocument(module)
+    val output = writer.toString()
+    assertThat(output).isEqualTo("foo: \"\\t\\\\d\"\n")
+    val loaded = Load(LoadSettings.builder().build()).loadFromString(output) as Map<*, *>
+    assertThat(loaded["foo"]).isEqualTo("\t\\d")
+  }
