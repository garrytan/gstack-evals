+    [Test]
+    [Category("UnitTest")]
+    public void MalformedAiffWithTruncatedSsndDoesNotThrowOnRead()
+    {
+        // 64-byte AIFF: COMM declares 32-bit samples (BlockAlign = 4 for mono),
+        // but the SSND chunk's effective audio payload is only 2 bytes long.
+        byte[] payload = new byte[]
+        {
+            0x46,0x4f,0x52,0x4d, 0x00,0x00,0x00,0x26, 0x41,0x49,0x46,0x46, 0x43,0x4f,0x4d,0x4d,
+            0x00,0x00,0x00,0x12, 0x00,0x01, 0x00,0x0b,0x00,0x00, 0x00,0x20, 0x00,0x00,0x00,0xe6,
+            0x00,0x00,0x00,0x19, 0x00,0x00, 0x53,0x53,0x4e,0x44, 0x00,0x00,0x00,0x0a, 0x00,0x00,
+            0x00,0x00, 0x00,0x24, 0x24,0x24,0x24,0x24, 0x45,0x66,0x63,0xf9, 0x00,0x00,0x00,0x53
+        };
+        Assert.That(payload.Length, Is.EqualTo(64));
+
+        using var reader = new AiffFileReader(new MemoryStream(payload));
+        var buffer = new byte[4096];
+        Assert.DoesNotThrow(() =>
+        {
+            while (reader.Read(buffer, 0, buffer.Length) > 0) { }
+        });
+    }
+
+    private static readonly byte[] Signed8BitSamples =
+    {
+        0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x0A,
+        0x80, 0x83, 0x85, 0x88, 0x8A, 0x8D, 0x8F, 0x92
+    };
+
+    private static byte[] Build8BitMonoAiff(byte[] samples)
+    {
+        var ms = new MemoryStream();
+        void WriteBE32(int v) { ms.WriteByte((byte)(v >> 24)); ms.WriteByte((byte)(v >> 16)); ms.WriteByte((byte)(v >> 8)); ms.WriteByte((byte)v); }
+        void WriteBE16(int v) { ms.WriteByte((byte)(v >> 8)); ms.WriteByte((byte)v); }
+        void WriteId(string id) { foreach (char c in id) ms.WriteByte((byte)c); }
+
+        WriteId("FORM");
+        WriteBE32(4 + (8 + 18) + (8 + 8 + samples.Length));
+        WriteId("AIFF");
+        WriteId("COMM");
+        WriteBE32(18);
+        WriteBE16(1);              // channels
+        WriteBE32(samples.Length); // sample frames
+        WriteBE16(8);              // sample size
+        // 44100 as 80-bit IEEE extended
+        ms.Write(new byte[] { 0x40, 0x0E, 0xAC, 0x44, 0, 0, 0, 0, 0, 0 }, 0, 10);
+        WriteId("SSND");
+        WriteBE32(8 + samples.Length);
+        WriteBE32(0); // offset
+        WriteBE32(0); // block size
+        ms.Write(samples, 0, samples.Length);
+        return ms.ToArray();
+    }
+
+    [Test]
+    [Category("UnitTest")]
+    public void EightBitAiffIsReadAsSignedPcm()
+    {
+        using var reader = new AiffFileReader(new MemoryStream(Build8BitMonoAiff(Signed8BitSamples)));
+        Assert.That(reader.WaveFormat.BitsPerSample, Is.EqualTo(8));
+        var sampleProvider = reader.ToSampleProvider();
+        var buffer = new float[Signed8BitSamples.Length];
+        int read = sampleProvider.Read(buffer.AsSpan());
+        Assert.That(read, Is.EqualTo(Signed8BitSamples.Length));
+        for (int i = 0; i < Signed8BitSamples.Length; i++)
+        {
+            Assert.That(buffer[i], Is.EqualTo((sbyte)Signed8BitSamples[i] / 128f), $"sample {i}");
+        }
+    }
+
+    [Test]
+    [Category("UnitTest")]
+    public void EightBitAiffRoundTripsThroughWriter()
+    {
+        byte[] original = Build8BitMonoAiff(Signed8BitSamples);
+        byte[] unsignedPcm;
+        using (var reader = new AiffFileReader(new MemoryStream(original)))
+        {
+            unsignedPcm = new byte[reader.Length];
+            Assert.That(reader.Read(unsignedPcm, 0, unsignedPcm.Length), Is.EqualTo(unsignedPcm.Length));
+        }
+        // WAV-style unsigned: 0x0A signed (10) -> 138 unsigned
+        Assert.That(unsignedPcm[0], Is.EqualTo(138));
+        Assert.That(unsignedPcm[8], Is.EqualTo(0));
+
+        var output = new MemoryStream();
+        using (var writer = new AiffFileWriter(new NAudio.Utils.IgnoreDisposeStream(output), new WaveFormat(44100, 8, 1)))
+        {
+            writer.Write(unsignedPcm, 0, unsignedPcm.Length);
+        }
+        output.Position = 0;
+        using var reader2 = new AiffFileReader(output);
+        var roundTripped = new byte[reader2.Length];
+        Assert.That(reader2.Read(roundTripped, 0, roundTripped.Length), Is.EqualTo(roundTripped.Length));
+        Assert.That(roundTripped, Is.EqualTo(unsignedPcm));
+    }
