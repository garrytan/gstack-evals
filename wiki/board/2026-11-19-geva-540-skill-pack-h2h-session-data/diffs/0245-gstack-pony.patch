+func Test_applyFieldOverriders_EmptyPatches(t *testing.T) {
+	obj := &unstructured.Unstructured{Object: map[string]interface{}{
+		"data": map[string]interface{}{"config": "a: b"},
+	}}
+	err := applyFieldOverriders(obj, []policyv1alpha1.FieldOverrider{{FieldPath: "/data/config"}})
+	if err == nil {
+		t.Fatal("expected error for FieldOverrider without YAML or JSON")
+	}
+	if got := obj.Object["data"].(map[string]interface{})["config"]; got != "a: b" {
+		t.Fatalf("field was modified: %v", got)
+	}
+}
