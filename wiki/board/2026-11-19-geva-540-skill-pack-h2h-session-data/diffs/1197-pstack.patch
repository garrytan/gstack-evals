+// Strip any directory component (either separator) and reject dot-only names,
+// so a server-chosen filename can never steer the write outside `dir`.
+export function safeFilename(name: string): string {
+  const base = (name.split(/[\\/]/).pop() ?? '').replace(/\0/g, '').trim();
+  return base && !/^\.+$/.test(base) ? base : 'download.bin';
+}
+
+const MAX_REDIRECTS = 10;
+
+// Follow redirects by hand so every hop passes the origin fence, matching the
+// browser-side fence that guards top-level navigations.
+async function fencedFetch(url: string): Promise<Response> {
+  const fence = parseFenceEnv();
+  let current = url;
+  for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
+    const v = checkUrlAllowed(current, fence);
+    if (!v.allowed) {
+      throw new Error(`fetch fallback refused by origin fence: ${v.reason ?? current}`);
+    }
+    const res = await fetch(current, { redirect: 'manual' });
+    const loc = res.headers.get('location');
+    if (res.status < 300 || res.status >= 400 || !loc) return res;
+    current = new URL(loc, current).toString();
+  }
+  throw new Error(`fetch fallback: too many redirects for ${url}`);
+}
