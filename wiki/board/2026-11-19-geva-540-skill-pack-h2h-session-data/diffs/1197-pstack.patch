diff --git a/test/download.test.ts b/test/download.test.ts
new file mode 100644
index 0000000..b59288e
--- /dev/null
+++ b/test/download.test.ts
@@ -0,0 +1,36 @@
+import { describe, it, expect } from 'vitest';
+import { join } from 'path';
+import { DOWNLOAD_DIR, safeFilename } from '../src/download.js';
+import { confineUnder } from '../src/paths.js';
+
+describe('download path confinement', () => {
+  it('keeps relative save_dir under the download root', () => {
+    expect(confineUnder(DOWNLOAD_DIR, 'reports/2026', 'save_dir')).toBe(
+      join(DOWNLOAD_DIR, 'reports', '2026'),
+    );
+  });
+
+  it('rejects absolute and escaping save_dir', () => {
+    for (const d of [
+      '/root',
+      '/tmp/x',
+      'C:\\Users',
+      '\\\\host\\share',
+      '..',
+      '../..',
+      'a/../../b',
+      'x\0y',
+    ]) {
+      expect(() => confineUnder(DOWNLOAD_DIR, d, 'save_dir')).toThrow(/save_dir/);
+    }
+  });
+
+  it('reduces filenames to a bare basename', () => {
+    expect(safeFilename('../../.bashrc')).toBe('.bashrc');
+    expect(safeFilename('..\\..\\evil.bat')).toBe('evil.bat');
+    expect(safeFilename('/etc/cron.d/job')).toBe('job');
+    expect(safeFilename('..')).toBe('download.bin');
+    expect(safeFilename('')).toBe('download.bin');
+    expect(safeFilename('report.pdf')).toBe('report.pdf');
+  });
+});
