diff --git a/src/paths.ts b/src/paths.ts
new file mode 100644
index 0000000..43aaad8
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,22 @@
+import { isAbsolute, relative, resolve, sep } from 'path';
+
+// Resolve a caller-supplied relative path under `root`, rejecting anything
+// that could land outside it. MCP callers control these arguments, so an
+// absolute path or `..` escape would be an arbitrary file write.
+export function confineUnder(root: string, rel: string, label: string): string {
+  if (isAbsolute(rel) || /^[A-Za-z]:/.test(rel) || rel.startsWith('\\') || rel.includes('\0')) {
+    throw new Error(`${label} must be a relative path inside ${root}`);
+  }
+  const base = resolve(root);
+  const out = resolve(base, rel);
+  const r = relative(base, out);
+  if (
+    r === '..' ||
+    r.startsWith('..' + sep) ||
+    isAbsolute(r) ||
+    rel.split(/[\\/]/).includes('..')
+  ) {
+    throw new Error(`${label} escapes ${root}: ${JSON.stringify(rel)}`);
+  }
+  return out;
+}
