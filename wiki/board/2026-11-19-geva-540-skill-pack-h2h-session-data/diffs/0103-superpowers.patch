diff --git a/tests/libuilogic/Ocr/OcrFixWithoutDictionaryTests.cs b/tests/libuilogic/Ocr/OcrFixWithoutDictionaryTests.cs
new file mode 100644
index 0000000..29e78d9
--- /dev/null
+++ b/tests/libuilogic/Ocr/OcrFixWithoutDictionaryTests.cs
@@ -0,0 +1,50 @@
+using System;
+using System.IO;
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+
+namespace LibUiLogicTests.Ocr;
+
+public class OcrFixWithoutDictionaryTests
+{
+    // "Fix common OCR errors" must apply the *_OCRFixReplaceList.xml even when no Hunspell
+    // dictionary is installed for the language (as Subtitle Edit 4 did).
+    [Fact]
+    public void ReplaceList_IsApplied_WhenNoHunspellDictionaryExists()
+    {
+        var dir = Path.Combine(Path.GetTempPath(), "se_ocrfix_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(dir);
+        var oldFolder = SpellCheckConfig.DictionariesFolder;
+        try
+        {
+            File.WriteAllText(Path.Combine(dir, "spa_OCRFixReplaceList.xml"),
+                "<ReplaceList><WholeWords>" +
+                "<Word from=\"aca\" to=\"acá\" /><Word from=\"Adios\" to=\"Adiós\" />" +
+                "<Word from=\"Algun\" to=\"Algún\" /><Word from=\"dia\" to=\"día\" />" +
+                "<Word from=\"volvere\" to=\"volveré\" />" +
+                "</WholeWords><PartialLines/><BeginLines/><EndLines/><WholeLines/><RegularExpressions/></ReplaceList>");
+            SpellCheckConfig.DictionariesFolder = () => dir;
+
+            var spellChecker = new SpellChecker();
+            Assert.Empty(spellChecker.GetDictionaryLanguages(dir));
+
+            var subtitle = new Subtitle();
+            subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+            subtitle.Paragraphs.Add(new Paragraph("Adios.", 1000, 2000));
+            subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 2000, 3000));
+
+            IOcrFixEngine engine = new OcrFixEngine(spellChecker);
+            engine.Initialize(subtitle, "spa", new SpellCheckDictionaryDisplay());
+
+            Assert.Equal("Hola, acá estoy.", engine.FixOcrErrors(0, subtitle.Paragraphs[0].Text, true).GetText());
+            Assert.Equal("Adiós.", engine.FixOcrErrors(1, subtitle.Paragraphs[1].Text, true).GetText());
+            Assert.Equal("Algún día volveré.", engine.FixOcrErrors(2, subtitle.Paragraphs[2].Text, true).GetText());
+        }
+        finally
+        {
+            SpellCheckConfig.DictionariesFolder = oldFolder;
+            Directory.Delete(dir, true);
+        }
+    }
+}
