+package tools.jackson.databind.deser.bean;
+
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.databind.DatabindException;
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+// Existing instances of local/anonymous classes should be updatable
+// via `readerForUpdating()`, even though they cannot be instantiated
+public class UpdateLocalAnonymousClassTest extends DatabindTestUtil
+{
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testUpdateAnonymousClassInstance() throws Exception
+    {
+        final Object anon = new Object() {
+            public int value;
+
+            @Override
+            public String toString() { return String.valueOf(value); }
+        };
+        Object result = MAPPER.readerForUpdating(anon)
+                .readValue(a2q("{'value':2}"));
+        assertSame(anon, result);
+        assertEquals("2", anon.toString());
+    }
+
+    @Test
+    public void testUpdateLocalClassInstance() throws Exception
+    {
+        class Local {
+            public int x;
+            public String name;
+        }
+        Local local = new Local();
+        Local result = MAPPER.readerForUpdating(local)
+                .readValue(a2q("{'x':3,'name':'abc'}"));
+        assertSame(local, result);
+        assertEquals(3, local.x);
+        assertEquals("abc", local.name);
+    }
+
+    @Test
+    public void testCannotCreateLocalClassInstance() throws Exception
+    {
+        class Local {
+            public int x;
+        }
+        assertThrows(DatabindException.class,
+                () -> MAPPER.readValue(a2q("{'x':3}"), Local.class));
+    }
+}
