+// Copyright (c) ClaceIO, LLC
+// SPDX-License-Identifier: Apache-2.0
+
+package app
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/openrundev/openrun/internal/types"
+)
+
+func TestValidatedRefererRedirect(t *testing.T) {
+	a := &App{serverConfig: &types.ServerConfig{}}
+	tests := []struct {
+		referrer string
+		want     string
+		ok       bool
+	}{
+		{"http://127.0.0.1:25222/app/page?x=1#f", "/app/page?x=1#f", true},
+		{"http://127.0.0.1:25222", "/", true},
+		{"/app/page", "/app/page", true},
+		{"http://evil.com/app", "", false},
+		{"http://127.0.0.1:25222//evil.com", "", false},
+		{"http://127.0.0.1:25222//evil.com/path", "", false},
+		{"//evil.com", "", false},
+		{"///evil.com", "", false},
+		{"/\\evil.com", "/%5Cevil.com", true},
+		{"http://127.0.0.1:25222/\\evil.com", "/%5Cevil.com", true},
+	}
+	for _, tt := range tests {
+		r := httptest.NewRequest("POST", "http://127.0.0.1:25222/app/abc", nil)
+		got, ok := a.validatedRefererRedirect(r, tt.referrer)
+		if got != tt.want || ok != tt.ok {
+			t.Errorf("referrer %q: got (%q, %v), want (%q, %v)", tt.referrer, got, ok, tt.want, tt.ok)
+		}
+	}
+}
