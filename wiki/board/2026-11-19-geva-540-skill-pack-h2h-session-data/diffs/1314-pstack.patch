+
+package hugolib
+
+import (
+	"strings"
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+)
+
+func TestSecurityAllowContentHTML(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert(1)</script>
+-- content/p2.md --
+---
+title: p2
+---
+Markdown.
+-- layouts/single.html --
+{{ .Content }}
+-- layouts/home.html --
+Home.
+`
+
+	b, err := TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+
+	b = Test(t, strings.Replace(files, "-- hugo.toml --", "-- hugo.toml --\n[security]\nallowContent = ['.*']", 1))
+	b.AssertFileContent("public/p1/index.html", "<script>alert(1)</script>")
+	b.AssertFileContent("public/p2/index.html", "<p>Markdown.</p>")
+}
+
+func TestSecurityAllowContentHTMLContentAdapter(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/_content.gotmpl --
+{{ $.AddPage (dict "path" "p1" "title" "p1" "content" (dict "mediaType" "text/html" "value" "<script>alert(1)</script>")) }}
+-- layouts/single.html --
+{{ .Content }}
+-- layouts/home.html --
+Home.
+`
+
+	_, err := TestE(t, files)
+	qt.Assert(t, err, qt.IsNotNil)
+	qt.Assert(t, err.Error(), qt.Contains, `security.allowContent`)
+}
+
+func TestSecurityAllowContentHTMLFrontMatterOnly(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/_index.html --
+---
+title: Home
+---
+-- layouts/home.html --
+{{ .Title }}|{{ .Content }}|
+`
+
+	b := Test(t, files)
+	b.AssertFileContent("public/index.html", "Home||")
+}
