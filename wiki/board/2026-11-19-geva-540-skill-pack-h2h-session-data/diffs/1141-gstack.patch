+
+	req := httptest.NewRequest(http.MethodGet,
+		"/exec/namespaces/default/components/victim-svc?env=development",
+		nil).WithContext(testutil.AuthzContext())
+	h.ServeHTTP(httptest.NewRecorder(), req)
+
+	require.Len(t, pdp.Captured, 1)
+	testutil.RequireEvalRequest(t, pdp.Captured[0],
+		authz.ActionExecComponent, "component", "victim-svc",
+		authz.ResourceHierarchy{Namespace: "default", Project: "victim", Component: "victim-svc"})
+}
