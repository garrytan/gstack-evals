+func TestExecHandler_CrossProjectRejected(t *testing.T) {
+	pdp := testutil.AllowPDP()
+	h := newExecHandler(t, pdp, execTestComponent("victim-svc", "victim"))
+
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet,
+		"/exec/namespaces/default/components/victim-svc?env=development&project=attacker",
+		nil).WithContext(testutil.AuthzContext())
+	h.ServeHTTP(rec, req)
+
+	require.Equal(t, http.StatusNotFound, rec.Code)
+	require.Empty(t, pdp.Captured, "authz must not be evaluated against a non-owning project")
+}
