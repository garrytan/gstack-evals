+// isSafeLocalRedirectPath returns true if path is an absolute local path that
+// cannot be interpreted by a browser as a reference to another host.
+func isSafeLocalRedirectPath(path string) bool {
+	if path == "" {
+		return true
+	}
+	if path[0] != '/' {
+		return false
+	}
+	if len(path) > 1 && (path[1] == '/' || path[1] == '\\') {
+		return false
+	}
+	lower := strings.ToLower(path)
+	if strings.HasPrefix(lower, "/%2f") || strings.HasPrefix(lower, "/%5c") {
+		return false
+	}
+	return true
+}
