+// Copyright (c) ClaceIO, LLC
+// SPDX-License-Identifier: Apache-2.0
+package app
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/openrundev/openrun/internal/types"
+)
+
+func TestValidatedRefererRedirect(t *testing.T) {
+	a := &App{serverConfig: &types.ServerConfig{}}
+	r := httptest.NewRequest("POST", "http://127.0.0.1:25222/test/abc", nil)
+
+	tests := []struct {
+		ref    string
+		want   string
+		wantOk bool
+	}{
+		{"http://127.0.0.1:25222/test/abc?x=1", "/test/abc?x=1", true},
+		{"/local/path", "/local/path", true},
+		{"http://127.0.0.1:25222", "/", true},
+		{"http://evil.com/abc", "", false},
+		{"http://127.0.0.1:25222//evil.com", "", false},
+		{"http://127.0.0.1:25222//evil.com/x", "", false},
+		{"http://127.0.0.1:25222/\\evil.com", "", false},
+		{"http://127.0.0.1:25222/%2Fevil.com", "", false},
+		{"//evil.com", "", false},
+		{"/\\evil.com", "", false},
+		{"relative", "", false},
+	}
+	for _, tt := range tests {
+		got, ok := a.validatedRefererRedirect(r, tt.ref)
+		if ok != tt.wantOk || got != tt.want {
+			t.Errorf("ref %q: got (%q, %v), want (%q, %v)", tt.ref, got, ok, tt.want, tt.wantOk)
+		}
+	}
+}
