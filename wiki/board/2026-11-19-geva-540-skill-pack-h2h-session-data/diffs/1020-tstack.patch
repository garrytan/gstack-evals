@@ -0,0 +1,63 @@
+package openapi3filter
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestCircularXOfRequestDecoding(t *testing.T) {
+	for _, tc := range []struct {
+		name, kind, param, query string
+	}{
+		{"allOf simple", "allOf", "schema: {$ref: '#/components/schemas/Recursive'}", "data=x"},
+		{"anyOf simple", "anyOf", "schema: {$ref: '#/components/schemas/Recursive'}", "data=x"},
+		{"oneOf simple", "oneOf", "schema: {$ref: '#/components/schemas/Recursive'}", "data=x"},
+		{"array items", "allOf", "schema: {type: array, items: {$ref: '#/components/schemas/Recursive'}}", "data=x&data=y"},
+		{"deepObject", "anyOf", "style: deepObject\n          explode: true\n          schema: {type: object, properties: {p: {$ref: '#/components/schemas/Recursive'}}}", "data[p]=x"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			spec := `
+openapi: '3.0.0'
+info: {title: circular, version: '1.0'}
+paths:
+  /test:
+    get:
+      parameters:
+        - name: data
+          in: query
+          ` + tc.param + `
+      responses: {'200': {description: OK}}
+components:
+  schemas:
+    Recursive:
+      ` + tc.kind + `:
+        - $ref: '#/components/schemas/Recursive'
+`
+			loader := openapi3.NewLoader()
+			doc, err := loader.LoadFromData([]byte(spec))
+			require.NoError(t, err)
+			require.NoError(t, doc.Validate(loader.Context))
+
+			router, err := gorillamux.NewRouter(doc)
+			require.NoError(t, err)
+			req, err := http.NewRequest(http.MethodGet, "/test?"+tc.query, nil)
+			require.NoError(t, err)
+			route, pathParams, err := router.FindRoute(req)
+			require.NoError(t, err)
+
+			err = ValidateRequest(context.Background(), &RequestValidationInput{
+				Request:    req,
+				PathParams: pathParams,
+				Route:      route,
+			})
+			require.Error(t, err)
+			require.Contains(t, err.Error(), "circular schema reference detected")
+		})
+	}
+}
