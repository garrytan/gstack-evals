+package openapi3
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestVisitJSONCircularXOf(t *testing.T) {
+	for _, kind := range []string{"allOf", "anyOf", "oneOf"} {
+		t.Run(kind, func(t *testing.T) {
+			s := &Schema{
+				Type:       &Types{"object"},
+				Properties: Schemas{"name": {Value: &Schema{Type: &Types{"string"}}}},
+			}
+			refs := SchemaRefs{{Ref: "#/components/schemas/S", Value: s}}
+			switch kind {
+			case "allOf":
+				s.AllOf = refs
+			case "anyOf":
+				s.AnyOf = refs
+			case "oneOf":
+				s.OneOf = refs
+			}
+			require.NoError(t, s.Validate(context.Background()))
+
+			err := s.VisitJSON(map[string]any{"name": "test"})
+			require.Error(t, err)
+			if kind == "allOf" {
+				require.Contains(t, err.Error(), "circular schema reference detected")
+			}
+			err = s.VisitJSON(map[string]any{"name": "test"}, MultiErrors())
+			require.Error(t, err)
+			err = s.VisitJSON(map[string]any{"name": "test"}, FailFast())
+			require.Error(t, err)
+		})
+	}
+}
+
+func TestVisitJSONIndirectCircularXOf(t *testing.T) {
+	a := &Schema{Type: &Types{"object"}}
+	b := &Schema{AllOf: SchemaRefs{{Ref: "#/components/schemas/A", Value: a}}}
+	a.AllOf = SchemaRefs{{Ref: "#/components/schemas/B", Value: b}}
+	require.ErrorIs(t, a.VisitJSON(map[string]any{}), ErrCircularSchema)
+}
+
+// Recursion through properties consumes the value, so it must keep working.
+func TestVisitJSONRecursiveThroughPropertiesWithXOf(t *testing.T) {
+	node := &Schema{Type: &Types{"object"}}
+	wrapper := &Schema{AllOf: SchemaRefs{{Value: node}}}
+	node.Properties = Schemas{"child": {Value: wrapper}}
+	value := map[string]any{"child": map[string]any{"child": map[string]any{}}}
+	require.NoError(t, wrapper.VisitJSON(value))
+	require.NoError(t, wrapper.VisitJSON(value, MultiErrors()))
+}
