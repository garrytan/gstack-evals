+    [Test]
+    public void TestDayLightSavingFallBackWithDailyInterval()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        var startTime = new DateTimeOffset(2020, 10, 25, 0, 1, 5, TimeSpan.FromHours(2));
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .WithIdentity("id")
+            .ForJob("job")
+            .StartAt(startTime)
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithIntervalInHours(24)
+                .StartingDailyAt(new TimeOfDay(0, 1, 5))
+                .EndingDailyAt(new TimeOfDay(23, 59, 59))
+                .InTimeZone(timeZoneInfo)
+                .WithMisfireHandlingInstructionDoNothing())
+            .Build();
+
+        var from = new DateTimeOffset(2020, 10, 25, 0, 0, 0, TimeSpan.FromHours(2));
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, from, from.AddDays(3));
+
+        Assert.That(fireTimes, Is.EqualTo(new[]
+        {
+            new DateTimeOffset(2020, 10, 25, 0, 1, 5, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 10, 26, 0, 1, 5, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 10, 27, 0, 1, 5, TimeSpan.FromHours(1)),
+        }).AsCollection);
+    }
+
+    [Test]
+    public void TestDayLightSavingSpringForwardWithDailyInterval()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        var from = new DateTimeOffset(2020, 3, 28, 0, 0, 0, TimeSpan.FromHours(1));
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .StartAt(from)
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithIntervalInHours(24)
+                .StartingDailyAt(new TimeOfDay(10, 0))
+                .InTimeZone(timeZoneInfo))
+            .Build();
+
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, from, from.AddDays(3));
+
+        Assert.That(fireTimes, Is.EqualTo(new[]
+        {
+            new DateTimeOffset(2020, 3, 28, 10, 0, 0, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 3, 29, 10, 0, 0, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 3, 30, 10, 0, 0, TimeSpan.FromHours(2)),
+        }).AsCollection);
+    }
