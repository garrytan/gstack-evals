+func TestRemoveEmptyPoliciesShadowingWildcards(t *testing.T) {
+	newAPs := func() []*caddytls.AutomationPolicy {
+		return []*caddytls.AutomationPolicy{
+			{SubjectsRaw: []string{"wiki.example.com"}},
+			{SubjectsRaw: []string{"*.example.com"}, ManagersRaw: []json.RawMessage{json.RawMessage(`{"via":"http","url":"http://localhost:9000/certs"}`)}},
+			{SubjectsRaw: []string{"other.test"}},
+		}
+	}
+
+	t.Run("removes empty policy covered by wildcard policy", func(t *testing.T) {
+		got := removeEmptyPoliciesShadowingWildcards(newAPs(), nil)
+		if len(got) != 2 || got[0].SubjectsRaw[0] != "*.example.com" || got[1].SubjectsRaw[0] != "other.test" {
+			t.Fatalf("unexpected policies: %+v", got)
+		}
+	})
+
+	t.Run("keeps policy for force_automate names", func(t *testing.T) {
+		got := removeEmptyPoliciesShadowingWildcards(newAPs(), map[string]struct{}{"wiki.example.com": {}})
+		if len(got) != 3 {
+			t.Fatalf("expected 3 policies, got %d: %+v", len(got), got)
+		}
+	})
+}
