+// removeEmptyPoliciesShadowingWildcards removes automation policies that have
+// no settings other than their subjects, if all of their subjects are covered
+// by a wildcard subject of another, non-empty policy (and none of the subjects
+// are forced to be automated). Such a policy would otherwise be more specific
+// than the wildcard's policy, causing the wildcard policy's settings (e.g. its
+// certificate managers via get_certificate) to not apply to those names, even
+// though they are served by the wildcard's certificate.
+func removeEmptyPoliciesShadowingWildcards(aps []*caddytls.AutomationPolicy, forced map[string]struct{}) []*caddytls.AutomationPolicy {
+	isEmpty := func(ap *caddytls.AutomationPolicy) bool {
+		emptyAP := &caddytls.AutomationPolicy{SubjectsRaw: ap.SubjectsRaw}
+		return reflect.DeepEqual(ap, emptyAP)
+	}
+	coveredByWildcard := func(i int, subj string) bool {
+		for j, other := range aps {
+			if i == j || isEmpty(other) {
+				continue
+			}
+			for _, wild := range other.SubjectsRaw {
+				if strings.Contains(wild, "*") && wild != subj && certmagic.MatchWildcard(subj, wild) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	var remove []int
+	for i, ap := range aps {
+		if len(ap.SubjectsRaw) == 0 || !isEmpty(ap) {
+			continue
+		}
+		allCovered := true
+		for _, subj := range ap.SubjectsRaw {
+			if _, ok := forced[subj]; ok || !coveredByWildcard(i, subj) {
+				allCovered = false
+				break
+			}
+		}
+		if allCovered {
+			remove = append(remove, i)
+		}
+	}
+	for k := len(remove) - 1; k >= 0; k-- {
+		aps = slices.Delete(aps, remove[k], remove[k]+1)
+	}
+	return aps
+}
