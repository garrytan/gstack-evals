diff --git a/Tests/UnitTestsParallelizable/ViewBase/Draw/SubViewOnlyRedrawTests.cs b/Tests/UnitTestsParallelizable/ViewBase/Draw/SubViewOnlyRedrawTests.cs
new file mode 100644
index 0000000..269e9d2
--- /dev/null
+++ b/Tests/UnitTestsParallelizable/ViewBase/Draw/SubViewOnlyRedrawTests.cs
@@ -0,0 +1,233 @@
+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     A SuperView entered via <c>SubViewNeedsDraw</c> must not clear/redraw its own Viewport, Text, or Content,
+///     and the resulting screen must be identical to a full redraw.
+/// </summary>
+public class SubViewOnlyRedrawTests : TestDriverBase
+{
+    private sealed class Counts
+    {
+        public int Cleared;
+        public int Text;
+        public int Content;
+
+        public void Track (View v)
+        {
+            v.ClearedViewport += (_, _) => Cleared++;
+            v.DrawingText += (_, _) => Text++;
+            v.DrawingContent += (_, _) => Content++;
+        }
+
+        public void Reset () => Cleared = Text = Content = 0;
+    }
+
+    // Grapheme + attribute snapshot of what the IOutput will be asked to render.
+    private static string Snapshot (IDriver driver)
+    {
+        StringBuilder sb = new ();
+        Cell [,] contents = driver.Contents!;
+
+        for (var r = 0; r < contents.GetLength (0); r++)
+        {
+            for (var c = 0; c < contents.GetLength (1); c++)
+            {
+                sb.Append (contents [r, c].Grapheme).Append ('|').Append (contents [r, c].Attribute).Append (';');
+            }
+
+            sb.Append ('\n');
+        }
+
+        return sb.ToString ();
+    }
+
+    // Mirrors the main loop: each iteration starts with a full-screen clip.
+    private static void Draw (View root, IDriver driver)
+    {
+        driver.Clip = new Region (driver.Screen);
+        root.Draw ();
+    }
+
+    private static void AssertMatchesFullRedraw (View root, IDriver driver)
+    {
+        string partial = Snapshot (driver);
+        driver.ClearContents ();
+        root.SetNeedsDraw ();
+        Draw (root, driver);
+        Assert.Equal (Snapshot (driver), partial);
+    }
+
+    private static View CreateRoot (IDriver driver) =>
+        new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single, Text = "root text" };
+
+    [Fact]
+    public void ChildOnly_Dirty_Parent_DoesNotClear_Or_Redraw_Text_Or_Content ()
+    {
+        IDriver driver = CreateTestDriver (30, 10);
+        View root = CreateRoot (driver);
+        View child = new () { X = 2, Y = 2, Width = 10, Height = 3, Text = "child", BorderStyle = LineStyle.Single };
+        View sibling = new () { X = 14, Y = 2, Width = 8, Height = 3, Text = "sib" };
+        root.Add (child, sibling);
+        root.Layout ();
+        Draw (root, driver);
+
+        Counts rootCounts = new ();
+        Counts childCounts = new ();
+        Counts siblingCounts = new ();
+        rootCounts.Track (root);
+        childCounts.Track (child);
+        siblingCounts.Track (sibling);
+
+        child.Text = "changed";
+        root.Layout ();
+        Draw (root, driver);
+
+        Assert.Equal (0, rootCounts.Cleared);
+        Assert.Equal (0, rootCounts.Text);
+        Assert.Equal (0, rootCounts.Content);
+        Assert.Equal (1, childCounts.Text);
+        Assert.Equal (0, siblingCounts.Content);
+        Assert.False (root.NeedsDraw);
+        Assert.False (root.SubViewNeedsDraw);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        // When the parent itself is dirty it still redraws fully.
+        rootCounts.Reset ();
+        root.SetNeedsDraw ();
+        Draw (root, driver);
+        Assert.Equal (1, rootCounts.Cleared);
+        Assert.Equal (1, rootCounts.Text);
+    }
+
+    [Fact]
+    public void ChildOnly_Dirty_Partially_Clipped_Child_Renders_Correctly ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+        View root = CreateRoot (driver);
+        View child = new () { X = 12, Y = 3, Width = 15, Height = 6, Text = "clipped child", BorderStyle = LineStyle.Double };
+        root.Add (child);
+        root.Layout ();
+        Draw (root, driver);
+
+        child.Text = "other text";
+        root.Layout ();
+        Draw (root, driver);
+
+        AssertMatchesFullRedraw (root, driver);
+    }
+
+    [Fact]
+    public void Tabs_ActiveTabScroll_DoesNot_Redraw_InactiveTabs ()
+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill () };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [3];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            int captured = i;
+            pages [i] = new View { Title = $"Tab{i + 1}", CanFocus = true };
+            pages [i].SetContentSize (new Size (20, 100));
+
+            pages [i].DrawingContent += (s, e) =>
+                                        {
+                                            View v = (View)s!;
+
+                                            for (var y = 0; y < v.Viewport.Height; y++)
+                                            {
+                                                v.Move (0, y);
+                                                v.AddStr ($"T{captured} line {v.Viewport.Y + y}");
+                                            }
+                                        };
+            tabs.Add (pages [i]);
+        }
+
+        root.Layout ();
+        Draw (root, driver);
+
+        View active = tabs.Value!;
+        Counts tabsCounts = new ();
+        tabsCounts.Track (tabs);
+        Counts [] pageCounts = pages.Select (p =>
+                                             {
+                                                 Counts c = new ();
+                                                 c.Track (p);
+
+                                                 return c;
+                                             })
+                                    .ToArray ();
+
+        for (var y = 1; y <= 3; y++)
+        {
+            active.Viewport = active.Viewport with { Y = y };
+            root.Layout ();
+            Draw (root, driver);
+        }
+
+        Assert.Equal (0, tabsCounts.Cleared);
+        Assert.Equal (3, pageCounts [Array.IndexOf (pages, active)].Content);
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            if (pages [i] != active)
+            {
+                Assert.Equal (0, pageCounts [i].Cleared);
+                Assert.Equal (0, pageCounts [i].Content);
+            }
+        }
+
+        // Tab headers/junctions (composited overlapped LineCanvases) must be unchanged.
+        AssertMatchesFullRedraw (root, driver);
+    }
+
+    [Fact]
+    public void Transparent_Dirty_Child_Forces_Parent_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (30, 10);
+        View root = CreateRoot (driver);
+        View child = new () { X = 2, Y = 2, Width = 10, Height = 3, Text = "child" };
+        child.ViewportSettings |= ViewportSettingsFlags.Transparent;
+        root.Add (child);
+        root.Layout ();
+        Draw (root, driver);
+
+        Counts rootCounts = new ();
+        rootCounts.Track (root);
+
+        child.Text = "x";
+        root.Layout ();
+        Draw (root, driver);
+
+        Assert.Equal (1, rootCounts.Cleared);
+        AssertMatchesFullRedraw (root, driver);
+    }
+
+    [Fact]
+    public void Transparent_Shadow_Sibling_Forces_Parent_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (30, 10);
+        View root = CreateRoot (driver);
+        View child = new () { X = 2, Y = 2, Width = 10, Height = 3, Text = "child" };
+        View shadowed = new () { X = 6, Y = 1, Width = 8, Height = 3, Text = "shadow", ShadowStyle = ShadowStyles.Transparent };
+        root.Add (child, shadowed);
+        root.Layout ();
+        Draw (root, driver);
+
+        Counts rootCounts = new ();
+        rootCounts.Track (root);
+
+        child.Text = "x";
+        root.Layout ();
+        Draw (root, driver);
+
+        Assert.Equal (1, rootCounts.Cleared);
+        AssertMatchesFullRedraw (root, driver);
+    }
+}
