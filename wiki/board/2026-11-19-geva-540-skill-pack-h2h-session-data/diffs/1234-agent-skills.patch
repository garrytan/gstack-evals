+	// Same-origin referers whose path would be treated as protocol-relative
+	// (or backslash-normalized) by browsers must not produce an open redirect.
+	for _, ref := range []string{
+		"http://example.com//evil.com",
+		"http://example.com//evil.com/test/abc",
+		"http://example.com/%2Fevil.com",
+		"http://example.com/\\evil.com",
+		"http://example.com/%5Cevil.com",
+		"http://example.com/%5C%5Cevil.com",
+		"http://example.com/%09/evil.com",
