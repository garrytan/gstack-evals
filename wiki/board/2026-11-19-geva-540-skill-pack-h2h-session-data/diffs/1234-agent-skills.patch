+// isSafeLocalRedirectPath reports whether path can be used as a same-origin
+// redirect target. Browsers treat "//host" and "/\host" as protocol-relative
+// URLs (and strip tabs/newlines, normalize backslashes), so such paths would
+// allow an open redirect to an external host.
+func isSafeLocalRedirectPath(path string) bool {
+	if path == "" {
+		return true
+	}
+	if !strings.HasPrefix(path, "/") {
+		return false
+	}
+	if strings.HasPrefix(path, "//") || strings.HasPrefix(path, "/\\") {
+		return false
+	}
+	for _, c := range path {
+		if c == '\\' || c < 0x20 || c == 0x7f {
+			return false
+		}
+	}
+	return true
+}
