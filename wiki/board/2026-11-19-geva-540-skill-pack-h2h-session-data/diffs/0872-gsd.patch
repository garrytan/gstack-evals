+// tableUnmarshaler returns the unstable.Unmarshaler implemented by v (or the
+// value it points to), if the unmarshaler interface is enabled.
+func (d *decoder) tableUnmarshaler(v reflect.Value) (unstable.Unmarshaler, bool) {
+	if !d.unmarshalerInterface {
+		return nil, false
+	}
+	for v.Kind() == reflect.Ptr {
+		if v.IsNil() && !v.CanSet() {
+			return nil, false
+		}
+		v = initAndDereferencePointer(v)
+	}
+	if !v.CanAddr() || !v.Addr().CanInterface() {
+		return nil, false
+	}
+	u, ok := v.Addr().Interface().(unstable.Unmarshaler)
+	return u, ok
+}
+
+// handleKeyValuesUnmarshaler collects all the key-value expressions until the
+// end of the document or the next table, and passes them to the Unmarshaler as
+// a single InlineTable node.
+func (d *decoder) handleKeyValuesUnmarshaler(u unstable.Unmarshaler) error {
+	var kvs []*unstable.Node
+	for d.nextExpr() {
+		expr := d.expr()
+		if expr.Kind != unstable.KeyValue {
+			d.stashExpr()
+			break
+		}
+
+		_, err := d.seen.CheckExpression(expr)
+		if err != nil {
+			return err
+		}
+
+		// The parser reuses its nodes on every expression; keep a copy.
+		kvs = append(kvs, unstable.NewInlineTable([]*unstable.Node{expr}).Child())
+	}
+
+	if err := d.p.Error(); err != nil {
+		return err
+	}
+
+	return u.UnmarshalTOML(unstable.NewInlineTable(kvs))
+}
