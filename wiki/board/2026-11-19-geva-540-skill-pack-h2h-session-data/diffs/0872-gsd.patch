+func TestUnmarshal_CustomUnmarshalerTables(t *testing.T) {
+	t.Run("root is called (issue)", func(t *testing.T) {
+		var d panicUnmarshaler
+		assert.Panics(t, func() {
+			_ = toml.NewDecoder(strings.NewReader(`foo = "bar"`)).
+				EnableUnmarshalerInterface().
+				Decode(&d)
+		})
+	})
+
+	t.Run("root keeps order", func(t *testing.T) {
+		var d orderedKV
+		err := toml.NewDecoder(strings.NewReader("z = 1\na.b = 'x'\nm = 3\n")).
+			EnableUnmarshalerInterface().Decode(&d)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"z", "a.b", "m"}, d.Keys)
+		assert.Equal(t, []string{"1", "x", "3"}, d.Values)
+	})
+
+	t.Run("root not called when disabled", func(t *testing.T) {
+		var d panicUnmarshaler
+		err := toml.NewDecoder(strings.NewReader(`foo = "bar"`)).Decode(&d)
+		assert.NoError(t, err)
+	})
+
+	t.Run("tables, pointers, maps and array tables", func(t *testing.T) {
+		type cfg struct {
+			Name   string
+			Table  orderedKV
+			Ptr    *orderedKV
+			Inline orderedKV
+			Map    map[string]orderedKV
+			Arr    []orderedKV
+		}
+		doc := `
+name = "n"
+inline = { b = 2, a = 1 }
+
+[table]
+y = 1
+x = 2
+
+[ptr]
+q = 'p'
+
+[map.one]
+k = 'v'
+
+[[arr]]
+c = 1
+[[arr]]
+d = 2
+e = 3
+`
+		var c cfg
+		err := toml.NewDecoder(strings.NewReader(doc)).EnableUnmarshalerInterface().Decode(&c)
+		assert.NoError(t, err)
+		assert.Equal(t, "n", c.Name)
+		assert.Equal(t, []string{"b", "a"}, c.Inline.Keys)
+		assert.Equal(t, []string{"y", "x"}, c.Table.Keys)
+		assert.Equal(t, []string{"1", "2"}, c.Table.Values)
+		assert.Equal(t, []string{"q"}, c.Ptr.Keys)
+		assert.Equal(t, []string{"k"}, c.Map["one"].Keys)
+		assert.Equal(t, 2, len(c.Arr))
+		assert.Equal(t, []string{"c"}, c.Arr[0].Keys)
+		assert.Equal(t, []string{"d", "e"}, c.Arr[1].Keys)
+	})
+
+	t.Run("error is returned", func(t *testing.T) {
+		type cfg struct{ T errUnmarshaler }
+		err := toml.NewDecoder(strings.NewReader("[t]\na = 1\n")).EnableUnmarshalerInterface().Decode(&cfg{})
+		assert.Error(t, err)
+	})
+
+	t.Run("duplicate keys still detected", func(t *testing.T) {
+		var d orderedKV
+		err := toml.NewDecoder(strings.NewReader("a = 1\na = 2\n")).EnableUnmarshalerInterface().Decode(&d)
+		assert.Error(t, err)
+	})
+}
