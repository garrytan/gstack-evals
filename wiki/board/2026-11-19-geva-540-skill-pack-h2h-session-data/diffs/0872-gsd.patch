+
+// orderedKV records the key-values it is decoded from, in document order.
+type orderedKV struct {
+	Keys   []string
+	Values []string
+}
+
+func (o *orderedKV) UnmarshalTOML(node *unstable.Node) error {
+	if node.Kind != unstable.InlineTable {
+		return fmt.Errorf("expected inline table, got %s", node.Kind)
+	}
+	it := node.Children()
+	for it.Next() {
+		kv := it.Node()
+		if kv.Kind != unstable.KeyValue {
+			return fmt.Errorf("expected key-value, got %s", kv.Kind)
+		}
+		var parts []string
+		k := kv.Key()
+		for k.Next() {
+			parts = append(parts, string(k.Node().Data))
+		}
+		o.Keys = append(o.Keys, strings.Join(parts, "."))
+		o.Values = append(o.Values, string(kv.Value().Data))
+	}
+	return nil
+}
