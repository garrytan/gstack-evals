@@ -5,3 +5,52 @@ package unstable
 type Unmarshaler interface {
 	UnmarshalTOML(value *Node) error
 }
+
+// NewInlineTable returns a new node of kind InlineTable whose children are
+// deep copies of the provided KeyValue nodes, in order.
+//
+// The nodes returned by the Parser are only valid until the next call to
+// NextExpression. This function allows to retain a set of expressions (for
+// example all the key-values of a table) beyond that point, by copying them
+// into a new, independent tree. Data slices are shared with the source nodes.
+//
+// *Unstable:* This function does not follow the compatibility guarantees of
+// semver. It can be changed or removed without a new major version being
+// issued.
+func NewInlineTable(keyValues []*Node) *Node {
+	c := nodeCopier{nodes: make([]Node, 1, 1+len(keyValues)*4)}
+	c.nodes[0] = Node{Kind: InlineTable}
+	prev := -1
+	for _, kv := range keyValues {
+		idx := c.copy(kv)
+		if prev < 0 {
+			c.nodes[0].child = idx
+		} else {
+			c.nodes[prev].next = idx - prev
+		}
+		prev = idx
+	}
+	return &c.nodes[0]
+}
+
+type nodeCopier struct {
+	nodes []Node
+}
+
+// copy appends a deep copy of n (and its children, but not its siblings) to
+// the backing array and returns its index.
+func (c *nodeCopier) copy(n *Node) int {
+	idx := len(c.nodes)
+	c.nodes = append(c.nodes, Node{Kind: n.Kind, Raw: n.Raw, Data: n.Data})
+	prev := -1
+	for child := n.Child(); child != nil; child = child.Next() {
+		ci := c.copy(child)
+		if prev < 0 {
+			c.nodes[idx].child = ci - idx
+		} else {
+			c.nodes[prev].next = ci - prev
+		}
+		prev = ci
+	}
+	return idx
+}
