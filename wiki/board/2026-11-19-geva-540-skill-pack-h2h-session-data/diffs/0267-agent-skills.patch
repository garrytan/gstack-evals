--- a/internal/tools/semconvkit/templates/error_type_test.go.tmpl
+++ b/internal/tools/semconvkit/templates/error_type_test.go.tmpl
@@ -5,6 +5,7 @@ package semconv // import "go.opentelemetry.io/otel/semconv/{{.TagVer}}"
 
 import (
 	"errors"
+	"fmt"
 	"testing"
 )
 
@@ -18,6 +19,15 @@ func TestErrorType(t *testing.T) {
 	check(t, custom(""), pkg+".ErrCustomType")                     // empty ErrorType, use concrete type.
 	check(t, wrapped(custom("wrapped-aborted")), "wrapped-aborted")
 	check(t, wrapped(custom("")), pkg+".wrappedErr") // empty ErrorType in chain, use concrete top-level type.
+
+	// fmt.Errorf wrappers are skipped in favor of the wrapped error type.
+	check(t, fmt.Errorf("ctx: %w", errors.New("msg")), "*errors.errorString")
+	check(t, fmt.Errorf("a: %w", fmt.Errorf("b: %w", wrapped(errors.New("msg")))), pkg+".wrappedErr")
+	check(t, fmt.Errorf("ctx: %w", custom("")), pkg+".ErrCustomType")
+	check(t, fmt.Errorf("ctx: %w", custom("aborted")), "aborted")
+	check(t, fmt.Errorf("%w and %w", errors.New("a"), wrapped(errors.New("b"))), "*errors.errorString") // first wrapped error.
+	check(t, fmt.Errorf("no wrap: %v", errors.New("msg")), "*errors.errorString")
+	check(t, fmt.Errorf("%w", nil), "*fmt.wrapError") // wrapper with no wrapped error, keep wrapper type.
 }
 
