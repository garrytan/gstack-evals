+				for _, e := range u.Unwrap() {
+					if e != nil {
+						next = e
+						break
+					}
+				}
+			}
+		default:
+			return err
+		}
+		if next == nil {
+			// Wrapper without a wrapped error; report the wrapper itself.
+			return err
+		}
+		err = next
+	}
+	return err
+}
diff --git a/internal/tools/semconvkit/templates/error_type_test.go.tmpl b/internal/tools/semconvkit/templates/error_type_test.go.tmpl
