+
+        [Test]
+        public void TestCreateCellAppliesDefaultColumnStyle()
+        {
+            IWorkbook wb1 = _testDataProvider.CreateWorkbook();
+            ISheet sheet = wb1.CreateSheet("test");
+
+            ICellStyle style = wb1.CreateCellStyle();
+            style.DataFormat = 4;
+            sheet.SetDefaultColumnStyle(1, style);
+
+            IRow row = sheet.CreateRow(0);
+            ICell styledCell = row.CreateCell(1);
+            styledCell.SetCellValue(1.5);
+            ICell plainCell = row.CreateCell(2);
+            plainCell.SetCellValue(2.5);
+
+            ClassicAssert.AreEqual(style.Index, styledCell.CellStyle.Index);
+            ClassicAssert.AreEqual(4, styledCell.CellStyle.DataFormat);
+            ClassicAssert.AreNotEqual(style.Index, plainCell.CellStyle.Index);
+
+            IWorkbook wb2 = _testDataProvider.WriteOutAndReadBack(wb1);
+            sheet = wb2.GetSheetAt(0);
+            row = sheet.GetRow(0);
+            ClassicAssert.AreEqual(4, row.GetCell(1).CellStyle.DataFormat);
+            ClassicAssert.AreNotEqual(4, row.GetCell(2).CellStyle.DataFormat);
+
+            wb2.Close();
+            wb1.Close();
+        }
     }
 
