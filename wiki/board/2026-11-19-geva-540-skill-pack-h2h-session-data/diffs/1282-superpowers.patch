+// sameLogDifferentIndexEntity returns the original entry plus a second entry,
+// validly signed by the same log, but at a different log index. This simulates
+// a single compromised log forging multiple entries.
+type sameLogDifferentIndexEntity struct {
+	*ca.TestEntity
+	virtualSigstore *ca.VirtualSigstore
+}
+
+func (e *sameLogDifferentIndexEntity) TlogEntries() ([]*tlog.Entry, error) {
+	entries, err := e.TestEntity.TlogEntries()
+	if err != nil {
+		return nil, err
+	}
+	orig := entries[0]
+	tle := orig.TransparencyLogEntry()
+	body := tle.GetCanonicalizedBody()
+	logIndex := orig.LogIndex() + 1
+	set, err := e.virtualSigstore.RekorSignPayload(tlog.RekorPayload{
+		Body:           base64.StdEncoding.EncodeToString(body),
+		IntegratedTime: orig.IntegratedTime().Unix(),
+		LogIndex:       logIndex,
+		LogID:          hex.EncodeToString([]byte(orig.LogKeyID())),
+	})
+	if err != nil {
+		return nil, err
+	}
+	forged, err := tlog.NewEntry(body, orig.IntegratedTime().Unix(), logIndex, []byte(orig.LogKeyID()), set, nil) //nolint:staticcheck
+	if err != nil {
+		return nil, err
+	}
+	return append(entries, forged), nil
+}
+
+func TestMultipleTlogEntriesFromSameLog(t *testing.T) {
+	virtualSigstore, err := ca.NewVirtualSigstore()
+	assert.NoError(t, err)
+
+	statement := []byte(`{"_type":"https://in-toto.io/Statement/v0.1","predicateType":"customFoo","subject":[{"name":"subject","digest":{"sha256":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}}],"predicate":{}}`)
+	entity, err := virtualSigstore.Attest("foo@example.com", "issuer", statement)
+	assert.NoError(t, err)
+
+	e := &sameLogDifferentIndexEntity{entity, virtualSigstore}
+	// threshold of 1 is met
+	_, err = verify.VerifyTlogEntry(e, virtualSigstore, 1, true)
+	assert.NoError(t, err)
+	// threshold of 2 must not be met by two entries from the same log
+	_, err = verify.VerifyTlogEntry(e, virtualSigstore, 2, true)
+	assert.ErrorContains(t, err, "not enough verified log entries")
+}
