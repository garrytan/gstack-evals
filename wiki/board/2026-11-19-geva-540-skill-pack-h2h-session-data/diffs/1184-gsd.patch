diff --git a/packages/mcp-tools/src/tools/jobs/space-to-space-migration/sanitizeOptions.ts b/packages/mcp-tools/src/tools/jobs/space-to-space-migration/sanitizeOptions.ts
new file mode 100644
index 0000000..68c00e6
--- /dev/null
+++ b/packages/mcp-tools/src/tools/jobs/space-to-space-migration/sanitizeOptions.ts
@@ -0,0 +1,35 @@
+/**
+ * Options that control where requests (and therefore the server's management
+ * token) are sent, or that allow loading arbitrary options from disk. These
+ * must never be taken from tool-call arguments, since those are controlled by
+ * the LLM and may be influenced by prompt injection.
+ */
+export const RESTRICTED_MIGRATION_OPTIONS = [
+  'host',
+  'hostDelivery',
+  'port',
+  'insecure',
+  'proxy',
+  'rawProxy',
+  'httpAgent',
+  'httpsAgent',
+  'basePath',
+  'baseURL',
+  'adapter',
+  'config',
+  'managementToken',
+  'accessToken',
+] as const;
+
+/**
+ * Returns a shallow copy of the given args with all restricted options removed.
+ */
+export function stripRestrictedOptions<T extends Record<string, unknown>>(
+  args: T,
+): Omit<T, (typeof RESTRICTED_MIGRATION_OPTIONS)[number]> {
+  const sanitized: Record<string, unknown> = { ...args };
+  for (const key of RESTRICTED_MIGRATION_OPTIONS) {
+    delete sanitized[key];
+  }
+  return sanitized as Omit<T, (typeof RESTRICTED_MIGRATION_OPTIONS)[number]>;
+}
