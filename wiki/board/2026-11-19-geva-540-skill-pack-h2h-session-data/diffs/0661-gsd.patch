+package machinery
+
+import (
+	"strconv"
+	"strings"
+	"time"
+)
+
+// YearPlaceholder is the placeholder that can be used in boilerplate files (e.g. hack/boilerplate.go.txt)
+// and that is replaced by the current year when the boilerplate is used to scaffold files.
+// This matches the behavior of gengo and controller-gen.
+const YearPlaceholder = "YEAR"
+
+// ReplaceYearPlaceholder replaces every occurrence of YearPlaceholder in the given boilerplate
+// with the current year.
+func ReplaceYearPlaceholder(boilerplate string) string {
+	return strings.ReplaceAll(boilerplate, YearPlaceholder, strconv.Itoa(time.Now().Year()))
+}
