new file mode 100644
index 0000000..a2f8fd9
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,84 @@
+import { existsSync, realpathSync } from 'fs';
+import { dirname, isAbsolute, posix, relative, resolve, win32 } from 'path';
+
+// Confinement helpers for caller-supplied filesystem paths. MCP tool arguments
+// are untrusted (a malicious client, or an agent steered by prompt injection),
+// so any path they name must stay inside one of our data roots.
+
+function isWithin(root: string, target: string): boolean {
+  const rel = relative(root, target);
+  return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));
+}
+
+/** Resolve symlinks on the longest existing prefix of `p`. */
+function realpathExisting(p: string): string {
+  let cur = p;
+  const tail: string[] = [];
+  while (!existsSync(cur)) {
+    const parent = dirname(cur);
+    if (parent === cur) return p;
+    tail.unshift(cur.slice(parent.length).replace(/^[\\/]+/, ''));
+    cur = parent;
+  }
+  let real: string;
+  try {
+    real = realpathSync(cur);
+  } catch {
+    return p;
+  }
+  return tail.length ? resolve(real, ...tail) : real;
+}
+
+/**
+ * Resolve a caller-supplied relative path under `root`. Absolute paths (POSIX
+ * or Windows style), `..` escapes and symlink escapes are rejected.
+ */
+export function confinePath(root: string, userPath: string, label = 'path'): string {
+  if (typeof userPath !== 'string' || userPath.trim() === '') {
+    throw new Error(`Invalid ${label}: must be a non-empty relative path`);
+  }
+  if (userPath.includes('\0')) {
+    throw new Error(`Invalid ${label}: contains a NUL byte`);
+  }
+  if (
+    isAbsolute(userPath) ||
+    posix.isAbsolute(userPath) ||
+    win32.isAbsolute(userPath) ||
+    /^[A-Za-z]:/.test(userPath) ||
+    userPath.startsWith('~')
+  ) {
+    throw new Error(
+      `Invalid ${label} ${JSON.stringify(userPath)}: absolute paths are not allowed; pass a path relative to ${root}`,
+    );
+  }
+  const segments = userPath.split(/[\\/]+/);
+  if (segments.includes('..')) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(userPath)}: ".." is not allowed`);
+  }
+  const absRoot = resolve(root);
+  const target = resolve(absRoot, ...segments.filter((s) => s !== '' && s !== '.'));
+  if (!isWithin(absRoot, target)) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(userPath)}: escapes ${absRoot}`);
+  }
+  // Symlink check: the real location must also remain under the real root.
+  const realRoot = realpathExisting(absRoot);
+  const realTarget = realpathExisting(target);
+  if (!isWithin(realRoot, realTarget)) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(userPath)}: resolves outside ${absRoot}`);
+  }
+  return target;
+}
+
+/** Reduce an untrusted filename (e.g. Content-Disposition) to a safe basename. */
+export function safeBasename(name: string | undefined | null, fallback = 'download.bin'): string {
+  let base = String(name ?? '')
+    .split(/[\\/]+/)
+    .pop()!
+    // eslint-disable-next-line no-control-regex
+    .replace(/[\x00-\x1f\x7f]/g, '')
+    .replace(/^[A-Za-z]:/, '')
+    .trim();
+  if (base === '' || base === '.' || base === '..' || /^\.+$/.test(base)) base = fallback;
+  if (base.length > 200) base = base.slice(-200);
+  return base;
+}
