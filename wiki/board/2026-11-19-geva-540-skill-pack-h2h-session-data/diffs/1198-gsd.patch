diff --git a/test/paths.test.ts b/test/paths.test.ts
new file mode 100644
index 0000000..927a674
--- /dev/null
+++ b/test/paths.test.ts
@@ -0,0 +1,59 @@
+import { describe, it, expect } from 'vitest';
+import { mkdtempSync, mkdirSync, symlinkSync } from 'fs';
+import { tmpdir } from 'os';
+import { join } from 'path';
+import { confinePath, safeBasename } from '../src/paths.js';
+import { resolveDownloadDir, DOWNLOAD_ROOT } from '../src/download.js';
+
+describe('confinePath', () => {
+  const root = mkdtempSync(join(tmpdir(), 'bmcp-root-'));
+
+  it('resolves relative paths under the root', () => {
+    expect(confinePath(root, 'a/b')).toBe(join(root, 'a', 'b'));
+    expect(confinePath(root, './a')).toBe(join(root, 'a'));
+  });
+
+  it('rejects absolute paths, home shortcuts and traversal', () => {
+    for (const p of [
+      '/etc/cron.d/x',
+      '\\\\server\\share',
+      'C:\\x',
+      '~/.bashrc',
+      '..',
+      'a/../../x',
+      'a\\..\\..\\x',
+    ]) {
+      expect(() => confinePath(root, p), p).toThrow();
+    }
+    expect(() => confinePath(root, '')).toThrow();
+    expect(() => confinePath(root, 'a\0b')).toThrow();
+  });
+
+  it('rejects symlink escapes', () => {
+    const outside = mkdtempSync(join(tmpdir(), 'bmcp-out-'));
+    mkdirSync(join(root, 'real'), { recursive: true });
+    symlinkSync(outside, join(root, 'link'));
+    expect(() => confinePath(root, 'link/evil')).toThrow(/outside/);
+    expect(confinePath(root, 'real/ok')).toBe(join(root, 'real', 'ok'));
+  });
+});
+
+describe('safeBasename', () => {
+  it('strips directories and dangerous names', () => {
+    expect(safeBasename('../../.bashrc')).toBe('.bashrc');
+    expect(safeBasename('/etc/passwd')).toBe('passwd');
+    expect(safeBasename('..\\..\\evil.exe')).toBe('evil.exe');
+    expect(safeBasename('..')).toBe('download.bin');
+    expect(safeBasename('')).toBe('download.bin');
+    expect(safeBasename('report.pdf')).toBe('report.pdf');
+  });
+});
+
+describe('resolveDownloadDir', () => {
+  it('defaults to the download root and confines save_dir', () => {
+    expect(resolveDownloadDir()).toBe(DOWNLOAD_ROOT);
+    expect(resolveDownloadDir('sub')).toBe(join(DOWNLOAD_ROOT, 'sub'));
+    expect(() => resolveDownloadDir('/home/user')).toThrow();
+    expect(() => resolveDownloadDir('../../')).toThrow();
+  });
+});
