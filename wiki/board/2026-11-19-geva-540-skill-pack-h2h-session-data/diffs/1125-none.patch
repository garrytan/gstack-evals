 // copyForwardedHeader copies header that are removed by the reverseProxy when a rewriteRequest is used.
+// stripTrailerValues returns a new trailer containing only the declared trailer names, without any value.
+func stripTrailerValues(trailer http.Header) http.Header {
+	if len(trailer) == 0 {
+		return nil
+	}
+
+	names := make(http.Header, len(trailer))
+	for name := range trailer {
+		names[name] = nil
+	}
+
+	return names
+}
