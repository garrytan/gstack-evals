+
+type statsEmittingClient struct {
+	*MockedClient
+}
+
+func (c *statsEmittingClient) ContainerStats(ctx context.Context, id string, stats chan<- container.ContainerStat) error {
+	select {
+	case stats <- container.ContainerStat{ID: id, CPUPercent: 42}:
+	case <-ctx.Done():
+	}
+	<-ctx.Done()
+	return ctx.Err()
+}
+
+func Test_handler_streamEvents_respects_label_filter(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	req, err := http.NewRequestWithContext(ctx, "GET", "/api/events/stream", nil)
+	require.NoError(t, err)
+
+	visible := container.Container{ID: "visible00001", Name: "visible", Host: "localhost", State: "running", Labels: map[string]string{"visible": "yes"}, Stats: utils.NewRingBuffer[container.ContainerStat](300)}
+	secret := container.Container{ID: "secret000001", Name: "secret", Host: "localhost", State: "running", Labels: map[string]string{"secretproject": "acme-payroll"}, Stats: utils.NewRingBuffer[container.ContainerStat](300)}
+
+	mockedClient := &statsEmittingClient{new(MockedClient)}
+	mockedClient.On("ListContainers", mock.Anything, mock.MatchedBy(func(l container.ContainerLabels) bool { return l.Exists() })).Return([]container.Container{visible}, nil)
+	mockedClient.On("ListContainers", mock.Anything, mock.MatchedBy(func(l container.ContainerLabels) bool { return !l.Exists() })).Return([]container.Container{visible, secret}, nil)
+	mockedClient.On("FindContainer", mock.Anything, visible.ID).Return(visible, nil)
+	mockedClient.On("FindContainer", mock.Anything, secret.ID).Return(secret, nil)
+	mockedClient.On("Host").Return(container.Host{ID: "localhost"})
+	mockedClient.On("ContainerEvents", mock.Anything, mock.AnythingOfType("chan<- container.ContainerEvent")).Return(nil).Run(func(args mock.Arguments) {
+		messages := args.Get(1).(chan<- container.ContainerEvent)
+		time.Sleep(100 * time.Millisecond)
+		for _, e := range []container.ContainerEvent{
+			{Name: "start", ActorID: secret.ID, Host: "localhost", ActorAttributes: secret.Labels},
+			{Name: "die", ActorID: secret.ID, Host: "localhost"},
+			{Name: "health_status: healthy", ActorID: secret.ID, Host: "localhost"},
+			{Name: "update", ActorID: secret.ID, Host: "localhost", Container: &secret},
+			{Name: "die", ActorID: visible.ID, Host: "localhost"},
+		} {
+			select {
+			case messages <- e:
+			case <-ctx.Done():
+				return
+			}
+		}
+		time.Sleep(100 * time.Millisecond)
+		cancel()
+	})
+
+	manager := docker_support.NewRetriableClientManager(nil, 3*time.Second, tls.Certificate{}, docker_support.NewDockerClientService(mockedClient, container.ContainerLabels{}))
+	multiHostService := docker_support.NewMultiHostService(manager, 3*time.Second)
+	server := CreateServer(multiHostService, nil, Config{
+		Base:          "/",
+		Authorization: Authorization{Provider: NONE},
+		Labels:        container.ContainerLabels{"visible": {"yes"}},
+	})
+
+	rr := httptest.NewRecorder()
+	server.Handler.ServeHTTP(rr, req)
+	body := rr.Body.String()
+
+	require.Contains(t, body, `"id":"visible00001","cpu":42`, "stats for visible container are streamed")
+	require.Contains(t, body, `"name":"die","host":"localhost","actorId":"visible00001"`, "events for visible container are streamed")
+	require.False(t, strings.Contains(body, secret.ID), "nothing about the filtered-out container is streamed:\n%s", body)
+	require.NotContains(t, body, "acme-payroll")
+}
