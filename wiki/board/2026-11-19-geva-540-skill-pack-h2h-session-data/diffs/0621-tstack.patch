diff --git a/Terminal.Gui/Views/Selectors/SelectorBase.cs b/Terminal.Gui/Views/Selectors/SelectorBase.cs
index f1f7ed1..c675814 100644
--- a/Terminal.Gui/Views/Selectors/SelectorBase.cs
+++ b/Terminal.Gui/Views/Selectors/SelectorBase.cs
@@ -529,6 +529,19 @@ public abstract class SelectorBase : View, IOrientation, IValue<int?>
                 SubViews.ElementAt (i).Width = Dim.Auto ();
             }
         }
+
+        if (Orientation == Orientation.Horizontal)
+        {
+            // DimAuto sizes Pos.Align'd SubViews using their current Frames. Ensure those Frames reflect
+            // the new SubViews (and their Margins) so our Dim.Auto width is correct, even when Labels/Values
+            // are set after the first layout pass.
+            foreach (View subView in SubViews)
+            {
+                subView.SetRelativeLayout (App?.Screen.Size ?? new Size (2048, 2048));
+            }
+        }
+
+        SetNeedsLayout ();
     }
 
