+			delete(m.failedItemsMap, itemName)
+		}
+	}
+}
+
 // ListenFailedScenarios listens to execution events and writes the failed scenarios to JSON file
 func ListenFailedScenarios(wg *sync.WaitGroup, specDirs []string) {
 	ch := make(chan event.ExecutionEvent)
@@ -97,10 +109,26 @@ func ListenFailedScenarios(wg *sync.WaitGroup, specDirs []string) {
 }
 
 func prepareScenarioFailedMetadata(res *result.ScenarioResult, sce *gauge.Scenario, executionInfo *gauge_messages.ExecutionInfo) {
+	specPath := executionInfo.GetCurrentSpec().GetFileName()
+	failedScenario := util.RelPathToProjectRoot(specPath)
+	item := fmt.Sprintf("%s:%v", failedScenario, sce.Span.Start)
 	if res.GetFailed() {
-		specPath := executionInfo.GetCurrentSpec().GetFileName()
-		failedScenario := util.RelPathToProjectRoot(specPath)
-		failedMeta.addFailedItem(specPath, fmt.Sprintf("%s:%v", failedScenario, sce.Span.Start))
+		if failedScenarios[item] == nil {
+			failedScenarios[item] = make(map[*gauge.Scenario]bool)
+		}
+		failedScenarios[item][sce] = true
+		failedMeta.addFailedItem(specPath, item)
+		return
+	}
+	// A scenario that failed in an earlier attempt may pass on a retry (--max-retries-count).
+	// Only the final outcome matters, so drop it unless another instance at the same location
+	// (e.g. another data table row) is still failing.
+	if instances, ok := failedScenarios[item]; ok {
+		delete(instances, sce)
+		if len(instances) == 0 {
+			delete(failedScenarios, item)
+			failedMeta.removeFailedItem(specPath, item)
+		}
 	}
 }
 
