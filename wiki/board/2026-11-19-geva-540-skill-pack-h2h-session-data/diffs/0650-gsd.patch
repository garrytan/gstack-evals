@@ -31,6 +31,9 @@ const (
 
 var failedMeta *failedMetadata
 
+// failedScenarios tracks, per failed item, the scenario instances whose latest attempt failed.
+var failedScenarios = make(map[string]map[*gauge.Scenario]bool)
+
 func init() {
 	failedMeta = newFailedMetaData()
 }
@@ -70,6 +73,15 @@ func (m *failedMetadata) addFailedItem(itemName string, item string) {
 	m.failedItemsMap[itemName][item] = true
 }
 
+func (m *failedMetadata) removeFailedItem(itemName string, item string) {
+	if items, ok := m.failedItemsMap[itemName]; ok {
