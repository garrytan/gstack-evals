 		return true
 	}
+	// IPv6 transition mechanisms (6to4, NAT64, Teredo, IPv4-compatible,
+	// IPv4-translated) embed arbitrary IPv4 addresses and can be used to reach
+	// loopback or link-local IPv4 targets. Block them outright.
+	if ip.To4() == nil && len(ip) == net.IPv6len {
+		for _, n := range ipv6TransitionNets {
+			if n.Contains(ip) {
+				return true
+			}
+		}
+	}
 	return false
 }
 
+var ipv6TransitionNets = func() []*net.IPNet {
+	cidrs := []string{
+		"2002::/16",       // 6to4 (RFC 3056)
+		"64:ff9b::/96",    // NAT64 well-known prefix (RFC 6052)
+		"64:ff9b:1::/48",  // NAT64 local-use prefix (RFC 8215)
+		"2001::/32",       // Teredo (RFC 4380)
+		"::/96",           // IPv4-compatible (deprecated, RFC 4291)
+		"::ffff:0:0:0/96", // IPv4-translated (SIIT, RFC 2765)
+	}
+	nets := make([]*net.IPNet, 0, len(cidrs))
+	for _, c := range cidrs {
+		_, n, err := net.ParseCIDR(c)
+		if err != nil {
+			panic(err)
+		}
+		nets = append(nets, n)
+	}
+	return nets
+}()
