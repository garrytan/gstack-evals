diff --git a/pkg/cli/copilot_agent_test.go b/pkg/cli/copilot_agent_test.go
index 2829182..7e9ac5c 100644
--- a/pkg/cli/copilot_agent_test.go
+++ b/pkg/cli/copilot_agent_test.go
@@ -341,3 +341,64 @@ ERROR: Test error
 		t.Error("Expected tool calls to be extracted")
 	}
 }
+
+func TestParseCopilotCodingAgentLogMetrics_IgnoresProse(t *testing.T) {
+	logContent := `
+I will now inspect the tool calls made by the workflow.
+The agent calls a command and then the tool to fetch data.
+Each tool call for the safe outputs is executed since the tool: or the tool on disk.
+The tool with unified diff launches misuse checks; calling tool calls is fine.
+Executing tool calls in order.
+Tool call: startHttpServer
+2024-01-15T10:00:00.000Z [INFO] Executing tool: noop
+Calling: label_agent
+`
+	metrics := ParseCopilotCodingAgentLogMetrics(logContent, false)
+
+	got := map[string]int{}
+	for _, tc := range metrics.ToolCalls {
+		got[tc.Name] = tc.CallCount
+	}
+	expected := map[string]int{"startHttpServer": 1, "noop": 1, "label_agent": 1}
+	if len(got) != len(expected) {
+		t.Fatalf("Expected tools %v, got %v", expected, got)
+	}
+	for name, count := range expected {
+		if got[name] != count {
+			t.Errorf("Expected %s to have %d calls, got %d (all: %v)", name, count, got[name], got)
+		}
+	}
+}
+
+func TestExtractToolName_RejectsProse(t *testing.T) {
+	lines := []string{
+		"the agent calls a tool to fetch data",
+		"Each tool call for the outputs",
+		"we are executing tool calls in order",
+		"Tool: to",
+		"Calling: calls",
+		"This mentions tool: something in the middle of prose",
+	}
+	for _, line := range lines {
+		if got := extractToolName(line); got != "" {
+			t.Errorf("extractToolName(%q) = %q, expected empty", line, got)
+		}
+	}
+}
+
+func TestCopilotCodingAgentDetector_ActivationAwInfo(t *testing.T) {
+	tmpDir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(tmpDir, "activation"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(tmpDir, "activation", "aw_info.json"), []byte(`{"engine_id":"copilot"}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	// Log mentions GitHub Copilot agent, which would otherwise trigger detection
+	if err := os.WriteFile(filepath.Join(tmpDir, "agent-stdio.log"), []byte("GitHub Copilot CLI agent starting\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if NewCopilotCodingAgentDetector(tmpDir, false).IsGitHubCopilotCodingAgent() {
+		t.Error("Expected agentic workflow run with activation/aw_info.json to not be detected as Copilot coding agent")
+	}
+}
