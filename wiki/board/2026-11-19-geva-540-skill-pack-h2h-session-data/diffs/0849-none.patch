diff --git a/examples/blp_model.conf b/examples/blp_model.conf
new file mode 100644
index 0000000..845ccc2
--- /dev/null
+++ b/examples/blp_model.conf
@@ -0,0 +1,11 @@
+[request_definition]
+r = sub, sub_level, obj, obj_level, act
+
+[policy_definition]
+p = sub, obj, act
+
+[policy_effect]
+e = some(where (p.eft == allow))
+
+[matchers]
+m = (r.act == "read" && r.sub_level >= r.obj_level) || (r.act == "write" && r.sub_level <= r.obj_level)
diff --git a/model_test.go b/model_test.go
index 98a09e2..6f3817e 100644
--- a/model_test.go
+++ b/model_test.go
@@ -706,3 +706,36 @@ func TestReBACModel(t *testing.T) {
 	testEnforce(t, e, "bob", "doc3", "read", false)
 	testEnforce(t, e, "bob", "doc3", "write", false)
 }
+
+func TestBLPModel(t *testing.T) {
+	e, _ := NewEnforcer("examples/blp_model.conf")
+
+	testEnforceBLP := func(sub string, subLevel int, obj string, objLevel int, act string, res bool) {
+		t.Helper()
+		myRes, err := e.Enforce(sub, subLevel, obj, objLevel, act)
+		if err != nil {
+			t.Errorf("Enforce Error: %s", err)
+			return
+		}
+		if myRes != res {
+			t.Errorf("%s, %d, %s, %d, %s: %t, supposed to be %t", sub, subLevel, obj, objLevel, act, myRes, res)
+		}
+	}
+
+	// Simple Security Property: no read up.
+	testEnforceBLP("alice", 3, "data1", 1, "read", true)
+	testEnforceBLP("alice", 3, "data2", 3, "read", true)
+	testEnforceBLP("bob", 2, "data3", 3, "read", false)
+	testEnforceBLP("charlie", 1, "data1", 1, "read", true)
+	testEnforceBLP("charlie", 1, "data2", 2, "read", false)
+
+	// *-Property: no write down.
+	testEnforceBLP("alice", 3, "data1", 1, "write", false)
+	testEnforceBLP("alice", 3, "data2", 3, "write", true)
+	testEnforceBLP("bob", 2, "data3", 3, "write", true)
+	testEnforceBLP("bob", 2, "data1", 1, "write", false)
+	testEnforceBLP("charlie", 1, "data2", 2, "write", true)
+
+	// Unknown actions are denied.
+	testEnforceBLP("alice", 3, "data1", 1, "delete", false)
+}
