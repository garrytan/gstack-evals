+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill () };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [3];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            StringBuilder text = new ();
+
+            for (var line = 0; line < 30; line++)
+            {
+                text.AppendLine ($"Tab{i} line {line}");
+            }
+
+            pages [i] = new View { Title = $"Tab{i}", Text = text.ToString () };
+            pages [i].SetContentSize (new Size (20, 30));
+            tabs.Add (pages [i]);
+        }
+
+        DrawFrame (root);
+
+        View active = (View)tabs.Value!;
+        Assert.Same (pages [0], active);
+
+        Counts tabsCounts = Counts.Track (tabs);
+        Counts activeCounts = Counts.Track (active);
+        Counts [] inactiveCounts = pages.Skip (1).Select (Counts.Track).ToArray ();
+
+        for (var y = 1; y <= 3; y++)
+        {
+            active.Viewport = active.Viewport with { Y = y };
+            DrawFrame (root);
+        }
+
+        Assert.Equal (0, tabsCounts.ClearedViewport);
+        Assert.Equal (0, tabsCounts.DrawingText);
+        Assert.Equal (3, activeCounts.ClearedViewport);
+        Assert.Equal (3, activeCounts.DrawComplete);
+
+        foreach (Counts c in inactiveCounts)
+        {
+            Assert.Equal (0, c.ClearedViewport);
+            Assert.Equal (0, c.DrawingText);
+            Assert.Equal (0, c.DrawingContent);
+            Assert.Equal (0, c.DrawComplete);
+        }
+
+        AssertMatchesFullRedraw (root, driver);
+        root.Dispose ();
+    }
+}
