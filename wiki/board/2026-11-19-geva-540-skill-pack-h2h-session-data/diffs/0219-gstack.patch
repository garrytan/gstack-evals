@@ -0,0 +1,413 @@
+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     Regression tests for the draw contract: a SubView-only redraw request (<see cref="View.SubViewNeedsDraw"/>)
+///     must not escalate into a full redraw (viewport clear, text, content) of the SuperView.
+/// </summary>
+/// <remarks>
+///     Rendering correctness is validated at the <see cref="IOutput"/> level (<see cref="IDriver.ToAnsi"/>) by
+///     comparing the result of a child-only redraw with the result of a forced full redraw of the same view tree.
+/// </remarks>
+[Trait ("Category", "Output")]
+public class ChildOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    private sealed class Counts
+    {
+        public int ClearingViewport;
+        public int ClearedViewport;
+        public int DrawingText;
+        public int DrawingContent;
+        public int DrawComplete;
+
+        public static Counts Track (View view)
+        {
+            Counts counts = new ();
+            view.ClearingViewport += (_, _) => counts.ClearingViewport++;
+            view.ClearedViewport += (_, _) => counts.ClearedViewport++;
+            view.DrawingText += (_, _) => counts.DrawingText++;
+            view.DrawingContent += (_, _) => counts.DrawingContent++;
+            view.DrawComplete += (_, _) => counts.DrawComplete++;
+
+            return counts;
+        }
+
+        public void Reset ()
+        {
+            ClearingViewport = 0;
+            ClearedViewport = 0;
+            DrawingText = 0;
+            DrawingContent = 0;
+            DrawComplete = 0;
+        }
+    }
+
+    /// <summary>Draws a full frame through the same path the application uses.</summary>
+    private static void DrawFrame (View root, bool force = false)
+    {
+        root.Layout ();
+        View.Draw ([root], force);
+    }
+
+    /// <summary>
+    ///     Asserts that the current rendered output (at the <see cref="IOutput"/> level) is identical to the output
+    ///     produced by a forced full redraw of <paramref name="root"/>.
+    /// </summary>
+    private void AssertMatchesFullRedraw (View root, IDriver driver)
+    {
+        // Push the incremental result through IOutput (not just Driver.Contents).
+        IOutput iOutput = driver.GetOutput ();
+        iOutput.Write (driver.GetOutputBuffer ());
+
+        string incremental = driver.ToAnsi ();
+        string incrementalText = ContentsAsText (driver);
+
+        DrawFrame (root, true);
+
+        iOutput.Write (driver.GetOutputBuffer ());
+        string full = driver.ToAnsi ();
+        string fullText = ContentsAsText (driver);
+
+        output.WriteLine ("Incremental:");
+        output.WriteLine (incrementalText);
+        output.WriteLine ("Full:");
+        output.WriteLine (fullText);
+
+        Assert.Equal (fullText, incrementalText);
+        Assert.Equal (full, incremental);
+    }
+
+    private static string ContentsAsText (IDriver driver)
+    {
+        StringBuilder sb = new ();
+        Cell [,] contents = driver.Contents!;
+
+        for (var r = 0; r < contents.GetLength (0); r++)
+        {
+            for (var c = 0; c < contents.GetLength (1); c++)
+            {
+                sb.Append (contents [r, c].Grapheme);
+            }
+
+            sb.AppendLine ();
+        }
+
+        return sb.ToString ();
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_Does_Not_Clear_Parent_Viewport ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single, Text = "Parent" };
+        Label child = new () { X = 1, Y = 2, Text = "Child" };
+        parent.Add (child);
+
+        DrawFrame (parent);
+
+        Counts parentCounts = Counts.Track (parent);
+        Counts childCounts = Counts.Track (child);
+
+        child.Text = "Kids!"; // same length: no layout change
+        Assert.False (parent.NeedsDraw);
+        Assert.True (parent.SubViewNeedsDraw);
+
+        DrawFrame (parent);
+
+        Assert.Equal (0, parentCounts.ClearingViewport);
+        Assert.Equal (0, parentCounts.ClearedViewport);
+        Assert.Equal (1, childCounts.ClearedViewport);
+        Assert.Equal (1, childCounts.DrawComplete);
+
+        Assert.False (parent.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+        Assert.False (child.NeedsDraw);
+
+        AssertMatchesFullRedraw (parent, driver);
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_Does_Not_Redraw_Parent_Text_Or_Content ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "Parent" };
+        View child = new () { X = 2, Y = 2, Width = 5, Height = 1, Text = "Child" };
+        parent.Add (child);
+
+        DrawFrame (parent);
+
+        Counts parentCounts = Counts.Track (parent);
+        Counts childCounts = Counts.Track (child);
+
+        child.SetNeedsDraw ();
+        DrawFrame (parent);
+
+        Assert.Equal (0, parentCounts.DrawingText);
+        Assert.Equal (0, parentCounts.DrawingContent);
+        Assert.Equal (1, childCounts.DrawingText);
+        Assert.Equal (1, childCounts.DrawingContent);
+
+        AssertMatchesFullRedraw (parent, driver);
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void Parent_That_Needs_Draw_Still_Clears_And_Redraws_SubViews ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "Parent" };
+        View child = new () { X = 2, Y = 2, Width = 5, Height = 1, Text = "Child" };
+        parent.Add (child);
+
+        DrawFrame (parent);
+
+        Counts parentCounts = Counts.Track (parent);
+        Counts childCounts = Counts.Track (child);
+
+        parent.SetNeedsDraw ();
+        DrawFrame (parent);
+
+        Assert.Equal (1, parentCounts.ClearedViewport);
+        Assert.Equal (1, parentCounts.DrawingText);
+        Assert.Equal (1, parentCounts.DrawingContent);
+        Assert.Equal (1, childCounts.DrawComplete);
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void Clean_Sibling_Is_Not_Redrawn_When_Only_Peer_Is_Dirty ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        View dirty = new () { X = 0, Y = 0, Width = 10, Height = 3, Text = "Dirty" };
+        View clean = new () { X = 5, Y = 1, Width = 10, Height = 3, Text = "Clean", Arrangement = ViewArrangement.Overlapped };
+        parent.Add (dirty, clean);
+
+        DrawFrame (parent);
+
+        Counts cleanCounts = Counts.Track (clean);
+
+        dirty.SetNeedsDraw ();
+        DrawFrame (parent);
+
+        Assert.Equal (0, cleanCounts.ClearedViewport);
+        Assert.Equal (0, cleanCounts.DrawingText);
+        Assert.Equal (0, cleanCounts.DrawComplete);
+
+        AssertMatchesFullRedraw (parent, driver);
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_Through_Nested_Hierarchy_Does_Not_Clear_Ancestors ()
+    {
+        IDriver driver = CreateTestDriver (30, 10);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Double };
+        View middle = new () { X = 1, Y = 1, Width = 20, Height = 6, BorderStyle = LineStyle.Single, Title = "Mid" };
+        Label leaf = new () { X = 1, Y = 1, Text = "Leaf" };
+        middle.Add (leaf);
+        root.Add (middle);
+
+        DrawFrame (root);
+
+        Counts rootCounts = Counts.Track (root);
+        Counts middleCounts = Counts.Track (middle);
+
+        leaf.Text = "Lea2"; // same length: no layout change
+        DrawFrame (root);
+
+        Assert.Equal (0, rootCounts.ClearedViewport);
+        Assert.Equal (0, middleCounts.ClearedViewport);
+
+        AssertMatchesFullRedraw (root, driver);
+        root.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_In_Partially_Clipped_Parent_Renders_Correctly ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+
+        // Parent extends past the right/bottom edge of root
+        View parent = new () { X = 10, Y = 3, Width = 20, Height = 6, BorderStyle = LineStyle.Single, Text = "P" };
+        Label child = new () { X = 1, Y = 1, Text = "Child" };
+        parent.Add (child);
+        root.Add (parent);
+
+        DrawFrame (root);
+
+        Counts parentCounts = Counts.Track (parent);
+
+        child.Text = "Other"; // same length: no layout change
+        DrawFrame (root);
+
+        Assert.Equal (0, parentCounts.ClearedViewport);
+        AssertMatchesFullRedraw (root, driver);
+        root.Dispose ();
+    }
+
+    [Fact]
+    public void Transparent_SubView_Forces_Parent_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "ParentText" };
+
+        View child = new ()
+        {
+            X = 0,
+            Y = 0,
+            Width = 10,
+            Height = 1,
+            Text = "LongerText",
+            ViewportSettings = ViewportSettingsFlags.Transparent
+        };
+        parent.Add (child);
+
+        DrawFrame (parent);
+
+        Counts parentCounts = Counts.Track (parent);
+
+        // Shorter text: previously drawn cells of the transparent child must be erased by the parent.
+        child.Text = "Hi";
+        DrawFrame (parent);
+
+        Assert.Equal (1, parentCounts.ClearedViewport);
+        AssertMatchesFullRedraw (parent, driver);
+        parent.Dispose ();
+    }
+
+    [Theory]
+    [InlineData (ShadowStyles.Transparent)]
+    [InlineData (ShadowStyles.Opaque)]
+    public void Shadow_SubView_Renders_Correctly_After_Repeated_ChildOnly_Redraws (ShadowStyles shadowStyle)
+    {
+        // Shadows composite over the cells beneath them (reading ScreenContents), so this requires a real App.
+        using IApplication app = Application.Create ();
+        app.Init (DriverRegistry.Names.ANSI);
+        app.Driver!.SetScreenSize (30, 10);
+
+        Runnable root = new () { Width = Dim.Fill (), Height = Dim.Fill (), Text = "Root background text that fills" };
+
+        // Use colors that do not hit ShadowView's DarkGray fallback, so repeated transparent-shadow
+        // compositing over un-repainted cells would be detectable at the attribute level.
+        root.SetScheme (new Scheme (new Attribute (Color.BrightYellow, Color.BrightCyan)));
+        View shadowed = new () { X = 2, Y = 2, Width = 12, Height = 4, BorderStyle = LineStyle.Single, ShadowStyle = shadowStyle };
+        Label leaf = new () { Text = "0" };
+        shadowed.Add (leaf);
+        View sibling = new () { X = 16, Y = 2, Width = 10, Height = 3, Text = "Sibling" };
+        root.Add (shadowed, sibling);
+
+        SessionToken? token = app.Begin (root);
+        app.LayoutAndDraw ();
+
+        for (var i = 1; i <= 3; i++)
+        {
+            // Child-only invalidation (no layout change)
+            leaf.SetNeedsDraw ();
+            app.LayoutAndDraw ();
+
+            sibling.SetNeedsDraw ();
+            app.LayoutAndDraw ();
+        }
+
+        IDriver driver = app.Driver;
+        string incremental = driver.ToAnsi ();
+        string incrementalText = ContentsAsText (driver);
+
+        app.LayoutAndDraw (true);
+
+        string full = driver.ToAnsi ();
+        output.WriteLine (ContentsAsText (driver));
+
+        Assert.Equal (ContentsAsText (driver), incrementalText);
+
+        // Attribute-level comparison: catches shadows being composited repeatedly over un-repainted cells.
+        Assert.Equal (full, incremental);
+
+        app.End (token!);
+        root.Dispose ();
+    }
+
