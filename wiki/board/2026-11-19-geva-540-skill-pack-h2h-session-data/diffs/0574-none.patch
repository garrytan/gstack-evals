+// isGoWithWgDone returns true if the given statement is a go statement
+// running a function literal that calls wg.Done, or if it is a loop
+// (for or range) whose body directly contains such a go statement.
+func (w *lintUseWaitGroupGo) isGoWithWgDone(stmt ast.Stmt) bool {
+	switch s := stmt.(type) {
+	case *ast.GoStmt:
+		return w.hasCallToWgDone(s)
+	case *ast.ForStmt:
+		return w.loopBodyHasGoWithWgDone(s.Body)
+	case *ast.RangeStmt:
+		return w.loopBodyHasGoWithWgDone(s.Body)
+	}
+
+	return false
+}
+
+func (w *lintUseWaitGroupGo) loopBodyHasGoWithWgDone(body *ast.BlockStmt) bool {
+	if body == nil {
+		return false
+	}
+
+	for _, stmt := range body.List {
+		if w.isCallToWgAdd(stmt) {
+			return false // the loop manages its own wg.Add calls
+		}
+
+		if w.isGoWithWgDone(stmt) {
+			return true
+		}
+	}
+
+	return false
+}
