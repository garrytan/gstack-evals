@@ -764,6 +766,15 @@ func (t *TLS) AddAutomationPolicy(ap *AutomationPolicy) error {
 
 func (t *TLS) getConfigForName(name string) *certmagic.Config {
 	ap := t.getAutomationPolicyForName(name)
+	// if this name is not managed itself because a managed wildcard covers
+	// it (see Manage), use the wildcard's policy instead, otherwise settings
+	// like on-demand TLS and external cert managers (get_certificate) would
+	// not apply to the subdomain even though the wildcard is meant to serve it
+	if _, managed := t.managing[name]; !managed && ap.magic.OnDemand == nil {
+		if wildcard := t.managingWildcardFor(name, nil); wildcard != "" && wildcard != name {
+			ap = t.getAutomationPolicyForName(wildcard)
+		}
+	}
 	return ap.magic
 }
 
diff --git a/modules/caddytls/tls_test.go b/modules/caddytls/tls_test.go
new file mode 100644
index 0000000..93ee302
--- /dev/null
+++ b/modules/caddytls/tls_test.go
@@ -0,0 +1,27 @@
+package caddytls
+
+import (
+	"testing"
+
+	"github.com/caddyserver/certmagic"
+)
+
+// Subdomains skipped by Manage because a managed wildcard covers them must
+// use the wildcard's policy at handshake time (e.g. for get_certificate).
+func TestGetConfigForNameUsesCoveringWildcardPolicy(t *testing.T) {
+	sub := &AutomationPolicy{subjects: []string{"wiki.example.com"}, magic: &certmagic.Config{}}
+	wild := &AutomationPolicy{subjects: []string{"*.example.com"}, magic: &certmagic.Config{OnDemand: &certmagic.OnDemandConfig{}}}
+	tlsApp := &TLS{
+		Automation: &AutomationConfig{Policies: []*AutomationPolicy{sub, wild}},
+		managing:   map[string]string{"*.example.com": ""},
+	}
+
+	if got := tlsApp.getConfigForName("wiki.example.com"); got != wild.magic {
+		t.Error("expected covering wildcard's config for unmanaged subdomain")
+	}
+
+	tlsApp.managing["wiki.example.com"] = ""
+	if got := tlsApp.getConfigForName("wiki.example.com"); got != sub.magic {
+		t.Error("expected subdomain's own config when it is managed itself")
+	}
+}
