index 0000000..5a5e61f
--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/abort-signal-state-mutation/main.svelte
@@ -0,0 +1,16 @@
+<script>
+	import { getAbortSignal } from 'svelte';
+
+	let count = $state(0);
+	let aborted = $state(0);
+
+	const value = $derived.by(() => {
+		const signal = getAbortSignal();
+		signal.addEventListener('abort', () => {
+			aborted += 1;
+		});
+		return count;
+	});
+</script>
+
+<button onclick={() => count++}>{value} {aborted}</button>
