+    @Test
+    @Order(2)
+    void listUserPoolClientsReturnsOnlyDescriptionFields() throws Exception {
+        JsonNode response = cognitoJson("ListUserPoolClients", """
+                {
+                  "UserPoolId": "%s"
+                }
+                """.formatted(poolId));
+
+        JsonNode clients = response.path("UserPoolClients");
+        assertTrue(clients.isArray());
+        assertEquals(3, clients.size());
+        for (JsonNode client : clients) {
+            assertEquals(3, client.size(), "Unexpected fields: " + client);
+            assertTrue(client.hasNonNull("ClientId"));
+            assertTrue(client.hasNonNull("ClientName"));
+            assertEquals(poolId, client.path("UserPoolId").asText());
+        }
+    }
