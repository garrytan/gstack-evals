+TEST_F(BuildTest, DyndepReadyImplicitOutputAsDepfileInputOfLaterEdge) {
+  // Verify that when an already-built dyndep file gives an edge an
+  // implicit output that a depfile lists as an input of another edge,
+  // and that input is visited before the dyndep is loaded, the other
+  // edge is still rebuilt when the implicit output is going to change.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out $out.imp\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"build dd: cp dd-in\n"
+"build tmp: touch || dd\n"
+"  dyndep = dd\n"
+"build out: cp || tmp\n"
+"  depfile = out.d\n"
+));
+  fs_.Create("dd-in",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Tick();
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("tmp.imp", "");
+  fs_.Tick();
+  fs_.Create("out", "");
+  fs_.Create("out.d", "out: tmp.imp\n");
+  // tmp is missing, so its edge will run and update tmp.imp.
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("out", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch tmp tmp.imp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cp  out", command_runner_.commands_ran_[1]);
+}
+
