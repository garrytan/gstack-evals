+    private static List<String> extractResources(Map<String, Object> event) {
+        Object raw = event.get("Resources");
+        if (raw instanceof Collection<?> collection) {
+            List<String> result = new ArrayList<>();
+            for (Object o : collection) {
+                if (o != null) {
+                    result.add(o.toString());
+                }
+            }
+            return result;
+        }
+        if (raw instanceof String[] array) {
+            List<String> result = new ArrayList<>();
+            for (String s : array) {
+                if (s != null) {
+                    result.add(s);
+                }
+            }
+            return result;
+        }
+        return List.of();
+    }
