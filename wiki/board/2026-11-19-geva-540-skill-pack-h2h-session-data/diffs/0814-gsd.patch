+test('Should send multiple cookie values as separate H2 header fields', async t => {
+  const server = createSecureServer(await pem.generate({ opts: { keySize: 2048 } }))
+
+  server.on('stream', (stream, headers, flags, rawHeaders) => {
+    // Node joins multiple cookie fields with "; " (RFC 9113 8.2.3)
+    t.strictEqual(headers.cookie, 'a=b; c=d; e=f')
+    const cookies = []
+    for (let i = 0; i < rawHeaders.length; i += 2) {
+      if (rawHeaders[i] === 'cookie') cookies.push(rawHeaders[i + 1])
+    }
+    t.deepStrictEqual(cookies, ['a=b', 'c=d', 'e=f'])
+    stream.respond({ ':status': 200 })
+    stream.end()
+  })
+
+  server.listen(0)
+  await once(server, 'listening')
+
+  const client = new Client(`https://localhost:${server.address().port}`, {
+    connect: {
+      rejectUnauthorized: false
+    },
+    allowH2: true
+  })
+
+  t = tspl(t, { plan: 3 })
+  after(() => server.close())
+  after(() => client.close())
+
+  const response = await client.request({
+    path: '/',
+    method: 'GET',
+    headers: { cookie: ['a=b', 'c=d', 'e=f'] }
+  })
+  await response.body.dump()
+  t.strictEqual(response.statusCode, 200)
+})
+
