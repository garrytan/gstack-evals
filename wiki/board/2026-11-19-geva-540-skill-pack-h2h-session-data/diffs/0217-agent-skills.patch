+        IDriver driver = CreateTestDriver (60, 20);
+        (View root, Tabs tabs, View [] _) = BuildTabs (driver);
+        root.Layout ();
+        tabs.Value!.Viewport = tabs.Value!.Viewport with { Y = 2 };
+        root.Layout ();
+        driver.Clip = new Region (driver.Screen);
+        root.Draw ();
+
+        string headerRow = driver.ToString ().Split ('\n') [1];
