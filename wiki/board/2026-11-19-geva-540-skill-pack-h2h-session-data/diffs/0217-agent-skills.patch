diff --git a/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs b/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs
new file mode 100644
index 0000000..56050d9
--- /dev/null
+++ b/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs
@@ -0,0 +1,501 @@
+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     Tests that a SuperView entered in <see cref="View.Draw(DrawContext?)"/> only because a SubView is dirty
+///     (<c>SubViewNeedsDraw</c>) does not escalate into a full redraw of its own viewport, text, and content,
+///     and that rendering stays correct at the <see cref="IOutput"/> level.
+/// </summary>
+public class ChildOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    private sealed class Counters
+    {
+        public int ClearingViewport;
+        public int ClearedViewport;
+        public int DrawingText;
+        public int DrawingContent;
+        public int DrawComplete;
+
+        public static Counters Track (View view)
+        {
+            Counters c = new ();
+            view.ClearingViewport += (_, _) => c.ClearingViewport++;
+            view.ClearedViewport += (_, _) => c.ClearedViewport++;
+            view.DrawingText += (_, _) => c.DrawingText++;
+            view.DrawingContent += (_, _) => c.DrawingContent++;
+            view.DrawComplete += (_, _) => c.DrawComplete++;
+
+            return c;
+        }
+    }
+
+    private static (View Parent, View Child) BuildParentWithChild (IDriver driver)
+    {
+        View parent = new ()
+        {
+            Driver = driver,
+            Width = 20,
+            Height = 10,
+            Text = "Parent",
+            BorderStyle = LineStyle.Single
+        };
+        View child = new () { X = 2, Y = 2, Width = 6, Height = 3, Text = "Child" };
+        parent.Add (child);
+        parent.Layout ();
+        parent.Driver!.Clip = new Region (parent.Driver.Screen);
+        parent.Draw ();
+
+        return (parent, child);
+    }
+
+    [Fact]
+    public void ChildOnlyDirty_Parent_DoesNotClearViewport ()
+    {
+        IDriver driver = CreateTestDriver (30, 15);
+        (View parent, View child) = BuildParentWithChild (driver);
+        Counters parentCounters = Counters.Track (parent);
+        Counters childCounters = Counters.Track (child);
+
+        child.SetNeedsDraw ();
+        Assert.False (parent.NeedsDraw);
+        parent.Driver!.Clip = new Region (parent.Driver.Screen);
+        parent.Draw ();
+
+        Assert.Equal (0, parentCounters.ClearingViewport);
+        Assert.Equal (0, parentCounters.ClearedViewport);
+        Assert.Equal (1, childCounters.ClearedViewport);
+        Assert.False (parent.NeedsDraw);
+        Assert.False (child.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnlyDirty_Parent_DoesNotDrawTextOrContent ()
+    {
+        IDriver driver = CreateTestDriver (30, 15);
+        (View parent, View child) = BuildParentWithChild (driver);
+        Counters parentCounters = Counters.Track (parent);
+        Counters childCounters = Counters.Track (child);
+
+        child.SetNeedsDraw ();
+        parent.Driver!.Clip = new Region (parent.Driver.Screen);
+        parent.Draw ();
+
+        Assert.Equal (0, parentCounters.DrawingText);
+        Assert.Equal (0, parentCounters.DrawingContent);
+        Assert.Equal (1, childCounters.DrawingText);
+        Assert.Equal (1, childCounters.DrawingContent);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ParentDirty_Parent_StillClearsAndDrawsText ()
+    {
+        IDriver driver = CreateTestDriver (30, 15);
+        (View parent, View child) = BuildParentWithChild (driver);
+        Counters parentCounters = Counters.Track (parent);
+        Counters childCounters = Counters.Track (child);
+
+        parent.SetNeedsDraw ();
+        parent.Driver!.Clip = new Region (parent.Driver.Screen);
+        parent.Draw ();
+
+        Assert.Equal (1, parentCounters.ClearedViewport);
+        Assert.Equal (1, parentCounters.DrawingText);
+        Assert.Equal (1, parentCounters.DrawingContent);
+        Assert.Equal (1, childCounters.ClearedViewport);
+
+        parent.Dispose ();
+        driver.Dispose ();
+    }
