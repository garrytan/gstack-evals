+
+    private static (View Root, Tabs Tabs, View [] Pages) BuildTabs (IDriver driver)
+    {
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill () };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [4];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            StringBuilder sb = new ();
+
+            for (var line = 1; line <= 40; line++)
+            {
+                sb.Append ($"Tab{i + 1} line {line}\n");
+            }
+
+            pages [i] = new View { Title = $"Tab{i + 1}", Text = sb.ToString (), Width = Dim.Fill (), Height = Dim.Fill () };
+            pages [i].SetContentSize (new Size (30, 40));
+            tabs.Add (pages [i]);
+        }
+
+        return (root, tabs, pages);
+    }
+
+    /// <summary>
+    ///     Builds the same scene twice. In the first, the scene is drawn, mutated, and incrementally redrawn.
+    ///     In the second, the mutation is applied before the very first draw. The resulting screens must be
+    ///     identical at the <see cref="IOutput"/> (ANSI) level as well as in <c>Driver.Contents</c>.
+    /// </summary>
+    private void AssertIncrementalMatchesFull (Func<IDriver, (View Root, Action Mutate)> build)
+    {
+        IDriver incrementalDriver = CreateTestDriver (60, 20);
+        (View incrementalRoot, Action mutateIncremental) = build (incrementalDriver);
+        incrementalRoot.Layout ();
+        incrementalRoot.Driver!.Clip = new Region (incrementalRoot.Driver.Screen);
+        incrementalRoot.Draw ();
+        mutateIncremental ();
+        incrementalRoot.Layout ();
+        incrementalRoot.Driver!.Clip = new Region (incrementalRoot.Driver.Screen);
+        incrementalRoot.Draw ();
+
+        IDriver fullDriver = CreateTestDriver (60, 20);
+        (View fullRoot, Action mutateFull) = build (fullDriver);
+        fullRoot.Layout ();
+        mutateFull ();
+        fullRoot.Layout ();
+        fullRoot.Driver!.Clip = new Region (fullRoot.Driver.Screen);
+        fullRoot.Draw ();
+
+        string expected = fullDriver.ToString ();
+        string actual = incrementalDriver.ToString ();
+
+        if (expected != actual)
+        {
+            output.WriteLine ("Expected (full):");
+            output.WriteLine (expected);
+            output.WriteLine ("Actual (incremental):");
+            output.WriteLine (actual);
+        }
+
+        Assert.Equal (expected, actual);
+        Assert.Equal (fullDriver.GetOutput ().ToAnsi (fullDriver.GetOutputBuffer ()), incrementalDriver.GetOutput ().ToAnsi (incrementalDriver.GetOutputBuffer ()));
+
+        incrementalRoot.Dispose ();
+        fullRoot.Dispose ();
+        incrementalDriver.Dispose ();
+        fullDriver.Dispose ();
+    }
+}
