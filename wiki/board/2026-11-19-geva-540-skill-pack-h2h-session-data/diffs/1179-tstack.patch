+// validateFileName ensures the file name is a plain base name so that it cannot
+// escape the destination directory (e.g. via "../" or an absolute path).
+func validateFileName(fileName string) error {
+	if fileName == "" || fileName == "." || fileName == ".." ||
+		strings.ContainsAny(fileName, `/\`) || filepath.Base(fileName) != fileName ||
+		filepath.IsAbs(fileName) || filepath.VolumeName(fileName) != "" {
+		return xerrors.Errorf("%q must be a plain file name without path components", fileName)
+	}
+	return nil
+}
