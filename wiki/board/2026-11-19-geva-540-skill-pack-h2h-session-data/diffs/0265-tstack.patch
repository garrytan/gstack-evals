 // the returned attribute has that method's return value. If multiple errors in
 // the chain implement this method, the value from the first match found by
 // [errors.As] is used. Otherwise, the returned attribute has a value derived
-// from the concrete type of err.
+// from the concrete type of err. Wrappers created by [fmt.Errorf] with the %w
+// verb are skipped, and the concrete type of the first wrapped error is used
+// instead.
 //
 // The key of the returned attribute is [ErrorTypeKey].
 func ErrorType(err error) attribute.KeyValue {
@@ -50,7 +52,7 @@ func errorType(err error) string {
 		// Fallback to reflection if the ErrorType method is not supported or
 		// returns an empty value.
 
-		t := reflect.TypeOf(err)
+		t := reflect.TypeOf(unwrapFmt(err))
 		pkg, name := t.PkgPath(), t.Name()
 		if pkg != "" && name != "" {
 			s = pkg + "." + name
@@ -64,3 +66,28 @@ func errorType(err error) string {
 	}
 	return s
 }
+
+// unwrapFmt returns the first error in err's chain that is not a wrapper
+// created by fmt.Errorf. These wrappers carry no meaningful type information.
+func unwrapFmt(err error) error {
+	for {
+		var next error
+		switch t := reflect.TypeOf(err); t.String() {
+		case "*fmt.wrapError":
+			next = errors.Unwrap(err)
+		case "*fmt.wrapErrors":
+			if u, ok := err.(interface{ Unwrap() []error }); ok {
+				for _, e := range u.Unwrap() {
+					if e != nil {
+						next = e
+						break
+					}
+				}
+			}
+		}
+		if next == nil {
+			return err
+		}
+		err = next
+	}
+}
