+	check(t, fmt.Errorf("a: %w", fmt.Errorf("b: %w", custom(""))), pkg+".ErrCustomType") // skip nested fmt wrappers.
+	check(t, fmt.Errorf("%w, %w", custom(""), errors.New("msg")), pkg+".ErrCustomType")  // skip fmt multi-wrapper, use first.
+	check(t, fmt.Errorf("ctx: %w", wrapped(custom(""))), pkg+".wrappedErr")              // stop at non-fmt wrapper.
+	check(t, fmt.Errorf("ctx: %w", nil), "*fmt.wrapError")                               // nothing to unwrap.
+	check(t, fmt.Errorf("no wrap: %v", errors.New("msg")), "*errors.errorString")        // fmt.Errorf without %w.
 }
 
