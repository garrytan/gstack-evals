+            "public class B { public string Str { get; set; } public int Value { get; set; } }"
+        );
+        TestHelper
+            .GenerateMapper(source)
+            .Should()
+            .HaveMethodBody(
+                "Update",
+                """
+                target.Str = global::OtherMapper.Trim(source.Str);
+                target.Value = global::OtherMapper.Identity<int>(source.Value);
+                """
+            );
+    }
