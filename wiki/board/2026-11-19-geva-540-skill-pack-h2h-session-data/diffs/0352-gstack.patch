+
+    /// <summary>
+    /// Sets the comparer used when matching user input against the choices.
+    /// </summary>
+    /// <typeparam name="T">The prompt result type.</typeparam>
+    /// <param name="obj">The prompt.</param>
+    /// <param name="comparer">The comparer to use, or <see langword="null"/> for the default (case-sensitive) comparison.</param>
+    /// <returns>The same instance so that multiple calls can be chained.</returns>
+    public static TextPrompt<T> WithComparer<T>(this TextPrompt<T> obj, StringComparer? comparer)
+    {
+        ArgumentNullException.ThrowIfNull(obj);
+
+        obj.Comparer = comparer;
+        return obj;
+    }
+
+    /// <summary>
+    /// Makes matching user input against the choices case-insensitive.
+    /// </summary>
+    /// <typeparam name="T">The prompt result type.</typeparam>
+    /// <param name="obj">The prompt.</param>
+    /// <returns>The same instance so that multiple calls can be chained.</returns>
+    public static TextPrompt<T> CaseInsensitive<T>(this TextPrompt<T> obj)
+    {
+        return WithComparer(obj, StringComparer.OrdinalIgnoreCase);
+    }
+}
