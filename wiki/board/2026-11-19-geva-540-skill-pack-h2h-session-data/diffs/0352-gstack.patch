+    [Theory]
+    [InlineData("yes", "Yes")]
+    [InlineData("PARTIALLY", "Partially")]
+    [InlineData("No", "No")]
+    public void Should_Match_Choices_Case_Insensitively_When_Configured(string input, string expected)
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter(input);
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Helpful?")
+                .AddChoices(["Yes", "Partially", "No"])
+                .CaseInsensitive());
+
+        // Then
+        result.ShouldBe(expected);
+    }
+
+    [Fact]
+    public void Should_Match_Choices_Using_Comparer_From_Constructor()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("banana");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Fruit?", StringComparer.OrdinalIgnoreCase)
+                .AddChoices(["Apple", "Banana"]));
+
+        // Then
+        result.ShouldBe("Banana");
+    }
+
+    [Fact]
+    public void Should_Match_Choices_Case_Sensitively_By_Default()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+        console.Input.PushTextWithEnter("Yes");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Helpful?")
+                .AddChoices(["Yes", "No"]));
+
+        // Then
+        result.ShouldBe("Yes");
+        console.Output.ShouldContain("Please select one of the available options");
+    }
+
+    [Fact]
+    public void Should_Not_Throw_On_Choices_Differing_Only_By_Case_When_Case_Insensitive()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Helpful?")
+                .AddChoices(["Yes", "YES"])
+                .CaseInsensitive());
+
+        // Then
+        result.ShouldBe("Yes");
+    }
+
