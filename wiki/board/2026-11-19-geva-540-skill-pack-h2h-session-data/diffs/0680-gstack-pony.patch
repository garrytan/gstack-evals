+
+func TestListBacktickInPackageComment(t *testing.T) {
+	stdout := &bytes.Buffer{}
+	inv := Invocation{
+		Dir:    "./testdata/backtick",
+		Stdout: stdout,
+		Stderr: io.Discard,
+		List:   true,
+	}
+	if code := Invoke(inv); code != 0 {
+		t.Fatalf("expected to exit with code 0, but got %v", code)
+	}
+	if !strings.Contains(stdout.String(), "Call with `mage` please.\n") {
+		t.Fatalf("unexpected output: %q", stdout.String())
+	}
+}
