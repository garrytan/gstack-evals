diff --git a/context.go b/context.go
index ec7fdd9..036eb88 100644
--- a/context.go
+++ b/context.go
@@ -166,16 +166,27 @@ func (c *Context) Scheme() string {
 		return "https"
 	}
 	if scheme := c.request.Header.Get(HeaderXForwardedProto); scheme != "" {
-		return scheme
+		return sanitizeScheme(scheme)
 	}
 	if scheme := c.request.Header.Get(HeaderXForwardedProtocol); scheme != "" {
-		return scheme
+		return sanitizeScheme(scheme)
 	}
 	if ssl := c.request.Header.Get(HeaderXForwardedSsl); ssl == "on" {
 		return "https"
 	}
 	if scheme := c.request.Header.Get(HeaderXUrlScheme); scheme != "" {
-		return scheme
+		return sanitizeScheme(scheme)
+	}
+	return "http"
+}
+
+// sanitizeScheme returns the normalized scheme if it is one of the allowed values (http, https, ws, wss)
+// and "http" otherwise. Scheme header values are client controlled and must not be trusted verbatim, as they
+// are used to construct URLs (e.g. redirect Location headers).
+func sanitizeScheme(scheme string) string {
+	switch s := strings.ToLower(strings.TrimSpace(scheme)); s {
+	case "http", "https", "ws", "wss":
+		return s
 	}
 	return "http"
 }
