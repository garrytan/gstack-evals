@@ -70,6 +70,17 @@ func (m *failedMetadata) addFailedItem(itemName string, item string) {
 	m.failedItemsMap[itemName][item] = true
 }
 
+func (m *failedMetadata) removeFailedItem(itemName string, item string) {
+	items, ok := m.failedItemsMap[itemName]
+	if !ok {
+		return
+	}
+	delete(items, item)
+	if len(items) == 0 {
+		delete(m.failedItemsMap, itemName)
+	}
+}
