+    [Fact]
+    public void FixHyphensEnDashBothLinesWithSpace()
+    {
+        var splitMerge = new DialogSplitMerge { DialogStyle = DialogType.DashBothLinesWithSpace };
+        var p = new Paragraph($"\u2013 How are you?{Environment.NewLine}\u2013 I'm fine.", 4000, 7000);
+        var result = splitMerge.FixDashesAndSpaces(p.Text, p, null);
+        Assert.Equal($"- How are you?{Environment.NewLine}- I'm fine.", result);
+    }
+
+    [Fact]
+    public void FixHyphensEnDashBothLinesWithoutSpace()
+    {
+        var splitMerge = new DialogSplitMerge { DialogStyle = DialogType.DashBothLinesWithoutSpace };
+        var p = new Paragraph($"<i>\u2013 How are you?{Environment.NewLine}\u2013I'm fine.</i>", 4000, 7000);
+        var result = splitMerge.FixDashesAndSpaces(p.Text, p, null);
+        Assert.Equal($"<i>-How are you?{Environment.NewLine}-I'm fine.</i>", result);
+    }
+
+    [Fact]
+    public void FixHyphensEnDashSecondLineWithSpace()
+    {
+        var splitMerge = new DialogSplitMerge { DialogStyle = DialogType.DashSecondLineWithSpace };
+        var p = new Paragraph($"\u2013 How are you?{Environment.NewLine}\u2013 I'm fine.", 4000, 7000);
+        var result = splitMerge.FixDashesAndSpaces(p.Text, p, null);
+        Assert.Equal($"How are you?{Environment.NewLine}- I'm fine.", result);
+    }
+
