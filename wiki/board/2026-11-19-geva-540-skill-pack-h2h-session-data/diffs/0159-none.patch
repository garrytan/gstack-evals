+        public static char GetAlternateDashChar() => '\u2010'; // Unicode Hyphen (\u2010)
+
+        /// <summary>
+        /// Non-ASCII dash characters that are treated like a normal dash at the start of dialog lines.
+        /// </summary>
+        public static char[] GetAlternateDashChars() => new[]
+        {
+            '\u2010', // Hyphen
+            '\u2011', // Non-breaking hyphen
+            '\u2012', // Figure dash
+            '\u2013', // En dash
+        };
+
+        public static bool IsAlternateDashChar(char c) => Array.IndexOf(GetAlternateDashChars(), c) >= 0;
+
+        private static bool StartsWithDash(string s)
+        {
+            var trimmed = s.TrimStart();
+            return trimmed.Length > 0 && (trimmed[0] == GetDashChar() || IsAlternateDashChar(trimmed[0]));
+        }
+
+        private static string NormalizeStartDash(string s)
+        {
+            var idx = 0;
+            while (idx < s.Length && char.IsWhiteSpace(s[idx]))
+            {
+                idx++;
+            }
+
+            if (idx < s.Length && IsAlternateDashChar(s[idx]))
+            {
+                return s.Substring(0, idx) + GetDashChar() + s.Substring(idx + 1);
+            }
+
+            return s;
+        }
 
