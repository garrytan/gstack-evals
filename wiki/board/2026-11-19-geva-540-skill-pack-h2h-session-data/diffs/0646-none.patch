diff --git a/changelogs/unreleased/9999-healthchecknodeport-null b/changelogs/unreleased/9999-healthchecknodeport-null
new file mode 100644
index 0000000..acb0ddb
--- /dev/null
+++ b/changelogs/unreleased/9999-healthchecknodeport-null
@@ -0,0 +1 @@
+Fix Service restore failure when last-applied-configuration has "healthCheckNodePort": null
diff --git a/pkg/restore/actions/service_action.go b/pkg/restore/actions/service_action.go
index 9de7522..45bf534 100644
--- a/pkg/restore/actions/service_action.go
+++ b/pkg/restore/actions/service_action.go
@@ -101,15 +101,24 @@ func deleteHealthCheckNodePort(service *corev1api.Service) error {
 			return errors.WithStack(err)
 		}
 
-		healthCheckNodePort, exist, err := unstructured.NestedFloat64(*appliedServiceUnstructured, "spec", "healthCheckNodePort")
+		healthCheckNodePortObj, exist, err := unstructured.NestedFieldNoCopy(*appliedServiceUnstructured, "spec", "healthCheckNodePort")
 		if err != nil {
 			return errors.WithStack(err)
 		}
 
-		// Found healthCheckNodePort in lastAppliedConfig annotation,
-		// and the value is not 0. No need to delete, return.
-		if exist && healthCheckNodePort != 0 {
-			return nil
+		// A missing or null healthCheckNodePort means the user did not specify
+		// an explicit port, so fall through and treat it as auto-assigned.
+		if exist && healthCheckNodePortObj != nil {
+			healthCheckNodePort, ok := healthCheckNodePortObj.(float64)
+			if !ok {
+				return errors.Errorf(".spec.healthCheckNodePort accessor error: %v is of the type %T, expected float64", healthCheckNodePortObj, healthCheckNodePortObj)
+			}
+
+			// Found healthCheckNodePort in lastAppliedConfig annotation,
+			// and the value is not 0. No need to delete, return.
+			if healthCheckNodePort != 0 {
+				return nil
+			}
 		}
 	}
 
