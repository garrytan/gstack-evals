+// validateNoDotSegments rejects paths containing "." or ".." segments (including
+// percent-encoded or backslash-separated variants), which could otherwise be
+// used to traverse outside of the operator-configured path scope.
+func validateNoDotSegments(u *url.URL) error {
+	candidates := []string{u.Path, u.EscapedPath(), u.Opaque}
+	for _, c := range candidates {
+		// Unescape repeatedly to catch double-encoded dot segments.
+		for i := 0; i < 3; i++ {
+			for _, seg := range strings.FieldsFunc(c, func(r rune) bool { return r == '/' || r == '\\' }) {
+				if seg == "." || seg == ".." {
+					return fmt.Errorf("path must not contain dot segments")
+				}
+			}
+			unescaped, err := url.PathUnescape(c)
+			if err != nil || unescaped == c {
+				break
+			}
+			c = unescaped
+		}
+	}
+	return nil
+}
