diff --git a/tests/unit/classes/node_helper_spec.js b/tests/unit/classes/node_helper_spec.js
new file mode 100644
index 0000000..a29c2e3
--- /dev/null
+++ b/tests/unit/classes/node_helper_spec.js
@@ -0,0 +1,44 @@
+const NodeHelper = require("../../../js/node_helper");
+
+describe("NodeHelper socket dispatcher", () => {
+	let originalConfig;
+
+	beforeEach(() => {
+		originalConfig = global.config;
+		process.env.SECRET_NODE_HELPER_TEST = "super-secret-value";
+	});
+
+	afterEach(() => {
+		global.config = originalConfig;
+		delete process.env.SECRET_NODE_HELPER_TEST;
+	});
+
+	const dispatch = (notification, payload) => {
+		const helper = new NodeHelper();
+		helper.setName("test");
+		const received = [];
+		helper.socketNotificationReceived = (n, p) => received.push({ n, p });
+		let onAny;
+		const fakeIo = {
+			of () {
+				return {
+					on (_ev, cb) {
+						cb({ onAny (fn) { onAny = fn; } });
+					}
+				};
+			}
+		};
+		helper.setSocketIO(fakeIo);
+		onAny(notification, payload);
+		return received;
+	};
+
+	it.each(["disabled", "allowWhitelist"])("does not expand secret placeholders in inbound payloads (cors=%s)", (cors) => {
+		global.config = { hideConfigSecrets: true, cors };
+		const payload = { instanceId: "**SECRET_NODE_HELPER_TEST**", nested: { url: "https://x/?k=**SECRET_NODE_HELPER_TEST**" } };
+		const received = dispatch("INIT", payload);
+		expect(received).toHaveLength(1);
+		expect(received[0].p).toStrictEqual(payload);
+		expect(JSON.stringify(received[0].p)).not.toContain("super-secret-value");
+	});
+});
