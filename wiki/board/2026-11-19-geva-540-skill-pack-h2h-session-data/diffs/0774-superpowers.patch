+#[test]
+fn parameter_used_in_clause_guard_is_not_inlined() {
+    assert_erl!(
+        "
+pub fn main() {
+  fn(x) {
+    case 1 {
+      _ if x -> 1
+      _ -> 2
+    }
+  }(True)
+}
+"
+    );
+}
+
+#[test]
+fn parameter_used_in_bit_array_size_pattern_is_not_inlined() {
+    assert_erl!(
+        "
+pub fn main(bits) {
+  fn(size) {
+    case bits {
+      <<_:size(size)>> -> 1
+      _ -> 2
+    }
+  }(8)
+}
+"
+    );
