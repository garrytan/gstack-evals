+#[test]
+fn inlined_parameter_in_record_update() {
+    assert_erl!(
+        ("gleam_stdlib", "gleam/result", RESULT_MODULE),
+        "
+import gleam/result
+
+pub type Config {
+  Config(host: String, ssl: Bool)
+}
+
+pub fn set_ssl(config: Config, value: Result(Bool, Nil)) {
+  use ssl <- result.map(value)
+  Config(..config, ssl:)
+}
