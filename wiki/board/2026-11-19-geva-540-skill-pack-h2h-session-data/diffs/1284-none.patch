diff --git a/pkg/verify/tlog_test.go b/pkg/verify/tlog_test.go
index 25859ae..ead40d7 100644
--- a/pkg/verify/tlog_test.go
+++ b/pkg/verify/tlog_test.go
@@ -16,6 +16,7 @@ package verify_test
 
 import (
 	"encoding/base64"
+	"encoding/hex"
 	"strings"
 	"testing"
 	"time"
@@ -196,6 +197,60 @@ func TestDuplicateTlogEntries(t *testing.T) {
 	assert.ErrorContains(t, err, "duplicate tlog entries found") // duplicate tlog entries should fail to verify
 }
 
+// sameLogMultiIndexEntity returns two validly signed entries from the same
+// log with different log indices, as a compromised log could produce.
+type sameLogMultiIndexEntity struct {
+	*ca.TestEntity
+	vs *ca.VirtualSigstore
+}
+
+func (e *sameLogMultiIndexEntity) TlogEntries() ([]*tlog.Entry, error) {
+	entries, err := e.TestEntity.TlogEntries()
+	if err != nil {
+		return nil, err
+	}
+	orig := entries[0]
+	logIndex := orig.LogIndex() + 1
+	payload := tlog.RekorPayload{
+		LogID:          hex.EncodeToString([]byte(orig.LogKeyID())),
+		IntegratedTime: orig.IntegratedTime().Unix(),
+		LogIndex:       logIndex,
+		Body:           orig.Body(),
+	}
+	set, err := e.vs.RekorSignPayload(payload)
+	if err != nil {
+		return nil, err
+	}
+	body, err := base64.StdEncoding.DecodeString(orig.Body().(string))
+	if err != nil {
+		return nil, err
+	}
+	second, err := tlog.NewEntry(body, orig.IntegratedTime().Unix(), logIndex, []byte(orig.LogKeyID()), set, nil) //nolint:staticcheck
+	if err != nil {
+		return nil, err
+	}
+	return append(entries, second), nil
+}
+
+func TestSameLogEntriesDoNotMeetMultiLogThreshold(t *testing.T) {
+	virtualSigstore, err := ca.NewVirtualSigstore()
+	assert.NoError(t, err)
+
+	statement := []byte(`{"_type":"https://in-toto.io/Statement/v0.1","predicateType":"customFoo","subject":[{"name":"subject","digest":{"sha256":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}}],"predicate":{}}`)
+	entity, err := virtualSigstore.Attest("foo@example.com", "issuer", statement)
+	assert.NoError(t, err)
+
+	e := &sameLogMultiIndexEntity{entity, virtualSigstore}
+
+	// both entries are individually valid
+	_, err = verify.VerifyTlogEntry(e, virtualSigstore, 1, true)
+	assert.NoError(t, err)
+
+	// but they come from a single log, so a threshold of 2 must not be met
+	_, err = verify.VerifyTlogEntry(e, virtualSigstore, 2, true)
+	assert.ErrorContains(t, err, "not enough verified log entries from transparency log")
+}
+
 type tooManyTlogEntriesEntity struct {
 	*ca.TestEntity
 }
