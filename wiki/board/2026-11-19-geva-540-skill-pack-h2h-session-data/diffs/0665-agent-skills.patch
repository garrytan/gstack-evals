+package templates
+
+import (
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/spf13/afero"
+
+	cfgv3 "sigs.k8s.io/kubebuilder/v4/pkg/config/v3"
+	"sigs.k8s.io/kubebuilder/v4/pkg/machinery"
+)
+
+func renderMakefile(boilerplatePath string) string {
+	fs := machinery.Filesystem{FS: afero.NewMemMapFs()}
+	cfg := cfgv3.New()
+	Expect(cfg.SetProjectName("project")).To(Succeed())
+	s := machinery.NewScaffold(fs, machinery.WithConfig(cfg))
+	Expect(s.Execute(&Makefile{BoilerplatePath: boilerplatePath})).To(Succeed())
+	content, err := afero.ReadFile(fs.FS, "Makefile")
+	Expect(err).NotTo(HaveOccurred())
+	return string(content)
+}
+
+var _ = Describe("Makefile", func() {
+	It("should pass the YEAR variable to controller-gen when a boilerplate is used", func() {
+		content := renderMakefile("hack/boilerplate.go.txt")
+		Expect(content).To(ContainSubstring("YEAR ?= $(shell date +%Y)"))
+		Expect(content).To(ContainSubstring(
+			`"$(CONTROLLER_GEN)" object:headerFile="hack/boilerplate.go.txt",year=$(YEAR) paths="./..."`))
+	})
+
+	It("should not define YEAR nor pass a header file when no boilerplate is used", func() {
+		content := renderMakefile("")
+		Expect(content).NotTo(ContainSubstring("YEAR ?="))
+		Expect(content).To(ContainSubstring(`"$(CONTROLLER_GEN)" object paths="./..."`))
+	})
+})
