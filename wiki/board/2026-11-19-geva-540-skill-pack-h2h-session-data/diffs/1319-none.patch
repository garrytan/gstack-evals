diff --git a/hugolib/security_allowcontent_test.go b/hugolib/security_allowcontent_test.go
new file mode 100644
index 0000000..3104cdf
--- /dev/null
+++ b/hugolib/security_allowcontent_test.go
@@ -0,0 +1,65 @@
+package hugolib
+
+import (
+	"strings"
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+)
+
+func TestSecurityAllowContentHTML(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert(1)</script>
+-- layouts/all.html --
+{{ .Content }}
+`
+	b, err := TestE(t, files)
+	qt.Assert(t, err, qt.IsNotNil)
+	qt.Assert(t, err.Error(), qt.Contains, "security.allowContent")
+
+	b = Test(t, strings.Replace(files, "-- hugo.toml --\n", "-- hugo.toml --\n[security]\nallowContent = ['.*']\n", 1))
+	b.AssertFileContent("public/p1/index.html", "<script>alert(1)</script>")
+}
+
+func TestSecurityAllowContentHTMLContentAdapter(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/_content.gotmpl --
+{{ $.AddPage (dict "path" "p1" "title" "p1" "content" (dict "mediaType" "text/html" "value" "<script>alert(1)</script>")) }}
+{{ $.AddPage (dict "path" "p2" "title" "p2" "content" (dict "mediaType" "text/markdown" "value" "**md**")) }}
+-- layouts/all.html --
+{{ .Content }}
+`
+	_, err := TestE(t, files)
+	qt.Assert(t, err, qt.IsNotNil)
+	qt.Assert(t, err.Error(), qt.Contains, "security.allowContent")
+}
+
+func TestSecurityAllowContentMarkdownUnaffected(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/p1.md --
+---
+title: p1
+---
+**md**
+-- layouts/all.html --
+{{ .Content }}
+`
+	b := Test(t, files)
+	b.AssertFileContent("public/p1/index.html", "<strong>md</strong>")
+}
