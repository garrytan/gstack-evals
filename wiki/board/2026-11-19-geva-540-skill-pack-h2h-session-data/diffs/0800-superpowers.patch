+export function getClientHubId() {
+    const key = 'bb_client_hub_id';
+    let id = window[key];
+    if (id === void 0) {
+        id = (window.crypto && typeof window.crypto.randomUUID === 'function')
+            ? window.crypto.randomUUID()
+            : `${Date.now().toString(36)}${Math.random().toString(36).substring(2)}`;
+        window[key] = id;
+    }
+    return id;
+}
