@@ -0,0 +1,370 @@
+//! Last-resort `ctx_edit` matching for an `old_string` copied out of a lossy
+//! `ctx_read` view.
+//!
+//! `ctx_read` modes such as `aggressive` (which `auto` may also pick) strip
+//! blank lines and comment-only lines, halve space indentation and merge runs
+//! of closing braces (`}` + `}` → `}}`). An agent that copies `old_string` from
+//! that view can never match the file byte-for-byte, so the edit failed.
+//!
+//! This module matches on *significant* lines only — blank and comment-only
+//! lines are skipped on both sides (with the exact rules of
+//! [`crate::core::compressor::aggressive_compress`]) and each line is compared
+//! with its whitespace collapsed. A match is only accepted when it is unique
+//! and covers whole lines of the file. The replacement then:
+//!
+//! - keeps every unchanged line *verbatim* from the file,
+//! - keeps the stripped blank/comment lines inside the span, and
+//! - re-indents inserted/changed lines to the file's indentation style.
+
+/// One significant (non-skipped) unit of a text: the line index it comes from,
+/// and its whitespace-collapsed key.
+#[derive(Debug, Clone)]
+struct Unit {
+    line: usize,
+    key: String,
+}
+
+/// A successful loose match: the exact original span to replace and its
+/// replacement (both using the file's line separator).
+#[derive(Debug)]
+pub(crate) struct LooseMatch {
+    pub(crate) original: String,
+    pub(crate) replacement: String,
+}
+
+/// Closing tokens that `aggressive_compress` merges onto one line.
+const CLOSERS: [&str; 4] = ["});", "};", ");", "}"];
+
+/// Splits a line made up solely of closing tokens (e.g. `}}` or `});}`) into
+/// its tokens; returns `None` for any other line.
+fn split_closers(trimmed: &str) -> Option<Vec<&'static str>> {
+    let mut rest = trimmed;
+    let mut out = Vec::new();
+    while !rest.is_empty() {
+        let tok = CLOSERS.iter().find(|c| rest.starts_with(**c))?;
+        out.push(*tok);
+        rest = &rest[tok.len()..];
+    }
+    if out.is_empty() { None } else { Some(out) }
+}
+
+fn collapse_ws(s: &str) -> String {
+    s.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+/// Mirrors the line-skipping rules of `aggressive_compress`.
+struct SkipRules {
+    is_python: bool,
+    is_html: bool,
+    is_sql: bool,
+    is_shell: bool,
+}
+
+impl SkipRules {
+    fn new(ext: &str) -> Self {
+        Self {
+            is_python: ext == "py",
+            is_html: matches!(ext, "html" | "htm" | "xml" | "svg"),
+            is_sql: ext == "sql",
+            is_shell: matches!(ext, "sh" | "bash" | "zsh" | "fish"),
+        }
+    }
+
+    /// Classifies every line: `true` = stripped (blank or comment-only).
+    fn skipped(&self, lines: &[&str]) -> Vec<bool> {
+        let mut in_block = false;
+        lines
+            .iter()
+            .map(|line| {
+                let t = line.trim();
+                if t.is_empty() {
+                    return true;
+                }
+                if in_block {
+                    if t.contains("*/") || (self.is_html && t.contains("-->")) {
+                        in_block = false;
+                    }
+                    return true;
+                }
+                if t.starts_with("/*") || (self.is_html && t.starts_with("<!--")) {
+                    if !(t.contains("*/") || t.contains("-->")) {
+                        in_block = true;
+                    }
+                    return true;
+                }
+                (t.starts_with("//") && !t.starts_with("///"))
+                    || t.starts_with('*')
+                    || (self.is_python && t.starts_with('#'))
+                    || (self.is_sql && t.starts_with("--"))
+                    || (self.is_shell && t.starts_with('#') && !t.starts_with("#!"))
+                    || (!self.is_python && t.starts_with('#') && t.contains('['))
+            })
+            .collect()
+    }
+
+    fn units(&self, lines: &[&str]) -> Vec<Unit> {
+        let skipped = self.skipped(lines);
+        let mut out = Vec::new();
+        for (i, line) in lines.iter().enumerate() {
+            if skipped[i] {
+                continue;
+            }
+            let t = line.trim();
+            if let Some(toks) = split_closers(t) {
+                out.extend(toks.into_iter().map(|k| Unit {
+                    line: i,
+                    key: k.to_string(),
+                }));
+            } else {
+                out.push(Unit {
+                    line: i,
+                    key: collapse_ws(t),
+                });
+            }
+        }
+        out
+    }
+}
+
+fn indent_of(line: &str) -> &str {
+    &line[..line.len() - line.trim_start().len()]
+}
+
+/// Finds a unique, whole-line loose match of `old_str` in `content` and builds
+/// the replacement for `new_str`. Returns `None` when there is no match, or
+/// more than one (ambiguous edits are never applied loosely).
+pub(crate) fn find(content: &str, old_str: &str, new_str: &str, ext: &str) -> Option<LooseMatch> {
+    let rules = SkipRules::new(ext);
+    let sep = if content.contains("\r\n") { "\r\n" } else { "\n" };
+
+    let file_lines: Vec<&str> = content.lines().collect();
+    let old_norm = old_str.replace("\r\n", "\n");
+    let old_lines: Vec<&str> = old_norm.lines().collect();
+    let file_units = rules.units(&file_lines);
+    let needle = rules.units(&old_lines);
+    if needle.is_empty() || needle.len() > file_units.len() {
+        return None;
+    }
+
+    // Whole-line constraint: the match must start at the first unit of a file
+    // line and end at the last unit of a file line.
+    let starts_line = |i: usize| i == 0 || file_units[i - 1].line != file_units[i].line;
+    let ends_line = |i: usize| i + 1 == file_units.len() || file_units[i + 1].line != file_units[i].line;
+
+    let mut hit: Option<usize> = None;
+    for start in 0..=file_units.len() - needle.len() {
+        let end = start + needle.len() - 1;
+        if starts_line(start)
+            && ends_line(end)
+            && needle
+                .iter()
+                .zip(&file_units[start..=end])
+                .all(|(n, f)| n.key == f.key)
+        {
+            if hit.is_some() {
+                return None;
+            }
+            hit = Some(start);
+        }
+    }
+    let start = hit?;
+    let matched = &file_units[start..start + needle.len()];
+    let first_line = matched[0].line;
+    let last_line = matched[matched.len() - 1].line;
+
+    // Map each significant old_string line to the file lines it covers.
+    let mut old_groups: Vec<(String, usize, usize)> = Vec::new(); // (key, lo, hi)
+    let mut old_indent_pairs: Vec<(usize, String)> = Vec::new();
+    {
+        let mut i = 0;
+        while i < needle.len() {
+            let ol = needle[i].line;
+            let mut j = i;
+            while j + 1 < needle.len() && needle[j + 1].line == ol {
+                j += 1;
+            }
+            let lo = matched[i].line;
+            let hi = matched[j].line;
+            let key = needle[i..=j]
+                .iter()
+                .map(|u| u.key.as_str())
+                .collect::<Vec<_>>()
+                .join(" ");
+            old_groups.push((key, lo, hi));
+            if lo == hi {
+                let w = indent_of(old_lines[ol]).len();
+                old_indent_pairs.push((w, indent_of(file_lines[lo]).to_string()));
+            }
+            i = j + 1;
+        }
+    }
+
+    let new_norm = new_str.replace("\r\n", "\n");
+    let new_lines: Vec<&str> = new_norm.lines().collect();
+    let new_keys: Vec<String> = new_lines
+        .iter()
+        .map(|l| match split_closers(l.trim()) {
+            Some(toks) => toks.join(" "),
+            None => collapse_ws(l.trim()),
+        })
+        .collect();
+
+    // LCS alignment between significant old lines and new lines.
+    let (n, m) = (old_groups.len(), new_lines.len());
+    let mut lcs = vec![vec![0usize; m + 1]; n + 1];
+    for a in (0..n).rev() {
+        for b in (0..m).rev() {
+            lcs[a][b] = if old_groups[a].0 == new_keys[b] && !new_keys[b].is_empty() {
+                lcs[a + 1][b + 1] + 1
+            } else {
+                lcs[a + 1][b].max(lcs[a][b + 1])
+            };
+        }
+    }
+
+    // Diff ops from the LCS table.
+    let same = |a: usize, b: usize| old_groups[a].0 == new_keys[b] && !new_keys[b].is_empty();
+    let mut ops: Vec<Op> = Vec::new();
+    let (mut a, mut b) = (0, 0);
+    while a < n || b < m {
+        if a < n && b < m && same(a, b) {
+            ops.push(Op::Keep(a));
+            a += 1;
+            b += 1;
+        } else if a < n && (b >= m || lcs[a + 1][b] >= lcs[a][b + 1]) {
+            ops.push(Op::Del(a));
+            a += 1;
+        } else {
+            ops.push(Op::Ins(b));
+            b += 1;
+        }
+    }
+
+    let reindent = Reindent::new(&old_indent_pairs, content);
+    let mut out: Vec<String> = Vec::new();
+    let mut next_file_line = first_line;
+    let mut i = 0;
+    while i < ops.len() {
+        if let Op::Keep(a) = ops[i] {
+            // Unchanged: keep the file's lines verbatim (incl. stripped gaps).
+            let hi = old_groups[a].2;
+            out.extend(file_lines[next_file_line..=hi].iter().map(|s| (*s).to_string()));
+            next_file_line = hi + 1;
+            i += 1;
+            continue;
+        }
+        // A change hunk: pair removed and inserted lines positionally so a
+        // stripped comment above a rewritten line stays above its rewrite.
+        let mut dels = Vec::new();
+        let mut ins = Vec::new();
+        while i < ops.len() {
+            match ops[i] {
+                Op::Del(a) => dels.push(a),
+                Op::Ins(b) => ins.push(b),
+                Op::Keep(_) => break,
+            }
+            i += 1;
+        }
+        for k in 0..dels.len().max(ins.len()) {
+            if let Some(&a) = dels.get(k) {
+                let (_, lo, hi) = old_groups[a];
+                out.extend(file_lines[next_file_line..lo].iter().map(|s| (*s).to_string()));
+                next_file_line = hi + 1;
+            }
+            if let Some(&b) = ins.get(k) {
+                out.push(reindent.apply(new_lines[b]));
+            }
+        }
+    }
+    debug_assert_eq!(next_file_line, last_line + 1);
+
+    Some(LooseMatch {
+        original: file_lines[first_line..=last_line].join(sep),
+        replacement: out.join(sep),
+    })
+}
+
+#[derive(Clone, Copy)]
+enum Op {
+    Keep(usize),
+    Del(usize),
+    Ins(usize),
+}
+
+/// Translates indentation from the lossy view back to the file's style.
+struct Reindent {
+    exact: Vec<(usize, String)>,
+    unit: char,
+    scale: usize,
+}
+
+impl Reindent {
+    fn new(pairs: &[(usize, String)], content: &str) -> Self {
+        let unit = if pairs.iter().any(|(_, f)| f.starts_with('\t'))
+            || content.lines().any(|l| l.starts_with('\t'))
+        {
+            '\t'
+        } else {
+            ' '
+        };
+        // Infer the view→file width ratio from matched indented lines.
+        let scale = pairs
+            .iter()
+            .find(|(w, f)| *w > 0 && !f.is_empty() && f.chars().count() % *w == 0)
+            .map_or(1, |(w, f)| f.chars().count() / *w);
+        Self {
+            exact: pairs.to_vec(),
+            unit,
+            scale,
+        }
+    }
+
+    fn apply(&self, line: &str) -> String {
+        let body = line.trim_start();
+        if body.is_empty() {
+            return String::new();
+        }
+        let w = line.len() - body.len();
+        if let Some((_, f)) = self.exact.iter().find(|(pw, _)| *pw == w) {
+            return format!("{f}{body}");
+        }
+        let width = if self.unit == '\t' { w } else { w * self.scale };
+        format!("{}{body}", self.unit.to_string().repeat(width))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn split_closers_only_accepts_pure_closer_runs() {
+        assert_eq!(split_closers("}}"), Some(vec!["}", "}"]));
+        assert_eq!(split_closers("});}"), Some(vec!["});", "}"]));
+        assert_eq!(split_closers("} else {"), None);
+    }
+
+    #[test]
+    fn exact_text_without_stripped_lines_round_trips() {
+        let c = "a\n    b\nc\n";
+        let m = find(c, "  b", "  B", "rs").unwrap();
+        assert_eq!(m.original, "    b");
+        assert_eq!(m.replacement, "    B");
+    }
+
+    #[test]
+    fn deleted_line_keeps_preceding_comment() {
+        let c = "fn f() {\n    // note\n    drop_me();\n    keep();\n}\n";
+        let m = find(c, "  drop_me();\n  keep();", "  keep();", "rs").unwrap();
+        assert_eq!(m.original, "    drop_me();\n    keep();");
+        assert_eq!(m.replacement, "    keep();");
+    }
+
+    #[test]
+    fn crlf_file_keeps_crlf() {
+        let c = "x {\r\n\r\n    a();\r\n    b();\r\n}\r\n";
+        let m = find(c, "  a();\n  b();", "  a();\n  c();", "rs").unwrap();
+        assert_eq!(m.original, "    a();\r\n    b();");
+        assert_eq!(m.replacement, "    a();\r\n    c();");
+    }
+}
