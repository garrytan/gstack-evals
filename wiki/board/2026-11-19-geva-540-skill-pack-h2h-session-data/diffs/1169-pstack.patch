+++ b/tests/unit/classes/node_helper_spec.js
@@ -0,0 +1,25 @@
+const NodeHelper = require("../../../js/node_helper");
+
+describe("NodeHelper socket dispatcher", () => {
+	afterEach(() => {
+		delete process.env.SECRET_TEST;
+	});
+
+	it("passes secret placeholders through unchanged when hideConfigSecrets is enabled", () => {
+		global.config = { hideConfigSecrets: true, cors: "disabled" };
+		process.env.SECRET_TEST = "secret-value";
+
+		const helper = new NodeHelper();
+		helper.setName("test");
+		const received = [];
+		helper.socketNotificationReceived = (notification, payload) => received.push({ notification, payload });
+
+		let onAny;
+		const socket = { onAny: (fn) => { onAny = fn; } };
+		helper.setSocketIO({ of: () => ({ on: (_event, cb) => cb(socket) }) });
+
+		onAny("PING", { key: "**SECRET_TEST**" });
+
+		expect(received).toStrictEqual([{ notification: "PING", payload: { key: "**SECRET_TEST**" } }]);
+	});
+});
