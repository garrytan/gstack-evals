+/** fetch() that applies the origin fence to the initial URL and every redirect hop. */
+export async function fencedFetch(
+  url: string,
+  fence: FenceConfig = parseFenceEnv(),
+  fetchImpl: typeof fetch = fetch,
+): Promise<Response> {
+  let current = url;
+  for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
+    assertFenced(current, fence);
+    const res = await fetchImpl(current, { redirect: 'manual' });
+    const loc = res.headers.get('location');
+    if (res.status >= 300 && res.status < 400 && loc) {
+      current = new URL(loc, current).toString();
+      continue;
+    }
+    return res;
+  }
