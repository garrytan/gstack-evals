diff --git a/src/paths.ts b/src/paths.ts
new file mode 100644
index 0000000..f2708fc
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,34 @@
+import { isAbsolute, resolve, relative, sep, basename } from 'path';
+
+/**
+ * Resolve a caller-supplied relative path under `root`, rejecting absolute
+ * paths and any `..` escape. Used to keep MCP-supplied save_dir / state paths
+ * inside browse-mcp's own data directories (GHSA-m9mq-7m7q-xc6p).
+ */
+export function confinePath(root: string, userPath: string, label = 'path'): string {
+  const p = userPath.trim();
+  if (!p) return resolve(root);
+  // Reject POSIX/Windows absolute paths, drive-letter and UNC forms on any OS.
+  if (isAbsolute(p) || /^[A-Za-z]:/.test(p) || /^[\\/]/.test(p) || p.startsWith('~')) {
+    throw new Error(
+      `Invalid ${label} ${JSON.stringify(userPath)}: must be relative to ${root} (absolute paths are not allowed).`,
+    );
+  }
+  const rootAbs = resolve(root);
+  const full = resolve(rootAbs, p.replace(/\\/g, '/'));
+  const rel = relative(rootAbs, full);
+  if (rel === '..' || rel.startsWith('..' + sep) || rel.startsWith('../') || isAbsolute(rel)) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(userPath)}: escapes ${root}.`);
+  }
+  return full;
+}
+
+/** Reduce an untrusted filename to a safe bare basename. */
+export function safeFilename(name: string | undefined, fallback = 'download.bin'): string {
+  const base = basename((name ?? '').replace(/\\/g, '/'))
+    // eslint-disable-next-line no-control-regex
+    .replace(/[\x00-\x1f<>:"|?*]/g, '_')
+    .trim();
+  if (!base || base === '.' || base === '..') return fallback;
+  return base;
+}
