diff --git a/test/paths.test.ts b/test/paths.test.ts
new file mode 100644
index 0000000..46aac81
--- /dev/null
+++ b/test/paths.test.ts
@@ -0,0 +1,72 @@
+import { describe, it, expect } from 'vitest';
+import { join, resolve } from 'path';
+import { confinePath, safeFilename } from '../src/paths.js';
+import { fencedFetch } from '../src/download.js';
+
+const ROOT = resolve('/tmp/bmcp-root');
+
+describe('confinePath', () => {
+  it('resolves relative paths under the root', () => {
+    expect(confinePath(ROOT, 'a/b')).toBe(join(ROOT, 'a', 'b'));
+    expect(confinePath(ROOT, '')).toBe(ROOT);
+  });
+
+  it('rejects absolute paths', () => {
+    for (const p of [
+      '/etc',
+      '/home/u/.bashrc',
+      'C:/Windows',
+      'C:\\x',
+      '\\\\srv\\share',
+      '~/.bashrc',
+    ]) {
+      expect(() => confinePath(ROOT, p)).toThrow(/absolute/);
+    }
+  });
+
+  it('rejects .. escapes', () => {
+    for (const p of ['..', '../x', 'a/../../x', '..\\..\\x']) {
+      expect(() => confinePath(ROOT, p)).toThrow(/escapes/);
+    }
+  });
+});
+
+describe('safeFilename', () => {
+  it('strips directories and traversal', () => {
+    expect(safeFilename('../../.bashrc')).toBe('.bashrc');
+    expect(safeFilename('a\\..\\b.txt')).toBe('b.txt');
+    expect(safeFilename('/etc/cron.d/x')).toBe('x');
+    expect(safeFilename('..')).toBe('download.bin');
+    expect(safeFilename('')).toBe('download.bin');
+  });
+});
+
+describe('fencedFetch', () => {
+  const fence = { allowed: ['good.com'], blocked: [] };
+
+  it('refuses a URL outside the allowlist without fetching', async () => {
+    let called = false;
+    const f = (async () => {
+      called = true;
+      return new Response('x');
+    }) as typeof fetch;
+    await expect(fencedFetch('https://evil.com/x', fence, f)).rejects.toThrow(/origin fence/);
+    expect(called).toBe(false);
+  });
+
+  it('refuses a redirect to a fenced origin', async () => {
+    const seen: string[] = [];
+    const f = (async (u: string) => {
+      seen.push(String(u));
+      return new Response(null, { status: 302, headers: { location: 'https://evil.com/p' } });
+    }) as unknown as typeof fetch;
+    await expect(fencedFetch('https://good.com/x', fence, f)).rejects.toThrow(/origin fence/);
+    expect(seen).toEqual(['https://good.com/x']);
+  });
+
+  it('allows permitted origins', async () => {
+    const f = (async () => new Response('ok')) as unknown as typeof fetch;
+    const res = await fencedFetch('https://docs.good.com/x', fence, f);
+    expect(await res.text()).toBe('ok');
+  });
+});
