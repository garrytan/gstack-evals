+using NAudio.Wave;
+using NUnit.Framework;
+
+namespace NAudio.Core.Tests.WaveStreams;
+
+[TestFixture]
+public class WaveBufferTests
+{
+    [Test]
+    public void CopyToFloatArrayCopiesRawSamples()
+    {
+#pragma warning disable CS0618 // WaveBuffer is obsolete but still public
+        var waveBuffer = new WaveBuffer(16);
+        var source = new[] { 0.25f, -0.5f, 0.75f, 1f };
+        System.Buffer.BlockCopy(source, 0, waveBuffer.ByteBuffer, 0, 16);
+        waveBuffer.ByteBufferCount = 16;
+#pragma warning restore CS0618
+
+        var dest = new float[4];
+        waveBuffer.Copy(dest);
+
+        Assert.That(dest, Is.EqualTo(source));
+    }
+}
