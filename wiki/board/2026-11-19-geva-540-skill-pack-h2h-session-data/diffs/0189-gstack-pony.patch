@@ -222,7 +222,10 @@ public class WaveBuffer : IWaveBuffer
     /// </summary>
     public void Copy(Array destinationArray)
     {
-        Array.Copy(byteBuffer, destinationArray, numberOfBytes);
+        // Raw byte copy: Array.Copy would widen each byte into a separate element when the
+        // destination is float[]/short[]/int[], and on .NET Core the aliased typed views report
+        // the byte element size, so element-based copies move only a fraction of the data.
+        Buffer.BlockCopy(byteBuffer, 0, destinationArray, 0, numberOfBytes);
     }
 
