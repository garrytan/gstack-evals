+    [Test]
+    public void MonoFileCopyToProducesFullLength()
+    {
+        // Mono WAV -> AudioFileReader -> Stream.CopyTo (issue: output was truncated to 1/4 on .NET Core)
+        var tmp = Path.Combine(Path.GetTempPath(), "naudio-copyto-test-" + Guid.NewGuid() + ".wav");
+        File.WriteAllBytes(tmp, Build16BitMonoPcmWav(sampleCount: 8000 * 16, sampleRate: 8000));
+        try
+        {
+            using var reader = new AudioFileReader(tmp);
+            var output = new MemoryStream();
+            reader.CopyTo(output);
+            Assert.That(output.Length, Is.EqualTo(8000 * 16 * 4));
+            Assert.That(output.Length, Is.EqualTo(reader.Length));
+        }
+        finally
+        {
+            File.Delete(tmp);
+        }
+    }
+
