+// metricsMethodLabel clamps the client-controlled method to a fixed set so
+// arbitrary methods cannot create unbounded Prometheus series.
+func metricsMethodLabel(method string) string {
+	if _, ok := metricsMethods[method]; ok {
+		return method
+	}
+	return "other"
