+
+func TestListBacktickDescription(t *testing.T) {
+	stdout := &bytes.Buffer{}
+	stderr := &bytes.Buffer{}
+	inv := Invocation{
+		Dir:    "./testdata/backtick_description",
+		Stdout: stdout,
+		Stderr: stderr,
+		List:   true,
+	}
+
+	code := Invoke(inv)
+	if code != 0 {
+		t.Fatalf("expected to exit with code 0, but got %v, stderr: %s", code, stderr)
+	}
+	actual := stdout.String()
+	expected := "This is a magefile, to be called with `go tool mage` (github.com/magefile/mage).\n\nTargets:\n  build    does a build.\n"
+	if actual != expected {
+		t.Fatalf("expected:\n%q\n\ngot:\n%q", expected, actual)
+	}
+}
