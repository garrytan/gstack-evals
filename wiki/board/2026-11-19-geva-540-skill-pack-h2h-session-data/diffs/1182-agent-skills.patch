diff --git a/packages/mcp-tools/src/utils/tools.ts b/packages/mcp-tools/src/utils/tools.ts
index 8b36540..ed3ae65 100644
--- a/packages/mcp-tools/src/utils/tools.ts
+++ b/packages/mcp-tools/src/utils/tools.ts
@@ -47,3 +47,40 @@ export function createClientConfig(config: ContentfulConfig): ClientOptions {
 
   return clientConfig;
 }
+
+/**
+ * Option keys accepted by contentful-export / contentful-import (and the
+ * underlying contentful-management client) that control where requests are
+ * sent or how they are transported. These must only ever come from trusted
+ * server configuration, never from tool-call arguments: otherwise a caller
+ * (or prompt-injected content) could redirect requests carrying the server's
+ * management token to an attacker-controlled endpoint.
+ */
+const UNSAFE_NETWORK_OPTION_KEYS = [
+  'host',
+  'hostDelivery',
+  'hostUpload',
+  'port',
+  'basePath',
+  'baseURL',
+  'insecure',
+  'proxy',
+  'rawProxy',
+  'httpAgent',
+  'httpsAgent',
+  'config',
+] as const;
+
+/**
+ * Returns a shallow copy of `options` with all network/transport-related
+ * keys removed (see UNSAFE_NETWORK_OPTION_KEYS).
+ */
+export function stripUnsafeNetworkOptions<T extends object>(
+  options: T,
+): Omit<T, (typeof UNSAFE_NETWORK_OPTION_KEYS)[number]> {
+  const safe: Record<string, unknown> = { ...options };
+  for (const key of UNSAFE_NETWORK_OPTION_KEYS) {
+    delete safe[key];
+  }
+  return safe as Omit<T, (typeof UNSAFE_NETWORK_OPTION_KEYS)[number]>;
+}
