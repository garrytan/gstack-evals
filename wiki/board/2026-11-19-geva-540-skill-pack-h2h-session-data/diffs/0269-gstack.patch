+
+var (
+	fmtWrapErrorType  = reflect.TypeOf(fmt.Errorf("%w", errors.New("")))
+	fmtWrapErrorsType = reflect.TypeOf(fmt.Errorf("%w %w", errors.New(""), errors.New("")))
+)
+
+// unwrapFmt returns the first error in the chain of err that is not a wrapping
+// error created by [fmt.Errorf]. Errors wrapping multiple errors are only
+// unwrapped if they wrap exactly one non-nil error.
+func unwrapFmt(err error) error {
+	for err != nil {
+		var next error
+		switch reflect.TypeOf(err) {
+		case fmtWrapErrorType:
+			next = errors.Unwrap(err)
+		case fmtWrapErrorsType:
+			if u, ok := err.(interface{ Unwrap() []error }); ok {
+				var n int
+				for _, e := range u.Unwrap() {
+					if e != nil {
+						next = e
+						n++
+					}
+				}
+				if n != 1 {
+					next = nil
+				}
+			}
+		}
+		if next == nil {
+			return err
+		}
+		err = next
+	}
+	return err
+}
