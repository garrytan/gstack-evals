+    static final class BinaryTypesTest extends RowCompactedSerializerTest {
+        public BinaryTypesTest() {
+            super(getRowSerializer(), getData());
+        }
+
+        private static InternalRow[] getData() {
+            return new GenericRow[] {
+                GenericRow.of(null, null),
+                GenericRow.of(new byte[] {1, 2}, new byte[] {(byte) 0xFF})
+            };
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(
+                    RowType.of(DataTypes.BINARY(2), DataTypes.VARBINARY(10)));
+        }
+
+        @Test
+        public void testSliceComparatorWithBinaryType() {
+            RowCompactedSerializer serializer = getRowSerializer();
+            Comparator<MemorySlice> comparator = serializer.createSliceComparator();
+            MemorySlice s1 =
+                    MemorySlice.wrap(
+                            serializer.serializeToBytes(
+                                    GenericRow.of(new byte[] {1, 2}, new byte[] {1})));
+            MemorySlice s2 =
+                    MemorySlice.wrap(
+                            serializer.serializeToBytes(
+                                    GenericRow.of(new byte[] {1, 2}, new byte[] {(byte) 0xFF})));
+            MemorySlice s3 =
+                    MemorySlice.wrap(
+                            serializer.serializeToBytes(
+                                    GenericRow.of(new byte[] {1, 2}, new byte[] {1, 0})));
+            // unsigned lexicographic: 0x01 < 0x01 0x00 < 0xFF
+            assertThat(comparator.compare(s1, s2)).isNegative();
+            assertThat(comparator.compare(s1, s3)).isNegative();
+            assertThat(comparator.compare(s3, s2)).isNegative();
+            assertThat(comparator.compare(s2, s2)).isZero();
+        }
+    }
