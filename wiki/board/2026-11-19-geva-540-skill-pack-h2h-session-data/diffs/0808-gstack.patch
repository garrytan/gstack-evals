+<script>
+	class MyStore {
+		items = $state([{ value: 'a' }]);
+
+		update = (x) => {
+			this.items = this.items.map(() => ({ value: x }));
+		};
+	}
+
+	const store = new MyStore();
+</script>
+
+{#each store.items as obj}
+	<p>{obj.value}</p>
+	<input bind:value={() => obj.value, (x) => store.update(x)} />
+{/each}
