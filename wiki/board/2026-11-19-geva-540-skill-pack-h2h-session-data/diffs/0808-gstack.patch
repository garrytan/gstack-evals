+---
+'svelte': patch
+---
+
+fix: update focused input if binding getter returns a stale value after setting
diff --git a/packages/svelte/src/internal/client/dom/elements/bindings/input.js b/packages/svelte/src/internal/client/dom/elements/bindings/input.js
index 67e6ff1..dafeeeb 100644
--- a/packages/svelte/src/internal/client/dom/elements/bindings/input.js
+++ b/packages/svelte/src/internal/client/dom/elements/bindings/input.js
@@ -39,6 +39,13 @@ export function bind_value(input, get, set = get) {
 		// In runes mode, respect any validation in accessors (doesn't apply in legacy mode,
 		// because we use mutable state which ensures the render effect always runs)
 		if (runes && value !== (value = get())) {
+			// The getter may return a stale value (e.g. if it depends on an each block item
+			// that is only updated once effects flush), so allow the render effect to
+			// update the input with the final value
+			if (current_batch !== null) {
+				batches.delete(current_batch);
+			}
+
 			var start = input.selectionStart;
 			var end = input.selectionEnd;
 
