+    [Fact]
+    public Task IncludesMultipleInterfaceConfigs()
+    {
+        var source = TestSourceBuilder.MapperWithBodyAndTypes(
+            """
+            [MapProperty(nameof(IAudit.CreatedBy), nameof(IAuditDto.Creator))]
+            partial void MapAudit(IAudit source, IAuditDto target);
+
+            [MapProperty(nameof(IOwnable.Owner), nameof(IOwnableDto.OwnerName))]
+            partial void MapOwnable(IOwnable source, IOwnableDto target);
+
+            [IncludeMappingConfiguration(nameof(MapAudit))]
+            [IncludeMappingConfiguration(nameof(MapOwnable))]
+            partial HouseDto Map(House house);
+            """,
+            "interface IAudit { string CreatedBy { get; } }",
+            "interface IOwnable { string Owner { get; } }",
+            "interface IAuditDto { string Creator { set; } }",
+            "interface IOwnableDto { string OwnerName { set; } }",
+            "class House : IAudit, IOwnable { public string CreatedBy { get; set; } public string Owner { get; set; } }",
+            "class HouseDto : IAuditDto, IOwnableDto { public string Creator { get; set; } public string OwnerName { get; set; } }"
+        );
+
+        return TestHelper.VerifyGenerator(source);
+    }
+
+    [Fact]
+    public void IncludesSameConfigTransitivelyWithoutCircularReference()
+    {
+        var source = TestSourceBuilder.MapperWithBodyAndTypes(
+            """
+            [MapProperty(nameof(A.Value), nameof(B.Value2))]
+            partial B MapBase(A a);
+
+            [IncludeMappingConfiguration(nameof(MapBase))]
+            partial B MapOther(A a);
+
+            [IncludeMappingConfiguration(nameof(MapBase))]
+            [IncludeMappingConfiguration(nameof(MapOther))]
+            partial B Map(A a);
+            """,
+            "class A { public string Value { get; set; } }",
+            "class B { public string Value2 { get; set; } }"
+        );
+
+        TestHelper
+            .GenerateMapper(source)
+            .Should()
+            .HaveMethodBody(
+                "Map",
+                """
+                var target = new global::B();
+                target.Value2 = a.Value;
+                return target;
+                """
+            );
+    }
+
