diff --git a/plugin/aa55udp_test.go b/plugin/aa55udp_test.go
index a617a6f..957b063 100644
--- a/plugin/aa55udp_test.go
+++ b/plugin/aa55udp_test.go
@@ -3,6 +3,7 @@ package plugin
 import (
 	"encoding/binary"
 	"encoding/hex"
+	"math"
 	"net"
 	"testing"
 
@@ -159,7 +160,43 @@ func TestDecodeAt_TooShort(t *testing.T) {
 }
 
 func TestDecodeAt_UnknownType(t *testing.T) {
-	_, err := decodeAt(make([]byte, 4), 0, "float32")
+	_, err := decodeAt(make([]byte, 4), 0, "float64")
+	require.Error(t, err)
+}
+
+// GoodWe ET meter energy registers (36015-36018) are IEEE-754 float32 values.
+func TestDecodeAt_Float32BE(t *testing.T) {
+	for _, decode := range []string{"float32", "float32be"} {
+		payload := make([]byte, 4)
+		binary.BigEndian.PutUint32(payload, math.Float32bits(12345.5))
+		v, err := decodeAt(payload, 0, decode)
+		require.NoError(t, err, decode)
+		assert.InDelta(t, 12345.5, v, 0, decode)
+	}
+}
+
+func TestDecodeAt_Float32BE_TooShort(t *testing.T) {
+	_, err := decodeAt([]byte{0x00, 0x01}, 0, "float32")
+	require.Error(t, err)
+}
+
+// TestNewAA55UDPFromConfig_Decodes verifies every decode used by the
+// goodwe-wifi-* templates is accepted (regression: float32 was rejected).
+func TestNewAA55UDPFromConfig_Decodes(t *testing.T) {
+	for _, decode := range []string{"int32be", "uint32be", "int16be", "uint16be", "float32", "float32be"} {
+		_, err := NewAA55UDPFromConfig(t.Context(), map[string]any{
+			"host":     "127.0.0.1",
+			"register": 36017,
+			"count":    2,
+			"decode":   decode,
+		})
+		require.NoError(t, err, decode)
+	}
+
+	_, err := NewAA55UDPFromConfig(t.Context(), map[string]any{
+		"host":   "127.0.0.1",
+		"decode": "bogus",
+	})
 	require.Error(t, err)
 }
 
