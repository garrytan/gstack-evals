+// launchesGoroutineWithWgDone returns true if the given statement is either
+// a go statement running a function literal that calls wg.Done, or
+// a loop (for or range) whose body contains such a go statement as a top-level statement.
+func (w *lintUseWaitGroupGo) launchesGoroutineWithWgDone(stmt ast.Stmt) bool {
+	var loopBody *ast.BlockStmt
+	switch s := stmt.(type) {
+	case *ast.GoStmt:
+		return w.hasCallToWgDone(s)
+	case *ast.RangeStmt:
+		loopBody = s.Body
+	case *ast.ForStmt:
+		loopBody = s.Body
+	default:
+		return false
+	}
+
+	for _, bodyStmt := range loopBody.List {
+		goStmt, ok := bodyStmt.(*ast.GoStmt)
+		if ok && w.hasCallToWgDone(goStmt) {
+			return true
+		}
+	}
+
+	return false
+}
+
