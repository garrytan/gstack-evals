+func Test_applyFieldOverriders_EmptyPatchRejected(t *testing.T) {
+	const original = `{"key":"value"}`
+	configmapObj, _ := utilhelper.ToUnstructured(helper.NewConfigMap(metav1.NamespaceDefault, "test1", map[string]string{
+		"test.json": original,
+	}))
+
+	err := applyFieldOverriders(configmapObj, []policyv1alpha1.FieldOverrider{{FieldPath: "/data/test.json"}})
+	if err == nil {
+		t.Fatal("applyFieldOverriders() expected error for FieldOverrider without YAML or JSON")
+	}
+	wantData := map[string]any{"test.json": original}
+	if !reflect.DeepEqual(configmapObj.Object["data"], wantData) {
+		t.Errorf("applyFieldOverriders() gotData = %v, wantData %v", configmapObj.Object["data"], wantData)
+	}
+}
