diff --git a/pkg/utils/root.go b/pkg/utils/root.go
new file mode 100644
index 0000000..ccabdfc
--- /dev/null
+++ b/pkg/utils/root.go
@@ -0,0 +1,65 @@
+// SPDX-FileCopyrightText: The Fission Authors
+//
+// SPDX-License-Identifier: Apache-2.0
+
+package utils
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// RootJoin joins an untrusted relative name onto root, rejecting any name that
+// is empty, absolute, or would climb out of root via "..".
+func RootJoin(root, name string) (string, error) {
+	if root == "" {
+		return "", errors.New("invalid root directory")
+	}
+	if !filepath.IsLocal(name) {
+		return "", fmt.Errorf("path %q is not local to %s", name, root)
+	}
+	return filepath.Join(root, name), nil
+}
+
+func withRoot(root string, fn func(*os.Root) error) error {
+	r, err := os.OpenRoot(root)
+	if err != nil {
+		return err
+	}
+	defer r.Close()
+	return fn(r)
+}
+
+// RootStat stats name inside root without following symlinks out of root.
+func RootStat(root, name string) (os.FileInfo, error) {
+	var fi os.FileInfo
+	err := withRoot(root, func(r *os.Root) error {
+		var err error
+		fi, err = r.Stat(name)
+		return err
+	})
+	return fi, err
+}
+
+// RootMkdirAll creates name and any missing parents inside root.
+func RootMkdirAll(root, name string, perm os.FileMode) error {
+	return withRoot(root, func(r *os.Root) error {
+		return r.MkdirAll(name, perm)
+	})
+}
+
+// RootWriteFile writes data to name inside root.
+func RootWriteFile(root, name string, data []byte, perm os.FileMode) error {
+	return withRoot(root, func(r *os.Root) error {
+		return r.WriteFile(name, data, perm)
+	})
+}
+
+// RootRename renames oldname to newname, both inside root.
+func RootRename(root, oldname, newname string) error {
+	return withRoot(root, func(r *os.Root) error {
+		return r.Rename(oldname, newname)
+	})
+}
diff --git a/pkg/utils/root_test.go b/pkg/utils/root_test.go
new file mode 100644
index 0000000..9dc759a
--- /dev/null
+++ b/pkg/utils/root_test.go
@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: The Fission Authors
+//
+// SPDX-License-Identifier: Apache-2.0
+
+package utils
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestRootJoin(t *testing.T) {
+	t.Parallel()
+	root := "/packages"
+
+	got, err := RootJoin(root, "pkg-abc")
+	require.NoError(t, err)
+	assert.Equal(t, "/packages/pkg-abc", got)
+
+	got, err = RootJoin(root, "ns/name")
+	require.NoError(t, err)
+	assert.Equal(t, "/packages/ns/name", got)
+
+	for _, name := range []string{
+		"",
+		"../packages-extra/evil",
+		"../etc/passwd",
+		"a/../../b",
+		"/packages-extra/evil",
+		"/packages/evil",
+		"..",
+	} {
+		_, err := RootJoin(root, name)
+		assert.Error(t, err, "name %q must be rejected", name)
+	}
+
+	_, err = RootJoin("", "pkg")
+	assert.Error(t, err, "empty root must be rejected")
+}
+
+func TestRootOpsStayInsideRoot(t *testing.T) {
+	t.Parallel()
+	parent := t.TempDir()
+	root := filepath.Join(parent, "packages")
+	sibling := filepath.Join(parent, "packages-extra")
+	require.NoError(t, os.Mkdir(root, 0o750))
+	require.NoError(t, os.Mkdir(sibling, 0o750))
+	require.NoError(t, os.WriteFile(filepath.Join(sibling, "secret"), []byte("s"), 0o600))
+	require.NoError(t, os.Symlink(sibling, filepath.Join(root, "link")))
+
+	require.Error(t, RootWriteFile(root, "../packages-extra/evil", []byte("x"), 0o600))
+	require.Error(t, RootWriteFile(root, "link/evil", []byte("x"), 0o600), "symlink escape must be refused")
+	_, err := os.Stat(filepath.Join(sibling, "evil"))
+	assert.True(t, os.IsNotExist(err), "nothing written into the sibling directory")
+
+	_, err = RootStat(root, "../packages-extra/secret")
+	assert.Error(t, err)
+	_, err = RootStat(root, "link/secret")
+	assert.Error(t, err, "symlink escape must be refused")
+
+	require.Error(t, RootMkdirAll(root, "../packages-extra/dir", 0o750))
+	require.Error(t, RootRename(root, "../packages-extra/secret", "stolen"))
+
+	require.NoError(t, RootMkdirAll(root, "ns/name", 0o750))
+	require.NoError(t, RootWriteFile(root, "ns/name/key", []byte("v"), 0o600))
+	require.NoError(t, RootRename(root, "ns/name/key", "ns/name/key2"))
+	fi, err := RootStat(root, "ns/name/key2")
+	require.NoError(t, err)
+	assert.Equal(t, int64(1), fi.Size())
+}
