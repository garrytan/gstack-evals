+TEST_F(BuildTest, DyndepReadyDepfileDependsOnDyndepOutput) {
+  // A depfile-discovered input that is an implicit output of a dyndep
+  // edge reached later (via an order-only input) must still be dirty.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out\n"
+"rule cc\n"
+"  command = cc $out\n"
+"  depfile = $out.d\n"
+"build stamp: touch in || stamp.dd\n"
+"  dyndep = stamp.dd\n"
+"build copy: cc || stamp\n"
+));
+  fs_.Create("stamp.dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+);
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Create("other", "");
+  fs_.Create("stamp", "");
+  fs_.Create("copy", "");
+  fs_.Tick();
+  fs_.Create("in", "");
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("copy", &err));
+  ASSERT_EQ("", err);
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch stamp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("cc copy", command_runner_.commands_ran_[1]);
+}
