+    if (!isValidPhoneNumber(value)) {
       throw createGraphQLError(
         `Value is not a valid phone number of the form +17895551234 (7-15 digits): ${value}`,
       );
@@ -45,7 +55,7 @@ export const GraphQLPhoneNumber = /*#__PURE__*/ new GraphQLScalarType({
       );
     }
 
