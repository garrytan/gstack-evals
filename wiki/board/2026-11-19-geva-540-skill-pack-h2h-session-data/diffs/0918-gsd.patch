diff --git a/tests/PhoneNumber.test.ts b/tests/PhoneNumber.test.ts
index e26c8e7..e468501 100644
--- a/tests/PhoneNumber.test.ts
+++ b/tests/PhoneNumber.test.ts
@@ -137,4 +137,32 @@ describe('PhoneNumber', () => {
       });
     });
   });
+
+  describe('ReDoS (GHSA-x8rm-f576-gq67)', () => {
+    const payloads = [
+      '1'.repeat(40) + 'x',
+      '+' + '1'.repeat(40) + 'x',
+      '+1 ' + '1 '.repeat(20) + 'x',
+      '+1-' + '1-'.repeat(20) + 'x',
+      '+1 (' + '1'.repeat(40) + 'x',
+      '+' + '1'.repeat(1_000_000) + 'x',
+    ];
+    const expectFast = (fn: () => unknown) => {
+      const start = performance.now();
+      expect(fn).toThrow(/^Value is not a valid phone number/);
+      expect(performance.now() - start).toBeLessThan(100);
+    };
+
+    test.each(payloads)('serialize rejects quickly (%#)', payload => {
+      expectFast(() => GraphQLPhoneNumber.serialize(payload));
+    });
+
+    test.each(payloads)('parseValue rejects quickly (%#)', payload => {
+      expectFast(() => GraphQLPhoneNumber.parseValue(payload));
+    });
+
+    test.each(payloads)('parseLiteral rejects quickly (%#)', payload => {
+      expectFast(() => GraphQLPhoneNumber.parseLiteral({ value: payload, kind: Kind.STRING }, {}));
+    });
+  });
 });
