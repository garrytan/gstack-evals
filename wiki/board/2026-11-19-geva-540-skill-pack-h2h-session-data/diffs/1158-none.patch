+	// must never produce an endpoint selector. Otherwise, the cluster
+	// selector below would instantiate a pod selector which, combined with
+	// the namespace of the policy, would allow all workloads of the local
+	// namespace.
 	if peer == nil || (peer.PodSelector == nil && peer.NamespaceSelector == nil) {
 		return nil
 	}
