+    [Test]
+    public void TestDayLightSavingWithEndTimeOfDayDoesNotFireTwiceOnLongDay()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        // 2020-10-25 is a 25 hour day in CET (DST ends)
+        var startTime = new DateTimeOffset(2020, 10, 25, 0, 1, 5, TimeSpan.FromHours(2));
+        var trigger = (IOperableTrigger) TriggerBuilder.Create()
+            .WithIdentity("id")
+            .ForJob("job")
+            .StartAt(startTime)
+            .WithDailyTimeIntervalSchedule(x => x
+                .OnEveryDay()
+                .WithIntervalInHours(24)
+                .StartingDailyAt(new TimeOfDay(0, 1, 5))
+                .EndingDailyAt(new TimeOfDay(23, 59, 59))
+                .InTimeZone(timeZoneInfo)
+                .WithMisfireHandlingInstructionDoNothing())
+            .Build();
+
+        var rangeStart = new DateTimeOffset(2020, 10, 25, 0, 0, 0, TimeSpan.FromHours(2));
+        var fireTimes = TriggerUtils.ComputeFireTimesBetween(trigger, null, rangeStart, rangeStart.AddDays(3));
+
+        Assert.That(fireTimes, Is.EqualTo(new[]
+        {
+            new DateTimeOffset(2020, 10, 25, 0, 1, 5, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 10, 26, 0, 1, 5, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 10, 27, 0, 1, 5, TimeSpan.FromHours(1)),
+        }));
+    }
+
+    [Test]
+    public void TestDayLightSavingHourlyIntervalOnShortDay()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        var trigger = DailyTimeIntervalScheduleBuilder.Create()
+            .OnEveryDay()
+            .StartingDailyAt(new TimeOfDay(0, 0))
+            .WithIntervalInHours(1)
+            .InTimeZone(timeZoneInfo)
+            .Build();
+
+        // 2020-03-29 02:00 CET -> 03:00 CEST
+        var first = trigger.GetFireTimeAfter(new DateTimeOffset(2020, 3, 29, 1, 0, 0, TimeSpan.FromHours(1)));
+        Assert.That(first, Is.EqualTo(new DateTimeOffset(2020, 3, 29, 3, 0, 0, TimeSpan.FromHours(2))));
+        var second = trigger.GetFireTimeAfter(first);
+        Assert.That(second, Is.EqualTo(new DateTimeOffset(2020, 3, 29, 4, 0, 0, TimeSpan.FromHours(2))));
+    }
+
