+// checkCols provides a function to check the column range of the col
+// elements in the worksheet are valid or not.
+func (ws *xlsxWorksheet) checkCols() error {
+	if ws.Cols == nil {
+		return nil
+	}
+	for _, col := range ws.Cols.Col {
+		if col.Min < MinColumns || col.Min > MaxColumns ||
+			col.Max < MinColumns || col.Max > MaxColumns {
+			return ErrColumnNumber
+		}
+	}
+	return nil
+}
