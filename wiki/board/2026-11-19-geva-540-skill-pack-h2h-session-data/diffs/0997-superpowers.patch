+func TestColMaxAttributeOutOfRange(t *testing.T) {
+	for _, cols := range []string{
+		`<cols><col min="1" max="2147483647" width="9"/></cols>`,
+		`<cols><col min="0" max="1" width="9"/></cols>`,
+	} {
+		f := NewFile()
+		f.Sheet.Delete("xl/worksheets/sheet1.xml")
+		f.Pkg.Store("xl/worksheets/sheet1.xml", []byte(`<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">`+cols+`<sheetData/></worksheet>`))
+		f.checked = sync.Map{}
+		assert.Equal(t, ErrColumnNumber, f.SetColWidth("Sheet1", "A", "A", 12))
+	}
+	// flatCols must never expand beyond MaxColumns
+	fc := flatCols(xlsxCol{Min: 1, Max: 1}, []xlsxCol{{Min: 1, Max: 2147483647}}, func(fc, c xlsxCol) xlsxCol { return fc })
+	assert.Len(t, fc, MaxColumns)
+}
