 }
+
+// ensureIgnoredTables re-creates the dolt_ignore'd wisp tables (wisps,
+// wisp_labels, wisp_dependencies, wisp_events, wisp_comments) if they are
+// missing from the working set. Because these tables are ignored by Dolt they
+// are never committed, so they are absent after a clone, on a new branch, or
+// when a database was backfilled rather than migrated. The schema migrations
+// only create them once, so they must be recreated on every open — mirroring
+// createIgnoredTables in the server-mode DoltStore (GH#2271).
+//
+// Safe to call repeatedly; it is a no-op when all tables exist.
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	missing := map[string]bool{}
+	for _, tbl := range []string{"wisps", "wisp_labels", "wisp_dependencies", "wisp_events", "wisp_comments"} {
+		var n int
+		if err := tx.QueryRowContext(ctx,
+			"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?",
+			tbl).Scan(&n); err != nil {
+			return fmt.Errorf("checking %s table: %w", tbl, err)
+		}
+		if n == 0 {
+			missing[tbl] = true
+		}
+	}
+	if len(missing) == 0 {
+		return nil
+	}
+
+	// The ignore patterns must be in place before the tables are created.
+	if _, err := tx.ExecContext(ctx, "REPLACE INTO dolt_ignore VALUES ('wisps', true), ('wisp_%', true)"); err != nil {
+		return fmt.Errorf("adding wisp patterns to dolt_ignore: %w", err)
+	}
+
+	// wisps mirrors the issues table exactly (including columns added by later
+	// migrations such as no_history), so clone its current definition.
+	if missing["wisps"] {
+		if _, err := tx.ExecContext(ctx, "CREATE TABLE IF NOT EXISTS wisps LIKE issues"); err != nil {
+			return fmt.Errorf("creating wisps table: %w", err)
+		}
+	}
+
+	// Auxiliary tables: replay the wisp-specific migrations. 0021 is fully
+	// idempotent (CREATE TABLE IF NOT EXISTS); 0022 adds indexes to
+	// wisp_dependencies and is only safe when that table was just created.
+	files := []string{"0021_create_wisp_auxiliary.up.sql"}
+	if missing["wisp_dependencies"] {
+		files = append(files, "0022_wisp_dep_type_index.up.sql")
+	}
+	for _, name := range files {
+		data, err := upMigrations.ReadFile("schema/" + name)
+		if err != nil {
+			return fmt.Errorf("reading %s: %w", name, err)
+		}
+		if _, err := tx.ExecContext(ctx, string(data)); err != nil {
+			return fmt.Errorf("recreating wisp tables (%s): %w", name, err)
+		}
+	}
+	return nil
+}
