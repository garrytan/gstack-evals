+//go:build cgo
+
+package embeddeddolt_test
+
+import (
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/storage/embeddeddolt"
+	"github.com/steveyegge/beads/internal/types"
+)
+
+// TestIgnoredTablesRecreatedOnOpen verifies that the dolt_ignore'd wisp tables
+// are recreated when an embedded store is opened and they are missing from the
+// working set (e.g. fresh clone, new branch, or restored database). Without
+// this, bd dep add / bd delete fail with "table not found: wisp_dependencies".
+func TestIgnoredTablesRecreatedOnOpen(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	ctx := t.Context()
+
+	beadsDir := filepath.Join(t.TempDir(), ".beads")
+	dataDir := filepath.Join(beadsDir, "embeddeddolt")
+
+	store, err := embeddeddolt.New(ctx, beadsDir, "wt", "main")
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if err := store.SetConfig(ctx, "issue_prefix", "wt"); err != nil {
+		t.Fatalf("SetConfig: %v", err)
+	}
+	if err := store.Commit(ctx, "bd init"); err != nil {
+		t.Fatalf("Commit: %v", err)
+	}
+	store.Close()
+
+	// Simulate a working set without the ignored wisp tables.
+	db, cleanup, err := embeddeddolt.OpenSQL(ctx, dataDir, "wt", "main")
+	if err != nil {
+		t.Fatalf("OpenSQL: %v", err)
+	}
+	for _, tbl := range []string{"wisp_comments", "wisp_events", "wisp_labels", "wisp_dependencies", "wisps"} {
+		if _, err := db.ExecContext(ctx, "DROP TABLE IF EXISTS `"+tbl+"`"); err != nil {
+			t.Fatalf("drop %s: %v", tbl, err)
+		}
+	}
+	cleanup()
+
+	store, err = embeddeddolt.New(ctx, beadsDir, "wt", "main")
+	if err != nil {
+		t.Fatalf("reopen New: %v", err)
+	}
+	defer store.Close()
+
+	a := &types.Issue{ID: "wt-a", Title: "A", Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+	b := &types.Issue{ID: "wt-b", Title: "B", Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+	for _, iss := range []*types.Issue{a, b} {
+		if err := store.CreateIssue(ctx, iss, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", iss.ID, err)
+		}
+	}
+	dep := &types.Dependency{IssueID: "wt-b", DependsOnID: "wt-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency: %v", err)
+	}
+	if err := store.DeleteIssue(ctx, "wt-b"); err != nil {
+		t.Fatalf("DeleteIssue: %v", err)
+	}
+
+	// Wisps must work too (full schema, including later-added columns).
+	w := &types.Issue{ID: "wt-w", Title: "W", Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask, Ephemeral: true}
+	if err := store.CreateIssue(ctx, w, "tester"); err != nil {
+		t.Fatalf("CreateIssue wisp: %v", err)
+	}
+	if err := store.AddLabel(ctx, "wt-w", "x", "tester"); err != nil {
+		t.Fatalf("AddLabel wisp: %v", err)
+	}
+	wdep := &types.Dependency{IssueID: "wt-w", DependsOnID: "wt-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, wdep, "tester"); err != nil {
+		t.Fatalf("AddDependency wisp: %v", err)
+	}
+
+	// The recreated tables must remain dolt_ignore'd (never staged/committed).
+	db, cleanup, err = embeddeddolt.OpenSQL(ctx, dataDir, "wt", "main")
+	if err != nil {
+		t.Fatalf("OpenSQL: %v", err)
+	}
+	defer cleanup()
+	var tracked int
+	if err := db.QueryRowContext(ctx, "SELECT COUNT(*) FROM dolt_status WHERE table_name LIKE 'wisp%'").Scan(&tracked); err != nil {
+		t.Fatalf("dolt_status: %v", err)
+	}
+	if tracked != 0 {
+		t.Errorf("wisp tables appear in dolt_status (%d rows); expected them to be ignored", tracked)
+	}
+}
+
+// TestCycleDetectionWithoutWispDependencies verifies that cycle detection
+// degrades gracefully when wisp_dependencies is missing from the working set.
+func TestCycleDetectionWithoutWispDependencies(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	te := newTestEnv(t, "cw")
+	ctx := t.Context()
+
+	for _, id := range []string{"cw-a", "cw-b"} {
+		iss := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+		if err := te.store.CreateIssue(ctx, iss, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+	}
+
+	db, cleanup, err := embeddeddolt.OpenSQL(ctx, te.dataDir, te.database, "main")
+	if err != nil {
+		t.Fatalf("OpenSQL: %v", err)
+	}
+	if _, err := db.ExecContext(ctx, "DROP TABLE wisp_dependencies"); err != nil {
+		t.Fatalf("drop wisp_dependencies: %v", err)
+	}
+	cleanup()
+
+	if err := te.store.AddDependency(ctx, &types.Dependency{IssueID: "cw-a", DependsOnID: "cw-b", Type: types.DepBlocks}, "tester"); err != nil {
+		t.Fatalf("AddDependency: %v", err)
+	}
+	err = te.store.AddDependency(ctx, &types.Dependency{IssueID: "cw-b", DependsOnID: "cw-a", Type: types.DepBlocks}, "tester")
+	if err == nil || !strings.Contains(err.Error(), "cycle") {
+		t.Fatalf("expected cycle error, got %v", err)
+	}
+}
