+
+func TestIsTrustedIPUnixSocketDoesNotLogError(t *testing.T) {
+	tests := []struct {
+		name         string
+		trustedIPs   []string
+		reverseProxy bool
+	}{
+		{name: "NoTrustedIPs", trustedIPs: nil, reverseProxy: false},
+		{name: "TrustedIPsWithoutReverseProxy", trustedIPs: []string{"127.0.0.1"}, reverseProxy: false},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			opts := baseTestOptions()
+			opts.TrustedIPs = tt.trustedIPs
+			opts.ReverseProxy = tt.reverseProxy
+			assert.NoError(t, validation.Validate(opts))
+
+			proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+			assert.NoError(t, err)
+
+			var errBuf bytes.Buffer
+			logger.SetErrOutput(&errBuf)
+			defer logger.SetErrOutput(os.Stderr)
+
+			req := httptest.NewRequest("GET", "/", nil)
+			// RemoteAddr for requests received over a unix socket
+			req.RemoteAddr = "@"
+
+			assert.False(t, proxy.isTrustedIP(req))
+			assert.Empty(t, errBuf.String())
+		})
+	}
+}
