+// Creates the column definitions from the fields of a header line.
+func parseHeader(fields []string) []column {
+	columns := make([]column, 0, len(fields))
+	for _, s := range fields {
+		columns = append(columns, createColumn(s))
+	}
+	return columns
+}
+
+// Checks whether the given fields belong to a header line. Value lines only
+// contain numbers or dashes, while header lines contain column names.
+func isHeader(fields []string) bool {
+	for _, f := range fields {
+		if f == "-" {
+			continue
+		}
+		if _, err := strconv.ParseFloat(f, 64); err == nil {
+			return false
+		}
+		return true
+	}
+	return false
+}
