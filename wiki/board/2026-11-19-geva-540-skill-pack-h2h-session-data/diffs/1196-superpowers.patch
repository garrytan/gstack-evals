diff --git a/test/paths.test.ts b/test/paths.test.ts
new file mode 100644
index 0000000..2594c3e
--- /dev/null
+++ b/test/paths.test.ts
@@ -0,0 +1,38 @@
+import { describe, it, expect } from 'vitest';
+import { join, resolve } from 'path';
+import { confinePath, safeBasename } from '../src/paths.js';
+
+const ROOT = resolve('/tmp/browse-root');
+
+describe('confinePath', () => {
+  it('resolves relative paths under the root', () => {
+    expect(confinePath(ROOT, 'a/b')).toBe(join(ROOT, 'a', 'b'));
+    expect(confinePath(ROOT, '.')).toBe(ROOT);
+  });
+  it('rejects absolute paths', () => {
+    expect(() => confinePath(ROOT, '/home/u')).toThrow(/absolute/);
+    expect(() => confinePath(ROOT, 'C:\\Users')).toThrow(/absolute/);
+    expect(() => confinePath(ROOT, ROOT + '/x')).toThrow(/absolute/);
+  });
+  it('rejects traversal', () => {
+    expect(() => confinePath(ROOT, '..')).toThrow();
+    expect(() => confinePath(ROOT, 'a/../../x')).toThrow();
+    expect(() => confinePath(ROOT, 'a\\..\\..\\x')).toThrow();
+  });
+  it('rejects NUL bytes', () => {
+    expect(() => confinePath(ROOT, 'a\0b')).toThrow(/NUL/);
+  });
+});
+
+describe('safeBasename', () => {
+  it('strips directories', () => {
+    expect(safeBasename('../../.bashrc')).toBe('.bashrc');
+    expect(safeBasename('C:\\x\\evil.exe')).toBe('evil.exe');
+    expect(safeBasename('/etc/cron.d/job')).toBe('job');
+  });
+  it('falls back for empty or dot names', () => {
+    expect(safeBasename('')).toBe('download.bin');
+    expect(safeBasename('..')).toBe('download.bin');
+    expect(safeBasename('a/')).toBe('download.bin');
+  });
+});
