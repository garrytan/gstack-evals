diff --git a/src/paths.ts b/src/paths.ts
new file mode 100644
index 0000000..97c0d3b
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,42 @@
+import { isAbsolute, relative, resolve, sep, win32, posix } from 'path';
+
+/**
+ * Resolve a caller-supplied relative path under `root`, refusing anything that
+ * could escape it: absolute paths (POSIX or Windows-style, including drive
+ * letters and UNC), `..` segments, and NUL bytes. Returns the absolute path.
+ *
+ * MCP tool arguments are attacker-controllable (malicious client, or an agent
+ * steered by prompt injection), so filesystem paths must never be honored as-is.
+ */
+export function confinePath(root: string, userPath: string, label = 'path'): string {
+  if (typeof userPath !== 'string') throw new Error(`Invalid ${label}: must be a string`);
+  const p = userPath.trim();
+  if (p.includes('\0')) throw new Error(`Invalid ${label}: contains a NUL byte`);
+  if (isAbsolute(p) || posix.isAbsolute(p) || win32.isAbsolute(p) || /^[A-Za-z]:/.test(p)) {
+    throw new Error(
+      `Invalid ${label} ${JSON.stringify(userPath)}: absolute paths are not allowed; use a path relative to ${root}`,
+    );
+  }
+  if (p.split(/[\\/]+/).some((seg) => seg === '..')) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(userPath)}: ".." segments are not allowed`);
+  }
+  const base = resolve(root);
+  const full = resolve(base, p);
+  const rel = relative(base, full);
+  if (rel !== '' && (rel === '..' || rel.startsWith('..' + sep) || isAbsolute(rel))) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(userPath)}: escapes ${root}`);
+  }
+  return full;
+}
+
+/** Reduce an untrusted filename to a safe bare basename. */
+export function safeBasename(name: string | undefined, fallback = 'download.bin'): string {
+  let n = String(name ?? '').replace(/\0/g, '');
+  const parts = n.split(/[\\/]+/);
+  n = (parts[parts.length - 1] ?? '').trim();
+  // Strip Windows drive prefixes and control characters.
+  // eslint-disable-next-line no-control-regex
+  n = n.replace(/^[A-Za-z]:/, '').replace(/[\x00-\x1f]/g, '');
+  if (!n || n === '.' || n === '..' || /^\.+$/.test(n)) return fallback;
+  return n;
+}
