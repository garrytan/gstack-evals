diff --git a/tests/issues/GHnested-embeddable-null.test.ts b/tests/issues/GHnested-embeddable-null.test.ts
new file mode 100644
index 0000000..e460f0b
--- /dev/null
+++ b/tests/issues/GHnested-embeddable-null.test.ts
@@ -0,0 +1,49 @@
+import { MikroORM } from '@mikro-orm/sqlite';
+import { Embeddable, Embedded, Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';
+
+@Embeddable()
+class Geo {
+  @Property({ nullable: true })
+  lat?: number;
+}
+
+@Embeddable()
+class Address {
+  @Property({ nullable: true })
+  city?: string;
+
+  @Embedded(() => Geo, { nullable: true })
+  geo?: Geo | null;
+}
+
+@Entity()
+class User {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Address, { nullable: true })
+  address?: Address | null;
+}
+
+let orm: MikroORM;
+
+beforeAll(async () => {
+  orm = await MikroORM.init({ entities: [User], dbName: ':memory:', metadataProvider: ReflectMetadataProvider });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+
+test('nested inline embeddable with null parent', async () => {
+  const u = orm.em.create(User, { address: null });
+  await orm.em.flush();
+  u.address = { city: 'x', geo: { lat: 1 } } as Address;
+  await orm.em.flush();
+  u.address = null;
+  await orm.em.flush();
+  const row = await orm.em.getConnection().execute('select * from user');
+  expect(row[0]).toMatchObject({ address_city: null, address_geo_lat: null });
+  orm.em.clear();
+  const u2 = await orm.em.findOneOrFail(User, u.id);
+  expect(u2.address).toBeNull();
+});
