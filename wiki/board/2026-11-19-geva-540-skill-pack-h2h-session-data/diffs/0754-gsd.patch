@@ -0,0 +1,60 @@
+package fsext
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func setupDotStarRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "example.txt"), []byte("test content"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "another.go"), []byte("more content"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".hidden"), []byte("hidden"), 0o644))
+	return dir
+}
+
+func TestListDirectoryDotStarGitignore(t *testing.T) {
+	dir := setupDotStarRepo(t)
+
+	t.Run("absolute root", func(t *testing.T) {
+		files, _, err := ListDirectory(dir, nil, 0)
+		require.NoError(t, err)
+		require.ElementsMatch(t, []string{
+			filepath.Join(dir, "example.txt"),
+			filepath.Join(dir, "another.go"),
+		}, files)
+	})
+
+	t.Run("dot root", func(t *testing.T) {
+		oldWd, err := os.Getwd()
+		require.NoError(t, err)
+		require.NoError(t, os.Chdir(dir))
+		t.Cleanup(func() { _ = os.Chdir(oldWd) })
+
+		files, _, err := ListDirectory(".", nil, 0)
+		require.NoError(t, err)
+		require.ElementsMatch(t, []string{"./example.txt", "./another.go"}, files)
+	})
+
+	t.Run("user ignore pattern", func(t *testing.T) {
+		files, _, err := ListDirectory(dir, []string{".*"}, 0)
+		require.NoError(t, err)
+		require.Len(t, files, 2)
+	})
+}
+
+func TestGlobWithDoubleStarDotStarGitignore(t *testing.T) {
+	dir := setupDotStarRepo(t)
+
+	matches, _, err := GlobWithDoubleStar("**/*", dir, 0)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{
+		filepath.Join(dir, "example.txt"),
+		filepath.Join(dir, "another.go"),
+	}, matches)
+}
