-	header.Del(groupHeader)
+func ClearAuthHeaders(header http.Header, userHeader, groupHeader, extraHeaderPrefix string) {
+	userHeaders := []string{userHeader, DefaultUserHeader, groupHeader, DefaultGroupHeader}
+	extraPrefixes := []string{strings.ToLower(extraHeaderPrefix), strings.ToLower(DefaultExtraHeaderPrefix)}
 	for key := range header {
-		if strings.HasPrefix(strings.ToLower(key), strings.ToLower(extraHeaderPrefix)) {
-			header.Del(key)
+		lower := strings.ToLower(key)
+		for _, h := range userHeaders {
+			if lower == strings.ToLower(h) {
+				delete(header, key)
