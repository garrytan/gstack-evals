+// TestClearAuthHeaders_NonCanonicalKeys ensures keys that bypassed
+// canonicalization are still removed.
+func TestClearAuthHeaders_NonCanonicalKeys(t *testing.T) {
+	t.Parallel()
+	h := http.Header{
+		"x-remote-user":  {"system:admin"},
+		"x-remote-group": {"system:masters"},
+		"x-remote-extra-authorization.kcp.io%2fwarrant": {"forged"},
+		"Accept": {"application/json"},
+	}
+	ClearAuthHeaders(h, userHeader, groupHeader, extraPrefix)
+	if want := (http.Header{"Accept": {"application/json"}}); !reflect.DeepEqual(h, want) {
+		t.Errorf("headers = %v, want %v", h, want)
+	}
+}
