+func TestWithProxyAuthHeaders_NoAuthenticatedUserStripsForgedHeaders(t *testing.T) {
+	t.Parallel()
+	var forwarded http.Header
+	sink := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		forwarded = r.Header.Clone()
+	})
+	handler := withProxyAuthHeaders(sink, "X-Remote-User", "X-Remote-Group", "X-Remote-Extra-")
+
+	req := httptest.NewRequest(http.MethodGet, "https://shard/clusters/root:org:ws/api/v1/secrets", http.NoBody)
+	req.Header.Add("X-Remote-User", "system:admin")
+	req.Header.Add("X-Remote-Group", "system:masters")
+	req.Header.Add("X-Remote-Extra-Authorization.kcp.io%2fwarrant", `{"groups":["system:masters"]}`)
+	handler.ServeHTTP(httptest.NewRecorder(), req)
+
+	require.Empty(t, forwarded, "forged identity headers must not reach the backend")
+}
