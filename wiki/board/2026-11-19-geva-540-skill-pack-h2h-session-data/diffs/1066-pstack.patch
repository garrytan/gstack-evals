+const (
+	DefaultUserHeader        = "X-Remote-User"
+	DefaultGroupHeader       = "X-Remote-Group"
+	DefaultExtraHeaderPrefix = "X-Remote-Extra-"
+)
+
+// ClearAuthHeaders deletes every inbound copy of the configured identity
