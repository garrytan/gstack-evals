+// TestWithProxyAuthHeaders_CustomHeaderNamesStripDefaults ensures the default
+// X-Remote-* headers are stripped even when the mapping stamps custom names.
+func TestWithProxyAuthHeaders_CustomHeaderNamesStripDefaults(t *testing.T) {
+	t.Parallel()
+	got := forwardThroughProxy(t,
+		&userinfo.DefaultInfo{Name: "alice", Groups: []string{"system:authenticated"}},
+		"X-Custom-User", "X-Custom-Group", "X-Custom-Extra-",
+		http.Header{
+			defaultUserHeader:  {"system:admin"},
+			defaultGroupHeader: {"system:masters"},
+			scopesExtraHeader:  {"cluster:root"},
+		},
+	)
+	for _, h := range []string{defaultUserHeader, defaultGroupHeader, scopesExtraHeader} {
+		if v := got.Values(h); len(v) != 0 {
+			t.Errorf("default header %q leaked with custom mapping: %v", h, v)
+		}
+	}
 }
