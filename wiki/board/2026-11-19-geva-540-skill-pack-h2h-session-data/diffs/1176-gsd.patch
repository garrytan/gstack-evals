+// validateFileName ensures the file name (which may come from an untrusted
+// manifest annotation) is a plain file name and cannot escape the destination directory.
+func validateFileName(fileName string) error {
+	switch {
+	case fileName == "", fileName == ".", fileName == "..":
+		return xerrors.Errorf("%q is not a valid file name", fileName)
+	case strings.ContainsAny(fileName, `/\`), strings.ContainsRune(fileName, 0):
+		return xerrors.Errorf("%q must not contain path separators", fileName)
+	case filepath.IsAbs(fileName), filepath.VolumeName(fileName) != "":
+		return xerrors.Errorf("%q must not be an absolute path", fileName)
+	case filepath.Base(fileName) != fileName || !filepath.IsLocal(fileName):
+		return xerrors.Errorf("%q must be a plain file name", fileName)
+	}
+	return nil
+}
+
 func (a *Artifact) download(ctx context.Context, layer v1.Layer, fileName, dir string, quiet bool) error {
+	if err := validateFileName(fileName); err != nil {
+		return xerrors.Errorf("invalid file name: %w", err)
+	}
+
