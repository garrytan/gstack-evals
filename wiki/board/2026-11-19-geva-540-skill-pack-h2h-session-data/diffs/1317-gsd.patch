+// limitations under the License.
+
+package hugolib
+
+import (
+	"strings"
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+)
+
+func TestSecurityAllowContentHTML(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+SECURITY
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert(1)</script>
+-- content/p2.md --
+---
+title: p2
+---
+**md**
+-- layouts/all.html --
+{{ .Title }}|{{ .Content }}|
+`
+
+	t.Run("Denied by default", func(t *testing.T) {
+		b, err := TestE(t, strings.ReplaceAll(files, "SECURITY", ""))
+		b.Assert(err, qt.IsNotNil)
+		b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+	})
+
+	t.Run("Content adapter denied by default", func(t *testing.T) {
+		f := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/_content.gotmpl --
+{{ $.AddPage (dict "path" "p3" "title" "p3" "content" (dict "mediaType" "text/html" "value" "<script>alert(1)</script>")) }}
+-- layouts/all.html --
+{{ .Title }}|{{ .Content }}|
+`
+		b, err := TestE(t, f)
+		b.Assert(err, qt.IsNotNil)
+		b.Assert(err.Error(), qt.Contains, `security.allowContent`)
+	})
+
+	t.Run("Allowed", func(t *testing.T) {
+		b := Test(t, strings.ReplaceAll(files, "SECURITY", "[security]\nallowContent = ['.*']"))
+		b.AssertFileContent("public/p1/index.html", "p1|<script>alert(1)</script>")
+		b.AssertFileContent("public/p2/index.html", "p2|<p><strong>md</strong></p>")
+	})
+
+	t.Run("Markdown unaffected", func(t *testing.T) {
+		b := Test(t, strings.ReplaceAll(strings.ReplaceAll(files, "SECURITY", ""), "-- content/p1.html --", "-- content/p1.md --"))
+		b.AssertFileContent("public/p2/index.html", "p2|<p><strong>md</strong></p>")
+	})
+}
