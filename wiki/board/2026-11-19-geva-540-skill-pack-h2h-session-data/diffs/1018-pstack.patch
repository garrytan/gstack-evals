@@ -166,16 +166,26 @@ func (c *Context) Scheme() string {
 		return "https"
 	}
 	if scheme := c.request.Header.Get(HeaderXForwardedProto); scheme != "" {
-		return scheme
+		return sanitizeScheme(scheme)
 	}
 	if scheme := c.request.Header.Get(HeaderXForwardedProtocol); scheme != "" {
-		return scheme
+		return sanitizeScheme(scheme)
 	}
 	if ssl := c.request.Header.Get(HeaderXForwardedSsl); ssl == "on" {
 		return "https"
 	}
 	if scheme := c.request.Header.Get(HeaderXUrlScheme); scheme != "" {
-		return scheme
+		return sanitizeScheme(scheme)
+	}
+	return "http"
+}
+
+// sanitizeScheme limits client-supplied scheme headers to known web schemes so they cannot inject
+// arbitrary schemes (e.g. `javascript`) into URLs built from Context.Scheme.
+func sanitizeScheme(scheme string) string {
+	switch s := strings.ToLower(strings.TrimSpace(scheme)); s {
+	case "http", "https", "ws", "wss":
+		return s
 	}
 	return "http"
 }
