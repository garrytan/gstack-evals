+func TestRedirectWWWAndNonWWWIgnoreUnsafeForwardedScheme(t *testing.T) {
+	header := http.Header{echo.HeaderXForwardedProto: []string{"javascript"}}
+
+	res := redirectTest(WWWRedirect, "labstack.com", header)
+	assert.Equal(t, http.StatusMovedPermanently, res.Code)
+	assert.Equal(t, "http://www.labstack.com/", res.Header().Get(echo.HeaderLocation))
+
+	res = redirectTest(NonWWWRedirect, "www.labstack.com", header)
+	assert.Equal(t, http.StatusMovedPermanently, res.Code)
+	assert.Equal(t, "http://labstack.com/", res.Header().Get(echo.HeaderLocation))
