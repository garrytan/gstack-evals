diff --git a/internal/web/events_filter_test.go b/internal/web/events_filter_test.go
new file mode 100644
index 0000000..81c8ff2
--- /dev/null
+++ b/internal/web/events_filter_test.go
@@ -0,0 +1,102 @@
+package web
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/amir20/dozzle/internal/container"
+	container_support "github.com/amir20/dozzle/internal/support/container"
+	"github.com/stretchr/testify/require"
+)
+
+type filteringHostService struct {
+	HostService
+	containers []container.Container
+	events     []container.ContainerEvent
+	stats      []container.ContainerStat
+}
+
+func (f *filteringHostService) matching(labels container.ContainerLabels) []container.Container {
+	var result []container.Container
+	for _, c := range f.containers {
+		if !labels.Exists() || c.Labels["visible"] == "yes" {
+			result = append(result, c)
+		}
+	}
+	return result
+}
+
+func (f *filteringHostService) ListAllContainers(labels container.ContainerLabels) ([]container.Container, []error) {
+	return f.matching(labels), nil
+}
+
+func (f *filteringHostService) ListContainersForHost(host string, labels container.ContainerLabels) ([]container.Container, error) {
+	return f.matching(labels), nil
+}
+
+func (f *filteringHostService) FindContainer(host string, id string, labels container.ContainerLabels) (*container_support.ContainerService, error) {
+	return nil, fmt.Errorf("not found")
+}
+
+func (f *filteringHostService) SubscribeAvailableHosts(ctx context.Context, hosts chan<- container.Host) {}
+
+func (f *filteringHostService) SubscribeEventsAndStats(ctx context.Context, events chan<- container.ContainerEvent, stats chan<- container.ContainerStat) {
+	go func() {
+		for _, s := range f.stats {
+			stats <- s
+		}
+		for _, e := range f.events {
+			events <- e
+		}
+	}()
+}
+
+func Test_handler_streamEvents_filtersByLabels(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	svc := &filteringHostService{
+		containers: []container.Container{
+			{ID: "visible00001", Name: "visible", Host: "localhost", Labels: map[string]string{"visible": "yes"}},
+			{ID: "secret000001", Name: "secret", Host: "localhost", Labels: map[string]string{"secretproject": "acme"}},
+		},
+		stats: []container.ContainerStat{
+			{ID: "secret000001", CPUPercent: 42},
+			{ID: "visible00001", CPUPercent: 1},
+		},
+		events: []container.ContainerEvent{
+			{Name: "start", Host: "localhost", ActorID: "secret000001", ActorAttributes: map[string]string{"secretproject": "acme"}},
+			{Name: "die", Host: "localhost", ActorID: "secret000001"},
+			{Name: "health_status: healthy", Host: "localhost", ActorID: "secret000001"},
+			{Name: "update", Host: "localhost", ActorID: "secret000001"},
+			{Name: "start", Host: "localhost", ActorID: "visible00001"},
+		},
+	}
+
+	labels, err := container.ParseContainerFilter("visible=yes")
+	require.NoError(t, err)
+
+	h := &handler{hostService: svc, config: &Config{Base: "/", NoAnalytics: true, Labels: labels, Authorization: Authorization{Provider: NONE}}}
+
+	req, err := http.NewRequestWithContext(ctx, "GET", "/api/events/stream", nil)
+	require.NoError(t, err)
+	rr := httptest.NewRecorder()
+
+	go func() {
+		time.Sleep(200 * time.Millisecond)
+		cancel()
+	}()
+	h.streamEvents(rr, req)
+
+	body := rr.Body.String()
+	require.NotContains(t, body, "secret000001")
+	require.NotContains(t, body, "acme")
+	require.Contains(t, body, "event: container-stat")
+	require.Contains(t, body, "visible00001")
+	require.Equal(t, 1, strings.Count(body, "event: container-event"))
+}
