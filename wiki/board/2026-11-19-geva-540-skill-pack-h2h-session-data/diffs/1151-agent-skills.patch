+package remote
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sync/atomic"
+	"testing"
+
+	"github.com/opencontainers/go-digest"
+	"github.com/opencontainers/image-spec/specs-go"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// Test_Pagination_CrossHostLink ensures that a malicious registry cannot make
+// the client issue requests to another host via the Link header (SSRF).
+func Test_Pagination_CrossHostLink(t *testing.T) {
+	var internalHits int32
+	internal := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&internalHits, 1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer internal.Close()
+
+	evil := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", "<"+internal.URL+"/admin>; rel=\"next\"")
+		switch r.URL.Path {
+		case "/v2/test/tags/list":
+			json.NewEncoder(w).Encode(map[string][]string{"tags": {"v1"}})
+		case "/v2/_catalog":
+			json.NewEncoder(w).Encode(map[string][]string{"repositories": {"test"}})
+		default:
+			w.Header().Set("Content-Type", ocispec.MediaTypeImageIndex)
+			json.NewEncoder(w).Encode(ocispec.Index{
+				Versioned: specs.Versioned{SchemaVersion: 2},
+				MediaType: ocispec.MediaTypeImageIndex,
+				Manifests: []ocispec.Descriptor{},
+			})
+		}
+	}))
+	defer evil.Close()
+	u, err := url.Parse(evil.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+
+	repo, err := NewRepository(u.Host + "/test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	repo.PlainHTTP = true
+	if err := repo.Tags(ctx, "", func([]string) error { return nil }); err == nil {
+		t.Error("Tags() expected error for cross-host Link")
+	}
+	repo.SetReferrersCapability(true)
+	subject := ocispec.Descriptor{MediaType: ocispec.MediaTypeImageManifest, Digest: digest.FromString("x"), Size: 1}
+	if err := repo.Referrers(ctx, subject, "", func([]ocispec.Descriptor) error { return nil }); err == nil {
+		t.Error("Referrers() expected error for cross-host Link")
+	}
+
+	reg, err := NewRegistry(u.Host)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reg.PlainHTTP = true
+	if err := reg.Repositories(ctx, "", func([]string) error { return nil }); err == nil {
+		t.Error("Repositories() expected error for cross-host Link")
+	}
+
+	if n := atomic.LoadInt32(&internalHits); n != 0 {
+		t.Errorf("internal server received %d requests, want 0", n)
+	}
+}
diff --git a/registry/remote/utils.go b/registry/remote/utils.go
index 797169f..3e3411a 100644
--- a/registry/remote/utils.go
+++ b/registry/remote/utils.go
@@ -51,10 +51,17 @@ func parseLink(resp *http.Response) (string, error) {
 		link = link[1:i]
 	}
 
-	linkURL, err := resp.Request.URL.Parse(link)
+	baseURL := resp.Request.URL
+	linkURL, err := baseURL.Parse(link)
 	if err != nil {
 		return "", err
 	}
+	// Prevent SSRF: the next page must be served by the same registry
+	// (same scheme and host, including port) as the current page.
+	if linkURL.Scheme != baseURL.Scheme || linkURL.Host != baseURL.Host {
+		return "", fmt.Errorf("invalid next link %q: scheme and host must match the current request %s://%s",
+			linkURL.Redacted(), baseURL.Scheme, baseURL.Host)
+	}
 	return linkURL.String(), nil
 }
 
