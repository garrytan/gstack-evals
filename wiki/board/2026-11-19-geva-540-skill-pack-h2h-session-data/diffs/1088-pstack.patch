 var zeroNetV4 = &net.IPNet{IP: net.IP{0, 0, 0, 0}, Mask: net.CIDRMask(8, 32)}
 
+// IPv6 transition ranges that tunnel to an embedded IPv4 address, letting a
+// target like 2002:7f00:1:: reach 127.0.0.1. None are plausible webhook hosts.
+var blockedTransitionNets = mustParseCIDRs(
+	"2002::/16",      // 6to4 (RFC 3056)
+	"2001::/32",      // Teredo (RFC 4380)
+	"64:ff9b:1::/48", // NAT64 local-use (RFC 8215)
+	"::/96",          // IPv4-compatible (deprecated, RFC 4291)
+)
+
+// nat64WKP is allowed so IPv6-only hosts behind DNS64 can still reach public
+// webhooks, but the embedded IPv4 is checked against the same rules.
+var nat64WKP = mustParseCIDRs("64:ff9b::/96")[0]
+
+func mustParseCIDRs(cidrs ...string) []*net.IPNet {
+	nets := make([]*net.IPNet, len(cidrs))
+	for i, c := range cidrs {
+		_, n, err := net.ParseCIDR(c)
+		if err != nil {
+			panic(err)
+		}
+		nets[i] = n
+	}
+	return nets
+}
+
 func isBlockedIP(ip net.IP) bool {
 	if ip.IsLoopback() ||
 		ip.IsLinkLocalUnicast() ||
@@ -47,6 +72,16 @@ func isBlockedIP(ip net.IP) bool {
 	if ip.Equal(net.IPv4bcast) {
 		return true
 	}
+	if ip.To4() == nil && len(ip) == net.IPv6len {
+		for _, n := range blockedTransitionNets {
+			if n.Contains(ip) {
+				return true
+			}
+		}
+		if nat64WKP.Contains(ip) {
+			return isBlockedIP(net.IP(ip[12:16]))
+		}
+	}
 	return false
 }
 
