+// Regression test: arguments of record updates must be traversed when inlining
+#[test]
+fn inlined_parameter_used_in_record_update() {
+    assert_erl!(
+        ("gleam_stdlib", "gleam/result", RESULT_MODULE),
+        "
+import gleam/result
+
+pub type Config {
+  Config(host: String, ssl: Bool)
+}
+
+pub fn main(config: Config) {
+  use ssl <- result.map(Ok(True))
+  Config(..config, ssl: ssl)
+}
+"
+    );
+}
