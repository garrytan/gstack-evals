+
+    @Test
+    void remote_glob_recursivePattern_matchesFilesAtSearchRoot() {
+        InMemoryStore store = new InMemoryStore();
+        List<String> ns = List.of("test-ns");
+        store.put(ns, "/hello.txt", Map.of("content", "root"));
+        store.put(ns, "/reports/hello.txt", Map.of("content", "nested"));
+        store.put(ns, "/reports/archive/hello.txt", Map.of("content", "deep"));
+
+        RemoteFilesystem fs = new RemoteFilesystem(store, ns);
+        for (String pattern : List.of("**/hello.txt", "**/*.txt")) {
+            GlobResult result = fs.glob(RT, pattern, "/");
+            assertTrue(result.isSuccess());
+            Set<String> paths =
+                    result.matches().stream().map(fi -> fi.path()).collect(Collectors.toSet());
+            assertEquals(
+                    Set.of("/hello.txt", "/reports/hello.txt", "/reports/archive/hello.txt"),
+                    paths,
+                    pattern);
+        }
+    }
