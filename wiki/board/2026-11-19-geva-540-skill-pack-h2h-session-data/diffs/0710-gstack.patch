+TEST_F(BuildTest, DyndepBuildDiscoverOutputAndDepfileInputOrderOnly) {
+  // Verify that an edge whose depfile reports an input that is an
+  // implicit output discovered via an already-built dyndep file is
+  // rebuilt when that implicit output's producer is dirty, even if the
+  // producer is reached only through a later order-only dependency.
+  ASSERT_NO_FATAL_FAILURE(AssertParse(&state_,
+"rule touch\n"
+"  command = touch $out $out.imp\n"
+"rule cp\n"
+"  command = cp $in $out\n"
+"rule cc\n"
+"  command = touch $out\n"
+"  depfile = $out.d\n"
+"build dd: cp dd-in\n"
+"build tmp: touch || dd\n"
+"  dyndep = dd\n"
+"build out: cc || tmp\n"
+));
+  fs_.Create("dd-in",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Tick();
+  fs_.Create("dd",
+"ninja_dyndep_version = 1\n"
+"build tmp | tmp.imp: dyndep\n"
+);
+  fs_.Create("tmp.imp", "");
+  fs_.Tick();
+  fs_.Create("out.d", "out: tmp.imp\n");
+  fs_.Create("out", "");
+  // "tmp" is missing, so its edge is dirty and will regenerate tmp.imp.
+
+  string err;
+  EXPECT_TRUE(builder_.AddTarget("out", &err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(builder_.Build(&err), ExitSuccess);
+  EXPECT_EQ("", err);
+
+  ASSERT_EQ(2u, command_runner_.commands_ran_.size());
+  EXPECT_EQ("touch tmp tmp.imp", command_runner_.commands_ran_[0]);
+  EXPECT_EQ("touch out", command_runner_.commands_ran_[1]);
+}
