+type sameLogMultipleEntriesEntity struct {
+	*ca.TestEntity
+	extra *tlog.Entry
+}
+
+func (e *sameLogMultipleEntriesEntity) TlogEntries() ([]*tlog.Entry, error) {
+	entries, err := e.TestEntity.TlogEntries()
+	if err != nil {
+		return nil, err
+	}
+	return append(entries, e.extra), nil
+}
+
+// A single (possibly compromised) log must not be able to satisfy a
+// multi-log threshold by producing multiple entries with different indices.
+func TestMultipleEntriesFromSameLogCountOnce(t *testing.T) {
+	virtualSigstore, err := ca.NewVirtualSigstore()
+	assert.NoError(t, err)
+
+	statement := []byte(`{"_type":"https://in-toto.io/Statement/v0.1","predicateType":"customFoo","subject":[{"name":"subject","digest":{"sha256":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}}],"predicate":{}}`)
+	entity, err := virtualSigstore.Attest("foo@example.com", "issuer", statement)
+	assert.NoError(t, err)
+
+	vc, err := entity.VerificationContent()
+	assert.NoError(t, err)
+	sigContent, err := entity.SignatureContent()
+	assert.NoError(t, err)
+	entries, err := entity.TlogEntries()
+	assert.NoError(t, err)
+
+	extra, err := virtualSigstore.GenerateTlogEntryWithLogIndex(vc.Certificate(), sigContent.EnvelopeContent().RawEnvelope(), sigContent.Signature(), entries[0].IntegratedTime().Unix(), 1, false)
+	assert.NoError(t, err)
+
+	multi := &sameLogMultipleEntriesEntity{TestEntity: entity, extra: extra}
+
+	// both entries are individually valid
+	_, err = verify.VerifyTlogEntry(multi, virtualSigstore, 1, true)
+	assert.NoError(t, err)
+
+	// but they come from the same log, so they must only count once
+	_, err = verify.VerifyTlogEntry(multi, virtualSigstore, 2, true)
+	assert.ErrorContains(t, err, "not enough verified log entries from transparency log")
+}
+
 type tooManyTlogEntriesEntity struct {
 	*ca.TestEntity
 }
