+        [Test]
+        public async Task ShowMessageBox_ShouldApplyGlobalBackgroundClass_WhenNoOptionsProvided()
+        {
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-bg"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            _ = provider.InvokeAsync(() => service.ShowMessageBoxAsync("Title", "Message"));
+            provider.WaitForAssertion(() => provider.Find("div.mud-overlay-dialog").ClassList.Should().Contain("global-bg"));
+        }
+
+        [Test]
+        public async Task ShowMessageBox_ShouldPreferLocalBackgroundClass_OverGlobal()
+        {
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-bg"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            _ = provider.InvokeAsync(() => service.ShowMessageBoxAsync("Title", "Message", options: new DialogOptions { BackgroundClass = "local-bg" }));
+            provider.WaitForAssertion(() =>
+            {
+                var classes = provider.Find("div.mud-overlay-dialog").ClassList;
+                classes.Should().Contain("local-bg");
+                classes.Should().NotContain("global-bg");
+            });
+        }
+
