+
+// Test that symlinks from untrusted .rclonelink files can't escape the root
+// See: GHSA-cf44-9pgv-m4xc
+func TestUnsafeSymlinkTarget(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("symlinks need privileges on windows")
+	}
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	f := r.Flocal.(*Fs)
+	f.opt.TranslateSymlinks = true
+
+	outside := t.TempDir()
+	when := time.Now()
+
+	put := func(remote, contents string) error {
+		src := object.NewStaticObjectInfo(remote, when, int64(len(contents)), true, nil, nil)
+		_, err := f.Put(ctx, bytes.NewBufferString(contents), src)
+		return err
+	}
+
+	for _, target := range []string{outside, "../../../../../../../../" + outside, "..", "a/../../x"} {
+		require.Error(t, put("pwn.rclonelink", target), target)
+		_, err := os.Lstat(filepath.Join(f.root, "pwn"))
+		require.True(t, os.IsNotExist(err), target)
+	}
+
+	// Chained escape via an intermediate symlink
+	require.NoError(t, put("a/b/up.rclonelink", ".."))
+	require.Error(t, put("chain.rclonelink", "a/b/up/../.."))
+
+	// Write through a pre-planted escaping symlink must fail
+	require.NoError(t, os.Symlink(outside, filepath.Join(f.root, "planted")))
+	require.Error(t, put("planted/authorized_keys", "pwned"))
+	_, err := os.Stat(filepath.Join(outside, "authorized_keys"))
+	require.True(t, os.IsNotExist(err))
+
+	// Safe relative links still work
+	require.NoError(t, put("dir/ok.rclonelink", "../file.txt"))
+	got, err := os.Readlink(filepath.Join(f.root, "dir", "ok"))
+	require.NoError(t, err)
+	assert.Equal(t, "../file.txt", got)
+
+	// Opt-out allows absolute links
+	f.opt.LinksAllowUnsafe = true
+	require.NoError(t, put("abs.rclonelink", outside))
+}
