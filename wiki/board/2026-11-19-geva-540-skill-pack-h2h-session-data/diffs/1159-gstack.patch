+
+// isWithin returns true if p is root or inside root (both cleaned OS paths)
+func isWithin(root, p string) bool {
+	rel, err := filepath.Rel(root, p)
+	if err != nil {
+		return false
+	}
+	return rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)) && !filepath.IsAbs(rel)
+}
+
+// checkSymlinkTarget checks that the target of a symlink about to be
+// created at o.path is safe, i.e. that it is relative and does not
+// point outside the root of the Fs.
+//
+// The contents of a .rclonelink file may come from an untrusted
+// remote, so creating arbitrary symlinks could allow writing files
+// outside the destination.
+func (o *Object) checkSymlinkTarget(target string) error {
+	if o.fs.opt.LinksAllowUnsafe {
+		return nil
+	}
+	if target == "" {
+		return fmt.Errorf("refusing to create symlink with empty target")
+	}
+	if strings.ContainsRune(target, 0) {
+		return fmt.Errorf("refusing to create symlink with target containing NUL")
+	}
+	if filepath.IsAbs(target) || filepath.VolumeName(target) != "" || strings.HasPrefix(target, "/") || strings.HasPrefix(target, string(filepath.Separator)) {
+		return fmt.Errorf("refusing to create symlink with absolute target %q (use --local-links-allow-unsafe to override)", target)
+	}
+	resolved := filepath.Join(filepath.Dir(o.path), target)
+	if !isWithin(filepath.Clean(o.fs.root), resolved) {
+		return fmt.Errorf("refusing to create symlink with target %q pointing outside the destination (use --local-links-allow-unsafe to override)", target)
+	}
+	return nil
+}
+
+// checkSymlinkResolved checks that the symlink just created at o.path
+// does not physically resolve outside the root of the Fs (this can
+// happen when chaining through other symlinks).
+func (o *Object) checkSymlinkResolved() error {
+	if o.fs.opt.LinksAllowUnsafe {
+		return nil
+	}
+	realRoot, err := filepath.EvalSymlinks(o.fs.root)
+	if err != nil {
+		return nil
+	}
+	resolved, err := filepath.EvalSymlinks(o.path)
+	if err != nil {
+		// Dangling link - the lexical check has already been done
+		return nil
+	}
+	if !isWithin(realRoot, resolved) {
+		return fmt.Errorf("refusing to create symlink which resolves to %q outside the destination (use --local-links-allow-unsafe to override)", resolved)
+	}
+	return nil
 }
 
