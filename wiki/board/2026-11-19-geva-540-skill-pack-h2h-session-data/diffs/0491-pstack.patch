+
+    @Test
+    public void testUpdatingLocalClassInstance() throws Exception
+    {
+        class Local {
+            public int value;
+        }
+        Local local = new Local();
+        Local result = MAPPER.readerForUpdating(local).readValue(a2q("{'value':2}"));
+        assertSame(local, result);
