+
+func TestFlatColsOutOfRange(t *testing.T) {
+	f := NewFile()
+	ws, ok := f.Sheet.Load("xl/worksheets/sheet1.xml")
+	assert.True(t, ok)
+	ws.(*xlsxWorksheet).Cols = &xlsxCols{Col: []xlsxCol{{Min: -5, Max: math.MaxInt32, Width: float64Ptr(9)}}}
+	assert.NoError(t, f.SetColWidth("Sheet1", "A", "A", 12))
+	assert.Len(t, ws.(*xlsxWorksheet).Cols.Col, MaxColumns)
+	assert.NoError(t, f.SetColStyle("Sheet1", "B", 0))
+	assert.NoError(t, f.SetColVisible("Sheet1", "C", false))
+	assert.NoError(t, f.SetColOutlineLevel("Sheet1", "D", 1))
+	assert.Len(t, ws.(*xlsxWorksheet).Cols.Col, MaxColumns)
+	width, err := f.GetColWidth("Sheet1", "A")
+	assert.NoError(t, err)
+	assert.Equal(t, 12.0, width)
+}
