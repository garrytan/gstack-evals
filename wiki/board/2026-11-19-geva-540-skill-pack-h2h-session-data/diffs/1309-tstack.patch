+// containsDotSegment reports whether the value contains a "." or ".." path
+// segment (including percent-encoded or backslash-separated forms), which could
+// be used to traverse outside of the configured tool path.
+func containsDotSegment(value string) bool {
+	candidates := []string{value}
+	// Decode repeatedly to catch (multi-)percent-encoded dot segments.
+	cur := value
+	for i := 0; i < 3; i++ {
+		decoded, err := url.PathUnescape(cur)
+		if err != nil || decoded == cur {
+			break
+		}
+		candidates = append(candidates, decoded)
+		cur = decoded
+	}
+	for _, c := range candidates {
+		segments := strings.FieldsFunc(c, func(r rune) bool { return r == '/' || r == '\\' || r == '?' || r == '#' || r == ';' })
+		for _, seg := range segments {
+			if seg == "." || seg == ".." {
+				return true
+			}
+		}
+	}
+	return false
+}
