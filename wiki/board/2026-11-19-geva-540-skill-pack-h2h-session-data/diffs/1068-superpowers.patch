+// visibleContainers tracks the set of container IDs a user is allowed to see, per host.
+type visibleContainers struct {
+	byHost map[string]map[string]struct{}
+}
+
+func newVisibleContainers(containers []container.Container) *visibleContainers {
+	v := &visibleContainers{byHost: make(map[string]map[string]struct{})}
+	for _, c := range containers {
+		ids, ok := v.byHost[c.Host]
+		if !ok {
+			ids = make(map[string]struct{})
+			v.byHost[c.Host] = ids
+		}
+		ids[c.ID] = struct{}{}
+	}
+	return v
+}
+
+func (v *visibleContainers) setHost(host string, containers []container.Container) {
+	ids := make(map[string]struct{}, len(containers))
+	for _, c := range containers {
+		ids[c.ID] = struct{}{}
+	}
+	v.byHost[host] = ids
+}
+
+func (v *visibleContainers) has(host, id string) bool {
+	if id == "" {
+		return false
+	}
+	ids, ok := v.byHost[host]
+	if !ok {
+		return false
+	}
+	_, ok = ids[id]
+	return ok
+}
+
+func (v *visibleContainers) hasID(id string) bool {
+	if id == "" {
+		return false
+	}
+	for _, ids := range v.byHost {
+		if _, ok := ids[id]; ok {
+			return true
+		}
+	}
+	return false
+}
