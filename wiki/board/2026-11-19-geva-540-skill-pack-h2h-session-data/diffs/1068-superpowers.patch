+func Test_handler_streamEvents_filtersByUserLabels(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	req, err := http.NewRequestWithContext(ctx, "GET", "/api/events/stream", nil)
+	require.NoError(t, err)
+
+	labels := container.ContainerLabels{"visible": []string{"yes"}}
+	visibleContainer := container.Container{ID: "visible12345", Name: "visible", Image: "test", Host: "localhost", State: "running", Labels: map[string]string{"visible": "yes"}, Stats: utils.NewRingBuffer[container.ContainerStat](300)}
+	secretContainer := container.Container{ID: "secret123456", Name: "dz_secret", Image: "test", Host: "localhost", State: "running", Labels: map[string]string{"secretproject": "acme-payroll"}, Stats: utils.NewRingBuffer[container.ContainerStat](300)}
+
+	mockedClient := new(MockedClient)
+	mockedClient.On("ListContainers", mock.Anything, labels).Return([]container.Container{visibleContainer}, nil)
+	mockedClient.On("ListContainers", mock.Anything, mock.Anything).Return([]container.Container{visibleContainer, secretContainer}, nil)
+	mockedClient.On("ContainerEvents", mock.Anything, mock.AnythingOfType("chan<- container.ContainerEvent")).Return(nil).Run(func(args mock.Arguments) {
+		messages := args.Get(1).(chan<- container.ContainerEvent)
+		time.Sleep(50 * time.Millisecond)
+		for _, name := range []string{"die", "start", "health_status: healthy"} {
+			messages <- container.ContainerEvent{Name: name, ActorID: secretContainer.ID, Host: "localhost", ActorAttributes: map[string]string{"secretproject": "acme-payroll"}}
+		}
+		messages <- container.ContainerEvent{Name: "die", ActorID: visibleContainer.ID, Host: "localhost"}
+		time.Sleep(50 * time.Millisecond)
+		cancel()
+	})
+	mockedClient.On("FindContainer", mock.Anything, secretContainer.ID).Return(secretContainer, nil).Maybe()
+	mockedClient.On("FindContainer", mock.Anything, visibleContainer.ID).Return(visibleContainer, nil).Maybe()
+	mockedClient.On("Host").Return(container.Host{ID: "localhost"})
+
+	manager := docker_support.NewRetriableClientManager(nil, 3*time.Second, tls.Certificate{}, docker_support.NewDockerClientService(mockedClient, labels))
+	multiHostService := docker_support.NewMultiHostService(manager, 3*time.Second)
+	server := CreateServer(multiHostService, nil, Config{Base: "/", Labels: labels, Authorization: Authorization{Provider: NONE}})
+
+	rr := httptest.NewRecorder()
+	server.Handler.ServeHTTP(rr, req)
+
+	body := rr.Body.String()
+	require.Contains(t, body, visibleContainer.ID)
+	require.NotContains(t, body, secretContainer.ID)
+	require.NotContains(t, body, "acme-payroll")
+}
+
+func Test_visibleContainers(t *testing.T) {
+	v := newVisibleContainers([]container.Container{{ID: "a", Host: "h1"}})
+	require.True(t, v.has("h1", "a"))
+	require.True(t, v.hasID("a"))
+	require.False(t, v.has("h2", "a"))
+	require.False(t, v.hasID("b"))
+	require.False(t, v.hasID(""))
+
+	v.setHost("h1", []container.Container{{ID: "b", Host: "h1"}})
+	require.False(t, v.hasID("a"))
+	require.True(t, v.has("h1", "b"))
+}
