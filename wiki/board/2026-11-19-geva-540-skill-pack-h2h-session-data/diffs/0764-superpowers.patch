+  it('preserves session config (e.g. audio formats) when updating the agent', async () => {
+    const t = new FakeTransport();
+    const agent = new RealtimeAgent({ name: 'A', handoffs: [] });
+    const s = new RealtimeSession(agent, {
+      transport: t,
+      config: {
+        inputAudioFormat: 'g711_ulaw',
+        outputAudioFormat: 'g711_ulaw',
+        voice: 'alloy',
+      },
+    });
+    await s.connect({ apiKey: 'test' });
+    await s.updateAgent(
+      agent.clone({ name: 'Bob', instructions: 'You are Bob.' }),
+    );
+    const last = t.updateSessionConfigCalls.at(-1)!;
+    expect(last.inputAudioFormat).toBe('g711_ulaw');
+    expect(last.outputAudioFormat).toBe('g711_ulaw');
+    expect(last.voice).toBe('alloy');
+    expect(last.instructions).toBe('You are Bob.');
+  });
