+// isGoWithWgDone returns true if the given statement is a go statement running
+// a function literal that calls wg.Done, or if it is a for/range loop whose body
+// contains (at its top level) such a go statement. The latter covers code like:
+//
+//	wg.Add(n)
+//	for range n {
+//		go func() {
+//			defer wg.Done()
+//			...
+//		}()
+//	}
+func (w *lintUseWaitGroupGo) isGoWithWgDone(stmt ast.Stmt) bool {
+	var body *ast.BlockStmt
+	switch s := stmt.(type) {
+	case *ast.GoStmt:
+		return w.hasCallToWgDone(s)
+	case *ast.ForStmt:
+		body = s.Body
+	case *ast.RangeStmt:
+		body = s.Body
+	default:
+		return false
+	}
+
+	if body == nil {
+		return false
+	}
+
+	for _, bodyStmt := range body.List {
+		goStmt, ok := bodyStmt.(*ast.GoStmt)
+		if ok && w.hasCallToWgDone(goStmt) {
+			return true
+		}
+	}
+
+	return false
+}
+
 // hasCallToWgDone returns true if the given go statement
 // calls to a function literal containing a call to wg.Done, false otherwise.
