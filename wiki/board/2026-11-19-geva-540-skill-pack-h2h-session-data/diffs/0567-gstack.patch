diff --git a/testdata/go1.25/use_waitgroup_go.go b/testdata/go1.25/use_waitgroup_go.go
index a827a49..45080e6 100644
--- a/testdata/go1.25/use_waitgroup_go.go
+++ b/testdata/go1.25/use_waitgroup_go.go
@@ -50,4 +50,58 @@ func useWaitGroupGo() {
 		}
 	}()
 	wg.Wait()
+
+	// from https://github.com/kubernetes-sigs/kueue/pull/9892
+	wg.Add(int(jobs)) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+
+	for range int(jobs) {
+		go func() {
+			defer wg.Done()
+			doSomething()
+		}()
+	}
+
+	wg.Wait()
+
+	wg.Add(n) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+	for i := 0; i < n; i++ {
+		go func() {
+			doSomething()
+			wg.Done()
+		}()
+	}
+	wg.Wait()
+
+	wg.Add(len(items)) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+	for _, item := range items {
+		item := item
+		go func() {
+			defer wg.Done()
+			process(item)
+		}()
+	}
+	wg.Wait()
+
+	// no go statement in the loop body
+	wg.Add(n)
+	for range n {
+		doSomething()
+	}
+	wg.Wait()
+
+	// goroutine in the loop does not call wg.Done
+	wg.Add(n)
+	for range n {
+		go func() {
+			doSomething()
+		}()
+	}
+	wg.Wait()
+
+	// goroutine runs a function defined elsewhere
+	wg.Add(n)
+	for range n {
+		go worker(&wg)
+	}
+	wg.Wait()
 }
