diff --git a/lib/dispatcher/client-h2.js b/lib/dispatcher/client-h2.js
index 3fc6384..206ba49 100644
--- a/lib/dispatcher/client-h2.js
+++ b/lib/dispatcher/client-h2.js
@@ -292,16 +292,19 @@ function writeH2 (client, request) {
     const key = reqHeaders[n + 0]
     const val = reqHeaders[n + 1]
 
+    // RFC 9113, Section 8.2.3: cookie-pairs are delimited by "; "
+    const separator = key.toLowerCase() === 'cookie' ? '; ' : ', '
+
     if (Array.isArray(val)) {
       for (let i = 0; i < val.length; i++) {
         if (headers[key]) {
-          headers[key] += `, ${val[i]}`
+          headers[key] += `${separator}${val[i]}`
         } else {
           headers[key] = val[i]
         }
       }
     } else if (headers[key]) {
-      headers[key] += `, ${val}`
+      headers[key] += `${separator}${val}`
     } else {
       headers[key] = val
     }
diff --git a/test/http2.js b/test/http2.js
index 83e1422..a59b255 100644
--- a/test/http2.js
+++ b/test/http2.js
@@ -1817,3 +1817,31 @@ test('Should handle http2 trailers', async t => {
 
   await t.completed
 })
+
+test('Should join multiple cookie values with "; " (RFC 9113 8.2.3)', async t => {
+  t = tspl(t, { plan: 2 })
+  const server = createSecureServer(await pem.generate({ opts: { keySize: 2048 } }))
+
+  server.on('stream', (stream, headers) => {
+    t.strictEqual(headers.cookie, 'a=b; c=d; e=f')
+    stream.respond({ ':status': 200 })
+    stream.end('ok')
+  })
+
+  after(() => server.close())
+  await once(server.listen(0), 'listening')
+
+  const client = new Client(`https://localhost:${server.address().port}`, {
+    connect: { rejectUnauthorized: false },
+    allowH2: true
+  })
+  after(() => client.close())
+
+  const response = await client.request({
+    path: '/',
+    method: 'GET',
+    headers: { cookie: ['a=b', 'c=d', 'e=f'] }
+  })
+  t.strictEqual(await response.body.text(), 'ok')
+  await t.completed
+})
