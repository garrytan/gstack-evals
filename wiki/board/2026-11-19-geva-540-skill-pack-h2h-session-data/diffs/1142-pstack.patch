+// resolveComponentProject returns the project that owns the component. Authorization
+// must use this owner rather than the caller-supplied project, otherwise a grant on one
+// project would reach components of every other project in the namespace. A non-empty
+// callerProject that differs from the owner is rejected.
+func resolveComponentProject(ctx context.Context, k8sClient client.Client, namespace, componentName, callerProject string) (string, error) {
+	comp := &openchoreov1alpha1.Component{}
+	if err := k8sClient.Get(ctx, client.ObjectKey{Namespace: namespace, Name: componentName}, comp); err != nil {
+		if apierrors.IsNotFound(err) {
+			return "", fmt.Errorf("component %q not found in namespace %q", componentName, namespace)
+		}
+		return "", infraErrorf("failed to look up component %q: %w", componentName, err)
+	}
+	owner := comp.Spec.Owner.ProjectName
+	if owner == "" || (callerProject != "" && callerProject != owner) {
+		return "", fmt.Errorf("component %q not found in project %q", componentName, callerProject)
+	}
+	return owner, nil
+}
+
+func writeComponentLookupError(w http.ResponseWriter, logger *slog.Logger, err error) {
+	var infraErr *execInfraError
+	if errors.As(err, &infraErr) {
+		logger.Error("Failed to look up component", "error", err)
+		http.Error(w, "failed to look up component", http.StatusServiceUnavailable)
+		return
+	}
+	logger.Warn("Component lookup rejected", "error", err)
+	http.Error(w, err.Error(), http.StatusNotFound)
+}
