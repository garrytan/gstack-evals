+	// Column names whose value overflows int64 must not wrap around
+	for _, name := range []string{"VGWQHXLSDVIKWV", "vgwqhxlsdvikwv", "ZZZZZZZZZZZZZZZZZZZZ", "AAAAAAAAAAAAAAAAAAAAA"} {
+		out, err := ColumnNameToNumber(name)
