--- a/lib.go
+++ b/lib.go
@@ -218,19 +218,29 @@ func ColumnNameToNumber(name string) (int, error) {
 		return -1, newInvalidColumnNameError(name)
 	}
 	col := 0
-	multi := 1
-	for i := len(name) - 1; i >= 0; i-- {
+	overflow := false
+	for i := 0; i < len(name); i++ {
+		var d int
 		r := name[i]
 		if r >= 'A' && r <= 'Z' {
-			col += int(r-'A'+1) * multi
+			d = int(r - 'A' + 1)
 		} else if r >= 'a' && r <= 'z' {
-			col += int(r-'a'+1) * multi
+			d = int(r - 'a' + 1)
 		} else {
 			return -1, newInvalidColumnNameError(name)
 		}
-		multi *= 26
+		if overflow {
+			continue
+		}
+		// Bound the accumulated value after each digit so that the
+		// accumulation can never wrap around: every digit is at least 1, so
+		// any name whose value exceeds MaxColumns crosses the bound here.
+		col = col*26 + d
+		if col > MaxColumns {
+			overflow = true
+		}
 	}
-	if col > MaxColumns {
+	if overflow {
 		return -1, ErrColumnNumber
 	}
