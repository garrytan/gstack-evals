+	_, _, err = CellNameToCoordinates("VGWQHXLSDVIKWV1")
+	assert.ErrorIs(t, err, ErrColumnNumber)
+	// Invalid characters still reported as invalid column name
+	_, err = ColumnNameToNumber("ZZZZ1")
+	assert.EqualError(t, err, newInvalidColumnNameError("ZZZZ1").Error())
+}
