diff --git a/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java b/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java
index d9c942a..8bd2c4f 100644
--- a/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java
+++ b/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java
@@ -392,4 +392,26 @@ public class UpdateViaObjectReaderTest
         assertNotSame(obj, newObj);
         assertNull(newObj);
     }
+
+    // Existing instance of local/anonymous class can be updated
+    @Test
+    public void testUpdateAnonymousInstance() throws Exception
+    {
+        Object anon = new Object() {
+            public int value;
+            @Override public String toString() { return String.valueOf(value); }
+        };
+        Object result = MAPPER.readerForUpdating(anon).readValue("{\"value\": 2}");
+        assertSame(anon, result);
+        assertEquals("2", anon.toString());
+
+        class Local { public int x; }
+        Local local = new Local();
+        assertSame(local, MAPPER.readerForUpdating(local).readValue("{\"x\": 3}"));
+        assertEquals(3, local.x);
+
+        // but instantiating a new one (needs outer instance) still fails
+        assertThrows(DatabindException.class,
+                () -> MAPPER.readValue("{\"x\": 3}", Local.class));
+    }
 }
