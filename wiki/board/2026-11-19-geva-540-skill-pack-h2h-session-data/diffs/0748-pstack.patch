+package fsext
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func setupDotStarRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "example.txt"), []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "another.go"), []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".hidden"), []byte("test"), 0o644))
+	return dir
+}
+
+func TestListDirectoryDotStarGitignore(t *testing.T) {
+	dir := setupDotStarRepo(t)
+	t.Chdir(dir)
+
+	for _, root := range []string{".", dir} {
+		files, _, err := ListDirectory(root, nil, 0)
+		require.NoError(t, err)
+
+		var names []string
+		for _, f := range files {
+			names = append(names, filepath.Base(f))
+		}
+		require.ElementsMatch(t, []string{"example.txt", "another.go"}, names, "root %q", root)
+	}
+}
+
+func TestGlobDotStarGitignore(t *testing.T) {
+	dir := setupDotStarRepo(t)
+	t.Chdir(dir)
+
+	for _, root := range []string{".", dir} {
+		files, _, err := GlobWithDoubleStar("**/*", root, 0)
+		require.NoError(t, err)
+
+		var names []string
+		for _, f := range files {
+			names = append(names, filepath.Base(f))
+		}
+		require.ElementsMatch(t, []string{"example.txt", "another.go"}, names, "root %q", root)
+	}
+}
