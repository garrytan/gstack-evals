+/**
+ * Whether the given action location resolves to the current origin
+ * @param {string | undefined} value
+ * @returns {boolean}
+ */
+export function is_same_origin_location(value) {
+	if (value === undefined) return true;
+	return resolve_url(value).origin === origin;
