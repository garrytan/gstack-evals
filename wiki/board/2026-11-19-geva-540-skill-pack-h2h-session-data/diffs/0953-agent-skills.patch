-	return location.pathname + location.search;
+	// a pathname beginning with `//` would otherwise produce a protocol-relative URL
+	// (e.g. `//evil.com/...`) that resolves to another origin. Prefixing it with `/.`
+	// preserves the double slash while keeping it a path on the current origin
+	const pathname = location.pathname.startsWith('//')
+		? '/.' + location.pathname
+		: location.pathname;
+
+	return pathname + location.search;
