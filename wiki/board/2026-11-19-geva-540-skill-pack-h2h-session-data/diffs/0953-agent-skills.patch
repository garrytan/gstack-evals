+
+test('get_action_location does not produce protocol-relative locations for paths beginning with //', async () => {
+	const { get_action_location } = await import('./actions.js');
+	const location = get_action_location(new URL('http://localhost//evil.com/a?/save&x=1'));
+
+	expect(location.startsWith('//')).toBe(false);
+	// resolves to the same path on the current origin, preserving the double slash
+	const resolved = new URL(location, 'http://localhost/');
+	expect(resolved.origin).toBe('http://localhost');
+	expect(resolved.pathname).toBe('//evil.com/a');
+	expect(resolved.search).toBe('?x=1');
+});
+
+test('get_action_location keeps ordinary paths unchanged', async () => {
+	const { get_action_location } = await import('./actions.js');
+	expect(get_action_location(new URL('http://localhost/a/b?/save&x=1'))).toBe('/a/b?x=1');
+});
