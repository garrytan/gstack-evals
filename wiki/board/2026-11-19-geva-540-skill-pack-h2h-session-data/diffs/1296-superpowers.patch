+// validateProxySegment ensures a route parameter used to build the upstream
+// URL is a single, literal path segment that cannot alter the target path.
+func validateProxySegment(field, value string) error {
+	if value == "" {
+		return fmt.Errorf("invalid %s: must not be empty", field)
+	}
+	if value == "." || value == ".." || strings.ContainsAny(value, "/\\%?#") {
+		return fmt.Errorf("invalid %s", field)
+	}
+	for _, r := range value {
+		if r < 0x20 || r == 0x7f {
+			return fmt.Errorf("invalid %s", field)
+		}
+	}
+	return nil
+}
+
+// hasDotSegment reports whether p, or any percent-decoded form of it, contains
+// "." or ".." path segments (using "/" or "\\" as separators).
+func hasDotSegment(p string) bool {
+	for i := 0; i < 5; i++ {
+		for _, seg := range strings.FieldsFunc(p, func(r rune) bool { return r == '/' || r == '\\' }) {
+			if seg == "." || seg == ".." {
+				return true
+			}
+		}
+		decoded, err := url.PathUnescape(p)
+		if err != nil {
+			// Malformed escapes are rejected to avoid ambiguity.
+			return true
+		}
+		if decoded == p {
+			return false
+		}
+		p = decoded
+	}
+	// Excessive nested encoding is treated as suspicious.
+	return true
+}
+
 func buildProxyURL(host, kind, namespace, name, path, rawQuery string) (string, error) {
-	path, err := url.JoinPath(host, "api/v1/namespaces", namespace, kind, name, "proxy", path)
+	if err := validateProxySegment("kind", kind); err != nil {
+		return "", err
+	}
+	if err := validateProxySegment("namespace", namespace); err != nil {
+		return "", err
+	}
+	if err := validateProxySegment("name", name); err != nil {
+		return "", err
+	}
+	if hasDotSegment(path) || strings.ContainsAny(path, "?#") {
+		return "", errors.New("invalid proxy path")
+	}
+
+	base, err := url.Parse(host)
+	if err != nil {
+		return "", err
+	}
+	prefix := strings.TrimSuffix(base.Path, "/") + "/api/v1/namespaces/" + namespace + "/" + kind + "/" + name + "/proxy"
+
+	path, err = url.JoinPath(host, "api/v1/namespaces", namespace, kind, name, "proxy", path)
 	if err != nil {
 		return "", err
 	}
