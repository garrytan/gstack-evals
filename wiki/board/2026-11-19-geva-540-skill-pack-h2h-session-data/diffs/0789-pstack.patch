+import { flushSync } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	html: `<button>click</button><p>false false</p>`,
+
+	test({ assert, target }) {
+		const button = /** @type {HTMLButtonElement} */ (target.querySelector('button'));
+
+		flushSync(() => button.click());
+		assert.htmlEqual(
+			target.innerHTML,
+			`<button>click</button><span>false</span><p>false false</p>`
+		);
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, `<button>click</button><p>false true</p>`);
+	}
+});
