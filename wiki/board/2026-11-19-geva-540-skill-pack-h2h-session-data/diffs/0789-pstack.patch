diff --git a/packages/svelte/tests/runtime-runes/samples/abort-signal-mutation/Component.svelte b/packages/svelte/tests/runtime-runes/samples/abort-signal-mutation/Component.svelte
new file mode 100644
index 0000000..473e13c
--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/abort-signal-mutation/Component.svelte
@@ -0,0 +1,24 @@
+<script>
+	import { onMount, getAbortSignal } from 'svelte';
+
+	const { test } = $props();
+
+	onMount(() => {
+		const signal = getAbortSignal();
+
+		test.value = true;
+		signal.addEventListener('abort', () => {
+			test.unmounted = true;
+		});
+	});
+
+	const value = $derived.by(() => {
+		const signal = getAbortSignal();
+		signal.addEventListener('abort', () => {
+			test.value = false;
+		});
+		return test.value;
+	});
+</script>
+
+<span>{value}</span>
