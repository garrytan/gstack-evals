+		return float64(math.Float32frombits(binary.BigEndian.Uint32(payload[offset:]))), nil
 	}
 	return 0, fmt.Errorf("unknown decode type: %s", decode)
 }
diff --git a/plugin/aa55udp_test.go b/plugin/aa55udp_test.go
index a617a6f..38c9949 100644
--- a/plugin/aa55udp_test.go
+++ b/plugin/aa55udp_test.go
@@ -158,8 +158,17 @@ func TestDecodeAt_TooShort(t *testing.T) {
 	require.Error(t, err)
 }
 
+func TestDecodeAt_Float32BE(t *testing.T) {
+	// 1234.5 as IEEE-754 big-endian
+	for _, d := range []string{"float32be", "float32"} {
+		v, err := decodeAt([]byte{0x44, 0x9A, 0x50, 0x00}, 0, d)
+		require.NoError(t, err)
+		assert.Equal(t, 1234.5, v)
+	}
+}
+
 func TestDecodeAt_UnknownType(t *testing.T) {
-	_, err := decodeAt(make([]byte, 4), 0, "float32")
+	_, err := decodeAt(make([]byte, 4), 0, "float64")
 	require.Error(t, err)
 }
 
