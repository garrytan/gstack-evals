diff --git a/tests/unit/classes/node_helper_spec.js b/tests/unit/classes/node_helper_spec.js
new file mode 100644
index 0000000..e1abaa0
--- /dev/null
+++ b/tests/unit/classes/node_helper_spec.js
@@ -0,0 +1,42 @@
+const NodeHelper = require("../../../js/node_helper");
+
+describe("NodeHelper socket dispatcher", () => {
+	let originalConfig;
+
+	beforeEach(() => {
+		originalConfig = global.config;
+		process.env.SECRET_NODE_HELPER_TEST = "super-secret-value";
+	});
+
+	afterEach(() => {
+		global.config = originalConfig;
+		delete process.env.SECRET_NODE_HELPER_TEST;
+	});
+
+	it("does not expand SECRET_* placeholders in inbound socket payloads", () => {
+		global.config = { hideConfigSecrets: true, cors: "disabled" };
+
+		const helper = new NodeHelper();
+		helper.setName("test_module");
+		const received = [];
+		helper.socketNotificationReceived = (notification, payload) => received.push({ notification, payload });
+
+		let onAny;
+		const fakeIo = {
+			of () {
+				return {
+					on (_event, cb) {
+						cb({ onAny (fn) { onAny = fn; } });
+					}
+				};
+			}
+		};
+		helper.setSocketIO(fakeIo);
+
+		onAny("TEST", { value: "**SECRET_NODE_HELPER_TEST**" });
+
+		expect(received).toHaveLength(1);
+		expect(received[0].payload.value).toBe("**SECRET_NODE_HELPER_TEST**");
+		expect(JSON.stringify(received)).not.toContain("super-secret-value");
+	});
+});
