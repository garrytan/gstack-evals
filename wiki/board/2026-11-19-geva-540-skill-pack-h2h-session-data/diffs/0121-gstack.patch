+    /**
+     * Converts a glob pattern into a regex over {@code /}-separated store keys. Unlike
+     * {@link FileSystems#getDefault()} path matchers, this is platform independent (store keys
+     * always use {@code /}) and treats {@code **}{@code /} as zero or more directories, so
+     * {@code **}{@code /hello.txt} also matches a root-level {@code hello.txt}.
+     *
+     * <p>Supported syntax: {@code **}, {@code *}, {@code ?}, {@code [...]} (with {@code !} or
+     * {@code ^} negation), {@code {a,b}} and {@code \} escapes.
+     */
+    static java.util.regex.Pattern globToRegex(String glob) {
+        StringBuilder sb = new StringBuilder();
+        int len = glob.length();
+        int braceDepth = 0;
+        int i = 0;
+        while (i < len) {
+            char c = glob.charAt(i);
+            switch (c) {
+                case '*':
+                    if (i + 1 < len && glob.charAt(i + 1) == '*') {
+                        boolean atSegmentStart = i == 0 || glob.charAt(i - 1) == '/';
+                        if (atSegmentStart && i + 2 < len && glob.charAt(i + 2) == '/') {
+                            // "**/" -> zero or more directories
+                            sb.append("(?:.*/)?");
+                            i += 3;
+                        } else {
+                            sb.append(".*");
+                            i += 2;
+                        }
+                    } else {
+                        sb.append("[^/]*");
+                        i++;
+                    }
+                    break;
+                case '?':
+                    sb.append("[^/]");
+                    i++;
+                    break;
+                case '[':
+                    {
+                        int end = glob.indexOf(']', i + 2);
+                        if (end < 0) {
+                            sb.append("\\[");
+                            i++;
+                            break;
+                        }
+                        String body = glob.substring(i + 1, end);
+                        StringBuilder cls = new StringBuilder("[");
+                        int j = 0;
+                        if (body.charAt(0) == '!' || body.charAt(0) == '^') {
+                            cls.append('^');
+                            j = 1;
+                        }
+                        for (; j < body.length(); j++) {
+                            char bc = body.charAt(j);
+                            if (bc == '\\' || bc == '[' || bc == ']' || bc == '&' || bc == '^') {
+                                cls.append('\\');
+                            }
+                            cls.append(bc);
+                        }
+                        cls.append(']');
+                        sb.append("(?:(?!/)").append(cls).append(')');
+                        i = end + 1;
+                        break;
+                    }
+                case '{':
+                    sb.append("(?:");
+                    braceDepth++;
+                    i++;
+                    break;
+                case '}':
+                    if (braceDepth > 0) {
+                        sb.append(')');
+                        braceDepth--;
+                    } else {
+                        sb.append("\\}");
+                    }
+                    i++;
+                    break;
+                case ',':
+                    sb.append(braceDepth > 0 ? "|" : ",");
+                    i++;
+                    break;
+                case '\\':
+                    if (i + 1 < len) {
+                        sb.append(
+                                java.util.regex.Pattern.quote(String.valueOf(glob.charAt(i + 1))));
+                        i += 2;
+                    } else {
+                        sb.append("\\\\");
+                        i++;
+                    }
+                    break;
+                default:
+                    if ("().+|^$".indexOf(c) >= 0) {
+                        sb.append('\\');
+                    }
+                    sb.append(c);
+                    i++;
+            }
+        }
+        while (braceDepth-- > 0) {
+            sb.append(')');
+        }
+        return java.util.regex.Pattern.compile(sb.toString());
+    }
