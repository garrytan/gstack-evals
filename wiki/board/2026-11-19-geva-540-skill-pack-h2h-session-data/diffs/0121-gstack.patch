+package io.agentscope.harness.agent.filesystem;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.harness.agent.filesystem.model.FileInfo;
+import io.agentscope.harness.agent.filesystem.model.GlobResult;
+import io.agentscope.harness.agent.filesystem.remote.RemoteFilesystem;
+import io.agentscope.harness.agent.filesystem.remote.store.InMemoryStore;
+import java.util.List;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+class RemoteFilesystemGlobTest {
+
+    private static final RuntimeContext CTX = RuntimeContext.empty();
+
+    private RemoteFilesystem fs;
+
+    @BeforeEach
+    void setUp() {
+        fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        for (String p :
+                List.of(
+                        "/hello.txt",
+                        "/notes.md",
+                        "/reports/hello.txt",
+                        "/reports/report.txt",
+                        "/reports/archive/hello.txt")) {
+            assertTrue(fs.write(CTX, p, "hello").isSuccess());
+        }
+    }
+
+    private List<String> glob(String pattern, String path) {
+        GlobResult r = fs.glob(CTX, pattern, path);
+        assertTrue(r.isSuccess());
+        return r.matches().stream().map(FileInfo::path).toList();
+    }
+
+    @Test
+    void recursiveGlobMatchesRootFile() {
+        assertEquals(
+                List.of("/hello.txt", "/reports/archive/hello.txt", "/reports/hello.txt"),
+                glob("**/hello.txt", "/"));
+    }
+
+    @Test
+    void recursiveExtensionGlobMatchesRootFile() {
+        assertEquals(
+                List.of(
+                        "/hello.txt",
+                        "/reports/archive/hello.txt",
+                        "/reports/hello.txt",
+                        "/reports/report.txt"),
+                glob("**/*.txt", "/"));
+    }
+
+    @Test
+    void recursiveGlobMatchesDirectChildOfSubdirectory() {
+        assertEquals(
+                List.of("/reports/archive/hello.txt", "/reports/hello.txt"),
+                glob("**/hello.txt", "/reports"));
+    }
+
+    @Test
+    void nonRecursivePatternsStillWork() {
+        assertEquals(
+                List.of("/reports/hello.txt", "/reports/report.txt"), glob("reports/*.txt", "/"));
+        assertEquals(List.of("/notes.md"), glob("*.md", "/"));
+        assertEquals(List.of("/notes.md", "/reports/report.txt"), glob("{*.md,report.txt}", "/"));
+    }
+}
