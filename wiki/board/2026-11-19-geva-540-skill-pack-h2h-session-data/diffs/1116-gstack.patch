diff --git a/test/dom/serializer.test.js b/test/dom/serializer.test.js
index 4bd555a..f07e70a 100644
--- a/test/dom/serializer.test.js
+++ b/test/dom/serializer.test.js
@@ -620,3 +620,37 @@ describe('NodeList.toString', () => {
 		});
 	});
 });
+
+describe('requireWellFormed element name validation', () => {
+	let doc;
+	beforeEach(() => {
+		doc = new DOMImplementation().createDocument(null, 'root', null);
+	});
+	test('emits invalid element name verbatim by default', () => {
+		doc.documentElement.appendChild(doc.createElement('img src=x onerror="alert(1)"'));
+		expect(new XMLSerializer().serializeToString(doc)).toBe('<root><img src=x onerror="alert(1)"/></root>');
+	});
+	test('throws InvalidStateError for invalid element name', () => {
+		doc.documentElement.appendChild(doc.createElement('img src=x onerror="alert(1)"'));
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+	test.each(['a b', 'a>', '1a', 'a:b:c', ':a', ''])('throws for element name %j', (name) => {
+		const el = doc.createElement('x');
+		el.tagName = el.nodeName = name;
+		doc.documentElement.appendChild(el);
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+	test('accepts valid element names', () => {
+		doc.documentElement.appendChild(doc.createElement('a-b.c_d'));
+		doc.documentElement.appendChild(doc.createElementNS('urn:x', 'p:e'));
+		expect(new XMLSerializer().serializeToString(doc, { requireWellFormed: true })).toBe(
+			'<root><a-b.c_d/><p:e xmlns:p="urn:x"/></root>'
+		);
+	});
+	test('throws for invalid prefix in synthesized xmlns declaration', () => {
+		const el = doc.createElementNS('urn:x', 'p:e');
+		el.prefix = 'b c';
+		doc.documentElement.appendChild(el);
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+});
