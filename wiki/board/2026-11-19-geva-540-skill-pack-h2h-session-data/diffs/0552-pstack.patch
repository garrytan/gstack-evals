@@ -25,6 +25,9 @@
   * For **MaxBatchSize**, a value less than or equal to **zero** will be rejected.
   * The ctor for **QuartzScheduler** no longer takes an **idleWaitTime** argument. This value
     is now obtained from a newly introduced **IdleWaitTime** property on **QuartzSchedulerResources**.
+  * **TaskSchedulingThreadPool.GetDefaultScheduler()** now takes a **CancellationToken** that is canceled when the
+    thread pool shuts down. Implementations that own resources, such as dedicated threads, should release them on cancellation.
+    This fixes threads leaking from **DedicatedThreadPool** after the scheduler is shut down.
 
   * `SystemTime` was removed as way to provide "now", you can inject `TimeProvider` via configuration or `SchedulerBuilder.UseTimeProvider<T>()`
 
diff --git a/src/Quartz.Tests.Unit/Simpl/DedicatedThreadPoolTest.cs b/src/Quartz.Tests.Unit/Simpl/DedicatedThreadPoolTest.cs
new file mode 100644
index 0000000..4197c53
--- /dev/null
+++ b/src/Quartz.Tests.Unit/Simpl/DedicatedThreadPoolTest.cs
@@ -0,0 +1,52 @@
+using Quartz.Simpl;
+
+namespace Quartz.Tests.Unit.Simpl;
+
+public class DedicatedThreadPoolTest
+{
+    [Test]
+    public void ShutdownStopsDedicatedThreads()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread dedicatedThread = null;
+        var jobRan = new ManualResetEventSlim();
+        threadPool.RunInThread(() =>
+        {
+            dedicatedThread = Thread.CurrentThread;
+            jobRan.Set();
+            return Task.CompletedTask;
+        });
+
+        Assert.That(jobRan.Wait(TimeSpan.FromSeconds(5)), Is.True);
+        Assert.That(dedicatedThread.IsThreadPoolThread, Is.False);
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        Assert.That(dedicatedThread.Join(TimeSpan.FromSeconds(5)), Is.True, "dedicated thread exited after shutdown");
+    }
+
+    [Test]
+    public void ShutdownWaitsForJobThatAwaitsAcrossShutdown()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        var jobStarted = new ManualResetEventSlim();
+        var jobCompleted = false;
+        threadPool.RunInThread(async () =>
+        {
+            jobStarted.Set();
+            await Task.Delay(TimeSpan.FromMilliseconds(200));
+            jobCompleted = true;
+        });
+
+        Assert.That(jobStarted.Wait(TimeSpan.FromSeconds(5)), Is.True);
+
+        var shutdown = Task.Run(() => threadPool.Shutdown(waitForJobsToComplete: true));
+
+        Assert.That(shutdown.Wait(TimeSpan.FromSeconds(5)), Is.True, "shutdown completed");
+        Assert.That(jobCompleted, Is.True);
+    }
+}
