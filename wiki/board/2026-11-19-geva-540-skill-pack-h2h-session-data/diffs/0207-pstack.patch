index 663cbe4..22a17e1 100644
--- a/test/Riok.Mapperly.Tests/Mapping/ObjectPropertyUseNamedMappingTest.cs
+++ b/test/Riok.Mapperly.Tests/Mapping/ObjectPropertyUseNamedMappingTest.cs
@@ -867,4 +867,60 @@ public class ObjectPropertyUseNamedMappingTest
 
         return TestHelper.VerifyGenerator(source);
     }
+
+    [Fact]
+    public void ExternalNonGenericAndGenericReferencedMappingsShouldEachBeUsed()
+    {
+        var source = TestSourceBuilder.CSharp(
+            """
+            using Riok.Mapperly.Abstractions;
+
+            class A { public string? NullableStr { get; set; } public string Str { get; set; } public int Value { get; set; } public int Plain { get; set; } }
+            class B { public string? NullableStr { get; set; } public string Str { get; set; } public int Value { get; set; } public int Plain { get; set; } }
+
+            static class OtherMapper
+            {
+                public static string? TrimToNull(string? input) => input;
+                public static string Trim(string input) => input.Trim();
+                public static T Identity<T>(T input) => input;
+            }
+
+            [Mapper]
+            public static partial class Mapper
+            {
+                [MapProperty(nameof(A.NullableStr), nameof(B.NullableStr), Use = nameof(@OtherMapper.TrimToNull))]
+                [MapProperty(nameof(A.Str), nameof(B.Str), Use = nameof(@OtherMapper.Trim))]
+                [MapProperty(nameof(A.Value), nameof(B.Value), Use = nameof(@OtherMapper.Identity))]
+                public static partial B Map(A source);
+
+                [MapProperty(nameof(A.NullableStr), nameof(B.NullableStr), Use = nameof(@OtherMapper.TrimToNull))]
+                [MapProperty(nameof(A.Str), nameof(B.Str), Use = nameof(@OtherMapper.Trim))]
+                [MapProperty(nameof(A.Value), nameof(B.Value), Use = nameof(@OtherMapper.Identity))]
+                public static partial void Update(A source, [MappingTarget] B target);
+            }
+            """
+        );
+        TestHelper
+            .GenerateMapper(source)
+            .Should()
+            .HaveMapMethodBody(
+                """
+                var target = new global::B();
+                target.NullableStr = global::OtherMapper.TrimToNull(source.NullableStr);
+                target.Str = global::OtherMapper.Trim(source.Str);
+                target.Value = global::OtherMapper.Identity<int>(source.Value);
+                target.Plain = source.Plain;
+                return target;
+                """
+            )
+            .HaveMethodBody(
+                "Update",
+                """
+                target.NullableStr = global::OtherMapper.TrimToNull(source.NullableStr);
+                target.Str = global::OtherMapper.Trim(source.Str);
+                target.Value = global::OtherMapper.Identity<int>(source.Value);
+                target.Plain = source.Plain;
+                """
+            );
+    }
 }
