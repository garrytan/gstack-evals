@@ -0,0 +1,64 @@
+package openapi3filter
+
+import (
+	"bytes"
+	"context"
+	"mime/multipart"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestConvertErrorsMultipartInvalidScalarNoPanic(t *testing.T) {
+	const spec = `
+openapi: '3.0.3'
+info: {title: t, version: '1.0.0'}
+paths:
+  /upload:
+    post:
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              properties:
+                age: {type: integer}
+      responses:
+        '200': {description: ok}
+`
+	loader := openapi3.NewLoader()
+	doc, err := loader.LoadFromData([]byte(spec))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(loader.Context))
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+
+	var buf bytes.Buffer
+	w := multipart.NewWriter(&buf)
+	require.NoError(t, w.WriteField("age", "notanumber"))
+	require.NoError(t, w.Close())
+
+	r, err := http.NewRequest(http.MethodPost, "/upload", &buf)
+	require.NoError(t, err)
+	r.Header.Set("Content-Type", w.FormDataContentType())
+	route, pp, err := router.FindRoute(r)
+	require.NoError(t, err)
+
+	reqErr := ValidateRequest(context.Background(), &RequestValidationInput{
+		Request: r, PathParams: pp, Route: route,
+		Options: &Options{AuthenticationFunc: NoopAuthenticationFunc},
+	})
+	require.Error(t, reqErr)
+
+	var converted error
+	require.NotPanics(t, func() { converted = ConvertErrors(reqErr) })
+	verr, ok := converted.(*ValidationError)
+	require.True(t, ok, "got %T", converted)
+	require.Equal(t, http.StatusBadRequest, verr.Status)
+	require.NotEmpty(t, verr.Title)
+}
