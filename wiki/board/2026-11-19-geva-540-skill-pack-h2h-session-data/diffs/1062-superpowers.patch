@@ -59,3 +57,21 @@ func SetAuthHeaders(header http.Header, user userinfo.Info, userHeader, groupHea
 		}
 	}
 }
+
+// StripAuthHeaders removes all inbound identity headers (user, group and any
+// header with the extra prefix) from the given header set. It must be called
+// unconditionally on every request a proxy forwards to a backend that trusts
+// request-header authentication, regardless of whether the request carries an
+// authenticated user, so client-supplied values can never be forwarded.
+func StripAuthHeaders(header http.Header, userHeader, groupHeader, extraHeaderPrefix string) {
+	header.Del(userHeader)
+	header.Del(groupHeader)
+	lowerPrefix := strings.ToLower(extraHeaderPrefix)
+	for key := range header {
+		lowerKey := strings.ToLower(key)
+		if lowerKey == strings.ToLower(userHeader) || lowerKey == strings.ToLower(groupHeader) ||
+			(lowerPrefix != "" && strings.HasPrefix(lowerKey, lowerPrefix)) {
+			delete(header, key)
+		}
+	}
+}
diff --git a/pkg/proxy/authheaders/authheaders_test.go b/pkg/proxy/authheaders/authheaders_test.go
index 258c208..8b2ff1d 100644
--- a/pkg/proxy/authheaders/authheaders_test.go
+++ b/pkg/proxy/authheaders/authheaders_test.go
@@ -142,3 +142,24 @@ func TestSetAuthHeaders_RealExtraIsEncodedAndForwarded(t *testing.T) {
 		t.Errorf("encoded extra header %q = %v, want [root:org:ws]; full headers=%v", encoded, got, h)
 	}
 }
+
+func TestStripAuthHeaders_RemovesAllIdentityHeaders(t *testing.T) {
+	t.Parallel()
+	h := http.Header{
+		userHeader:           {"system:admin"},
+		groupHeader:          {"system:masters"},
+		warrantHeader:        {"{}"},
+		scopesHeader:         {"cluster:root"},
+		"x-remote-extra-foo": {"bar"},
+		"Accept":             {"application/json"},
+	}
+	StripAuthHeaders(h, userHeader, groupHeader, extraPrefix)
+	for k := range h {
+		if k != "Accept" {
+			t.Errorf("header %q not stripped: %v", k, h[k])
+		}
+	}
+	if h.Get("Accept") != "application/json" {
+		t.Errorf("unrelated header removed")
+	}
+}
