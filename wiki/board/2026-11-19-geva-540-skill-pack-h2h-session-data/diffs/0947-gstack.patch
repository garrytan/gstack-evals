+// hasItemsSchema reports whether an array schema has a non-nil items schema.
+func hasItemsSchema(schema *openapi3.SchemaRef) bool {
+	return schema != nil && schema.Value != nil && schema.Value.Items != nil && schema.Value.Items.Value != nil
