diff --git a/openapi3filter/array_items_nil_test.go b/openapi3filter/array_items_nil_test.go
new file mode 100644
index 0000000..c007d96
--- /dev/null
+++ b/openapi3filter/array_items_nil_test.go
@@ -0,0 +1,162 @@
+package openapi3filter_test
+
+import (
+	"bytes"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+const arrayNoItemsSpec31 = `
+openapi: 3.1.0
+info: {title: t, version: 1.0.0}
+paths:
+  /f:
+    post:
+      requestBody:
+        required: true
+        content:
+          application/x-www-form-urlencoded:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /upload:
+    post:
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /hdr:
+    get:
+      responses:
+        '200':
+          description: ok
+          headers:
+            X-Tags:
+              schema: {type: array}
+  /q:
+    get:
+      parameters:
+        - name: tags
+          in: query
+          schema: {type: array}
+        - name: deep
+          in: query
+          style: deepObject
+          schema:
+            type: object
+            properties:
+              arr: {type: array}
+      responses:
+        '200': {description: ok}
+  /p/{tags}:
+    get:
+      parameters:
+        - name: tags
+          in: path
+          required: true
+          schema: {type: array}
+        - name: c
+          in: cookie
+          schema: {type: array}
+        - name: X-H
+          in: header
+          schema: {type: array}
+      responses:
+        '200': {description: ok}
+`
+
+func TestArrayWithoutItemsDoesNotPanic(t *testing.T) {
+	loader := openapi3.NewLoader()
+	doc, err := loader.LoadFromData([]byte(arrayNoItemsSpec31))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(loader.Context))
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+
+	opts := &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc}
+	input := func(req *http.Request) *openapi3filter.RequestValidationInput {
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+		return &openapi3filter.RequestValidationInput{Request: req, PathParams: pathParams, Route: route, Options: opts}
+	}
+
+	t.Run("urlencoded", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodPost, "/f", strings.NewReader("tags=a"))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		require.NotPanics(t, func() {
+			require.Error(t, openapi3filter.ValidateRequest(loader.Context, input(req)))
+		})
+	})
+
+	t.Run("multipart", func(t *testing.T) {
+		var buf bytes.Buffer
+		w := multipart.NewWriter(&buf)
+		require.NoError(t, w.WriteField("tags", "a"))
+		require.NoError(t, w.Close())
+		req, _ := http.NewRequest(http.MethodPost, "/upload", &buf)
+		req.Header.Set("Content-Type", w.FormDataContentType())
+		require.NotPanics(t, func() {
+			require.Error(t, openapi3filter.ValidateRequest(loader.Context, input(req)))
+		})
+	})
+
+	t.Run("response header", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/hdr", nil)
+		require.NotPanics(t, func() {
+			err := openapi3filter.ValidateResponse(loader.Context, &openapi3filter.ResponseValidationInput{
+				RequestValidationInput: input(req),
+				Status:                 http.StatusOK,
+				Header:                 http.Header{"X-Tags": []string{"a,b"}},
+				Body:                   io.NopCloser(strings.NewReader("")),
+			})
+			require.Error(t, err)
+		})
+	})
+
+	for _, u := range []string{"/q?tags=a&tags=b", "/q?deep[arr][0]=a"} {
+		t.Run("query "+u, func(t *testing.T) {
+			req, _ := http.NewRequest(http.MethodGet, u, nil)
+			require.NotPanics(t, func() {
+				require.Error(t, openapi3filter.ValidateRequest(loader.Context, input(req)))
+			})
+		})
+	}
+
+	t.Run("path", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/p/a,b", nil)
+		require.NotPanics(t, func() {
+			require.Error(t, openapi3filter.ValidateRequest(loader.Context, input(req)))
+		})
+	})
+
+	t.Run("cookie and header", func(t *testing.T) {
+		for _, set := range []func(*http.Request){
+			func(r *http.Request) { r.AddCookie(&http.Cookie{Name: "c", Value: "a,b"}) },
+			func(r *http.Request) { r.Header.Set("X-H", "a,b") },
+		} {
+			req, _ := http.NewRequest(http.MethodGet, "/p/x", nil)
+			set(req)
+			require.NotPanics(t, func() {
+				_ = openapi3filter.ValidateRequest(loader.Context, input(req))
+			})
+		}
+	})
+}
