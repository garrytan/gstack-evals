+// ─── bulkDownload .goshs ACL enforcement (GHSA-rmxw-pq4x-3fvh) ──────────────
+
+func setupBulkACL(t *testing.T) (*FileServer, string) {
+	t.Helper()
+	dir := t.TempDir()
+	prot := filepath.Join(dir, "protected")
+	require.NoError(t, os.MkdirAll(prot, 0755))
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := fmt.Sprintf(`{"auth":"admin:%s","block":["blocked.txt","hidden/"]}`, string(hash))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, ".goshs"), []byte(acl), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "secret.txt"), []byte("TOPSECRET"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "blocked.txt"), []byte("BLOCKEDDATA"), 0644))
+	require.NoError(t, os.MkdirAll(filepath.Join(prot, "hidden"), 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "hidden", "h.txt"), []byte("HIDDENDATA"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "public.txt"), []byte("PUBLIC"), 0644))
+	fs, _ := newTestFileServer(t, dir)
+	return fs, dir
+}
+
+func zipContents(t *testing.T, body []byte) map[string]string {
+	t.Helper()
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	out := map[string]string{}
+	for _, f := range zr.File {
+		rc, err := f.Open()
+		require.NoError(t, err)
+		b, _ := io.ReadAll(rc)
+		rc.Close()
+		out[f.Name] = string(b)
+	}
+	return out
+}
+
+func TestBulkDownload_ACLRequiresAuth(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	for _, q := range []string{"/?bulk&file=/protected/secret.txt", "/?bulk&file=/protected", "/?bulk&file=/", "/?bulk&file=/public.txt&file=/protected/secret.txt"} {
+		r := httptest.NewRequest(http.MethodGet, q, nil)
+		w := httptest.NewRecorder()
+		fs.bulkDownload(w, r)
+		require.Equal(t, http.StatusUnauthorized, w.Code, q)
+		require.NotContains(t, w.Body.String(), "TOPSECRET", q)
+	}
+	// wrong creds
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected/secret.txt", nil)
+	r.SetBasicAuth("admin", "wrong")
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+}
+
+func TestBulkDownload_ACLAuthorizedHonorsBlock(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected&file=/protected/blocked.txt&file=/protected/hidden/h.txt&file=/protected/.goshs", nil)
+	r.SetBasicAuth("admin", "admin")
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	c := zipContents(t, w.Body.Bytes())
+	require.Equal(t, "TOPSECRET", c["protected/secret.txt"])
+	for name := range c {
+		require.NotContains(t, name, "blocked.txt")
+		require.NotContains(t, name, ".goshs")
+		require.NotContains(t, name, "hidden")
+	}
+}
+
+func TestBulkDownload_PublicUnaffected(t *testing.T) {
+	fs, _ := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/public.txt", nil)
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, "PUBLIC", zipContents(t, w.Body.Bytes())["public.txt"])
+}
