diff --git a/openapi3/schema_circular_xof_test.go b/openapi3/schema_circular_xof_test.go
new file mode 100644
index 0000000..0aa6a7d
--- /dev/null
+++ b/openapi3/schema_circular_xof_test.go
@@ -0,0 +1,89 @@
+package openapi3
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestVisitJSONCircularCombinators(t *testing.T) {
+	str := &Schema{Type: &Types{"string"}}
+	newObject := func() *Schema {
+		return &Schema{Type: &Types{"object"}, Properties: Schemas{"name": {Value: str}}}
+	}
+
+	allOf := newObject()
+	allOf.AllOf = SchemaRefs{{Value: allOf}}
+
+	anyOf := newObject()
+	anyOf.AnyOf = SchemaRefs{{Value: anyOf}}
+
+	oneOf := newObject()
+	oneOf.OneOf = SchemaRefs{{Value: oneOf}}
+
+	not := newObject()
+	not.Not = &SchemaRef{Value: not}
+
+	a, b := newObject(), newObject()
+	a.AllOf = SchemaRefs{{Value: b}}
+	b.AnyOf = SchemaRefs{{Value: a}}
+
+	for name, schema := range map[string]*Schema{"allOf": allOf, "anyOf": anyOf, "oneOf": oneOf, "not": not, "mutual": a} {
+		t.Run(name, func(t *testing.T) {
+			require.NoError(t, schema.Validate(context.Background()))
+			_ = schema.VisitJSON(map[string]any{"name": "test"})
+			_ = schema.VisitJSON(map[string]any{"name": "test"}, VisitAsRequest())
+			_ = schema.VisitJSON(nil)
+		})
+	}
+
+	require.NoError(t, allOf.VisitJSON(map[string]any{"name": "test"}))
+	require.Error(t, allOf.VisitJSON(map[string]any{"name": 1}))
+	require.Error(t, not.VisitJSON(map[string]any{"name": "test"}))
+}
+
+func TestVisitJSONDiscriminatorBaseReferencedByVariants(t *testing.T) {
+	spec := []byte(`
+openapi: 3.0.0
+info: {title: t, version: "1"}
+paths: {}
+components:
+  schemas:
+    Pet:
+      type: object
+      required: [kind]
+      properties:
+        kind: {type: string}
+      discriminator:
+        propertyName: kind
+        mapping:
+          cat: '#/components/schemas/Cat'
+          dog: '#/components/schemas/Dog'
+      oneOf:
+        - $ref: '#/components/schemas/Cat'
+        - $ref: '#/components/schemas/Dog'
+    Cat:
+      allOf:
+        - $ref: '#/components/schemas/Pet'
+        - type: object
+          required: [meows]
+          properties:
+            meows: {type: boolean}
+    Dog:
+      allOf:
+        - $ref: '#/components/schemas/Pet'
+        - type: object
+          required: [barks]
+          properties:
+            barks: {type: boolean}
+`)
+	doc, err := NewLoader().LoadFromData(spec)
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(context.Background()))
+
+	pet := doc.Components.Schemas["Pet"].Value
+	require.NoError(t, pet.VisitJSON(map[string]any{"kind": "cat", "meows": true}))
+	require.Error(t, pet.VisitJSON(map[string]any{"kind": "cat", "barks": true}))
+	require.Error(t, pet.VisitJSON(map[string]any{"kind": "dog", "barks": "loud"}))
+}
diff --git a/openapi3filter/circular_xof_test.go b/openapi3filter/circular_xof_test.go
new file mode 100644
index 0000000..0cca745
--- /dev/null
+++ b/openapi3filter/circular_xof_test.go
@@ -0,0 +1,84 @@
+package openapi3filter
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestValidateRequestCircularCombinators(t *testing.T) {
+	const specTemplate = `
+openapi: 3.0.0
+info: {title: t, version: "1"}
+paths:
+  /test:
+    get:
+      parameters:
+        - name: data
+          in: query
+          %s
+          schema: {$ref: '#/components/schemas/Recursive'}
+      responses: {'200': {description: OK}}
+components:
+  schemas:
+    Recursive:
+      %s
+      %s:
+        - $ref: '#/components/schemas/Recursive'
+      properties:
+        name: {type: string}
+`
+	for _, combinator := range []string{"allOf", "anyOf", "oneOf"} {
+		for _, style := range []string{"", "style: deepObject\n          explode: true"} {
+			for _, typ := range []string{"type: object", "", "type: array\n      items: {type: string}"} {
+				t.Run(fmt.Sprintf("%s/%q/%q", combinator, style, typ), func(t *testing.T) {
+					spec := fmt.Sprintf(specTemplate, style, typ, combinator)
+					doc, err := openapi3.NewLoader().LoadFromData([]byte(spec))
+					require.NoError(t, err)
+					require.NoError(t, doc.Validate(context.Background()))
+					router, err := gorillamux.NewRouter(doc)
+					require.NoError(t, err)
+
+					for _, query := range []string{"data=x", "data[name]=x", "data=a&data=b"} {
+						req, err := http.NewRequest(http.MethodGet, "http://example.com/test?"+query, nil)
+						require.NoError(t, err)
+						route, pathParams, err := router.FindRoute(req)
+						require.NoError(t, err)
+						err = ValidateRequest(context.Background(), &RequestValidationInput{Request: req, PathParams: pathParams, Route: route})
+						if combinator == "allOf" {
+							require.ErrorContains(t, err, errCircularSchema.Error(), query)
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestDecodeBodyCircularCombinators(t *testing.T) {
+	recursive := &openapi3.Schema{Type: &openapi3.Types{"object"}}
+	recursive.Properties = openapi3.Schemas{"name": {Value: &openapi3.Schema{
+		AnyOf: openapi3.SchemaRefs{{Value: recursive}},
+	}}}
+	inner := recursive.Properties["name"].Value
+	inner.AnyOf = openapi3.SchemaRefs{{Value: inner}}
+
+	for _, ct := range []string{"application/x-www-form-urlencoded", "multipart/form-data"} {
+		body := strings.NewReader("name=x")
+		h := http.Header{"Content-Type": {ct}}
+		if ct == "multipart/form-data" {
+			body = strings.NewReader("--b\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nx\r\n--b--\r\n")
+			h.Set("Content-Type", ct+"; boundary=b")
+		}
+		_, v, err := decodeBody(body, h, &openapi3.SchemaRef{Value: recursive}, nil)
+		require.NoError(t, err, ct)
+		require.Nil(t, v.(map[string]any)["name"], ct)
+	}
+}
