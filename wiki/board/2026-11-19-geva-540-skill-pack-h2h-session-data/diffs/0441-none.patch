     private static boolean areNeighborsTextChunks(TextChunk firstTextChunk, TextChunk secondTextChunk) {
+        double gap = secondTextChunk.getTextStart() - firstTextChunk.getTextEnd();
+        // Chunks separated by a word-sized gap belong to different words. Merging them would concatenate
+        // the words without a space (the space is later inserted by TextLineProcessor using the same threshold).
+        // The height-based epsilon alone is not sufficient: fonts with a tall bounding box produce an epsilon
+        // larger than the width of a regular space.
+        double wordSpaceThreshold = Math.min(firstTextChunk.getFontSize(), secondTextChunk.getFontSize()) *
+            TextChunkUtils.TEXT_LINE_SPACE_RATIO;
+        if (wordSpaceThreshold > 0 && gap > wordSpaceThreshold) {
+            return false;
+        }
         return NodeUtils.areCloseNumbers(firstTextChunk.getTextEnd(), secondTextChunk.getTextStart(),
             NEIGHBORS_TEXT_CHUNKS_EPSILON * firstTextChunk.getBoundingBox().getHeight());
     }
