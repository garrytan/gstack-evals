+    /**
+     * Trims leading and trailing white spaces of text chunks.
+     * <p>
+     * The trimmed white spaces are kept as separate white space chunks, so that the information about
+     * the white space between words is not lost. It is used later by {@link TextLineProcessor} to insert
+     * spaces between words even if the geometric gap between them is small (e.g. due to inaccurate glyph widths).
+     */
     public static void trimTextChunksWhiteSpaces(List<IObject> contents) {
         for (int i = 0; i < contents.size(); i++) {
             IObject object = contents.get(i);
-            if (object instanceof TextChunk) {
-                contents.set(i, ChunksMergeUtils.getTrimTextChunk((TextChunk) object));
+            if (!(object instanceof TextChunk)) {
+                continue;
+            }
+            TextChunk textChunk = (TextChunk) object;
+            String value = textChunk.getValue();
+            if (value == null || value.isEmpty() || textChunk.isWhiteSpaceChunk()) {
+                continue;
+            }
+            int length = value.length();
+            int start = 0;
+            while (start < length && TextChunkUtils.isWhiteSpaceChar(value.charAt(start))) {
+                start++;
+            }
+            int end = length;
+            while (end > start && TextChunkUtils.isWhiteSpaceChar(value.charAt(end - 1))) {
+                end--;
             }
+            TextChunk trimmedChunk = ChunksMergeUtils.getTrimTextChunk(textChunk);
+            contents.set(i, trimmedChunk);
+            if (start > 0 && start < end) {
+                TextChunk leadingSpace = createWhiteSpaceChunk(textChunk, 0, start);
+                if (leadingSpace != null) {
+                    contents.add(i, leadingSpace);
+                    i++;
+                }
+            }
+            if (end < length && start < end) {
+                TextChunk trailingSpace = createWhiteSpaceChunk(textChunk, end, length);
+                if (trailingSpace != null) {
+                    contents.add(i + 1, trailingSpace);
+                    i++;
+                }
+            }
+        }
+    }
+
+    private static TextChunk createWhiteSpaceChunk(TextChunk textChunk, int start, int end) {
+        try {
+            TextChunk spaceChunk = TextChunk.getTextChunk(textChunk, start, end);
+            if (spaceChunk == null || !spaceChunk.isWhiteSpaceChunk()) {
+                return null;
+            }
+            return spaceChunk;
+        } catch (RuntimeException e) {
+            return null;
         }
