+
+func TestSanitizeFilePathBoundary(t *testing.T) {
+	cases := []struct {
+		path, safe string
+		ok         bool
+	}{
+		{"/packages/foo", "/packages", true},
+		{"/packages/a/b", "/packages/", true},
+		{"/packages", "/packages", true},
+		{"/packages-extra/evil", "/packages", false},
+		{"/packagesevil", "/packages", false},
+		{"/etc/passwd", "/packages", false},
+		{"/packages/../etc", "/packages", false},
+		{"", "/packages", false},
+		{"/packages/x", "", false},
+	}
+	for _, c := range cases {
+		_, err := SanitizeFilePath(c.path, c.safe)
+		if (err == nil) != c.ok {
+			t.Errorf("SanitizeFilePath(%q, %q) err=%v, want ok=%v", c.path, c.safe, err, c.ok)
+		}
+	}
+}
