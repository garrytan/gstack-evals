 }
+
+func TestFlatColsUnboundedRange(t *testing.T) {
+	f := NewFile()
+	ws, ok := f.Sheet.Load("xl/worksheets/sheet1.xml")
+	assert.True(t, ok)
+	ws.(*xlsxWorksheet).Cols = &xlsxCols{Col: []xlsxCol{{Min: -5, Max: 2147483647, Width: float64Ptr(9)}}}
+	assert.NoError(t, f.SetColWidth("Sheet1", "A", "A", 12))
+	assert.Len(t, ws.(*xlsxWorksheet).Cols.Col, MaxColumns)
+	assert.NoError(t, f.Close())
+}
