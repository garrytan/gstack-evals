@@ -0,0 +1,49 @@
+import docsifyInit from '../helpers/docsify-init.js';
+import { test, expect } from './fixtures/docsify-init-fixture.js';
+
+test.describe('Coverpage', () => {
+  test('coverpage heading link focuses heading in main content', async ({
+    page,
+  }) => {
+    await docsifyInit({
+      markdown: {
+        coverpage: `
+          # Quick start
+        `,
+        homepage: `
+          # Quick start
+
+          Content
+        `,
+      },
+    });
+
+    const coverHeading = page.locator('section.cover h1 a');
+    const mainHeading = page.locator('#main h1#quick-start');
+
+    await expect(coverHeading).toBeVisible();
+    await coverHeading.click();
+    await expect(page).toHaveURL(/id=quick-start/);
+    await expect(mainHeading).toBeFocused();
+  });
+
+  test('direct URL with id focuses heading in main content', async ({
+    page,
+  }) => {
+    await docsifyInit({
+      markdown: {
+        coverpage: `
+          # Quick start
+        `,
+        homepage: `
+          # Quick start
+
+          Content
+        `,
+      },
+    });
+
+    await page.goto('/#/?id=quick-start');
+    await expect(page.locator('#main h1#quick-start')).toBeFocused();
+  });
+});
