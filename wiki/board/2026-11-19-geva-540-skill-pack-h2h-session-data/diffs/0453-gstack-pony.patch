+// ensureIgnoredTables re-creates the dolt_ignore'd wisp tables if they are
+// missing. Because they are ignored, they live only in the working set and are
+// absent after a clone, a branch switch, or a backfilled restore — even though
+// schema_migrations records migrations 0020-0023 as applied. Idempotent.
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	rows, err := tx.QueryContext(ctx, `SELECT table_name FROM information_schema.tables
+		WHERE table_schema = DATABASE() AND table_name IN
+		('wisps', 'wisp_labels', 'wisp_dependencies', 'wisp_events', 'wisp_comments')`)
+	if err != nil {
+		return fmt.Errorf("checking wisp tables: %w", err)
+	}
+	have := map[string]bool{}
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			_ = rows.Close()
+			return fmt.Errorf("checking wisp tables: %w", err)
+		}
+		have[strings.ToLower(name)] = true
+	}
+	if err := rows.Close(); err != nil {
+		return fmt.Errorf("checking wisp tables: %w", err)
+	}
+	if err := rows.Err(); err != nil {
+		return fmt.Errorf("checking wisp tables: %w", err)
+	}
+	if len(have) == 5 {
+		return nil
+	}
+
+	// Replay the migrations that build the wisp tables, skipping the
+	// non-idempotent parts for tables that already exist.
+	// dolt_ignore patterns (REPLACE, idempotent) must precede table creation.
+	stmts := []string{"0019_wisps_dolt_ignore.up.sql"}
+	if !have["wisps"] {
+		stmts = append(stmts, "0020_create_wisps.up.sql",
+			"ALTER TABLE wisps ADD COLUMN no_history TINYINT(1) DEFAULT 0") // wisps half of 0023
+	}
+	stmts = append(stmts, "0021_create_wisp_auxiliary.up.sql") // CREATE TABLE IF NOT EXISTS
+	if !have["wisp_dependencies"] {
+		stmts = append(stmts, "0022_wisp_dep_type_index.up.sql")
+	}
+
+	for _, s := range stmts {
+		query := s
+		if strings.HasSuffix(s, ".up.sql") {
+			data, err := upMigrations.ReadFile("schema/" + s)
+			if err != nil {
+				return fmt.Errorf("reading migration %s: %w", s, err)
+			}
+			query = string(data)
+		}
+		if _, err := tx.ExecContext(ctx, query); err != nil {
+			return fmt.Errorf("recreating wisp tables (%s): %w", s, err)
+		}
+	}
+	return nil
+}
+
 // backfillMigrations marks all known migrations as applied without executing them.
 // Used when a database is restored from a backup that predates the schema_migrations
 // tracking table — the schema is already correct, we just need to record that fact.
