diff --git a/packages/mcp-tools/src/utils/tools.ts b/packages/mcp-tools/src/utils/tools.ts
index 8b36540..a5bdfe8 100644
--- a/packages/mcp-tools/src/utils/tools.ts
+++ b/packages/mcp-tools/src/utils/tools.ts
@@ -47,3 +47,41 @@ export function createClientConfig(config: ContentfulConfig): ClientOptions {
 
   return clientConfig;
 }
+
+/**
+ * Option keys that control where/how requests are sent (or that can load
+ * arbitrary options from disk). These must never be taken from tool
+ * arguments, as they would let a caller redirect requests carrying the
+ * server's management token to an attacker-controlled endpoint.
+ */
+export const UNSAFE_NETWORK_OPTION_KEYS = [
+  'host',
+  'hostDelivery',
+  'hostUpload',
+  'port',
+  'basePath',
+  'baseURL',
+  'proxy',
+  'rawProxy',
+  'httpAgent',
+  'httpsAgent',
+  'insecure',
+  'config',
+  'accessToken',
+  'managementToken',
+  'adapter',
+] as const;
+
+/**
+ * Returns a shallow copy of `args` with all network/connection related
+ * options removed.
+ */
+export function stripUnsafeNetworkOptions<T extends Record<string, unknown>>(
+  args: T,
+): Omit<T, (typeof UNSAFE_NETWORK_OPTION_KEYS)[number]> {
+  const copy: Record<string, unknown> = { ...args };
+  for (const key of UNSAFE_NETWORK_OPTION_KEYS) {
+    delete copy[key];
+  }
+  return copy as Omit<T, (typeof UNSAFE_NETWORK_OPTION_KEYS)[number]>;
+}
