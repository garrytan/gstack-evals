+    it('should not pollute Object.prototype when converting to object', () => {
+      const result = convertTokenData(
+        [
+          { key: '{__proto__.foo}', value: 'malicious' },
+          { key: '{constructor.prototype.bar}', value: 'malicious' },
+        ],
+        { output: 'object' },
+      );
+      expect({}.foo).to.be.undefined;
+      expect({}.bar).to.be.undefined;
+      expect(Object.prototype.hasOwnProperty.call(result, '__proto__')).to.be.false;
+      expect(result.constructor.prototype.bar.value).to.equal('malicious');
+    });
