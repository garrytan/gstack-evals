@@ -341,3 +341,48 @@ ERROR: Test error
 		t.Error("Expected tool calls to be extracted")
 	}
 }
+
+func TestParseCopilotCodingAgentLogMetrics_IgnoresProseWords(t *testing.T) {
+	logContent := `
+Task iteration 1: Starting analysis
+The agent calls a tool to fetch data; every tool calls the server since it launches.
+Each tool call for the server is logged, or the tool on disk with misuse is rejected.
+Calling for help with the unified tool since the tool to use is unknown.
+Executing the plan with care
+Calling: startHttpServer
+Tool call: noop
+Using tool: label_agent
+`
+	metrics := ParseCopilotCodingAgentLogMetrics(logContent, false)
+
+	got := make(map[string]int)
+	for _, tc := range metrics.ToolCalls {
+		got[tc.Name] = tc.CallCount
+	}
+	want := map[string]int{"startHttpServer": 1, "noop": 1, "label_agent": 1}
+	if len(got) != len(want) {
+		t.Fatalf("Expected exactly tools %v, got %v", want, got)
+	}
+	for name, count := range want {
+		if got[name] != count {
+			t.Errorf("Expected %s to have %d calls, got %d (all: %v)", name, count, got[name], got)
+		}
+	}
+}
+
+func TestExtractToolName_RejectsProse(t *testing.T) {
+	lines := []string{
+		"every tool calls the server",
+		"the tool to use",
+		"Calling for help",
+		"each tool call for the server",
+		"Executing the plan",
+		"the tool since it launches",
+		"calling the tool",
+	}
+	for _, line := range lines {
+		if got := extractToolName(line); got != "" {
+			t.Errorf("extractToolName(%q) = %q, want empty", line, got)
+		}
+	}
+}
