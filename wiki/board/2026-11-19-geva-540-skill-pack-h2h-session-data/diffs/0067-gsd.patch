+    static final class BinaryTypesTest extends RowCompactedSerializerTest {
+        public BinaryTypesTest() {
+            super(getRowSerializer(), getData());
+        }
+
+        private static InternalRow[] getData() {
+            return new GenericRow[] {
+                GenericRow.of(null, null),
+                GenericRow.of(new byte[] {1, 2}, new byte[] {3}),
+                GenericRow.of(new byte[] {-1, 0}, new byte[0])
+            };
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(
+                    RowType.of(DataTypes.BINARY(2), DataTypes.VARBINARY(10)));
+        }
+
+        private static MemorySlice slice(byte[] f0, byte[] f1) {
+            return MemorySlice.wrap(getRowSerializer().serializeToBytes(GenericRow.of(f0, f1)));
+        }
+
+        @Test
+        public void testSliceComparatorWithBinaryFields() {
+            Comparator<MemorySlice> comparator = getRowSerializer().createSliceComparator();
+
+            MemorySlice base = slice(new byte[] {1, 2}, new byte[] {3});
+            assertThat(comparator.compare(base, slice(new byte[] {1, 2}, new byte[] {3})))
+                    .isZero();
+
+            // first field decides
+            assertThat(comparator.compare(base, slice(new byte[] {1, 3}, new byte[] {0})))
+                    .isNegative();
+            // second field breaks ties
+            assertThat(comparator.compare(base, slice(new byte[] {1, 2}, new byte[] {4})))
+                    .isNegative();
+            // shorter prefix sorts first
+            assertThat(comparator.compare(base, slice(new byte[] {1, 2}, new byte[] {3, 0})))
+                    .isNegative();
+            // unsigned byte ordering: 0xFF > 0x01
+            assertThat(comparator.compare(slice(new byte[] {-1, 0}, null), base)).isPositive();
+            // null sorts first
+            assertThat(comparator.compare(slice(null, null), base)).isNegative();
+            assertThat(comparator.compare(base, slice(new byte[] {1, 2}, null))).isPositive();
+        }
+    }
