+        [Test]
+        public async Task GlobalBackgroundClass_ShouldApply_WhenNotSetInOptions()
+        {
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-bg"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            await provider.InvokeAsync(async () => await service.ShowAsync(typeof(DialogOkCancel)));
+            provider.Find(".mud-overlay-dialog").ClassList.Should().Contain("global-bg");
+            await provider.InvokeAsync(() => ((IMudDialogInstance)provider.FindComponent<MudDialogContainer>().Instance).Close());
+
+            _ = provider.InvokeAsync(() => service.ShowMessageBoxAsync("Title", "Message"));
+            provider.WaitForAssertion(() => provider.Find(".mud-overlay-dialog").ClassList.Should().Contain("global-bg"));
+            await provider.InvokeAsync(() => ((IMudDialogInstance)provider.FindComponent<MudDialogContainer>().Instance).Close());
+
+            await provider.InvokeAsync(async () => await service.ShowAsync(typeof(DialogOkCancel), "t", new DialogOptions { BackgroundClass = "local-bg" }));
+            var classes = provider.Find(".mud-overlay-dialog").ClassList;
+            classes.Should().Contain("local-bg");
+            classes.Should().NotContain("global-bg");
+        }
+
