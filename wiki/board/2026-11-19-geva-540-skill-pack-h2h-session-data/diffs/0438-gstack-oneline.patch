diff --git a/pkg/workflow/engine_version_expression_test.go b/pkg/workflow/engine_version_expression_test.go
new file mode 100644
index 0000000..f771493
--- /dev/null
+++ b/pkg/workflow/engine_version_expression_test.go
@@ -0,0 +1,39 @@
+//go:build !integration
+
+package workflow
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestEngineVersionExpressionUsesEnvVar(t *testing.T) {
+	expr := "${{ inputs.engine-version }}"
+	engines := []CodingAgentEngine{NewCopilotEngine(), NewClaudeEngine(), NewCodexEngine(), NewGeminiEngine()}
+	for _, engine := range engines {
+		t.Run(engine.GetID(), func(t *testing.T) {
+			data := &WorkflowData{EngineConfig: &EngineConfig{ID: engine.GetID(), Version: expr}}
+			var all []string
+			for _, step := range engine.GetInstallationSteps(data) {
+				all = append(all, step...)
+			}
+			yaml := strings.Join(all, "\n")
+			if !strings.Contains(yaml, "ENGINE_VERSION: "+expr) {
+				t.Errorf("expected expression passed via ENGINE_VERSION env var, got:\n%s", yaml)
+			}
+			for _, line := range all {
+				if strings.Contains(line, "run:") && strings.Contains(line, expr) {
+					t.Errorf("expression must not be interpolated into run command: %s", line)
+				}
+			}
+		})
+	}
+}
+
+func TestEngineVersionLiteralUnchanged(t *testing.T) {
+	steps := GenerateNpmInstallSteps("@openai/codex", "1.2.3", "Install", "codex", false)
+	got := strings.Join(steps[0], "\n")
+	if !strings.Contains(got, "npm install -g @openai/codex@1.2.3") || strings.Contains(got, "ENGINE_VERSION") {
+		t.Errorf("unexpected literal version step:\n%s", got)
+	}
+}
