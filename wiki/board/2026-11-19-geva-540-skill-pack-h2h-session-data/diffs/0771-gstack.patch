+    public interface IDecorateTestService { string Name { get; } }
+    public class DecorateTestServiceA : IDecorateTestService { public string Name => "A"; }
+    public class DecorateTestServiceB : IDecorateTestService { public string Name => "B"; }
+    public class DecorateTestDecorator(IDecorateTestService inner, string suffix) : IDecorateTestService
+    {
+        public IDecorateTestService Inner { get; } = inner;
+        public string Name => Inner.Name + suffix;
+    }
+
+    [Fact]
+    public void DecorateService_DecorateAllRegistrations()
+    {
+        var services = new ServiceCollection();
+        services.AddTransient<IDecorateTestService, DecorateTestServiceA>();
+        services.AddSingleton<IDecorateTestService>(new DecorateTestServiceB());
+        services.AddScoped<IDecorateTestService>(_ => new DecorateTestServiceA());
+
+        services.DecorateService<IDecorateTestService, DecorateTestDecorator>("-decorated");
+
+        var descriptors = services.Where(s => s.ServiceType == typeof(IDecorateTestService)).ToList();
+        Assert.Equal(3, descriptors.Count);
+        Assert.Equal(ServiceLifetime.Transient, descriptors[0].Lifetime);
+        Assert.Equal(ServiceLifetime.Singleton, descriptors[1].Lifetime);
+        Assert.Equal(ServiceLifetime.Scoped, descriptors[2].Lifetime);
+
+        using var sp = services.BuildServiceProvider();
+        using var scope = sp.CreateScope();
+        var resolved = scope.ServiceProvider.GetServices<IDecorateTestService>().ToList();
+        Assert.All(resolved, s => Assert.IsType<DecorateTestDecorator>(s));
+        Assert.Equal(["A-decorated", "B-decorated", "A-decorated"], resolved.Select(s => s.Name));
+        Assert.Equal("A-decorated", scope.ServiceProvider.GetRequiredService<IDecorateTestService>().Name);
+    }
+
+    [Fact]
+    public void DecorateService_ThrowIfNoRegistration()
+    {
+        var services = new ServiceCollection();
+        Assert.Throws<ArgumentException>(() =>
+            services.DecorateService<IDecorateTestService, DecorateTestDecorator>("x"));
+    }
