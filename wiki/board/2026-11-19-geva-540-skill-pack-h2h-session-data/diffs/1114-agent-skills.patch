+		describe('Element name', () => {
+			test('default: element with invalid name from createElement serializes verbatim — no throw', () => {
+				doc.documentElement.appendChild(doc.createElement('img src=x onerror="alert(1)"'));
+				expect(new XMLSerializer().serializeToString(doc)).toBe('<root><img src=x onerror="alert(1)"/></root>');
+			});
+
+			test('requireWellFormed: true on element with attribute injection in name throws InvalidStateError', () => {
+				doc.documentElement.appendChild(doc.createElement('img src=x onerror="alert(1)"'));
+				expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+			});
+
+			test('requireWellFormed: true on element with markup injection in name throws InvalidStateError', () => {
+				doc.documentElement.appendChild(doc.createElement('a></a><script>alert(1)</script><b'));
+				expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+			});
+
+			test('requireWellFormed: true on empty element name throws InvalidStateError', () => {
+				doc.documentElement.appendChild(doc.createElement(''));
+				expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+			});
+
+			test('requireWellFormed: true on invalid name of the serialized element itself throws InvalidStateError', () => {
+				const el = doc.createElement('x y="1"');
+				expectDOMException(() => new XMLSerializer().serializeToString(el, { requireWellFormed: true }), 'InvalidStateError');
+			});
+
+			test('requireWellFormed: true error message names the invalid element name', () => {
+				doc.documentElement.appendChild(doc.createElement('bad name'));
