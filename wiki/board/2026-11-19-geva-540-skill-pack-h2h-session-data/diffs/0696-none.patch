+    [Test]
+    public async Task AsyncLocalSetInJobFactoryShouldFlowToJobExecution()
+    {
+        var scheduler = await SchedulerBuilder.Create().WithName("AsyncLocalFlowTest").Build().GetScheduler();
+
+        var serviceCollection = new ServiceCollection();
+        serviceCollection.AddTransient<AsyncLocalJob>();
+        var serviceProvider = serviceCollection.BuildServiceProvider(validateScopes: true);
+
+        scheduler.JobFactory = new AsyncLocalJobFactory(serviceProvider);
+        await scheduler.Start();
+
+        var jobDetail = JobBuilder.Create<AsyncLocalJob>().StoreDurably().Build();
+        await scheduler.AddJob(jobDetail, replace: false);
+
+        AsyncLocalJob.Completion = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
+        await scheduler.TriggerJob(jobDetail.Key);
+
+        var finished = await Task.WhenAny(AsyncLocalJob.Completion.Task, Task.Delay(TimeSpan.FromSeconds(10)));
+        await scheduler.Shutdown();
+
+        finished.Should().BeSameAs(AsyncLocalJob.Completion.Task);
+        (await AsyncLocalJob.Completion.Task).Should().Be("tenant-001");
+    }
+
+    private static readonly AsyncLocal<string> asyncLocalValue = new();
+
+    private sealed class AsyncLocalJobFactory : MicrosoftDependencyInjectionJobFactory
+    {
+        public AsyncLocalJobFactory(IServiceProvider serviceProvider) : base(serviceProvider, Options.Create(new QuartzOptions()))
+        {
+        }
+
+        public override IJob NewJob(Spi.TriggerFiredBundle bundle, IScheduler scheduler)
+        {
+            asyncLocalValue.Value = "tenant-001";
+            return base.NewJob(bundle, scheduler);
+        }
+    }
+
+    private sealed class AsyncLocalJob : IJob
+    {
+        public static TaskCompletionSource<string> Completion { get; set; }
+
+        public async ValueTask Execute(IJobExecutionContext context)
+        {
+            await Task.Yield();
+            Completion.TrySetResult(asyncLocalValue.Value);
+        }
+    }
+
