+        return obj;
+    }
+
+    /// <summary>
+    /// Makes matching of user input against choices case-insensitive.
+    /// </summary>
+    /// <typeparam name="T">The prompt result type.</typeparam>
+    /// <param name="obj">The prompt.</param>
+    /// <param name="ignoreCase">Whether or not to ignore case.</param>
+    /// <returns>The same instance so that multiple calls can be chained.</returns>
+    public static TextPrompt<T> IgnoreCase<T>(this TextPrompt<T> obj, bool ignoreCase = true)
+    {
+        ArgumentNullException.ThrowIfNull(obj);
+
+        obj.Comparer = ignoreCase ? StringComparer.OrdinalIgnoreCase : null;
+        return obj;
