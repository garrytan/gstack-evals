+    [Theory]
+    [InlineData("yes", "Yes")]
+    [InlineData("PARTIALLY", "Partially")]
+    [InlineData("nO", "No")]
+    public void Should_Match_Choice_Ignoring_Case_When_IgnoreCase_Is_Set(string input, string expected)
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter(input);
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Helpful?")
+                .AddChoices(["Yes", "Partially", "No"])
+                .IgnoreCase());
+
+        // Then
+        result.ShouldBe(expected);
+    }
+
+    [Fact]
+    public void Should_Match_Choice_Using_Custom_Comparer()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+
+        // When
+        var result = console.Prompt(
+            new TextPrompt<string>("Helpful?")
+                .AddChoices(["Yes", "No"])
+                .WithComparer(StringComparer.OrdinalIgnoreCase));
+
+        // Then
+        result.ShouldBe("Yes");
+    }
+
