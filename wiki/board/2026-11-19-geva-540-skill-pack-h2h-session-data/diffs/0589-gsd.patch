+package caddytls
+
+import (
+	"testing"
+
+	"github.com/caddyserver/certmagic"
+)
+
+func TestManagingWildcardFor(t *testing.T) {
+	newApp := func(policies ...*AutomationPolicy) *TLS {
+		for _, ap := range policies {
+			ap.subjects = ap.SubjectsRaw
+		}
+		return &TLS{
+			Automation: &AutomationConfig{Policies: policies},
+			managing:   make(map[string]string),
+		}
+	}
+
+	t.Run("regular wildcard covers subdomain", func(t *testing.T) {
+		app := newApp(
+			&AutomationPolicy{SubjectsRaw: []string{"wiki.example.com"}},
+			&AutomationPolicy{SubjectsRaw: []string{"*.example.com"}},
+		)
+		subjs := map[string]struct{}{"*.example.com": {}, "wiki.example.com": {}}
+		if !app.managingWildcardFor("wiki.example.com", subjs) {
+			t.Error("expected wildcard to cover subdomain")
+		}
+		app.managing["*.example.com"] = ""
+		if !app.managingWildcardFor("wiki.example.com", nil) {
+			t.Error("expected already-managed wildcard to cover subdomain")
+		}
+	})
+
+	// regression test: a wildcard whose certificate comes from get_certificate
+	// (a Manager) is not obtained up front, so it must not prevent its
+	// subdomains from being managed normally
+	t.Run("wildcard with managers does not cover subdomain", func(t *testing.T) {
+		app := newApp(
+			&AutomationPolicy{SubjectsRaw: []string{"wiki.example.com"}},
+			&AutomationPolicy{
+				SubjectsRaw: []string{"*.example.com"},
+				Managers:    []certmagic.Manager{Tailscale{}},
+			},
+		)
+		subjs := map[string]struct{}{"*.example.com": {}, "wiki.example.com": {}}
+		if app.managingWildcardFor("wiki.example.com", subjs) {
+			t.Error("wildcard with external managers should not cover subdomain")
+		}
+		app.managing["*.example.com"] = ""
+		if app.managingWildcardFor("wiki.example.com", nil) {
+			t.Error("managed wildcard with external managers should not cover subdomain")
+		}
+	})
+
+	t.Run("on-demand wildcard does not cover subdomain", func(t *testing.T) {
+		app := newApp(
+			&AutomationPolicy{SubjectsRaw: []string{"wiki.example.com"}},
+			&AutomationPolicy{SubjectsRaw: []string{"*.example.com"}, OnDemand: true},
+		)
+		subjs := map[string]struct{}{"*.example.com": {}, "wiki.example.com": {}}
+		if app.managingWildcardFor("wiki.example.com", subjs) {
+			t.Error("on-demand wildcard should not cover subdomain")
+		}
+	})
+}
