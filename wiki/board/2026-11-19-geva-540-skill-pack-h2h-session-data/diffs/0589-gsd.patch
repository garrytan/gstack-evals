+// wildcardIsOnDemand returns true if the automation policy for the given
+// wildcard name gets its certificates on-demand (i.e. during TLS handshakes,
+// via on-demand issuance or external cert managers / get_certificate). In
+// that case, no certificate for the wildcard is obtained up front, and the
+// subdomains might be served by a different automation policy (without
+// on-demand), so the wildcard cannot be relied upon to cover them.
+func (t *TLS) wildcardIsOnDemand(wildcard string) bool {
+	if t.Automation == nil {
+		return false
+	}
+	ap := t.getAutomationPolicyForName(wildcard)
+	if ap == nil {
+		return false
+	}
+	return ap.OnDemand || len(ap.Managers) > 0
+}
