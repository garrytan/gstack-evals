--- a/internal/storage/embeddeddolt/schema.go
+++ b/internal/storage/embeddeddolt/schema.go
@@ -8,6 +8,7 @@ import (
 	"embed"
 	"fmt"
 	"io/fs"
+	"regexp"
 	"sort"
 	"strconv"
 	"strings"
@@ -169,3 +170,84 @@ func backfillMigrations(ctx context.Context, tx *sql.Tx) (int, error) {
 	}
 	return n, nil
 }
+
+// ignoredTables lists the dolt_ignore'd tables (matching the 'wisps' and
+// 'wisp_%' patterns). Because they are ignored, they never enter Dolt history
+// and exist only in a working set: a fresh clone, a new branch, or a working
+// set reset will not contain them even though schema_migrations says the
+// migrations that created them were applied.
+var ignoredTables = []string{"wisps", "wisp_labels", "wisp_dependencies", "wisp_events", "wisp_comments"}
+
+// ignoredTableStmtRe extracts the target table of a migration statement that
+// creates or alters an ignored table (CREATE TABLE, ALTER TABLE, CREATE INDEX ... ON).
+var ignoredTableStmtRe = regexp.MustCompile(`(?is)^\s*(?:CREATE\s+TABLE\s+(?:IF\s+NOT\s+EXISTS\s+)?|ALTER\s+TABLE\s+|CREATE\s+(?:UNIQUE\s+)?INDEX\s+\S+\s+ON\s+)` + "`?" + `(wisps|wisp_\w+)` + "`?" + `\b`)
+
+// ensureIgnoredTables recreates any missing dolt_ignore'd tables in the current
+// working set by replaying, in version order, every already-applied embedded
+// migration statement that targets a missing ignored table. Tables that
+// already exist are left untouched, so this is idempotent. This is the
+// embedded-mode counterpart of the server-mode createIgnoredTables.
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	missing := map[string]bool{}
+	for _, tbl := range ignoredTables {
+		var n int
+		if err := tx.QueryRowContext(ctx,
+			"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?",
+			tbl).Scan(&n); err != nil {
+			return fmt.Errorf("checking for table %s: %w", tbl, err)
+		}
+		if n == 0 {
+			missing[tbl] = true
+		}
+	}
+	if len(missing) == 0 {
+		return nil
+	}
+
+	var current int
+	if err := tx.QueryRowContext(ctx, "SELECT COALESCE(MAX(version), 0) FROM schema_migrations").Scan(&current); err != nil {
+		return fmt.Errorf("reading current migration version: %w", err)
+	}
+
+	entries, err := fs.ReadDir(upMigrations, "schema")
+	if err != nil {
+		return fmt.Errorf("reading embedded migrations: %w", err)
+	}
+	type migrationFile struct {
+		version int
+		name    string
+	}
+	var files []migrationFile
+	for _, e := range entries {
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".up.sql") {
+			continue
+		}
+		v, err := parseVersion(e.Name())
+		if err != nil {
+			return fmt.Errorf("parsing migration filename %q: %w", e.Name(), err)
+		}
+		if v <= current {
+			files = append(files, migrationFile{version: v, name: e.Name()})
+		}
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].version < files[j].version })
+
+	for _, mf := range files {
+		data, err := upMigrations.ReadFile("schema/" + mf.name)
+		if err != nil {
+			return fmt.Errorf("reading migration %s: %w", mf.name, err)
+		}
+		// Migration files contain only DDL without embedded semicolons,
+		// so splitting on ';' yields individual statements.
+		for _, stmt := range strings.Split(string(data), ";") {
+			m := ignoredTableStmtRe.FindStringSubmatch(stmt)
+			if m == nil || !missing[strings.ToLower(m[1])] {
+				continue
+			}
+			if _, err := tx.ExecContext(ctx, stmt); err != nil {
+				return fmt.Errorf("recreating ignored table %s (migration %s): %w", m[1], mf.name, err)
+			}
+		}
+	}
+	return nil
+}
