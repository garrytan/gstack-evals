 	return strings.Contains(s, "doesn't exist") || strings.Contains(s, "does not exist") ||
 		strings.Contains(s, "error 1146")
 }
+
+// tableExistsInTx reports whether a table exists in the current database.
+func tableExistsInTx(ctx context.Context, tx *sql.Tx, table string) (bool, error) {
+	var n int
+	if err := tx.QueryRowContext(ctx,
+		"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?",
+		table).Scan(&n); err != nil {
+		return false, err
+	}
+	return n > 0, nil
+}
