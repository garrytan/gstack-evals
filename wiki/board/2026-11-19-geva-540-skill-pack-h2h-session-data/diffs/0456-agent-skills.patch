diff --git a/internal/storage/embeddeddolt/wisp_tables_test.go b/internal/storage/embeddeddolt/wisp_tables_test.go
new file mode 100644
index 0000000..bde46d2
--- /dev/null
+++ b/internal/storage/embeddeddolt/wisp_tables_test.go
@@ -0,0 +1,132 @@
+//go:build cgo
+
+package embeddeddolt_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/storage/embeddeddolt"
+	"github.com/steveyegge/beads/internal/types"
+)
+
+var wispTables = []string{"wisps", "wisp_labels", "wisp_dependencies", "wisp_events", "wisp_comments"}
+
+// dropWispTables simulates a working set without the dolt_ignore'd wisp tables
+// (e.g. a fresh clone, a new branch, or a database created before the tables
+// were tracked by migrations). Ignored tables never reach Dolt history, so
+// they must be recreated on open.
+func dropWispTables(t *testing.T, te *testEnv) {
+	t.Helper()
+	for _, tbl := range wispTables {
+		te.exec(t, t.Context(), "DROP TABLE IF EXISTS `"+tbl+"`")
+	}
+}
+
+func createTwoTasks(t *testing.T, te *testEnv, prefix string) {
+	t.Helper()
+	ctx := t.Context()
+	for _, id := range []string{prefix + "-a", prefix + "-b"} {
+		iss := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+		if err := te.store.CreateIssue(ctx, iss, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+	}
+}
+
+// TestReopenRecreatesMissingWispTables: opening an embedded store must
+// recreate dolt_ignore'd wisp tables that are missing from the working set.
+func TestReopenRecreatesMissingWispTables(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	ctx := t.Context()
+
+	beadsDir := filepath.Join(t.TempDir(), ".beads")
+	store, err := embeddeddolt.New(ctx, beadsDir, "rw", "main")
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if err := store.SetConfig(ctx, "issue_prefix", "rw"); err != nil {
+		t.Fatalf("SetConfig: %v", err)
+	}
+	if err := store.Commit(ctx, "init"); err != nil {
+		t.Fatalf("Commit: %v", err)
+	}
+	te := &testEnv{store: store, dataDir: filepath.Join(beadsDir, "embeddeddolt"), database: "rw"}
+	createTwoTasks(t, te, "rw")
+	store.Close()
+
+	dropWispTables(t, te)
+
+	store, err = embeddeddolt.New(ctx, beadsDir, "rw", "main")
+	if err != nil {
+		t.Fatalf("New (reopen): %v", err)
+	}
+	t.Cleanup(func() { store.Close() })
+	te.store = store
+
+	for _, tbl := range wispTables {
+		var n int
+		te.queryScalar(t, ctx,
+			"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?",
+			[]any{tbl}, &n)
+		if n != 1 {
+			t.Errorf("table %s not recreated on open", tbl)
+		}
+	}
+
+	// The recreated wisps table must carry later-migration columns.
+	var n int
+	te.queryScalar(t, ctx,
+		"SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = 'wisps' AND column_name = 'no_history'",
+		nil, &n)
+	if n != 1 {
+		t.Errorf("recreated wisps table missing no_history column")
+	}
+	te.queryScalar(t, ctx,
+		"SELECT COUNT(*) FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = 'wisp_dependencies' AND index_name = 'idx_wisp_dep_type'",
+		nil, &n)
+	if n == 0 {
+		t.Errorf("recreated wisp_dependencies table missing idx_wisp_dep_type index")
+	}
+
+	dep := &types.Dependency{IssueID: "rw-b", DependsOnID: "rw-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency after reopen: %v", err)
+	}
+	if err := store.DeleteIssue(ctx, "rw-a"); err != nil {
+		t.Fatalf("DeleteIssue after reopen: %v", err)
+	}
+}
+
+// TestDependencyOpsToleratesMissingWispDependencies: dependency queries must
+// not fail hard when wisp_dependencies is missing (mirrors blocked.go).
+func TestDependencyOpsToleratesMissingWispDependencies(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	te := newTestEnv(t, "mw")
+	ctx := t.Context()
+	createTwoTasks(t, te, "mw")
+
+	// Drop while the store stays open, so no re-init happens.
+	te.exec(t, ctx, "DROP TABLE IF EXISTS wisp_dependencies")
+
+	dep := &types.Dependency{IssueID: "mw-b", DependsOnID: "mw-a", Type: types.DepBlocks}
+	if err := te.store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency: %v", err)
+	}
+	deps, err := te.store.GetDependencies(ctx, "mw-b")
+	if err != nil {
+		t.Fatalf("GetDependencies: %v", err)
+	}
+	if len(deps) != 1 || deps[0].ID != "mw-a" {
+		t.Errorf("GetDependencies = %v, want [mw-a]", deps)
+	}
+	if _, err := te.store.GetDependents(ctx, "mw-a"); err != nil {
+		t.Fatalf("GetDependents: %v", err)
+	}
+	if _, err := te.store.GetDependenciesWithMetadata(ctx, "mw-b"); err != nil {
+		t.Fatalf("GetDependenciesWithMetadata: %v", err)
+	}
+	if _, err := te.store.GetDependentsWithMetadata(ctx, "mw-a"); err != nil {
+		t.Fatalf("GetDependentsWithMetadata: %v", err)
+	}
+}
