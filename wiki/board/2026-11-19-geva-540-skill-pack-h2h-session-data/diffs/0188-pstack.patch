diff --git a/test/sql/aggregate/aggregates/test_volatile_aggregate_dedup.test b/test/sql/aggregate/aggregates/test_volatile_aggregate_dedup.test
new file mode 100644
index 0000000..ba848f5
--- /dev/null
+++ b/test/sql/aggregate/aggregates/test_volatile_aggregate_dedup.test
@@ -0,0 +1,42 @@
+# name: test/sql/aggregate/aggregates/test_volatile_aggregate_dedup.test
+# description: Identical aggregates or windows over volatile functions are evaluated independently
+# group: [aggregates]
+
+statement ok
+PRAGMA enable_verification
+
+query I
+SELECT any_value(uuid()::VARCHAR) = any_value(uuid()::VARCHAR) FROM range(3)
+----
+false
+
+query I
+SELECT sum(random()) = sum(random()) FROM range(100)
+----
+false
+
+query II
+SELECT g, any_value(uuid()::VARCHAR) OVER (PARTITION BY g) = any_value(uuid()::VARCHAR) OVER (PARTITION BY g)
+FROM (VALUES (1), (1), (2), (2)) t(g)
+ORDER BY g
+----
+1	false
+1	false
+2	false
+2	false
+
+query I
+SELECT count(*) FROM (
+	SELECT g,
+		any_value(uuid()::VARCHAR) OVER (PARTITION BY g) AS id_a,
+		any_value(uuid()::VARCHAR) OVER (PARTITION BY g) AS id_b
+	FROM (VALUES (1), (1), (2), (2)) t(g)
+) WHERE id_a = id_b
+----
+0
+
+# non-volatile duplicates are still deduplicated
+query II
+SELECT sum(i), sum(i) FROM range(10) t(i)
+----
+45	45
