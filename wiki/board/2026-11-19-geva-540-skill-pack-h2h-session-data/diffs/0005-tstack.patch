+    // MSDF atlases must not be mipmapped - averaging the distance channels corrupts the median
+    it('loads msdf font textures without mipmaps', function (done) {
+        const asset = new Asset('arial', 'font', {
+            url: 'http://localhost:3210/test/assets/fonts/arial.json'
+        });
+
+        app.assets.add(asset);
+        app.assets.load(asset);
+
+        asset.ready(function () {
+            const font = asset.resource;
+            expect(font.type).to.equal('msdf');
+            font.textures.forEach((texture) => {
+                expect(texture.mipmaps).to.equal(false);
+                expect(texture.minFilter).to.equal(FILTER_LINEAR);
+                // the texture keeps its url as name, which is its loader cache key
+                expect(app.loader.getFromCache(texture.name, 'texture')).to.equal(texture);
+            });
+            done();
+        });
+
+        asset.on('error', err => done(new Error(err)));
+    });
+
