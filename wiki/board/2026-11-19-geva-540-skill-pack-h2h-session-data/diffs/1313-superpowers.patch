+
+func TestSecurityAllowContentHTML(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert(1)</script>
+-- layouts/single.html --
+{{ .Content }}
+-- layouts/list.html --
+List.
+`
+	b, err := TestE(t, files)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+
+	// Content adapter.
+	filesAdapter := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/_content.gotmpl --
+{{ $.AddPage (dict "path" "p2" "title" "p2" "content" (dict "mediaType" "text/html" "value" "<script>alert(2)</script>")) }}
+-- layouts/single.html --
+{{ .Content }}
+-- layouts/list.html --
+List.
+`
+	b, err = TestE(t, filesAdapter)
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, `security.allowContent`)
+
+	// Opt in.
+	b = Test(t, strings.Replace(files, "-- hugo.toml --\n", "-- hugo.toml --\n[security]\nallowContent = ['.*']\n", 1))
+	b.AssertFileContent("public/p1/index.html", "<script>alert(1)</script>")
+	b = Test(t, strings.Replace(filesAdapter, "-- hugo.toml --\n", "-- hugo.toml --\n[security]\nallowContent = ['.*']\n", 1))
+	b.AssertFileContent("public/p2/index.html", "<script>alert(2)</script>")
+
+	// Markdown is unaffected.
+	b = Test(t, strings.Replace(files, "content/p1.html", "content/p1.md", 1))
+	b.AssertFileExists("public/p1/index.html", true)
+}
