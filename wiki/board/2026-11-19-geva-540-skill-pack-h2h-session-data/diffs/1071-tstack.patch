diff --git a/internal/web/events_filter_test.go b/internal/web/events_filter_test.go
new file mode 100644
index 0000000..92fb430
--- /dev/null
+++ b/internal/web/events_filter_test.go
@@ -0,0 +1,92 @@
+package web
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/amir20/dozzle/internal/container"
+	"github.com/stretchr/testify/require"
+)
+
+// filteringHostService is a minimal HostService that applies label filters to
+// container lists and lets the test push arbitrary events and stats.
+type filteringHostService struct {
+	HostService
+	containers []container.Container
+	feed       func(events chan<- container.ContainerEvent, stats chan<- container.ContainerStat)
+}
+
+func (f *filteringHostService) match(labels container.ContainerLabels) []container.Container {
+	var out []container.Container
+	for _, c := range f.containers {
+		ok := true
+		for _, kv := range labels["label"] {
+			k, v, _ := strings.Cut(kv, "=")
+			ok = ok && c.Labels[k] == v
+		}
+		if ok {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+func (f *filteringHostService) ListAllContainers(labels container.ContainerLabels) ([]container.Container, []error) {
+	return f.match(labels), nil
+}
+
+func (f *filteringHostService) ListContainersForHost(host string, labels container.ContainerLabels) ([]container.Container, error) {
+	return f.match(labels), nil
+}
+
+func (f *filteringHostService) SubscribeAvailableHosts(ctx context.Context, hosts chan<- container.Host) {
+}
+
+func (f *filteringHostService) SubscribeEventsAndStats(ctx context.Context, events chan<- container.ContainerEvent, stats chan<- container.ContainerStat) {
+	go f.feed(events, stats)
+}
+
+func Test_handler_streamEvents_respects_label_filter(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	visible := container.Container{ID: "visible00001", Name: "dz_visible", Host: "localhost", Labels: map[string]string{"visible": "yes"}}
+	secret := container.Container{ID: "secret000001", Name: "dz_secret", Host: "localhost", Labels: map[string]string{"secretproject": "acme-payroll"}}
+
+	svc := &filteringHostService{containers: []container.Container{visible, secret}}
+	svc.feed = func(events chan<- container.ContainerEvent, stats chan<- container.ContainerStat) {
+		for _, c := range []container.Container{visible, secret} {
+			stats <- container.ContainerStat{ID: c.ID, CPUPercent: 1}
+			events <- container.ContainerEvent{Name: "start", Host: c.Host, ActorID: c.ID, ActorAttributes: map[string]string{"name": c.Name, "secretproject": c.Labels["secretproject"]}}
+			events <- container.ContainerEvent{Name: "die", Host: c.Host, ActorID: c.ID}
+			events <- container.ContainerEvent{Name: "update", Host: c.Host, ActorID: c.ID, Container: &c}
+			events <- container.ContainerEvent{Name: "health_status: healthy", Host: c.Host, ActorID: c.ID}
+		}
+		time.Sleep(50 * time.Millisecond)
+		cancel()
+	}
+
+	labels, err := container.ParseContainerFilter("label=visible=yes")
+	require.NoError(t, err)
+	h := &handler{hostService: svc, config: &Config{Base: "/", Labels: labels, NoAnalytics: true, Authorization: Authorization{Provider: NONE}}}
+
+	req, err := http.NewRequestWithContext(ctx, "GET", "/api/events/stream", nil)
+	require.NoError(t, err)
+	rr := httptest.NewRecorder()
+	h.streamEvents(rr, req)
+
+	body := rr.Body.String()
+	require.Contains(t, body, visible.ID)
+	require.Contains(t, body, "event: container-stat")
+	require.Contains(t, body, "event: container-event")
+	require.Contains(t, body, "event: container-updated")
+	require.Contains(t, body, "event: container-health")
+	require.NotContains(t, body, secret.ID)
+	require.NotContains(t, body, "acme-payroll")
+	require.NotContains(t, body, "dz_secret")
+	require.Equal(t, 0, strings.Count(body, "secret0"))
+}
