--- /dev/null
+++ b/NAudio.Core.Tests/WaveFormats/WaveFormatSerializeTests.cs
@@ -0,0 +1,65 @@
+using System.IO;
+using NAudio.Utils;
+using NAudio.Wave;
+using NUnit.Framework;
+
+namespace NAudio.Core.Tests.WaveFormats
+{
+    [TestFixture]
+    [Category("UnitTest")]
+    public class WaveFormatSerializeTests
+    {
+        private static byte[] Serialize(WaveFormat format)
+        {
+            using (var ms = new MemoryStream())
+            using (var writer = new BinaryWriter(ms))
+            {
+                format.Serialize(writer);
+                writer.Flush();
+                return ms.ToArray();
+            }
+        }
+
+        [Test]
+        public void PcmFormatChunkHasNoExtraSizeField()
+        {
+            var bytes = Serialize(new WaveFormat(44100, 16, 2));
+            Assert.That(bytes.Length, Is.EqualTo(4 + 16));
+            using (var reader = new BinaryReader(new MemoryStream(bytes)))
+            {
+                Assert.That(reader.ReadInt32(), Is.EqualTo(16));
+                var roundTripped = WaveFormat.FromFormatChunk(reader, 16);
+                Assert.That(roundTripped, Is.EqualTo(new WaveFormat(44100, 16, 2)));
+            }
+        }
+
+        [Test]
+        public void IeeeFloatFormatChunkKeepsExtraSizeField()
+        {
+            var bytes = Serialize(WaveFormat.CreateIeeeFloatWaveFormat(44100, 2));
+            Assert.That(bytes.Length, Is.EqualTo(4 + 18));
+            using (var reader = new BinaryReader(new MemoryStream(bytes)))
+            {
+                Assert.That(reader.ReadInt32(), Is.EqualTo(18));
+            }
+        }
+
+        [Test]
+        public void PcmWaveFileHas44ByteHeaderAndReadsBack()
+        {
+            var ms = new MemoryStream();
+            var format = new WaveFormat(8000, 16, 1);
+            using (var writer = new WaveFileWriter(new IgnoreDisposeStream(ms), format))
+            {
+                writer.Write(new byte[100], 0, 100);
+            }
+            Assert.That(ms.Length, Is.EqualTo(44 + 100));
+            ms.Position = 0;
+            using (var reader = new WaveFileReader(ms))
+            {
+                Assert.That(reader.WaveFormat, Is.EqualTo(format));
+                Assert.That(reader.Length, Is.EqualTo(100));
+            }
+        }
+    }
+}
