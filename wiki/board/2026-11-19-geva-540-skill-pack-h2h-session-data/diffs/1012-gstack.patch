+func TestContext_Scheme_rejectsInvalidHeaderValues(t *testing.T) {
+	for _, h := range []string{HeaderXForwardedProto, HeaderXForwardedProtocol, HeaderXUrlScheme} {
+		for _, v := range []string{"javascript", "data", "file", "vbscript", "https://evil", "ftp"} {
+			c := &Context{request: &http.Request{Header: http.Header{h: []string{v}}}}
+			assert.Equal(t, "http", c.Scheme(), "%s: %s", h, v)
+		}
+		for _, v := range []string{"http", "https", "ws", "wss", "HTTPS"} {
+			c := &Context{request: &http.Request{Header: http.Header{h: []string{v}}}}
+			assert.Equal(t, strings.ToLower(v), c.Scheme(), "%s: %s", h, v)
+		}
+	}
+}
