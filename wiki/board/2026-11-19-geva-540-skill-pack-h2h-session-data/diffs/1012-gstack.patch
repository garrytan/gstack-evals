+// sanitizeScheme validates scheme value taken from request headers. Only `http`, `https`, `ws` and `wss` are allowed
+// as headers are client controlled and could otherwise be used to inject arbitrary schemes (e.g. `javascript`).
+func sanitizeScheme(scheme string) (string, bool) {
+	if scheme == "" {
+		return "", false
+	}
+	switch s := strings.ToLower(strings.TrimSpace(scheme)); s {
+	case "http", "https", "ws", "wss":
+		return s, true
+	}
+	return "", false
+}
