+function headerArrayToObject(headerArray) {
+  if (headerArray.length % 2 !== 0) {
+    throw new TypeError("Array-form headers must contain name/value pairs");
+  }
+  var headers = {};
+  var names = {};
+  for (var i = 0; i < headerArray.length; i += 2) {
+    var name = String(headerArray[i]);
+    var value = headerArray[i + 1];
+    var key = name.toLowerCase();
+    // Combine duplicate headers (case-insensitively) into an array of values
+    if (Object.prototype.hasOwnProperty.call(names, key)) {
+      var existingName = names[key];
+      headers[existingName] = [].concat(headers[existingName], value);
+    }
+    else {
+      names[key] = name;
+      headers[name] = value;
+    }
+  }
+  return headers;
+}
