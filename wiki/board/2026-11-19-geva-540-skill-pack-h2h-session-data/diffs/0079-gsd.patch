+package io.github.hectorvent.floci.services.s3;
+
+import io.quarkus.test.junit.QuarkusTest;
+import org.junit.jupiter.api.MethodOrderer;
+import org.junit.jupiter.api.Order;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.TestMethodOrder;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import static io.restassured.RestAssured.given;
+
+/**
+ * Regression: sub-resource-qualified DELETEs (e.g. DeleteBucketReplication) must never
+ * fall through to DeleteBucket.
+ */
+@QuarkusTest
+@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
+class S3DeleteBucketSubresourceIntegrationTest {
+
+    private static final String BUCKET = "delete-subresource-int-test";
+
+    @Test
+    @Order(1)
+    void createBucket() {
+        given().when().put("/" + BUCKET).then().statusCode(200);
+    }
+
+    @Test
+    @Order(2)
+    void deleteBucketReplicationKeepsBucket() {
+        given().when().delete("/" + BUCKET + "?replication").then().statusCode(204);
+        given().when().head("/" + BUCKET).then().statusCode(200);
+    }
+
+    @ParameterizedTest
+    @Order(3)
+    @ValueSource(strings = {"analytics&id=a1", "metrics&id=m1", "inventory&id=i1", "intelligent-tiering&id=t1"})
+    void otherUnmodeledSubresourcesKeepBucket(String query) {
+        given().when().delete("/" + BUCKET + "?" + query).then().statusCode(204);
+        given().when().head("/" + BUCKET).then().statusCode(200);
+    }
+
+    @Test
+    @Order(4)
+    void deleteBucketReplicationOnMissingBucketReturns404() {
+        given().when().delete("/no-such-bucket-replication-test?replication").then().statusCode(404);
+    }
+
+    @Test
+    @Order(5)
+    void plainDeleteStillDeletesBucket() {
+        given().when().delete("/" + BUCKET).then().statusCode(204);
+        given().when().head("/" + BUCKET).then().statusCode(404);
+    }
+}
