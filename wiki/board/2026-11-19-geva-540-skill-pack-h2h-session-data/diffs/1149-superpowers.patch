diff --git a/registry/remote/utils.go b/registry/remote/utils.go
index 797169f..8d95607 100644
--- a/registry/remote/utils.go
+++ b/registry/remote/utils.go
@@ -51,10 +51,22 @@ func parseLink(resp *http.Response) (string, error) {
 		link = link[1:i]
 	}
 
-	linkURL, err := resp.Request.URL.Parse(link)
+	baseURL := resp.Request.URL
+	linkURL, err := baseURL.Parse(link)
 	if err != nil {
 		return "", err
 	}
+	// prevent following the link to a different host or scheme, which could
+	// be abused for server-side request forgery (SSRF) or downgrade attacks.
+	if !strings.EqualFold(linkURL.Scheme, baseURL.Scheme) {
+		return "", fmt.Errorf("invalid next link %q: scheme %q does not match the request scheme %q", link, linkURL.Scheme, baseURL.Scheme)
+	}
+	if !strings.EqualFold(linkURL.Host, baseURL.Host) {
+		return "", fmt.Errorf("invalid next link %q: host %q does not match the request host %q", link, linkURL.Host, baseURL.Host)
+	}
+	if linkURL.User != nil {
+		return "", fmt.Errorf("invalid next link %q: user info is not allowed", link)
+	}
 	return linkURL.String(), nil
 }
 
