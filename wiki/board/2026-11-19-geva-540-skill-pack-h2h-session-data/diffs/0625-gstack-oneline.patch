diff --git a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
index f84b0da..d6939b1 100644
--- a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
+++ b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
@@ -1069,4 +1069,18 @@ public class OptionSelectorTests
     }
 
     #endregion
+
+    [Fact]
+    public void Horizontal_Labels_Set_After_Construction_Width_Includes_All_Labels ()
+    {
+        OptionSelector selector = new () { Orientation = Orientation.Horizontal };
+        selector.Labels = ["IMDb (Recommended)", "TMDb"];
+        selector.Values = [0, 1];
+        View super = new () { Width = 80, Height = 10 };
+        super.Add (selector);
+        super.Layout ();
+        CheckBox last = selector.SubViews.OfType<CheckBox> ().Last ();
+        Assert.True (last.Frame.Right <= selector.Viewport.Width, $"{last.Frame} {selector.Frame}");
+        Assert.Equal (last.Frame.Right, selector.Frame.Width);
+    }
 }
