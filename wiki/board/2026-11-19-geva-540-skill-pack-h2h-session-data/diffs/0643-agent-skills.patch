diff --git a/changelogs/unreleased/9999-healthchecknodeport-null b/changelogs/unreleased/9999-healthchecknodeport-null
new file mode 100644
index 0000000..a512f93
--- /dev/null
+++ b/changelogs/unreleased/9999-healthchecknodeport-null
@@ -0,0 +1 @@
+Fix restore failure when the Service last-applied-configuration annotation contains "healthCheckNodePort": null
diff --git a/pkg/restore/actions/service_action.go b/pkg/restore/actions/service_action.go
index 9de7522..bbcf246 100644
--- a/pkg/restore/actions/service_action.go
+++ b/pkg/restore/actions/service_action.go
@@ -101,15 +101,25 @@ func deleteHealthCheckNodePort(service *corev1api.Service) error {
 			return errors.WithStack(err)
 		}
 
-		healthCheckNodePort, exist, err := unstructured.NestedFloat64(*appliedServiceUnstructured, "spec", "healthCheckNodePort")
+		healthCheckNodePort, exist, err := unstructured.NestedFieldNoCopy(*appliedServiceUnstructured, "spec", "healthCheckNodePort")
 		if err != nil {
 			return errors.WithStack(err)
 		}
 
-		// Found healthCheckNodePort in lastAppliedConfig annotation,
-		// and the value is not 0. No need to delete, return.
-		if exist && healthCheckNodePort != 0 {
-			return nil
+		// A missing or null healthCheckNodePort means the user didn't
+		// specify it explicitly, so fall through to the ManagedFields check.
+		if exist && healthCheckNodePort != nil {
+			port, ok := healthCheckNodePort.(float64)
+			if !ok {
+				return errors.Errorf(".spec.healthCheckNodePort in %s annotation is of the type %T, expected float64",
+					annotationLastAppliedConfig, healthCheckNodePort)
+			}
+
+			// Found healthCheckNodePort in lastAppliedConfig annotation,
+			// and the value is not 0. No need to delete, return.
+			if port != 0 {
+				return nil
+			}
 		}
 	}
 
