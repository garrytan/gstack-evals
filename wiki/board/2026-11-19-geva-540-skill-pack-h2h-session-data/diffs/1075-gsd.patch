+
+// newHTTP3ReadTimeoutHandler enforces the entryPoint readTimeout on HTTP/3 request bodies.
+// For HTTP/1.1 and HTTP/2, the readTimeout is enforced as a deadline on the TCP connection,
+// which does not exist for HTTP/3, so the deadline is enforced on the request body instead.
+func newHTTP3ReadTimeoutHandler(next http.Handler, readTimeout time.Duration) http.Handler {
+	if readTimeout <= 0 {
+		return next
+	}
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		if req.Body == nil || req.Body == http.NoBody {
+			next.ServeHTTP(rw, req)
+			return
+		}
+
+		body := newDeadlineBody(req.Body, readTimeout)
+		defer body.stop()
+
+		req.Body = body
+		next.ServeHTTP(rw, req)
+	})
+}
+
+// deadlineBody is a request body which is closed when the deadline is exceeded.
+// Closing an HTTP/3 request body cancels the underlying QUIC stream read,
+// which unblocks a pending Read, even if the client stopped sending data.
+type deadlineBody struct {
+	body  io.ReadCloser
+	timer *time.Timer
+
+	mu       sync.Mutex
+	timedOut bool
+	closed   bool
+}
+
+func newDeadlineBody(body io.ReadCloser, timeout time.Duration) *deadlineBody {
+	b := &deadlineBody{body: body}
+	b.timer = time.AfterFunc(timeout, b.expire)
+	return b
+}
+
+func (b *deadlineBody) expire() {
+	b.mu.Lock()
+	if b.closed {
+		b.mu.Unlock()
+		return
+	}
+	b.timedOut = true
+	b.closed = true
+	b.mu.Unlock()
+
+	_ = b.body.Close()
+}
+
+func (b *deadlineBody) isTimedOut() bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	return b.timedOut
+}
+
+func (b *deadlineBody) Read(p []byte) (int, error) {
+	if b.isTimedOut() {
+		return 0, os.ErrDeadlineExceeded
+	}
+
+	n, err := b.body.Read(p)
+	if err != nil {
+		if b.isTimedOut() {
+			return n, os.ErrDeadlineExceeded
+		}
+		if errors.Is(err, io.EOF) {
+			// The whole body has been read before the deadline.
+			b.timer.Stop()
+		}
+	}
+
+	return n, err
+}
+
+func (b *deadlineBody) Close() error {
+	b.timer.Stop()
+
+	b.mu.Lock()
+	if b.closed {
+		b.mu.Unlock()
+		return nil
+	}
+	b.closed = true
+	b.mu.Unlock()
+
+	return b.body.Close()
+}
+
+// stop releases the deadline timer once the request has been handled.
+func (b *deadlineBody) stop() {
+	b.timer.Stop()
+}
