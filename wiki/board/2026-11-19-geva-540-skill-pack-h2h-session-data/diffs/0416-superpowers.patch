+package tools.jackson.databind.jsontype.ext;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.*;
+
+import tools.jackson.databind.*;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+// [databind#3601]: External type id must be written even if @JsonValue returns null
+public class ExternalTypeIdWithJsonValue3601Test extends DatabindTestUtil
+{
+    interface GenericType {
+        String getValue();
+    }
+
+    static abstract class AbstractGenericType implements GenericType {
+        protected String value;
+
+        protected AbstractGenericType() { }
+        protected AbstractGenericType(String v) { value = v; }
+
+        @JsonValue
+        @Override
+        public String getValue() { return value; }
+    }
+
+    static class FooType extends AbstractGenericType {
+        public FooType() { super(); }
+        public FooType(String v) { super(v); }
+    }
+
+    static class Container {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.EXTERNAL_PROPERTY,
+                property = "type", visible = true)
+        @JsonSubTypes({ @JsonSubTypes.Type(value = FooType.class, name = "foo") })
+        public GenericType value;
+
+        public Container() { }
+        public Container(GenericType v) { value = v; }
+    }
+
+    static class WrapperArrayContainer {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.WRAPPER_ARRAY)
+        @JsonSubTypes({ @JsonSubTypes.Type(value = FooType.class, name = "foo") })
+        public GenericType value;
+
+        public WrapperArrayContainer(GenericType v) { value = v; }
+    }
+
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testExternalTypeIdWithNullJsonValue() throws Exception
+    {
+        assertEquals(a2q("{'value':null}"),
+                MAPPER.writeValueAsString(new Container()));
+        assertEquals(a2q("{'value':null,'type':'foo'}"),
+                MAPPER.writeValueAsString(new Container(new FooType())));
+        assertEquals(a2q("{'value':'foobar','type':'foo'}"),
+                MAPPER.writeValueAsString(new Container(new FooType("foobar"))));
+    }
+
+    @Test
+    public void testWrapperArrayWithNullJsonValue() throws Exception
+    {
+        assertEquals(a2q("{'value':['foo',null]}"),
+                MAPPER.writeValueAsString(new WrapperArrayContainer(new FooType())));
+    }
+}
