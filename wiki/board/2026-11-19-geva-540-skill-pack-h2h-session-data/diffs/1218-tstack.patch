+// SPDX-FileCopyrightText: 2026 The Pion community <https://pion.ly>
+// SPDX-License-Identifier: MIT
+
+package handshake
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/pion/dtls/v3/internal/ciphersuite/types"
+)
+
+func TestServerKeyExchangeEcdhePskEmptyAfterHint(t *testing.T) {
+	for _, data := range [][]byte{{0x00, 0x00}, {0x00, 0x01, 0xAA}} {
+		m := &MessageServerKeyExchange{
+			KeyExchangeAlgorithm: types.KeyExchangeAlgorithmEcdhe | types.KeyExchangeAlgorithmPsk,
+		}
+		if err := m.Unmarshal(data); !errors.Is(err, errBufferTooSmall) {
+			t.Fatalf("expected errBufferTooSmall, got %v", err)
+		}
+	}
+}
