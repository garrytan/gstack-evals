+function arrayToHeaders(array) {
+  if (array.length % 2 !== 0) {
+    throw new TypeError("headers array must contain name/value pairs");
+  }
+  var headers = {};
+  for (var i = 0; i < array.length; i += 2) {
+    var name = String(array[i]);
+    var value = array[i + 1];
+    if (Object.prototype.hasOwnProperty.call(headers, name)) {
+      // Preserve duplicate headers as multiple values
+      headers[name] = [].concat(headers[name], value);
+    }
+    else {
+      Object.defineProperty(headers, name, {
+        value: value,
+        writable: true,
+        enumerable: true,
+        configurable: true,
+      });
+    }
+  }
+  return headers;
+}
