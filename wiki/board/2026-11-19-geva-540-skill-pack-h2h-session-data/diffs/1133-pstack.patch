+func TestTlsConfigFromUriEnforcesMinimumTLS12(t *testing.T) {
+	dir := t.TempDir()
+	certFile, keyFile := dir+"/client.pem", dir+"/client.key"
+	if err := os.WriteFile(certFile, []byte(clientCert), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(keyFile, []byte(clientKey), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	for name, uri := range map[string]URI{
+		"server auth only": {Scheme: "amqps", Host: "example.com"},
+		"mutual TLS":       {Scheme: "amqps", Host: "example.com", CertFile: certFile, KeyFile: keyFile},
+	} {
+		tlsConf, err := tlsConfigFromURI(uri)
+		if err != nil {
+			t.Fatalf("%s: expected tlsConfigFromURI to succeed, got error: %s", name, err)
+		}
+		if tlsConf.MinVersion != tls.VersionTLS12 {
+			t.Fatalf("%s: expected MinVersion TLS 1.2, got %#x", name, tlsConf.MinVersion)
+		}
+	}
+}
