+    private static List<String> extractResources(Map<String, Object> event) {
+        Object raw = event.get("Resources");
+        if (!(raw instanceof Collection<?> collection)) {
+            return List.of();
+        }
+        List<String> resources = new ArrayList<>();
+        for (Object item : collection) {
+            if (item != null) {
+                resources.add(item.toString());
+            }
+        }
+        return resources;
+    }
