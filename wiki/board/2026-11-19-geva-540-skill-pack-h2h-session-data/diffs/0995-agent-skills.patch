+
+func TestFlatColsUnboundedColumnRange(t *testing.T) {
+	// A worksheet loaded from an untrusted file may contain <col> elements
+	// with min/max far outside the valid column range; flattening must stay
+	// bounded by MaxColumns instead of allocating one entry per column.
+	for _, col := range []xlsxCol{
+		{Min: 1, Max: math.MaxInt32, Width: float64Ptr(9)},
+		{Min: -math.MaxInt32, Max: 2, Width: float64Ptr(9)},
+	} {
+		f := NewFile()
+		ws, err := f.workSheetReader("Sheet1")
+		assert.NoError(t, err)
+		ws.Cols = &xlsxCols{Col: []xlsxCol{col}}
+		done := make(chan error, 1)
+		go func() { done <- f.SetColWidth("Sheet1", "A", "A", 12) }()
+		select {
+		case err := <-done:
+			assert.NoError(t, err)
+		case <-time.After(10 * time.Second):
+			t.Fatal("SetColWidth did not finish for an out-of-range <col> element")
+		}
+		assert.LessOrEqual(t, len(ws.Cols.Col), MaxColumns)
+		for _, c := range ws.Cols.Col {
+			assert.True(t, c.Min >= MinColumns && c.Max <= MaxColumns)
+		}
+		width, err := f.GetColWidth("Sheet1", "A")
+		assert.NoError(t, err)
+		assert.Equal(t, 12.0, width)
+		assert.NoError(t, f.Close())
+	}
+}
