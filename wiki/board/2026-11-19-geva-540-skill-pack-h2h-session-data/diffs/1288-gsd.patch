+describe('utils', () => {
+  describe('convertTokenData prototype pollution', () => {
+    it('should not pollute Object.prototype through token keys', () => {
+      const tokens = [
+        { key: '{__proto__.polluted}', value: 'malicious' },
+        { key: '{constructor.prototype.polluted2}', value: 'malicious' },
+        { key: '{safe.token}', value: 'ok' },
+      ];
+      const asMap = new Map(tokens.map((t) => [t.key, t]));
+      const fromArr = convertTokenData(tokens, { output: 'object' });
+      const fromMap = convertTokenData(asMap, { output: 'object' });
+      expect(/** @type {any} */ ({}).polluted).to.be.undefined;
+      expect(/** @type {any} */ ({}).polluted2).to.be.undefined;
+      expect(fromArr).to.eql({ safe: { token: tokens[2] } });
+      expect(fromMap).to.eql({ safe: { token: tokens[2] } });
+    });
+  });
+});
