--- a/src/Riok.Mapperly/Helpers/EnumerableExtensions.cs
+++ b/src/Riok.Mapperly/Helpers/EnumerableExtensions.cs
@@ -2,6 +2,24 @@ namespace Riok.Mapperly.Helpers;
 
 public static class EnumerableExtensions
 {
+    /// <summary>
+    /// Appends all items of <paramref name="other"/> which are not already contained in <paramref name="enumerable"/>.
+    /// Duplicates within <paramref name="enumerable"/> are kept.
+    /// Used to merge included configurations which may be reached via multiple include paths.
+    /// </summary>
+    public static IReadOnlyCollection<T> ConcatNew<T>(
+        this IReadOnlyCollection<T> enumerable,
+        IEnumerable<T>? other,
+        IEqualityComparer<T>? comparer = null
+    )
+    {
+        if (other == null)
+            return enumerable;
+
+        var existing = new HashSet<T>(enumerable, comparer);
+        return enumerable.Concat(other.Where(existing.Add)).ToList();
+    }
+
     public static IEnumerable<T> WhereNotNull<T>(this IEnumerable<T?> enumerable)
         where T : struct
     {
