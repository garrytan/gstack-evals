+package tools.jackson.databind.jsontype.ext;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.*;
+
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class ExternalTypeIdWithJsonValueNull3500Test extends DatabindTestUtil
+{
+    public interface GenericType {
+        String getValue();
+    }
+
+    public static class FooType implements GenericType {
+        protected String value;
+        public FooType() { }
+        public FooType(String v) { value = v; }
+        @JsonValue
+        @Override
+        public String getValue() { return value; }
+    }
+
+    public static class Container {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.NAME, include = JsonTypeInfo.As.EXTERNAL_PROPERTY,
+                property = "type")
+        @JsonSubTypes({ @JsonSubTypes.Type(value = FooType.class, name = "foo") })
+        public GenericType value;
+    }
+
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testNullJsonValueWithExternalTypeId() throws Exception
+    {
+        Container c = new Container();
+        assertEquals(a2q("{'value':null}"), MAPPER.writeValueAsString(c));
+        c.value = new FooType();
+        assertEquals(a2q("{'value':null,'type':'foo'}"), MAPPER.writeValueAsString(c));
+        c.value = new FooType("bar");
+        assertEquals(a2q("{'value':'bar','type':'foo'}"), MAPPER.writeValueAsString(c));
+    }
+}
