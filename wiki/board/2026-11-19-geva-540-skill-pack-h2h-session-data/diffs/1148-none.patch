diff --git a/registry/remote/utils.go b/registry/remote/utils.go
index 797169f..0f74025 100644
--- a/registry/remote/utils.go
+++ b/registry/remote/utils.go
@@ -55,6 +55,12 @@ func parseLink(resp *http.Response) (string, error) {
 	if err != nil {
 		return "", err
 	}
+	// prevent SSRF: the next link must stay on the same origin as the request
+	reqURL := resp.Request.URL
+	if linkURL.Scheme != reqURL.Scheme || linkURL.Host != reqURL.Host {
+		return "", fmt.Errorf("invalid next link %q: cross-origin link is not allowed: expected %s://%s",
+			link, reqURL.Scheme, reqURL.Host)
+	}
 	return linkURL.String(), nil
 }
 
