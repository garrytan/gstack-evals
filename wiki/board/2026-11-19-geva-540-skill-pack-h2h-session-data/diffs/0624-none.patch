diff --git a/Terminal.Gui/Views/Selectors/SelectorBase.cs b/Terminal.Gui/Views/Selectors/SelectorBase.cs
index f1f7ed1..af324ac 100644
--- a/Terminal.Gui/Views/Selectors/SelectorBase.cs
+++ b/Terminal.Gui/Views/Selectors/SelectorBase.cs
@@ -527,8 +527,16 @@ public abstract class SelectorBase : View, IOrientation, IValue<int?>
                 SubViews.ElementAt (i).Y = 0;
                 SubViews.ElementAt (i).Margin.Thickness = new Thickness (0, 0, i < SubViews.Count - 1 ? _horizontalSpace : 0, 0);
                 SubViews.ElementAt (i).Width = Dim.Auto ();
+
+                // DimAuto (used by this selector's Width/Height) sizes Pos.Align-based SubViews using their
+                // current Frame. Ensure the Frame reflects the new Margin/Width immediately; otherwise the
+                // selector's auto-size would be computed from stale (e.g. margin-less) frames and labels
+                // would be truncated until some unrelated layout pass happened.
+                SubViews.ElementAt (i).SetRelativeLayout (App?.Screen.Size ?? new Size (2048, 2048));
             }
         }
+
+        SetNeedsLayout ();
     }
 
