diff --git a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
index f84b0da..aec12e1 100644
--- a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
+++ b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
@@ -1069,4 +1069,63 @@ public class OptionSelectorTests
     }
 
     #endregion
+
+    [Theory]
+    [InlineData (false)]
+    [InlineData (true)]
+    public void Horizontal_Labels_Set_After_Construction_Width_Fits_Content (bool initiallyHidden)
+    {
+        VirtualTimeProvider time = new ();
+        using IApplication app = Application.Create (time);
+        app.Init (DriverRegistry.Names.ANSI);
+        Runnable runnable = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+
+        OptionSelector selector = new () { Y = 2, Orientation = Orientation.Horizontal };
+        runnable.Add (selector);
+
+        if (initiallyHidden)
+        {
+            selector.Visible = false;
+        }
+
+        app.Begin (runnable);
+
+        selector.Labels = ["IMDb (Recommended)", "TMDb"];
+        selector.Values = [0, 1];
+        selector.Visible = true;
+
+        app.LayoutAndDraw ();
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (2, checkBoxes.Length);
+        int expected = checkBoxes.Sum (cb => cb.Frame.Width);
+        Assert.Equal ("TMDb".Length + 2, checkBoxes [1].Frame.Width);
+        Assert.Equal (expected, selector.Frame.Width);
+        Assert.True (checkBoxes [1].Frame.Right <= selector.Viewport.Width);
+
+        runnable.Dispose ();
+    }
+
+    [Fact]
+    public void Horizontal_Labels_Set_Before_Add_Width_Fits_Content ()
+    {
+        VirtualTimeProvider time = new ();
+        using IApplication app = Application.Create (time);
+        app.Init (DriverRegistry.Names.ANSI);
+        Runnable runnable = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+
+        OptionSelector selector = new () { Y = 2, Orientation = Orientation.Horizontal };
+        selector.Labels = ["IMDb (Recommended)", "TMDb"];
+        selector.Values = [0, 1];
+        runnable.Add (selector);
+
+        app.Begin (runnable);
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (checkBoxes.Sum (cb => cb.Frame.Width), selector.Frame.Width);
+        Assert.Equal ("TMDb".Length + 2, checkBoxes [1].Frame.Width);
+        Assert.True (checkBoxes [1].Frame.Right <= selector.Viewport.Width);
+
+        runnable.Dispose ();
+    }
