 	if s.DisableOverwrite {
 		if _, err := os.Stat(path); err == nil {
@@ -686,3 +689,33 @@ func (s *Store) setClosed() {
 func ensureDir(path string) error {
 	return os.MkdirAll(path, 0777)
 }
+
+// ensureNoSymlinkComponents walks each path component of rel under base and
+// returns ErrPathTraversalDisallowed if any existing component (including the
+// final one) is a symbolic link, preventing writes from escaping base via
+// symlink traversal.
+func ensureNoSymlinkComponents(base, rel string) error {
+	if rel == "." || rel == "" {
+		return nil
+	}
+	current := base
+	for _, part := range strings.Split(rel, "/") {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		fi, err := os.Lstat(current)
+		if err != nil {
+			if os.IsNotExist(err) {
+				// the remaining components do not exist yet and will be
+				// created as regular directories / files.
+				return nil
+			}
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("%s: %w: symlink in path", current, ErrPathTraversalDisallowed)
+		}
+	}
+	return nil
+}
