+
+public class OptionSelectorTEnumInitTests
+{
+    [InlineData (null)]
+    [InlineData (TabBehavior.NoStop)]
+    [Theory]
+    public void Generic_New_FirstCheckBox_IsChecked (TabBehavior? tabBehavior)
+    {
+        OptionSelector<Orientation> selector = new () { TabBehavior = tabBehavior };
+
+        Assert.Equal (Orientation.Horizontal, selector.Value);
+        CheckBox [] cbs = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (CheckState.Checked, cbs [0].Value);
+        Assert.Equal (CheckState.UnChecked, cbs [1].Value);
+    }
+}
