+    [TestCase(true)]
+    [TestCase(false)]
+    public void DedicatedThreadPool_ThreadsAreStoppedOnShutdown(bool waitForJobsToComplete)
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 2 };
+        threadPool.Initialize();
+
+        var threads = new List<Thread>();
+        using var done = new CountdownEvent(2);
+
+        for (var i = 0; i < 2; i++)
+        {
+            threadPool.RunInThread(async () =>
+            {
+                lock (threads)
+                {
+                    threads.Add(Thread.CurrentThread);
+                }
+
+                // continuation is scheduled on the dedicated thread pool
+                await Task.Delay(TimeSpan.FromMilliseconds(50));
+
+                lock (threads)
+                {
+                    threads.Add(Thread.CurrentThread);
+                }
+
+                done.Signal();
+            });
+        }
+
+        Thread.Sleep(10);
+        threadPool.Shutdown(waitForJobsToComplete);
+
+        Assert.That(done.Wait(TimeSpan.FromSeconds(5)), Is.True);
+
+        List<Thread> capturedThreads;
+        lock (threads)
+        {
+            capturedThreads = threads.Distinct().ToList();
+        }
+
+        Assert.That(capturedThreads, Is.Not.Empty);
+        foreach (var thread in capturedThreads)
+        {
+            Assert.That(thread.Join(TimeSpan.FromSeconds(5)), Is.True, "Thread was not stopped after shutdown");
+        }
+    }
+
+    [Test]
+    public void DedicatedThreadPool_ShutdownWithoutRunningTasks()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread thread = null;
+        using var done = new ManualResetEventSlim();
+        threadPool.RunInThread(() =>
+        {
+            thread = Thread.CurrentThread;
+            done.Set();
+            return Task.CompletedTask;
+        });
+
+        Assert.That(done.Wait(TimeSpan.FromSeconds(5)), Is.True);
+        threadPool.Shutdown(waitForJobsToComplete: true);
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        Assert.That(thread.Join(TimeSpan.FromSeconds(5)), Is.True, "Thread was not stopped after shutdown");
+    }
