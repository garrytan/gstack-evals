+// getBackupVaultTags retrieves all tags of a backup vault.
+func getBackupVaultTags(ctx context.Context, client BackupVaultAPI, arn *string) (map[string]string, error) {
+	tags := make(map[string]string)
+	paginator := backup.NewListTagsPaginator(client, &backup.ListTagsInput{ResourceArn: arn})
+	for paginator.HasMorePages() {
+		page, err := paginator.NextPage(ctx)
+		if err != nil {
+			logging.Debugf("[Failed] listing tags of backup vault %s: %v", aws.ToString(arn), err)
+			return nil, err
+		}
+		for k, v := range page.Tags {
+			tags[k] = v
+		}
+	}
+	return tags, nil
+}
