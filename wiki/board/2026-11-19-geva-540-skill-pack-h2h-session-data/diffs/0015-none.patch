+/// A `.git` entry marks a repository boundary if it is a directory, or a
+/// gitfile whose `gitdir:` target resolves to an existing directory.
+/// Broken gitfiles (e.g. stale worktree links) are ignored.
+pub(crate) fn is_valid_git_boundary(git: &Path) -> bool {
+    if git.is_dir() {
+        return true;
+    }
+    if !git.is_file() {
+        return false;
+    }
+    let Ok(content) = std::fs::read_to_string(git) else {
+        return false;
+    };
+    let Some(target) = content
+        .lines()
+        .find_map(|l| l.trim().strip_prefix("gitdir:"))
+        .map(str::trim)
+        .filter(|t| !t.is_empty())
+    else {
+        return false;
+    };
+    let target = Path::new(target);
+    let resolved = if target.is_absolute() {
+        target.to_path_buf()
+    } else {
+        match git.parent() {
+            Some(dir) => dir.join(target),
+            None => return false,
+        }
+    };
+    resolved.is_dir()
+}
