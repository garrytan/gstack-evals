+    [Test]
+    public void DedicatedThreadPoolStopsItsThreadsOnShutdown()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 2 };
+        threadPool.Initialize();
+
+        using var jobDone = new ManualResetEventSlim();
+        Assert.That(threadPool.RunInThread(() => { jobDone.Set(); return Task.CompletedTask; }), Is.True);
+        Assert.That(jobDone.Wait(TimeSpan.FromSeconds(5)), Is.True);
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        var threads = (Thread[]) typeof(Quartz.Util.QueuedTaskScheduler)
+            .GetField("_threads", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+            .GetValue(threadPool.Scheduler)!;
+        Assert.That(threads, Has.Length.EqualTo(2));
+        Assert.That(threads.All(t => t.Join(TimeSpan.FromSeconds(5))), Is.True);
+    }
+
     private class CustomTaskSchedulingThreadPool : TaskSchedulingThreadPool
     {
         private readonly TaskScheduler taskScheduler;
