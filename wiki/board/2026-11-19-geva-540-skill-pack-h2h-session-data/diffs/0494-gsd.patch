@@ -0,0 +1,78 @@
+package tools.jackson.databind.convert;
+
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.exc.InvalidDefinitionException;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Tests for verifying that existing instances of local and anonymous
+ * classes can be updated (even though they cannot be constructed).
+ */
+public class UpdateLocalAnonymousClassTest extends DatabindTestUtil
+{
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testUpdateAnonymousInstance() throws Exception
+    {
+        Object resultObject = new Object() {
+            public int value;
+
+            @Override
+            public String toString() { return String.valueOf(value); }
+        };
+        Object result = MAPPER.readerForUpdating(resultObject)
+                .readValue(a2q("{'value': 2}"));
+        assertSame(resultObject, result);
+        assertEquals("2", result.toString());
+    }
+
+    @Test
+    public void testUpdateLocalInstance() throws Exception
+    {
+        class Local {
+            public int x;
+            public String name;
+        }
+        Local local = new Local();
+        Local result = MAPPER.readerForUpdating(local)
+                .readValue(a2q("{'x': 3, 'name':'foo'}"));
+        assertSame(local, result);
+        assertEquals(3, local.x);
+        assertEquals("foo", local.name);
+    }
+
+    @Test
+    public void testCannotCreateLocalInstance() throws Exception
+    {
+        class Local {
+            public int x;
+        }
+        InvalidDefinitionException e = assertThrows(InvalidDefinitionException.class,
+                () -> MAPPER.readValue(a2q("{'x': 3}"), Local.class));
+        verifyException(e, "local/anonymous");
+    }
+
+    @Test
+    public void testCannotCreateLocalInstanceInStaticContext() throws Exception
+    {
+        _testStaticLocal(MAPPER);
+    }
+
+    private static void _testStaticLocal(ObjectMapper mapper) {
+        class StaticLocal {
+            public int x;
+        }
+        InvalidDefinitionException e = assertThrows(InvalidDefinitionException.class,
+                () -> mapper.readValue(a2q("{'x': 3}"), StaticLocal.class));
+        verifyException(e, "local/anonymous");
+        // but updating works
+        StaticLocal local = new StaticLocal();
+        mapper.readerForUpdating(local).readValue(a2q("{'x': 5}"));
+        assertEquals(5, local.x);
+    }
+}
