+    /**
+     * Splits a text chunk by whitespaces. Unlike {@link TextChunkUtils#splitTextChunkByWhiteSpaces(TextChunk)},
+     * the removed whitespaces are kept as separate whitespace chunks (positioned between the text parts),
+     * so that later line building can restore word separators even when the gap is narrow.
+     */
+    static List<TextChunk> splitTextChunkKeepingWhiteSpaces(TextChunk textChunk) {
+        String value = textChunk.getValue();
+        if (value == null || value.isEmpty() || !TextChunkUtils.isContainsWhiteSpaceChar(value)) {
+            return Collections.singletonList(textChunk);
+        }
+        List<TextChunk> parts = new ArrayList<>();
+        for (TextChunk part : TextChunkUtils.splitTextChunkByWhiteSpaces(textChunk)) {
+            if (!part.isEmpty() && !part.isWhiteSpaceChunk()) {
+                parts.add(part);
+            }
+        }
+        List<TextChunk> result = new ArrayList<>();
+        if (parts.isEmpty()) {
+            // Whitespace-only chunk
+            result.add(createWhiteSpaceChunk(textChunk, textChunk.getLeftX(), textChunk.getRightX()));
+            return result;
+        }
+        if (TextChunkUtils.isWhiteSpaceChar(value.charAt(0))) {
+            result.add(createWhiteSpaceChunk(textChunk, textChunk.getLeftX(),
+                Math.max(textChunk.getLeftX(), parts.get(0).getLeftX())));
+        }
+        for (int i = 0; i < parts.size(); i++) {
+            TextChunk part = parts.get(i);
+            if (i > 0) {
+                TextChunk previousPart = parts.get(i - 1);
+                result.add(createWhiteSpaceChunk(textChunk, previousPart.getRightX(),
+                    Math.max(previousPart.getRightX(), part.getLeftX())));
+            }
+            result.add(part);
+        }
+        if (TextChunkUtils.isWhiteSpaceChar(value.charAt(value.length() - 1))) {
+            TextChunk lastPart = parts.get(parts.size() - 1);
+            result.add(createWhiteSpaceChunk(textChunk, lastPart.getRightX(),
+                Math.max(lastPart.getRightX(), textChunk.getRightX())));
+        }
+        return result;
+    }
+
+    private static TextChunk createWhiteSpaceChunk(TextChunk textChunk, double leftX, double rightX) {
+        BoundingBox boundingBox = new BoundingBox(textChunk.getBoundingBox());
+        boundingBox.setLeftX(leftX);
+        boundingBox.setRightX(rightX);
+        TextChunk whiteSpaceChunk = new TextChunk(boundingBox, " ", textChunk.getFontSize(), textChunk.getBaseLine());
+        whiteSpaceChunk.setFontName(textChunk.getFontName());
+        whiteSpaceChunk.setFontWeight(textChunk.getFontWeight());
+        whiteSpaceChunk.setItalicAngle(textChunk.getItalicAngle());
+        whiteSpaceChunk.setFontColor(textChunk.getFontColor());
+        whiteSpaceChunk.setTextFormat(textChunk.getTextFormat());
+        whiteSpaceChunk.adjustSymbolEndsToBoundingBox(null);
+        return whiteSpaceChunk;
+    }
