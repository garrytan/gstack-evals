+    /**
+     * Checks whether an explicit whitespace chunk from the PDF lies between two adjacent text chunks
+     * of the line. This keeps word separators when the visual gap is narrower than the threshold
+     * (e.g. fonts with narrow space glyphs or tightly justified text).
+     */
+    private static boolean hasWhiteSpaceBetween(TextLine textLine, double previousEnd, double currentStart,
+                                                List<BoundingBox> whiteSpaces) {
+        if (whiteSpaces.isEmpty()) {
+            return false;
+        }
+        BoundingBox lineBox = textLine.getBoundingBox();
+        double epsilon = textLine.getFontSize() * TextChunkUtils.TEXT_LINE_SPACE_RATIO;
+        for (BoundingBox whiteSpace : whiteSpaces) {
+            if (whiteSpace.getPageNumber() != null && lineBox.getPageNumber() != null &&
+                !whiteSpace.getPageNumber().equals(lineBox.getPageNumber())) {
+                continue;
+            }
+            double centerY = (whiteSpace.getBottomY() + whiteSpace.getTopY()) / 2;
+            if (centerY < lineBox.getBottomY() || centerY > lineBox.getTopY()) {
+                continue;
+            }
+            if (whiteSpace.getLeftX() >= previousEnd - epsilon && whiteSpace.getRightX() <= currentStart + epsilon) {
+                return true;
+            }
+        }
+        return false;
+    }
