+func TestContext_Scheme_rejectsUntrustedHeaderValues(t *testing.T) {
+	var testCases = []struct {
+		name   string
+		header string
+		value  string
+		expect string
+	}{
+		{name: "proto javascript", header: HeaderXForwardedProto, value: "javascript", expect: "http"},
+		{name: "proto data", header: HeaderXForwardedProto, value: "data", expect: "http"},
+		{name: "protocol file", header: HeaderXForwardedProtocol, value: "file", expect: "http"},
+		{name: "url scheme vbscript", header: HeaderXUrlScheme, value: "vbscript", expect: "http"},
+		{name: "proto with injection", header: HeaderXForwardedProto, value: "https://evil.com/#", expect: "http"},
+		{name: "proto uppercase https", header: HeaderXForwardedProto, value: " HTTPS ", expect: "https"},
+		{name: "proto ws", header: HeaderXForwardedProto, value: "ws", expect: "ws"},
+		{name: "proto wss", header: HeaderXForwardedProto, value: "wss", expect: "wss"},
+	}
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			c := &Context{request: &http.Request{Header: http.Header{tc.header: []string{tc.value}}}}
+			assert.Equal(t, tc.expect, c.Scheme())
+		})
+	}
+}
