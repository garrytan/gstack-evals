index 0000000..25ff5e9
--- /dev/null
+++ b/tests/features/embeddables/nested-inline-null.test.ts
@@ -0,0 +1,59 @@
+import { MikroORM } from '@mikro-orm/sqlite';
+import { Embeddable, Embedded, Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';
+import { mockLogger } from '../../helpers.js';
+
+@Embeddable()
+class Inner {
+  @Property({ nullable: true })
+  value?: string;
+}
+
+@Embeddable()
+class Outer {
+  @Property({ nullable: true })
+  name?: string;
+
+  @Embedded(() => Inner, { nullable: true })
+  inner?: Inner | null;
+}
+
+@Entity()
+class Thing {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Outer, { nullable: true })
+  outer?: Outer | null;
+}
+
+let orm: MikroORM;
+
+beforeAll(async () => {
+  orm = await MikroORM.init({
+    metadataProvider: ReflectMetadataProvider,
+    entities: [Thing],
+    dbName: ':memory:',
+  });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+
+test('nested inline embeddable with null parent', async () => {
+  const mock = mockLogger(orm);
+  orm.em.create(Thing, { outer: null });
+  await orm.em.flush();
+  expect(mock.mock.calls[1][0]).toMatch('insert into `thing` (`outer_name`, `outer_inner_value`) values (null, null)');
+  orm.em.clear();
+  mock.mockReset();
+  const t2 = orm.em.create(Thing, { outer: { name: 'a', inner: { value: 'b' } } });
+  await orm.em.flush();
+  t2.outer = null;
+  await orm.em.flush();
+  expect(mock.mock.calls[4][0]).toMatch('update `thing` set `outer_name` = null, `outer_inner_value` = null where `id` = 2');
+  orm.em.clear();
+  const r = await orm.em.findOneOrFail(Thing, t2.id);
+  expect(r.outer).toBeNull();
+  const all = await orm.em.find(Thing, { outer: null });
+  expect(all).toHaveLength(2);
+});
