new file mode 100644
index 0000000..a373525
--- /dev/null
+++ b/internal/fsext/dotstar_ignore_test.go
@@ -0,0 +1,35 @@
+package fsext
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestDotStarGitignoreDoesNotSkipRoot(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "example.txt"), []byte("x"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "another.go"), []byte("x"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".hidden"), []byte("x"), 0o644))
+
+	t.Run("ListDirectory", func(t *testing.T) {
+		files, _, err := ListDirectory(dir, nil, 0)
+		require.NoError(t, err)
+		require.ElementsMatch(t, []string{
+			filepath.Join(dir, "example.txt"),
+			filepath.Join(dir, "another.go"),
+		}, files)
+	})
+
+	t.Run("GlobWithDoubleStar", func(t *testing.T) {
+		files, _, err := GlobWithDoubleStar("**/*", dir, 0)
+		require.NoError(t, err)
+		require.ElementsMatch(t, []string{
+			filepath.Join(dir, "example.txt"),
+			filepath.Join(dir, "another.go"),
+		}, files)
+	})
+}
