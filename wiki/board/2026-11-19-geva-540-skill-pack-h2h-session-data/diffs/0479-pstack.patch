+// Turbostat repeats its header before every interval, and the repeated header
+// may differ from the first one in whitespace or in the set of columns.
+// Data rows always start with a number or "-", so any other first field marks a header.
+func isHeader(fields []string) bool {
+	if len(fields) == 0 || fields[0] == "-" {
+		return false
+	}
+	_, err := strconv.ParseFloat(fields[0], 64)
+	return err != nil
+}
+
+func parseHeader(fields []string) []column {
+	columns := make([]column, 0, len(fields))
+	for _, s := range fields {
+		columns = append(columns, createColumn(s))
+	}
+	return columns
+}
+
