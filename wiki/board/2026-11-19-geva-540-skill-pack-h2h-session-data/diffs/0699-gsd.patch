+using System.Collections.Specialized;
+
+using Quartz.Impl;
+using Quartz.Simpl;
+using Quartz.Spi;
+
+namespace Quartz.Tests.Unit.Core;
+
+[NonParallelizable]
+public class JobFactoryAsyncLocalTest
+{
+    private static readonly AsyncLocal<string> tenant = new AsyncLocal<string>();
+    private static TaskCompletionSource<string> observed = null!;
+
+    [Test]
+    public async Task AsyncLocalSetInJobFactoryShouldFlowToJobExecution()
+    {
+        observed = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        NameValueCollection properties = new NameValueCollection
+        {
+            ["quartz.scheduler.instanceName"] = nameof(JobFactoryAsyncLocalTest),
+            ["quartz.serializer.type"] = TestConstants.DefaultSerializerType,
+        };
+        IScheduler scheduler = await new StdSchedulerFactory(properties).GetScheduler();
+        scheduler.JobFactory = new TenantJobFactory();
+
+        try
+        {
+            IJobDetail job = JobBuilder.Create<TenantJob>()
+                .WithIdentity("job")
+                .UsingJobData("tenantId", "001")
+                .Build();
+            ITrigger trigger = TriggerBuilder.Create().WithIdentity("trigger").StartNow().Build();
+
+            await scheduler.ScheduleJob(job, trigger);
+            await scheduler.Start();
+
+            Task completed = await Task.WhenAny(observed.Task, Task.Delay(TimeSpan.FromSeconds(10)));
+            Assert.That(completed, Is.SameAs(observed.Task), "Job did not execute in time");
+            Assert.That(await observed.Task, Is.EqualTo("001"));
+        }
+        finally
+        {
+            await scheduler.Shutdown(true);
+        }
+    }
+
+    private sealed class TenantJobFactory : SimpleJobFactory
+    {
+        public override IJob NewJob(TriggerFiredBundle bundle, IScheduler scheduler)
+        {
+            tenant.Value = bundle.JobDetail.JobDataMap.GetString("tenantId");
+            return base.NewJob(bundle, scheduler);
+        }
+    }
+
+    private sealed class TenantJob : IJob
+    {
+        public async ValueTask Execute(IJobExecutionContext context)
+        {
+            await Task.Yield();
+            observed.TrySetResult(tenant.Value);
+        }
+    }
+}
