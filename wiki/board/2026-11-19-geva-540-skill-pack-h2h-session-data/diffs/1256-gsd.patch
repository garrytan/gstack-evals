 // Applies custom auth for file based acls
+// aclAuthorized reports whether the request satisfies the auth requirement
+// of the given .goshs ACL without writing anything to the response.
+func aclAuthorized(req *http.Request, acl configFile) bool {
+	if acl.Auth == "" {
+		return true
+	}
+	username, password, authOK := req.BasicAuth()
+	if !authOK {
+		return false
+	}
+	user, passwordHash, ok := strings.Cut(acl.Auth, ":")
+	if !ok {
+		return false
+	}
+	return username == user && checkPasswordHash(password, passwordHash)
+}
