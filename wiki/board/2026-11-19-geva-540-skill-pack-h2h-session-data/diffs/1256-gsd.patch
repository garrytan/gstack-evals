+	"golang.org/x/crypto/bcrypt"
+)
+
+// Regression tests for GHSA-rmxw-pq4x-3fvh: ?bulk must enforce .goshs ACLs.
+
+func setupBulkACL(t *testing.T) (string, *FileServer, func()) {
+	t.Helper()
+	dir := t.TempDir()
+	prot := filepath.Join(dir, "protected")
+	require.NoError(t, os.MkdirAll(filepath.Join(prot, "sub"), 0755))
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := fmt.Sprintf(`{"auth":"admin:%s","block":["blocked.txt","hidden/"]}`, string(hash))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, ".goshs"), []byte(acl), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "secret.txt"), []byte("secret"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "blocked.txt"), []byte("blocked"), 0644))
+	require.NoError(t, os.MkdirAll(filepath.Join(prot, "hidden"), 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "hidden", "h.txt"), []byte("h"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "sub", "deep.txt"), []byte("deep"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "public.txt"), []byte("public"), 0644))
+	fs, cleanup := newTestFileServer(t, dir)
+	return dir, fs, cleanup
+}
+
+func zipNames(t *testing.T, body []byte) []string {
+	t.Helper()
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	var names []string
+	for _, f := range zr.File {
+		names = append(names, f.Name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func TestBulkACL_UnauthenticatedProtectedFile(t *testing.T) {
+	_, fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+	for _, target := range []string{"/protected/secret.txt", "/protected", "/protected/sub/deep.txt"} {
+		r := httptest.NewRequest(http.MethodGet, "/?bulk&file="+target, nil)
+		w := httptest.NewRecorder()
+		fs.handler(w, r)
+		require.Equal(t, http.StatusUnauthorized, w.Code, target)
+		require.NotContains(t, w.Body.String(), "secret")
+	}
+}
+
+func TestBulkACL_RootWalkSkipsProtected(t *testing.T) {
+	_, fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/", nil)
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, []string{"public.txt"}, zipNames(t, w.Body.Bytes()))
+}
+
+func TestBulkACL_AuthorizedHonorsBlockList(t *testing.T) {
+	_, fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected&file=/protected/blocked.txt", nil)
+	r.SetBasicAuth("admin", "admin")
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, []string{"protected/secret.txt", "protected/sub/deep.txt"}, zipNames(t, w.Body.Bytes()))
+}
+
+func TestBulkACL_OnlyBlockedRequested(t *testing.T) {
+	_, fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected/blocked.txt", nil)
+	r.SetBasicAuth("admin", "admin")
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusNotFound, w.Code)
+	require.NotContains(t, w.Body.String(), "blocked")
+}
