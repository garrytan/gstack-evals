+
+// bulkACLCheck resolves the .goshs ACL relevant to absPath and reports whether
+// it must be hidden (block list / .goshs file) and whether the request is
+// authorized to read it. For directories the directory's own ACL applies
+// (as in doDir); for files the ACL of the containing directory applies
+// (as in doFile).
+func (fs *FileServer) bulkACLCheck(req *http.Request, absPath string, isDir bool) (blocked bool, authorized bool) {
+	name := filepath.Base(absPath)
+	if !isDir && name == ".goshs" {
+		return true, false
+	}
+
+	webroot := filepath.Clean(fs.Webroot)
+	if filepath.Clean(absPath) != webroot {
+		parentACL, err := fs.findEffectiveACL(filepath.Dir(absPath))
+		if err != nil {
+			logger.Errorf("error reading file based access config: %+v", err)
+			return true, false
+		}
+		blockName := name
+		if isDir {
+			blockName = name + "/"
+		}
+		if slices.Contains(parentACL.Block, blockName) {
+			return true, false
+		}
+		if !isDir {
+			return false, aclAuthorized(req, parentACL)
+		}
+	}
+
+	dirACL, err := fs.findEffectiveACL(absPath)
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+		return true, false
+	}
+	return false, aclAuthorized(req, dirACL)
+}
