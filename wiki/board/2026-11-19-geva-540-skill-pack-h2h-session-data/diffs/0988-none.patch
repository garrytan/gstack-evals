+describe('sanitizeTranslatedHtml srcdoc', () => {
+  test('neutralizes srcdoc attribute', () => {
+    expect(sanitizeTranslatedHtml('<iframe srcdoc="<b>x</b>"></iframe>')).toBe(
+      '<iframe &#115;rcdoc="&lt;b&gt;x&lt;/b&gt;"></iframe>'
+    )
+    expect(
+      sanitizeTranslatedHtml(
+        "<iframe SRCDOC='&lt;img src=x onerror=alert(1)&gt;'>"
+      )
+    ).not.toMatch(/[\s<]srcdoc/i)
+    expect(sanitizeTranslatedHtml('<iframe/srcdoc=x>')).toBe(
+      '<iframe/&#115;rcdoc=x>'
+    )
+  })
