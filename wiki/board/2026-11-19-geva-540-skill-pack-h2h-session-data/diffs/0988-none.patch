@@ -1119,3 +1119,20 @@ test('locale detector', () => {
   expect(translate(ctx, 'hi')).toEqual('hi kazupon !')
   expect(locale).toHaveBeenCalledTimes(2)
 })
+
+test('escapeParameter neutralizes srcdoc', () => {
+  const ctx = context({
+    locale: 'en',
+    escapeParameter: true,
+    messages: {
+      en: {
+        a: '<iframe srcdoc="<b>x</b>"></iframe>',
+        b: '<iframe srcdoc="{content}"></iframe>'
+      }
+    }
+  })
+  expect(translate(ctx, 'a')).not.toMatch(/\ssrcdoc/i)
+  expect(
+    translate(ctx, 'b', { content: '<img src=x onerror=alert(1)>' })
+  ).not.toMatch(/\ssrcdoc/i)
+})
