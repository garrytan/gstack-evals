@@ -1072,3 +1072,60 @@ public class OptionSelectorTests
 
     #endregion
 }
+
+public class OptionSelectorTEnumInitialCheckedTests
+{
+    private enum TestEnum
+    {
+        Zero,
+        One,
+        Two
+    }
+
+    private enum NonZeroEnum
+    {
+        Ten = 10,
+        Twenty = 20
+    }
+
+    [Fact]
+    public void New_GenericOptionSelector_Checks_CheckBox_For_Default_Value ()
+    {
+        OptionSelector<TestEnum> selector = new ();
+
+        Assert.Equal (TestEnum.Zero, selector.Value);
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (3, checkBoxes.Length);
+        Assert.Equal (CheckState.Checked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [2].Value);
+    }
+
+    [Fact]
+    public void New_GenericOptionSelector_NonZeroEnum_Checks_First ()
+    {
+        OptionSelector<NonZeroEnum> selector = new ();
+
+        Assert.Equal (NonZeroEnum.Ten, selector.Value);
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (CheckState.Checked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+
+        selector.Value = NonZeroEnum.Twenty;
+        Assert.Equal (CheckState.UnChecked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.Checked, checkBoxes [1].Value);
+    }
+
+    [Fact]
+    public void Changing_TabBehavior_Preserves_Checked_State ()
+    {
+        OptionSelector<TestEnum> selector = new () { Value = TestEnum.Two };
+
+        selector.TabBehavior = TabBehavior.NoStop;
+
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (CheckState.UnChecked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+        Assert.Equal (CheckState.Checked, checkBoxes [2].Value);
+    }
+}
