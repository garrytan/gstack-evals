diff --git a/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs b/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
index 56bcb96..1e5b534 100644
--- a/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
+++ b/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
@@ -10,7 +10,25 @@ public sealed class OptionSelector<TEnum> : OptionSelector, IValue where TEnum :
     /// <summary>
     ///     Initializes a new instance of the <see cref="OptionSelector{TEnum}"/> class.
     /// </summary>
-    public OptionSelector () => Labels = Enum.GetValues<TEnum> ().Select (f => f.ToString ()).ToArray ();
+    public OptionSelector ()
+    {
+        TEnum [] enumValues = Enum.GetValues<TEnum> ();
+        int [] values = enumValues.Select (f => Convert.ToInt32 (f)).ToArray ();
+
+        // Use the actual enum values (not 0..N-1) so non-contiguous enums map correctly.
+        // Note: this.Values setter throws by design; set the base property directly.
+        base.Values = values;
+
+        // The base constructor defaults Value to 0, which may not be a member of TEnum.
+        if (base.Value is { } current && !values.Contains (current))
+        {
+            base.Value = values.Length > 0 ? values [0] : null;
+        }
+
+        // Setting Labels creates the CheckBoxes and updates their checked state so that a
+        // freshly-constructed selector reflects Value without requiring UpdateChecked ().
+        Labels = enumValues.Select (f => f.ToString ()).ToArray ();
+    }
 
     /// <summary>
     ///     Gets or sets the value of the selected option.
