diff --git a/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs b/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
index 56bcb96..807c907 100644
--- a/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
+++ b/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
@@ -10,7 +10,28 @@ public sealed class OptionSelector<TEnum> : OptionSelector, IValue where TEnum :
     /// <summary>
     ///     Initializes a new instance of the <see cref="OptionSelector{TEnum}"/> class.
     /// </summary>
-    public OptionSelector () => Labels = Enum.GetValues<TEnum> ().Select (f => f.ToString ()).ToArray ();
+    /// <remarks>
+    ///     <see cref="SelectorBase.Values"/> are populated from the underlying enum values (which need not be
+    ///     zero-based or contiguous) and <see cref="SelectorBase.Labels"/> from the enum names. If the default
+    ///     <see cref="Value"/> is not a member of <typeparamref name="TEnum"/>, it is set to the first enum value so that
+    ///     the corresponding CheckBox is checked without needing to call <see cref="SelectorBase.UpdateChecked"/>.
+    /// </remarks>
+    public OptionSelector ()
+    {
+        TEnum [] enumValues = Enum.GetValues<TEnum> ();
+        List<int> values = enumValues.Select (f => Convert.ToInt32 (f)).ToList ();
+
+        // Use the base setter directly; this class's Values setter disallows external assignment.
+        base.Values = values;
+
+        if (base.Value is { } current && !values.Contains (current))
+        {
+            base.Value = values.Count > 0 ? values [0] : null;
+        }
+
+        // Setting Labels creates the CheckBoxes and updates their checked state.
+        Labels = enumValues.Select (f => f.ToString ()).ToArray ();
+    }
 
     /// <summary>
     ///     Gets or sets the value of the selected option.
diff --git a/Terminal.Gui/Views/Selectors/SelectorBase.cs b/Terminal.Gui/Views/Selectors/SelectorBase.cs
index 04f4315..49ce2e7 100644
