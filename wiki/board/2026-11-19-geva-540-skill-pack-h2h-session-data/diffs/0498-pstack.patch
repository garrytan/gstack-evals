+                let mut keys = Vec::new();
+                while let Some(kv) = iter.next().await.unwrap() {
+                    keys.push(kv.key);
+                }
+                let mut expected: Vec<&[u8]> = expected.clone();
+                if matches!(order, IterationOrder::Descending) {
+                    expected.reverse();
+                }
+                assert_eq!(keys, expected, "range {range:?} order {order:?}");
+            }
+        }
