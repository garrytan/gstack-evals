+        kv_store.put(b"a", b"v0").await.unwrap();
+        kv_store.put(b"b", b"v1").await.unwrap();
+        kv_store.flush().await.unwrap();
+        kv_store.put(b"c", b"v2").await.unwrap();
+
+        let empty = Bytes::new();
+        let c = Bytes::from_static(b"c");
+        let cases: Vec<((Bound<Bytes>, Bound<Bytes>), Vec<&[u8]>)> = vec![
+            ((Included(empty.clone()), Unbounded), vec![b"a", b"b", b"c"]),
+            ((Excluded(empty.clone()), Unbounded), vec![b"a", b"b", b"c"]),
+            ((Included(empty.clone()), Excluded(c.clone())), vec![b"a", b"b"]),
+            ((Excluded(empty.clone()), Included(c.clone())), vec![b"a", b"b", b"c"]),
+            ((Unbounded, Excluded(empty.clone())), vec![]),
+            ((Unbounded, Included(empty.clone())), vec![]),
+            ((Included(empty.clone()), Excluded(empty.clone())), vec![]),
+            ((Included(empty.clone()), Included(empty.clone())), vec![]),
+        ];
+
+        for order in [IterationOrder::Ascending, IterationOrder::Descending] {
+            let scan_options = ScanOptions::default().with_order(order);
