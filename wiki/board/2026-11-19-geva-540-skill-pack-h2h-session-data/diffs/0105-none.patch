@@ -0,0 +1,78 @@
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Core.Dictionaries;
+using Nikse.SubtitleEdit.Core.Forms.FixCommonErrors;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+using Nikse.SubtitleEdit.Logic.Config;
+
+namespace UITests.Features.Tools.FixCommonErrors;
+
+[Collection("Se.DictionariesFolder")]
+public class FixCommonOcrErrorsTests : IDisposable
+{
+    private const string ReplaceListXml = """
+        <?xml version="1.0" encoding="utf-8"?>
+        <OCRFixReplaceList>
+          <WholeWords>
+            <Word from="aca" to="acá" />
+            <Word from="adios" to="adiós" />
+            <Word from="algun" to="algún" />
+            <Word from="dia" to="día" />
+            <Word from="volvere" to="volveré" />
+          </WholeWords>
+        </OCRFixReplaceList>
+        """;
+
+    private readonly string _folder;
+    private readonly string? _oldDictionariesFolder;
+    private readonly Func<string> _oldConfigFolder;
+
+    public FixCommonOcrErrorsTests()
+    {
+        _folder = Path.Combine(Path.GetTempPath(), "SE.FixCommonOcrErrorsTests", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_folder);
+        File.WriteAllText(Path.Combine(_folder, "spa_OCRFixReplaceList.xml"), ReplaceListXml);
+
+        _oldDictionariesFolder = Se.DictionariesFolder;
+        _oldConfigFolder = SpellCheckConfig.DictionariesFolder;
+        Se.DictionariesFolder = _folder;
+        SpellCheckConfig.DictionariesFolder = () => _folder;
+    }
+
+    public void Dispose()
+    {
+        Se.DictionariesFolder = _oldDictionariesFolder!;
+        SpellCheckConfig.DictionariesFolder = _oldConfigFolder;
+        FixCommonOcrErrors.OcrFixEngine = null;
+        try { Directory.Delete(_folder, true); } catch { /* ignore */ }
+    }
+
+    [Fact]
+    public void Fix_SpanishReplaceList_AppliedWithoutHunspellDictionary()
+    {
+        var subtitle = new Subtitle();
+        subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 2000));
+        subtitle.Paragraphs.Add(new Paragraph("Adios.", 3000, 5000));
+        subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 6000, 8000));
+
+        FixCommonOcrErrors.OcrFixEngine = new OcrFixEngine(new SpellCheckManager());
+        new FixCommonOcrErrors().Fix(subtitle, new EmptyFixCallback { Language = "es" });
+
+        Assert.Equal("Hola, acá estoy.", subtitle.Paragraphs[0].Text);
+        Assert.Equal("Adiós.", subtitle.Paragraphs[1].Text);
+        Assert.Equal("Algún día volveré.", subtitle.Paragraphs[2].Text);
+    }
+
+    [Theory]
+    [InlineData("adios", "adiós")]
+    [InlineData("Adios", "Adiós")]
+    [InlineData("Adios.", "Adiós.")]
+    [InlineData("ADIOS", "ADIÓS")]
+    [InlineData("<i>Adios</i>", "<i>Adiós</i>")]
+    [InlineData("Hola", "Hola")]
+    public void FixCommonWordErrors_MatchesCapitalizedWords(string input, string expected)
+    {
+        var list = OcrFixReplaceList2.FromLanguageId("spa");
+        Assert.Equal(expected, list.FixCommonWordErrors(input));
+    }
+}
