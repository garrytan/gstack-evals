diff --git a/test/sql/aggregate/aggregates/test_volatile_aggregate_cse.test b/test/sql/aggregate/aggregates/test_volatile_aggregate_cse.test
new file mode 100644
index 0000000..26b2a31
--- /dev/null
+++ b/test/sql/aggregate/aggregates/test_volatile_aggregate_cse.test
@@ -0,0 +1,26 @@
+# name: test/sql/aggregate/aggregates/test_volatile_aggregate_cse.test
+# description: Duplicate aggregates/windows over volatile expressions must not be deduplicated
+# group: [aggregates]
+
+query I
+select any_value(uuid()::varchar) = any_value(uuid()::varchar) from range(3)
+----
+false
+
+query II
+select g, any_value(uuid()::varchar) over (partition by g) = any_value(uuid()::varchar) over (partition by g)
+from (values (1),(1),(2),(2)) t(g) order by g
+----
+1	false
+1	false
+2	false
+2	false
+
+query II
+select g, any_value(uuid()::varchar) over (order by g) = any_value(uuid()::varchar) over (order by g)
+from (values (1),(1),(2),(2)) t(g) order by g
+----
+1	false
+1	false
+2	false
+2	false
