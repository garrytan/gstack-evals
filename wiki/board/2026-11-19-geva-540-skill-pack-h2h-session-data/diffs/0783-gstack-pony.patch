+import { flushSync } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	html: `<button>0 0</button>`,
+
+	test({ assert, target }) {
+		const button = /** @type {HTMLButtonElement} */ (target.querySelector('button'));
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, `<button>1 1</button>`);
+	}
+});
diff --git a/packages/svelte/tests/runtime-runes/samples/abort-signal-state-mutation/main.svelte b/packages/svelte/tests/runtime-runes/samples/abort-signal-state-mutation/main.svelte
