+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     Tests that a child-only redraw (a SuperView entered into <see cref="View.Draw(DrawContext?)"/> solely because
+///     <c>SubViewNeedsDraw</c> is set) does not escalate into a full redraw of the SuperView's viewport, text, and
+///     content — while keeping the rendered output identical to a full redraw.
+/// </summary>
+[Trait ("Category", "Output")]
+public class ChildOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    /// <summary>A View that counts clear/text/content draw work actually performed.</summary>
+    private sealed class CountingView : View
+    {
+        public int ClearingViewportCount { get; private set; }
+        public int DrawingTextCount { get; private set; }
+        public int DrawingContentCount { get; private set; }
+
+        public void Reset ()
+        {
+            ClearingViewportCount = 0;
+            DrawingTextCount = 0;
+            DrawingContentCount = 0;
+        }
+
+        protected override bool OnClearingViewport ()
+        {
+            ClearingViewportCount++;
+
+            return base.OnClearingViewport ();
+        }
+
+        protected override bool OnDrawingText ()
+        {
+            DrawingTextCount++;
+
+            return base.OnDrawingText ();
+        }
+
+        protected override bool OnDrawingContent (DrawContext? context)
+        {
+            DrawingContentCount++;
+
+            return base.OnDrawingContent (context);
+        }
+    }
+
+    /// <summary>
+    ///     Draws <paramref name="root"/> the way the application main loop does: the clip is reset to the screen first
+    ///     (each Draw excludes the drawn view from the clip).
+    /// </summary>
+    private static void DrawRoot (View root)
+    {
+        root.SetClipToScreen ();
+        root.Draw ();
+    }
+
+    private static string RenderContents (IDriver driver)
+    {
+        StringBuilder sb = new ();
+        Cell [,] contents = driver.Contents!;
+
+        for (var r = 0; r < contents.GetLength (0); r++)
+        {
+            for (var c = 0; c < contents.GetLength (1); c++)
+            {
+                sb.Append (contents [r, c].Grapheme);
+            }
+
+            sb.AppendLine ();
+        }
+
+        return sb.ToString ();
+    }
+
+    /// <summary>Renders the driver's buffer through the <see cref="IOutput"/> layer (ANSI, incl. attributes).</summary>
+    private static string RenderOutput (IDriver driver) => driver.GetOutput ().ToAnsi (driver.GetOutputBuffer ());
+
+    /// <summary>
+    ///     Asserts that what is on screen after a child-only redraw is identical (at both the Contents and the
+    ///     <see cref="IOutput"/> level) to what a full redraw of <paramref name="root"/> produces.
+    /// </summary>
+    private void AssertMatchesFullRedraw (View root, IDriver driver)
+    {
+        string childOnlyContents = RenderContents (driver);
+        string childOnlyAnsi = RenderOutput (driver);
+
+        root.SetNeedsDraw ();
+        DrawRoot (root);
+
+        string fullContents = RenderContents (driver);
+        string fullAnsi = RenderOutput (driver);
+
+        output.WriteLine (fullContents);
+
+        Assert.Equal (fullContents, childOnlyContents);
+        Assert.Equal (fullAnsi, childOnlyAnsi);
+    }
+
+    private static (View root, CountingView parent, CountingView child1, CountingView child2, IDriver driver) BuildSimple ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+
+        CountingView parent = new () { Text = "Parent", Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+        CountingView child1 = new () { Text = "Child1", X = 0, Y = 1, Width = 8, Height = 1 };
+        CountingView child2 = new () { Text = "Child2", X = 9, Y = 1, Width = 8, Height = 1 };
+        parent.Add (child1, child2);
+        root.Add (parent);
+
+        root.Layout ();
+        DrawRoot (root);
+
+        parent.Reset ();
+        child1.Reset ();
+        child2.Reset ();
+
+        return (root, parent, child1, child2, driver);
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_Does_Not_Clear_Or_Redraw_Parent ()
+    {
+        (View root, CountingView parent, CountingView child1, CountingView child2, IDriver driver) = BuildSimple ();
+
+        child1.Text = "Changed";
+        root.Layout ();
+
+        Assert.False (parent.NeedsDraw);
+        Assert.True (parent.SubViewNeedsDraw);
+
+        DrawRoot (root);
+
+        Assert.Equal (0, parent.ClearingViewportCount);
+        Assert.Equal (0, parent.DrawingTextCount);
+        Assert.Equal (0, parent.DrawingContentCount);
+
+        Assert.Equal (1, child1.ClearingViewportCount);
+        Assert.Equal (1, child1.DrawingTextCount);
+
+        // The peer that was not dirty is not redrawn.
+        Assert.Equal (0, child2.ClearingViewportCount);
+        Assert.Equal (0, child2.DrawingTextCount);
+
+        Assert.False (parent.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+        Assert.False (child1.NeedsDraw);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Parent_Dirty_Still_Clears_And_Redraws ()
+    {
+        (View root, CountingView parent, CountingView child1, CountingView child2, IDriver driver) = BuildSimple ();
+
+        parent.SetNeedsDraw ();
+        DrawRoot (root);
+
+        Assert.Equal (1, parent.ClearingViewportCount);
+        Assert.Equal (1, parent.DrawingTextCount);
+        Assert.Equal (1, parent.DrawingContentCount);
+        Assert.Equal (1, child1.ClearingViewportCount);
+        Assert.Equal (1, child2.ClearingViewportCount);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_In_Partially_Clipped_Parent_Renders_Correctly ()
+    {
+        IDriver driver = CreateTestDriver (12, 5);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+
+        // Parent extends beyond the screen; child is partially clipped.
+        CountingView parent = new () { X = 2, Y = 1, Width = 20, Height = 10, BorderStyle = LineStyle.Single };
+        CountingView child = new () { X = 5, Y = 0, Width = 10, Height = 2, Text = "0123456789" };
+        parent.Add (child);
+        root.Add (parent);
+
+        root.Layout ();
+        DrawRoot (root);
+        parent.Reset ();
+
+        child.Text = "abcdefghij";
+        root.Layout ();
+        DrawRoot (root);
+
+        Assert.Equal (0, parent.ClearingViewportCount);
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Transparent_Dirty_Child_Escalates_To_Full_Parent_Redraw ()
+    {
+        (View root, CountingView parent, CountingView child1, CountingView _, IDriver driver) = BuildSimple ();
+
+        child1.ViewportSettings |= ViewportSettingsFlags.Transparent;
+        DrawRoot (root);
+        parent.Reset ();
+
+        // Shrinking text of a transparent child must reveal the parent's freshly-drawn content.
+        child1.Text = "X";
+        root.Layout ();
+        DrawRoot (root);
+
+        Assert.Equal (1, parent.ClearingViewportCount);
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Shadow_SubView_Escalates_To_Full_Parent_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        CountingView parent = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        CountingView child1 = new () { Text = "Child1", X = 1, Y = 1, Width = 8, Height = 1 };
+        View shadowed = new () { Text = "Shadow", X = 1, Y = 3, Width = 8, Height = 1, ShadowStyle = ShadowStyles.Transparent };
+        parent.Add (child1, shadowed);
+        root.Add (parent);
+
+        root.Layout ();
+        DrawRoot (root);
+        parent.Reset ();
+
+        child1.Text = "Changed";
+        root.Layout ();
+        DrawRoot (root);
+
+        // A peer with a shadow forces a full redraw so the shadow is not composited over stale (already shadowed) cells.
+        Assert.Equal (1, parent.ClearingViewportCount);
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Tiled_SuperViewRendersLineCanvas_ChildOnly_Redraw_Preserves_AutoJoin ()
+    {
+        IDriver driver = CreateTestDriver (21, 5);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        CountingView parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+
+        CountingView left = new ()
+        {
+            Text = "L", X = -1, Y = -1, Width = 11, Height = 5, BorderStyle = LineStyle.Single, SuperViewRendersLineCanvas = true
+        };
+
+        CountingView right = new ()
+        {
+            Text = "R", X = 9, Y = -1, Width = 11, Height = 5, BorderStyle = LineStyle.Single, SuperViewRendersLineCanvas = true
+        };
+        parent.Add (left, right);
+        root.Add (parent);
+
+        root.Layout ();
+        DrawRoot (root);
+        string before = RenderContents (driver);
+        output.WriteLine (before);
+        Assert.Contains ("┬", before);
+        Assert.Contains ("┴", before);
+
+        parent.Reset ();
+        right.Reset ();
+
+        left.Text = "LL";
+        root.Layout ();
+        DrawRoot (root);
+
+        Assert.Equal (0, parent.ClearingViewportCount);
+        Assert.Equal (0, right.ClearingViewportCount);
+
+        string after = RenderContents (driver);
+        Assert.Contains ("┬", after);
+        Assert.Contains ("┴", after);
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    /// <summary>A View that contributes a line (outside its own frame) to its SuperView's LineCanvas.</summary>
+    private sealed class LineContributingView : View
+    {
+        public bool ContributeLine { get; set; } = true;
+
+        protected override bool OnDrawingContent (DrawContext? context)
+        {
+            if (ContributeLine)
+            {
+                // Two rows below this view's frame, i.e. in the SuperView's area.
+                Point start = FrameToScreen ().Location with { Y = FrameToScreen ().Bottom + 1 };
+                LineCanvas.AddLine (start, 6, Orientation.Horizontal, LineStyle.Double);
+            }
+
+            return base.OnDrawingContent (context);
+        }
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_That_Removes_Lines_Escalates_To_Full_Parent_Redraw ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        CountingView parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+        LineContributingView child = new () { Text = "C", X = 1, Y = 1, Width = 8, Height = 2, SuperViewRendersLineCanvas = true };
+        parent.Add (child);
+        root.Add (parent);
+
+        root.Layout ();
+        DrawRoot (root);
+        Assert.Contains ("═", RenderContents (driver));
+        parent.Reset ();
+
+        // The child stops contributing the line; only the child is invalidated.
+        child.ContributeLine = false;
+        child.SetNeedsDraw ();
+        Assert.False (parent.NeedsDraw);
+        Assert.True (parent.SubViewNeedsDraw);
+
+        DrawRoot (root);
+
+        // The line lives outside the child's frame, so only the parent can erase it: the child-only redraw
+        // must escalate to a full parent redraw rather than leave the line stale.
+        Assert.Equal (1, parent.ClearingViewportCount);
+        Assert.DoesNotContain ("═", RenderContents (driver));
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnly_Redraw_With_Unchanged_Lines_Does_Not_Escalate ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        CountingView parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+        LineContributingView child = new () { Text = "C", X = 1, Y = 1, Width = 8, Height = 2, SuperViewRendersLineCanvas = true };
+        parent.Add (child);
+        root.Add (parent);
+
+        root.Layout ();
+        DrawRoot (root);
+        parent.Reset ();
+
+        child.Text = "D";
+        root.Layout ();
+        DrawRoot (root);
+
+        Assert.Equal (0, parent.ClearingViewportCount);
+        Assert.Contains ("═", RenderContents (driver));
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Padding_SubView_Redraw_Does_Not_Clear_Parent_Viewport ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        CountingView parent = new () { Text = "Parent", Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+        parent.Padding.Thickness = new Thickness (0, 1, 0, 0);
+        View paddingChild = new () { Text = "Pad", X = 0, Y = 0, Width = 6, Height = 1 };
+        parent.Padding.GetOrCreateView ().Add (paddingChild);
+        root.Add (parent);
+
+        root.Layout ();
