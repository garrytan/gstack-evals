+    private static string MakeText (string prefix, int lines)
+    {
+        StringBuilder sb = new ();
+
+        for (var i = 1; i <= lines; i++)
+        {
+            sb.Append ($"{prefix}{i}");
+
+            if (i < lines)
+            {
+                sb.Append ('\n');
+            }
+        }
+
+        return sb.ToString ();
+    }
+
+    private static (View root, Tabs tabs, CountingTabPage [] pages, IDriver driver) BuildTabs (Action<CountingTabPage []>? configure = null)
+    {
