+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        CountingTabPage [] pages = new CountingTabPage [3];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            pages [i] = new CountingTabPage { Title = $"Tab{i + 1}", Text = MakeText ($"P{i + 1}.", 30), Width = Dim.Fill (), Height = Dim.Fill () };
+            pages [i].SetContentSize (new Size (20, 30));
+            tabs.Add (pages [i]);
+        }
+
+        configure?.Invoke (pages);
+
+        root.Layout ();
+        DrawRoot (root);
+
+        return (root, tabs, pages, driver);
+    }
