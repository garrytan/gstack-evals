+// streamDeadliner is implemented by the quic-go HTTP/3 response writer,
+// which allows setting deadlines on the underlying QUIC request stream.
+type streamDeadliner interface {
+	SetReadDeadline(time.Time) error
+	SetWriteDeadline(time.Time) error
+}
+
+// newHTTP3TimeoutHandler enforces the responding timeouts on HTTP/3 requests.
+// Contrary to HTTP/1.1 and HTTP/2, where these timeouts are applied as deadlines on the TCP connection,
+// HTTP/3 requests are carried by QUIC streams, so the deadlines have to be applied on each request stream.
+func newHTTP3TimeoutHandler(next http.Handler, readTimeout, writeTimeout time.Duration) http.Handler {
+	if readTimeout <= 0 && writeTimeout <= 0 {
+		return next
+	}
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		start := time.Now()
+
+		deadliner, ok := rw.(streamDeadliner)
+		if !ok {
+			log.WithoutContext().Debugf("Unable to set HTTP/3 stream deadlines: unsupported response writer %T", rw)
+			next.ServeHTTP(rw, req)
+			return
+		}
+
+		if readTimeout > 0 {
+			if err := deadliner.SetReadDeadline(start.Add(readTimeout)); err != nil {
+				log.WithoutContext().Debugf("Unable to set HTTP/3 stream read deadline: %v", err)
+			}
+		}
+
+		if writeTimeout > 0 {
+			if err := deadliner.SetWriteDeadline(start.Add(writeTimeout)); err != nil {
+				log.WithoutContext().Debugf("Unable to set HTTP/3 stream write deadline: %v", err)
+			}
+		}
+
+		next.ServeHTTP(rw, req)
+	})
+}
+
 func (e *http3server) Start() error {
 	return e.Serve(e.http3conn)
 }
