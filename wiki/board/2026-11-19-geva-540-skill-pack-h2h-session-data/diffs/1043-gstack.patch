+
+func TestDispatchUniqueCycleAndAmplification(t *testing.T) {
+	// Cycles terminate without revisiting.
+	a, b := newDesc("a"), newDesc("b")
+	var calls atomic.Int32
+	cyclic := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls.Add(1)
+		if desc.Digest == a.Digest {
+			return []ocispec.Descriptor{b}, nil
+		}
+		return []ocispec.Descriptor{a}, nil
+	})
+	require.NoError(t, DispatchUnique(context.Background(), cyclic, nil, a))
+	assert.Equal(t, int32(2), calls.Load())
+
+	// Layered fan-out of identical descriptors does not amplify work.
+	calls.Store(0)
+	nodes := make([]ocispec.Descriptor, 8)
+	for i := range nodes {
+		nodes[i] = newDesc(fmt.Sprintf("n%d", i))
+	}
+	fanout := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls.Add(1)
+		for i, n := range nodes[:len(nodes)-1] {
+			if n.Digest == desc.Digest {
+				children := make([]ocispec.Descriptor, 100)
+				for j := range children {
+					children[j] = nodes[i+1]
+				}
+				return children, nil
+			}
+		}
+		return nil, nil
+	})
+	require.NoError(t, DispatchUnique(context.Background(), fanout, nil, nodes[0]))
+	assert.Equal(t, int32(len(nodes)), calls.Load())
+}
