@@ -0,0 +1,16 @@
+package oci
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestValidateFileName(t *testing.T) {
+	for _, name := range []string{"db.tar.gz", "trivy-checks.tar.gz", "module.wasm"} {
+		assert.NoError(t, validateFileName(name), name)
+	}
+	for _, name := range []string{"", ".", "..", "../evil", "../../etc/passwd", "/etc/passwd", `..\evil`, "a/b", "a\x00b"} {
+		assert.Error(t, validateFileName(name), name)
+	}
+}
