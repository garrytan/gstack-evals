+// validateFileName ensures the file name is a plain base name and cannot escape the destination directory.
+func validateFileName(fileName string) error {
+	switch {
+	case fileName == "", fileName == ".", fileName == "..":
+		return xerrors.Errorf("%q is not allowed", fileName)
+	case strings.ContainsAny(fileName, `/\`+"\x00"):
+		return xerrors.Errorf("%q must not contain path separators", fileName)
+	case filepath.IsAbs(fileName), filepath.VolumeName(fileName) != "":
+		return xerrors.Errorf("%q must not be an absolute path", fileName)
+	case filepath.Base(fileName) != fileName:
+		return xerrors.Errorf("%q must be a base name", fileName)
+	}
+	return nil
+}
