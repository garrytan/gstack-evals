+# test that .chezmoidata files support TOML v1.1.0
+exec chezmoi execute-template '{{ .table.key }} {{ index .array 1 }} {{ .escape }}'
+stdout '^value b \x1b$'
+
+-- home/user/.local/share/chezmoi/.chezmoidata.toml --
