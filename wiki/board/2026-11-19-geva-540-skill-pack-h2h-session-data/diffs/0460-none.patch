diff --git a/internal/chezmoi/format.go b/internal/chezmoi/format.go
index 341ac66..778480a 100644
--- a/internal/chezmoi/format.go
+++ b/internal/chezmoi/format.go
@@ -10,6 +10,7 @@ import (
 	"slices"
 	"strings"
 
+	burntsushitoml "github.com/BurntSushi/toml"
 	"github.com/goccy/go-yaml"
 	"github.com/pelletier/go-toml/v2"
 	"github.com/tailscale/hujson"
@@ -159,6 +160,32 @@ func (formatTOML) Name() string {
 
 // Unmarshal implements Format.Unmarshal.
 func (formatTOML) Unmarshal(data []byte, value any) error {
+	// Parse with github.com/BurntSushi/toml as it supports TOML v1.1.0,
+	// whereas github.com/pelletier/go-toml/v2 only supports TOML v1.0.0.
+	var parsed map[string]any
+	if _, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(&parsed); err != nil {
+		return err
+	}
+	if parsed == nil {
+		parsed = make(map[string]any)
+	}
+
+	switch value := value.(type) {
+	case *map[string]any:
+		*value = parsed
+		return nil
+	case *any:
+		*value = parsed
+		return nil
+	}
+
+	// For other types, re-encode the parsed data as TOML v1.0.0 and decode it
+	// with github.com/pelletier/go-toml/v2 in strict mode to detect unknown
+	// fields.
+	data, err := toml.Marshal(parsed)
+	if err != nil {
+		return err
+	}
 	decoder := toml.NewDecoder(bytes.NewReader(data))
 	decoder.DisallowUnknownFields()
 	return decoder.Decode(value)
