+    /**
+     * Tight word spacing (0.15em, e.g. justified text positioned via TJ offsets without
+     * space glyphs) must still produce a space; adjacent chunks must not.
+     */
+    @Test
+    public void testProcessTextLinesAddsSpacesForTightWordGaps() {
+        StaticContainers.setIsIgnoreCharactersWithoutUnicode(false);
+        StaticContainers.setIsDataLoader(true);
+        List<IObject> contents = new ArrayList<>();
+        // font size 10: "Lexical" ends at 40, "Search" starts 1.5pt later, "es" touches it
+        contents.add(new TextChunk(new BoundingBox(0, 10.0, 300.0, 40.0, 310.0), "Lexical", 10, 300.0));
+        contents.add(new TextChunk(new BoundingBox(0, 41.5, 300.0, 70.0, 310.0), "Search", 10, 300.0));
+        contents.add(new TextChunk(new BoundingBox(0, 70.0, 300.0, 80.0, 310.0), "es", 10, 300.0));
+
+        contents = TextLineProcessor.processTextLines(contents);
+
+        Assertions.assertEquals(1, contents.size());
+        Assertions.assertEquals("Lexical Searches", ((TextLine) contents.get(0)).getValue());
