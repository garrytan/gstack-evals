diff --git a/test/sql/optimizer/test_volatile_aggregate_window_cse.test b/test/sql/optimizer/test_volatile_aggregate_window_cse.test
new file mode 100644
index 0000000..9ba9e6c
--- /dev/null
+++ b/test/sql/optimizer/test_volatile_aggregate_window_cse.test
@@ -0,0 +1,44 @@
+# name: test/sql/optimizer/test_volatile_aggregate_window_cse.test
+# description: Identical aggregate/window calls over volatile functions must not be deduplicated
+# group: [optimizer]
+
+statement ok
+PRAGMA enable_verification
+
+# window functions
+query II
+select g, any_value(uuid()::varchar) over (partition by g) = any_value(uuid()::varchar) over (partition by g)
+from (values (1),(1),(2),(2)) t(g) order by g;
+----
+1	false
+1	false
+2	false
+2	false
+
+# grouped aggregates
+query II
+select g, any_value(uuid()::varchar) = any_value(uuid()::varchar)
+from (values (1),(1),(2),(2)) t(g) group by g order by g;
+----
+1	false
+2	false
+
+# ungrouped aggregates
+query I
+select any_value(gen_random_uuid()) = any_value(gen_random_uuid()) from range(3);
+----
+false
+
+# with the optimizer disabled as well
+statement ok
+PRAGMA disable_optimizer
+
+query I
+select any_value(uuid()) = any_value(uuid()) from range(3);
+----
+false
+
+query I
+select count(*) from (select any_value(uuid()) over () = any_value(uuid()) over () as eq from range(3)) where eq;
+----
+0
