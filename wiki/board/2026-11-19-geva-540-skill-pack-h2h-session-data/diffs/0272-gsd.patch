+
+        /** Header row + data rows: cells created after SetDefaultColumnStyle get the column style */
+        [Test]
+        public void DefaultColumnStyleAppliedToNewCells()
+        {
+            IWorkbook wb = _testDataProvider.CreateWorkbook();
+            ICellStyle headerStyle = wb.CreateCellStyle();
+            headerStyle.Alignment = HorizontalAlignment.Center;
+            ICellStyle defaultStyle = wb.CreateCellStyle();
+            defaultStyle.Alignment = HorizontalAlignment.Right;
+            ISheet sheet = wb.CreateSheet();
+
+            IRow header = sheet.CreateRow(0);
+            for (int c = 0; c < 3; c++)
+            {
+                ICell hc = header.CreateCell(c);
+                hc.CellStyle = headerStyle;
+                hc.SetCellValue("h" + c);
+                sheet.SetDefaultColumnStyle(c, defaultStyle);
+            }
+
+            for (int r = 1; r <= 3; r++)
+            {
+                IRow row = sheet.CreateRow(r);
+                for (int c = 0; c < 3; c++)
+                {
+                    ICell dc = row.CreateCell(c);
+                    dc.SetCellValue(r * 10 + c);
+                    ClassicAssert.AreEqual(defaultStyle.Index, dc.CellStyle.Index);
+                }
+            }
+            // a column without default style keeps the workbook default
+            ClassicAssert.AreNotEqual(defaultStyle.Index, sheet.GetRow(1).CreateCell(5).CellStyle.Index);
+
+            IWorkbook wb2 = _testDataProvider.WriteOutAndReadBack(wb);
+            ISheet sheet2 = wb2.GetSheetAt(0);
+            for (int r = 1; r <= 3; r++)
+            {
+                for (int c = 0; c < 3; c++)
+                {
+                    ClassicAssert.AreEqual(HorizontalAlignment.Right, sheet2.GetRow(r).GetCell(c).CellStyle.Alignment);
+                }
+            }
+            wb2.Close();
+            wb.Close();
+        }
