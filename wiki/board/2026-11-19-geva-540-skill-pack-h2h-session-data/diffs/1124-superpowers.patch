+// stripTrailerValues removes request trailer values from the outgoing request.
+// Trailers arrive after the body, once routing and security decisions (such as header sanitization)
+// have already been made, so their values must not be forwarded to the backend.
+// Body-buffering middlewares (e.g. retry, buffering) read the body before the request is cloned,
+// which populates the trailer values and would otherwise forward them.
+// Only the declared trailer names are kept, as permitted by RFC 9110 section 6.6.2.
+func stripTrailerValues(outReq *http.Request) {
+	if outReq.Trailer == nil {
+		return
+	}
+
+	trailer := make(http.Header, len(outReq.Trailer))
+	for name := range outReq.Trailer {
+		trailer[name] = nil
+	}
+	outReq.Trailer = trailer
+}
