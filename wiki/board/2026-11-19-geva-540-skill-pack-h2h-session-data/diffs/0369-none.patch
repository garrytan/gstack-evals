diff --git a/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs b/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
index 56bcb96..a4df7b8 100644
--- a/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
+++ b/Terminal.Gui/Views/Selectors/OptionSelectorTEnum.cs
@@ -10,7 +10,23 @@ public sealed class OptionSelector<TEnum> : OptionSelector, IValue where TEnum :
     /// <summary>
     ///     Initializes a new instance of the <see cref="OptionSelector{TEnum}"/> class.
     /// </summary>
-    public OptionSelector () => Labels = Enum.GetValues<TEnum> ().Select (f => f.ToString ()).ToArray ();
+    public OptionSelector ()
+    {
+        TEnum [] enumValues = Enum.GetValues<TEnum> ();
+
+        // Use the actual enum values (which may not be 0..N-1) as the option values.
+        base.Values = enumValues.Select (f => Convert.ToInt32 (f)).ToList ().AsReadOnly ();
+
+        // OptionSelector defaults Value to 0, which may not be a valid enum value. Ensure Value is valid
+        // so that a fresh OptionSelector<TEnum> shows the selected CheckBox as checked.
+        if (base.Value is { } current && !base.Values!.Contains (current))
+        {
+            base.Value = base.Values!.Count > 0 ? base.Values [0] : null;
+        }
+
+        // Setting Labels creates the CheckBoxes and calls UpdateChecked.
+        Labels = enumValues.Select (f => f.ToString ()).ToArray ();
+    }
 
     /// <summary>
     ///     Gets or sets the value of the selected option.
diff --git a/Terminal.Gui/Views/Selectors/SelectorBase.cs b/Terminal.Gui/Views/Selectors/SelectorBase.cs
index 04f4315..49ce2e7 100644
--- a/Terminal.Gui/Views/Selectors/SelectorBase.cs
+++ b/Terminal.Gui/Views/Selectors/SelectorBase.cs
@@ -535,7 +535,7 @@ public abstract class SelectorBase : View, IOrientation, IValue<int?>
         // total width via PosAlign.CalculateMinDimension, which reads Frame.Width.
         // Without this, newly-created subviews have Frame.Width == 0 on the first
         // layout pass, causing the selector to be sized too narrow.
-        if (Orientation != Orientation.Horizontal || SubViews.Count <= 0)
+        if (Orientation != Orientation.Horizontal || SubViews.Count == 0)
         {
             return;
         }
diff --git a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
index d22b41f..ee7fa75 100644
--- a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
+++ b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
@@ -1072,3 +1072,50 @@ public class OptionSelectorTests
 
     #endregion
 }
+
+public class OptionSelectorTEnumInitTests
+{
+    private enum TestEnum
+    {
+        First,
+        Second,
+        Third
+    }
+
+    private enum NonZeroEnum
+    {
+        One = 1,
+        Five = 5,
+        Ten = 10
+    }
+
+    [Fact]
+    public void Generic_New_FirstCheckBox_Is_Checked_Without_UpdateChecked ()
+    {
+        OptionSelector<TestEnum> selector = new ();
+
+        Assert.Equal (TestEnum.First, selector.Value);
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (3, checkBoxes.Length);
+        Assert.Equal (CheckState.Checked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [2].Value);
+    }
+
+    [Fact]
+    public void Generic_New_NonZeroEnum_FirstCheckBox_Is_Checked_Without_UpdateChecked ()
+    {
+        OptionSelector<NonZeroEnum> selector = new ();
+
+        Assert.Equal (NonZeroEnum.One, selector.Value);
+        CheckBox [] checkBoxes = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (3, checkBoxes.Length);
+        Assert.Equal (CheckState.Checked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [1].Value);
+        Assert.Equal (CheckState.UnChecked, checkBoxes [2].Value);
+
+        selector.Value = NonZeroEnum.Ten;
+        Assert.Equal (CheckState.UnChecked, checkBoxes [0].Value);
+        Assert.Equal (CheckState.Checked, checkBoxes [2].Value);
+    }
+}
