+func TestHandshakeMessageServerKeyExchangeEcdhePskTruncated(t *testing.T) {
+	for _, raw := range [][]byte{
+		{0x00, 0x00},             // empty hint, nothing after
+		{0x00, 0x02, 0x41, 0x42}, // hint consumes the whole buffer
+	} {
+		msg := &MessageServerKeyExchange{
+			KeyExchangeAlgorithm: types.KeyExchangeAlgorithmEcdhe | types.KeyExchangeAlgorithmPsk,
+		}
+		assert.ErrorIs(t, msg.Unmarshal(raw), errBufferTooSmall)
+	}
+}
