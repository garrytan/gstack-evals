+import { flushSync } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	html: `<button>click</button>`,
+
+	test({ assert, target }) {
+		const [button] = target.querySelectorAll('button');
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, `<button>click</button><p>false</p>`);
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, `<button>click</button>`);
+	}
+});
