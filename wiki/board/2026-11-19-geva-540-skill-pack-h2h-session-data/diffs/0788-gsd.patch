index 0000000..c94feb9
--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/abort-signal-state-mutation/Component.svelte
@@ -0,0 +1,24 @@
+<script>
+	import { onMount, getAbortSignal } from 'svelte';
+
+	const { test } = $props();
+
+	onMount(() => {
+		const signal = getAbortSignal();
+
+		test.value = true;
+		signal.addEventListener('abort', () => {
+			test.value = false;
+		});
+	});
+
+	const value = $derived.by(() => {
+		const signal = getAbortSignal();
+		signal.addEventListener('abort', () => {
+			test.value = false;
+		});
+		return test.value;
+	});
+</script>
+
+<p>{value}</p>
