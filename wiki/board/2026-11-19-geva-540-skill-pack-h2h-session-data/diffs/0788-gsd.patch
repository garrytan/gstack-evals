@@ -0,0 +1,5 @@
+---
+'svelte': patch
+---
+
+fix: don't run `getAbortSignal()` abort listeners in the context of the reaction being re-run, avoiding false positive `state_unsafe_mutation` errors
diff --git a/packages/svelte/src/internal/client/runtime.js b/packages/svelte/src/internal/client/runtime.js
index 3d760e4..cd9c2a9 100644
--- a/packages/svelte/src/internal/client/runtime.js
+++ b/packages/svelte/src/internal/client/runtime.js
@@ -265,6 +265,20 @@ export function update_reaction(reaction) {
 
 	var flags = reaction.f;
 
+	if (reaction.ac !== null) {
+		// abort before switching the active reaction, so that `abort` listeners
+		// don't run in the reaction's context (which could cause false positive
+		// `state_unsafe_mutation` errors when the listener updates state)
+		var ac = reaction.ac;
+		reaction.ac = null;
+		active_reaction = null;
+		try {
+			ac.abort(STALE_REACTION);
+		} finally {
+			active_reaction = previous_reaction;
+		}
+	}
+
 	new_deps = /** @type {null | Value[]} */ (null);
 	skipped_deps = 0;
 	untracked_writes = null;
@@ -277,11 +291,6 @@ export function update_reaction(reaction) {
 	untracking = false;
 	update_version = ++read_version;
 
-	if (reaction.ac !== null) {
-		reaction.ac.abort(STALE_REACTION);
-		reaction.ac = null;
-	}
-
 	try {
 		reaction.f |= REACTION_IS_UPDATING;
 		var fn = /** @type {Function} */ (reaction.fn);
diff --git a/packages/svelte/tests/runtime-runes/samples/abort-signal-state-mutation/Component.svelte b/packages/svelte/tests/runtime-runes/samples/abort-signal-state-mutation/Component.svelte
