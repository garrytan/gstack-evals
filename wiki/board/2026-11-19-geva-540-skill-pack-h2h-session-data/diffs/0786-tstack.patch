+<script>
+	import Component from './Component.svelte';
+
+	class Test {
+		value = $state(false);
+	}
+
+	const test = new Test();
+	let show = $state(false);
+</script>
+
+<button onclick={() => (show = !show)}>click</button>
+{#if show}
+	<Component {test} />
+{/if}
