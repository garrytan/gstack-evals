@@ -0,0 +1,19 @@
+import { flushSync } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	test({ assert, target, logs }) {
+		const [button] = target.querySelectorAll('button');
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, '<button>click</button> false');
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, '<button>click</button>');
+
+		flushSync(() => button.click());
+		assert.htmlEqual(target.innerHTML, '<button>click</button> false');
+
+		assert.deepEqual(logs, []);
+	}
+});
diff --git a/packages/svelte/tests/runtime-runes/samples/abort-signal-mutation/main.svelte b/packages/svelte/tests/runtime-runes/samples/abort-signal-mutation/main.svelte
