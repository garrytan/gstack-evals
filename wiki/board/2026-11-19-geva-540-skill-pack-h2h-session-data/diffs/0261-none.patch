+	check(t, wrapped(custom("")), pkg+".wrappedErr")                          // empty ErrorType in chain, use concrete top-level type.
+	check(t, fmt.Errorf("ctx: %w", errors.New("msg")), "*errors.errorString") // fmt wrapping is unwrapped.
+	check(t, fmt.Errorf("a: %w", fmt.Errorf("b: %w", custom(""))), pkg+".ErrCustomType")
+	check(t, fmt.Errorf("a: %w", wrapped(custom(""))), pkg+".wrappedErr") // stop at non-fmt wrapper.
+	check(t, fmt.Errorf("a: %w", custom("fmt-aborted")), "fmt-aborted")
+	check(t, fmt.Errorf("%w, %w", errors.New("a"), errors.New("b")), "*fmt.wrapErrors") // multiple wrapped errors are not unwrapped.
 }
 
