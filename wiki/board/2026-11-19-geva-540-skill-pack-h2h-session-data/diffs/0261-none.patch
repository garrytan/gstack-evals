 import (
 	"errors"
+	"fmt"
 	"reflect"
 
 	"go.opentelemetry.io/otel/attribute"
@@ -22,7 +23,9 @@ import (
 // the returned attribute has that method's return value. If multiple errors in
 // the chain implement this method, the value from the first match found by
 // [errors.As] is used. Otherwise, the returned attribute has a value derived
-// from the concrete type of err.
+// from the concrete type of err. If err was created by [fmt.Errorf] wrapping a
+// single error with the %w verb, the wrapping is unwrapped and the concrete
+// type of the first error in the chain not created this way is used instead.
 //
 // The key of the returned attribute is [ErrorTypeKey].
 func ErrorType(err error) attribute.KeyValue {
@@ -50,7 +53,7 @@ func errorType(err error) string {
 		// Fallback to reflection if the ErrorType method is not supported or
 		// returns an empty value.
 
-		t := reflect.TypeOf(err)
+		t := reflect.TypeOf(unwrapFmt(err))
 		pkg, name := t.PkgPath(), t.Name()
 		if pkg != "" && name != "" {
 			s = pkg + "." + name
@@ -64,3 +67,21 @@ func errorType(err error) string {
 	}
 	return s
 }
+
+// fmtWrapErrorType is the concrete type of errors returned by [fmt.Errorf]
+// when a single error is wrapped with the %w verb.
+var fmtWrapErrorType = reflect.TypeOf(fmt.Errorf("%w", errors.New("")))
+
+// unwrapFmt unwraps err while it is an error created by [fmt.Errorf] wrapping
+// a single error. These wrapping errors do not provide meaningful type
+// information, so the type of the first non-fmt-wrapping error is preferred.
+func unwrapFmt(err error) error {
+	for reflect.TypeOf(err) == fmtWrapErrorType {
+		inner := errors.Unwrap(err)
+		if inner == nil {
+			break
+		}
+		err = inner
+	}
+	return err
+}
