+// withStreamDeadlines applies the read and write timeouts to the QUIC stream of each request,
+// as the TCP entrypoint does with connection deadlines, which do not reach HTTP/3 streams.
+func withStreamDeadlines(next http.Handler, readTimeout, writeTimeout time.Duration) http.Handler {
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		rc := http.NewResponseController(rw)
+		now := time.Now()
+
+		if readTimeout > 0 {
+			if err := rc.SetReadDeadline(now.Add(readTimeout)); err != nil {
+				log.FromContext(req.Context()).Errorf("Error setting HTTP/3 read deadline: %v", err)
+			}
+		}
+
+		if writeTimeout > 0 {
+			if err := rc.SetWriteDeadline(now.Add(writeTimeout)); err != nil {
+				log.FromContext(req.Context()).Errorf("Error setting HTTP/3 write deadline: %v", err)
+			}
+		}
+
+		next.ServeHTTP(rw, req)
+	})
+}
