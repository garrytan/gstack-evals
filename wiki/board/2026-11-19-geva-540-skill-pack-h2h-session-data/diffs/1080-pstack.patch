+func TestHTTP3ReadTimeout(t *testing.T) {
+	certContent, err := localhostCert.Read()
+	require.NoError(t, err)
+
+	keyContent, err := localhostKey.Read()
+	require.NoError(t, err)
+
+	tlsCert, err := tls.X509KeyPair(certContent, keyContent)
+	require.NoError(t, err)
+
+	epConfig := &static.EntryPointsTransport{}
+	epConfig.SetDefaults()
+	epConfig.RespondingTimeouts.ReadTimeout = ptypes.Duration(time.Second)
+
+	entryPoint, err := NewTCPEntryPoint(t.Context(), &static.EntryPoint{
+		Address:          "127.0.0.1:0",
+		Transport:        epConfig,
+		ForwardedHeaders: &static.ForwardedHeaders{},
+		HTTP2:            &static.HTTP2Config{},
+		HTTP3:            &static.HTTP3Config{},
+	}, nil)
+	require.NoError(t, err)
+
+	router, err := tcprouter.NewRouter()
+	require.NoError(t, err)
+
+	router.AddHTTPTLSConfig("*", &tls.Config{
+		Certificates: []tls.Certificate{tlsCert},
+	}, traefiktls.DefaultTLSConfigName)
+
+	bodyReadErr := make(chan error, 1)
+	router.SetHTTPSHandler(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		_, err := io.ReadAll(req.Body)
+		bodyReadErr <- err
+	}), nil)
+
+	ctx := t.Context()
+	go entryPoint.Start(ctx)
+	entryPoint.SwitchRouter(router)
+
+	// The client body writer stays open so that the upload never completes.
+	bodyReader, bodyWriter := io.Pipe()
+
+	transport := &http3.Transport{TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}
+
+	t.Cleanup(func() {
+		_ = bodyWriter.Close()
+		_ = transport.Close()
+		entryPoint.Shutdown(ctx)
+	})
+
+	// We are racing with the http3Server readiness happening in the goroutine starting the entrypoint.
+	time.Sleep(time.Second)
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "https://"+entryPoint.http3Server.http3conn.LocalAddr().String(), bodyReader)
+	require.NoError(t, err)
+
+	go func() {
+		resp, err := transport.RoundTrip(req)
+		if err == nil {
+			_ = resp.Body.Close()
+		}
+	}()
+
+	_, err = bodyWriter.Write([]byte("x"))
+	require.NoError(t, err)
+
+	start := time.Now()
+	select {
+	case err := <-bodyReadErr:
+		require.ErrorIs(t, err, os.ErrDeadlineExceeded)
+		assert.Less(t, time.Since(start), 3*time.Second)
+	case <-time.After(5 * time.Second):
+		t.Fatal("HTTP/3 request body read was not bounded by readTimeout")
+	}
+}
