+function headersArrayToObject(headersArray) {
+  var headers = {};
+  var names = {};
+  for (var i = 0; i + 1 < headersArray.length; i += 2) {
+    var name = String(headersArray[i]);
+    var value = headersArray[i + 1];
+    var key = name.toLowerCase();
+    // Merge duplicate header names (case-insensitively) into an array value
+    if (Object.prototype.hasOwnProperty.call(names, key)) {
+      var existingName = names[key];
+      var existing = headers[existingName];
+      headers[existingName] = (isArray(existing) ? existing : [existing])
+        .concat(isArray(value) ? value : [value]);
+    }
+    else {
+      names[key] = name;
+      headers[name] = value;
+    }
+  }
+  return headers;
+}
