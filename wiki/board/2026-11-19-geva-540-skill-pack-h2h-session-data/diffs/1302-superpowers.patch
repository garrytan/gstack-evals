+
+func Test_BGPUpdateDecodeLengthUnderflow(t *testing.T) {
+	// withdrawn routes length 1, but prefix /24 consumes 4 bytes
+	data := []byte{0x00, 0x01, 0x18, 0x0a, 0x00, 0x00, 0x00, 0x00}
+	m := &BGPUpdate{}
+	err := m.DecodeFromBytes(data)
+	assert.ErrorContains(t, err, "withdrawn route length is short")
+
+	// total path attribute length 3, but ORIGIN attribute consumes 4 bytes
+	data = []byte{0x00, 0x00, 0x00, 0x03, 0x40, 0x01, 0x01, 0x00}
+	m = &BGPUpdate{}
+	err = m.DecodeFromBytes(data)
+	assert.ErrorContains(t, err, "attribute length exceeds total path attribute length")
+}
