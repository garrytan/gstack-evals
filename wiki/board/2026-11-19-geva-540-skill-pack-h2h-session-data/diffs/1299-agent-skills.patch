diff --git a/pkg/packet/bgp/bgp_update_underflow_test.go b/pkg/packet/bgp/bgp_update_underflow_test.go
new file mode 100644
index 0000000..7560ce2
--- /dev/null
+++ b/pkg/packet/bgp/bgp_update_underflow_test.go
@@ -0,0 +1,50 @@
+package bgp
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// Crafted UPDATE where an attribute is longer than the remaining total path
+// attribute length, which used to underflow the uint16 counter.
+func Test_UpdatePathAttrLenUnderflow(t *testing.T) {
+	buf := []byte{
+		0x00, 0x00, // Withdrawn len 0
+		0x00, 0x03, // Total path attr len 3
+		0x50, 0xff, 0x00, 0x00, // ext-len unknown attr, length 0 => 4 bytes (> 3)
+	}
+	// second attribute with Len 65534 (4 header + 65530 value) drives the
+	// wrapped counter down to 1 with no data left.
+	buf = append(buf, 0x50, 0xfe, 0xff, 0xfa)
+	buf = append(buf, make([]byte, 65530)...)
+
+	u := &BGPUpdate{}
+	var err error
+	assert.NotPanics(t, func() { err = u.DecodeFromBytes(buf) })
+	assert.Error(t, err)
+
+	// Simple case: attribute overruns attr length into NLRI.
+	buf = []byte{
+		0x00, 0x00,
+		0x00, 0x03,
+		0x40, 0x01, 0x01, 0x00, // ORIGIN (4 bytes > 3)
+		0x08, 0x0a,
+	}
+	u = &BGPUpdate{}
+	assert.NotPanics(t, func() { err = u.DecodeFromBytes(buf) })
+	assert.Error(t, err)
+}
+
+// Withdrawn prefix overrunning the withdrawn routes length.
+func Test_UpdateWithdrawnLenUnderflow(t *testing.T) {
+	buf := []byte{
+		0x00, 0x01, // Withdrawn len 1
+		0x18, 0x0a, 0x00, 0x00, // /24 prefix: 4 bytes (> 1)
+		0x00, 0x00, // attr len 0
+	}
+	u := &BGPUpdate{}
+	var err error
+	assert.NotPanics(t, func() { err = u.DecodeFromBytes(buf) })
+	assert.Error(t, err)
+}
