--- a/pkg/proxy/authheaders/authheaders_test.go
+++ b/pkg/proxy/authheaders/authheaders_test.go
@@ -142,3 +142,30 @@ func TestSetAuthHeaders_RealExtraIsEncodedAndForwarded(t *testing.T) {
 		t.Errorf("encoded extra header %q = %v, want [root:org:ws]; full headers=%v", encoded, got, h)
 	}
 }
+
+// TestClearAuthHeaders_NoUserAndCustomHeaders ensures forged identity headers are
+// stripped even when there is no authenticated user, and that the default
+// X-Remote-* headers are stripped when custom header names are configured.
+func TestClearAuthHeaders_NoUserAndCustomHeaders(t *testing.T) {
+	t.Parallel()
+	h := http.Header{}
+	h.Add(userHeader, "system:admin")
+	h.Add(groupHeader, "system:masters")
+	h.Add(warrantHeader, "forged")
+	h.Add(scopesHeader, "cluster:root")
+	h.Add("X-Custom-User", "system:admin")
+	h.Add("X-Custom-Group", "system:masters")
+	h.Add("X-Custom-Extra-Foo", "bar")
+	h.Add("Accept", "application/json")
+
+	ClearAuthHeaders(h, "X-Custom-User", "X-Custom-Group", "X-Custom-Extra-")
+
+	for _, name := range []string{userHeader, groupHeader, warrantHeader, scopesHeader, "X-Custom-User", "X-Custom-Group", "X-Custom-Extra-Foo"} {
+		if v := h.Values(name); len(v) != 0 {
+			t.Errorf("header %q leaked: %v", name, v)
+		}
+	}
+	if got := h.Get("Accept"); got != "application/json" {
+		t.Errorf("unrelated header was removed: %v", h)
+	}
+}
diff --git a/pkg/proxy/proxy.go b/pkg/proxy/proxy.go
