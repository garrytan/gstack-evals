diff --git a/registry/remote/utils.go b/registry/remote/utils.go
index 797169f..e721842 100644
--- a/registry/remote/utils.go
+++ b/registry/remote/utils.go
@@ -51,10 +51,16 @@ func parseLink(resp *http.Response) (string, error) {
 		link = link[1:i]
 	}
 
-	linkURL, err := resp.Request.URL.Parse(link)
+	reqURL := resp.Request.URL
+	linkURL, err := reqURL.Parse(link)
 	if err != nil {
 		return "", err
 	}
+	// Prevent SSRF: the next link must stay on the same scheme and host as
+	// the original request.
+	if linkURL.Scheme != reqURL.Scheme || linkURL.Host != reqURL.Host {
+		return "", fmt.Errorf("invalid next link %q: host or scheme mismatch with request %q", link, reqURL.Redacted())
+	}
 	return linkURL.String(), nil
 }
 
