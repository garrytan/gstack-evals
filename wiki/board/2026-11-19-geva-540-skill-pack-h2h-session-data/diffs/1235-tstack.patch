--- a/internal/app/tests/fragment_test.go
+++ b/internal/app/tests/fragment_test.go
@@ -347,4 +347,17 @@ def handler(req):
 	// Non-rooted relative referer is ignored and falls back to rendering the page.
 	testutil.AssertEqualsInt(t, "code", http.StatusOK, response.Code)
 	testutil.AssertEqualsString(t, "body", "Template main myvalue.  fragdata myvalue2 ", response.Body.String())
+
+	// Protocol-relative paths (//host) must not be used as redirect targets, since
+	// browsers treat them as external URLs.
+	for _, ref := range []string{"http://example.com//evil.com", "http://example.com//evil.com/x?q=1",
+		"//evil.com", "http://example.com///evil.com"} {
+		request = httptest.NewRequest("POST", "/test/abc/frag", nil)
+		request.Header.Set("Referer", ref)
+		response = httptest.NewRecorder()
+		a.ServeHTTP(response, request)
+
+		testutil.AssertEqualsInt(t, "code "+ref, http.StatusOK, response.Code)
+		testutil.AssertEqualsString(t, "location "+ref, "", response.Header().Get("Location"))
+	}
 }
