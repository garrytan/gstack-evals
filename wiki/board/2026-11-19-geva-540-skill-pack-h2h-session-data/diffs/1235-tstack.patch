diff --git a/internal/app/handler.go b/internal/app/handler.go
index 9c6c2ec..80d2f5f 100644
--- a/internal/app/handler.go
+++ b/internal/app/handler.go
@@ -114,6 +114,11 @@ func (a *App) validatedRefererRedirect(r *http.Request, referrer string) (string
 	if redirectTarget == "" {
 		redirectTarget = "/"
 	}
+	// Paths like "//host" or "/\\host" are treated by browsers as protocol-relative
+	// URLs pointing to an external host, reject them to prevent open redirects
+	if strings.HasPrefix(redirectTarget, "//") || strings.HasPrefix(redirectTarget, "/\\") {
+		return "", false
+	}
 	if refURL.RawQuery != "" {
 		redirectTarget += "?" + refURL.RawQuery
 	}
diff --git a/internal/app/tests/fragment_test.go b/internal/app/tests/fragment_test.go
