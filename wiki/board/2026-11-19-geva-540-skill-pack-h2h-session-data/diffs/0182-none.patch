diff --git a/test/optimizer/volatile_aggregate_window_cse.test b/test/optimizer/volatile_aggregate_window_cse.test
new file mode 100644
index 0000000..7b8fe73
--- /dev/null
+++ b/test/optimizer/volatile_aggregate_window_cse.test
@@ -0,0 +1,42 @@
+# name: test/optimizer/volatile_aggregate_window_cse.test
+# description: Identical volatile aggregates/window functions must not be deduplicated
+# group: [optimizer]
+
+statement ok
+PRAGMA enable_verification
+
+query I
+select count(*) filter (where id_a = id_b) from (
+	select g,
+	    any_value(uuid()::varchar) over (partition by g) as id_a,
+	    any_value(uuid()::varchar) over (partition by g) as id_b
+	from (values (1),(1),(2),(2)) t(g)
+);
+----
+0
+
+query I
+select count(*) filter (where a = b) from (select first(random()) over (order by g) a, first(random()) over (order by g) b from range(100) t(g));
+----
+0
+
+query I
+select count(*) filter (where a = b) from (select any_value(random()) over () a, any_value(random()) over () b from range(100) t(g));
+----
+0
+
+query I
+select any_value(uuid()::varchar) = any_value(uuid()::varchar) from range(3);
+----
+false
+
+query I
+select count(*) filter (where a = b) from (select g, max(random()) a, max(random()) b from range(100) t(g) group by g);
+----
+0
+
+# non-volatile duplicates are still fine
+query I
+select count(*) filter (where a = b) from (select sum(g) over (order by g) a, sum(g) over (order by g) b from range(100) t(g));
+----
+100
