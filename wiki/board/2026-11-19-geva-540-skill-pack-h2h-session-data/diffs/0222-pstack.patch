diff --git a/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs b/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs
new file mode 100644
index 0000000..87f788f
--- /dev/null
+++ b/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs
@@ -0,0 +1,372 @@
+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Draw;
+
+/// <summary>
+///     A SuperView entered by <see cref="View.Draw(DrawContext?)"/> only because a SubView is dirty must not redraw its own
+///     viewport, text, or content, and the screen must match a full redraw.
+/// </summary>
+public class ChildOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    private sealed class DrawCounts
+    {
+        public int ClearedViewport;
+        public int DrawingText;
+        public int DrawingContent;
+
+        public static DrawCounts Track (View view)
+        {
+            DrawCounts counts = new ();
+            view.ClearedViewport += (_, _) => counts.ClearedViewport++;
+            view.DrawingText += (_, _) => counts.DrawingText++;
+            view.DrawingContent += (_, _) => counts.DrawingContent++;
+
+            return counts;
+        }
+
+        public int Total => ClearedViewport + DrawingText + DrawingContent;
+    }
+
+    private static string Snapshot (IDriver driver)
+    {
+        StringBuilder sb = new ();
+        Cell [,] contents = driver.Contents!;
+
+        for (var r = 0; r < contents.GetLength (0); r++)
+        {
+            for (var c = 0; c < contents.GetLength (1); c++)
+            {
+                sb.Append (contents [r, c].Grapheme);
+                sb.Append ('|');
+                sb.Append (contents [r, c].Attribute);
+                sb.Append (';');
+            }
+
+            sb.AppendLine ();
+        }
+
+        return sb.ToString ();
+    }
+
+    private static string Text (IDriver driver)
+    {
+        StringBuilder sb = new ();
+        Cell [,] contents = driver.Contents!;
+
+        for (var r = 0; r < contents.GetLength (0); r++)
+        {
+            for (var c = 0; c < contents.GetLength (1); c++)
+            {
+                sb.Append (contents [r, c].Grapheme);
+            }
+
+            sb.AppendLine ();
+        }
+
+        return sb.ToString ();
+    }
+
+    /// <summary>Asserts the incremental screen equals what a full redraw of <paramref name="root"/> produces.</summary>
+    private void AssertMatchesFullRedraw (View root, IDriver driver)
+    {
+        string incremental = Snapshot (driver);
+        string incrementalText = Text (driver);
+
+        driver.ClearContents ();
+        root.SetNeedsDraw ();
+        Redraw (root, driver);
+
+        string fullText = Text (driver);
+        output.WriteLine ("Incremental:\n" + incrementalText);
+        output.WriteLine ("Full redraw:\n" + fullText);
+
+        Assert.Equal (fullText, incrementalText);
+        Assert.Equal (Snapshot (driver), incremental);
+    }
+
+    private static void Redraw (View root, IDriver driver)
+    {
+        driver.Clip = new Region (driver.Screen);
+        View.Draw ([root], false);
+    }
+
+    private static View CreateRoot (IDriver driver) =>
+        new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+
+    [Fact]
+    public void ChildOnly_Parent_DoesNotClear_Or_Draw_Text_Or_Content ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = CreateRoot (driver);
+        View parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single, Title = "P", Text = "parent text" };
+        View child = new () { X = 1, Y = 2, Width = 8, Height = 1, Text = "child" };
+        parent.Add (child);
+        root.Add (parent);
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        DrawCounts parentCounts = DrawCounts.Track (parent);
+        DrawCounts childCounts = DrawCounts.Track (child);
+
+        child.Text = "CHILD";
+        root.Layout ();
+        Redraw (root, driver);
+
+        Assert.Equal (0, parentCounts.Total);
+        Assert.Equal (1, childCounts.ClearedViewport);
+        Assert.Equal (1, childCounts.DrawingText);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Parent_Itself_Dirty_Still_Clears_And_Draws ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = CreateRoot (driver);
+        View parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), Text = "parent text" };
+        View child = new () { X = 1, Y = 2, Width = 8, Height = 1, Text = "child" };
+        parent.Add (child);
+        root.Add (parent);
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        DrawCounts parentCounts = DrawCounts.Track (parent);
+
+        parent.SetNeedsDraw ();
+        Redraw (root, driver);
+
+        Assert.Equal (1, parentCounts.ClearedViewport);
+        Assert.Equal (1, parentCounts.DrawingText);
+        Assert.Equal (1, parentCounts.DrawingContent);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    private static (View Root, Tabs Tabs, View [] Pages) BuildTabs (IDriver driver)
+    {
+        View root = CreateRoot (driver);
+        root.CanFocus = true;
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [3];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            pages [i] = new View { Title = $"Tab{i + 1}", Text = $"page {i + 1}" };
+            pages [i].SetContentSize (new Size (30, 40));
+            tabs.Add (pages [i]);
+        }
+
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        return (root, tabs, pages);
+    }
+
+    [Fact]
+    public void Tabs_ActiveTabScroll_DoesNotRedraw_InactivePages_Or_Tabs ()
+    {
+        IDriver driver = CreateTestDriver (40, 10);
+        (View root, Tabs tabs, View [] pages) = BuildTabs (driver);
+        View active = tabs.Value!;
+        Assert.Same (pages [0], active);
+
+        DrawCounts tabsCounts = DrawCounts.Track (tabs);
+        DrawCounts activeCounts = DrawCounts.Track (active);
+        DrawCounts [] inactiveCounts = pages.Skip (1).Select (DrawCounts.Track).ToArray ();
+
+        for (var y = 1; y <= 3; y++)
+        {
+            active.Viewport = active.Viewport with { Y = y };
+            root.Layout ();
+            Redraw (root, driver);
+        }
+
+        Assert.Equal (0, tabsCounts.Total);
+        Assert.All (inactiveCounts, c => Assert.Equal (0, c.Total));
+        Assert.Equal (3, activeCounts.ClearedViewport);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Tabs_ActiveTabScroll_IOutput_Receives_Active_Content ()
+    {
+        IDriver driver = CreateTestDriver (40, 10);
+        (View root, Tabs tabs, View [] _) = BuildTabs (driver);
+        View active = tabs.Value!;
+        active.Text = string.Join ('\n', Enumerable.Range (1, 30).Select (i => $"row {i}"));
+        root.Layout ();
+        Redraw (root, driver);
+
+        IOutput ioutput = driver.GetOutput ();
+        ioutput.Write (driver.GetOutputBuffer ());
+
+        active.Viewport = active.Viewport with { Y = 5 };
+        root.Layout ();
+        Redraw (root, driver);
+        ioutput.Write (driver.GetOutputBuffer ());
+
+        string ansi = ioutput.GetLastOutput ();
+        Assert.Contains ("row 6", ansi);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void Tabs_InactivePageDirty_RendersSameAsFullRedraw ()
+    {
+        IDriver driver = CreateTestDriver (40, 10);
+        (View root, Tabs _, View [] pages) = BuildTabs (driver);
+
+        pages [2].Text = "changed";
+        root.Layout ();
+        Redraw (root, driver);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void TiledSiblings_SharingBorders_KeepJunctions_When_One_Redraws ()
+    {
+        IDriver driver = CreateTestDriver (21, 5);
+        View root = CreateRoot (driver);
+        View parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+        View left = new () { Width = 10, Height = Dim.Fill (), BorderStyle = LineStyle.Single, SuperViewRendersLineCanvas = true, Text = "L" };
+        View right = new () { X = 9, Width = 10, Height = Dim.Fill (), BorderStyle = LineStyle.Single, SuperViewRendersLineCanvas = true, Text = "R" };
+        parent.Add (left, right);
+        root.Add (parent);
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        DrawCounts parentCounts = DrawCounts.Track (parent);
+        DrawCounts leftCounts = DrawCounts.Track (left);
+
+        right.Text = "Right";
+        root.Layout ();
+        Redraw (root, driver);
+
+        Assert.Equal (0, parentCounts.Total);
+        Assert.Equal (0, leftCounts.Total);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void TransparentSibling_Forces_Parent_Redraw_And_Leaves_No_Stale_Cells ()
+    {
+        IDriver driver = CreateTestDriver (20, 5);
+        View root = CreateRoot (driver);
+        View parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), Text = "background" };
+        View overlay = new () { Width = Dim.Fill (), Height = Dim.Fill (), Text = "    ABCDEFGH" };
+        overlay.ViewportSettings |= ViewportSettingsFlags.Transparent;
+        View child = new () { X = 2, Y = 2, Width = 6, Height = 1, Text = "child" };
+        parent.Add (child, overlay);
+        root.Add (parent);
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        DrawCounts parentCounts = DrawCounts.Track (parent);
+
+        overlay.Text = "    AB";
+        root.Layout ();
+        Redraw (root, driver);
+
+        Assert.Equal (1, parentCounts.ClearedViewport);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Theory]
+    [InlineData (ShadowStyles.Transparent)]
+    [InlineData (ShadowStyles.Opaque)]
+    public void ShadowSibling_DoesNotCompound_Across_ChildOnly_Redraws (ShadowStyles shadowStyle)
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = CreateRoot (driver);
+        View parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), Text = "background\nbackground\nbackground" };
+        View shadowed = new () { X = 1, Y = 0, Width = 6, Height = 2, Text = "btn", ShadowStyle = shadowStyle };
+        View child = new () { X = 10, Y = 3, Width = 6, Height = 1, Text = "child" };
+        parent.Add (child, shadowed);
+        root.Add (parent);
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        for (var i = 0; i < 3; i++)
+        {
+            child.Text = $"c{i}";
+            root.Layout ();
+            Redraw (root, driver);
+        }
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void BorderTitle_And_PartiallyClipped_Child_RenderSameAsFullRedraw ()
+    {
+        IDriver driver = CreateTestDriver (20, 6);
+        View root = CreateRoot (driver);
+        View parent = new () { Width = 14, Height = Dim.Fill (), BorderStyle = LineStyle.Rounded, Title = "Title", Text = "abc" };
+        View child = new () { X = 6, Y = 1, Width = 12, Height = 2, BorderStyle = LineStyle.Single, Text = "clipped" };
+        parent.Add (child);
+        root.Add (parent);
+        root.BeginInit ();
+        root.EndInit ();
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        child.Text = "CLIPPED!";
+        root.Layout ();
+        Redraw (root, driver);
+
+        AssertMatchesFullRedraw (root, driver);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+}
