diff --git a/app/kuma-dp/pkg/dataplane/metrics/kumadp_metrics.go b/app/kuma-dp/pkg/dataplane/metrics/kumadp_metrics.go
new file mode 100644
index 0000000..08de51c
--- /dev/null
+++ b/app/kuma-dp/pkg/dataplane/metrics/kumadp_metrics.go
@@ -0,0 +1,93 @@
+package metrics
+
+import (
+	"regexp"
+	"sort"
+	"sync"
+
+	prom_client "github.com/prometheus/client_golang/prometheus"
+	io_prometheus_client "github.com/prometheus/client_model/go"
+	"google.golang.org/protobuf/proto"
+)
+
+// KumaDPRegistry is the registry for metrics emitted by the kuma-dp process itself
+// (e.g. DNS proxy metrics). Metrics registered here are exposed together with Envoy
+// metrics and are decorated with the same extra labels (workload, namespace, zone, mesh, ...).
+var KumaDPRegistry = prom_client.NewRegistry()
+
+// KumaDPGatherer gathers metrics from KumaDPRegistry and adds extra labels to them.
+var KumaDPGatherer = NewLabelingGatherer(KumaDPRegistry)
+
+var invalidLabelCharRE = regexp.MustCompile(`[^a-zA-Z0-9_]`)
+
+func sanitizeLabelName(name string) string {
+	return invalidLabelCharRE.ReplaceAllString(name, "_")
+}
+
+// LabelingGatherer wraps a gatherer and adds a dynamic set of labels to every gathered metric.
+// Labels already present on a metric are not overridden.
+type LabelingGatherer struct {
+	gatherer prom_client.Gatherer
+	mu       sync.RWMutex
+	labels   []*io_prometheus_client.LabelPair
+}
+
+var _ prom_client.Gatherer = &LabelingGatherer{}
+
+func NewLabelingGatherer(gatherer prom_client.Gatherer) *LabelingGatherer {
+	return &LabelingGatherer{gatherer: gatherer}
+}
+
+// SetLabels replaces the set of extra labels. Label names are sanitized to be valid Prometheus label names.
+func (g *LabelingGatherer) SetLabels(labels map[string]string) {
+	sanitized := map[string]string{}
+	for k, v := range labels {
+		if k == "" {
+			continue
+		}
+		sanitized[sanitizeLabelName(k)] = v
+	}
+	pairs := make([]*io_prometheus_client.LabelPair, 0, len(sanitized))
+	for k, v := range sanitized {
+		pairs = append(pairs, &io_prometheus_client.LabelPair{Name: proto.String(k), Value: proto.String(v)})
+	}
+	sort.Slice(pairs, func(i, j int) bool { return pairs[i].GetName() < pairs[j].GetName() })
+
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.labels = pairs
+}
+
+func (g *LabelingGatherer) Gather() ([]*io_prometheus_client.MetricFamily, error) {
+	families, err := g.gatherer.Gather()
+
+	g.mu.RLock()
+	extra := g.labels
+	g.mu.RUnlock()
+
+	if len(extra) == 0 {
+		return families, err
+	}
+
+	for _, family := range families {
+		for _, metric := range family.GetMetric() {
+			existing := map[string]struct{}{}
+			for _, lp := range metric.GetLabel() {
+				existing[lp.GetName()] = struct{}{}
+			}
+			for _, lp := range extra {
+				if _, ok := existing[lp.GetName()]; ok {
+					continue
+				}
+				metric.Label = append(metric.Label, &io_prometheus_client.LabelPair{
+					Name:  proto.String(lp.GetName()),
+					Value: proto.String(lp.GetValue()),
+				})
+			}
+			sort.Slice(metric.Label, func(i, j int) bool {
+				return metric.Label[i].GetName() < metric.Label[j].GetName()
+			})
+		}
+	}
+	return families, err
+}
diff --git a/app/kuma-dp/pkg/dataplane/metrics/kumadp_metrics_test.go b/app/kuma-dp/pkg/dataplane/metrics/kumadp_metrics_test.go
new file mode 100644
index 0000000..9c233a9
--- /dev/null
+++ b/app/kuma-dp/pkg/dataplane/metrics/kumadp_metrics_test.go
@@ -0,0 +1,55 @@
+package metrics_test
+
+import (
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/prometheus/client_golang/prometheus"
+
+	"github.com/kumahq/kuma/v2/app/kuma-dp/pkg/dataplane/metrics"
+)
+
+var _ = Describe("LabelingGatherer", func() {
+	It("should add extra labels to gathered metrics", func() {
+		// given
+		registry := prometheus.NewRegistry()
+		histogram := prometheus.NewHistogram(prometheus.HistogramOpts{
+			Name: "kuma_dp_dns_request_duration_seconds",
+			Help: "test",
+		})
+		registry.MustRegister(histogram)
+		histogram.Observe(0.1)
+		gatherer := metrics.NewLabelingGatherer(registry)
+
+		// when
+		gatherer.SetLabels(map[string]string{
+			"kuma.workload":         "kri_wl_mesh-1_zone-1_ns-1_wl-1_",
+			"k8s_kuma_io_namespace": "ns-1",
+			"kuma_io_zone":          "zone-1",
+			"mesh":                  "mesh-1",
+		})
+		families, err := gatherer.Gather()
+
+		// then
+		Expect(err).ToNot(HaveOccurred())
+		Expect(families).To(HaveLen(1))
+		Expect(families[0].GetMetric()).To(HaveLen(1))
+		labels := map[string]string{}
+		for _, lp := range families[0].GetMetric()[0].GetLabel() {
+			labels[lp.GetName()] = lp.GetValue()
+		}
+		Expect(labels).To(Equal(map[string]string{
+			"kuma_workload":         "kri_wl_mesh-1_zone-1_ns-1_wl-1_",
+			"k8s_kuma_io_namespace": "ns-1",
+			"kuma_io_zone":          "zone-1",
+			"mesh":                  "mesh-1",
+		}))
+
+		// when labels are cleared
+		gatherer.SetLabels(nil)
+		families, err = gatherer.Gather()
+
+		// then
+		Expect(err).ToNot(HaveOccurred())
+		Expect(families[0].GetMetric()[0].GetLabel()).To(BeEmpty())
+	})
+})
