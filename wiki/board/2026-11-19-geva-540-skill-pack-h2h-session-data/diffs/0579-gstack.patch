+// SetKumaDPMetricsLabels sets extra labels (the same as the ones added to Envoy metrics)
+// on metrics emitted by kuma-dp itself (e.g. DNS metrics).
+func (s *Hijacker) SetKumaDPMetricsLabels(labels map[string]string) {
+	KumaDPGatherer.SetLabels(labels)
+}
+
 func (s *Hijacker) NeedLeaderElection() bool {
 	return false
 }
