+
+    #[tokio::test]
+    async fn navigation_prunes_cleared_execution_context_ids() {
+        // Runtime.executionContextsCleared must invalidate every previously
+        // advertised context: stale ids are rejected afterwards and the set
+        // stays bounded across many navigations.
+        let mut ctx = CdpContext::new();
+        let page_id = ctx.create_page();
+        let session_id = format!("{}-session", page_id);
+        ctx.sessions.insert(session_id.clone(), page_id.clone());
+        let sid = Some(session_id.clone());
+
+        let params = json!({"url": "data:text/html,<p>a</p>", "waitUntil": "load"});
+        handle("navigate", &params, &mut ctx, &sid).await.expect("nav 1");
+        let first: Vec<i64> = ctx.valid_context_ids.iter().copied().collect();
+        let stale = *first.iter().max().unwrap();
+        assert!(stale >= 100, "an isolated world id should be live: {first:?}");
+
+        for _ in 0..20 {
+            handle("navigate", &params, &mut ctx, &sid).await.expect("nav");
+        }
+        assert!(!ctx.valid_context_ids.contains(&stale));
+        assert!(!ctx.valid_context_ids.contains(&1));
+        assert!(ctx.valid_context_ids.contains(&2));
+        assert_eq!(ctx.valid_context_ids.len(), first.len(), "set must stay bounded");
+
+        let err = crate::domains::runtime::handle(
+            "evaluate",
+            &json!({"expression": "1", "contextId": stale}),
+            &mut ctx,
+            &sid,
+        )
+        .await
+        .expect_err("stale context must be rejected");
+        assert!(err.contains("Cannot find context with specified id"), "{err}");
+
+        // Runtime.enable re-advertises context 1, so it becomes valid again.
+        crate::domains::runtime::handle("enable", &json!({}), &mut ctx, &sid)
+            .await
+            .unwrap();
+        assert!(ctx.valid_context_ids.contains(&1));
+    }
 }
