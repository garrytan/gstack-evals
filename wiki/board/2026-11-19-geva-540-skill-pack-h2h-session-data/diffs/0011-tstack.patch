+/// A `.git` entry marks a checkout root when it is a directory, or a gitfile
+/// whose `gitdir:` target resolves to an existing directory. Broken gitfiles
+/// (stale worktree pointers) must not promote the root to an ancestor.
+fn is_valid_git_boundary(git: &Path) -> bool {
+    if git.is_dir() {
+        return true;
+    }
+    if !git.is_file() {
+        return false;
+    }
+    let Ok(content) = std::fs::read_to_string(git) else {
+        return false;
+    };
+    let Some(target) = content
+        .lines()
+        .find_map(|l| l.trim().strip_prefix("gitdir:"))
+        .map(str::trim)
+        .filter(|t| !t.is_empty())
+    else {
+        return false;
+    };
+    let target = Path::new(target);
+    let resolved = if target.is_absolute() {
+        target.to_path_buf()
+    } else {
+        match git.parent() {
+            Some(base) => base.join(target),
+            None => return false,
+        }
+    };
+    resolved.is_dir()
+}
+
+#[cfg(test)]
+mod git_root_tests {
+    use super::git_root_for;
+
+    #[test]
+    fn broken_ancestor_gitfile_is_ignored() {
+        let tmp = tempfile::tempdir().unwrap();
+        let ws = tmp.path().join("workspace");
+        let project = ws.join("project");
+        std::fs::create_dir_all(&project).unwrap();
+        std::fs::write(ws.join(".git"), "gitdir: ../missing/git-dir\n").unwrap();
+        let got = git_root_for(project.to_str().unwrap());
+        assert_ne!(got.as_deref(), Some(ws.to_str().unwrap()));
+    }
+
+    #[test]
+    fn valid_gitfile_worktree_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let wt = tmp.path().join("wt");
+        let sub = wt.join("src");
+        let gitdir = tmp.path().join("main/.git/worktrees/wt");
+        std::fs::create_dir_all(&sub).unwrap();
+        std::fs::create_dir_all(&gitdir).unwrap();
+        std::fs::write(wt.join(".git"), "gitdir: ../main/.git/worktrees/wt\n").unwrap();
+        assert_eq!(
+            git_root_for(sub.to_str().unwrap()).as_deref(),
+            Some(wt.to_str().unwrap())
+        );
+    }
+
+    #[test]
+    fn git_directory_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let repo = tmp.path().join("repo");
+        let sub = repo.join("a/b");
+        std::fs::create_dir_all(&sub).unwrap();
+        std::fs::create_dir_all(repo.join(".git")).unwrap();
+        assert_eq!(
+            git_root_for(sub.to_str().unwrap()).as_deref(),
+            Some(repo.to_str().unwrap())
+        );
+    }
+}
