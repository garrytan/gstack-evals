diff --git a/src/linker-script.cc b/src/linker-script.cc
index 51144b3..011ab43 100644
--- a/src/linker-script.cc
+++ b/src/linker-script.cc
@@ -249,9 +249,23 @@ std::string_view Script<E>::get_script_output_type() {
   }
 
   if (tok.size() >= 3 && (tok[0] == "INPUT" || tok[0] == "GROUP") &&
-      tok[1] == "(")
-    if (MappedFile *mf = resolve_path(tok[2], false))
-      return get_machine_type(ctx, rctx, mf);
+      tok[1] == "(") {
+    // Find the first file name in the group, skipping AS_NEEDED(...)
+    // wrappers, e.g. `INPUT(AS_NEEDED(-latomic))`.
+    i64 depth = 1;
+    for (i64 i = 2; i < tok.size() && depth > 0; i++) {
+      if (tok[i] == "AS_NEEDED" && i + 1 < tok.size() && tok[i + 1] == "(") {
+        depth++;
+        i++;
+      } else if (tok[i] == ")") {
+        depth--;
+      } else {
+        if (MappedFile *mf = resolve_path(tok[i], false))
+          return get_machine_type(ctx, rctx, mf);
+        break;
+      }
+    }
+  }
   return "";
 }
 
diff --git a/test/linker-script7.sh b/test/linker-script7.sh
new file mode 100755
index 0000000..31eb3ea
--- /dev/null
+++ b/test/linker-script7.sh
@@ -0,0 +1,26 @@
+#!/bin/bash
+. $(dirname $0)/common.inc
+
+cat <<EOF | $CC -o $t/a.o -c -xc -
+#include <stdio.h>
+int main() {
+  printf("Hello world\n");
+}
+EOF
+
+cat <<EOF | $CC -o $t/b.o -c -xc -fPIC -
+void foo() {}
+EOF
+
+$CC -B. -shared -o $t/libfoo.so $t/b.o
+
+cat <<EOF > $t/script
+INPUT(AS_NEEDED(-lfoo))
+EOF
+
+$CC -B. -o $t/exe -L$t $t/script $t/a.o
+$QEMU $t/exe | grep 'Hello world'
+readelf --dynamic $t/exe > $t/log
+not grep libfoo.so $t/log
+
+./mold -o $t/exe2 -L$t $t/script --unresolved-symbols=ignore-all
