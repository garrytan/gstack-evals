+func TestStatic_GroupEncodedSlashNotUnescaped(t *testing.T) {
+	e := echo.New()
+	g := e.Group("/assets")
+	g.Use(StaticWithConfig(StaticConfig{Root: ".", Filesystem: os.DirFS("../_fixture")}))
+	g.GET("/*", func(c *echo.Context) error { return echo.ErrNotFound })
+
+	req := httptest.NewRequest(http.MethodGet, "/assets/images%2Fwalle.png", nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	assert.Equal(t, http.StatusNotFound, rec.Code)
+
+	req = httptest.NewRequest(http.MethodGet, "/assets/images/walle.png", nil)
