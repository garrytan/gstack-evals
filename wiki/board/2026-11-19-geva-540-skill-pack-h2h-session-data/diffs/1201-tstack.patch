+func TestEcho_StaticFS_encodedSlashDoesNotBypassRouteMiddleware(t *testing.T) {
+	e := New()
+	protected := e.Group("/images", func(next HandlerFunc) HandlerFunc {
+		return func(c *Context) error {
+			return ErrForbidden
+		}
+	})
+	protected.GET("/*", func(c *Context) error { return c.String(http.StatusOK, "secret") })
+	e.StaticFS("/", os.DirFS("_fixture"))
+
+	req := httptest.NewRequest(http.MethodGet, "/images/walle.png", nil)
+	rec := httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	assert.Equal(t, http.StatusForbidden, rec.Code)
+
+	for _, target := range []string{"/images%2Fwalle.png", "/images%2fwalle.png", "/images%5Cwalle.png"} {
+		req = httptest.NewRequest(http.MethodGet, target, nil)
+		rec = httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		assert.Equal(t, http.StatusNotFound, rec.Code, target)
+	}
+
+	// regular static files still served
+	req = httptest.NewRequest(http.MethodGet, "/index.html", nil)
+	rec = httptest.NewRecorder()
+	e.ServeHTTP(rec, req)
+	assert.Equal(t, http.StatusOK, rec.Code)
+}
