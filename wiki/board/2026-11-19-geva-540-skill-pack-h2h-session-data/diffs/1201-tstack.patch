+// containsEncodedSlash reports whether path contains a percent-encoded forward slash (`%2F`) or backslash (`%5C`).
+func containsEncodedSlash(p string) bool {
+	if !strings.Contains(p, "%") {
+		return false
+	}
+	lp := strings.ToLower(p)
+	return strings.Contains(lp, "%2f") || strings.Contains(lp, "%5c")
+}
