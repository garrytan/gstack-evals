diff --git a/src/test/java/tools/jackson/databind/deser/UpdateLocalTypeTest.java b/src/test/java/tools/jackson/databind/deser/UpdateLocalTypeTest.java
new file mode 100644
index 0000000..301b9e2
--- /dev/null
+++ b/src/test/java/tools/jackson/databind/deser/UpdateLocalTypeTest.java
@@ -0,0 +1,58 @@
+package tools.jackson.databind.deser;
+
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.databind.*;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+// For [databind#2803]-like issue: allow updating instances of local/anonymous classes
+public class UpdateLocalTypeTest extends DatabindTestUtil
+{
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    public static class Holder {
+        public Object value;
+    }
+
+    @Test
+    public void testUpdateAnonymous() throws Exception
+    {
+        Object ob = new Object() {
+            public int value;
+
+            @Override
+            public String toString() { return String.valueOf(value); }
+        };
+        Object result = MAPPER.readerForUpdating(ob).readValue("{\"value\": 2}");
+        assertSame(ob, result);
+        assertEquals("2", ob.toString());
+    }
+
+    @Test
+    public void testUpdateLocal() throws Exception
+    {
+        class Local {
+            public int x;
+        }
+        Local l = new Local();
+        Local result = MAPPER.readerForUpdating(l).readValue("{\"x\": 3}");
+        assertSame(l, result);
+        assertEquals(3, l.x);
+    }
+
+    @Test
+    public void testCreateLocalFails() throws Exception
+    {
+        class Local {
+            public int x;
+        }
+        try {
+            MAPPER.readValue("{\"x\": 3}", Local.class);
+            fail("Should not pass");
+        } catch (DatabindException e) {
+            verifyException(e, "local/anonymous");
+        }
+    }
+}
