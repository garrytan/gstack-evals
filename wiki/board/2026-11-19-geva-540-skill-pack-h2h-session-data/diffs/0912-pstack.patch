diff --git a/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
new file mode 100644
index 0000000..6e74017
--- /dev/null
+++ b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
@@ -0,0 +1,57 @@
+'use strict';
+
+/**
+ * GHSA-x6m4-chr9-cg97 — host error stacks leak host paths through the bridge
+ *
+ * Sandbox code that catches a host-realm error (e.g. the SyntaxError thrown by
+ * the host-side transformer on malformed `eval` input) and reads `.stack` got
+ * the host-formatted string, with absolute paths of vm2, Node internals, and
+ * the embedding application. The sandbox-side bridge now rewrites every frame
+ * of a host `stack` value to `at CallSite {}`, matching the sandbox formatter.
+ */
+
+const assert = require('assert');
+const { VM, NodeVM } = require('../../../lib/main.js');
+
+function assertRedacted(stack) {
+	assert.strictEqual(typeof stack, 'string');
+	assert.ok(stack.indexOf(__dirname) === -1, 'test file path absent: ' + stack);
+	assert.ok(!/[\\/]lib[\\/]/.test(stack), 'vm2 lib paths absent: ' + stack);
+	assert.ok(!/node:|internal\//.test(stack), 'node internals absent: ' + stack);
+	assert.ok(/^SyntaxError: /.test(stack) || /^Error: /.test(stack), 'header kept: ' + stack);
+}
+
+describe('GHSA-x6m4-chr9-cg97 (host error stack path leak)', function () {
+	const poc = 'var s; try { eval("@@@ catch") } catch (e) { s = e.stack }';
+
+	it('canonical PoC on default VM', function () {
+		assertRedacted(new VM().run(poc + '; s'));
+	});
+
+	it('VM with eval disabled', function () {
+		assertRedacted(new VM({ eval: false }).run(poc + '; s'));
+	});
+
+	it('Function constructor path', function () {
+		assertRedacted(new VM().run('var s; try { new Function("@@@ catch") } catch (e) { s = e.stack } s'));
+	});
+
+	it('default NodeVM', function () {
+		assertRedacted(new NodeVM().run(poc + '; module.exports = s'));
+	});
+
+	it('property descriptor read', function () {
+		const vm = new VM();
+		vm.setGlobal('hostError', new Error('host'));
+		assertRedacted(vm.run('Object.getOwnPropertyDescriptor(hostError, "stack").value'));
+		assertRedacted(vm.run('Object.getOwnPropertyDescriptors(hostError).stack.value'));
+	});
+
+	it('host keeps its own unredacted stack', function () {
+		const hostError = new Error('host');
+		const vm = new VM();
+		vm.setGlobal('hostError', hostError);
+		vm.run('hostError.stack');
+		assert.ok(hostError.stack.indexOf(__filename) !== -1);
+	});
+});
