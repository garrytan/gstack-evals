+#[cfg(test)]
+mod git_boundary_tests {
+    use super::{git_root_for, promote_to_git_root};
+
+    #[test]
+    fn broken_ancestor_gitfile_is_not_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let ws = tmp.path().join("workspace");
+        let project = ws.join("project");
+        std::fs::create_dir_all(&project).unwrap();
+        std::fs::write(ws.join(".git"), "gitdir: ../missing/git-dir\n").unwrap();
+
+        let project_s = project.to_string_lossy().to_string();
+        assert_eq!(promote_to_git_root(&project_s), project_s);
+    }
+
+    #[test]
+    fn valid_gitfile_worktree_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let ws = tmp.path().join("workspace");
+        let sub = ws.join("src");
+        std::fs::create_dir_all(&sub).unwrap();
+        std::fs::create_dir_all(tmp.path().join("real-git-dir")).unwrap();
+        std::fs::write(ws.join(".git"), "gitdir: ../real-git-dir\n").unwrap();
+
+        assert_eq!(
+            git_root_for(&sub.to_string_lossy()),
+            Some(ws.to_string_lossy().to_string())
+        );
+    }
+
+    #[test]
+    fn git_directory_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let ws = tmp.path().join("repo");
+        let sub = ws.join("a/b");
+        std::fs::create_dir_all(&sub).unwrap();
+        std::fs::create_dir_all(ws.join(".git")).unwrap();
+
+        assert_eq!(
+            promote_to_git_root(&sub.to_string_lossy()),
+            ws.to_string_lossy().to_string()
+        );
+    }
+}
