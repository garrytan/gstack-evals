+/// A `.git` entry marks a usable checkout boundary when it is a directory, or a
+/// gitfile (worktree/submodule) whose `gitdir:` target resolves to an existing
+/// directory. Broken gitfiles (stale worktrees, deleted git dirs) are ignored so
+/// they cannot hijack root promotion to an unrelated ancestor such as `$HOME`.
+pub(crate) fn is_valid_git_boundary(git: &Path) -> bool {
+    if git.is_dir() {
+        return true;
+    }
+    if !git.is_file() {
+        return false;
+    }
+    let Ok(content) = std::fs::read_to_string(git) else {
+        return false;
+    };
+    let Some(target) = content
+        .lines()
+        .find_map(|l| l.trim().strip_prefix("gitdir:"))
+        .map(str::trim)
+        .filter(|t| !t.is_empty())
+    else {
+        return false;
+    };
+    let target = Path::new(target);
+    let resolved = if target.is_absolute() {
+        target.to_path_buf()
+    } else {
+        match git.parent() {
+            Some(base) => base.join(target),
+            None => target.to_path_buf(),
+        }
+    };
+    resolved.is_dir()
+}
