+    #[tokio::test]
+    async fn test_merge_partition_value_with_space_removes_rewritten_file() {
+        // Regression: rewritten files in partitions whose value contains a space
+        // (percent-encoded in the log path) were never removed, duplicating rows.
+        let schema = get_arrow_schema(&None);
+        let table = setup_table(Some(vec!["modified"])).await;
+
+        let make_batch = || {
+            RecordBatch::try_new(
+                Arc::clone(&schema),
+                vec![
+                    Arc::new(arrow::array::StringArray::from(vec!["A", "B", "C"])),
+                    Arc::new(arrow::array::Int32Array::from(vec![1, 2, 3])),
+                    Arc::new(arrow::array::StringArray::from(vec![
+                        "foo bar", "foo bar", "foo bar",
+                    ])),
+                ],
+            )
+            .unwrap()
+        };
+
+        let mut table = table;
+        let mut last_metrics = None;
+        for _ in 0..2 {
+            let source = SessionContext::new().read_batch(make_batch()).unwrap();
+            let (t, metrics) = table
+                .merge(
+                    source,
+                    col("target.id")
+                        .eq(col("source.id"))
+                        .and(col("target.modified").eq(lit("foo bar"))),
+                )
+                .with_source_alias("source")
+                .with_target_alias("target")
+                .when_matched_update(|update| {
+                    update
+                        .update("value", col("source.value"))
+                        .update("modified", col("source.modified"))
+                })
+                .unwrap()
+                .when_not_matched_insert(|insert| {
+                    insert
+                        .set("id", col("source.id"))
+                        .set("value", col("source.value"))
+                        .set("modified", col("source.modified"))
+                })
+                .unwrap()
+                .await
+                .unwrap();
+            table = t;
+            last_metrics = Some(metrics);
+        }
+
+        let metrics = last_metrics.unwrap();
+        assert_eq!(metrics.num_target_rows_updated, 3);
+        assert_eq!(metrics.num_target_rows_inserted, 0);
+        assert_eq!(metrics.num_target_files_removed, 1);
+        assert_eq!(table.snapshot().unwrap().log_data().num_files(), 1);
+
+        let expected = vec![
+            "+----+-------+----------+",
+            "| id | value | modified |",
+            "+----+-------+----------+",
+            "| A  | 1     | foo bar  |",
+            "| B  | 2     | foo bar  |",
+            "| C  | 3     | foo bar  |",
+            "+----+-------+----------+",
+        ];
+        let actual = get_data(&table).await;
+        assert_batches_sorted_eq!(&expected, &actual);
+    }
