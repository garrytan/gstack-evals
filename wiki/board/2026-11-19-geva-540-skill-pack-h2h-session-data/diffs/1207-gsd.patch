@@ -587,8 +587,19 @@ func (e *Echo) StaticFS(pathPrefix string, filesystem fs.FS, middleware ...Middl
 // When disablePathUnescaping is set then file name from path is not unescaped and is served as is.
 func StaticDirectoryHandler(fileSystem fs.FS, disablePathUnescaping bool) HandlerFunc {
 	return func(c *Context) error {
+		// Security: the router matches routes against the escaped path (URL.RawPath), so `%2F` is not treated as a
+		// path separator during routing. If we allowed `%2F` to be decoded into `/` here, requests like
+		// `/admin%2Fsecret.txt` would bypass routes/middlewares registered for `/admin/*` and serve `admin/secret.txt`.
+		// URL.Path is also checked because the router matches against it when RawPath is empty (e.g. `%252F` decoded to `%2F`)
+		// and the value could be unescaped again into `/` later.
+		if containsEncodedSlash(c.Request().URL.RawPath) || containsEncodedSlash(c.Request().URL.Path) {
+			return ErrNotFound
+		}
 		p := c.Param("*")
 		if !disablePathUnescaping { // when router is already unescaping we do not want to do is twice
+			if containsEncodedSlash(p) { // e.g. double encoded `%252F` that router has already unescaped once
+				return ErrNotFound
+			}
 			tmpPath, err := url.PathUnescape(p)
 			if err != nil {
 				return fmt.Errorf("failed to unescape path variable: %w", err)
@@ -890,3 +901,13 @@ func sanitizeURI(uri string) string {
 	}
 	return uri
 }
+
+// containsEncodedSlash checks if given (escaped) path contains percent-encoded slash (`%2F` or `%2f`).
+func containsEncodedSlash(p string) bool {
+	for i := 0; i+2 < len(p); i++ {
+		if p[i] == '%' && p[i+1] == '2' && (p[i+2] == 'F' || p[i+2] == 'f') {
+			return true
+		}
+	}
+	return false
+}
diff --git a/echo_static_encodedslash_test.go b/echo_static_encodedslash_test.go
new file mode 100644
index 0000000..3be0359
--- /dev/null
+++ b/echo_static_encodedslash_test.go
@@ -0,0 +1,41 @@
+package echo
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"testing/fstest"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestStaticFS_EncodedSlashDoesNotBypassRoutes(t *testing.T) {
+	fsys := fstest.MapFS{
+		"admin/secret.txt": {Data: []byte("secret")},
+		"public.txt":       {Data: []byte("public")},
+	}
+	for _, unescape := range []bool{false, true} {
+		e := NewWithConfig(Config{Router: NewRouter(RouterConfig{UnescapePathParamValues: unescape})})
+		e.Group("/admin", func(next HandlerFunc) HandlerFunc {
+			return func(c *Context) error { return c.NoContent(http.StatusForbidden) }
+		}).GET("/*", func(c *Context) error { return c.String(http.StatusOK, "admin") })
+		e.StaticFS("/", fsys)
+
+		for _, tc := range []struct {
+			target string
+			code   int
+		}{
+			{"/public.txt", http.StatusOK},
+			{"/admin/secret.txt", http.StatusForbidden},
+			{"/admin%2Fsecret.txt", http.StatusNotFound},
+			{"/admin%2fsecret.txt", http.StatusNotFound},
+			{"/admin%252Fsecret.txt", http.StatusNotFound},
+		} {
+			req := httptest.NewRequest(http.MethodGet, tc.target, nil)
+			rec := httptest.NewRecorder()
+			e.ServeHTTP(rec, req)
+			assert.Equal(t, tc.code, rec.Code, "unescape=%v target=%s", unescape, tc.target)
+			assert.NotContains(t, rec.Body.String(), "secret")
+		}
+	}
+}
