diff --git a/src/Quartz.Tests.Unit/Simpl/DedicatedThreadPoolTest.cs b/src/Quartz.Tests.Unit/Simpl/DedicatedThreadPoolTest.cs
new file mode 100644
index 0000000..04c5af1
--- /dev/null
+++ b/src/Quartz.Tests.Unit/Simpl/DedicatedThreadPoolTest.cs
@@ -0,0 +1,48 @@
+using System.Reflection;
+
+using Quartz.Simpl;
+using Quartz.Util;
+
+namespace Quartz.Tests.Unit.Simpl;
+
+public class DedicatedThreadPoolTest
+{
+    [Test]
+    public void ShutdownStopsDedicatedThreads()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 3 };
+        threadPool.Initialize();
+
+        var scheduler = (QueuedTaskScheduler) threadPool.Scheduler;
+        var threads = (Thread[]) typeof(QueuedTaskScheduler)
+            .GetField("_threads", BindingFlags.Instance | BindingFlags.NonPublic)!
+            .GetValue(scheduler)!;
+
+        Assert.That(threads, Has.Length.EqualTo(3));
+        Assert.That(threads.All(t => t.IsAlive), Is.True);
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        foreach (var thread in threads)
+        {
+            Assert.That(thread.Join(TimeSpan.FromSeconds(5)), Is.True, "Dedicated thread was not stopped on shutdown");
+        }
+    }
+
+    [Test]
+    public void QueuedTaskSchedulerStopsThreadsWhenTokenIsCanceled()
+    {
+        using var cts = new CancellationTokenSource();
+        using var scheduler = new QueuedTaskScheduler(2, "test", cancellationToken: cts.Token);
+        var threads = (Thread[]) typeof(QueuedTaskScheduler)
+            .GetField("_threads", BindingFlags.Instance | BindingFlags.NonPublic)!
+            .GetValue(scheduler)!;
+
+        cts.Cancel();
+
+        foreach (var thread in threads)
+        {
+            Assert.That(thread.Join(TimeSpan.FromSeconds(5)), Is.True);
+        }
+    }
+}
