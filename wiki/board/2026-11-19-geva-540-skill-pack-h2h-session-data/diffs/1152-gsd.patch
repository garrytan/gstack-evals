+
+// TestParseNetworkPolicyIPBlockNoNamespaceWildcard ensures that an
+// ipBlock-only peer never results in an endpoint selector (which would allow
+// all pods from the policy's namespace), regardless of the cluster name.
+func TestParseNetworkPolicyIPBlockNoNamespaceWildcard(t *testing.T) {
+	np := &slim_networkingv1.NetworkPolicy{
+		ObjectMeta: slim_metav1.ObjectMeta{Name: "test-server", Namespace: "default"},
+		Spec: slim_networkingv1.NetworkPolicySpec{
+			PodSelector: slim_metav1.LabelSelector{MatchLabels: map[string]string{"app": "test-server"}},
+			PolicyTypes: []slim_networkingv1.PolicyType{slim_networkingv1.PolicyTypeIngress, slim_networkingv1.PolicyTypeEgress},
+			Ingress: []slim_networkingv1.NetworkPolicyIngressRule{{
+				From: []slim_networkingv1.NetworkPolicyPeer{{IPBlock: &slim_networkingv1.IPBlock{CIDR: "192.0.2.3/32"}}},
+			}},
+			Egress: []slim_networkingv1.NetworkPolicyEgressRule{{
+				To: []slim_networkingv1.NetworkPolicyPeer{{IPBlock: &slim_networkingv1.IPBlock{CIDR: "192.0.2.3/32"}}},
+			}},
+		},
+	}
+
+	for _, clusterName := range []string{cmtypes.PolicyAnyCluster, "my-cluster"} {
+		rules, err := ParseNetworkPolicy(hivetest.Logger(t), clusterName, np)
+		require.NoError(t, err)
+		require.Len(t, rules, 2)
+		for _, r := range rules {
+			require.Len(t, r.L3, 1, "cluster %q: unexpected L3 selectors %v", clusterName, r.L3)
+			require.Equal(t, policytypes.ToSelector(api.CIDRRule{Cidr: "192.0.2.3/32"}), r.L3[0])
+		}
+	}
+}
