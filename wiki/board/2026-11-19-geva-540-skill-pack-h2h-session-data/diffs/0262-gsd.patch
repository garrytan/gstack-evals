 // The key of the returned attribute is [ErrorTypeKey].
 func ErrorType(err error) attribute.KeyValue {
 	if err == nil {
@@ -50,6 +56,11 @@ func errorType(err error) string {
 		// Fallback to reflection if the ErrorType method is not supported or
 		// returns an empty value.
 
+		// Errors that only wrap other errors (e.g. those created by
+		// fmt.Errorf with the %w verb or by errors.Join) have uninformative
+		// types. Report the type of the outermost non-wrapping error instead.
+		err = unwrapGeneric(err)
+
 		t := reflect.TypeOf(err)
 		pkg, name := t.PkgPath(), t.Name()
 		if pkg != "" && name != "" {
@@ -64,3 +75,47 @@ func errorType(err error) string {
 	}
 	return s
 }
+
+// unwrapGeneric unwraps err while it is a generic wrapping error from the
+// standard library (created by fmt.Errorf with the %w verb or by errors.Join).
+// It returns the outermost error that is not such a wrapper. If a wrapper does
+// not wrap any non-nil error, the wrapper itself is returned.
+func unwrapGeneric(err error) error {
+	for err != nil && isGenericWrapper(err) {
+		var next error
+		switch u := err.(type) {
+		case interface{ Unwrap() error }:
+			next = u.Unwrap()
+		case interface{ Unwrap() []error }:
+			for _, e := range u.Unwrap() {
+				if e != nil {
+					next = e
+					break
+				}
+			}
+		}
+		if next == nil {
+			break
+		}
+		err = next
+	}
+	return err
+}
+
+// isGenericWrapper reports whether err is one of the standard library error
+// types whose only purpose is to wrap other errors: *fmt.wrapError,
+// *fmt.wrapErrors, or *errors.joinError.
+func isGenericWrapper(err error) bool {
+	t := reflect.TypeOf(err)
+	if t.Kind() != reflect.Pointer {
+		return false
+	}
+	t = t.Elem()
+	switch t.PkgPath() {
+	case "fmt":
+		return t.Name() == "wrapError" || t.Name() == "wrapErrors"
+	case "errors":
+		return t.Name() == "joinError"
+	}
+	return false
+}
