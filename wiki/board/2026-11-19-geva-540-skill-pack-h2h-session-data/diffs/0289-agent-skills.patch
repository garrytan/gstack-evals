+        [Test]
+        public async Task DialogProvider_BackgroundClass_ShouldApplyToMessageBox_WhenNoOptionsGiven()
+        {
+            var comp = Context.Render<MudDialogProvider>(parameters => parameters
+                .Add(p => p.BackgroundClass, "global-background"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            _ = comp.InvokeAsync(() => service.ShowMessageBoxAsync("Title", "Message"));
+
+            comp.WaitForAssertion(() => comp.Find("div.mud-overlay-dialog").ClassList.Should().Contain("global-background"));
+        }
+
+        [Test]
+        public async Task DialogProvider_BackgroundClass_ShouldApplyToDialog_WhenNoOptionsGiven()
+        {
+            var comp = Context.Render<MudDialogProvider>(parameters => parameters
+                .Add(p => p.BackgroundClass, "global-background"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            await comp.InvokeAsync(() => service.ShowAsync<DialogOkCancel>("Title"));
+
+            comp.Find("div.mud-overlay-dialog").ClassList.Should().Contain("global-background");
+        }
+
+        [Test]
+        public async Task DialogOptions_BackgroundClass_ShouldOverrideProviderBackgroundClass()
+        {
+            var comp = Context.Render<MudDialogProvider>(parameters => parameters
+                .Add(p => p.BackgroundClass, "global-background"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            await comp.InvokeAsync(() => service.ShowAsync<DialogOkCancel>("Title", new DialogOptions { BackgroundClass = "local-background" }));
+
+            var classList = comp.Find("div.mud-overlay-dialog").ClassList;
+            classList.Should().Contain("local-background");
+            classList.Should().NotContain("global-background");
+        }
+
