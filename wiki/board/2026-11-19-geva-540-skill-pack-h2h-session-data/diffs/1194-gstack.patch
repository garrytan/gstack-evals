diff --git a/test/download.test.ts b/test/download.test.ts
new file mode 100644
index 0000000..d17252e
--- /dev/null
+++ b/test/download.test.ts
@@ -0,0 +1,34 @@
+import { describe, it, expect } from 'vitest';
+import { resolve } from 'path';
+import { resolveDownloadDir } from '../src/download.js';
+import { safeBasename } from '../src/paths.js';
+
+describe('resolveDownloadDir', () => {
+  const root = resolve('/tmp/bmcp-dl');
+  it('defaults to the root', () => {
+    expect(resolveDownloadDir(undefined, root)).toBe(root);
+    expect(resolveDownloadDir('', root)).toBe(root);
+  });
+  it('allows relative subdirectories', () => {
+    expect(resolveDownloadDir('a/b', root)).toBe(resolve(root, 'a/b'));
+  });
+  it('rejects absolute paths and traversal', () => {
+    expect(() => resolveDownloadDir('/etc', root)).toThrow(/absolute/);
+    expect(() => resolveDownloadDir('C:\\Windows', root)).toThrow(/absolute/);
+    expect(() => resolveDownloadDir('..', root)).toThrow(/\.\./);
+    expect(() => resolveDownloadDir('x/../../y', root)).toThrow(/\.\./);
+    expect(() => resolveDownloadDir('..\\y', root)).toThrow(/\.\./);
+  });
+});
+
+describe('safeBasename', () => {
+  it('strips directories', () => {
+    expect(safeBasename('../../.bashrc')).toBe('.bashrc');
+    expect(safeBasename('a\\b\\c.txt')).toBe('c.txt');
+  });
+  it('falls back on empty or dot names', () => {
+    expect(safeBasename('')).toBe('download.bin');
+    expect(safeBasename('..')).toBe('download.bin');
+    expect(safeBasename('dir/')).toBe('download.bin');
+  });
+});
