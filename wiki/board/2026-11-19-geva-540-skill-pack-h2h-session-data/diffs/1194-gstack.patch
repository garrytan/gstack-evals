diff --git a/src/paths.ts b/src/paths.ts
new file mode 100644
index 0000000..b0add9b
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,37 @@
+import { isAbsolute, relative, resolve, sep, win32, posix } from 'path';
+
+// Confine a caller-supplied relative path under a fixed root. Rejects absolute
+// paths (POSIX, Windows drive, UNC) and any `..` escape. MCP callers (or an
+// agent steered by prompt injection) control these arguments, so they must
+// never be able to choose an arbitrary filesystem location.
+export function confinePath(root: string, userPath: string, what = 'path'): string {
+  if (typeof userPath !== 'string' || userPath.trim() === '') {
+    throw new Error(`Invalid ${what}: empty`);
+  }
+  if (userPath.includes('\0')) throw new Error(`Invalid ${what}: contains NUL byte`);
+  if (isAbsolute(userPath) || posix.isAbsolute(userPath) || win32.isAbsolute(userPath)) {
+    throw new Error(
+      `Invalid ${what} ${JSON.stringify(userPath)}: absolute paths are not allowed; pass a path relative to ${root}`,
+    );
+  }
+  const segments = userPath.split(/[\\/]+/);
+  if (segments.includes('..')) {
+    throw new Error(`Invalid ${what} ${JSON.stringify(userPath)}: ".." is not allowed`);
+  }
+  const base = resolve(root);
+  const full = resolve(base, userPath);
+  const rel = relative(base, full);
+  if (rel === '..' || rel.startsWith('..' + sep) || isAbsolute(rel)) {
+    throw new Error(`Invalid ${what} ${JSON.stringify(userPath)}: escapes ${root}`);
+  }
+  return full;
+}
+
+// Reduce a server-supplied filename to a safe bare basename.
+export function safeBasename(name: string | undefined, fallback = 'download.bin'): string {
+  const last = (name ?? '').split(/[\\/]+/).pop() ?? '';
+  // eslint-disable-next-line no-control-regex
+  const cleaned = last.replace(/[\x00-\x1f]/g, '').trim();
+  if (!cleaned || cleaned === '.' || cleaned === '..') return fallback;
+  return cleaned;
+}
