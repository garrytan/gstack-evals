@@ -106,6 +106,35 @@ namespace Tests.Core
             }
         }
 
+        [Test]
+        public void CopyDirectory_DestInsideSource_ThrowsKraken()
+        {
+            using (var dir = new TemporaryDirectory())
+            {
+                // Arrange
+                var source = Path.Combine(dir, "source");
+                Directory.CreateDirectory(source);
+                File.WriteAllText(Path.Combine(source, "thatsafile"), "contents");
+
+                // Act / Assert
+                Assert.Throws<PathErrorKraken>(() =>
+                    Utilities.CopyDirectory(source, Path.Combine(source, "sub", "dest"),
+                                            Array.Empty<string>(), Array.Empty<string>(),
+                                            Array.Empty<string>(), Array.Empty<string>()));
+                Assert.Throws<PathErrorKraken>(() =>
+                    Utilities.CopyDirectory(source, source,
+                                            Array.Empty<string>(), Array.Empty<string>(),
+                                            Array.Empty<string>(), Array.Empty<string>()));
+                DirectoryAssert.DoesNotExist(Path.Combine(source, "sub"));
+
+                // A sibling sharing the name prefix is fine
+                Utilities.CopyDirectory(source, source + "2",
+                                        Array.Empty<string>(), Array.Empty<string>(),
+                                        Array.Empty<string>(), Array.Empty<string>());
+                FileAssert.Exists(Path.Combine(source + "2", "thatsafile"));
+            }
+        }
+
         private readonly string goodKspDir = TestData.good_ksp_dir();
     }
