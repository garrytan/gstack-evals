+/// A `.git` boundary is valid when it is a directory, or a gitfile whose
+/// `gitdir:` target resolves to an existing directory. Broken gitfiles (e.g.
+/// a stale worktree pointer in `$HOME`) must not promote the root.
+fn is_valid_git_boundary(dir: &Path) -> bool {
+    let git = dir.join(".git");
+    if git.is_dir() {
+        return true;
+    }
+    if !git.is_file() {
+        return false;
+    }
+    let Ok(content) = std::fs::read_to_string(&git) else {
+        return false;
+    };
+    let Some(target) = content
+        .lines()
+        .find_map(|l| l.trim().strip_prefix("gitdir:"))
+        .map(str::trim)
+        .filter(|t| !t.is_empty())
+    else {
+        return false;
+    };
+    let target = Path::new(target);
+    let resolved = if target.is_absolute() {
+        target.to_path_buf()
+    } else {
+        dir.join(target)
+    };
+    resolved.is_dir()
+}
