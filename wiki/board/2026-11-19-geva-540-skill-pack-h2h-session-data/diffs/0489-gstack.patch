diff --git a/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java b/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java
index d9c942a..bb239f2 100644
--- a/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java
+++ b/src/test/java/tools/jackson/databind/convert/UpdateViaObjectReaderTest.java
@@ -392,4 +392,33 @@ public class UpdateViaObjectReaderTest
         assertNotSame(obj, newObj);
         assertNull(newObj);
     }
+
+    // [databind#2762]: should be able to update instance of local/anonymous class
+    @Test
+    public void testUpdatingLocalAndAnonymousClass() throws Exception
+    {
+        final ObjectMapper mapper = newJsonMapper();
+
+        class LocalBean {
+            public int value;
+        }
+        LocalBean local = new LocalBean();
+        LocalBean result = mapper.readerForUpdating(local).readValue(a2q("{'value':2}"));
+        assertSame(local, result);
+        assertEquals(2, local.value);
+
+        Object anon = new Object() {
+            public int value;
+
+            @Override
+            public String toString() { return String.valueOf(value); }
+        };
+        Object anonResult = mapper.readerForUpdating(anon).readValue(a2q("{'value':3}"));
+        assertSame(anon, anonResult);
+        assertEquals("3", anon.toString());
+
+        // but can not construct a new instance (requires outer instance)
+        assertThrows(DatabindException.class,
+                () -> mapper.readValue(a2q("{'value':2}"), LocalBean.class));
+    }
 }
