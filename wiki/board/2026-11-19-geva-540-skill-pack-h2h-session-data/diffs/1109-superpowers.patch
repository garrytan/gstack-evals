diff --git a/test/dom/serializer.test.js b/test/dom/serializer.test.js
index 4bd555a..27c98ae 100644
--- a/test/dom/serializer.test.js
+++ b/test/dom/serializer.test.js
@@ -620,3 +620,40 @@ describe('NodeList.toString', () => {
 		});
 	});
 });
+
+describe('attribute name validation with requireWellFormed (GHSA-4w3w-2rp5-g8jm)', () => {
+	const payload = 'class="safe" onclick';
+	test('default serialization emits names verbatim', () => {
+		const doc = new DOMImplementation().createDocument(null, 'root', null);
+		doc.documentElement.setAttribute(payload, 'alert(1)');
+		expect(new XMLSerializer().serializeToString(doc)).toBe('<root class="safe" onclick="alert(1)"/>');
+	});
+	test('throws InvalidStateError for invalid attribute name set via setAttribute', () => {
+		const doc = new DOMImplementation().createDocument(null, 'root', null);
+		doc.documentElement.setAttribute(payload, 'alert(1)');
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+		expectDOMException(() => doc.documentElement.toString({ requireWellFormed: true }), 'InvalidStateError');
+	});
+	test('throws InvalidStateError when serializing a standalone attribute node with invalid name', () => {
+		const doc = new DOMImplementation().createDocument(null, 'root', null);
+		doc.documentElement.setAttribute(payload, 'x');
+		const attr = doc.documentElement.attributes.item(0);
+		expectDOMException(() => new XMLSerializer().serializeToString(attr, { requireWellFormed: true }), 'InvalidStateError');
+	});
+	test('throws InvalidStateError for invalid synthesized xmlns:PREFIX declaration', () => {
+		const doc = new DOMImplementation().createDocument(null, 'root', null);
+		const attr = doc.createAttributeNS('urn:x', 'p:a');
+		attr.prefix = 'bad" onclick="alert(1)" x';
+		doc.documentElement.setAttributeNode(attr);
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+	test('valid attribute names and namespace declarations serialize under requireWellFormed', () => {
+		const doc = new DOMImplementation().createDocument('urn:a', 'p:root', null);
+		doc.documentElement.setAttributeNS('urn:b', 'q:x', '1');
+		doc.documentElement.setAttribute('xmlns:z', 'urn:z');
+		doc.documentElement.setAttribute('plain', 'v');
+		expect(new XMLSerializer().serializeToString(doc, { requireWellFormed: true })).toBe(
+			'<p:root xmlns:q="urn:b" q:x="1" xmlns:z="urn:z" plain="v" xmlns:p="urn:a"/>'
+		);
+	});
+});
