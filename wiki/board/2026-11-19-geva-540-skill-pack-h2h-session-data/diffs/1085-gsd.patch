 }
 
+func mustCIDR(s string) *net.IPNet {
+	_, n, err := net.ParseCIDR(s)
+	if err != nil {
+		panic(err)
+	}
+	return n
+}
+
+var ipv6TransitionNets = []*net.IPNet{
+	mustCIDR("2002::/16"),      // 6to4 (RFC 3056)
