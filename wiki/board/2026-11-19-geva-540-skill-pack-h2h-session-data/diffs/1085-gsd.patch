+	mustCIDR("64:ff9b:1::/48"), // NAT64 local-use prefix (RFC 8215)
+	mustCIDR("2001::/32"),      // Teredo (RFC 4380)
+	mustCIDR("::/96"),          // IPv4-compatible IPv6 (deprecated, RFC 4291)
+}
