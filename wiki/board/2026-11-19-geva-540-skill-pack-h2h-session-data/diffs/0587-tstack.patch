+// hostsCoveredByWildcard returns true if every host in hosts is
+// matched by one of the wildcard hosts (excluding exact equality).
+// It returns false if hosts is empty.
+func hostsCoveredByWildcard(hosts []string, wildcards []string) bool {
+	if len(hosts) == 0 || len(wildcards) == 0 {
+		return false
+	}
+	for _, host := range hosts {
+		if strings.HasPrefix(host, "*.") || certmagic.SubjectIsIP(host) {
+			return false
+		}
+		if !slices.ContainsFunc(wildcards, func(wc string) bool {
+			return certmagic.MatchWildcard(host, wc)
+		}) {
+			return false
+		}
+	}
+	return true
+}
