diff --git a/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
new file mode 100644
index 0000000..3582bda
--- /dev/null
+++ b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
@@ -0,0 +1,55 @@
+'use strict';
+
+/**
+ * GHSA-x6m4-chr9-cg97 — host path disclosure via transformer error stack
+ *
+ * Sandbox `eval` / `Function` route source through the host-realm
+ * transformer. A malformed source makes it throw a host-realm SyntaxError
+ * whose `.stack` was formatted by the host and contained absolute host paths.
+ * Errors must be rebuilt in the sandbox realm so `.stack` is sandbox-formatted.
+ */
+
+const assert = require('assert');
+const { VM, NodeVM } = require('../../../lib/main.js');
+
+const HOST_PATH = /transformer\.js|setup-sandbox\.js|vm\.js:\d|node:|\(\//;
+
+describe('GHSA-x6m4-chr9-cg97 (transformer error stack leak)', () => {
+	const cases = {
+		'eval': 'eval("@@@ catch")',
+		'Function': 'Function("@@@ catch")',
+		'new Function': 'new Function("a", "@@@ catch")',
+	};
+	for (const name of Object.keys(cases)) {
+		it(`VM ${name} does not leak host paths`, () => {
+			const r = new VM().run(`var r; try { ${cases[name]} } catch (e) { r = [e instanceof SyntaxError, e.message, String(e.stack)] } r;`);
+			assert.strictEqual(r[0], true);
+			assert.strictEqual(r[1], "Unexpected character '@'");
+			assert.ok(!HOST_PATH.test(r[2]), r[2]);
+		});
+	}
+
+	it('VM with eval disabled does not leak host paths', () => {
+		const s = new VM({ eval: false }).run('var s; try { eval("@@@ catch") } catch (e) { s = String(e.stack) } s;');
+		assert.ok(!HOST_PATH.test(s), s);
+	});
+
+	it('NodeVM does not leak host paths', () => {
+		const s = new NodeVM().run('var s; try { eval("@@@ catch") } catch (e) { s = String(e.stack) } module.exports = s;');
+		assert.ok(!HOST_PATH.test(s), s);
+	});
+
+	it('async-disallowed VMError stays a VMError without host stack', () => {
+		const r = new VM({ allowAsync: false }).run('var r; try { Function("async function f(){}") } catch (e) { r = [e instanceof VMError, e.message, String(e.stack)] } r;');
+		assert.strictEqual(r[0], true);
+		assert.strictEqual(r[1], 'Async not available');
+		assert.ok(!HOST_PATH.test(r[2]), r[2]);
+	});
+
+	it('host-thrown errors caught in the sandbox do not carry host stack', () => {
+		const vm = new VM({ sandbox: { f() { throw new Error('boom'); } } });
+		const s = vm.run('var s; try { f() } catch (e) { s = String(e.stack) } s;');
+		assert.ok(/boom/.test(s));
+		assert.ok(!HOST_PATH.test(s), s);
+	});
+});
