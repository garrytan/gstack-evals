diff --git a/CHANGELOG.md b/CHANGELOG.md
index 973f4a9..6beb53b 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -140,6 +140,9 @@ is based on [Keep a Changelog](https://keepachangelog.com).
 
 ### Fixed
 
+- Calling `quit` from a message handler in an actor shell (e.g., in the error
+  handler of a request that timed out) no longer triggers an assertion. The
+  actor shell now stops processing messages once its mailbox has been closed.
 - Errors that arise during the `with` DSL setup of servers and clients now
   properly call `on_error` (#2026).
 - Fix UBSan finding regarding non-aligned memory allocation when spawning
diff --git a/libcaf_net/caf/net/abstract_actor_shell.cpp b/libcaf_net/caf/net/abstract_actor_shell.cpp
index 22cbf81..770198c 100644
--- a/libcaf_net/caf/net/abstract_actor_shell.cpp
+++ b/libcaf_net/caf/net/abstract_actor_shell.cpp
@@ -27,7 +27,9 @@ abstract_actor_shell::abstract_actor_shell(actor_config& cfg,
   mailbox_.try_block();
   resume_ = make_action([this] {
     for (;;) {
-      if (!consume_message() && try_block_mailbox())
+      // Note: consume_message() may call quit(), which closes the mailbox. We
+      //       must not access a closed mailbox again.
+      if (terminated() || (!consume_message() && try_block_mailbox()))
         return;
     }
   });
@@ -52,12 +54,14 @@ void abstract_actor_shell::quit(error reason) {
 // -- mailbox access -----------------------------------------------------------
 
 mailbox_element_ptr abstract_actor_shell::next_message() {
-  if (!mailbox_.blocked())
+  if (!mailbox_.closed() && !mailbox_.blocked())
     return mailbox_.pop_front();
   return nullptr;
 }
 
 bool abstract_actor_shell::try_block_mailbox() {
+  if (mailbox_.closed())
+    return false;
   return mailbox_.try_block();
 }
 
