+TEST("actor shells may call quit from a request error handler") {
+  scoped_actor self{sys};
+  // Actor that never responds to the request.
+  auto dummy = sys.spawn([](event_based_actor* dself) -> behavior {
+    return {
+      [dself](get_atom) {
+        auto rp = dself->make_response_promise<std::string>();
+        return rp;
+      },
+    };
+  });
+  auto cb = [dummy](app_t* app) {
+    app->self->mail(get_atom_v)
+      .request(dummy, 10ms)
+      .then([](const std::string&) {},
+            [app](const error& err) {
+              auto* down = app->down;
+              down->begin_output();
+              auto& buf = down->output_buffer();
+              auto msg = "timeout"s;
+              auto bytes = as_bytes(std::span{msg});
+              buf.insert(buf.end(), bytes.begin(), bytes.end());
+              down->end_output();
+              app->self->quit(err);
+            });
+  };
+  auto& mpx = sys.network_manager().mpx();
+  auto app = app_t::make(actor{self}, cb);
+  auto transport = net::octet_stream::transport::make(fd1, std::move(app));
+  auto mgr = net::socket_manager::make(&mpx, std::move(transport));
+  require(mpx.start(mgr));
+  fd1.id = net::invalid_socket_id;
+  auto msg = "timeout"s;
+  byte_buffer buf;
+  buf.resize(msg.size());
+  auto n = net::read(fd2, buf);
+  check_eq(n, static_cast<ptrdiff_t>(msg.size()));
+  check_eq(to_string_view(buf), msg);
+  self->send_exit(dummy, exit_reason::user_shutdown);
+}
+
 } // WITH_FIXTURE(fixture)
