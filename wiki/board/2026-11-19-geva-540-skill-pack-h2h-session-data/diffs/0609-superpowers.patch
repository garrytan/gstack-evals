+    /// <summary>
+    /// Converts a wall clock time in the trigger's time zone into a <see cref="DateTimeOffset"/>.
+    /// For ambiguous times (DST end) the earliest instance that is not before <paramref name="notBefore"/> is chosen.
+    /// Invalid times (DST start) are effectively moved forward by the DST gap.
+    /// </summary>
+    private DateTimeOffset ToDateTimeOffsetNotBefore(DateTime localTime, DateTimeOffset notBefore)
+    {
+        localTime = DateTime.SpecifyKind(localTime, DateTimeKind.Unspecified);
+        if (TimeZone.IsAmbiguousTime(localTime))
+        {
+            DateTimeOffset? candidate = null;
+            foreach (TimeSpan offset in TimeZone.GetAmbiguousTimeOffsets(localTime).OrderByDescending(x => x))
+            {
+                candidate = new DateTimeOffset(localTime, offset);
+                if (candidate.Value >= notBefore)
+                {
+                    break;
+                }
+            }
+            return candidate!.Value;
+        }
+
+        // for invalid times this returns the offset in effect before the transition, moving time forward
+        return new DateTimeOffset(localTime, TimeZone.GetUtcOffset(localTime));
+    }
