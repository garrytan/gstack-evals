index 1e86ec8..8b943a6 100644
--- a/internal/storage/embeddeddolt/schema.go
+++ b/internal/storage/embeddeddolt/schema.go
@@ -169,3 +169,59 @@ func backfillMigrations(ctx context.Context, tx *sql.Tx) (int, error) {
 	}
 	return n, nil
 }
+
+// ignoredTableSteps rebuild the dolt_ignore'd wisp tables. Migrations run once
+// per database, but these tables live only in the working set, so a clone, a
+// restored backup, or a new branch lacks them. A step runs when any table it
+// builds is missing; together the steps reproduce what migrations 0020-0023 did.
+var ignoredTableSteps = []struct {
+	tables    []string
+	migration string
+	stmt      string
+}{
+	{tables: []string{"wisps"}, migration: "0020_create_wisps.up.sql"},
+	{tables: []string{"wisps"}, stmt: "ALTER TABLE wisps ADD COLUMN no_history TINYINT(1) DEFAULT 0"},
+	{tables: []string{"wisp_labels", "wisp_dependencies", "wisp_events", "wisp_comments"}, migration: "0021_create_wisp_auxiliary.up.sql"},
+	{tables: []string{"wisp_dependencies"}, migration: "0022_wisp_dep_type_index.up.sql"},
+}
+
+// ensureIgnoredTables recreates any missing dolt_ignore'd wisp tables.
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	missing := map[string]bool{}
+	for _, step := range ignoredTableSteps {
+		for _, table := range step.tables {
+			var n int
+			if err := tx.QueryRowContext(ctx, "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?", table).Scan(&n); err != nil {
+				return fmt.Errorf("checking for table %s: %w", table, err)
+			}
+			missing[table] = n == 0
+		}
+	}
+
+	for _, step := range ignoredTableSteps {
+		if !anyMissing(missing, step.tables) {
+			continue
+		}
+		stmt := step.stmt
+		if step.migration != "" {
+			data, err := upMigrations.ReadFile("schema/" + step.migration)
+			if err != nil {
+				return fmt.Errorf("reading migration %s: %w", step.migration, err)
+			}
+			stmt = string(data)
+		}
+		if _, err := tx.ExecContext(ctx, stmt); err != nil {
+			return fmt.Errorf("recreating %s: %w", strings.Join(step.tables, ", "), err)
+		}
+	}
+	return nil
+}
+
+func anyMissing(missing map[string]bool, tables []string) bool {
+	for _, table := range tables {
+		if missing[table] {
+			return true
+		}
+	}
+	return false
+}
