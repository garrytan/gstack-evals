diff --git a/internal/storage/embeddeddolt/ignored_tables_test.go b/internal/storage/embeddeddolt/ignored_tables_test.go
new file mode 100644
index 0000000..ef2400a
--- /dev/null
+++ b/internal/storage/embeddeddolt/ignored_tables_test.go
@@ -0,0 +1,99 @@
+//go:build cgo
+
+package embeddeddolt_test
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/storage/embeddeddolt"
+	"github.com/steveyegge/beads/internal/types"
+)
+
+var wispTables = []string{"wisps", "wisp_dependencies", "wisp_labels", "wisp_events", "wisp_comments"}
+
+func showCreateTables(t *testing.T, ctx context.Context, db *sql.DB) map[string]string {
+	t.Helper()
+	ddl := map[string]string{}
+	for _, table := range wispTables {
+		var name, create string
+		if err := db.QueryRowContext(ctx, "SHOW CREATE TABLE "+table).Scan(&name, &create); err != nil {
+			t.Fatalf("SHOW CREATE TABLE %s: %v", table, err)
+		}
+		ddl[table] = create
+	}
+	return ddl
+}
+
+// Wisp tables are dolt_ignore'd, so a working set can lack them (fresh clone,
+// restored backup, new branch). Reopening the store must recreate them.
+func TestReopenRecreatesMissingWispTables(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	ctx := t.Context()
+	beadsDir := filepath.Join(t.TempDir(), ".beads")
+	dataDir := filepath.Join(beadsDir, "embeddeddolt")
+
+	store, err := embeddeddolt.New(ctx, beadsDir, "rw", "main")
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if err := store.SetConfig(ctx, "issue_prefix", "rw"); err != nil {
+		t.Fatalf("SetConfig: %v", err)
+	}
+	for _, id := range []string{"rw-a", "rw-b"} {
+		issue := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+		if err := store.CreateIssue(ctx, issue, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+	}
+	if err := store.Commit(ctx, "seed"); err != nil {
+		t.Fatalf("Commit: %v", err)
+	}
+	store.Close()
+
+	db, cleanup, err := embeddeddolt.OpenSQL(ctx, dataDir, "rw", "main")
+	if err != nil {
+		t.Fatalf("OpenSQL: %v", err)
+	}
+	fresh := showCreateTables(t, ctx, db)
+	for _, table := range wispTables {
+		if _, err := db.ExecContext(ctx, "DROP TABLE "+table); err != nil {
+			cleanup()
+			t.Fatalf("DROP TABLE %s: %v", table, err)
+		}
+	}
+	cleanup()
+
+	store, err = embeddeddolt.New(ctx, beadsDir, "rw", "main")
+	if err != nil {
+		t.Fatalf("reopen: %v", err)
+	}
+	defer store.Close()
+
+	db, cleanup, err = embeddeddolt.OpenSQL(ctx, dataDir, "rw", "main")
+	if err != nil {
+		t.Fatalf("OpenSQL after reopen: %v", err)
+	}
+	recreated := showCreateTables(t, ctx, db)
+	cleanup()
+	for _, table := range wispTables {
+		if recreated[table] != fresh[table] {
+			t.Errorf("%s schema drifted after recreation\nfresh:\n%s\nrecreated:\n%s", table, fresh[table], recreated[table])
+		}
+	}
+
+	dep := &types.Dependency{IssueID: "rw-b", DependsOnID: "rw-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency after reopen: %v", err)
+	}
+	if err := store.DeleteIssue(ctx, "rw-b"); err != nil {
+		t.Fatalf("DeleteIssue after reopen: %v", err)
+	}
+
+	wisp := &types.Issue{Title: "w", Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask, Ephemeral: true}
+	if err := store.CreateIssue(ctx, wisp, "tester"); err != nil {
+		t.Fatalf("CreateIssue wisp after reopen: %v", err)
+	}
+}
