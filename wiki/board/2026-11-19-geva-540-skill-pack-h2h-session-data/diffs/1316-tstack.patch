@@ -741,6 +741,7 @@ func TestSummaryManualSplitHTML(t *testing.T) {
 	t.Parallel()
 	Test(t, `
 -- hugo.toml --
+security.allowContent = ['.*']
 -- content/simple.html --
 ---
 title: Simple
@@ -2016,3 +2017,45 @@ disableKinds = ["taxonomy", "term"]
 		}
 	}
 }
+
+func TestAllowContentHTMLDeniedByDefault(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap", "home", "section"]
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert(1)</script>
+-- layouts/single.html --
+{{ .Content }}
+`
+	b, err := TestE(t, files)
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+
+	// Content adapter.
+	filesAdapter := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap", "home", "section"]
+-- content/_content.gotmpl --
+{{ $content := dict "mediaType" "text/html" "value" "<script>alert(1)</script>" }}
+{{ .AddPage (dict "path" "p2" "title" "p2" "content" $content) }}
+-- layouts/single.html --
+{{ .Content }}
+`
+	b, err = TestE(t, filesAdapter)
+	if err == nil {
+		t.Fatal("expected error")
+	}
+	b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+
+	// Opt in.
+	files = strings.Replace(files, "-- hugo.toml --\n", "-- hugo.toml --\nsecurity.allowContent = ['.*']\n", 1)
+	b = Test(t, files)
+	b.AssertFileContent("public/p1/index.html", "<script>alert(1)</script>")
+}
