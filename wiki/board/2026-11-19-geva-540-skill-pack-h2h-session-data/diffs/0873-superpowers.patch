 }
 
+function hasAssignmentToBindings(
+  nodes: t.Node[],
+  bindings: ReferencedBindings,
+) {
+  const names = new Set<string>();
+  forEach(bindings, (binding) => {
+    if (binding.assignmentSections) {
+      names.add(binding.name);
+    }
+  });
+
+  return (
+    names.size > 0 &&
+    traverseContains(nodes, (node) => {
+      switch (node.type) {
+        case "AssignmentExpression": {
+          let found = false;
+          forEachIdentifier(node.left, (id) => {
+            if (names.has(id.name)) found = true;
+          });
+          return found;
+        }
+        case "UpdateExpression":
+          return (
+            node.argument.type === "Identifier" && names.has(node.argument.name)
+          );
+      }
+    })
+  );
+}
