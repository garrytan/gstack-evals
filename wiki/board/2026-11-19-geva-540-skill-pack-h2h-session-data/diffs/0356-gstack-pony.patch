+    [Fact]
+    public void Should_Accept_Choice_Ignoring_Case_By_Default()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+
+        // When
+        var result = console.Prompt(new TextPrompt<string>("Helpful?").AddChoices(["Yes", "No"]));
+
+        // Then
+        result.ShouldBe("Yes");
+    }
+
+    [Fact]
+    public void Should_Respect_Explicit_Case_Sensitive_Comparer()
+    {
+        // Given
+        var console = new TestConsole();
+        console.Input.PushTextWithEnter("yes");
+        console.Input.PushTextWithEnter("Yes");
+
+        // When
+        var result = console.Prompt(new TextPrompt<string>("Helpful?", StringComparer.Ordinal).AddChoices(["Yes", "No"]));
+
+        // Then
+        result.ShouldBe("Yes");
+        console.Output.ShouldContain("Please select one of the available options");
+    }
