+    private static bool TryGetChoiceIgnoreCase(Dictionary<string, T> choiceMap, string input, out T? result)
+    {
+        foreach (var pair in choiceMap)
+        {
+            if (string.Equals(pair.Key, input, StringComparison.OrdinalIgnoreCase))
+            {
+                result = pair.Value;
+                return true;
+            }
+        }
+
+        result = default;
+        return false;
+    }
