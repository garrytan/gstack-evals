+
+    public interface IDecoratable { string Name { get; } }
+    public class DecoratableA : IDecoratable { public string Name => "A"; }
+    public class DecoratableB : IDecoratable { public string Name => "B"; }
+    public class Decorator(IDecoratable inner) : IDecoratable
+    {
+        public IDecoratable Inner { get; } = inner;
+        public string Name => "Decorated" + Inner.Name;
+    }
+
+    [Fact]
+    public void DecorateService_DecorateSingleRegistration()
+    {
+        var services = new ServiceCollection();
+        services.AddTransient<IDecoratable, DecoratableA>();
+
+        Assert.True(services.DecorateService<IDecoratable, Decorator>());
+
+        var sp = services.BuildServiceProvider();
+        Assert.Equal("DecoratedA", sp.GetRequiredService<IDecoratable>().Name);
+    }
+
+    [Fact]
+    public void DecorateService_DecorateAllRegistrationsPreservingOrderAndLifetime()
+    {
+        var services = new ServiceCollection();
+        services.AddTransient<IDecoratable, DecoratableA>();
+        services.AddSingleton<IDecoratable>(new DecoratableB());
+        services.AddScoped<IDecoratable>(_ => new DecoratableA());
+
+        Assert.True(services.DecorateService<IDecoratable, Decorator>());
+
+        var descriptors = services.Where(s => s.ServiceType == typeof(IDecoratable)).ToList();
+        Assert.Equal(3, descriptors.Count);
+        Assert.Equal(ServiceLifetime.Transient, descriptors[0].Lifetime);
+        Assert.Equal(ServiceLifetime.Singleton, descriptors[1].Lifetime);
+        Assert.Equal(ServiceLifetime.Scoped, descriptors[2].Lifetime);
+
+        using var sp = services.BuildServiceProvider();
+        using var scope = sp.CreateScope();
+        var all = scope.ServiceProvider.GetServices<IDecoratable>().Select(d => d.Name).ToList();
+        Assert.Equal(new[] { "DecoratedA", "DecoratedB", "DecoratedA" }, all);
+        Assert.IsType<Decorator>(scope.ServiceProvider.GetRequiredService<IDecoratable>());
+    }
+
+    [Fact]
+    public void DecorateService_ThrowIfNoRegistration()
+    {
+        var services = new ServiceCollection();
+        Assert.Throws<ArgumentException>(() => services.DecorateService<IDecoratable, Decorator>());
+    }
+}
