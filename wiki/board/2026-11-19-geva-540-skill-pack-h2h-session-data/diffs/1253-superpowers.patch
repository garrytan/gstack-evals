+
+// bulkEffectiveACL returns the .goshs ACL governing absPath. For directories
+// the directory's own config applies (as in doDir), for files the config of
+// the containing directory applies (as in doFile).
+func (fs *FileServer) bulkEffectiveACL(absPath string, isDir bool) configFile {
+	dir := absPath
+	if !isDir {
+		dir = filepath.Dir(absPath)
+	}
+	acl, err := fs.findEffectiveACL(dir)
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+		// Fail closed: deny access if the ACL cannot be parsed
+		return configFile{Auth: "invalid"}
+	}
+	return acl
+}
+
+// bulkPathBlocked reports whether absPath is hidden by a block list in the
+// effective ACL of its parent directory, or is a .goshs ACL file.
+func (fs *FileServer) bulkPathBlocked(absPath string, isDir bool) bool {
+	name := filepath.Base(absPath)
+	if !isDir && name == ".goshs" {
+		return true
+	}
+	if filepath.Clean(absPath) == filepath.Clean(fs.Webroot) {
+		return false
+	}
+	parentACL, err := fs.findEffectiveACL(filepath.Dir(absPath))
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+		return true
+	}
+	if isDir {
+		return slices.Contains(parentACL.Block, name+"/") || slices.Contains(parentACL.Block, name)
+	}
+	return slices.Contains(parentACL.Block, name)
+}
+
+// bulkEntryAllowed checks an entry encountered while walking a requested
+// directory. It does not write to the response (headers are already sent).
+func (fs *FileServer) bulkEntryAllowed(req *http.Request, absPath string, isDir bool) bool {
+	if fs.bulkPathBlocked(absPath, isDir) {
+		return false
+	}
+	return checkACLCredentials(req, fs.bulkEffectiveACL(absPath, isDir))
+}
+
+// checkACLCredentials validates request basic auth against a .goshs ACL
+// without writing any response.
+func checkACLCredentials(req *http.Request, acl configFile) bool {
+	if acl.Auth == "" {
+		return true
+	}
+	username, password, authOK := req.BasicAuth()
+	if !authOK {
+		return false
+	}
+	user, passwordHash, ok := strings.Cut(acl.Auth, ":")
+	if !ok {
+		return false
+	}
+	return username == user && checkPasswordHash(password, passwordHash)
+}
