+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func setupBulkACL(t *testing.T) string {
+	dir := t.TempDir()
+	prot := filepath.Join(dir, "protected")
+	require.NoError(t, os.MkdirAll(filepath.Join(prot, "sub"), 0755))
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := fmt.Sprintf(`{"auth":"admin:%s","block":["blocked.txt"]}`, hash)
+	require.NoError(t, os.WriteFile(filepath.Join(prot, ".goshs"), []byte(acl), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "secret.txt"), []byte("SECRET"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "blocked.txt"), []byte("BLOCKED"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "sub", "deep.txt"), []byte("DEEP"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "public.txt"), []byte("PUBLIC"), 0644))
+	return dir
+}
+
+func zipNames(t *testing.T, body []byte) map[string]string {
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	out := map[string]string{}
+	for _, f := range zr.File {
+		rc, err := f.Open()
+		require.NoError(t, err)
+		b, _ := io.ReadAll(rc)
+		rc.Close()
+		out[f.Name] = string(b)
+	}
+	return out
+}
+
+func TestBulkDownload_ACL(t *testing.T) {
+	dir := setupBulkACL(t)
+	fs, _ := newTestFileServer(t, dir)
+
+	cases := []struct {
+		url    string
+		auth   bool
+		status int
+	}{
+		{"/?bulk&file=/protected/secret.txt", false, http.StatusUnauthorized},
+		{"/?bulk&file=/protected/sub/deep.txt", false, http.StatusUnauthorized},
+		{"/?bulk&file=/protected", false, http.StatusUnauthorized},
+		{"/?bulk&file=/public.txt&file=/protected/secret.txt", false, http.StatusUnauthorized},
+		{"/?bulk&file=/protected/blocked.txt", true, http.StatusNotFound},
+		{"/?bulk&file=/protected/.goshs", true, http.StatusNotFound},
+		{"/?bulk&file=/protected/secret.txt", true, http.StatusOK},
+	}
+	for _, c := range cases {
+		r := httptest.NewRequest(http.MethodGet, c.url, nil)
+		if c.auth {
+			r.SetBasicAuth("admin", "admin")
+		}
+		w := httptest.NewRecorder()
+		fs.bulkDownload(w, r)
+		require.Equal(t, c.status, w.Code, c.url)
+		require.NotContains(t, w.Body.String(), "BLOCKED", c.url)
+		if c.status != http.StatusOK {
+			require.NotContains(t, w.Body.String(), "SECRET", c.url)
+		}
+	}
+}
+
+func TestBulkDownload_RootWalkSkipsProtected(t *testing.T) {
+	dir := setupBulkACL(t)
+	fs, _ := newTestFileServer(t, dir)
+
+	// Unauthenticated zip of the webroot must not include protected content
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/", nil)
+	w := httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	names := zipNames(t, w.Body.Bytes())
+	require.Contains(t, names, "public.txt")
+	for n := range names {
+		require.NotContains(t, n, "protected", n)
+	}
+
+	// Authenticated: protected content included, but never blocked files or .goshs
+	r = httptest.NewRequest(http.MethodGet, "/?bulk&file=/", nil)
+	r.SetBasicAuth("admin", "admin")
+	w = httptest.NewRecorder()
+	fs.bulkDownload(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	names = zipNames(t, w.Body.Bytes())
+	require.Equal(t, "SECRET", names["protected/secret.txt"])
+	require.Equal(t, "DEEP", names["protected/sub/deep.txt"])
+	require.NotContains(t, names, "protected/blocked.txt")
+	require.NotContains(t, names, "protected/.goshs")
+}
