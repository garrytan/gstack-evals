--- a/cipher/cbc_hmac_test.go
+++ b/cipher/cbc_hmac_test.go
@@ -528,3 +528,23 @@ func BenchmarkDecryptAES256_CBCHMAC_1MB(b *testing.B) {
 func BenchmarkDecryptAES256_CBCHMAC_64MB(b *testing.B) {
 	benchDecryptCBCHMAC(b, 32, 67108864)
 }
+
+func TestOpenEmptyCiphertextWithValidTag(t *testing.T) {
+	key := make([]byte, 32)
+	aead, err := NewCBCHMAC(key, aes.NewCipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := aead.(*cbcAEAD)
+	nonce := make([]byte, 16)
+	tag := ctx.computeAuthTag(nil, nonce, nil)
+	if _, err := aead.Open(nil, nonce, tag, nil); err == nil {
+		t.Error("expected error for empty ciphertext")
+	}
+	if _, err := aead.Open(nil, make([]byte, 3), tag, nil); err == nil {
+		t.Error("expected error for bad nonce")
+	}
+	if _, err := unpadBuffer([]byte{}, 16); err == nil {
+		t.Error("expected error for empty buffer")
+	}
+}
