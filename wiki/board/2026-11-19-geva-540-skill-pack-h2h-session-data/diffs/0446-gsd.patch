@@ -155,7 +155,23 @@ public class TextProcessor {
     }
 
     private static boolean areNeighborsTextChunks(TextChunk firstTextChunk, TextChunk secondTextChunk) {
+        double gap = secondTextChunk.getTextStart() - firstTextChunk.getTextEnd();
+        // Chunks are merged without inserting a space, so a gap wide enough to be a word
+        // separator must never be merged here. The bounding box height can be much larger
+        // than the font size (fonts with tall ascent/descent), so the height-based epsilon
+        // alone may swallow inter-word gaps (see TextLineProcessor space detection).
+        if (gap > getWordSpaceThreshold(firstTextChunk, secondTextChunk)) {
+            return false;
+        }
         return NodeUtils.areCloseNumbers(firstTextChunk.getTextEnd(), secondTextChunk.getTextStart(),
             NEIGHBORS_TEXT_CHUNKS_EPSILON * firstTextChunk.getBoundingBox().getHeight());
     }
+
+    private static double getWordSpaceThreshold(TextChunk firstTextChunk, TextChunk secondTextChunk) {
+        double fontSize = Math.max(firstTextChunk.getFontSize(), secondTextChunk.getFontSize());
+        if (!(fontSize > 0)) {
+            return Double.MAX_VALUE;
+        }
+        return fontSize * TextChunkUtils.TEXT_LINE_SPACE_RATIO;
+    }
 }
