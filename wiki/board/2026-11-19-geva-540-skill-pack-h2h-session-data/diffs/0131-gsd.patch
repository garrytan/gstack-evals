+    #[tokio::test]
+    async fn navigation_prunes_cleared_execution_contexts() {
+        // Navigation emits Runtime.executionContextsCleared, so ids advertised
+        // before it must stop validating and the set must not grow per nav.
+        let mut ctx = CdpContext::new();
+        let page_id = ctx.create_page();
+        let session_id = Some(format!("{}-session", page_id));
+        ctx.sessions.insert(session_id.clone().unwrap(), page_id.clone());
+
+        let params = json!({ "url": "data:text/html,<p>a</p>", "waitUntil": "load" });
+        let mut prev_isolated: Vec<i64> = Vec::new();
+        for _ in 0..5 {
+            ctx.pending_events.clear();
+            handle("navigate", &params, &mut ctx, &session_id)
+                .await
+                .expect("navigate should succeed");
+            let live: Vec<i64> = ctx
+                .pending_events
+                .iter()
+                .filter(|e| e.method == "Runtime.executionContextCreated")
+                .filter_map(|e| e.params["context"]["id"].as_i64())
+                .collect();
+            for id in &live {
+                assert!(ctx.valid_context_ids.contains(id), "live ctx {id} must validate");
+            }
+            for id in &prev_isolated {
+                assert!(!ctx.valid_context_ids.contains(id), "cleared ctx {id} must not validate");
+                let err = crate::domains::runtime::handle(
+                    "evaluate",
+                    &json!({ "expression": "1", "contextId": id }),
+                    &mut ctx,
+                    &session_id,
+                )
+                .await
+                .expect_err("stale contextId must be rejected");
+                assert!(err.contains("Cannot find context with specified id"), "{err}");
+            }
+            assert_eq!(ctx.valid_context_ids.len(), live.len(), "set must stay bounded");
+            prev_isolated = live.into_iter().filter(|id| *id != 2).collect();
+        }
+
+        // Runtime.enable re-advertises context 1, which must validate again.
+        crate::domains::runtime::handle("enable", &json!({}), &mut ctx, &session_id)
+            .await
+            .expect("enable");
+        assert!(ctx.valid_context_ids.contains(&1));
+    }
 }
