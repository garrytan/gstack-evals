+    /// Drop every execution context id previously advertised and keep only
+    /// the default-frame context (`2`) that navigation re-emits. Called when
+    /// navigation emits `Runtime.executionContextsCleared`, so contexts the
+    /// client was told are gone stop validating in
+    /// `Runtime.{evaluate,callFunctionOn}` and the set stays bounded on
+    /// long-lived connections. Freshly minted isolated-world ids are added
+    /// back via [`Self::next_isolated_context`]; `Runtime.enable` re-registers
+    /// `1` when it re-advertises it.
+    pub fn clear_execution_contexts(&mut self) {
+        self.valid_context_ids.clear();
+        self.valid_context_ids.insert(2);
+    }
