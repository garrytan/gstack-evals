+    static final class BinaryTypesTest extends RowCompactedSerializerTest {
+        public BinaryTypesTest() {
+            super(getRowSerializer(), getData());
+        }
+
+        private static InternalRow[] getData() {
+            return new GenericRow[] {
+                GenericRow.of(null, null),
+                GenericRow.of(new byte[] {1, 2}, new byte[] {3}),
+                GenericRow.of(new byte[] {(byte) 0xFF}, new byte[0])
+            };
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(
+                    RowType.of(DataTypes.BINARY(2), DataTypes.VARBINARY(10)));
+        }
+
+        @Test
+        public void testSliceComparatorWithBinaryTypes() {
+            RowCompactedSerializer serializer = getRowSerializer();
+            Comparator<MemorySlice> comparator = serializer.createSliceComparator();
+            byte[][][] ordered = {
+                {new byte[] {1, 2}, new byte[0]},
+                {new byte[] {1, 2}, new byte[] {1}},
+                {new byte[] {1, 2}, new byte[] {1, 0}},
+                {new byte[] {1, 3}, new byte[] {0}},
+                {new byte[] {(byte) 0x80, 0}, new byte[] {0}},
+                {new byte[] {(byte) 0xFF, 0}, new byte[] {0}}
+            };
+            for (int i = 0; i < ordered.length; i++) {
+                for (int j = 0; j < ordered.length; j++) {
+                    MemorySlice s1 =
+                            MemorySlice.wrap(
+                                    serializer.serializeToBytes(
+                                            GenericRow.of(ordered[i][0], ordered[i][1])));
+                    MemorySlice s2 =
+                            MemorySlice.wrap(
+                                    serializer.serializeToBytes(
+                                            GenericRow.of(ordered[j][0], ordered[j][1])));
+                    assertThat(Integer.signum(comparator.compare(s1, s2)))
+                            .isEqualTo(Integer.compare(i, j));
+                }
+            }
+        }
+    }
