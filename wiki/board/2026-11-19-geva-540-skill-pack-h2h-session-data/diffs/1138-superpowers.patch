diff --git a/internal/openchoreo-api/api/handlers/exec.go b/internal/openchoreo-api/api/handlers/exec.go
index 64ec651..54961ec 100644
--- a/internal/openchoreo-api/api/handlers/exec.go
+++ b/internal/openchoreo-api/api/handlers/exec.go
@@ -78,6 +78,33 @@ func (h *ExecHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
 	logger := h.logger.With("namespace", namespace, "component", componentName)
 	logger.Info("Exec request received", "env", envName, "pod", podName, "container", container)
 
+	// Resolve the target component first and authorize against its real owning
+	// project. The caller-supplied `project` query parameter must never be trusted
+	// for authorization, otherwise a grant on one project could be used to exec
+	// into components owned by another project in the same namespace.
+	comp := &openchoreov1alpha1.Component{}
+	if err := h.k8sClient.Get(ctx, client.ObjectKey{Namespace: namespace, Name: componentName}, comp); err != nil {
+		if apierrors.IsNotFound(err) {
+			http.Error(w, fmt.Sprintf("component %q not found in namespace %q", componentName, namespace), http.StatusNotFound)
+			return
+		}
+		logger.Error("Failed to look up component for exec", "error", err)
+		http.Error(w, "failed to look up component", http.StatusServiceUnavailable)
+		return
+	}
+	ownerProject := comp.Spec.Owner.ProjectName
+	if ownerProject == "" {
+		logger.Error("Component has no owning project")
+		http.Error(w, fmt.Sprintf("component %q has no owning project", componentName), http.StatusBadRequest)
+		return
+	}
+	if project != "" && project != ownerProject {
+		logger.Warn("Exec request project does not match component owner", "requestedProject", project)
+		http.Error(w, fmt.Sprintf("component %q not found in project %q", componentName, project), http.StatusNotFound)
+		return
+	}
+	project = ownerProject
+
 	// Resolve the target environment before authorizing so per-environment exec
 	// conditions are evaluated against it (`env` may be omitted by the client).
 	effectiveEnv, err := h.resolveEnvName(ctx, namespace, project, envName)
