+	if component != "" {
+		comp := &openchoreov1alpha1.Component{}
+		if err := h.k8sClient.Get(ctx, client.ObjectKey{Namespace: namespace, Name: component}, comp); err != nil {
+			if apierrors.IsNotFound(err) {
+				http.Error(w, fmt.Sprintf("component %q not found in namespace %q", component, namespace), http.StatusNotFound)
+				return
+			}
+			logger.Error("Failed to look up component for wirelogs", "error", err)
+			http.Error(w, "failed to look up component", http.StatusServiceUnavailable)
+			return
+		}
+		if comp.Spec.Owner.ProjectName == "" || comp.Spec.Owner.ProjectName != project {
+			logger.Warn("Wirelogs request project does not match component owner",
+				"ownerProject", comp.Spec.Owner.ProjectName)
+			http.Error(w, fmt.Sprintf("component %q not found in project %q", component, project), http.StatusNotFound)
+			return
+		}
+		project = comp.Spec.Owner.ProjectName
+	}
+
 	if err := h.authzChecker.Check(ctx, wirelogsCheckRequest(namespace, environment, project, component)); err != nil {
 		if errors.Is(err, svcpkg.ErrForbidden) {
 			http.Error(w, "you do not have permission to view wirelogs for this scope", http.StatusForbidden)
