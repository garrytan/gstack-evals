+"  command = unused\n"
+"rule d\n"
+"  command = unused\n"
+"  depfile = $out.d\n"
+"build stamp: r || stamp.dd\n"
+"  dyndep = stamp.dd\n"
+"build stamp.dd: r\n"
+"build copy: d || stamp\n"
+  );
+  fs_.Create("stamp.dd",
+"ninja_dyndep_version = 1\n"
+"build stamp | other: dyndep\n"
+  );
+  fs_.Create("other", "");
+  fs_.Create("copy.d", "copy: other\n");
+  fs_.Create("copy", "");
+
+  string err;
+  EXPECT_TRUE(scan_.RecomputeDirty(GetNode("copy"), NULL, &err));
+  ASSERT_EQ("", err);
+
+  EXPECT_EQ(GetNode("stamp")->in_edge(), GetNode("other")->in_edge());
+  EXPECT_TRUE(GetNode("stamp")->dirty());
+  EXPECT_TRUE(GetNode("other")->dirty());
+  EXPECT_TRUE(GetNode("copy")->dirty());
+}
