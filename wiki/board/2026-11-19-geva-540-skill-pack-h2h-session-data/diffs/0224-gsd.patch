+    #region Tabs
+
+    private const int TAB_COUNT = 4;
+
+    private static string MakeText (string prefix, int lines)
+    {
+        StringBuilder sb = new ();
+
+        for (var i = 1; i <= lines; i++)
+        {
+            sb.Append ($"{prefix} {i}");
+
+            if (i < lines)
+            {
+                sb.Append ('\n');
+            }
+        }
+
+        return sb.ToString ();
+    }
+
+    private static (View Root, Tabs Tabs, Code [] Codes) BuildTabs (IDriver driver)
+    {
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill () };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        var codes = new Code [TAB_COUNT];
+
+        for (var i = 0; i < TAB_COUNT; i++)
+        {
+            codes [i] = new Code
+            {
+                Title = $"Tab{i + 1}",
+                Text = MakeText ($"Tab{i + 1} line", 50),
+                Language = null,
+                SyntaxHighlighter = null,
+                Width = Dim.Fill (),
+                Height = Dim.Fill ()
+            };
+            tabs.Add (codes [i]);
+        }
+
+        return (root, tabs, codes);
+    }
