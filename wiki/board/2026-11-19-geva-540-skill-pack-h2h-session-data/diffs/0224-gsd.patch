+    [Fact]
+    public void Tabs_ActiveTabScroll_InactiveTabs_Are_Not_Redrawn ()
+    {
+        IDriver driver = CreateTestDriver (60, 20);
+        (View root, Tabs tabs, Code [] codes) = BuildTabs (driver);
+        root.Layout ();
+        DrawRoot (root);
+
+        Code active = (Code)tabs.Value!;
+        Assert.Same (codes [0], active);
+
+        Counts tabsCounts = Track (tabs);
+        var codeCounts = new Counts [TAB_COUNT];
+        var borderDraws = new int [TAB_COUNT];
+
+        for (var i = 0; i < TAB_COUNT; i++)
+        {
+            codeCounts [i] = Track (codes [i]);
+            int index = i;
+            codes [i].Border.View!.DrawComplete += (_, _) => borderDraws [index]++;
+        }
+
+        for (var y = 1; y <= 5; y++)
+        {
+            active.Viewport = active.Viewport with { Y = y };
+            root.Layout ();
+            DrawRoot (root);
+        }
+
+        output.WriteLine ($"tabs: {tabsCounts}");
+
+        for (var i = 0; i < TAB_COUNT; i++)
+        {
+            output.WriteLine ($"code{i + 1}: {codeCounts [i]} border={borderDraws [i]}");
+        }
+
+        // The Tabs container is entered only because the active tab is dirty.
+        Assert.Equal (0, tabsCounts.ClearedViewport);
+        Assert.Equal (0, tabsCounts.DrawingText);
+        Assert.Equal (0, tabsCounts.DrawingContent);
+
+        Assert.Equal (5, codeCounts [0].DrawingText);
+
+        // Inactive tab pages are not redrawn: no viewport clear, no text/content. (Their borders do participate so that
+        // their lines are re-merged into the Tabs LineCanvas and auto-joined intersections are preserved.)
+        for (var i = 1; i < TAB_COUNT; i++)
+        {
+            Assert.Equal (0, codeCounts [i].ClearedViewport);
+            Assert.Equal (0, codeCounts [i].DrawingText);
+            Assert.Equal (0, codeCounts [i].DrawingContent);
+        }
+
+        AssertIncrementalMatchesFullRedraw (driver, root);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
