index 0000000..e5d5922
--- /dev/null
+++ b/Tests/UnitTestsParallelizable/ViewBase/Draw/ChildOnlyRedrawTests.cs
@@ -0,0 +1,779 @@
+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     Regression tests for "child-only redraws must not escalate into full parent redraws" (split from #4973).
+/// </summary>
+/// <remarks>
+///     <para>
+///         A View that enters <see cref="View.Draw(DrawContext?)"/> only because a SubView is dirty
+///         (<c>SubViewNeedsDraw</c>) must not clear its own Viewport or redraw its own Text/Content. Doing so fans redraw
+///         work out to every overlapped SubView (via <see cref="View.ClearViewport"/> -> <see cref="View.SetNeedsDraw()"/>).
+///     </para>
+///     <para>
+///         Each test validates both event counters (behavior) and the final rendered output. Rendered output is
+///         compared against a forced full redraw (or a freshly built scene) using both <see cref="IDriver.ToString"/>
+///         and <see cref="IDriver.ToAnsi"/> (which includes attributes, e.g. shadow dimming), and at the
+///         <see cref="IOutput"/> level, so the tests do not rely solely on <c>Driver.Contents</c> text.
+///     </para>
+/// </remarks>
+[Trait ("Category", "Output")]
+public class ChildOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    private sealed class Counts
+    {
+        public int ClearedViewport;
+        public int DrawingText;
+        public int DrawingContent;
+
+        public void Reset ()
+        {
+            ClearedViewport = 0;
+            DrawingText = 0;
+            DrawingContent = 0;
+        }
+
+        public override string ToString () => $"cleared={ClearedViewport} text={DrawingText} content={DrawingContent}";
+    }
+
+    private static Counts Track (View view)
+    {
+        Counts counts = new ();
+        view.ClearedViewport += (_, _) => counts.ClearedViewport++;
+        view.DrawingText += (_, _) => counts.DrawingText++;
+        view.DrawingContent += (_, _) => counts.DrawingContent++;
+
+        return counts;
+    }
+
+    /// <summary>
+    ///     Draws via the static peer-draw path, mirroring what the application does each frame
+    ///     (see <c>ApplicationImpl.LayoutAndDraw</c>): reset the clip to the screen, draw (which includes shadow
+    ///     margins), and reset the clip again.
+    /// </summary>
+    private static void DrawRoot (View root, bool force = false)
+    {
+        IDriver driver = root.Driver!;
+        Rectangle screen = new (Point.Empty, driver.Screen.Size);
+        driver.Clip = new Region (screen);
+        View.Draw ([root], force);
+        driver.Clip = new Region (screen);
+    }
+
+    /// <summary>
+    ///     Asserts that what an incremental draw produced is identical to what a forced full redraw produces, both as
+    ///     text and as ANSI (attributes included), and that the <see cref="IOutput"/> layer emits the same final buffer.
+    /// </summary>
+    private void AssertIncrementalMatchesFullRedraw (IDriver driver, View root)
+    {
+        string incrementalText = driver.ToString ();
+        string incrementalAnsi = driver.ToAnsi ();
+
+        IOutput ioutput = driver.GetOutput ();
+        IOutputBuffer buffer = driver.GetOutputBuffer ();
+        ioutput.Write (buffer);
+        string incrementalOutputAnsi = ioutput.ToAnsi (buffer);
+
+        root.Layout ();
+        DrawRoot (root, true);
+
+        string fullText = driver.ToString ();
+        string fullAnsi = driver.ToAnsi ();
+        ioutput.Write (buffer);
+        string fullOutputAnsi = ioutput.ToAnsi (buffer);
+
+        output.WriteLine ("Incremental:\n" + incrementalText);
+        output.WriteLine ("Full:\n" + fullText);
+
+        Assert.Equal (fullText, incrementalText);
+        Assert.Equal (fullAnsi, incrementalAnsi);
+        Assert.Equal (fullOutputAnsi, incrementalOutputAnsi);
+    }
+
+    private static (View Root, View Parent, View Child) BuildParentChild (IDriver driver)
+    {
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+
+        View parent = new ()
+        {
+            X = 1,
+            Y = 1,
+            Width = 30,
+            Height = 8,
+            BorderStyle = LineStyle.Single,
+            Text = "Parent text"
+        };
+
+        View child = new ()
+        {
+            X = 2,
+            Y = 2,
+            Width = 12,
+            Height = 3,
+            BorderStyle = LineStyle.Single,
+            Text = "Child"
+        };
+
+        parent.Add (child);
+        root.Add (parent);
+
+        return (root, parent, child);
+    }
+
+    [Fact]
+    public void ChildOnlyDirty_Parent_DoesNotClearViewport ()
+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        (View root, View parent, View child) = BuildParentChild (driver);
+        root.Layout ();
+        DrawRoot (root);
+
+        Counts parentCounts = Track (parent);
+        Counts childCounts = Track (child);
+
+        child.SetNeedsDraw ();
+        Assert.False (parent.NeedsDraw);
+        Assert.True (parent.SubViewNeedsDraw);
+
+        DrawRoot (root);
+
+        output.WriteLine ($"parent: {parentCounts}; child: {childCounts}");
+        Assert.Equal (0, parentCounts.ClearedViewport);
+        Assert.Equal (1, childCounts.ClearedViewport);
+
+        AssertIncrementalMatchesFullRedraw (driver, root);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnlyDirty_Parent_DoesNotRedraw_Text_Or_Content ()
+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        (View root, View parent, View child) = BuildParentChild (driver);
+        root.Layout ();
+        DrawRoot (root);
+
+        Counts parentCounts = Track (parent);
+        Counts childCounts = Track (child);
+
+        child.Text = "Changed";
+        root.Layout ();
+        DrawRoot (root);
+
+        output.WriteLine ($"parent: {parentCounts}; child: {childCounts}");
+        Assert.Equal (0, parentCounts.DrawingText);
+        Assert.Equal (0, parentCounts.DrawingContent);
+        Assert.Equal (1, childCounts.DrawingText);
+        Assert.Equal (1, childCounts.DrawingContent);
+
+        AssertIncrementalMatchesFullRedraw (driver, root);
+
+        root.Dispose ();
+        driver.Dispose ();
+    }
+
+    [Fact]
+    public void ParentDirty_Parent_Still_Clears_And_Redraws ()
+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        (View root, View parent, View child) = BuildParentChild (driver);
+        root.Layout ();
+        DrawRoot (root);
+
+        Counts parentCounts = Track (parent);
+        Counts childCounts = Track (child);
+
+        parent.Text = "Other";
+        root.Layout ();
+        DrawRoot (root);
+
+        Assert.Equal (1, parentCounts.ClearedViewport);
+        Assert.Equal (1, parentCounts.DrawingText);
+        Assert.Equal (1, parentCounts.DrawingContent);
+
+        // Clearing the parent viewport requires the child to be redrawn.
