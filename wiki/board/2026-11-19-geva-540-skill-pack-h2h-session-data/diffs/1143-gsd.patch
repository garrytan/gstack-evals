+// Authorization must be evaluated against the component's real owning project,
+// not the caller-supplied `project` query parameter.
+func TestExecHandler_AuthzUsesOwningProject_WhenProjectOmitted(t *testing.T) {
+	pdp := testutil.AllowPDP()
+	h := newExecHandler(t, pdp, execTestComponent("payments", "finance"))
+
+	req := httptest.NewRequest(http.MethodGet,
+		"/exec/namespaces/default/components/payments?env=development",
+		nil).WithContext(testutil.AuthzContext())
+	h.ServeHTTP(httptest.NewRecorder(), req)
+
+	require.Len(t, pdp.Captured, 1)
+	testutil.RequireEvalRequest(t, pdp.Captured[0],
+		authz.ActionExecComponent, "component", "payments",
+		authz.ResourceHierarchy{Namespace: "default", Project: "finance", Component: "payments"})
+}
+
+func TestExecHandler_RejectsComponentFromOtherProject(t *testing.T) {
+	pdp := testutil.AllowPDP()
+	h := newExecHandler(t, pdp, execTestComponent("payments", "finance"))
+
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet,
+		"/exec/namespaces/default/components/payments?env=development&project=default",
+		nil).WithContext(testutil.AuthzContext())
+	h.ServeHTTP(rec, req)
+
+	require.Equal(t, http.StatusNotFound, rec.Code)
+	require.Empty(t, pdp.Captured, "authz must not be evaluated against a caller-supplied foreign project")
+}
+
+func TestExecHandler_ComponentNotFound(t *testing.T) {
+	pdp := testutil.AllowPDP()
+	h := newExecHandler(t, pdp)
+
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet,
+		"/exec/namespaces/default/components/missing?env=development",
+		nil).WithContext(testutil.AuthzContext())
+	h.ServeHTTP(rec, req)
+
+	require.Equal(t, http.StatusNotFound, rec.Code)
+	require.Empty(t, pdp.Captured)
+}
