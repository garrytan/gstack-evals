+    [Test]
+    public void DedicatedThreadPoolThreadsStopOnShutdown()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread workerThread = null;
+        var taskDone = new ManualResetEventSlim(false);
+
+        threadPool.RunInThread(async () =>
+        {
+            workerThread = Thread.CurrentThread;
+            // continuation runs on the dedicated scheduler
+            await Task.Delay(TimeSpan.FromMilliseconds(100));
+            taskDone.Set();
+        });
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        Assert.That(taskDone.IsSet, Is.True);
+        Assert.That(workerThread, Is.Not.Null);
+        Assert.That(workerThread.Join(TimeSpan.FromSeconds(5)), Is.True, "dedicated thread should stop after shutdown");
+    }
+
+    [Test]
+    public void DedicatedThreadPoolThreadsStopOnShutdownWithoutWaiting()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread workerThread = null;
+        var started = new ManualResetEventSlim(false);
+        var taskDone = new ManualResetEventSlim(false);
+
+        threadPool.RunInThread(async () =>
+        {
+            workerThread = Thread.CurrentThread;
+            started.Set();
+            await Task.Delay(TimeSpan.FromMilliseconds(200));
+            taskDone.Set();
+        });
+
+        Assert.That(started.Wait(TimeSpan.FromSeconds(5)), Is.True);
+        threadPool.Shutdown(waitForJobsToComplete: false);
+
+        Assert.That(taskDone.Wait(TimeSpan.FromSeconds(5)), Is.True, "running job should still complete");
+        Assert.That(workerThread.Join(TimeSpan.FromSeconds(5)), Is.True, "dedicated thread should stop after shutdown");
+    }
+
