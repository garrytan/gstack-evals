+
+func TestXORMappedAddress_GetFrom_ShortValue(t *testing.T) {
+	for _, value := range [][]byte{{}, {0x00}, {0x00, 0x01}, {0x00, 0x01, 0x00}, {0x00, 0x01, 0x00, 0x00}} {
+		m := New()
+		m.Add(AttrXORMappedAddress, value)
+		m.WriteHeader()
+		addr := new(XORMappedAddress)
+		if err := addr.GetFrom(m); !errors.Is(err, io.ErrUnexpectedEOF) {
+			t.Errorf("len %d: expected ErrUnexpectedEOF, got %v", len(value), err)
+		}
+	}
