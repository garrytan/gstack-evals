+func TestTraversalReferenceLimits(t *testing.T) {
+	root := newDesc("root")
+	dup := newDesc("dup")
+	fanoutChildren := make([]ocispec.Descriptor, maxReferences)
+	for i := range fanoutChildren {
+		fanoutChildren[i] = dup
+	}
+	var dupVisits atomic.Int32
+	fanout := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		if desc.Digest == root.Digest {
+			return fanoutChildren, nil
+		}
+		dupVisits.Add(1)
+		return nil, nil
+	})
+
+	a, b := newDesc("a"), newDesc("b")
+	cycle := map[digest.Digest][]ocispec.Descriptor{a.Digest: {b}, b.Digest: {a}}
+	cyclic := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		return cycle[desc.Digest], nil
+	})
+
+	// Each level of this diamond chain names the next level twice, so an
+	// unbounded traversal visits 2^depth descriptors.
+	const depth = 64
+	levels := make([]ocispec.Descriptor, depth+1)
+	for i := range levels {
+		levels[i] = newDesc(fmt.Sprintf("level-%d", i))
+	}
+	next := make(map[digest.Digest][]ocispec.Descriptor, depth)
+	for i := 0; i < depth; i++ {
+		next[levels[i].Digest] = []ocispec.Descriptor{levels[i+1], levels[i+1]}
+	}
+	diamond := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		return next[desc.Digest], nil
+	})
+
+	for _, tt := range traversals {
+		t.Run(tt.name, func(t *testing.T) {
+			dupVisits.Store(0)
+			require.ErrorIs(t, tt.dispatch(context.Background(), fanout, nil, root), errdefs.ErrResourceExhausted)
+			assert.Equal(t, int32(0), dupVisits.Load(), "children of an over-limit slice must not be visited")
+			require.ErrorIs(t, tt.dispatch(context.Background(), cyclic, nil, a), errdefs.ErrResourceExhausted)
+			require.ErrorIs(t, tt.dispatch(context.Background(), diamond, nil, levels[0]), errdefs.ErrResourceExhausted)
+		})
+	}
+}
+
+func TestWalkAcceptsReferencesAtLimit(t *testing.T) {
+	root := newDesc("root")
+	children := make([]ocispec.Descriptor, maxReferences-1)
+	for i := range children {
+		children[i] = newDesc(fmt.Sprintf("child-%d", i))
+	}
+	var visits int
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		visits++
+		if desc.Digest == root.Digest {
+			return children, nil
+		}
+		return nil, nil
+	})
+	require.NoError(t, Walk(context.Background(), handler, root))
+	assert.Equal(t, maxReferences, visits)
+}
