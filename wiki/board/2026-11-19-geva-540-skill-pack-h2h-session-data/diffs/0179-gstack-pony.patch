+    // AIFF 8-bit PCM is signed (unlike WAV, which is unsigned).
+    [Test]
+    [Category("UnitTest")]
+    public void EightBitAiffSamplesAreReadAsSigned()
+    {
+        byte[] payload = new byte[]
+        {
+            0x46,0x4f,0x52,0x4d, 0x00,0x00,0x00,0x32, 0x41,0x49,0x46,0x46, // FORM size=50 AIFF
+            0x43,0x4f,0x4d,0x4d, 0x00,0x00,0x00,0x12, // COMM size=18
+            0x00,0x01, 0x00,0x00,0x00,0x04, 0x00,0x08, // 1 channel, 4 frames, 8 bits
+            0x40,0x0e,0xac,0x44,0x00,0x00,0x00,0x00,0x00,0x00, // 44100 Hz
+            0x53,0x53,0x4e,0x44, 0x00,0x00,0x00,0x0c, 0x00,0x00,0x00,0x00, 0x00,0x00,0x00,0x00, // SSND
+            0x0a, 0x80, 0x83, 0x7f
+        };
+
+        using var reader = new AiffFileReader(new MemoryStream(payload));
+        var samples = new float[4];
+        Assert.That(reader.ToSampleProvider().Read(samples), Is.EqualTo(4));
+        Assert.That(samples, Is.EqualTo(new[] { 10 / 128f, -1f, -125 / 128f, 127 / 128f }));
+    }
+
+    [Test]
+    [Category("UnitTest")]
+    public void EightBitAiffRoundTripsThroughWriter()
+    {
+        byte[] unsignedPcm = { 0x00, 0x7f, 0x80, 0xff };
+        var ms = new MemoryStream();
+        using (var writer = new AiffFileWriter(new NAudio.Utils.IgnoreDisposeStream(ms), new WaveFormat(44100, 8, 1)))
+        {
+            writer.Write(unsignedPcm, 0, unsignedPcm.Length);
+        }
+        ms.Position = 0;
+        using var reader = new AiffFileReader(ms);
+        var read = new byte[4];
+        Assert.That(reader.Read(read, 0, 4), Is.EqualTo(4));
+        Assert.That(read, Is.EqualTo(unsignedPcm));
+    }
