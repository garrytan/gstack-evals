+
+func TestFromLogEvent_GroupedFragments(t *testing.T) {
+	logEvent := container.LogEvent{
+		Type: container.LogTypeGroup,
+		Message: []container.LogFragment{
+			{Message: "\x1b[32mINFO\x1b[0m 1 --- [backend] Sincronizado lote de 1000 registros (Total: 710000)"},
+			{Message: "INFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 711000)"},
+		},
+	}
+
+	notificationLog := FromLogEvent(logEvent)
+	msg, ok := notificationLog.Message.(string)
+	require.True(t, ok, "grouped message should be joined into a string")
+	assert.Equal(t, "INFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 710000)\nINFO 1 --- [backend] Sincronizado lote de 1000 registros (Total: 711000)", msg)
+
+	tests := []struct {
+		expression string
+		want       bool
+	}{
+		{`message contains "registros"`, true},
+		{`message contains "711000"`, true},
+		{`message contains "error"`, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.expression, func(t *testing.T) {
+			program, err := expr.Compile(tt.expression, expr.Env(types.NotificationLog{}), expr.AsBool())
+			require.NoError(t, err)
+			sub := &Subscription{LogProgram: program}
+			assert.Equal(t, tt.want, sub.MatchesLog(notificationLog))
+		})
+	}
+}
