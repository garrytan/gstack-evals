+// bindgen-flags: --default-alias-style=new_type
+
+// Fake stdint.h
+typedef __UINT32_TYPE__ uint32_t;
+
+#define FooBar 0x00000000
+#define Negative -1
+#define Float 2.5
+#define Character 'c'
+
+static const unsigned int Builtin_A = 1;
+static const uint32_t Std_A = 2;
+
+typedef unsigned int MyInt;
+static const MyInt MyInt_A = 3;
