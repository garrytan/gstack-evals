+// validateFileName ensures the file name doesn't contain path separators or
+// traversal elements so that it cannot escape the destination directory.
+func validateFileName(fileName string) error {
+	if fileName == "" || fileName == "." || fileName == ".." {
+		return xerrors.Errorf("%q is not a valid file name", fileName)
+	}
+	if strings.ContainsAny(fileName, `/\`) || strings.ContainsRune(fileName, 0) ||
+		filepath.Base(fileName) != fileName || filepath.IsAbs(fileName) || filepath.VolumeName(fileName) != "" {
+		return xerrors.Errorf("%q must be a plain file name without path elements", fileName)
+	}
+	return nil
+}
