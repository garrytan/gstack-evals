+        BlockAlignedWaveStream inputStream = new BlockAlignedWaveStream(726, 80000);
+        BlockAlignReductionStream blockStream = new BlockAlignReductionStream(inputStream);
+
+        Assert.Throws<ArgumentException>(() => blockStream.Position = 1001);
+    }
+
+    [Test]
+    public void CanReadMoreThanInternalBufferSizeInOneRead()
+    {
+        // Internal circular buffer is 4 seconds (4 * 16000 = 64000 bytes).
+        // A single read bigger than that (e.g. .NET's Stream.CopyTo, which on
+        // modern .NET uses a 128KB pooled buffer) must not drop audio.
+        const int length = 16000 * 16; // 16 seconds
+        BlockAlignedWaveStream inputStream = new BlockAlignedWaveStream(726, length);
+        BlockAlignReductionStream blockStream = new BlockAlignReductionStream(inputStream);
+
+        byte[] readBuffer = new byte[65536];
+        int read = blockStream.Read(readBuffer, 0, readBuffer.Length);
+        Assert.That(read, Is.EqualTo(readBuffer.Length), "bytes read 1");
+        Assert.That(blockStream.Position, Is.EqualTo(readBuffer.Length), "position 1");
+        CheckReadBuffer(readBuffer, read, 0);
+
+        read = blockStream.Read(readBuffer, 0, readBuffer.Length);
+        Assert.That(read, Is.EqualTo(readBuffer.Length), "bytes read 2");
+        CheckReadBuffer(readBuffer, read, 65536);
+    }
+
+    [Test]
+    public void CopyToReadsEntireStream()
+    {
+        const int length = 16000 * 16; // 16 seconds
+        BlockAlignedWaveStream inputStream = new BlockAlignedWaveStream(726, length);
