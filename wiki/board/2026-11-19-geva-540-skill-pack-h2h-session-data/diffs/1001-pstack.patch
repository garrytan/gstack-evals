diff --git a/src/rules_inline/html_inline.ts b/src/rules_inline/html_inline.ts
index 5c2faef..54e31b0 100644
--- a/src/rules_inline/html_inline.ts
+++ b/src/rules_inline/html_inline.ts
@@ -16,6 +16,28 @@ function isLetter (ch: number) {
   return (lc >= 0x61/* a */) && (lc <= 0x7a/* z */)
 }
 
+// Comments, processing instructions, declarations and CDATA end at the first
+// terminator after the opener, so a cached forward search decides whether
+// the regexp can match. Without it, unterminated openers rescan the rest of
+// the input each time, which is quadratic.
+function terminatorOf (src: string, pos: number): [string, number] | null {
+  if (src.startsWith('<?', pos)) return ['?>', 2]
+  if (src.startsWith('<!--', pos)) return ['-->', 2]
+  if (src.startsWith('<![CDATA[', pos)) return [']]>', 9]
+  if (src.charCodeAt(pos + 1) === 0x21/* ! */ && isLetter(src.charCodeAt(pos + 2))) return ['>', 3]
+  return null
+}
+
+function findCached (state: StateInline, terminator: string, start: number) {
+  const cached = state.htmlTerminators[terminator]
+  if (cached && cached.from <= start && (cached.at < 0 || cached.at >= start)) {
+    return cached.at
+  }
+  const at = state.src.indexOf(terminator, start)
+  state.htmlTerminators[terminator] = { from: start, at }
+  return at
+}
+
 export default function html_inline (state: StateInline, silent: boolean): boolean {
   if (!state.md.options.html) { return false }
 
