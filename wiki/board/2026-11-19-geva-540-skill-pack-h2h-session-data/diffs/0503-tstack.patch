+    #[tokio::test]
+    async fn test_scan_accepts_empty_bounds() {
+        let object_store: Arc<dyn ObjectStore> = Arc::new(InMemory::new());
+        let kv_store = Db::builder("/tmp/test_scan_empty_bounds", object_store)
+            .with_settings(test_db_options(0, 1024, None))
+            .build()
+            .await
+            .unwrap();
+
+        kv_store.put(b"a", b"v0").await.unwrap();
+        kv_store.put(b"b", b"v1").await.unwrap();
+
+        // An empty start bound sorts before every key, so it behaves like `..`.
+        let empty: &[u8] = b"";
+        let mut iter = kv_store.scan(empty..).await.unwrap();
+        assert_eq!(iter.next().await.unwrap().unwrap().key.as_ref(), b"a");
+        assert_eq!(iter.next().await.unwrap().unwrap().key.as_ref(), b"b");
+        assert_eq!(iter.next().await.unwrap(), None);
+
+        let mut iter = kv_store
+            .scan::<&[u8], _>((std::ops::Bound::Excluded(empty), std::ops::Bound::Excluded(b"b".as_slice())))
+            .await
+            .unwrap();
+        assert_eq!(iter.next().await.unwrap().unwrap().key.as_ref(), b"a");
+        assert_eq!(iter.next().await.unwrap(), None);
+
+        // An empty end bound sorts before every key, so the scan yields nothing.
+        let mut iter = kv_store.scan(..empty).await.unwrap();
+        assert_eq!(iter.next().await.unwrap(), None);
+        let mut iter = kv_store.scan(empty..=empty).await.unwrap();
+        assert_eq!(iter.next().await.unwrap(), None);
+
+        kv_store.close().await.unwrap();
+    }
