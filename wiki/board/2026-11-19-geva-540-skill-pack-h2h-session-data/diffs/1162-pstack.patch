+func TestSymlinkEscape(t *testing.T) {
+	ctx := context.Background()
+	r := fstest.NewRun(t)
+	f := r.Flocal.(*Fs)
+	f.opt.TranslateSymlinks = true
+	modTime := fstest.Time("2002-03-03T04:05:10.123123123Z")
+
+	outside := t.TempDir()
+	victim := filepath.Join(outside, "authorized_keys")
+
+	for _, target := range []string{outside, "../" + filepath.Base(f.root) + "x", "sub/../../x", "a/b/../../../x"} {
+		t.Run(target, func(t *testing.T) {
+			src := object.NewStaticObjectInfo("pwn"+fs.LinkSuffix, modTime, int64(len(target)), true, nil, nil)
+			_, err := r.Flocal.Put(ctx, strings.NewReader(target), src)
+			require.Error(t, err)
+			_, err = os.Lstat(filepath.Join(f.root, "pwn"))
+			assert.True(t, os.IsNotExist(err), "no symlink created")
+		})
+	}
+
+	for _, target := range []string{"file.txt", "sub/../file.txt", "dir/x", "."} {
+		t.Run(target, func(t *testing.T) {
+			src := object.NewStaticObjectInfo("ok"+fs.LinkSuffix, modTime, int64(len(target)), true, nil, nil)
+			_, err := r.Flocal.Put(ctx, strings.NewReader(target), src)
+			require.NoError(t, err)
+			linkText, err := os.Readlink(filepath.Join(f.root, "ok"))
+			require.NoError(t, err)
+			assert.Equal(t, target, linkText)
+		})
+	}
+
+	require.NoError(t, os.Symlink(outside, filepath.Join(f.root, "planted")))
+	src := object.NewStaticObjectInfo("planted/authorized_keys", modTime, 5, true, nil, nil)
+	_, err := r.Flocal.Put(ctx, strings.NewReader("pwned"), src)
+	require.Error(t, err)
+	_, err = os.Stat(victim)
+	assert.True(t, os.IsNotExist(err), "nothing written outside the destination")
+
+	f.opt.LinksAllowUnsafe = true
+	src = object.NewStaticObjectInfo("abs"+fs.LinkSuffix, modTime, int64(len(outside)), true, nil, nil)
+	_, err = r.Flocal.Put(ctx, strings.NewReader(outside), src)
+	require.NoError(t, err)
+	linkText, err := os.Readlink(filepath.Join(f.root, "abs"))
+	require.NoError(t, err)
+	assert.Equal(t, outside, linkText)
+}
