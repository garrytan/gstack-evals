+// checkSymlinkTarget refuses a symlink target that is absolute or
+// would resolve outside f.root when placed at linkPath.
+func (f *Fs) checkSymlinkTarget(linkPath, target string) error {
+	if target == "" {
+		return errors.New("refusing to create symlink with empty target")
+	}
+	if filepath.IsAbs(target) || filepath.VolumeName(target) != "" || os.IsPathSeparator(target[0]) || target[0] == '/' {
+		return fmt.Errorf("refusing to create symlink with absolute target %q (use --local-links-allow-unsafe to override)", target)
+	}
+	resolved := filepath.Join(filepath.Dir(linkPath), target)
+	rel, err := filepath.Rel(f.root, resolved)
+	if err != nil || !filepath.IsLocal(rel) {
+		return fmt.Errorf("refusing to create symlink with target %q outside the destination (use --local-links-allow-unsafe to override)", target)
+	}
+	return nil
+}
+
+// checkNoSymlinkParents refuses a path whose directories below f.root
+// include a symlink, so writes can't be redirected outside f.root.
+func (f *Fs) checkNoSymlinkParents(path string) error {
+	for dir := filepath.Dir(path); len(dir) > len(f.root) && strings.HasPrefix(dir, f.root); dir = filepath.Dir(dir) {
+		fi, err := os.Lstat(dir)
+		if err == nil && fi.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("refusing to write through symlinked directory %q (use --local-links-allow-unsafe to override)", dir)
+		}
+	}
+	return nil
+}
