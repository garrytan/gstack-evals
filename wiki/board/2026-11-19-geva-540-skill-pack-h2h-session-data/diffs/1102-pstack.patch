@@ -0,0 +1,32 @@
+package bolt
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/semaphoreui/semaphore/db"
+)
+
+func TestGetProjectOrGlobalRoleBySlug_ScopedToProject(t *testing.T) {
+	store := CreateTestStore()
+
+	projectA := 1
+	if _, err := store.CreateRole(db.Role{Slug: "lead", Name: "Lead", Permissions: 15, ProjectID: &projectA}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.CreateRole(db.Role{Slug: "viewer", Name: "Viewer", Permissions: 0}); err != nil {
+		t.Fatal(err)
+	}
+
+	if role, err := store.GetProjectOrGlobalRoleBySlug(projectA, "lead"); err != nil || role.Permissions != 15 {
+		t.Fatalf("own project role not resolved: %v %v", role, err)
+	}
+
+	if _, err := store.GetProjectOrGlobalRoleBySlug(2, "lead"); !errors.Is(err, db.ErrNotFound) {
+		t.Fatalf("role from another project leaked: err = %v", err)
+	}
+
+	if _, err := store.GetProjectOrGlobalRoleBySlug(2, "viewer"); err != nil {
+		t.Fatalf("global role not resolved: %v", err)
+	}
+}
