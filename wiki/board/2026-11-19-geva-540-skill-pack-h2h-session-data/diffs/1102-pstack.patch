--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,28 @@
+package db
+
+import "testing"
+
+func TestValidateRole(t *testing.T) {
+	cases := []struct {
+		name    string
+		role    Role
+		wantErr bool
+	}{
+		{"custom role", Role{Slug: "deployer", Name: "Deployer", Permissions: CanRunProjectTasks}, false},
+		{"full custom role", Role{Slug: "lead", Name: "Lead", Permissions: allProjectUserPermissions}, false},
+		{"empty name", Role{Slug: "deployer"}, true},
+		{"empty slug", Role{Name: "Deployer"}, true},
+		{"owner slug", Role{Slug: "owner", Name: "x"}, true},
+		{"manager slug", Role{Slug: "manager", Name: "pwn", Permissions: 15}, true},
+		{"task_runner slug", Role{Slug: "task_runner", Name: "x"}, true},
+		{"guest slug", Role{Slug: "guest", Name: "x"}, true},
+		{"unknown bits", Role{Slug: "deployer", Name: "x", Permissions: 1 << 10}, true},
+		{"negative bits", Role{Slug: "deployer", Name: "x", Permissions: -1}, true},
+	}
+	for _, c := range cases {
+		err := ValidateRole(c.role)
+		if (err != nil) != c.wantErr {
+			t.Errorf("%s: ValidateRole() err = %v, wantErr %v", c.name, err, c.wantErr)
+		}
+	}
+}
