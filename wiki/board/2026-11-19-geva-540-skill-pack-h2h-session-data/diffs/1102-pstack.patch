@@ -0,0 +1,81 @@
+package projects
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/gorilla/mux"
+	"github.com/semaphoreui/semaphore/api/helpers"
+	"github.com/semaphoreui/semaphore/db"
+	"github.com/semaphoreui/semaphore/db/bolt"
+)
+
+func resolvedPermissions(t *testing.T, store db.Store, user *db.User, projectID int) db.ProjectUserPermission {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, "/api/project/"+strconv.Itoa(projectID)+"/role", nil)
+	req = mux.SetURLVars(req, map[string]string{"project_id": strconv.Itoa(projectID)})
+	req = helpers.SetContextValue(req, "store", store)
+	req = helpers.SetContextValue(req, "user", user)
+
+	rec := httptest.NewRecorder()
+	ProjectMiddleware(http.HandlerFunc(GetUserRole)).ServeHTTP(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, body = %s", rec.Code, rec.Body.String())
+	}
+	var body struct {
+		Permissions db.ProjectUserPermission `json:"permissions"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	return body.Permissions
+}
+
+func TestProjectMiddleware_StoredRoleCannotOverrideBuiltInRole(t *testing.T) {
+	store := bolt.CreateTestStore()
+
+	project, err := store.CreateProject(db.Project{Name: "p"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	manager, err := store.CreateUserWithoutPassword(db.User{Username: "mgr", Name: "mgr", Email: "mgr@example.com"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = store.CreateProjectUser(db.ProjectUser{ProjectID: project.ID, UserID: manager.ID, Role: db.ProjectManager}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = store.CreateRole(db.Role{Slug: "manager", Name: "pwn", Permissions: 15, ProjectID: &project.ID}); err != nil {
+		t.Fatal(err)
+	}
+
+	if got := resolvedPermissions(t, store, &manager, project.ID); got != db.ProjectManager.GetPermissions() {
+		t.Fatalf("manager permissions = %d, want %d", got, db.ProjectManager.GetPermissions())
+	}
+}
+
+func TestProjectMiddleware_CustomRoleResolvesFromStore(t *testing.T) {
+	store := bolt.CreateTestStore()
+
+	project, err := store.CreateProject(db.Project{Name: "p"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	user, err := store.CreateUserWithoutPassword(db.User{Username: "dep", Name: "dep", Email: "dep@example.com"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = store.CreateRole(db.Role{Slug: "deployer", Name: "Deployer", Permissions: db.CanRunProjectTasks | db.CanUpdateProject, ProjectID: &project.ID}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = store.CreateProjectUser(db.ProjectUser{ProjectID: project.ID, UserID: user.ID, Role: "deployer"}); err != nil {
+		t.Fatal(err)
+	}
+
+	if got := resolvedPermissions(t, store, &user, project.ID); got != db.CanRunProjectTasks|db.CanUpdateProject {
+		t.Fatalf("custom role permissions = %d", got)
+	}
+}
