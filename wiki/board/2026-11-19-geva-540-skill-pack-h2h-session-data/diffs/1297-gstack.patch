+// isUnsafeSegment reports whether a single path segment could alter the
+// resolved upstream path (dot segments, embedded separators), checking both
+// the raw value and its percent-decoded forms.
+func isUnsafeSegment(seg string) bool {
+	for i := 0; i < 3; i++ {
+		if seg == "." || seg == ".." || strings.ContainsAny(seg, "/\\") {
+			return true
+		}
+		decoded, err := url.PathUnescape(seg)
+		if err != nil {
+			return true
+		}
+		if decoded == seg {
+			return false
+		}
+		seg = decoded
+	}
+	return true
+}
+
+func validateResourceSegment(v string) error {
+	if v == "" || isUnsafeSegment(v) {
+		return errInvalidProxyPath
+	}
+	return nil
+}
+
+func validateProxySubPath(p string) error {
+	for _, seg := range strings.Split(p, "/") {
+		if seg == "" {
+			continue
+		}
+		if isUnsafeSegment(seg) {
+			return errInvalidProxyPath
+		}
+	}
+	return nil
+}
+
