+#[cfg(test)]
+mod git_boundary_tests {
+    use super::*;
+
+    #[test]
+    fn broken_ancestor_gitfile_is_ignored() {
+        let tmp = tempfile::tempdir().unwrap();
+        let ws = tmp.path().join("workspace");
+        let project = ws.join("project");
+        std::fs::create_dir_all(&project).unwrap();
+        std::fs::write(ws.join(".git"), "gitdir: ../missing/git-dir\n").unwrap();
+        let proj = project.to_string_lossy().to_string();
+        assert_eq!(promote_to_git_root(&proj), proj);
+        assert!(!is_valid_git_boundary(&ws.join(".git")));
+    }
+
+    #[test]
+    fn valid_gitfile_worktree_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let gitdir = tmp.path().join("real-git/worktrees/wt");
+        std::fs::create_dir_all(&gitdir).unwrap();
+        let wt = tmp.path().join("wt");
+        let sub = wt.join("src");
+        std::fs::create_dir_all(&sub).unwrap();
+        std::fs::write(wt.join(".git"), "gitdir: ../real-git/worktrees/wt\n").unwrap();
+        assert_eq!(
+            promote_to_git_root(&sub.to_string_lossy()),
+            wt.to_string_lossy()
+        );
+        std::fs::write(wt.join(".git"), format!("gitdir: {}\n", gitdir.display())).unwrap();
+        assert_eq!(
+            promote_to_git_root(&sub.to_string_lossy()),
+            wt.to_string_lossy()
+        );
+    }
+
+    #[test]
+    fn git_directory_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let repo = tmp.path().join("repo");
+        let sub = repo.join("a/b");
+        std::fs::create_dir_all(&sub).unwrap();
+        std::fs::create_dir_all(repo.join(".git")).unwrap();
+        assert_eq!(
+            promote_to_git_root(&sub.to_string_lossy()),
+            repo.to_string_lossy()
+        );
+    }
+}
