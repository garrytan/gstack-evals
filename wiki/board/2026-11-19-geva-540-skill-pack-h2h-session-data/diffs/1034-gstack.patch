+func TestMetricsMiddlewareClampsMethodLabel(t *testing.T) {
+	reg := prometheus.NewRegistry()
+	mw := newMetricsMiddleware(reg)
+	h := mw(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	for _, m := range []string{"M1", "M2", "FOO", "GET", "get"} {
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		req.Method = m
+		h.ServeHTTP(httptest.NewRecorder(), req)
+	}
+	expected := `
+# HELP yopass_http_requests_total Total number of requests served by HTTP method, path and response code.
+# TYPE yopass_http_requests_total counter
+yopass_http_requests_total{code="200",method="GET",path="<other>"} 1
+yopass_http_requests_total{code="200",method="other",path="<other>"} 4
+`
+	if err := testutil.GatherAndCompare(reg, strings.NewReader(expected), "yopass_http_requests_total"); err != nil {
+		t.Fatal(err)
+	}
+}
