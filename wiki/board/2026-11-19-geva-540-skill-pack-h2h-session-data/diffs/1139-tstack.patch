+// A caller must not be able to authorize exec against a project they hold a
+// grant on while targeting a component owned by a different project.
+func TestExecHandler_CrossProjectComponentRejected(t *testing.T) {
+	pdp := testutil.AllowPDP()
+	h := newExecHandler(t, pdp, execTestComponent("payments", "project-b"))
+
+	req := httptest.NewRequest(http.MethodGet,
+		"/exec/namespaces/default/components/payments?env=development&project=project-a",
+		nil).WithContext(testutil.AuthzContext())
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+
+	require.Equal(t, http.StatusBadRequest, rec.Code)
+	require.Empty(t, pdp.Captured, "authz must not be evaluated against the caller-supplied project")
+}
