diff --git a/tests/libuilogic/SpellCheck/OcrFixEngineWithoutDictionaryTests.cs b/tests/libuilogic/SpellCheck/OcrFixEngineWithoutDictionaryTests.cs
new file mode 100644
index 0000000..8c54ee3
--- /dev/null
+++ b/tests/libuilogic/SpellCheck/OcrFixEngineWithoutDictionaryTests.cs
@@ -0,0 +1,51 @@
+using System;
+using System.IO;
+using Nikse.SubtitleEdit.Core.Common;
+using Nikse.SubtitleEdit.Features.Ocr.FixEngine;
+using Nikse.SubtitleEdit.Features.SpellCheck;
+
+namespace LibUiLogicTests.SpellCheck;
+
+public class OcrFixEngineWithoutDictionaryTests
+{
+    [Fact]
+    public void ReplaceListIsAppliedWhenNoHunspellDictionaryIsInstalled()
+    {
+        var folder = Path.Combine(Path.GetTempPath(), "se-ocrfix-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(folder);
+        var previousFolder = SpellCheckConfig.DictionariesFolder;
+        try
+        {
+            File.WriteAllText(Path.Combine(folder, "spa_OCRFixReplaceList.xml"), """
+                <?xml version="1.0" encoding="utf-8"?>
+                <ReplaceList>
+                  <WholeWords>
+                    <Word from="aca" to="acá" />
+                    <Word from="Adios" to="Adiós" />
+                    <Word from="Algun" to="Algún" />
+                    <Word from="dia" to="día" />
+                    <Word from="volvere" to="volveré" />
+                  </WholeWords>
+                </ReplaceList>
+                """);
+            SpellCheckConfig.DictionariesFolder = () => folder;
+
+            var subtitle = new Subtitle();
+            subtitle.Paragraphs.Add(new Paragraph("Hola, aca estoy.", 0, 1000));
+            subtitle.Paragraphs.Add(new Paragraph("Adios.", 1000, 2000));
+            subtitle.Paragraphs.Add(new Paragraph("Algun dia volvere.", 2000, 3000));
+
+            IOcrFixEngine engine = new OcrFixEngine(new SpellChecker());
+            engine.Initialize(subtitle, "spa", null);
+
+            Assert.Equal("Hola, acá estoy.", engine.FixOcrErrors(0, subtitle.Paragraphs[0].Text, true).GetText());
+            Assert.Equal("Adiós.", engine.FixOcrErrors(1, subtitle.Paragraphs[1].Text, true).GetText());
+            Assert.Equal("Algún día volveré.", engine.FixOcrErrors(2, subtitle.Paragraphs[2].Text, true).GetText());
+        }
+        finally
+        {
+            SpellCheckConfig.DictionariesFolder = previousFolder;
+            Directory.Delete(folder, true);
+        }
+    }
+}
