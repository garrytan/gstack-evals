diff --git a/internal/chezmoi/format.go b/internal/chezmoi/format.go
index 341ac66..083eb98 100644
--- a/internal/chezmoi/format.go
+++ b/internal/chezmoi/format.go
@@ -10,6 +10,7 @@ import (
 	"slices"
 	"strings"
 
+	burntsushitoml "github.com/BurntSushi/toml"
 	"github.com/goccy/go-yaml"
 	"github.com/pelletier/go-toml/v2"
 	"github.com/tailscale/hujson"
@@ -159,9 +160,33 @@ func (formatTOML) Name() string {
 
 // Unmarshal implements Format.Unmarshal.
 func (formatTOML) Unmarshal(data []byte, value any) error {
-	decoder := toml.NewDecoder(bytes.NewReader(data))
-	decoder.DisallowUnknownFields()
-	return decoder.Decode(value)
+	// Use github.com/BurntSushi/toml for decoding as it supports TOML v1.1.0.
+	metaData, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(value)
+	if err != nil {
+		return err
+	}
+	// Emulate strict mode by reporting undecoded keys. BurntSushi/toml
+	// reports the children of inline tables decoded into an interface value
+	// as undecoded, so ignore keys whose parent key was decoded.
+	undecoded := metaData.Undecoded()
+	undecodedSet := make(map[string]struct{}, len(undecoded))
+	for _, key := range undecoded {
+		undecodedSet[key.String()] = struct{}{}
+	}
+	var unknownKeys []string
+FOR:
+	for _, key := range undecoded {
+		for i := 1; i < len(key); i++ {
+			if _, ok := undecodedSet[key[:i].String()]; !ok {
+				continue FOR
+			}
+		}
+		unknownKeys = append(unknownKeys, key.String())
+	}
+	if len(unknownKeys) > 0 {
+		return fmt.Errorf("toml: unknown fields: %s", strings.Join(unknownKeys, ", "))
+	}
+	return nil
 }
 
 // Name implements Format.Name.
