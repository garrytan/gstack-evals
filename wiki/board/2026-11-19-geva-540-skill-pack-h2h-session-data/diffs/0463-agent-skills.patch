@@ -222,3 +228,22 @@ func TestFormatEdgeCases(t *testing.T) {
 		})
 	}
 }
+
+func TestFormatTOMLV1_1(t *testing.T) {
+	data := []byte(`
+table = {
+  key1 = "value1",
+  key2 = "value2",
+}
+escapes = "\e\x41"
+`)
+	var actual map[string]any
+	assert.NoError(t, FormatTOML.Unmarshal(data, &actual))
+	assert.Equal(t, map[string]any{
+		"table": map[string]any{
+			"key1": "value1",
+			"key2": "value2",
+		},
+		"escapes": "\x1bA",
+	}, actual)
+}
