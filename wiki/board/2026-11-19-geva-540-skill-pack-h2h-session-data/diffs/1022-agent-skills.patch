@@ -0,0 +1,67 @@
+package openapi3
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// GHSA-g8cf-rcjf-c8cf: a schema whose allOf/anyOf/oneOf/not chain refers back
+// to itself is accepted by Validate() but made VisitJSON recurse without bound,
+// producing a fatal (unrecoverable) stack overflow.
+func TestGHSA_g8cf_rcjf_c8cf_CircularCombinators(t *testing.T) {
+	newRecursive := func(link func(s *Schema)) *Schema {
+		s := &Schema{
+			Type:       &Types{"object"},
+			Properties: Schemas{"name": {Value: &Schema{Type: &Types{"string"}}}},
+		}
+		link(s)
+		return s
+	}
+
+	for _, tc := range []struct {
+		name string
+		link func(s *Schema)
+	}{
+		{"allOf self", func(s *Schema) { s.AllOf = SchemaRefs{{Value: s}} }},
+		{"anyOf self", func(s *Schema) { s.AnyOf = SchemaRefs{{Value: s}} }},
+		{"oneOf self", func(s *Schema) { s.OneOf = SchemaRefs{{Value: s}} }},
+		{"allOf indirect", func(s *Schema) {
+			mid := &Schema{AllOf: SchemaRefs{{Value: s}}}
+			s.AllOf = SchemaRefs{{Value: mid}}
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newRecursive(tc.link)
+			require.NoError(t, s.Validate(context.Background()))
+
+			require.NoError(t, s.VisitJSON(map[string]any{"name": "test"}))
+			require.Error(t, s.VisitJSON(map[string]any{"name": 42}))
+			require.Error(t, s.VisitJSON("not an object"))
+		})
+	}
+
+	t.Run("not self", func(t *testing.T) {
+		s := &Schema{Type: &Types{"object"}}
+		s.Not = &SchemaRef{Value: s}
+		// Must terminate; the result itself is paradoxical so it is not asserted.
+		_ = s.VisitJSON(map[string]any{})
+	})
+
+	t.Run("legitimate recursion through properties still validates", func(t *testing.T) {
+		node := &Schema{Type: &Types{"object"}}
+		node.Properties = Schemas{
+			"value": {Value: &Schema{Type: &Types{"integer"}}},
+			"next":  {Value: &Schema{AllOf: SchemaRefs{{Value: node}}}},
+		}
+		require.NoError(t, node.VisitJSON(map[string]any{
+			"value": 1.0,
+			"next":  map[string]any{"value": 2.0, "next": map[string]any{"value": 3.0}},
+		}))
+		require.Error(t, node.VisitJSON(map[string]any{
+			"value": 1.0,
+			"next":  map[string]any{"value": 2.0, "next": map[string]any{"value": "bad"}},
+		}))
+	})
+}
