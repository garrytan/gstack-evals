@@ -0,0 +1,124 @@
+package openapi3filter_test
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+// GHSA-g8cf-rcjf-c8cf: circular allOf/anyOf/oneOf schemas made request
+// parameter decoding and response validation recurse without bound, causing a
+// fatal, unrecoverable stack overflow that kills the whole process.
+func TestGHSA_g8cf_rcjf_c8cf_CircularCombinators(t *testing.T) {
+	spec := `
+openapi: '3.0.0'
+info: { title: Circular combinators, version: '1.0' }
+paths:
+  /allof:
+    get:
+      parameters:
+        - name: data
+          in: query
+          schema: { $ref: '#/components/schemas/RecursiveAllOf' }
+      responses: { '200': { description: OK } }
+  /array:
+    get:
+      parameters:
+        - name: data
+          in: query
+          schema:
+            type: array
+            items: { $ref: '#/components/schemas/RecursiveAnyOf' }
+      responses: { '200': { description: OK } }
+  /deep:
+    get:
+      parameters:
+        - name: data
+          in: query
+          style: deepObject
+          explode: true
+          schema:
+            type: object
+            properties:
+              inner: { $ref: '#/components/schemas/RecursiveOneOf' }
+      responses: { '200': { description: OK } }
+  /response:
+    get:
+      responses:
+        '200':
+          description: OK
+          content:
+            application/json:
+              schema: { $ref: '#/components/schemas/RecursiveAllOf' }
+components:
+  schemas:
+    RecursiveAllOf:
+      type: object
+      allOf:
+        - $ref: '#/components/schemas/RecursiveAllOf'
+      properties:
+        name: { type: string }
+    RecursiveAnyOf:
+      anyOf:
+        - $ref: '#/components/schemas/RecursiveAnyOf'
+    RecursiveOneOf:
+      oneOf:
+        - $ref: '#/components/schemas/RecursiveOneOf'
+`[1:]
+
+	loader := openapi3.NewLoader()
+	ctx := loader.Context
+	doc, err := loader.LoadFromData([]byte(spec))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(ctx))
+
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+
+	for _, target := range []string{
+		"/allof?data=x",
+		"/array?data=x&data=y",
+		"/deep?data[inner]=x",
+	} {
+		t.Run("request "+target, func(t *testing.T) {
+			req, err := http.NewRequest(http.MethodGet, target, nil)
+			require.NoError(t, err)
+			route, pathParams, err := router.FindRoute(req)
+			require.NoError(t, err)
+
+			err = openapi3filter.ValidateRequest(ctx, &openapi3filter.RequestValidationInput{
+				Request:    req,
+				PathParams: pathParams,
+				Route:      route,
+			})
+			require.Error(t, err)
+			require.Contains(t, err.Error(), "circular schema reference")
+		})
+	}
+
+	t.Run("response", func(t *testing.T) {
+		req, err := http.NewRequest(http.MethodGet, "/response", nil)
+		require.NoError(t, err)
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+
+		reqInput := &openapi3filter.RequestValidationInput{Request: req, PathParams: pathParams, Route: route}
+		validate := func(body string) error {
+			return openapi3filter.ValidateResponse(ctx, &openapi3filter.ResponseValidationInput{
+				RequestValidationInput: reqInput,
+				Status:                 http.StatusOK,
+				Header:                 http.Header{"Content-Type": []string{"application/json"}},
+				Body:                   io.NopCloser(bytes.NewBufferString(body)),
+			})
+		}
+		require.NoError(t, validate(`{"name":"ok"}`))
+		require.Error(t, validate(`{"name":42}`))
+	})
+}
