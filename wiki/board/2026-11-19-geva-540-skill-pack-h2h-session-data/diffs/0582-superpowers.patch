index 0000000..065b1b9
--- /dev/null
+++ b/app/kuma-dp/pkg/dataplane/metrics/labeling_gatherer.go
@@ -0,0 +1,116 @@
+package metrics
+
+import (
+	"maps"
+	"slices"
+	"strings"
+	"sync/atomic"
+
+	prom_client "github.com/prometheus/client_golang/prometheus"
+	io_prometheus_client "github.com/prometheus/client_model/go"
+	"github.com/prometheus/otlptranslator"
+	"google.golang.org/protobuf/proto"
+)
+
+// KumaDPMetricsPrefix is the prefix of metrics emitted directly by the kuma-dp
+// process (e.g. DNS proxy metrics) as opposed to the ones scraped from Envoy.
+const KumaDPMetricsPrefix = "kuma_dp_"
+
+// ExtraLabels holds the set of extra labels (e.g. kuma.workload, mesh,
+// k8s.kuma.io/namespace, kuma.io/zone) which are attached to every scraped
+// metric (Envoy, applications). It allows to attach the same labels to metrics
+// emitted directly by kuma-dp, so they can be correlated with Envoy metrics.
+type ExtraLabels struct {
+	labels atomic.Pointer[[]*io_prometheus_client.LabelPair]
+}
+
+func NewExtraLabels() *ExtraLabels {
+	return &ExtraLabels{}
+}
+
+// Set replaces the current set of extra labels. Label names are translated the
+// same way as attributes of metrics exposed through the OpenTelemetry
+// Prometheus exporter (e.g. "kuma.workload" -> "kuma_workload",
+// "k8s.kuma.io/namespace" -> "k8s_kuma_io_namespace").
+func (e *ExtraLabels) Set(extraLabels map[string]string) {
+	namer := otlptranslator.LabelNamer{UTF8Allowed: false}
+	byName := map[string]string{}
+	for _, k := range slices.Sorted(maps.Keys(extraLabels)) {
+		v := extraLabels[k]
+		if v == "" {
+			continue
+		}
+		name, err := namer.Build(k)
+		if err != nil {
+			log.V(1).Info("skipping invalid extra label", "label", k, "err", err)
+			continue
+		}
+		if _, ok := byName[name]; ok {
+			continue
+		}
+		byName[name] = v
+	}
+	pairs := make([]*io_prometheus_client.LabelPair, 0, len(byName))
+	for _, name := range slices.Sorted(maps.Keys(byName)) {
+		pairs = append(pairs, &io_prometheus_client.LabelPair{
+			Name:  proto.String(name),
+			Value: proto.String(byName[name]),
+		})
+	}
+	e.labels.Store(&pairs)
+}
+
+func (e *ExtraLabels) get() []*io_prometheus_client.LabelPair {
+	if e == nil {
+		return nil
+	}
+	if l := e.labels.Load(); l != nil {
+		return *l
+	}
+	return nil
+}
+
+// LabelingGatherer wraps a Gatherer and adds extra labels to all metrics
+// families emitted by kuma-dp itself (prefixed with "kuma_dp_"). Labels that
+// are already present on a metric are not overridden.
+type LabelingGatherer struct {
+	Gatherer    prom_client.Gatherer
+	ExtraLabels *ExtraLabels
+}
+
+var _ prom_client.Gatherer = &LabelingGatherer{}
+
+func (g *LabelingGatherer) Gather() ([]*io_prometheus_client.MetricFamily, error) {
+	families, err := g.Gatherer.Gather()
+	extra := g.ExtraLabels.get()
+	if len(extra) == 0 {
+		return families, err
+	}
+	for _, family := range families {
+		if !strings.HasPrefix(family.GetName(), KumaDPMetricsPrefix) {
+			continue
+		}
+		for _, metric := range family.GetMetric() {
+			metric.Label = withExtraLabels(metric.GetLabel(), extra)
+		}
+	}
+	return families, err
+}
+
+func withExtraLabels(labels []*io_prometheus_client.LabelPair, extra []*io_prometheus_client.LabelPair) []*io_prometheus_client.LabelPair {
+	existing := make(map[string]struct{}, len(labels))
+	for _, l := range labels {
+		existing[l.GetName()] = struct{}{}
+	}
+	result := slices.Clone(labels)
+	for _, l := range extra {
+		if _, ok := existing[l.GetName()]; ok {
+			continue
+		}
+		result = append(result, &io_prometheus_client.LabelPair{Name: proto.String(l.GetName()), Value: proto.String(l.GetValue())})
+	}
+	slices.SortFunc(result, func(a, b *io_prometheus_client.LabelPair) int {
+		return strings.Compare(a.GetName(), b.GetName())
+	})
+	return result
+}
diff --git a/app/kuma-dp/pkg/dataplane/metrics/labeling_gatherer_test.go b/app/kuma-dp/pkg/dataplane/metrics/labeling_gatherer_test.go
