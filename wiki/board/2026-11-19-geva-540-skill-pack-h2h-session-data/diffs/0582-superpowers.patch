+package meshmetrics
+
+import (
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+var _ = Describe("kumaDPMetricsLabels", func() {
+	It("should derive mesh, zone and namespace from the workload KRI", func() {
+		Expect(kumaDPMetricsLabels(map[string]string{
+			"kuma.workload": "kri_wl_default_zone-1_kuma-demo_demo-app_",
+		})).To(Equal(map[string]string{
+			"kuma.workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"mesh":                  "default",
+			"kuma.io/zone":          "zone-1",
+			"k8s.kuma.io/namespace": "kuma-demo",
+		}))
+	})
+
+	It("should not override existing labels", func() {
+		Expect(kumaDPMetricsLabels(map[string]string{
+			"kuma.workload": "kri_wl_default___demo-app_",
+			"mesh":          "other",
+		})).To(Equal(map[string]string{
+			"kuma.workload": "kri_wl_default___demo-app_",
+			"mesh":          "other",
+		}))
+	})
+
+	It("should return labels unchanged without workload", func() {
+		Expect(kumaDPMetricsLabels(nil)).To(BeEmpty())
+		Expect(kumaDPMetricsLabels(map[string]string{"mesh": "default"})).To(Equal(map[string]string{"mesh": "default"}))
+	})
+})
