@@ -0,0 +1,67 @@
+package metrics_test
+
+import (
+	"bytes"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/common/expfmt"
+
+	"github.com/kumahq/kuma/v2/app/kuma-dp/pkg/dataplane/metrics"
+)
+
+var _ = Describe("LabelingGatherer", func() {
+	gather := func(g prometheus.Gatherer) string {
+		families, err := g.Gather()
+		Expect(err).ToNot(HaveOccurred())
+		buf := &bytes.Buffer{}
+		for _, f := range families {
+			_, err := expfmt.MetricFamilyToText(buf, f)
+			Expect(err).ToNot(HaveOccurred())
+		}
+		return buf.String()
+	}
+
+	It("should add extra labels to kuma-dp metrics only", func() {
+		// given
+		registry := prometheus.NewRegistry()
+		dnsHistogram := prometheus.NewHistogram(prometheus.HistogramOpts{
+			Name:    "kuma_dp_dns_request_duration_seconds",
+			Buckets: []float64{1},
+		})
+		dnsHistogram.Observe(0.5)
+		other := prometheus.NewCounter(prometheus.CounterOpts{
+			Name: "envoy_server_live",
+		})
+		withLabel := prometheus.NewCounter(prometheus.CounterOpts{
+			Name:        "kuma_dp_other",
+			ConstLabels: prometheus.Labels{"mesh": "original"},
+		})
+		registry.MustRegister(dnsHistogram, other, withLabel)
+
+		extraLabels := metrics.NewExtraLabels()
+		gatherer := &metrics.LabelingGatherer{Gatherer: registry, ExtraLabels: extraLabels}
+
+		// when no labels are set
+		out := gather(gatherer)
+
+		// then
+		Expect(out).To(ContainSubstring("kuma_dp_dns_request_duration_seconds_count 1\n"))
+
+		// when
+		extraLabels.Set(map[string]string{
+			"kuma.workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"k8s.kuma.io/namespace": "kuma-demo",
+			"kuma.io/zone":          "zone-1",
+			"mesh":                  "default",
+		})
+		out = gather(gatherer)
+
+		// then
+		Expect(out).To(ContainSubstring(`kuma_dp_dns_request_duration_seconds_count{k8s_kuma_io_namespace="kuma-demo",kuma_io_zone="zone-1",kuma_workload="kri_wl_default_zone-1_kuma-demo_demo-app_",mesh="default"} 1`))
+		Expect(out).To(ContainSubstring(`kuma_dp_dns_request_duration_seconds_bucket{k8s_kuma_io_namespace="kuma-demo",kuma_io_zone="zone-1",kuma_workload="kri_wl_default_zone-1_kuma-demo_demo-app_",mesh="default",le="1"} 1`))
+		Expect(out).To(ContainSubstring(`kuma_dp_other{k8s_kuma_io_namespace="kuma-demo",kuma_io_zone="zone-1",kuma_workload="kri_wl_default_zone-1_kuma-demo_demo-app_",mesh="original"} 0`))
+		Expect(out).To(ContainSubstring("envoy_server_live 0\n"))
+	})
+})
