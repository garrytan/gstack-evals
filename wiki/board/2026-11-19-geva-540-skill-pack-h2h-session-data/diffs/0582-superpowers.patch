+// kumaDPMetricsLabels returns labels attached to metrics emitted directly by
+// kuma-dp (e.g. DNS metrics). On top of the labels attached to Envoy metrics,
+// it adds mesh, zone and namespace derived from the workload KRI when they are
+// not already present, so these metrics can be filtered without joins.
+func kumaDPMetricsLabels(extraLabels map[string]string) map[string]string {
+	labels := maps.Clone(extraLabels)
+	if labels == nil {
+		labels = map[string]string{}
+	}
+	workload, ok := labels[meshmetric_plugin.WorkloadAttributeKey]
+	if !ok || workload == "" {
+		return labels
+	}
+	id, err := kri.FromString(workload)
+	if err != nil {
+		return labels
+	}
+	setIfMissing := func(key, value string) {
+		if value == "" {
+			return
+		}
+		if _, exists := labels[key]; !exists {
+			labels[key] = value
+		}
+	}
+	setIfMissing("mesh", id.Mesh)
+	setIfMissing(mesh_proto.ZoneTag, id.Zone)
+	setIfMissing(mesh_proto.KubeNamespaceTag, id.Namespace)
+	return labels
+}
