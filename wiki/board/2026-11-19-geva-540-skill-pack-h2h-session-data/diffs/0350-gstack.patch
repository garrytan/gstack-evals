+        /// <summary>
+        /// Check whether a path is the same as or inside another directory
+        /// </summary>
+        /// <param name="parentPath">The possible parent directory</param>
+        /// <param name="childPath">The possible child path</param>
+        /// <returns>true if childPath is parentPath or is contained within it, false otherwise</returns>
+        public static bool IsSameOrSubDirectory(string parentPath, string childPath)
+        {
+            var parent = NormalizeDirPath(parentPath);
+            var child  = NormalizeDirPath(childPath);
+            return child.StartsWith(parent, Platform.PathComparison);
+        }
+
+        private static string NormalizeDirPath(string path)
+        {
+            var full = Path.GetFullPath(path);
+            // Resolve symbolic links in the existing portion of the path
+            var existing = full;
+            var suffix   = "";
+            while (!Directory.Exists(existing))
+            {
+                var parent = Path.GetDirectoryName(existing);
+                if (parent == null)
+                {
+                    break;
+                }
+                suffix   = Path.Combine(Path.GetFileName(existing), suffix);
+                existing = parent;
+            }
+            if (Directory.Exists(existing))
+            {
+                try
+                {
+                    full = Path.Combine(ResolveDirLinks(existing), suffix);
+                }
+                catch
+                {
+                    // Fall back to the unresolved path
+                }
+            }
+            full = full.Replace(Path.AltDirectorySeparatorChar, Path.DirectorySeparatorChar)
+                       .TrimEnd(Path.DirectorySeparatorChar);
+            return full + Path.DirectorySeparatorChar;
+        }
+
+        private static string ResolveDirLinks(string existingDir)
+        {
+            var parent = Path.GetDirectoryName(existingDir);
+            var resolvedParent = parent == null ? existingDir : ResolveDirLinks(parent);
+            var current = parent == null ? existingDir
+                                         : Path.Combine(resolvedParent, Path.GetFileName(existingDir));
+            return DirectoryLink.TryGetTarget(current, out string? target)
+                   && target is not null
+                       ? Path.GetFullPath(Path.Combine(resolvedParent, target))
+                       : current;
+        }
