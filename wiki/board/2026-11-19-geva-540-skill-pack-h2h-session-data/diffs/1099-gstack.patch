diff --git a/db/Role.go b/db/Role.go
index a322acc..2979b4e 100644
--- a/db/Role.go
+++ b/db/Role.go
@@ -7,10 +7,31 @@ type Role struct {
 	ProjectID   *int                  `db:"project_id" json:"project_id"`
 }
 
+// AllProjectPermissions is the bitmask of all known project permissions.
+const AllProjectPermissions = CanRunProjectTasks | CanUpdateProject | CanManageProjectResources | CanManageProjectUsers
+
 func ValidateRole(role Role) error {
 	if role.Name == "" {
 		return &ValidationError{Message: "Role name cannot be empty"}
 	}
+	if role.Slug == "" {
+		return &ValidationError{Message: "Role slug cannot be empty"}
+	}
+	if ProjectUserRole(role.Slug).IsValid() {
+		return &ValidationError{Message: "Role slug is reserved for a built-in role"}
+	}
+	if role.Permissions < 0 || role.Permissions&^AllProjectPermissions != 0 {
+		return &ValidationError{Message: "Role contains unknown permissions"}
+	}
+	return nil
+}
+
+// ValidateRolePermissionsCeiling ensures that a role does not grant permissions
+// the caller does not hold.
+func ValidateRolePermissionsCeiling(role Role, callerPermissions ProjectUserPermission) error {
+	if role.Permissions&^callerPermissions != 0 {
+		return &ValidationError{Message: "Role cannot grant permissions the caller does not have"}
+	}
 	return nil
 }
 
diff --git a/db/Role_test.go b/db/Role_test.go
new file mode 100644
index 0000000..965a0f8
--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,20 @@
+package db
+
+import "testing"
+
+func TestValidateRoleRejectsBuiltinSlugs(t *testing.T) {
+	for _, slug := range []string{"owner", "manager", "task_runner", "guest"} {
+		if ValidateRole(Role{Slug: slug, Name: "x", Permissions: 1}) == nil {
+			t.Fatalf("expected slug %q to be rejected", slug)
+		}
+	}
+	if ValidateRole(Role{Slug: "custom", Name: "x", Permissions: 1 << 10}) == nil {
+		t.Fatal("expected unknown permission bits to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: CanRunProjectTasks}); err != nil {
+		t.Fatal(err)
+	}
+	if ValidateRolePermissionsCeiling(Role{Permissions: AllProjectPermissions}, ProjectManager.GetPermissions()) == nil {
+		t.Fatal("expected ceiling violation")
+	}
+}
