+
+// Search `terminator` starting from `start`, remembering failed searches.
+// If a search from `start` fails, any search from a later position fails
+// too, so repeated unterminated constructs don't cause quadratic scans.
+function findTerminator (state: StateInline, terminator: string, start: number): number {
+  const failFrom = state.htmlFail[terminator]
+  if (failFrom !== undefined && start >= failFrom) { return -1 }
+
+  const idx = state.src.indexOf(terminator, start)
+  if (idx < 0) { state.htmlFail[terminator] = start }
+  return idx
+}
+
+// Equivalent of `<!--(?:[^-]|-[^-]|--[^>])*-->` applied at `start` (position
+// right after `<!--`). Match ends at the first `>` preceded by a run of `-`
+// (counted from `start`) whose length is 2 (mod 3). Returns end position or -1.
+function scanComment (state: StateInline, start: number): number {
+  const src = state.src
+  const max = src.length
+  const key = '-->'
+  const failFrom = state.htmlFail[key]
+
+  if (failFrom !== undefined && start >= failFrom) {
+    // Everything after the leading dash run was already scanned without
+    // success. Only the leading run (truncated at `start`) can differ.
+    let j = start
+    while (j < max && src.charCodeAt(j) === 0x2D/* - */) j++
+    if (j < max && src.charCodeAt(j) === 0x3E/* > */ && (j - start) % 3 === 2) {
+      return j + 1
+    }
+    return -1
+  }
+
+  let dashes = 0
+  for (let j = start; j < max; j++) {
+    const c = src.charCodeAt(j)
+    if (c === 0x2D/* - */) {
+      dashes++
+    } else {
+      if (c === 0x3E/* > */ && dashes % 3 === 2) { return j + 1 }
+      dashes = 0
+    }
+  }
+
+  state.htmlFail[key] = start
+  return -1
+}
+
+// Returns end position of html construct at `pos`, or -1
+function matchHtml (state: StateInline, pos: number): number {
+  const src = state.src
+  const ch = src.charCodeAt(pos + 1)
+
+  if (ch === 0x3F/* ? */) {
+    // processing instruction: <?...?>
+    const idx = findTerminator(state, '?>', pos + 2)
+    return idx < 0 ? -1 : idx + 2
+  }
+
+  if (ch === 0x21/* ! */) {
+    if (src.startsWith('<!--', pos)) {
+      // comment: <!--> | <!---> | <!--...-->
+      if (src.startsWith('<!-->', pos)) return pos + 5
+      if (src.startsWith('<!--->', pos)) return pos + 6
+      return scanComment(state, pos + 4)
+    }
+
+    if (src.startsWith('<![CDATA[', pos)) {
+      const idx = findTerminator(state, ']]>', pos + 9)
+      return idx < 0 ? -1 : idx + 3
+    }
+
+    if (isLetter(src.charCodeAt(pos + 2))) {
+      // declaration: <!X...>
+      const idx = findTerminator(state, '>', pos + 3)
+      return idx < 0 ? -1 : idx + 1
+    }
+
+    return -1
+  }
+
+  // open / close tag
+  HTML_OPEN_CLOSE_TAG_STICKY_RE.lastIndex = pos
+  const match = HTML_OPEN_CLOSE_TAG_STICKY_RE.exec(src)
+  return match ? pos + match[0].length : -1
+}
