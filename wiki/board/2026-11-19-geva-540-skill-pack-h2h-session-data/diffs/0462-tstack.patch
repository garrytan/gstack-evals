+
+func TestFormatTOMLV1_1_0(t *testing.T) {
+	data := "abbr = {\n  g = \"git\",\n  k = \"kubectl\",\n}\nesc = \"\\e[0m\"\n"
+	var actual map[string]any
+	assert.NoError(t, FormatTOML.Unmarshal([]byte(data), &actual))
+	assert.Equal(t, map[string]any{
+		"abbr": map[string]any{
+			"g": "git",
+			"k": "kubectl",
+		},
+		"esc": "\x1b[0m",
+	}, actual)
+}
+
+func TestFormatTOMLUnknownFields(t *testing.T) {
+	var value struct {
+		Any    any
+		Object map[string]any
+	}
+	assert.NoError(t, FormatTOML.Unmarshal([]byte("Any = {a = 1}\n[Object]\nb = {c = 2}\n"), &value))
+	assert.Equal[any](t, map[string]any{"a": int64(1)}, value.Any)
+	assert.Equal(t, map[string]any{"b": map[string]any{"c": int64(2)}}, value.Object)
+
+	var externals map[string]External
+	err := FormatTOML.Unmarshal([]byte("[a]\ntype = \"file\"\n[a.clone]\nunknown = 1\n"), &externals)
+	assert.Error(t, err)
+	assert.Contains(t, err.Error(), "unknown fields: a.clone.unknown")
+}
