 	"strings"
 
+	burntsushitoml "github.com/BurntSushi/toml"
 	"github.com/goccy/go-yaml"
 	"github.com/pelletier/go-toml/v2"
 	"github.com/tailscale/hujson"
@@ -157,11 +159,94 @@ func (formatTOML) Name() string {
 	return "toml"
 }
 
-// Unmarshal implements Format.Unmarshal.
+// Unmarshal implements Format.Unmarshal. It uses github.com/BurntSushi/toml
+// as it supports TOML v1.1.0.
 func (formatTOML) Unmarshal(data []byte, value any) error {
-	decoder := toml.NewDecoder(bytes.NewReader(data))
-	decoder.DisallowUnknownFields()
-	return decoder.Decode(value)
+	metaData, err := burntsushitoml.Decode(string(data), value)
+	if err != nil {
+		return err
+	}
+	// BurntSushi/toml reports keys decoded into interface values as
+	// undecoded, so only report keys that do not correspond to a field.
+	var unknownKeys []string
+	for _, key := range metaData.Undecoded() {
+		if !tomlKeyIsKnown(reflect.TypeOf(value), key) {
+			unknownKeys = append(unknownKeys, key.String())
+		}
+	}
+	if len(unknownKeys) > 0 {
+		return fmt.Errorf("unknown fields: %s", strings.Join(unknownKeys, ", "))
+	}
+	return nil
+}
+
+// tomlKeyIsKnown returns whether key can be decoded into a value of type t.
+func tomlKeyIsKnown(t reflect.Type, key burntsushitoml.Key) bool {
+	for _, part := range key {
+	FOR:
+		for {
+			switch t.Kind() {
+			case reflect.Interface:
+				return true
+			case reflect.Pointer, reflect.Slice, reflect.Array:
+				t = t.Elem()
+			default:
+				break FOR
+			}
+		}
+		switch t.Kind() {
+		case reflect.Map:
+			t = t.Elem()
+		case reflect.Struct:
+			field, ok := tomlStructField(t, part)
+			if !ok {
+				return false
+			}
+			t = field.Type
+		default:
+			return false
+		}
+	}
+	return t.Kind() == reflect.Interface
+}
+
+// tomlStructField returns the field of struct type t that corresponds to the
+// TOML key name, using the same rules as github.com/BurntSushi/toml.
+func tomlStructField(t reflect.Type, name string) (reflect.StructField, bool) {
+	var caseInsensitiveField reflect.StructField
+	caseInsensitiveMatch := false
+	for i := range t.NumField() {
+		field := t.Field(i)
+		if field.Anonymous && field.Tag.Get("toml") == "" {
+			fieldType := field.Type
+			if fieldType.Kind() == reflect.Pointer {
+				fieldType = fieldType.Elem()
+			}
+			if fieldType.Kind() == reflect.Struct {
+				if f, ok := tomlStructField(fieldType, name); ok {
+					return f, true
+				}
+			}
+			continue
+		}
+		if !field.IsExported() {
+			continue
+		}
+		fieldName, _, _ := strings.Cut(field.Tag.Get("toml"), ",")
+		if fieldName == "-" {
+			continue
+		}
+		if fieldName == "" {
+			fieldName = field.Name
+		}
+		if fieldName == name {
+			return field, true
+		}
+		if !caseInsensitiveMatch && strings.EqualFold(fieldName, name) {
+			caseInsensitiveField, caseInsensitiveMatch = field, true
+		}
+	}
+	return caseInsensitiveField, caseInsensitiveMatch
 }
 
