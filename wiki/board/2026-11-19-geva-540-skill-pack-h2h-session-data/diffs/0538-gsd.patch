+func TestDatasetServiceImpl_process_commitsProgressEveryBatch(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	mockRepo := mock_repo.NewMockIDatasetAPI(ctrl)
+	mockIConfig := confmocks.NewMockIConfig(ctrl)
+	mockILocker := lockmocks.NewMockILocker(ctrl)
+	service := &DatasetServiceImpl{
+		repo:     mockRepo,
+		retryCfg: mockIConfig.GetSnapshotRetry,
+		locker:   mockILocker,
+	}
+
+	mockIConfig.EXPECT().GetSnapshotRetry().Return(&conf.SnapshotRetry{}).AnyTimes()
+	mockILocker.EXPECT().LockBackoffWithRenew(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(true, context.Background(), func() {}, nil)
+
+	cursors := []string{"c1", "c2", "c3", ""}
+	call := 0
+	mockRepo.EXPECT().ListItems(gomock.Any(), gomock.Any()).DoAndReturn(func(_ context.Context, _ *repo.ListItemsParams, _ ...repo.Option) ([]*entity.Item, *pagination.PageResult, error) {
+		c := cursors[call]
+		call++
+		return []*entity.Item{}, &pagination.PageResult{Cursor: c}, nil
+	}).Times(len(cursors))
+	mockRepo.EXPECT().BatchUpsertItemSnapshots(gomock.Any(), gomock.Any()).Return(int64(0), nil).Times(len(cursors))
+	mockRepo.EXPECT().CountItemSnapshots(gomock.Any(), gomock.Any(), gomock.Any()).Return(int64(0), nil)
+
+	var committed []string
+	var whereVersions []int64
+	mockRepo.EXPECT().PatchVersion(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(func(_ context.Context, patch, where *entity.DatasetVersion, _ ...repo.Option) error {
+		committed = append(committed, patch.SnapshotProgress.Cursor)
+		whereVersions = append(whereVersions, where.UpdateVersion)
+		return nil
+	}).Times(len(cursors))
+
+	processCtx := &snapshotContext{
+		spaceID:   1,
+		versionID: 1,
+		version: &entity.DatasetVersion{
+			ID:               1,
+			SnapshotStatus:   entity.SnapshotStatusUnstarted,
+			SnapshotProgress: &entity.SnapshotProgress{},
+		},
+	}
+	if err := service.process(context.Background(), processCtx); err != nil {
+		t.Fatalf("process() error = %v", err)
+	}
+	if fmt.Sprint(committed) != fmt.Sprint(cursors) {
+		t.Errorf("committed cursors = %v, want %v", committed, cursors)
+	}
+	if fmt.Sprint(whereVersions) != fmt.Sprint([]int64{0, 1, 2, 3}) {
+		t.Errorf("optimistic lock versions = %v, want [0 1 2 3]", whereVersions)
+	}
+	if processCtx.version.SnapshotStatus != entity.SnapshotStatusCompleted {
+		t.Errorf("status = %v, want completed", processCtx.version.SnapshotStatus)
+	}
+}
