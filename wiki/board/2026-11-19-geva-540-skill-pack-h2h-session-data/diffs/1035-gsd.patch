+func TestMetricsMiddlewareClampsMethodLabel(t *testing.T) {
+	reg := prometheus.NewRegistry()
+	mw := newMetricsMiddleware(reg)
+	h := mw(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+
+	for i := 0; i < 50; i++ {
+		req := httptest.NewRequest(fmt.Sprintf("M%d", i), "/", nil)
+		h.ServeHTTP(httptest.NewRecorder(), req)
+	}
+	h.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, "/", nil))
+
+	families, err := reg.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mf := range families {
+		methods := map[string]bool{}
+		for _, m := range mf.GetMetric() {
+			for _, l := range m.GetLabel() {
+				if l.GetName() == "method" {
+					methods[l.GetValue()] = true
+				}
+			}
+		}
+		if len(methods) != 2 || !methods["other"] || !methods[http.MethodGet] {
+			t.Errorf("%s: unexpected method labels %v", mf.GetName(), methods)
+		}
+	}
+}
