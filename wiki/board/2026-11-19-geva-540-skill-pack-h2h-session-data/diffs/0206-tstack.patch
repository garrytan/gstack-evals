+using Riok.Mapperly.Abstractions;
+
+namespace Riok.Mapperly.IntegrationTests.Mapper
+{
+    public interface IAudit
+    {
+        string CreatedBy { get; set; }
+    }
+
+    public interface IOwnable
+    {
+        string? Owner { get; set; }
+    }
+
+    public interface IAuditDto
+    {
+        string CreatedByUser { get; set; }
+    }
+
+    public interface IOwnableDto
+    {
+        string? OwnerName { get; set; }
+    }
+
+    public class House : IAudit, IOwnable
+    {
+        public string CreatedBy { get; set; } = string.Empty;
+
+        public string? Owner { get; set; }
+
+        public int Rooms { get; set; }
+    }
+
+    public class HouseDto : IAuditDto, IOwnableDto
+    {
+        public string CreatedByUser { get; set; } = string.Empty;
+
+        public string? OwnerName { get; set; }
+
+        public int Rooms { get; set; }
+    }
+
+    [Mapper]
+    public static partial class BaseConfigurationMapper
+    {
+        [MapProperty(nameof(IAudit.CreatedBy), nameof(IAuditDto.CreatedByUser))]
+        public static partial void MapAudit(IAudit audit, IAuditDto auditDto);
+
+        [MapProperty(nameof(IOwnable.Owner), nameof(IOwnableDto.OwnerName))]
+        public static partial void MapOwnable(IOwnable ownable, IOwnableDto ownableDto);
+    }
+
+    [Mapper]
+    [UseStaticMapper(typeof(BaseConfigurationMapper))]
+    public static partial class IncludeMultipleConfigurationsMapper
+    {
+        [IncludeMappingConfiguration(nameof(@BaseConfigurationMapper.MapAudit))]
+        [IncludeMappingConfiguration(nameof(@BaseConfigurationMapper.MapOwnable))]
+        public static partial HouseDto ToDto(House house);
+    }
+}
