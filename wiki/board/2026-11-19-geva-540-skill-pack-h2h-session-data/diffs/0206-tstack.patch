+namespace Riok.Mapperly.Configuration;
+
+internal static class ConfigurationCollectionExtensions
+{
+    /// <summary>
+    /// Appends all items of <paramref name="other"/> which are not yet contained in <paramref name="items"/>.
+    /// This prevents duplicated configurations if the same configuration is included multiple times
+    /// (e.g. multiple included configurations which include the same base configuration).
+    /// </summary>
+    public static IReadOnlyCollection<T> IncludeDistinct<T>(this IReadOnlyCollection<T> items, IReadOnlyCollection<T>? other)
+    {
+        if (other == null || other.Count == 0)
+            return items;
+
+        var existing = new HashSet<T>(items);
+        return items.Concat(other.Where(x => !existing.Contains(x))).ToList();
+    }
+}
