+using Riok.Mapperly.IntegrationTests.Mapper;
+using Shouldly;
+using Xunit;
+
+namespace Riok.Mapperly.IntegrationTests
+{
+    public class IncludeMultipleConfigurationsMapperTest
+    {
+        [Fact]
+        public void RunMappingShouldApplyAllIncludedConfigurations()
+        {
+            var house = new House
+            {
+                CreatedBy = "creator",
+                Owner = "owner",
+                Rooms = 3,
+            };
+            var dto = IncludeMultipleConfigurationsMapper.ToDto(house);
+            dto.CreatedByUser.ShouldBe("creator");
+            dto.OwnerName.ShouldBe("owner");
+            dto.Rooms.ShouldBe(3);
+        }
+    }
+}
