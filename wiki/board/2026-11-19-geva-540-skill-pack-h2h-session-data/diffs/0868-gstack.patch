+
+type rootUnmarshaler struct {
+	Keys []string
+}
+
+func (r *rootUnmarshaler) UnmarshalTOML(value *unstable.Node) error {
+	switch value.Kind {
+	case unstable.KeyValue, unstable.Table, unstable.ArrayTable:
+		k := value.Key()
+		var parts []string
+		for k.Next() {
+			parts = append(parts, string(k.Node().Data))
+		}
+		r.Keys = append(r.Keys, strings.Join(parts, "."))
+	}
+	return nil
+}
+
+func TestUnmarshal_RootUnmarshaler(t *testing.T) {
+	doc := "foo = \"bar\"\nbaz = 1\n[tbl]\nx = 2\n"
+	var r rootUnmarshaler
+	err := toml.NewDecoder(bytes.NewReader([]byte(doc))).EnableUnmarshalerInterface().Decode(&r)
+	assert.NoError(t, err)
+	assert.Equal(t, []string{"foo", "baz", "tbl", "x"}, r.Keys)
+
+	var r2 rootUnmarshaler
+	err = toml.NewDecoder(bytes.NewReader([]byte(doc))).Decode(&r2)
+	assert.NoError(t, err)
+	assert.Equal(t, 0, len(r2.Keys))
+}
+
+func TestUnmarshal_TableUnmarshaler(t *testing.T) {
+	type cfg struct {
+		A   int
+		Tbl rootUnmarshaler
+	}
+	doc := "A = 1\n[Tbl]\nx = 2\ny.z = 3\n"
+	var c cfg
+	err := toml.NewDecoder(bytes.NewReader([]byte(doc))).EnableUnmarshalerInterface().Decode(&c)
+	assert.NoError(t, err)
+	assert.Equal(t, 1, c.A)
+	assert.Equal(t, []string{"x", "y.z"}, c.Tbl.Keys)
+}
