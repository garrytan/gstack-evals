+func (d *decoder) asUnmarshaler(v reflect.Value) (unstable.Unmarshaler, bool) {
+	if !d.unmarshalerInterface || !v.IsValid() {
+		return nil, false
+	}
+	if v.Kind() == reflect.Ptr && !v.IsNil() && v.CanInterface() {
+		if outi, ok := v.Interface().(unstable.Unmarshaler); ok {
+			return outi, true
+		}
+	}
