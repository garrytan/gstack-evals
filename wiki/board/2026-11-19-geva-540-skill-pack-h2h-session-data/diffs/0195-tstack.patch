@@ -0,0 +1,52 @@
+using System;
+using NAudio.Wave;
+using NUnit.Framework;
+
+#pragma warning disable CS0618 // WaveBuffer is obsolete but still shipped for backward compatibility
+
+namespace NAudio.Core.Tests.WaveStreams;
+
+[TestFixture]
+[Category("UnitTest")]
+public class WaveBufferTests
+{
+    [Test]
+    public void CopyToFloatArrayCopiesRawSampleBytes()
+    {
+        var samples = new[] { 0.25f, -0.5f, 1.0f, 0.125f };
+        var bytes = new byte[samples.Length * 4];
+        Buffer.BlockCopy(samples, 0, bytes, 0, bytes.Length);
+        var waveBuffer = new WaveBuffer(bytes) { FloatBufferCount = samples.Length };
+
+        var destination = new float[samples.Length];
+        waveBuffer.Copy(destination);
+
+        Assert.That(destination, Is.EqualTo(samples));
+    }
+
+    [Test]
+    public void CopyToShortArrayCopiesRawSampleBytes()
+    {
+        var samples = new short[] { 1000, -2000, 32767, -32768 };
+        var bytes = new byte[samples.Length * 2];
+        Buffer.BlockCopy(samples, 0, bytes, 0, bytes.Length);
+        var waveBuffer = new WaveBuffer(bytes) { ShortBufferCount = samples.Length };
+
+        var destination = new short[samples.Length];
+        waveBuffer.Copy(destination);
+
+        Assert.That(destination, Is.EqualTo(samples));
+    }
+
+    [Test]
+    public void CopyToByteArrayCopiesByteBufferCount()
+    {
+        var bytes = new byte[] { 1, 2, 3, 4, 5, 6, 7, 8 };
+        var waveBuffer = new WaveBuffer(bytes) { ByteBufferCount = 4 };
+
+        var destination = new byte[8];
+        waveBuffer.Copy(destination);
+
+        Assert.That(destination, Is.EqualTo(new byte[] { 1, 2, 3, 4, 0, 0, 0, 0 }));
+    }
+}
