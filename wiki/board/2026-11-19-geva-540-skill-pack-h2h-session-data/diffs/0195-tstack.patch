+    [Test]
+    public void CopyToDeliversWholeMonoFile()
+    {
+        // 16 seconds of 8kHz mono, as in the "WAV to MP3 truncates file length" report
+        const int sampleRate = 8000;
+        var wav = Build16BitMonoPcmWav(sampleCount: sampleRate * 16, sampleRate: sampleRate);
+        var tmp = Path.Combine(Path.GetTempPath(), "naudio-copyto-test-" + Guid.NewGuid() + ".wav");
+        File.WriteAllBytes(tmp, wav);
+        try
+        {
+            using var reader = new AudioFileReader(tmp);
+            var output = new MemoryStream();
+            reader.CopyTo(output);
+            Assert.That(output.Length, Is.EqualTo(reader.Length));
+            Assert.That(output.Length, Is.EqualTo(sampleRate * 16 * 4)); // 32-bit float mono
+        }
+        finally
+        {
+            File.Delete(tmp);
+        }
+    }
