+        [Test]
+        public async Task MessageBox_ShouldUseGlobalBackgroundClass_WhenNoOptionsProvided()
+        {
+            var comp = Context.Render<MudDialogProvider>(builder =>
+            {
+                builder.Add(p => p.BackgroundClass, "blurry-dialog-background");
+            });
+            var service = Context.Services.GetService<IDialogService>();
+
+            await comp.InvokeAsync(() => { _ = service.ShowMessageBoxAsync("Title", "Message"); });
+
+            comp.Find("div.mud-overlay-dialog").ClassList.Should().Contain("blurry-dialog-background");
+        }
+
+        [Test]
+        public async Task MessageBox_ShouldPreferDialogOptionsBackgroundClass_OverGlobal()
+        {
+            var comp = Context.Render<MudDialogProvider>(builder =>
+            {
+                builder.Add(p => p.BackgroundClass, "global-background");
+            });
+            var service = Context.Services.GetService<IDialogService>();
+
+            await comp.InvokeAsync(() => { _ = service.ShowMessageBoxAsync("Title", "Message", options: new DialogOptions { BackgroundClass = "local-background" }); });
+
+            var classList = comp.Find("div.mud-overlay-dialog").ClassList;
+            classList.Should().Contain("local-background");
+            classList.Should().NotContain("global-background");
+        }
+
