+// launchesGoroutineWithWgDone returns true if the given statement is a go statement
+// running a function literal that calls wg.Done, or a loop whose body directly contains such a go statement.
+func (w *lintUseWaitGroupGo) launchesGoroutineWithWgDone(stmt ast.Stmt) bool {
+	var loopBody *ast.BlockStmt
+	switch s := stmt.(type) {
+	case *ast.GoStmt:
+		return w.hasCallToWgDone(s)
+	case *ast.RangeStmt:
+		loopBody = s.Body
+	case *ast.ForStmt:
+		loopBody = s.Body
+	default:
+		return false
+	}
+
+	for _, bodyStmt := range loopBody.List {
+		if goStmt, ok := bodyStmt.(*ast.GoStmt); ok && w.hasCallToWgDone(goStmt) {
+			return true
+		}
+	}
+
+	return false
+}
