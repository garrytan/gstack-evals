+func useWaitGroupGoWithLoops(jobs int64) {
+	wg := sync.WaitGroup{}
+
+	// from https://github.com/kubernetes-sigs/kueue/pull/9892
+	wg.Add(int(jobs)) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+
+	for range int(jobs) {
+		go func() {
+			defer wg.Done()
+			doSomething()
+		}()
+	}
+
+	wg.Wait()
+
+	wg.Add(int(jobs)) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+	for i := 0; i < int(jobs); i++ {
+		go func() {
+			doSomething()
+			wg.Done()
+		}()
+	}
+	wg.Wait()
+
+	wg.Add(int(jobs))
+	for range int(jobs) {
+		go func() {
+			doSomething()
+		}()
+	}
+	wg.Wait()
+}
