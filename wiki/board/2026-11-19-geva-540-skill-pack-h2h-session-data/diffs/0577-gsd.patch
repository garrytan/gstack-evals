-	m = &metrics{
-		RequestDuration:             requestDuration,
-		UpstreamRequestDuration:     upstreamRequestDuration,
-		UpstreamRequestFailureCount: upstreamRequestFailureCount,
+	m.current.Store(newMetricSet(labels))
+}
+
+var labelNamer = otlptranslator.LabelNamer{UTF8Allowed: false}
+
+// toPrometheusLabels converts extra labels to Prometheus label names the same
+// way the OpenTelemetry Prometheus exporter does for Envoy metrics
+// (e.g. "kuma.workload" -> "kuma_workload", "k8s.kuma.io/namespace" -> "k8s_kuma_io_namespace").
+func toPrometheusLabels(extraLabels map[string]string) prometheus.Labels {
+	labels := prometheus.Labels{}
+	for k, v := range extraLabels {
+		if v == "" {
+			continue
+		}
+		name, err := labelNamer.Build(k)
+		if err != nil {
+			log.V(1).Info("skipping invalid metric label", "label", k, "err", err)
+			continue
+		}
+		labels[name] = v
 	}
+	return labels
+}
+
+var (
+	m        *metrics
+	initOnce sync.Once
+)
+
+func newMetrics() *metrics {
+	initOnce.Do(func() {
+		m = &metrics{}
+		m.current.Store(newMetricSet(prometheus.Labels{}))
