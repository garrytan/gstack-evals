+// are the same extra labels that are added to Envoy metrics, they are
+// delivered dynamically by the control plane (MeshMetric configuration).
+// Whenever the set of labels changes, a new set of metrics is created.
+type metrics struct {
+	current atomic.Pointer[metricSet]
+	mu      sync.Mutex // serializes label updates
+}
