+	})
 	return m
 }
+
+// SetMetricsLabels sets extra labels (the same as the ones added to Envoy metrics)
+// on DNS proxy metrics.
+func SetMetricsLabels(extraLabels map[string]string) {
+	newMetrics().setLabels(extraLabels)
+}
