+// Describe intentionally sends no descriptors, which makes this an
+// "unchecked" collector. This is required because label set of the metrics
+// can change over time.
+func (m *metrics) Describe(chan<- *prometheus.Desc) {}
+
+func (m *metrics) Collect(ch chan<- prometheus.Metric) {
+	set := m.get()
+	set.RequestDuration.Collect(ch)
+	set.UpstreamRequestDuration.Collect(ch)
+	set.UpstreamRequestFailureCount.Collect(ch)
+}
