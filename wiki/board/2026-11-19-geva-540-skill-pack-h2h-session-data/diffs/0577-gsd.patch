@@ -0,0 +1,87 @@
+package dnsproxy_test
+
+import (
+	"github.com/miekg/dns"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/prometheus/client_golang/prometheus"
+	io_prometheus_client "github.com/prometheus/client_model/go"
+
+	"github.com/kumahq/kuma/v2/app/kuma-dp/pkg/dataplane/dnsproxy"
+)
+
+type noopWriter struct{ dns.ResponseWriter }
+
+func (noopWriter) WriteMsg(*dns.Msg) error { return nil }
+
+func gatherDNSLabels() map[string]map[string]string {
+	families, err := prometheus.DefaultGatherer.Gather()
+	Expect(err).ToNot(HaveOccurred())
+	result := map[string]map[string]string{}
+	for _, family := range families {
+		switch family.GetName() {
+		case "kuma_dp_dns_request_duration_seconds",
+			"kuma_dp_dns_upstream_request_duration_seconds",
+			"kuma_dp_dns_upstream_request_failure_count":
+			Expect(family.GetMetric()).To(HaveLen(1))
+			result[family.GetName()] = labelsOf(family.GetMetric()[0])
+		}
+	}
+	return result
+}
+
+func labelsOf(metric *io_prometheus_client.Metric) map[string]string {
+	labels := map[string]string{}
+	for _, l := range metric.GetLabel() {
+		labels[l.GetName()] = l.GetValue()
+	}
+	return labels
+}
+
+var _ = Describe("metrics", func() {
+	AfterEach(func() {
+		dnsproxy.SetMetricsLabels(nil)
+	})
+
+	It("should add extra labels to DNS metrics", func() {
+		// given
+		server := dnsproxy.NewServerWithCustomClient("", func(msg *dns.Msg) (*dns.Msg, error) {
+			resp := new(dns.Msg)
+			resp.SetRcode(msg, dns.RcodeSuccess)
+			return resp, nil
+		})
+
+		// when
+		dnsproxy.SetMetricsLabels(map[string]string{
+			"kuma.workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"k8s.kuma.io/namespace": "kuma-demo",
+			"kuma.io/zone":          "zone-1",
+			"mesh":                  "default",
+			"empty":                 "",
+		})
+		msg := &dns.Msg{}
+		msg.SetQuestion("example.com.", dns.TypeA)
+		server.Handler(noopWriter{}, msg)
+
+		// then
+		expected := map[string]string{
+			"kuma_workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"k8s_kuma_io_namespace": "kuma-demo",
+			"kuma_io_zone":          "zone-1",
+			"mesh":                  "default",
+		}
+		labels := gatherDNSLabels()
+		Expect(labels).To(HaveKeyWithValue("kuma_dp_dns_request_duration_seconds", expected))
+		Expect(labels).To(HaveKeyWithValue("kuma_dp_dns_upstream_request_duration_seconds", expected))
+		Expect(labels).To(HaveKeyWithValue("kuma_dp_dns_upstream_request_failure_count", expected))
+	})
+
+	It("should replace labels when they change", func() {
+		dnsproxy.SetMetricsLabels(map[string]string{"kuma.workload": "a"})
+		dnsproxy.SetMetricsLabels(map[string]string{"kuma.workload": "b"})
+
+		Expect(gatherDNSLabels()).To(HaveKeyWithValue(
+			"kuma_dp_dns_request_duration_seconds", map[string]string{"kuma_workload": "b"},
+		))
+	})
+})
