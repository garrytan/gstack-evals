+		describe('Element name (GHSA-w2rr-34g9-rvrj)', () => {
+			const injected = 'img src=x onerror="alert(1)"';
+			test('default serialization emits an invalid element name verbatim', () => {
+				const doc = new DOMImplementation().createDocument(null, 'root', null);
