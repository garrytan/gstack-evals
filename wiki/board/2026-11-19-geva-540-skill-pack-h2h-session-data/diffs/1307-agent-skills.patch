+// validatePathParamValue rejects path parameter values that contain dot
+// segments ("." or ".."), either literally or percent-encoded. Such segments
+// would be normalized during URL resolution (or by the downstream server) and
+// allow escaping the operator-configured path scope.
+func validatePathParamValue(v string) error {
+	decoded := v
+	// Decode repeatedly to catch multiply-encoded sequences such as %252e.
+	for i := 0; i < 5; i++ {
+		next, err := url.PathUnescape(decoded)
+		if err != nil || next == decoded {
+			break
+		}
+		decoded = next
+	}
+	for _, candidate := range []string{v, decoded} {
+		segments := strings.FieldsFunc(candidate, func(r rune) bool { return r == '/' || r == '\\' })
+		for _, seg := range segments {
+			if seg == "." || seg == ".." {
+				return fmt.Errorf("path traversal sequences are not allowed")
+			}
+		}
+	}
+	return nil
+}
