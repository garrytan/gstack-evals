diff --git a/registry/remote/utils.go b/registry/remote/utils.go
index 797169f..0333402 100644
--- a/registry/remote/utils.go
+++ b/registry/remote/utils.go
@@ -51,10 +51,22 @@ func parseLink(resp *http.Response) (string, error) {
 		link = link[1:i]
 	}
 
-	linkURL, err := resp.Request.URL.Parse(link)
+	baseURL := resp.Request.URL
+	linkURL, err := baseURL.Parse(link)
 	if err != nil {
 		return "", err
 	}
+	// Prevent SSRF: the next link must stay on the same scheme and host as
+	// the original request.
+	if !strings.EqualFold(linkURL.Scheme, baseURL.Scheme) {
+		return "", fmt.Errorf("invalid next link %q: scheme %q does not match request scheme %q", link, linkURL.Scheme, baseURL.Scheme)
+	}
+	if !strings.EqualFold(linkURL.Host, baseURL.Host) {
+		return "", fmt.Errorf("invalid next link %q: host %q does not match request host %q", link, linkURL.Host, baseURL.Host)
+	}
+	if linkURL.User != nil {
+		return "", fmt.Errorf("invalid next link %q: userinfo is not allowed", link)
+	}
 	return linkURL.String(), nil
 }
 
