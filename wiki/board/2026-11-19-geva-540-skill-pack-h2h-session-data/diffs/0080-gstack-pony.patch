+package io.github.hectorvent.floci.services.s3;
+
+import io.quarkus.test.junit.QuarkusTest;
+import org.junit.jupiter.api.Test;
+
+import static io.restassured.RestAssured.given;
+
+@QuarkusTest
+class S3DeleteBucketReplicationIntegrationTest {
+
+    @Test
+    void deleteReplicationKeepsBucket() {
+        String bucket = "delete-replication-int-test";
+        given().when().put("/" + bucket).then().statusCode(200);
+        given().when().delete("/" + bucket + "?replication").then().statusCode(204);
+        given().when().head("/" + bucket).then().statusCode(200);
+        given().when().delete("/" + bucket + "?unknownSubresource").then().statusCode(501);
+        given().when().head("/" + bucket).then().statusCode(200);
+        given().when().delete("/" + bucket).then().statusCode(204);
+        given().when().delete("/" + bucket + "?replication").then().statusCode(404);
+    }
+}
