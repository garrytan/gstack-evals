+        [Test]
+        public void ShowMessageBoxAsync_ShouldUseGlobalBackgroundClass()
+        {
+            // Arrange
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-bg"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            // Act
+            _ = provider.InvokeAsync(() => service.ShowMessageBoxAsync("Title", "Message"));
+
+            // Assert
+            provider.WaitForAssertion(() => provider.Find(".mud-overlay-dialog").ClassList.Should().Contain("global-bg"));
+        }
+
+        [Test]
+        public async Task ShowAsync_ShouldPreferDialogBackgroundClassOverGlobal()
+        {
+            // Arrange
+            var provider = Context.Render<MudDialogProvider>(p => p.Add(x => x.BackgroundClass, "global-bg"));
+            var service = Context.Services.GetRequiredService<IDialogService>();
+
+            // Act
+            await provider.InvokeAsync(() => service.ShowAsync<DialogOkCancel>("Title", new DialogOptions { BackgroundClass = "local-bg" }));
+
+            // Assert
+            var classList = provider.Find(".mud-overlay-dialog").ClassList;
+            classList.Should().Contain("local-bg");
+            classList.Should().NotContain("global-bg");
+        }
+
