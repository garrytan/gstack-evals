+package app
+
+import (
+	"net/http/httptest"
+	"testing"
+
+	"github.com/openrundev/openrun/internal/types"
+)
+
+func TestValidatedRefererRedirectSchemeRelative(t *testing.T) {
+	a := &App{serverConfig: &types.ServerConfig{}}
+	cases := map[string]string{
+		"http://127.0.0.1:25222//evil.com":    "/evil.com",
+		"http://127.0.0.1:25222/\\evil.com":   "/",
+		"http://127.0.0.1:25222///evil.com/x": "/evil.com/x",
+		"//evil.com":                          "",
+		"/ok/path?a=b":                        "/ok/path?a=b",
+		"http://127.0.0.1:25222/app/x":        "/app/x",
+		"http://127.0.0.1:25222":              "/",
+	}
+	for in, want := range cases {
+		r := httptest.NewRequest("POST", "http://127.0.0.1:25222/redirecttest/abc", nil)
+		got, ok := a.validatedRefererRedirect(r, in)
+		if want == "" {
+			if ok && (len(got) > 1 && (got[1] == '/' || got[1] == '\\')) {
+				t.Errorf("%q: unsafe redirect %q", in, got)
+			}
+			continue
+		}
+		if !ok || got != want {
+			t.Errorf("%q: got %q,%v want %q", in, got, ok, want)
+		}
+	}
+}
