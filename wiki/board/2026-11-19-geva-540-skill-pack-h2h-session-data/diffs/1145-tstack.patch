--- a/registry/remote/utils.go
+++ b/registry/remote/utils.go
@@ -51,10 +51,17 @@ func parseLink(resp *http.Response) (string, error) {
 		link = link[1:i]
 	}
 
-	linkURL, err := resp.Request.URL.Parse(link)
+	baseURL := resp.Request.URL
+	linkURL, err := baseURL.Parse(link)
 	if err != nil {
 		return "", err
 	}
+	// Only follow links to the same scheme and host as the original request
+	// to prevent malicious registries from redirecting pagination requests
+	// to arbitrary hosts (SSRF) or downgrading the scheme.
+	if linkURL.Scheme != baseURL.Scheme || linkURL.Host != baseURL.Host {
+		return "", fmt.Errorf("invalid next link %q: scheme and host must match %q", link, baseURL.Scheme+"://"+baseURL.Host)
+	}
 	return linkURL.String(), nil
 }
 
