+func TestRepository_Tags_CrossHostLink(t *testing.T) {
+	var internalHit atomic.Bool
+	internal := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		internalHit.Store(true)
+	}))
+	defer internal.Close()
+
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Link", fmt.Sprintf(`<%s/admin>; rel="next"`, internal.URL))
+		if err := json.NewEncoder(w).Encode(map[string][]string{"tags": {"v1"}}); err != nil {
+			t.Errorf("failed to write response: %v", err)
+		}
+	}))
+	defer ts.Close()
+	uri, err := url.Parse(ts.URL)
+	if err != nil {
+		t.Fatalf("invalid test http server: %v", err)
+	}
+
+	repo, err := NewRepository(uri.Host + "/test")
+	if err != nil {
+		t.Fatalf("NewRepository() error = %v", err)
+	}
+	repo.PlainHTTP = true
+
+	err = repo.Tags(context.Background(), "", func([]string) error { return nil })
+	if err == nil {
+		t.Error("Repository.Tags() error = nil, want error for cross-host link")
+	}
+	if internalHit.Load() {
+		t.Error("Repository.Tags() followed cross-host Link header")
+	}
+}
