+  it('preserves session config when updating the agent', async () => {
+    const t = new FakeTransport();
+    const agent = new RealtimeAgent({ name: 'A', handoffs: [] });
+    const s = new RealtimeSession(agent, {
+      transport: t,
+      config: {
+        inputAudioFormat: 'g711_ulaw',
+        outputAudioFormat: 'g711_ulaw',
+        voice: 'ash',
+        instructions: 'session-level instructions',
+      },
+    });
+    await s.connect({ apiKey: 'test' });
+
+    const newAgent = new RealtimeAgent({
+      name: 'Bob',
+      instructions: 'You are Bob',
+      handoffs: [],
+    });
+    await s.updateAgent(newAgent);
+
+    const update = t.updateSessionConfigCalls.at(-1)!;
+    expect(update.inputAudioFormat).toBe('g711_ulaw');
+    expect(update.outputAudioFormat).toBe('g711_ulaw');
+    expect(update.voice).toBe('ash');
+    // agent-specific values still take precedence over the base config
+    expect(update.instructions).toBe('You are Bob');
+  });
+
