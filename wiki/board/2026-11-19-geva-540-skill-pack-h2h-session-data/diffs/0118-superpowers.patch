+package io.agentscope.harness.agent.filesystem;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.agentscope.core.agent.RuntimeContext;
+import io.agentscope.harness.agent.filesystem.model.FileInfo;
+import io.agentscope.harness.agent.filesystem.model.GlobResult;
+import io.agentscope.harness.agent.filesystem.remote.RemoteFilesystem;
+import io.agentscope.harness.agent.filesystem.remote.store.InMemoryStore;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+class RemoteFilesystemGlobTest {
+
+    private static final RuntimeContext RT = RuntimeContext.empty();
+
+    private RemoteFilesystem newFs() {
+        RemoteFilesystem fs = new RemoteFilesystem(new InMemoryStore(), List.of("test"));
+        assertTrue(fs.write(RT, "/hello.txt", "hello").isSuccess());
+        assertTrue(fs.write(RT, "/reports/hello.txt", "hello").isSuccess());
+        assertTrue(fs.write(RT, "/reports/report.txt", "r").isSuccess());
+        assertTrue(fs.write(RT, "/reports/archive/hello.txt", "hello").isSuccess());
+        assertTrue(fs.write(RT, "/notes.md", "n").isSuccess());
+        return fs;
+    }
+
+    private static List<String> paths(GlobResult r) {
+        assertTrue(r.isSuccess());
+        return r.matches().stream().map(FileInfo::path).toList();
+    }
+
+    @Test
+    void recursiveGlobMatchesFileAtRoot() {
+        RemoteFilesystem fs = newFs();
+        assertEquals(
+                List.of("/hello.txt", "/reports/archive/hello.txt", "/reports/hello.txt"),
+                paths(fs.glob(RT, "**/hello.txt", "/")));
+    }
+
+    @Test
+    void recursiveWildcardGlobMatchesFileAtRoot() {
+        RemoteFilesystem fs = newFs();
+        assertEquals(
+                List.of(
+                        "/hello.txt",
+                        "/reports/archive/hello.txt",
+                        "/reports/hello.txt",
+                        "/reports/report.txt"),
+                paths(fs.glob(RT, "**/*.txt", "/")));
+    }
+
+    @Test
+    void recursiveGlobMatchesFileAtSubdirectoryRoot() {
+        RemoteFilesystem fs = newFs();
+        assertEquals(
+                List.of("/reports/archive/hello.txt", "/reports/hello.txt"),
+                paths(fs.glob(RT, "**/hello.txt", "/reports")));
+    }
+}
