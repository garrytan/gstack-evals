diff --git a/pkg/verify/tlog_test.go b/pkg/verify/tlog_test.go
index 25859ae..6e1a3e8 100644
--- a/pkg/verify/tlog_test.go
+++ b/pkg/verify/tlog_test.go
@@ -196,6 +196,63 @@ func TestDuplicateTlogEntries(t *testing.T) {
 	assert.ErrorContains(t, err, "duplicate tlog entries found") // duplicate tlog entries should fail to verify
 }
 
+// sameLogTwoIndicesEntity returns two distinct entries (different log
+// indices) that were both signed by the same transparency log.
+type sameLogTwoIndicesEntity struct {
+	*ca.TestEntity
+	vs *ca.VirtualSigstore
+}
+
+func (e *sameLogTwoIndicesEntity) TlogEntries() ([]*tlog.Entry, error) {
+	entries, err := e.TestEntity.TlogEntries()
+	if err != nil {
+		return nil, err
+	}
+	orig := entries[0]
+	body := orig.Body().(string)
+	logID, err := e.vs.RekorLogID()
+	if err != nil {
+		return nil, err
+	}
+	set, err := e.vs.RekorSignPayload(tlog.RekorPayload{
+		Body:           body,
+		IntegratedTime: orig.IntegratedTime().Unix(),
+		LogIndex:       orig.LogIndex() + 1,
+		LogID:          logID,
+	})
+	if err != nil {
+		return nil, err
+	}
+	bodyRaw, err := base64.StdEncoding.DecodeString(body)
+	if err != nil {
+		return nil, err
+	}
+	forged, err := tlog.NewEntry(bodyRaw, orig.IntegratedTime().Unix(), orig.LogIndex()+1, []byte(orig.LogKeyID()), set, nil) //nolint:staticcheck
+	if err != nil {
+		return nil, err
+	}
+	return []*tlog.Entry{orig, forged}, nil
+}
+
+func TestTlogThresholdCountsUniqueLogs(t *testing.T) {
+	virtualSigstore, err := ca.NewVirtualSigstore()
+	assert.NoError(t, err)
+
+	statement := []byte(`{"_type":"https://in-toto.io/Statement/v0.1","predicateType":"customFoo","subject":[{"name":"subject","digest":{"sha256":"deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"}}],"predicate":{}}`)
+	entity, err := virtualSigstore.Attest("foo@example.com", "issuer", statement)
+	assert.NoError(t, err)
+
+	e := &sameLogTwoIndicesEntity{entity, virtualSigstore}
+
+	// threshold of 1 is satisfied
+	_, err = verify.VerifyTlogEntry(e, virtualSigstore, 1, true)
+	assert.NoError(t, err)
+
+	// a single log must not satisfy a threshold of 2, even with two entries
+	_, err = verify.VerifyTlogEntry(e, virtualSigstore, 2, true)
+	assert.ErrorContains(t, err, "not enough verified log entries from transparency log")
+}
+
 type tooManyTlogEntriesEntity struct {
 	*ca.TestEntity
 }
