diff --git a/cipher/cbc_hmac_test.go b/cipher/cbc_hmac_test.go
index 88b2145..f58b028 100644
--- a/cipher/cbc_hmac_test.go
+++ b/cipher/cbc_hmac_test.go
@@ -528,3 +528,28 @@ func BenchmarkDecryptAES256_CBCHMAC_1MB(b *testing.B) {
 func BenchmarkDecryptAES256_CBCHMAC_64MB(b *testing.B) {
 	benchDecryptCBCHMAC(b, 32, 67108864)
 }
+
+func TestOpenEmptyCiphertextNoPanic(t *testing.T) {
+	key := make([]byte, 32)
+	aead, err := NewCBCHMAC(key, aes.NewCipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	nonce := make([]byte, aead.NonceSize())
+	aad := []byte("aad")
+
+	// Empty ciphertext with a valid tag for it.
+	tag := aead.(*cbcAEAD).computeAuthTag(aad, nonce, nil)
+	if _, err := aead.Open(nil, nonce, tag, aad); err == nil {
+		t.Error("expected error on empty ciphertext")
+	}
+
+	// Wrong nonce length must not panic.
+	if _, err := aead.Open(nil, []byte{1, 2, 3}, make([]byte, 64), aad); err == nil {
+		t.Error("expected error on bad nonce length")
+	}
+
+	if _, err := unpadBuffer(nil, 16); err == nil {
+		t.Error("expected error on empty buffer")
+	}
+}
