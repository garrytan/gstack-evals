@@ -0,0 +1,59 @@
+package tools.jackson.databind.convert;
+
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.exc.InvalidDefinitionException;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import static tools.jackson.databind.testutil.DatabindTestUtil.newJsonMapper;
+
+/**
+ * Tests to verify that existing instances of local/anonymous classes
+ * can be updated, even though they cannot be instantiated.
+ */
+public class UpdateLocalClassTest
+{
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testUpdateAnonymousClass() throws Exception
+    {
+        Object ob = new Object() {
+            public int value;
+
+            @Override
+            public String toString() { return String.valueOf(value); }
+        };
+        Object result = MAPPER.readerForUpdating(ob).readValue("{\"value\": 2}");
+        assertSame(ob, result);
+        assertEquals("2", ob.toString());
+    }
+
+    @Test
+    public void testUpdateLocalClass() throws Exception
+    {
+        class Local {
+            public int x;
+            public String name;
+        }
+        Local local = new Local();
+        Local result = MAPPER.readerForUpdating(local).readValue("{\"x\":3,\"name\":\"foo\"}");
+        assertSame(local, result);
+        assertEquals(3, local.x);
+        assertEquals("foo", local.name);
+    }
+
+    // But creating new instances should still fail
+    @Test
+    public void testCannotCreateLocalClass() throws Exception
+    {
+        class Local {
+            public int x;
+        }
+        InvalidDefinitionException e = assertThrows(InvalidDefinitionException.class,
+                () -> MAPPER.readValue("{\"x\":3}", Local.class));
+        assertTrue(e.getMessage().contains("Cannot construct instance"), e.getMessage());
+    }
+}
