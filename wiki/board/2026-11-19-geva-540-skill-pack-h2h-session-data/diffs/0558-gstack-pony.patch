+++ b/internal/tui/components/detailedit/controller_test.go
@@ -338,3 +338,18 @@ func TestUnassignModeDoesNotUseAutocomplete(t *testing.T) {
 
 	require.False(t, c.usesAutocomplete())
 }
+
+func TestPasteInsertsTextIntoInputBox(t *testing.T) {
+	c := newTestController(t)
+	c, _ = c.Enter(EnterOptions{
+		Mode:       ModeComment,
+		Prompt:     "comment",
+		Repo:       testRepo(),
+		EnterFetch: FetchNone,
+	})
+
+	c, _, _, handled := c.Update(tea.PasteMsg{Content: "this should paste into gh-dash"})
+
+	require.True(t, handled)
+	require.Equal(t, "this should paste into gh-dash", c.inputBox.Value())
+}
