+                    builder.AddAttribute(7, nameof(TableColumn<Foo, int>.Fixed), true);
+                    builder.CloseComponent();
+                });
+            });
+        });
+
+        // fixed column without width uses DefaultFixedColumnWidth for colgroup and left offset
+        var cols = cut.FindAll("colgroup col");
