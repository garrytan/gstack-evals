+TEST("actor shells may call quit from a response handler") {
+  scoped_actor self{sys};
+  auto self_hdl = actor_cast<actor>(self);
+  auto cb = [self_hdl](app_t* app) {
+    app->self->mail(get_atom_v)
+      .request(self_hdl, 10ms)
+      .then([](const std::string&) {},
+            [app, self_hdl](const error& err) {
+              app->self->quit(err);
+              anon_mail(err).send(self_hdl);
+            });
+  };
+  auto& mpx = sys.network_manager().mpx();
+  auto app = app_t::make(actor{self}, cb);
+  auto transport = net::octet_stream::transport::make(fd1, std::move(app));
+  auto mgr = net::socket_manager::make(&mpx, std::move(transport));
+  require(mpx.start(mgr));
+  fd1.id = net::invalid_socket_id;
+  // Receive the handle of the shell and the request, but never respond.
+  self->receive([](actor&) {},
+                after(1s) >> [this] { fail("shell did not send its handle"); });
+  response_promise pending;
+  self->receive([&](get_atom) { pending = self->make_response_promise(); },
+                after(1s) >> [this] { fail("shell did not send a request"); });
+  self->receive(
+    [this](const error& err) { check_eq(err, sec::request_timeout); },
+    after(1s) >> [this] { fail("shell did not report the timeout"); });
+}
