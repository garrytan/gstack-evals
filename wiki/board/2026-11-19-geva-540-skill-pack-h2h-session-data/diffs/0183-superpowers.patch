diff --git a/test/sql/window/test_volatile_dedup.test b/test/sql/window/test_volatile_dedup.test
new file mode 100644
index 0000000..ccb1f41
--- /dev/null
+++ b/test/sql/window/test_volatile_dedup.test
@@ -0,0 +1,63 @@
+# name: test/sql/window/test_volatile_dedup.test
+# description: Identical aggregate/window expressions over volatile inputs must not be deduplicated
+# group: [window]
+
+statement ok
+PRAGMA enable_verification
+
+# window aggregate over full partition (rewritten to aggregate + self join)
+query I
+SELECT bool_or(id_a = id_b) FROM (
+	SELECT g,
+		any_value(uuid()::VARCHAR) OVER (PARTITION BY g) AS id_a,
+		any_value(uuid()::VARCHAR) OVER (PARTITION BY g) AS id_b
+	FROM (VALUES (1), (1), (2), (2)) t(g)
+);
+----
+false
+
+# framed window aggregate (physical window operator)
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT
+		sum(random()) OVER (ORDER BY g ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS a,
+		sum(random()) OVER (ORDER BY g ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS b
+	FROM range(10) t(g)
+);
+----
+false
+
+query I
+SELECT count(DISTINCT x) FROM (
+	SELECT
+		first(uuid()) OVER (PARTITION BY g ORDER BY g) AS a,
+		first(uuid()) OVER (PARTITION BY g ORDER BY g) AS b
+	FROM (VALUES (1), (1), (2), (2)) t(g)
+) UNPIVOT (x FOR c IN (a, b));
+----
+4
+
+# regular aggregates
+query I
+SELECT any_value(uuid()::VARCHAR) = any_value(uuid()::VARCHAR) FROM (VALUES (1), (1), (2), (2)) t(g);
+----
+false
+
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT g, any_value(gen_random_uuid()) AS a, any_value(gen_random_uuid()) AS b
+	FROM (VALUES (1), (1), (2), (2)) t(g) GROUP BY g
+);
+----
+false
+
+# non-volatile duplicates are still deduplicated and correct
+query I
+SELECT sum(g) = sum(g) FROM range(3) t(g);
+----
+true
+
+query I
+SELECT bool_and(a = b) FROM (SELECT sum(g) OVER () a, sum(g) OVER () b FROM range(3) t(g));
+----
+true
