diff --git a/tests/features/embeddables/nested-inline-null-parent.test.ts b/tests/features/embeddables/nested-inline-null-parent.test.ts
new file mode 100644
index 0000000..c85c851
--- /dev/null
+++ b/tests/features/embeddables/nested-inline-null-parent.test.ts
@@ -0,0 +1,67 @@
+import { MikroORM } from '@mikro-orm/sqlite';
+import {
+  Embeddable,
+  Embedded,
+  Entity,
+  PrimaryKey,
+  Property,
+  ReflectMetadataProvider,
+} from '@mikro-orm/decorators/legacy';
+
+@Embeddable()
+class Inner {
+  @Property({ nullable: true })
+  value?: string;
+}
+
+@Embeddable()
+class Outer {
+  @Property({ nullable: true })
+  label?: string;
+
+  @Embedded(() => Inner, { nullable: true })
+  inner?: Inner | null;
+}
+
+@Entity()
+class Holder {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Outer, { nullable: true })
+  outer?: Outer | null;
+}
+
+let orm: MikroORM;
+
+beforeAll(async () => {
+  orm = await MikroORM.init({
+    entities: [Holder],
+    dbName: ':memory:',
+    metadataProvider: ReflectMetadataProvider,
+  });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+
+test('nested inline embeddable columns are nulled when parent is set to null', async () => {
+  const outer = new Outer();
+  outer.label = 'a';
+  outer.inner = new Inner();
+  outer.inner.value = 'b';
+  const h = orm.em.create(Holder, { id: 1, outer });
+  await orm.em.flush();
+
+  h.outer = null;
+  await orm.em.flush();
+  orm.em.clear();
+
+  const h1 = await orm.em.findOneOrFail(Holder, 1);
+  expect(h1.outer).toBeNull();
+
+  const h2 = orm.em.create(Holder, { id: 2, outer: null });
+  await orm.em.flush();
+  orm.em.clear();
+  expect((await orm.em.findOneOrFail(Holder, 2)).outer).toBeNull();
+});
