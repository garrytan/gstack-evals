+
+    private static byte[] Build8BitMonoAiff(byte[] audio)
+    {
+        var ms = new MemoryStream();
+        var bw = new BinaryWriter(ms);
+        void BE32(int v) { bw.Write((byte)(v >> 24)); bw.Write((byte)(v >> 16)); bw.Write((byte)(v >> 8)); bw.Write((byte)v); }
+        void BE16(short v) { bw.Write((byte)(v >> 8)); bw.Write((byte)v); }
+        bw.Write(System.Text.Encoding.ASCII.GetBytes("FORM"));
+        BE32(4 + 26 + 16 + audio.Length);
+        bw.Write(System.Text.Encoding.ASCII.GetBytes("AIFF"));
+        bw.Write(System.Text.Encoding.ASCII.GetBytes("COMM"));
+        BE32(18);
+        BE16(1); // channels
+        BE32(audio.Length); // sample frames
+        BE16(8); // sample size
+        // 44100 as 80-bit extended
+        bw.Write(new byte[] { 0x40, 0x0E, 0xAC, 0x44, 0, 0, 0, 0, 0, 0 });
+        bw.Write(System.Text.Encoding.ASCII.GetBytes("SSND"));
+        BE32(8 + audio.Length);
+        BE32(0); // offset
+        BE32(0); // block size
+        bw.Write(audio);
+        bw.Flush();
+        return ms.ToArray();
+    }
+
+    [Test]
+    [Category("UnitTest")]
+    public void EightBitAiffIsReadAsSigned()
+    {
+        byte[] audio = { 0x0A, 0x0A, 0x80, 0x83, 0x85, 0x88, 0x7F, 0x00 };
+        using var reader = new AiffFileReader(new MemoryStream(Build8BitMonoAiff(audio)));
+        var samples = new float[audio.Length];
+        int read = reader.ToSampleProvider().Read(samples.AsSpan());
+        Assert.That(read, Is.EqualTo(audio.Length));
+        float[] expected = { 0.078125f, 0.078125f, -1f, -0.9765625f, -0.9609375f, -0.9375f, 127 / 128f, 0f };
+        Assert.That(samples, Is.EqualTo(expected));
+    }
