+    [Test]
+    public void EightBitDataIsWrittenSignedAndRoundTrips()
+    {
+        var ms = new MemoryStream();
+        var unsignedData = new byte[] { 0x80, 0x00, 0xFF, 0x8A };
+        using (var writer = new AiffFileWriter(new IgnoreDisposeStream(ms), new WaveFormat(8000, 8, 1)))
+        {
+            writer.Write(unsignedData, 0, unsignedData.Length);
+        }
+        var bytes = ms.ToArray();
+        // signed AIFF bytes are at the end of the file
+        Assert.That(bytes[^4..], Is.EqualTo(new byte[] { 0x00, 0x80, 0x7F, 0x0A }));
+        ms.Position = 0;
+        using var reader = new AiffFileReader(ms);
+        var buffer = new byte[4];
+        Assert.That(reader.Read(buffer, 0, 4), Is.EqualTo(4));
+        Assert.That(buffer, Is.EqualTo(unsignedData));
+    }
 }
