+// normalizedMethod clamps the HTTP method to a fixed allowlist so that
+// arbitrary client-supplied methods cannot create unbounded metric series.
+func normalizedMethod(method string) string {
+	switch method {
+	case http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete,
+		http.MethodOptions, http.MethodHead, http.MethodConnect, http.MethodTrace:
+		return method
+	default:
+		return "other"
+	}
+}
