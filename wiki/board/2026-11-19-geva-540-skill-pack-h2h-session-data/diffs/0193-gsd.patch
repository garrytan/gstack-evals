+    [TestCase(16)]
+    [TestCase(24)]
+    [TestCase(32)]
+    public void AudioFileReader_MonoExtensibleWav_CopyToReadsWholeFile(int bitsPerSample)
+    {
+        // 16 seconds of 8kHz mono audio stored as WAVE_FORMAT_EXTENSIBLE (PCM / IEEE float subformat)
+        const int sampleRate = 8000;
+        const int seconds = 16;
+        var tmp = Path.Combine(Path.GetTempPath(), "naudio-ext-test-" + Guid.NewGuid() + ".wav");
+        try
+        {
+            using (var writer = new WaveFileWriter(tmp, new WaveFormatExtensible(sampleRate, bitsPerSample, 1)))
+            {
+                for (int i = 0; i < sampleRate * seconds; i++)
+                    writer.WriteSample((float)Math.Sin(2 * Math.PI * 440.0 * i / sampleRate) * 0.5f);
+            }
+
+            using var reader = new AudioFileReader(tmp);
+            Assert.That(reader.WaveFormat.Encoding, Is.EqualTo(WaveFormatEncoding.IeeeFloat));
+            Assert.That(reader.WaveFormat.Channels, Is.EqualTo(1));
+            Assert.That(reader.WaveFormat.SampleRate, Is.EqualTo(sampleRate));
+            Assert.That(reader.TotalTime, Is.EqualTo(TimeSpan.FromSeconds(seconds)));
+
+            var output = new MemoryStream();
+            reader.CopyTo(output);
+            Assert.That(output.Length, Is.EqualTo(sampleRate * seconds * 4L));
+        }
+        finally
+        {
+            File.Delete(tmp);
+        }
+    }
+
