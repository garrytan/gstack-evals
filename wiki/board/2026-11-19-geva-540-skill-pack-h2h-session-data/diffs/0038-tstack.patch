+    @Test
+    @DisplayName("targeted user interrupt returns GenerateReason.INTERRUPTED and isolates sessions")
+    void targetedUserInterruptReturnsInterruptedReason() throws Exception {
+        InMemoryAgentStateStore store = new InMemoryAgentStateStore();
+        CountDownLatch subscribed = new CountDownLatch(2);
+        ReActAgent agent =
+                ReActAgent.builder()
+                        .name("asst")
+                        .sysPrompt("hi")
+                        .model(new DelayedFirstChunkModel(subscribed))
+                        .stateStore(store)
+                        .build();
+
+        CompletableFuture<Msg> target =
+                agent.call(
+                                List.of(userMsg("hello")),
+                                RuntimeContext.builder().userId("u1").sessionId("sessA").build())
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+        CompletableFuture<Msg> bystander =
+                agent.call(
+                                List.of(userMsg("other")),
+                                RuntimeContext.builder().userId("u1").sessionId("sessB").build())
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+
+        assertTrue(subscribed.await(5, TimeUnit.SECONDS), "both model streams should start");
+        agent.interrupt("u1", "sessA", new UserMessage("stop"));
+
+        Msg reply = target.get(5, TimeUnit.SECONDS);
+        assertEquals(GenerateReason.INTERRUPTED, reply.getGenerateReason());
+        assertEquals(
+                "I noticed that you have interrupted me. What can I do for you?",
+                reply.getTextContent());
+
+        Msg other = bystander.get(5, TimeUnit.SECONDS);
+        assertEquals(GenerateReason.MODEL_STOP, other.getGenerateReason());
+        assertEquals("model reply", other.getTextContent());
+
+        ReActAgent reborn = agent(store);
+        assertTrue(
+                allText(reborn.getAgentState("u1", "sessA"))
+                        .contains("I noticed that you have interrupted me. What can I do for you?"),
+                "interrupt recovery message should be persisted");
+        assertFalse(
+                allText(reborn.getAgentState("u1", "sessB"))
+                        .contains("I noticed that you have interrupted me. What can I do for you?"),
+                "interrupt must not leak into another session");
+    }
+
     private static final class DelayedFirstChunkModel extends ChatModelBase {
         private final CountDownLatch subscribed;
 
