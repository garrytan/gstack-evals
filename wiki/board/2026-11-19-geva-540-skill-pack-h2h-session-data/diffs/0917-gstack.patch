 import { createGraphQLError } from '../error.js';
 
+// Strict E.164: a leading "+", a non-zero first digit and 7-15 digits in total.
+// SECURITY: this pattern must stay free of ambiguous/nested quantifiers. The
+// pattern used in graphql-scalars 1.24.1 - 2.0.0
+// (/^\+?\d{1,3}(\-|\x20)?\(?\d+\)?((\-|\x20)?\d+)+$/) backtracked
+// exponentially on inputs such as "1".repeat(30) + "x" (ReDoS,
+// GHSA-x8rm-f576-gq67). Since this regex runs during document validation and
+// variable coercion, i.e. before any auth, it must always run in linear time.
 const PHONE_NUMBER_REGEX = /^\+[1-9]\d{6,14}$/;
 
 export const GraphQLPhoneNumber = /*#__PURE__*/ new GraphQLScalarType({
