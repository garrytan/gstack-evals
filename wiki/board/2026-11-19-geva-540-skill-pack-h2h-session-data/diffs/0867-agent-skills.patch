+type errUnmarshaler struct{}
+
+func (errUnmarshaler) UnmarshalTOML(*unstable.Node) error {
+	return errors.New("called")
+}
+
+func TestUnmarshal_CustomUnmarshalerTable(t *testing.T) {
+	type cfg struct {
+		Name string
+		Tbl  orderedRecorder
+		Ptr  *orderedRecorder
+		Arr  []orderedRecorder
+	}
+	input := `name = "x"
+[tbl]
+b = 1
+a = 2
+[ptr]
+c = 3
+[[arr]]
+d = 4
+[[arr]]
+e = 5
+`
+	var c cfg
+	err := toml.NewDecoder(strings.NewReader(input)).EnableUnmarshalerInterface().Decode(&c)
+	assert.NoError(t, err)
+	assert.Equal(t, "x", c.Name)
+	assert.Equal(t, []string{"KeyValue:b=1", "KeyValue:a=2"}, c.Tbl.Entries)
+	assert.True(t, c.Ptr != nil)
+	assert.Equal(t, []string{"KeyValue:c=3"}, c.Ptr.Entries)
+	assert.Equal(t, 2, len(c.Arr))
+	assert.Equal(t, []string{"KeyValue:d=4"}, c.Arr[0].Entries)
+	assert.Equal(t, []string{"KeyValue:e=5"}, c.Arr[1].Entries)
+}
+
+func TestUnmarshal_CustomUnmarshalerTableDisabled(t *testing.T) {
+	var r orderedRecorder
+	err := toml.NewDecoder(strings.NewReader(`entries = ["a"]`)).Decode(&r)
+	assert.NoError(t, err)
+	assert.Equal(t, []string{"a"}, r.Entries)
+}
