+type orderedRecorder struct {
+	Entries []string
+}
+
+func (r *orderedRecorder) UnmarshalTOML(node *unstable.Node) error {
+	var parts []string
+	it := node.Key()
+	for it.Next() {
+		parts = append(parts, string(it.Node().Data))
+	}
+	entry := node.Kind.String() + ":" + strings.Join(parts, ".")
+	if node.Kind == unstable.KeyValue {
+		entry += "=" + string(node.Value().Data)
+	}
+	r.Entries = append(r.Entries, entry)
+	return nil
+}
+
+func TestUnmarshal_CustomUnmarshalerRootDocument(t *testing.T) {
+	input := `b = "1"
+a = "2"
+[t]
+z = "3"
+[[arr]]
+y = "4"
+`
+	var r orderedRecorder
+	err := toml.NewDecoder(strings.NewReader(input)).EnableUnmarshalerInterface().Decode(&r)
+	assert.NoError(t, err)
+	assert.Equal(t, []string{
+		"KeyValue:b=1",
+		"KeyValue:a=2",
+		"Table:t",
+		"KeyValue:z=3",
+		"ArrayTable:arr",
+		"KeyValue:y=4",
+	}, r.Entries)
+}
+
+func TestUnmarshal_CustomUnmarshalerRootError(t *testing.T) {
+	var r errUnmarshaler
+	err := toml.NewDecoder(strings.NewReader(`foo = "bar"`)).EnableUnmarshalerInterface().Decode(&r)
+	assert.Error(t, err)
+}
