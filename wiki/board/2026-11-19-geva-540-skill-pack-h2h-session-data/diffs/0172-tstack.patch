+    [Test]
+    [Category("UnitTest")]
+    public void EightBitAiffSamplesAreReadAsSigned()
+    {
+        var raw = new byte[] { 0x0A, 0x0A, 0x80, 0x83, 0x85, 0x88, 0x8A, 0x8D, 0x8F, 0x92, 0x7F, 0x00 };
+        var expected = new[] { 0.078125f, 0.078125f, -1f, -0.9765625f, -0.9609375f, -0.9375f, -0.921875f, -0.8984375f, -0.8828125f, -0.859375f, 127 / 128f, 0f };
+        using var reader = new AiffFileReader(new MemoryStream(Build8BitMonoAiff(raw)));
+        var sp = reader.ToSampleProvider();
+        var samples = new float[raw.Length];
+        Assert.That(sp.Read(samples.AsSpan()), Is.EqualTo(raw.Length));
+        Assert.That(samples, Is.EqualTo(expected));
+    }
