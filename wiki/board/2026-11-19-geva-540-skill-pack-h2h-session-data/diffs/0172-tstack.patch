+    private static byte[] Build8BitMonoAiff(byte[] sampleData)
+    {
+        var ms = new MemoryStream();
+        var bw = new BinaryWriter(ms);
+        void Be32(int v) { bw.Write(new[] { (byte)(v >> 24), (byte)(v >> 16), (byte)(v >> 8), (byte)v }); }
+        bw.Write("FORM"u8.ToArray());
+        Be32(4 + 26 + 16 + sampleData.Length);
+        bw.Write("AIFF"u8.ToArray());
+        bw.Write("COMM"u8.ToArray());
+        Be32(18);
+        bw.Write(new byte[] { 0x00, 0x01 }); // channels
+        Be32(sampleData.Length); // frames
+        bw.Write(new byte[] { 0x00, 0x08 }); // sample size
+        bw.Write(new byte[] { 0x40, 0x0e, 0xac, 0x44, 0, 0, 0, 0, 0, 0 }); // 44100
+        bw.Write("SSND"u8.ToArray());
+        Be32(8 + sampleData.Length);
+        Be32(0);
+        Be32(0);
+        bw.Write(sampleData);
+        return ms.ToArray();
+    }
