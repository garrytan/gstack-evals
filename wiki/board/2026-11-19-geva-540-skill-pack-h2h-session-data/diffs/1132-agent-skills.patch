+func TestTlsConfigFromUriSetsExplicitMinVersion(t *testing.T) {
+	writeTemp := func(name, content string) string {
+		p := filepath.Join(t.TempDir(), name)
+		if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+			t.Fatalf("write %s: %v", name, err)
+		}
+		return p
+	}
+
+	tests := map[string]URI{
+		"server auth only": {Scheme: "amqps", Host: "example.com", Port: 5671},
+		"mutual TLS": {
+			Scheme:     "amqps",
+			Host:       "example.com",
+			Port:       5671,
+			CACertFile: writeTemp("ca.pem", caCert),
+			CertFile:   writeTemp("cert.pem", clientCert),
+			KeyFile:    writeTemp("key.pem", clientKey),
+		},
+	}
+
+	for name, uri := range tests {
+		t.Run(name, func(t *testing.T) {
+			cfg, err := tlsConfigFromURI(uri)
+			if err != nil {
+				t.Fatalf("expected tlsConfigFromURI to succeed, got error: %s", err)
+			}
+			if cfg.MinVersion < tls.VersionTLS12 {
+				t.Fatalf("expected MinVersion >= TLS 1.2 (%#x), got %#x", tls.VersionTLS12, cfg.MinVersion)
+			}
+		})
+	}
+}
