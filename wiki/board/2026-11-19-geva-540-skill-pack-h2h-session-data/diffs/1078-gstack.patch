 		QUICConfig: &quic.Config{
 			Allow0RTT: false,
 		},
@@ -79,6 +81,47 @@ func newHTTP3Server(ctx context.Context, configuration *static.EntryPoint, https
 	return h3, nil
 }
 
+func idleTimeout(transport *static.EntryPointsTransport) time.Duration {
+	if transport == nil || transport.RespondingTimeouts == nil {
+		return 0
+	}
+	return time.Duration(transport.RespondingTimeouts.IdleTimeout)
+}
+
+// withRespondingTimeouts enforces the respondingTimeouts read and write timeouts on HTTP/3 requests,
+// by setting deadlines on the underlying QUIC stream, as there is no TCP connection deadline to rely on.
+func withRespondingTimeouts(ctx context.Context, handler http.Handler, transport *static.EntryPointsTransport) http.Handler {
+	if transport == nil || transport.RespondingTimeouts == nil {
+		return handler
+	}
+
+	readTimeout := time.Duration(transport.RespondingTimeouts.ReadTimeout)
+	writeTimeout := time.Duration(transport.RespondingTimeouts.WriteTimeout)
+
+	if readTimeout <= 0 && writeTimeout <= 0 {
+		return handler
+	}
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		rc := http.NewResponseController(rw)
+		now := time.Now()
+
+		if readTimeout > 0 {
+			if err := rc.SetReadDeadline(now.Add(readTimeout)); err != nil {
+				log.FromContext(ctx).Errorf("Error setting HTTP/3 read deadline: %v", err)
+			}
+		}
+
+		if writeTimeout > 0 {
+			if err := rc.SetWriteDeadline(now.Add(writeTimeout)); err != nil {
+				log.FromContext(ctx).Errorf("Error setting HTTP/3 write deadline: %v", err)
+			}
+		}
+
+		handler.ServeHTTP(rw, req)
+	})
+}
+
 func (e *http3server) Start() error {
 	return e.Serve(e.http3conn)
 }
