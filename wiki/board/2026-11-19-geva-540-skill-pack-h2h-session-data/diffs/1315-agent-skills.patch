+
+func TestSecurityPolicyAllowContent(t *testing.T) {
+	c := qt.New(t)
+
+	const filesTemplate = `
+-- hugo.toml --
+baseURL = "https://example.org"
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+CONFIG
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert("xss")</script>
+-- content/p2.md --
+---
+title: p2
+---
+**markdown**
+-- layouts/home.html --
+home
+-- layouts/single.html --
+{{ .Title }}|{{ .Content }}|
+`
+
+	c.Run("HTML content file, denied by default", func(c *qt.C) {
+		c.Parallel()
+		files := strings.ReplaceAll(filesTemplate, "CONFIG", "")
+		_, err := TestE(c, files)
+		c.Assert(err, qt.IsNotNil)
+		c.Assert(err, qt.ErrorMatches, `(?s).*"text/html" is not whitelisted in policy "security\.allowContent".*`)
+	})
+
+	c.Run("HTML content file, allowed", func(c *qt.C) {
+		c.Parallel()
+		files := strings.ReplaceAll(filesTemplate, "CONFIG", "[security]\nallowContent = ['.*']")
+		b := Test(c, files)
+		b.AssertFileContent("public/p1/index.html", `p1|<script>alert("xss")</script>`)
+		b.AssertFileContent("public/p2/index.html", "p2|<p><strong>markdown</strong></p>")
+	})
+
+	c.Run("Markdown content, allowed by default", func(c *qt.C) {
+		c.Parallel()
+		files := strings.ReplaceAll(filesTemplate, "CONFIG", "")
+		files = strings.Replace(files, "-- content/p1.html --\n---\ntitle: p1\n---\n<script>alert(\"xss\")</script>\n", "", 1)
+		c.Assert(files, qt.Not(qt.Contains), "p1.html")
+		b := Test(c, files)
+		b.AssertFileContent("public/p2/index.html", "p2|<p><strong>markdown</strong></p>")
+	})
+
+	c.Run("Content adapter with text/html, denied by default", func(c *qt.C) {
+		c.Parallel()
+		files := `
+-- hugo.toml --
+baseURL = "https://example.org"
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+-- content/_content.gotmpl --
+{{ $content := dict "mediaType" "text/html" "value" "<script>alert('xss')</script>" }}
+{{ .AddPage (dict "path" "a1" "title" "a1" "content" $content) }}
+-- layouts/home.html --
+home
+-- layouts/single.html --
+{{ .Title }}|{{ .Content }}|
+`
+		_, err := TestE(c, files)
+		c.Assert(err, qt.IsNotNil)
+		c.Assert(err, qt.ErrorMatches, `(?s).*"text/html" is not whitelisted in policy "security\.allowContent".*`)
+	})
+}
