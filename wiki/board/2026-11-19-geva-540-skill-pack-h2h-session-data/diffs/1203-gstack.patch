+func TestEcho_StaticFS_encodedSlashDoesNotBypassRouteProtection(t *testing.T) {
+	e := New()
+	g := e.Group("/folder", func(next HandlerFunc) HandlerFunc {
+		return func(c *Context) error { return ErrForbidden }
+	})
+	g.StaticFS("/", os.DirFS("_fixture/folder"))
+	e.StaticFS("/", os.DirFS("_fixture"))
+
+	for _, u := range []string{"/folder/index.html", "/folder%2Findex.html", "/folder%2findex.html", "/folder%5Cindex.html"} {
+		req := httptest.NewRequest(http.MethodGet, u, nil)
+		rec := httptest.NewRecorder()
+		e.ServeHTTP(rec, req)
+		assert.NotEqual(t, http.StatusOK, rec.Code, u)
+	}
+}
