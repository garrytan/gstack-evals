+// containsEncodedPathSeparator checks if the path contains percent-encoded slash (`%2F`) or backslash (`%5C`).
+func containsEncodedPathSeparator(p string) bool {
+	for i := 0; i+2 < len(p); i++ {
+		if p[i] != '%' {
+			continue
+		}
+		if p[i+1] == '2' && (p[i+2] == 'f' || p[i+2] == 'F') {
+			return true
+		}
+		if p[i+1] == '5' && (p[i+2] == 'c' || p[i+2] == 'C') {
+			return true
+		}
+	}
+	return false
+}
