diff --git a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
index f84b0da..c913af0 100644
--- a/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
+++ b/Tests/UnitTestsParallelizable/Views/OptionSelectorTests.cs
@@ -1069,4 +1069,56 @@ public class OptionSelectorTests
     }
 
     #endregion
+
+    // Claude - Opus 5.5
+    [Theory]
+    [InlineData (true, true)]
+    [InlineData (true, false)]
+    [InlineData (false, true)]
+    [InlineData (false, false)]
+    public void Horizontal_Labels_Set_After_Construction_Width_Fits_All_Labels_On_First_Layout (bool setValues, bool initiallyHidden)
+    {
+        View superView = new () { Width = 80, Height = 10 };
+
+        OptionSelector selector = new () { Y = 2, Orientation = Orientation.Horizontal };
+        superView.Add (selector);
+
+        if (initiallyHidden)
+        {
+            selector.Visible = false;
+            superView.Layout ();
+        }
+
+        selector.Labels = ["IMDb (Recommended)", "TMDb"];
+
+        if (setValues)
+        {
+            selector.Values = [0, 1];
+        }
+
+        selector.Visible = true;
+        superView.Layout ();
+
+        CheckBox [] cbs = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (2, cbs.Length);
+
+        // "◉ IMDb (Recommended)" (20) + 2 margin, "○ TMDb" (6)
+        Assert.Equal (22, cbs [1].Frame.X);
+        Assert.Equal (6, cbs [1].Frame.Width);
+        Assert.Equal (28, selector.Frame.Width);
+    }
+
+    // Claude - Opus 5.5
+    [Fact]
+    public void Generic_Horizontal_Width_Fits_All_Labels_On_First_Layout ()
+    {
+        View superView = new () { Width = 80, Height = 10 };
+        OptionSelector<Orientation> selector = new () { Orientation = Orientation.Horizontal };
+        superView.Add (selector);
+        superView.Layout ();
+
+        CheckBox [] cbs = selector.SubViews.OfType<CheckBox> ().ToArray ();
+        Assert.Equal (cbs [^1].Frame.Right, selector.Frame.Width);
+        Assert.Equal (24, selector.Frame.Width);
+    }
 }
