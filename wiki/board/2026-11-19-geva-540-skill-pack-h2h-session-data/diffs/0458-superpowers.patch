@@ -0,0 +1,92 @@
+//go:build cgo
+
+package embeddeddolt_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/storage/embeddeddolt"
+	"github.com/steveyegge/beads/internal/types"
+)
+
+// TestIgnoredTablesRecreatedOnOpen verifies that dolt_ignore'd wisp tables
+// that are missing from the working set are recreated when the store is
+// opened, even though all schema migrations are already recorded as applied.
+func TestIgnoredTablesRecreatedOnOpen(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	ctx := t.Context()
+
+	beadsDir := filepath.Join(t.TempDir(), ".beads")
+	dataDir := filepath.Join(beadsDir, "embeddeddolt")
+	const dbName = "ig"
+
+	store, err := embeddeddolt.New(ctx, beadsDir, dbName, "main")
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if err := store.SetConfig(ctx, "issue_prefix", dbName); err != nil {
+		t.Fatalf("SetConfig: %v", err)
+	}
+	for _, id := range []string{"ig-a", "ig-b"} {
+		iss := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+		if err := store.CreateIssue(ctx, iss, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+	}
+	if err := store.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+
+	// Simulate a session where the ignored tables are absent.
+	db, cleanup, err := embeddeddolt.OpenSQL(ctx, dataDir, dbName, "main")
+	if err != nil {
+		t.Fatalf("OpenSQL: %v", err)
+	}
+	for _, tbl := range []string{"wisps", "wisp_labels", "wisp_dependencies", "wisp_events", "wisp_comments"} {
+		if _, err := db.ExecContext(ctx, "DROP TABLE IF EXISTS "+tbl); err != nil {
+			t.Fatalf("DROP %s: %v", tbl, err)
+		}
+	}
+	if err := cleanup(); err != nil {
+		t.Fatalf("cleanup: %v", err)
+	}
+
+	store, err = embeddeddolt.New(ctx, beadsDir, dbName, "main")
+	if err != nil {
+		t.Fatalf("New (reopen): %v", err)
+	}
+	t.Cleanup(func() { store.Close() })
+
+	dep := &types.Dependency{IssueID: "ig-b", DependsOnID: "ig-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency after reopen: %v", err)
+	}
+	if _, err := store.GetDependencies(ctx, "ig-b"); err != nil {
+		t.Fatalf("GetDependencies after reopen: %v", err)
+	}
+	if err := store.DeleteIssue(ctx, "ig-b"); err != nil {
+		t.Fatalf("DeleteIssue after reopen: %v", err)
+	}
+
+	db, cleanup, err = embeddeddolt.OpenSQL(ctx, dataDir, dbName, "main")
+	if err != nil {
+		t.Fatalf("OpenSQL (verify): %v", err)
+	}
+	defer cleanup()
+	var n int
+	if err := db.QueryRowContext(ctx,
+		"SELECT COUNT(*) FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = 'wisp_dependencies' AND index_name = 'idx_wisp_dep_type'").Scan(&n); err != nil {
+		t.Fatalf("query index: %v", err)
+	}
+	if n == 0 {
+		t.Errorf("idx_wisp_dep_type missing on recreated wisp_dependencies")
+	}
+	if err := db.QueryRowContext(ctx,
+		"SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name = 'wisps' AND column_name = 'no_history'").Scan(&n); err != nil {
+		t.Fatalf("query column: %v", err)
+	}
+	if n == 0 {
+		t.Errorf("no_history column missing on recreated wisps")
+	}
+}
diff --git a/internal/storage/embeddeddolt/store.go b/internal/storage/embeddeddolt/store.go
index d9f0dcc..65b6e6d 100644
--- a/internal/storage/embeddeddolt/store.go
+++ b/internal/storage/embeddeddolt/store.go
@@ -245,6 +245,13 @@ func (s *EmbeddedDoltStore) initSchema(ctx context.Context) error {
 				return fmt.Errorf("dolt commit after migrations: %w", err)
 			}
 		}
+		// Wisp tables are dolt_ignore'd, so they are not part of commit
+		// history and may be missing even when all migrations are recorded
+		// as applied (fresh clone, branch checkout, backfilled migrations).
+		// Recreate them on every open, like the server-mode store does.
+		if err := ensureIgnoredTables(ctx, tx); err != nil {
+			return fmt.Errorf("embeddeddolt: creating ignored tables: %w", err)
+		}
 		return nil
 	})
 }
