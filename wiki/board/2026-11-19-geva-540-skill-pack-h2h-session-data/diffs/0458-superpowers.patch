diff --git a/internal/storage/embeddeddolt/ignored_tables.go b/internal/storage/embeddeddolt/ignored_tables.go
new file mode 100644
index 0000000..3ccc1fe
--- /dev/null
+++ b/internal/storage/embeddeddolt/ignored_tables.go
@@ -0,0 +1,90 @@
+//go:build cgo
+
+package embeddeddolt
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+)
+
+// ignoredTableDDL lists, in order, the DDL needed to (re)create each
+// dolt_ignore'd wisp table at the current schema version. Each entry is the
+// embedded migration file(s) that create the table followed by statements
+// from later migrations that alter it.
+//
+// When adding a migration that alters a wisp table, add its statements here
+// as well so tables recreated in a new session match the migrated schema.
+var ignoredTableDDL = []struct {
+	table string
+	files []string
+	extra []string
+}{
+	{
+		table: "wisps",
+		files: []string{"0020_create_wisps.up.sql"},
+		extra: []string{"ALTER TABLE wisps ADD COLUMN no_history TINYINT(1) DEFAULT 0"},
+	},
+	{table: "wisp_labels", files: []string{"0021_create_wisp_auxiliary.up.sql"}},
+	{
+		table: "wisp_dependencies",
+		files: []string{"0021_create_wisp_auxiliary.up.sql", "0022_wisp_dep_type_index.up.sql"},
+	},
+	{table: "wisp_events", files: []string{"0021_create_wisp_auxiliary.up.sql"}},
+	{table: "wisp_comments", files: []string{"0021_create_wisp_auxiliary.up.sql"}},
+}
+
+// ensureIgnoredTables re-creates any missing dolt_ignore'd tables (wisps,
+// wisp_*). These tables live only in the working set and are not part of
+// commit history, so they may be absent even when every schema migration is
+// recorded as applied. Safe to call repeatedly (idempotent).
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	// Determine the missing set before creating anything: one migration file
+	// (0021) creates several tables, and follow-up DDL (e.g. 0022 indexes)
+	// must still run for every table that was originally missing.
+	var missing []int
+	for i, t := range ignoredTableDDL {
+		exists, err := tableExistsInTx(ctx, tx, t.table)
+		if err != nil {
+			return fmt.Errorf("checking %s: %w", t.table, err)
+		}
+		if !exists {
+			missing = append(missing, i)
+		}
+	}
+
+	ran := make(map[string]bool)
+	for _, i := range missing {
+		t := ignoredTableDDL[i]
+		for _, f := range t.files {
+			if ran[f] {
+				continue
+			}
+			ran[f] = true
+			data, err := upMigrations.ReadFile("schema/" + f)
+			if err != nil {
+				return fmt.Errorf("reading %s: %w", f, err)
+			}
+			if stmt := strings.TrimSpace(string(data)); stmt != "" {
+				if _, err := tx.ExecContext(ctx, stmt); err != nil {
+					return fmt.Errorf("creating %s (%s): %w", t.table, f, err)
+				}
+			}
+		}
+		for _, stmt := range t.extra {
+			if _, err := tx.ExecContext(ctx, stmt); err != nil {
+				return fmt.Errorf("migrating %s: %w", t.table, err)
+			}
+		}
+	}
+	return nil
+}
+
+func tableExistsInTx(ctx context.Context, tx *sql.Tx, table string) (bool, error) {
+	var n int
+	err := tx.QueryRowContext(ctx,
+		"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?",
+		table).Scan(&n)
+	return n > 0, err
+}
diff --git a/internal/storage/embeddeddolt/ignored_tables_test.go b/internal/storage/embeddeddolt/ignored_tables_test.go
