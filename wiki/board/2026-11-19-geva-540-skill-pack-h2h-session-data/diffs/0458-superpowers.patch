+
+// countReachableInTx counts how many times target is reachable from start by
+// following blocking edges across the given dependency tables (recursive CTE).
+func countReachableInTx(ctx context.Context, tx *sql.Tx, depTables []string, start, target string) (int, error) {
+	var unions []string
+	for _, t := range depTables {
+		//nolint:gosec // G201: depTables are caller-controlled constants
+		unions = append(unions, fmt.Sprintf("SELECT issue_id, depends_on_id FROM %s WHERE type IN ('blocks', 'conditional-blocks')", t))
+	}
+	unionQuery := strings.Join(unions, " UNION ALL ")
+
+	var reachable int
+	//nolint:gosec // G201: unionQuery built from caller-controlled table names
+	err := tx.QueryRowContext(ctx, fmt.Sprintf(`
+		WITH RECURSIVE reachable AS (
+			SELECT ? AS node, 0 AS depth
+			UNION ALL
+			SELECT d.depends_on_id, r.depth + 1
+			FROM reachable r
+			JOIN (%s) d ON d.issue_id = r.node
+			WHERE r.depth < 100
+		)
+		SELECT COUNT(*) FROM reachable WHERE node = ?
+	`, unionQuery), start, target).Scan(&reachable)
+	return reachable, err
+}
+
+// filterExistingTablesInTx returns the subset of tables that exist in the
+// current database, preserving order.
+func filterExistingTablesInTx(ctx context.Context, tx *sql.Tx, tables []string) ([]string, error) {
+	var existing []string
+	for _, t := range tables {
+		var n int
+		if err := tx.QueryRowContext(ctx,
+			"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = ?", t).Scan(&n); err != nil {
+			return nil, err
+		}
+		if n > 0 {
+			existing = append(existing, t)
+		}
+	}
+	return existing, nil
+}
