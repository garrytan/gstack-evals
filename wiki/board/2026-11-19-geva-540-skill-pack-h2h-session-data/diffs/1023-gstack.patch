+package openapi3
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestVisitJSONCircularXOf(t *testing.T) {
+	newSchema := func() *Schema {
+		return &Schema{
+			Type:       &Types{"object"},
+			Properties: Schemas{"name": {Value: &Schema{Type: &Types{"string"}}}},
+		}
+	}
+
+	t.Run("allOf", func(t *testing.T) {
+		s := newSchema()
+		s.AllOf = SchemaRefs{{Ref: "#/components/schemas/S", Value: s}}
+		require.NoError(t, s.Validate(context.Background()))
+		require.NoError(t, s.VisitJSON(map[string]any{"name": "test"}))
+		require.Error(t, s.VisitJSON(map[string]any{"name": 1}))
+	})
+
+	t.Run("anyOf", func(t *testing.T) {
+		s := newSchema()
+		s.AnyOf = SchemaRefs{{Ref: "#/components/schemas/S", Value: s}}
+		require.Error(t, s.VisitJSON(map[string]any{"name": "test"}))
+		s.AnyOf = append(s.AnyOf, &SchemaRef{Value: &Schema{}})
+		require.NoError(t, s.VisitJSON(map[string]any{"name": "test"}))
+	})
+
+	t.Run("oneOf", func(t *testing.T) {
+		s := newSchema()
+		s.OneOf = SchemaRefs{{Ref: "#/components/schemas/S", Value: s}}
+		require.Error(t, s.VisitJSON(map[string]any{"name": "test"}))
+		require.Error(t, s.VisitJSON(map[string]any{"name": "test"}, VisitAsRequest()))
+	})
+
+	t.Run("not", func(t *testing.T) {
+		s := newSchema()
+		s.Not = &SchemaRef{Ref: "#/components/schemas/S", Value: s}
+		require.Error(t, s.VisitJSON(map[string]any{"name": "test"}))
+	})
+
+	t.Run("indirect", func(t *testing.T) {
+		a, b := newSchema(), newSchema()
+		a.AllOf = SchemaRefs{{Ref: "#/components/schemas/B", Value: b}}
+		b.OneOf = SchemaRefs{{Ref: "#/components/schemas/A", Value: a}, {Value: &Schema{}}}
+		require.NoError(t, a.VisitJSON(map[string]any{"name": "test"}))
+	})
+
+	t.Run("recursive data still validated", func(t *testing.T) {
+		s := newSchema()
+		s.AllOf = SchemaRefs{{Ref: "#/components/schemas/S", Value: s}}
+		s.Properties["child"] = &SchemaRef{Ref: "#/components/schemas/S", Value: s}
+		require.NoError(t, s.VisitJSON(map[string]any{"name": "a", "child": map[string]any{"name": "b"}}))
+		require.Error(t, s.VisitJSON(map[string]any{"name": "a", "child": map[string]any{"name": 2}}))
+	})
+}
