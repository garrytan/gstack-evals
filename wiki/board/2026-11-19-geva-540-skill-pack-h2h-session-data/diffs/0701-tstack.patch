+using System.Collections.Specialized;
+
+using Quartz.Impl;
+using Quartz.Simpl;
+using Quartz.Spi;
+
+namespace Quartz.Tests.Unit.Core;
+
+[TestFixture]
+public class JobRunShellAsyncLocalTest
+{
+    private static readonly AsyncLocal<string> tenant = new();
+
+    [Test]
+    public async Task AsyncLocalSetInJobFactoryShouldFlowToJobExecution()
+    {
+        NameValueCollection properties = new NameValueCollection
+        {
+            ["quartz.serializer.type"] = TestConstants.DefaultSerializerType,
+            ["quartz.scheduler.instanceName"] = nameof(AsyncLocalSetInJobFactoryShouldFlowToJobExecution)
+        };
+        IScheduler scheduler = await new StdSchedulerFactory(properties).GetScheduler();
+        scheduler.JobFactory = new TenantJobFactory();
+
+        TenantJob.Result = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        IJobDetail job = JobBuilder.Create<TenantJob>().WithIdentity("tenantJob").UsingJobData("tenantId", "001").Build();
+        ITrigger trigger = TriggerBuilder.Create().StartNow().Build();
+
+        await scheduler.ScheduleJob(job, trigger);
+        await scheduler.Start();
+        try
+        {
+            Task completed = await Task.WhenAny(TenantJob.Result.Task, Task.Delay(TimeSpan.FromSeconds(10)));
+            Assert.That(completed, Is.SameAs(TenantJob.Result.Task), "job did not run");
+            Assert.That(await TenantJob.Result.Task, Is.EqualTo("001"));
+        }
+        finally
+        {
+            await scheduler.Shutdown(waitForJobsToComplete: true);
+        }
+    }
+
+    private sealed class TenantJobFactory : SimpleJobFactory
+    {
+        public override IJob NewJob(TriggerFiredBundle bundle, IScheduler scheduler)
+        {
+            tenant.Value = bundle.JobDetail.JobDataMap.GetString("tenantId");
+            return base.NewJob(bundle, scheduler);
+        }
+    }
+
+    private sealed class TenantJob : IJob
+    {
+        public static TaskCompletionSource<string> Result = null!;
+
+        public ValueTask Execute(IJobExecutionContext context)
+        {
+            Result.TrySetResult(tenant.Value ?? "<null>");
+            return default;
+        }
+    }
+}
