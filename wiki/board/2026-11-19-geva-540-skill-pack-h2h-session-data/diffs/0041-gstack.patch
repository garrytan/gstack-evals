+    @Test
+    @DisplayName("targeted user interrupt returns INTERRUPTED and leaves other sessions untouched")
+    void targetedUserInterruptReturnsInterruptedReason() throws Exception {
+        InMemoryAgentStateStore store = new InMemoryAgentStateStore();
+        CountDownLatch subscribed = new CountDownLatch(2);
+        ReActAgent agent =
+                ReActAgent.builder()
+                        .name("asst")
+                        .sysPrompt("hi")
+                        .model(new DelayedFirstChunkModel(subscribed))
+                        .stateStore(store)
+                        .build();
+        RuntimeContext ctxA = RuntimeContext.builder().userId("u1").sessionId("sessA").build();
+        RuntimeContext ctxB = RuntimeContext.builder().userId("u1").sessionId("sessB").build();
+
+        CompletableFuture<Msg> futureA =
+                agent.call(List.of(userMsg("hello-a")), ctxA)
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+        CompletableFuture<Msg> futureB =
+                agent.call(List.of(userMsg("hello-b")), ctxB)
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+
+        assertTrue(subscribed.await(5, TimeUnit.SECONDS), "both model streams should start");
+        agent.interrupt("u1", "sessA", userMsg("stop"));
+
+        String recovery = "I noticed that you have interrupted me. What can I do for you?";
+        Msg replyA = futureA.get(5, TimeUnit.SECONDS);
+        assertEquals(GenerateReason.INTERRUPTED, replyA.getGenerateReason());
+        assertEquals(recovery, replyA.getTextContent());
+
+        Msg replyB = futureB.get(5, TimeUnit.SECONDS);
+        assertNotEquals(
+                GenerateReason.INTERRUPTED,
+                replyB.getGenerateReason(),
+                "non-targeted session must not be interrupted");
+        assertEquals("model reply", replyB.getTextContent());
+
+        ReActAgent reborn = agent(store);
+        List<String> textsA = allText(reborn.getAgentState("u1", "sessA"));
+        assertTrue(textsA.contains("hello-a"));
+        assertTrue(textsA.contains(recovery), "recovery message should be persisted");
+        List<String> textsB = allText(reborn.getAgentState("u1", "sessB"));
+        assertFalse(textsB.contains(recovery), "other session must not receive recovery message");
+    }
+
     private static final class DelayedFirstChunkModel extends ChatModelBase {
         private final CountDownLatch subscribed;
 
