@@ -636,6 +641,33 @@ func (s *Store) resolveWritePath(name string) (string, error) {
 	return path, nil
 }
 
+// ensureNoSymlinkComponents checks that no existing path component of rel
+// (relative to base) is a symbolic link.
+func ensureNoSymlinkComponents(base, rel string) error {
+	if rel == "." || rel == "" {
+		return nil
+	}
+	current := base
+	for _, part := range strings.Split(rel, "/") {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		fi, err := os.Lstat(current)
+		if err != nil {
+			if os.IsNotExist(err) {
+				// remaining components do not exist yet
+				return nil
+			}
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			return ErrPathTraversalDisallowed
+		}
+	}
+	return nil
+}
