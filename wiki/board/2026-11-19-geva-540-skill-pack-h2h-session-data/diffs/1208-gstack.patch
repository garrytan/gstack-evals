+func TestStore_Push_SymlinkTraversalDisallowed(t *testing.T) {
+	tempDir := t.TempDir()
+	outside := t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(tempDir, "out")); err != nil {
+		t.Fatal("error calling Symlink(), error =", err)
+	}
+	s, err := New(tempDir)
+	if err != nil {
+		t.Fatal("Store.New() error =", err)
+	}
+	defer s.Close()
+
+	for _, name := range []string{"out/pwn.txt", "out"} {
+		content := []byte("hello world")
+		desc := ocispec.Descriptor{
+			MediaType: "test",
+			Digest:    digest.FromBytes(content),
+			Size:      int64(len(content)),
+			Annotations: map[string]string{
+				ocispec.AnnotationTitle: name,
+			},
+		}
+		err = s.Push(context.Background(), desc, bytes.NewReader(content))
+		if !errors.Is(err, ErrPathTraversalDisallowed) {
+			t.Errorf("Store.Push(%q) error = %v, want %v", name, err, ErrPathTraversalDisallowed)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(outside, "pwn.txt")); !os.IsNotExist(err) {
+		t.Errorf("file written outside working directory, stat error = %v", err)
+	}
+}
