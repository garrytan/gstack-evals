+
+func Test_BGPUpdateDecodeLengthUnderflow(t *testing.T) {
+	// Path attribute length (4: ORIGIN header+1 byte) exceeds TotalPathAttributeLen (3)
+	data := []byte{0x00, 0x00, 0x00, 0x03, 0x40, 0x01, 0x01, 0x00, 0x18, 0x0a, 0x00, 0x00}
+	msg := &BGPUpdate{}
+	assert.Error(t, msg.DecodeFromBytes(data))
+
+	// Withdrawn prefix (/24 = 4 bytes) exceeds WithdrawnRoutesLen (1)
+	data = []byte{0x00, 0x01, 0x18, 0x0a, 0x00, 0x00, 0x00, 0x00}
+	msg = &BGPUpdate{}
+	assert.Error(t, msg.DecodeFromBytes(data))
+}
