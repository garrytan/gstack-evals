+func TestParseCopilotCodingAgentLogMetrics_IgnoresProse(t *testing.T) {
+	logContent := `
+The agent calls a command or two since it launches a unified server.
+Tool calls with misuse for on to are not tool names.
+Tool call: startHttpServer
+Executing tool: noop
+`
+	metrics := ParseCopilotCodingAgentLogMetrics(logContent, false)
+
+	names := make(map[string]int)
+	for _, tc := range metrics.ToolCalls {
+		names[tc.Name] = tc.CallCount
+	}
+	if len(names) != 2 || names["startHttpServer"] != 1 || names["noop"] != 1 {
+		t.Errorf("Expected only startHttpServer and noop tool calls, got %v", names)
+	}
+}
+
+func TestCopilotCodingAgentDetector_ActivationAwInfo(t *testing.T) {
+	tmpDir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(tmpDir, "activation"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(tmpDir, "activation", "aw_info.json"), []byte(`{"engine_id":"copilot"}`), 0644); err != nil {
+		t.Fatal(err)
+	}
+	// Log content that would otherwise match the coding agent heuristics
+	if err := os.WriteFile(filepath.Join(tmpDir, "agent-stdio.log"), []byte("GitHub Copilot CLI agent starting\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	if NewCopilotCodingAgentDetector(tmpDir, false).IsGitHubCopilotCodingAgent() {
+		t.Error("Expected agentic workflow run with activation/aw_info.json not to be detected as Copilot coding agent")
+	}
+}
