+
+package hack
+
+import (
+	"testing"
+
+	"sigs.k8s.io/kubebuilder/v4/pkg/machinery"
+)
+
+func TestBoilerplateDefaultsYearToPlaceholder(t *testing.T) {
+	f := &Boilerplate{}
+	if err := f.SetTemplateDefaults(); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if f.Year != machinery.YearPlaceholder {
+		t.Fatalf("expected Year %q, got %q", machinery.YearPlaceholder, f.Year)
+	}
+}
+
+func TestBoilerplateKeepsExplicitYear(t *testing.T) {
+	f := &Boilerplate{Year: "2024"}
+	if err := f.SetTemplateDefaults(); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if f.Year != "2024" {
+		t.Fatalf("expected Year %q, got %q", "2024", f.Year)
+	}
+}
