+// ensureNoSymlinkEscape checks that target, after resolving symlinks in the
+// portion of the path that already exists, remains within base.
+// base and target must be absolute and target must lexically be under base.
+func ensureNoSymlinkEscape(base, target string) error {
+	resolvedBase, err := filepath.EvalSymlinks(base)
+	if err != nil {
+		if os.IsNotExist(err) {
+			// working directory does not exist yet; nothing can be a symlink
+			// under it.
+			return nil
+		}
+		return err
+	}
+
+	// find the deepest existing ancestor (or target itself)
+	existing := target
+	var rest []string
+	for {
+		if _, err := os.Lstat(existing); err == nil {
+			break
+		} else if !os.IsNotExist(err) {
+			return err
+		}
+		parent := filepath.Dir(existing)
+		if parent == existing {
+			return nil
+		}
+		rest = append([]string{filepath.Base(existing)}, rest...)
+		existing = parent
+	}
+
+	resolved, err := filepath.EvalSymlinks(existing)
+	if err != nil {
+		if os.IsNotExist(err) {
+			// dangling symlink: following it on write could escape base
+			return ErrPathTraversalDisallowed
+		}
+		return err
+	}
+	resolved = filepath.Join(append([]string{resolved}, rest...)...)
+
+	rel, err := filepath.Rel(resolvedBase, resolved)
+	if err != nil {
+		return ErrPathTraversalDisallowed
+	}
+	rel = filepath.ToSlash(rel)
+	if strings.HasPrefix(rel, "../") || rel == ".." {
+		return ErrPathTraversalDisallowed
+	}
+	return nil
+}
