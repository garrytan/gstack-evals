+func TestStore_File_Push_DisallowSymlinkTraversal(t *testing.T) {
+	content := []byte("hello world")
+	workDir := t.TempDir()
+	outsideDir := t.TempDir()
+	if err := os.Symlink(outsideDir, filepath.Join(workDir, "out")); err != nil {
+		t.Fatal("error calling Symlink(), error =", err)
+	}
+	outsideFile := filepath.Join(outsideDir, "pwn.txt")
+	if err := os.Symlink(outsideFile, filepath.Join(workDir, "link.txt")); err != nil {
+		t.Fatal("error calling Symlink(), error =", err)
+	}
+
+	for _, name := range []string{"out/pwn.txt", "out/sub/pwn.txt", "link.txt"} {
+		t.Run(name, func(t *testing.T) {
+			s, err := New(workDir)
+			if err != nil {
+				t.Fatal("Store.New() error =", err)
+			}
+			defer s.Close()
+			desc := ocispec.Descriptor{
+				MediaType: "test",
+				Digest:    digest.FromBytes(content),
+				Size:      int64(len(content)),
+				Annotations: map[string]string{
+					ocispec.AnnotationTitle: name,
+				},
+			}
+			err = s.Push(context.Background(), desc, bytes.NewReader(content))
+			if !errors.Is(err, ErrPathTraversalDisallowed) {
+				t.Errorf("Store.Push() error = %v, want %v", err, ErrPathTraversalDisallowed)
+			}
+			entries, err := os.ReadDir(outsideDir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(entries) != 0 {
+				t.Errorf("unexpected write outside working dir: %v", entries)
+			}
+		})
+	}
+
+	// symlink inside working dir pointing inside working dir is allowed
+	if err := os.Mkdir(filepath.Join(workDir, "in"), 0777); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(workDir, "in"), filepath.Join(workDir, "inlink")); err != nil {
+		t.Fatal(err)
+	}
+	s, err := New(workDir)
+	if err != nil {
+		t.Fatal("Store.New() error =", err)
+	}
+	defer s.Close()
+	desc := ocispec.Descriptor{
+		MediaType:   "test",
+		Digest:      digest.FromBytes(content),
+		Size:        int64(len(content)),
+		Annotations: map[string]string{ocispec.AnnotationTitle: "inlink/ok.txt"},
+	}
+	if err := s.Push(context.Background(), desc, bytes.NewReader(content)); err != nil {
+		t.Errorf("Store.Push() error = %v", err)
+	}
+}
