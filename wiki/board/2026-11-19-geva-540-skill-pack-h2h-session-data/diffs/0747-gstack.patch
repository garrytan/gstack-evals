index 0000000..2a1f46b
--- /dev/null
+++ b/internal/fsext/ls_dotstar_test.go
@@ -0,0 +1,31 @@
+package fsext
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestListDirectoryDotStarGitignore(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".gitignore"), []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "example.txt"), []byte("x"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "another.go"), []byte("x"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, ".hidden"), []byte("x"), 0o644))
+
+	t.Chdir(dir)
+
+	files, _, err := ListDirectory(".", nil, 0)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{"./example.txt", "./another.go"}, files)
+
+	files, _, err = ListDirectory(dir, nil, 0)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{filepath.Join(dir, "example.txt"), filepath.Join(dir, "another.go")}, files)
+
+	matches, _, err := GlobWithDoubleStar("**/*", dir, 0)
+	require.NoError(t, err)
+	require.Len(t, matches, 2)
+}
