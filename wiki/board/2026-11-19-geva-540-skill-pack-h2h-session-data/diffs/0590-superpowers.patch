@@ -0,0 +1,60 @@
+package caddytls
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/caddyserver/certmagic"
+)
+
+// Regression test: a subdomain that is covered by a managed wildcard (and
+// thus not managed itself) must use the wildcard's automation policy during
+// handshakes, even if a more specific automation policy exists for it;
+// otherwise certificate managers (e.g. get_certificate) configured on the
+// wildcard's policy would not be consulted.
+func TestGetConfigForHandshakeUsesManagedWildcardPolicy(t *testing.T) {
+	specificAP := &AutomationPolicy{subjects: []string{"wiki.example.com"}, magic: new(certmagic.Config)}
+	wildcardAP := &AutomationPolicy{subjects: []string{"*.example.com"}, magic: new(certmagic.Config)}
+	otherAP := &AutomationPolicy{subjects: []string{"other.test"}, magic: new(certmagic.Config)}
+
+	tlsApp := &TLS{
+		Automation: &AutomationConfig{
+			Policies: []*AutomationPolicy{specificAP, wildcardAP, otherAP},
+		},
+		managing:   map[string]string{"*.example.com": "", "other.test": ""},
+		managingMu: new(sync.RWMutex),
+	}
+
+	if got := tlsApp.getConfigForHandshake("wiki.example.com"); got != wildcardAP.magic {
+		t.Errorf("expected wildcard policy's config for subdomain covered by managed wildcard")
+	}
+	if got := tlsApp.getConfigForHandshake("WIKI.example.com"); got != wildcardAP.magic {
+		t.Errorf("expected wildcard policy's config for mixed-case subdomain")
+	}
+	if got := tlsApp.getConfigForHandshake("foo.example.com"); got != wildcardAP.magic {
+		t.Errorf("expected wildcard policy's config for other subdomain")
+	}
+	if got := tlsApp.getConfigForHandshake("other.test"); got != otherAP.magic {
+		t.Errorf("expected own policy's config for unrelated name")
+	}
+
+	// if the specific name is managed itself, its own policy must be used
+	tlsApp.managing["wiki.example.com"] = ""
+	if got := tlsApp.getConfigForHandshake("wiki.example.com"); got != specificAP.magic {
+		t.Errorf("expected specific policy's config when name itself is managed")
+	}
+	delete(tlsApp.managing, "wiki.example.com")
+
+	// names forced to be automated must use their own policy
+	tlsApp.automateNames = map[string]struct{}{"wiki.example.com": {}}
+	if got := tlsApp.getConfigForHandshake("wiki.example.com"); got != specificAP.magic {
+		t.Errorf("expected specific policy's config when name is forced to be automated")
+	}
+	tlsApp.automateNames = nil
+
+	// on-demand policies must be kept
+	specificAP.OnDemand = true
+	if got := tlsApp.getConfigForHandshake("wiki.example.com"); got != specificAP.magic {
+		t.Errorf("expected specific on-demand policy's config")
+	}
+}
