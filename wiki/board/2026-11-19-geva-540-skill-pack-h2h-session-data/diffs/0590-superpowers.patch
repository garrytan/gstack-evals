+// getConfigForHandshake returns the certmagic config to use for a TLS
+// handshake with the given server name. Usually, this is the config of
+// the first automation policy matching the name. However, if the name is
+// not itself being managed because a wildcard covering it is managed
+// instead (see Manage), the wildcard's automation policy is used; this
+// is important for policies that obtain certificates at handshake-time,
+// e.g. via certificate managers like get_certificate, since otherwise
+// a more specific policy without those managers would be used and no
+// certificate would be found for the name.
+func (t *TLS) getConfigForHandshake(name string) *certmagic.Config {
+	ap := t.getAutomationPolicyForName(name)
+	if ap.OnDemand || name == "" || net.ParseIP(name) != nil {
+		return ap.magic
+	}
+	name = strings.ToLower(name)
+	if _, ok := t.automateNames[name]; ok {
+		return ap.magic
+	}
+
+	t.managingMu.RLock()
+	_, managingName := t.managing[name]
+	var wildcard string
+	if !managingName {
+		wildcard = t.managingWildcardForLocked(name, nil)
+	}
+	t.managingMu.RUnlock()
+
+	if wildcard == "" {
+		return ap.magic
+	}
+	return t.getAutomationPolicyForName(wildcard).magic
 }
 
