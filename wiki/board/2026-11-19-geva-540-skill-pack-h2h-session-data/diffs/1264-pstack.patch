+func TestXORMappedAddress_GetFrom_Short(t *testing.T) {
+	for _, value := range [][]byte{{}, {0x00}, {0x00, 0x01}, {0x00, 0x01, 0x00, 0x00}} {
+		src := New()
+		src.Add(AttrXORMappedAddress, value)
+		src.WriteHeader()
+		raw := append([]byte(nil), src.Raw...)
+		msg := &Message{Raw: raw[:len(raw):len(raw)]}
+		assert.NoError(t, msg.Decode())
+		addr := new(XORMappedAddress)
+		assert.NotPanics(t, func() {
+			assert.ErrorIs(t, addr.GetFrom(msg), io.ErrUnexpectedEOF)
+		}, "value length %d", len(value))
+	}
+}
