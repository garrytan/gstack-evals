@@ -81,7 +81,13 @@ export function get_action_location(url) {
 		}
 	}
 
-	return location.pathname + location.search;
+	// a pathname starting with `//` would be interpreted as a protocol-relative URL,
+	// so prefix it with a `/.` segment, which URL resolution removes again
+	const pathname = location.pathname.startsWith('//')
+		? '/.' + location.pathname
+		: location.pathname;
+
+	return pathname + location.search;
 }
 
