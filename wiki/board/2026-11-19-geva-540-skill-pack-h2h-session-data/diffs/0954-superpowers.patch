+
+test('get_action_location does not produce protocol-relative URLs', async () => {
+	const { get_action_location } = await import('./actions.js');
+	const location = get_action_location(new URL('https://example.com//evil.com/path?/login'));
+	expect(location).toBe('/.//evil.com/path');
+	const resolved = new URL(location, 'https://example.com/');
+	expect(resolved.origin).toBe('https://example.com');
+	expect(resolved.pathname).toBe('//evil.com/path');
+	expect(get_action_location(new URL('https://example.com/a/b?x=1'))).toBe('/a/b?x=1');
+});
