+function headersArrayToObject(array) {
+  var headers = {};
+  var names = {};
+  for (var i = 0; i + 1 < array.length; i += 2) {
+    var name = String(array[i]);
+    var value = array[i + 1];
+    var key = name.toLowerCase();
+    // Merge duplicate header names (case-insensitively) into an array value
+    if (Object.prototype.hasOwnProperty.call(names, key)) {
+      var existingName = names[key];
+      headers[existingName] = [].concat(headers[existingName], value);
+    }
+    else {
+      names[key] = name;
+      headers[name] = value;
+    }
+  }
+  return headers;
+}
