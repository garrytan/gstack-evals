+    [Test]
+    public void DedicatedThreadPoolStopsThreadsOnShutdown()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread workerThread = null;
+        var done = new ManualResetEventSlim(false);
+
+        Assert.That(threadPool.RunInThread(async () =>
+        {
+            workerThread = Thread.CurrentThread;
+            // continuation is scheduled back to the dedicated scheduler
+            await Task.Delay(50);
+            done.Set();
+        }), Is.True);
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        Assert.Multiple(() =>
+        {
+            Assert.That(done.IsSet, Is.True);
+            Assert.That(workerThread, Is.Not.Null);
+            Assert.That(workerThread.Join(TimeSpan.FromSeconds(5)), Is.True, "Dedicated thread was not stopped");
+        });
+    }
+
     private class CustomTaskSchedulingThreadPool : TaskSchedulingThreadPool
     {
         private readonly TaskScheduler taskScheduler;
