+using System.Text;
+using UnitTests;
+
+namespace ViewBaseTests.Drawing;
+
+/// <summary>
+///     Tests that a SubView-only redraw request (<c>SubViewNeedsDraw</c>) does not escalate into a full redraw
+///     of the SuperView's adornments, viewport, text, and content.
+/// </summary>
+public class ChildOnlyRedrawTests (ITestOutputHelper output) : TestDriverBase
+{
+    private sealed class Counts
+    {
+        public int ClearingViewport;
+        public int DrawingText;
+        public int DrawingContent;
+
+        public void Track (View view)
+        {
+            view.ClearingViewport += (_, _) => ClearingViewport++;
+            view.DrawingText += (_, _) => DrawingText++;
+            view.DrawingContent += (_, _) => DrawingContent++;
+        }
+
+        public void Reset () => ClearingViewport = DrawingText = DrawingContent = 0;
+
+        public bool Any => ClearingViewport + DrawingText + DrawingContent > 0;
+    }
+
+    /// <summary>Draws <paramref name="root"/> like the application main loop does: with the clip reset to the screen.</summary>
+    private static void Redraw (View root, IDriver driver)
+    {
+        driver.Clip = new Region (driver.Screen);
+        root.Draw ();
+        driver.Clip = new Region (driver.Screen);
+    }
+
+    /// <summary>
+    ///     Builds a scenario, draws it, applies <c>mutate</c>, and draws again (incrementally). Returns the incremental
+    ///     result along with a reference produced by building the same scenario on a fresh driver, applying
+    ///     <c>mutate</c> before the first draw, and drawing once (a full draw of the same final state).
+    /// </summary>
+    private (string Incremental, string Reference) DrawIncrementalAndReference (
+        int width,
+        int height,
+        Func<IDriver, (View Root, Action Mutate)> build,
+        Action<View>? afterInitialDraw = null
+    )
+    {
+        IDriver driver = CreateTestDriver (width, height);
+        (View root, Action mutate) = build (driver);
+        root.Layout ();
+        Redraw (root, driver);
+        afterInitialDraw?.Invoke (root);
+        mutate ();
+        root.Layout ();
+        Redraw (root, driver);
+        string incremental = driver.ToAnsi ();
+        output.WriteLine ("Incremental:");
+        output.WriteLine (driver.ToString ());
+        root.Dispose ();
+
+        IDriver refDriver = CreateTestDriver (width, height);
+        (View refRoot, Action refMutate) = build (refDriver);
+        refRoot.Layout ();
+        refMutate ();
+        refRoot.Layout ();
+        Redraw (refRoot, refDriver);
+        string reference = refDriver.ToAnsi ();
+        output.WriteLine ("Reference:");
+        output.WriteLine (refDriver.ToString ());
+        refRoot.Dispose ();
+
+        return (incremental, reference);
+    }
+
+    private static string MakeLines (string prefix, int count)
+    {
+        StringBuilder sb = new ();
+
+        for (var i = 1; i <= count; i++)
+        {
+            sb.Append ($"{prefix}{i}");
+
+            if (i < count)
+            {
+                sb.Append ('\n');
+            }
+        }
+
+        return sb.ToString ();
+    }
+
+    [Fact]
+    public void ChildOnly_Parent_Does_Not_Clear_Or_Draw_Text_Or_Content ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single, Text = "Parent" };
+        View child = new () { X = 2, Y = 2, Width = 8, Height = 3, BorderStyle = LineStyle.Rounded, Text = "Child" };
+        parent.Add (child);
+
+        Counts parentCounts = new ();
+        parentCounts.Track (parent);
+        Counts childCounts = new ();
+        childCounts.Track (child);
+
+        parent.Layout ();
+        Redraw (parent, driver);
+        Assert.True (parentCounts.Any);
+        string initial = driver.ToAnsi ();
+
+        parentCounts.Reset ();
+        childCounts.Reset ();
+
+        child.SetNeedsDraw ();
+        Assert.False (parent.NeedsDraw);
+        Assert.True (parent.SubViewNeedsDraw);
+
+        Redraw (parent, driver);
+
+        Assert.Equal (0, parentCounts.ClearingViewport);
+        Assert.Equal (0, parentCounts.DrawingText);
+        Assert.Equal (0, parentCounts.DrawingContent);
+
+        Assert.Equal (1, childCounts.ClearingViewport);
+        Assert.Equal (1, childCounts.DrawingText);
+        Assert.Equal (1, childCounts.DrawingContent);
+
+        Assert.False (parent.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+        Assert.False (child.NeedsDraw);
+
+        // Nothing changed visually, so the output must be identical to the full initial draw.
+        Assert.Equal (initial, driver.ToAnsi ());
+
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void ChildOnly_Does_Not_Redraw_Clean_Siblings ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        View dirty = new () { X = 0, Y = 0, Width = 8, Height = 3, Text = "Dirty" };
+        View clean = new () { X = 10, Y = 0, Width = 8, Height = 3, Text = "Clean" };
+        parent.Add (dirty, clean);
+
+        Counts cleanCounts = new ();
+        cleanCounts.Track (clean);
+
+        parent.Layout ();
+        Redraw (parent, driver);
+        cleanCounts.Reset ();
+
+        dirty.SetNeedsDraw ();
+        Redraw (parent, driver);
+
+        Assert.False (cleanCounts.Any);
+
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void Parent_Dirty_Still_Clears_And_Draws_Text ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+
+        View parent = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill (), Text = "Parent" };
+        View child = new () { X = 2, Y = 2, Width = 8, Height = 3, Text = "Child" };
+        parent.Add (child);
+
+        Counts parentCounts = new ();
+        parentCounts.Track (parent);
+
+        parent.Layout ();
+        Redraw (parent, driver);
+        parentCounts.Reset ();
+
+        parent.SetNeedsDraw ();
+        Redraw (parent, driver);
+
+        Assert.Equal (1, parentCounts.ClearingViewport);
+        Assert.Equal (1, parentCounts.DrawingText);
+        Assert.Equal (1, parentCounts.DrawingContent);
+
+        parent.Dispose ();
+    }
+
+    [Fact]
+    public void AdornmentViews_Draw_Does_Not_Leave_Parent_Or_SuperView_Dirty ()
+    {
+        IDriver driver = CreateTestDriver (20, 8);
+
+        View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+        View parent = new () { Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = LineStyle.Single };
+        parent.Border.GetOrCreateView ();
+        parent.Padding.Thickness = new Thickness (1);
+        parent.Padding.GetOrCreateView ();
+        root.Add (parent);
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        Assert.False (root.NeedsDraw);
+        Assert.False (root.SubViewNeedsDraw);
+        Assert.False (parent.NeedsDraw);
+        Assert.False (parent.SubViewNeedsDraw);
+
+        root.Dispose ();
+    }
