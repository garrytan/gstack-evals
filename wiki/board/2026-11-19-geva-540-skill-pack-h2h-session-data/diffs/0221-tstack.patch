+    private static (View Root, Tabs Tabs, View [] Pages) BuildTabs (IDriver driver, int count, LineStyle rootBorder)
+    {
+        View root = new () { Driver = driver, CanFocus = true, Width = Dim.Fill (), Height = Dim.Fill (), BorderStyle = rootBorder };
+        Tabs tabs = new () { Width = Dim.Fill (), Height = Dim.Fill () };
+        root.Add (tabs);
+
+        View [] pages = new View [count];
+
+        for (var i = 0; i < count; i++)
+        {
+            pages [i] = new Code
+            {
+                Title = $"Tab{i + 1}",
+                Text = MakeLines ($"Tab{i + 1} line ", 30),
+                Language = null,
+                SyntaxHighlighter = null,
+                Width = Dim.Fill (),
+                Height = Dim.Fill ()
+            };
+            tabs.Add (pages [i]);
+        }
+
+        return (root, tabs, pages);
+    }
