+                                              │    ╰────┴────┴───────────────────────╮
+                                              │Tab1 line 6                          ▲│
+                                              │Tab1 line 7                          ░│
+                                              │Tab1 line 8                          █│
+                                              │Tab1 line 9                          ░│
+                                              │Tab1 line 10                         ░│
+                                              │Tab1 line 11                         ░│
+                                              │Tab1 line 12                         ░│
+                                              │Tab1 line 13                         ▼│
+                                              ╰──────────────────────────────────────╯
+                                              """,
+                                              output,
+                                              driver);
+
+        root.Dispose ();
+    }
+}
