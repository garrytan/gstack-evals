+    [Fact]
+    public void Tabs_ActiveTab_Scroll_Does_Not_Redraw_Inactive_Tabs_Or_Tabs ()
+    {
+        IDriver driver = CreateTestDriver (40, 12);
+        (View root, Tabs tabs, View [] pages) = BuildTabs (driver, 4, LineStyle.Dotted);
+
+        Counts [] pageCounts = new Counts [pages.Length];
+        int [] pageDrawSubViews = new int [pages.Length];
+
+        for (var i = 0; i < pages.Length; i++)
+        {
+            pageCounts [i] = new Counts ();
+            pageCounts [i].Track (pages [i]);
+            int index = i;
+
+            // Code suppresses ClearingViewport/DrawingContent events; DrawingSubViews is raised only when the
+            // view itself actually redraws.
+            pages [i].DrawingSubViews += (_, _) => pageDrawSubViews [index]++;
+        }
+
+        Counts tabsCounts = new ();
+        tabsCounts.Track (tabs);
+        Counts rootCounts = new ();
+        rootCounts.Track (root);
+
+        root.Layout ();
+        Redraw (root, driver);
+
+        View active = tabs.Value!;
+        int activeIndex = Array.IndexOf (pages, active);
+        Assert.True (activeIndex >= 0);
+
+        for (var y = 1; y <= 3; y++)
+        {
+            foreach (Counts c in pageCounts)
+            {
+                c.Reset ();
+            }
+
+            Array.Clear (pageDrawSubViews);
+            tabsCounts.Reset ();
+            rootCounts.Reset ();
+
+            active.ScrollVertical (1);
+            root.Layout ();
+            Redraw (root, driver);
+
+            Assert.False (rootCounts.Any);
+            Assert.False (tabsCounts.Any);
+
+            for (var i = 0; i < pages.Length; i++)
+            {
+                if (i == activeIndex)
+                {
+                    Assert.Equal (1, pageDrawSubViews [i]);
+
+                    continue;
+                }
+
+                Assert.False (pageCounts [i].Any, $"Inactive tab {i + 1} was redrawn.");
