+    [Fact]
+    public void ChildOnly_Inside_Partially_Clipped_Parent_Renders_Same_As_Full_Draw ()
+    {
+        Counts parentCounts = new ();
+        var tracked = false;
+
+        (string incremental, string reference) = DrawIncrementalAndReference (
+                                                                             20,
+                                                                             8,
+                                                                             driver =>
+                                                                             {
+                                                                                 View root = new () { Driver = driver, Width = Dim.Fill (), Height = Dim.Fill () };
+
+                                                                                 // Parent extends beyond the root's viewport and so is partially clipped.
+                                                                                 View parent = new ()
+                                                                                 {
+                                                                                     X = 10, Y = 3, Width = 20, Height = 10, BorderStyle = LineStyle.Single,
+                                                                                     Text = "Parent"
+                                                                                 };
+
+                                                                                 View child = new ()
+                                                                                 {
+                                                                                     X = 3, Y = 1, Width = 12, Height = 4, BorderStyle = LineStyle.Rounded,
+                                                                                     Text = "abc"
+                                                                                 };
+                                                                                 parent.Add (child);
+                                                                                 root.Add (parent);
+                                                                                 if (!tracked)
+                                                                                 {
+                                                                                     // Only track the incremental scenario, not the reference.
+                                                                                     parentCounts.Track (parent);
+                                                                                     tracked = true;
+                                                                                 }
+
+                                                                                 return (root, () => child.Text = "changed");
+                                                                             },
+                                                                             _ => parentCounts.Reset ());
+
+        Assert.False (parentCounts.Any);
+        Assert.Equal (reference, incremental);
+    }
+
