+
+    @Test
+    void remote_glob_recursivePattern_matchesFileAtSearchRoot() {
+        InMemoryStore store = new InMemoryStore();
+        List<String> ns = List.of("test-ns");
+        RemoteFilesystem fs = new RemoteFilesystem(store, ns);
+        assertTrue(fs.write(RT, "/hello.txt", "hello").isSuccess());
+        assertTrue(fs.write(RT, "/reports/hello.txt", "hello").isSuccess());
+        assertTrue(fs.write(RT, "/reports/archive/hello.txt", "hello").isSuccess());
+        assertTrue(fs.write(RT, "/reports/report.txt", "report").isSuccess());
+        assertTrue(fs.write(RT, "/reports/notes.md", "notes").isSuccess());
+
+        assertEquals(
+                Set.of("/hello.txt", "/reports/hello.txt", "/reports/archive/hello.txt"),
+                globPaths(fs.glob(RT, "**/hello.txt", "/")));
+        assertEquals(
+                Set.of(
+                        "/hello.txt",
+                        "/reports/hello.txt",
+                        "/reports/archive/hello.txt",
+                        "/reports/report.txt"),
+                globPaths(fs.glob(RT, "**/*.txt", "/")));
+        assertEquals(
+                Set.of("/reports/hello.txt", "/reports/archive/hello.txt"),
+                globPaths(fs.glob(RT, "**/hello.txt", "/reports")));
+        assertEquals(
+                Set.of(
+                        "/hello.txt",
+                        "/reports/hello.txt",
+                        "/reports/archive/hello.txt",
+                        "/reports/report.txt",
+                        "/reports/notes.md"),
+                globPaths(fs.glob(RT, "**", "/")));
+    }
+
+    private static Set<String> globPaths(GlobResult result) {
+        assertTrue(result.isSuccess());
+        return result.matches().stream()
+                .map(fi -> fi.path().replace('\\', '/'))
+                .collect(Collectors.toSet());
+    }
