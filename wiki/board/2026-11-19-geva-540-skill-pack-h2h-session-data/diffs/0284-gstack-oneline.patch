diff --git a/tests/features/embeddables/nested-inline-null.test.ts b/tests/features/embeddables/nested-inline-null.test.ts
new file mode 100644
index 0000000..b1aefaf
--- /dev/null
+++ b/tests/features/embeddables/nested-inline-null.test.ts
@@ -0,0 +1,42 @@
+import { Embeddable, Embedded, Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';
+import { MikroORM } from '@mikro-orm/sqlite';
+
+@Embeddable()
+class Inner {
+  @Property({ type: 'string', nullable: true })
+  value?: string;
+}
+
+@Embeddable()
+class Outer {
+  @Property({ type: 'string', nullable: true })
+  name?: string;
+
+
+  @Embedded(() => Inner, { nullable: true })
+  inner?: Inner | null;
+}
+
+@Entity()
+class Foo {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Outer, { nullable: true })
+  outer?: Outer | null;
+}
+
+test('nested inline embeddable with null parent', async () => {
+  const orm = await MikroORM.init({ entities: [Foo], dbName: ':memory:', metadataProvider: ReflectMetadataProvider });
+  await orm.schema.create();
+  const f = orm.em.create(Foo, { outer: { name: 'a', inner: { value: 'b' } } });
+  await orm.em.flush();
+  f.outer = null;
+  await orm.em.flush();
+  orm.em.clear();
+  const f2 = await orm.em.findOneOrFail(Foo, f.id);
+  expect(f2.outer).toBeNull();
+  orm.em.create(Foo, { outer: null });
+  await orm.em.flush();
+  await orm.close();
+});
