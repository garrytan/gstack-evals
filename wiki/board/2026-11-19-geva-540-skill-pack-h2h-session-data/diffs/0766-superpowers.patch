@@ -10,6 +10,80 @@ namespace Finbuckle.MultiTenant.Test.DependencyInjection;
 
 public class ServiceCollectionExtensionsShould
 {
+    public interface IDecoratable
+    {
+        string Name { get; }
+    }
+
+    public class DecoratableA : IDecoratable
+    {
+        public string Name => "A";
+    }
+
+    public class DecoratableB : IDecoratable
+    {
+        public string Name => "B";
+    }
+
+    public class Decorator : IDecoratable
+    {
+        private readonly IDecoratable _inner;
+        private readonly string _suffix;
+
+        public Decorator(IDecoratable inner, string suffix = "")
+        {
+            _inner = inner;
+            _suffix = suffix;
+        }
+
+        public string Name => $"Decorated({_inner.Name}){_suffix}";
+    }
+
+    [Fact]
+    public void DecorateService_DecorateAllRegistrations()
+    {
+        var services = new ServiceCollection();
+        services.AddTransient<IDecoratable, DecoratableA>();
+        services.AddSingleton<IDecoratable>(new DecoratableB());
+        services.AddScoped<IDecoratable>(_ => new DecoratableA());
+
+        services.DecorateService<IDecoratable, Decorator>();
+
+        var descriptors = services.Where(s => s.ServiceType == typeof(IDecoratable)).ToList();
+        Assert.Equal(3, descriptors.Count);
+        Assert.Equal(ServiceLifetime.Transient, descriptors[0].Lifetime);
+        Assert.Equal(ServiceLifetime.Singleton, descriptors[1].Lifetime);
+        Assert.Equal(ServiceLifetime.Scoped, descriptors[2].Lifetime);
+
+        using var sp = services.BuildServiceProvider();
+        using var scope = sp.CreateScope();
+        var names = scope.ServiceProvider.GetServices<IDecoratable>().Select(s => s.Name).ToList();
+        Assert.Equal(["Decorated(A)", "Decorated(B)", "Decorated(A)"], names);
+        Assert.Equal("Decorated(A)", scope.ServiceProvider.GetRequiredService<IDecoratable>().Name);
+    }
+
+    [Fact]
+    public void DecorateService_PassParameters()
+    {
+        var services = new ServiceCollection();
+        services.AddTransient<IDecoratable, DecoratableA>();
+        services.AddSingleton<IDecoratable>(new DecoratableB());
+        services.AddTransient<IDecoratable>(_ => new DecoratableA());
+
+        services.DecorateService<IDecoratable, Decorator>("!");
+
+        using var sp = services.BuildServiceProvider();
+        var names = sp.GetServices<IDecoratable>().Select(s => s.Name).ToList();
+        Assert.Equal(["Decorated(A)!", "Decorated(B)!", "Decorated(A)!"], names);
+    }
+
+    [Fact]
+    public void DecorateService_ThrowIfNoRegistration()
+    {
+        var services = new ServiceCollection();
+        Assert.Throws<ArgumentException>(() => services.DecorateService<IDecoratable, Decorator>());
+    }
+
