diff --git a/packages/mcp-tools/src/utils/tools.ts b/packages/mcp-tools/src/utils/tools.ts
index 8b36540..cd859f8 100644
--- a/packages/mcp-tools/src/utils/tools.ts
+++ b/packages/mcp-tools/src/utils/tools.ts
@@ -47,3 +47,22 @@ export function createClientConfig(config: ContentfulConfig): ClientOptions {
 
   return clientConfig;
 }
+
+const CONNECTION_OVERRIDE_KEYS = new Set([
+  'host',
+  'hostDelivery',
+  'proxy',
+  'rawProxy',
+  'insecure',
+  'config',
+]);
+
+/**
+ * Drops caller-supplied connection settings so options passed alongside the
+ * server's management token can only target the configured host.
+ */
+export function omitConnectionOverrides<T extends object>(args: T): T {
+  return Object.fromEntries(
+    Object.entries(args).filter(([key]) => !CONNECTION_OVERRIDE_KEYS.has(key)),
+  ) as T;
+}
