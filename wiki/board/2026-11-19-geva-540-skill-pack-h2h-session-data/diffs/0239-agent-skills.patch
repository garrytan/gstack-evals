+using System.IO;
+using NAudio.Wave;
+using NUnit.Framework;
+
+namespace NAudio.Core.Tests.WaveFormats
+{
+    [TestFixture]
+    [Category("UnitTest")]
+    public class WaveFormatSerializeTests
+    {
+        private static byte[] Serialize(WaveFormat format)
+        {
+            using var ms = new MemoryStream();
+            using (var w = new BinaryWriter(ms))
+            {
+                format.Serialize(w);
+            }
+            return ms.ToArray();
+        }
+
+        [Test]
+        public void PcmFormatSerializesAs16ByteFmtChunkWithoutCbSize()
+        {
+            var bytes = Serialize(new WaveFormat(44100, 16, 2));
+
+            Assert.That(bytes.Length, Is.EqualTo(4 + 16));
+            Assert.That(System.BitConverter.ToInt32(bytes, 0), Is.EqualTo(16));
+        }
+
+        [Test]
+        public void IeeeFloatFormatStillIncludesCbSize()
+        {
+            var bytes = Serialize(WaveFormat.CreateIeeeFloatWaveFormat(44100, 2));
+
+            Assert.That(bytes.Length, Is.EqualTo(4 + 18));
+            Assert.That(System.BitConverter.ToInt32(bytes, 0), Is.EqualTo(18));
+            Assert.That(System.BitConverter.ToInt16(bytes, 20), Is.EqualTo(0));
+        }
+
+        [Test]
+        public void PcmWaveFileRoundTripsWith16ByteFmtChunk()
+        {
+            var format = new WaveFormat(8000, 16, 1);
+            var ms = new MemoryStream();
+            using (var writer = new WaveFileWriter(new NAudio.Utils.IgnoreDisposeStream(ms), format))
+            {
+                writer.Write(new byte[] { 1, 2, 3, 4 }, 0, 4);
+            }
+
+            var bytes = ms.ToArray();
+            Assert.That(System.Text.Encoding.ASCII.GetString(bytes, 12, 4), Is.EqualTo("fmt "));
+            Assert.That(System.BitConverter.ToInt32(bytes, 16), Is.EqualTo(16));
+            Assert.That(System.Text.Encoding.ASCII.GetString(bytes, 36, 4), Is.EqualTo("data"));
+
+            ms.Position = 0;
+            using var reader = new WaveFileReader(ms);
+            Assert.That(reader.WaveFormat, Is.EqualTo(format));
+            Assert.That(reader.Length, Is.EqualTo(4));
+        }
+    }
+}
