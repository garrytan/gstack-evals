diff --git a/src/cc65/codeoptutil.c b/src/cc65/codeoptutil.c
index 0d3dba9..910ccb4 100644
--- a/src/cc65/codeoptutil.c
+++ b/src/cc65/codeoptutil.c
@@ -1152,6 +1152,18 @@ void AddOpHigh (StackOpData* D, opc_t OPC, LoadInfo* LI, int KeepResult)
 
 
 
+static int IsRegLoadOrXfer (const CodeEntry* E, unsigned Reg)
+/* Return true if E is a load or transfer insn that sets the given register.
+** The change index may also point to some other insn (e.g. one with a label,
+** which is treated as a change to all regs), and such insns must not be
+** removed.
+*/
+{
+    return (E->Info & (OF_LOAD | OF_XFR)) != 0 && (E->Chg & Reg) != 0;
+}
+
+
+
 void RemoveRegLoads (StackOpData* D, LoadInfo* LI)
 /* Remove register load insns */
 {
@@ -1166,6 +1178,7 @@ void RemoveRegLoads (StackOpData* D, LoadInfo* LI)
             DelEntry (D, LI->A.LoadYIndex);
         }
         if (LI->A.ChgIndex >= 0 &&
+            IsRegLoadOrXfer (LI->A.ChgEntry, REG_A) &&
             (LI->A.ChgEntry->Flags & CEF_DONT_REMOVE) == 0) {
             DelEntry (D, LI->A.ChgIndex);
         }
@@ -1189,6 +1202,7 @@ void RemoveRegLoads (StackOpData* D, LoadInfo* LI)
             DelEntry (D, LI->X.LoadYIndex);
         }
         if (LI->X.ChgIndex >= 0 &&
+            IsRegLoadOrXfer (LI->X.ChgEntry, REG_X) &&
             (LI->X.ChgEntry->Flags & CEF_DONT_REMOVE) == 0) {
             DelEntry (D, LI->X.ChgIndex);
         }
