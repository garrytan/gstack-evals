diff --git a/layers/sflow_alloc_test.go b/layers/sflow_alloc_test.go
new file mode 100644
index 0000000..b9b212c
--- /dev/null
+++ b/layers/sflow_alloc_test.go
@@ -0,0 +1,49 @@
+package layers
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func buildGatewayDatagram(asPathCount, asCount, commLen uint32) []byte {
+	var d []byte
+	u32 := func(v uint32) { d = binary.BigEndian.AppendUint32(d, v) }
+	u32(5)
+	u32(1)
+	u32(0x7f000001)
+	u32(0)
+	u32(0)
+	u32(0)
+	u32(1) // SampleCount
+	u32(1) // FlowSample
+	for i := 0; i < 8; i++ {
+		u32(0)
+	}
+	u32(1)    // RecordCount
+	u32(1003) // ExtendedGatewayFlow
+	u32(0)
+	u32(1)
+	u32(0x08080808)
+	u32(0)
+	u32(0)
+	u32(0)
+	u32(asPathCount)
+	if asPathCount > 0 {
+		u32(uint32(SFlowASSequence))
+		u32(asCount)
+	}
+	u32(commLen)
+	return d
+}
+
+func TestSFlowExtendedGatewayHugeCounts(t *testing.T) {
+	for _, d := range [][]byte{
+		buildGatewayDatagram(0, 0, 0xFFFFFFFF),
+		buildGatewayDatagram(1, 0xFFFFFFFF, 0),
+	} {
+		var s SFlowDatagram
+		if err := s.DecodeFromBytes(d, nil); err == nil {
+			t.Fatal("expected error for oversized count")
+		}
+	}
+}
