+package tools.jackson.databind.jsontype.ext;
+
+import org.junit.jupiter.api.Test;
+
+import com.fasterxml.jackson.annotation.*;
+
+import tools.jackson.databind.*;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class ExternalTypeIdWithJsonValueNullTest extends DatabindTestUtil
+{
+    interface GenericType { }
+
+    static class FooType implements GenericType {
+        protected String value;
+
+        protected FooType() { }
+        public FooType(String v) { value = v; }
+
+        @JsonValue
+        public String getValue() { return value; }
+    }
+
+    static class Container {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.NAME,
+                include = JsonTypeInfo.As.EXTERNAL_PROPERTY, property = "type")
+        @JsonSubTypes(@JsonSubTypes.Type(value = FooType.class, name = "foo"))
+        public GenericType value;
+
+        protected Container() { }
+        public Container(GenericType v) { value = v; }
+    }
+
+    static class WrapperArrayContainer {
+        @JsonTypeInfo(use = JsonTypeInfo.Id.NAME,
+                include = JsonTypeInfo.As.WRAPPER_ARRAY)
+        @JsonSubTypes(@JsonSubTypes.Type(value = FooType.class, name = "foo"))
+        public GenericType value;
+
+        public WrapperArrayContainer(GenericType v) { value = v; }
+    }
+
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testExternalTypeIdWithNullJsonValue() throws Exception
+    {
+        assertEquals(a2q("{'value':null}"),
+                MAPPER.writeValueAsString(new Container(null)));
+        assertEquals(a2q("{'value':null,'type':'foo'}"),
+                MAPPER.writeValueAsString(new Container(new FooType(null))));
+        assertEquals(a2q("{'value':'bar','type':'foo'}"),
+                MAPPER.writeValueAsString(new Container(new FooType("bar"))));
+    }
+
+    @Test
+    public void testWrapperArrayTypeIdWithNullJsonValue() throws Exception
+    {
+        assertEquals(a2q("{'value':['foo',null]}"),
+                MAPPER.writeValueAsString(new WrapperArrayContainer(new FooType(null))));
+    }
+}
