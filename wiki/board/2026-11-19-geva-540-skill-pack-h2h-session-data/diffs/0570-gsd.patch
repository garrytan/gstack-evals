+// isGoStmtWithWgDone returns true if the given statement is either
+//   - a go statement running a function literal that calls wg.Done, or
+//   - a for/range loop whose body directly contains such a go statement
+//
+// The latter covers idioms like:
+//
+//	wg.Add(n)
+//	for range n {
+//		go func() {
+//			defer wg.Done()
+//			...
+//		}()
+//	}
+func (w *lintUseWaitGroupGo) isGoStmtWithWgDone(stmt ast.Stmt) bool {
+	switch s := stmt.(type) {
+	case *ast.GoStmt:
+		return w.hasCallToWgDone(s)
+	case *ast.RangeStmt:
+		return w.loopBodyHasGoStmtWithWgDone(s.Body)
+	case *ast.ForStmt:
+		return w.loopBodyHasGoStmtWithWgDone(s.Body)
+	default:
+		return false
+	}
+}
+
+// loopBodyHasGoStmtWithWgDone returns true if the given loop body
+// directly contains a go statement running a function literal that calls wg.Done.
+func (w *lintUseWaitGroupGo) loopBodyHasGoStmtWithWgDone(body *ast.BlockStmt) bool {
+	if body == nil {
+		return false
+	}
+
+	for _, stmt := range body.List {
+		goStmt, ok := stmt.(*ast.GoStmt)
+		if ok && w.hasCallToWgDone(goStmt) {
+			return true
+		}
+	}
+
+	return false
+}
+
 // hasCallToWgDone returns true if the given go statement
 // calls to a function literal containing a call to wg.Done, false otherwise.
 func (*lintUseWaitGroupGo) hasCallToWgDone(goStmt *ast.GoStmt) bool {
