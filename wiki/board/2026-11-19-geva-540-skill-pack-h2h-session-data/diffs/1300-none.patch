+func Test_BGPUpdateDecodeLengthUnderflow(t *testing.T) {
+	// withdrawn routes length 1, but prefix /24 occupies 4 bytes
+	data := []byte{0x00, 0x01, 0x18, 0x0a, 0x00, 0x00, 0x00, 0x00}
+	m := &BGPUpdate{}
+	assert.Error(t, m.DecodeFromBytes(data))
+
+	// total path attribute length 3, but ORIGIN attribute occupies 4 bytes
+	data = []byte{0x00, 0x00, 0x00, 0x03, 0x40, 0x01, 0x01, 0x00}
+	m = &BGPUpdate{}
+	assert.Error(t, m.DecodeFromBytes(data))
+}
