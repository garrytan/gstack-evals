     [Category("UnitTest")]
     public class WaveFileWriterTests
     {
+        [Test]
+        public void PcmFormatChunkShouldNotIncludeExtraSize()
+        {
+            var ms = new MemoryStream();
+            using (var writer = new WaveFileWriter(new IgnoreDisposeStream(ms), new WaveFormat(16000, 16, 1)))
+            {
+                writer.Write(new byte[] { 1, 2, 3, 4 }, 0, 4);
+            }
+            var bytes = ms.ToArray();
+            Assert.That(System.Text.Encoding.ASCII.GetString(bytes, 12, 4), Is.EqualTo("fmt "));
+            Assert.That(BitConverter.ToInt32(bytes, 16), Is.EqualTo(16), "fmt chunk size");
+            Assert.That(System.Text.Encoding.ASCII.GetString(bytes, 36, 4), Is.EqualTo("data"));
+            Assert.That(bytes.Length, Is.EqualTo(44 + 4));
+
+            ms.Position = 0;
+            using (var reader = new WaveFileReader(ms))
+            {
+                Assert.That(reader.WaveFormat, Is.EqualTo(new WaveFormat(16000, 16, 1)));
+                Assert.That(reader.Length, Is.EqualTo(4));
+            }
+        }
+
+        [Test]
+        public void NonPcmFormatChunkShouldIncludeExtraSize()
+        {
+            var ms = new MemoryStream();
+            using (var writer = new WaveFileWriter(new IgnoreDisposeStream(ms), WaveFormat.CreateIeeeFloatWaveFormat(16000, 1)))
+            {
+                writer.WriteSample(0.5f);
+            }
+            var bytes = ms.ToArray();
+            Assert.That(BitConverter.ToInt32(bytes, 16), Is.EqualTo(18), "fmt chunk size");
+        }
+
