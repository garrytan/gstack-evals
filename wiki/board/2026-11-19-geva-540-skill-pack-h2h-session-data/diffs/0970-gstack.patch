+
+func TestColumnNameToNumberOverflow(t *testing.T) {
+	for _, name := range []string{"VGWQHXLSDVIKWV", "XFE", "ZZZZZZZZZZZZZZZZZZZZZZZZZZ", "AAAAAAAAAAAAAAAAAAAAAAAAAAAA"} {
+		col, err := ColumnNameToNumber(name)
+		assert.Equal(t, -1, col, name)
+		assert.ErrorIs(t, err, ErrColumnNumber, name)
+	}
+	_, _, err := CellNameToCoordinates("VGWQHXLSDVIKWV1")
+	assert.Error(t, err)
+	col, err := ColumnNameToNumber("XFD")
+	assert.NoError(t, err)
+	assert.Equal(t, MaxColumns, col)
+}
