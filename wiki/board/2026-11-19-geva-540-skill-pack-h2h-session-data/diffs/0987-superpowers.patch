     const result = sanitizeTranslatedHtml(html)
     expect(result).toBe(
-      '<iframe srcdoc="&lt;script&gt;alert(1)&lt;/script&gt;">Test</iframe>'
+      '<iframe &#115;rcdoc="&lt;script&gt;alert(1)&lt;/script&gt;">Test</iframe>'
     )
   })
 
@@ -372,4 +372,22 @@ describe('sanitizeTranslatedHtml', () => {
       '<div aria-live="polite" aria-label="Status: &lt;b&gt;Active&lt;/b&gt;">Status</div>'
     )
   })
+
+  test('neutralize srcdoc attribute', () => {
+    expect(sanitizeTranslatedHtml('<iframe srcdoc="<b>x</b>"></iframe>')).toBe(
+      '<iframe &#115;rcdoc="&lt;b&gt;x&lt;/b&gt;"></iframe>'
+    )
+    expect(
+      sanitizeTranslatedHtml(
+        "<iframe SRCDOC = '<script>alert(1)</script>'></iframe>"
+      )
+    ).toBe(
