diff --git a/db/bolt/role_test.go b/db/bolt/role_test.go
new file mode 100644
index 0000000..033e5b5
--- /dev/null
+++ b/db/bolt/role_test.go
@@ -0,0 +1,34 @@
+package bolt
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/semaphoreui/semaphore/db"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestGetProjectOrGlobalRoleBySlug_IgnoresOtherProjects(t *testing.T) {
+	store := CreateTestStore()
+
+	p1, err := store.CreateProject(db.Project{Name: "p1"})
+	require.NoError(t, err)
+	p2, err := store.CreateProject(db.Project{Name: "p2"})
+	require.NoError(t, err)
+
+	_, err = store.CreateRole(db.Role{Slug: "foreign", Name: "x", Permissions: 15, ProjectID: &p2.ID})
+	require.NoError(t, err)
+
+	_, err = store.GetProjectOrGlobalRoleBySlug(p1.ID, "foreign")
+	assert.True(t, errors.Is(err, db.ErrNotFound), "role of another project must not resolve, got %v", err)
+
+	role, err := store.GetProjectOrGlobalRoleBySlug(p2.ID, "foreign")
+	require.NoError(t, err)
+	assert.Equal(t, "foreign", role.Slug)
+
+	_, err = store.CreateRole(db.Role{Slug: "global", Name: "g", Permissions: 1})
+	require.NoError(t, err)
+	_, err = store.GetProjectOrGlobalRoleBySlug(p1.ID, "global")
+	assert.NoError(t, err)
+}
