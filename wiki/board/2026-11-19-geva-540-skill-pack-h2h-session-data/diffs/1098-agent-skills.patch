diff --git a/api/projects/project_middleware_test.go b/api/projects/project_middleware_test.go
new file mode 100644
index 0000000..2e6f8f1
--- /dev/null
+++ b/api/projects/project_middleware_test.go
@@ -0,0 +1,46 @@
+package projects
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/gorilla/mux"
+	"github.com/semaphoreui/semaphore/api/helpers"
+	"github.com/semaphoreui/semaphore/db"
+	"github.com/semaphoreui/semaphore/db/bolt"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// A DB role row whose slug collides with a built-in role must never override
+// the built-in permission set (GHSA-cxvf-gvfq-36w2).
+func TestProjectMiddleware_BuiltInRoleNotOverriddenByCustomRow(t *testing.T) {
+	store := bolt.CreateTestStore()
+
+	project, err := store.CreateProject(db.Project{Name: "p"})
+	require.NoError(t, err)
+	user, err := store.CreateUserWithoutPassword(db.User{Username: "mgr", Name: "mgr", Email: "m@x"})
+	require.NoError(t, err)
+	_, err = store.CreateProjectUser(db.ProjectUser{ProjectID: project.ID, UserID: user.ID, Role: db.ProjectManager})
+	require.NoError(t, err)
+
+	_, err = store.CreateRole(db.Role{Slug: "manager", Name: "pwn", Permissions: 15, ProjectID: &project.ID})
+	require.NoError(t, err)
+
+	var got db.ProjectUserPermission
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		got = r.Context().Value("permissions").(db.ProjectUserPermission)
+	})
+
+	req := httptest.NewRequest(http.MethodGet, "/api/project/1/role", nil)
+	req = mux.SetURLVars(req, map[string]string{"project_id": strconv.Itoa(project.ID)})
+	req = helpers.SetContextValue(req, "store", db.Store(store))
+	req = helpers.SetContextValue(req, "user", &user)
+	w := httptest.NewRecorder()
+
+	ProjectMiddleware(next).ServeHTTP(w, req)
+
+	assert.Equal(t, db.ProjectManager.GetPermissions(), got)
+}
diff --git a/db/Role.go b/db/Role.go
index a322acc..3393edf 100644
--- a/db/Role.go
+++ b/db/Role.go
@@ -1,5 +1,7 @@
 package db
 
+import "fmt"
+
 type Role struct {
 	Slug        string                `db:"slug" json:"slug" backup:"-"`
 	Name        string                `db:"name" json:"name"`
@@ -7,10 +9,33 @@ type Role struct {
 	ProjectID   *int                  `db:"project_id" json:"project_id"`
 }
 
+// AllProjectUserPermissions is the union of every known permission bit.
+const AllProjectUserPermissions = CanRunProjectTasks | CanUpdateProject | CanManageProjectResources | CanManageProjectUsers
+
 func ValidateRole(role Role) error {
 	if role.Name == "" {
 		return &ValidationError{Message: "Role name cannot be empty"}
 	}
+	if role.Slug == "" {
+		return &ValidationError{Message: "Role slug cannot be empty"}
+	}
+	// Built-in role slugs are reserved: a custom row with such a slug would
+	// shadow the built-in permission set.
+	if ProjectUserRole(role.Slug).IsValid() {
+		return &ValidationError{Message: fmt.Sprintf("Role slug %q is reserved", role.Slug)}
+	}
+	if role.Permissions < 0 || role.Permissions&^AllProjectUserPermissions != 0 {
+		return &ValidationError{Message: "Role contains unknown permissions"}
+	}
+	return nil
+}
+
+// ValidateRolePermissionCeiling ensures a caller cannot create or update a role
+// granting permissions the caller does not hold itself.
+func ValidateRolePermissionCeiling(role Role, callerPermissions ProjectUserPermission) error {
+	if role.Permissions&^callerPermissions != 0 {
+		return &ValidationError{Message: "Role cannot grant permissions you do not have"}
+	}
 	return nil
 }
 
diff --git a/db/Role_test.go b/db/Role_test.go
new file mode 100644
index 0000000..c6c7300
--- /dev/null
+++ b/db/Role_test.go
@@ -0,0 +1,42 @@
+package db
+
+import "testing"
+
+func TestValidateRole_RejectsBuiltInSlugs(t *testing.T) {
+	for _, slug := range []ProjectUserRole{ProjectOwner, ProjectManager, ProjectTaskRunner, ProjectGuest} {
+		if err := ValidateRole(Role{Slug: string(slug), Name: "pwn", Permissions: 1}); err == nil {
+			t.Errorf("expected built-in slug %q to be rejected", slug)
+		}
+	}
+}
+
+func TestValidateRole_RejectsEmptySlug(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "", Name: "x"}); err == nil {
+		t.Error("expected empty slug to be rejected")
+	}
+}
+
+func TestValidateRole_RejectsUnknownPermissionBits(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: 1 << 10}); err == nil {
+		t.Error("expected unknown permission bits to be rejected")
+	}
+	if err := ValidateRole(Role{Slug: "custom", Name: "x", Permissions: -1}); err == nil {
+		t.Error("expected negative permissions to be rejected")
+	}
+}
+
+func TestValidateRole_AcceptsCustomRole(t *testing.T) {
+	if err := ValidateRole(Role{Slug: "deployer", Name: "Deployer", Permissions: CanRunProjectTasks}); err != nil {
+		t.Errorf("unexpected error: %v", err)
+	}
+}
+
+func TestValidateRolePermissionCeiling(t *testing.T) {
+	manager := ProjectManager.GetPermissions()
+	if err := ValidateRolePermissionCeiling(Role{Permissions: 15}, manager); err == nil {
+		t.Error("manager must not grant owner-only bits")
+	}
+	if err := ValidateRolePermissionCeiling(Role{Permissions: CanRunProjectTasks}, manager); err != nil {
+		t.Errorf("unexpected error: %v", err)
+	}
+}
