+			retName := name
+			if query.Cmd == metadata.CmdOne {
+				// :one declares the return variable at function scope. Don't
+				// reuse a method parameter for it; otherwise the parameter is
+				// scanned into and returned unchanged when no rows are found.
+				retName = uniqueReturnName(name, gq.Arg.Pairs())
+			}
