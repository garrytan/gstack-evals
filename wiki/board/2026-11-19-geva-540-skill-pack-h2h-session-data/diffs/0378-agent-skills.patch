+
+func TestBuildQueries_ReturnValueDoesNotShadowParam(t *testing.T) {
+	textType := &plugin.Identifier{Name: "text"}
+	intType := &plugin.Identifier{Name: "int8"}
+	emailParam := &plugin.Parameter{Number: 1, Column: &plugin.Column{Name: "email", Type: textType, NotNull: true}}
+	idParam := &plugin.Parameter{Number: 2, Column: &plugin.Column{Name: "id", Type: intType, NotNull: true}}
+	emailCol := &plugin.Column{Name: "email", Type: textType, NotNull: true}
+
+	tests := []struct {
+		name   string
+		cmd    string
+		params []*plugin.Parameter
+		limit  int32
+	}{
+		{"one with single param", metadata.CmdOne, []*plugin.Parameter{emailParam}, 1},
+		{"one with expanded params", metadata.CmdOne, []*plugin.Parameter{emailParam, idParam}, 4},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			limit := tt.limit
+			req := &plugin.GenerateRequest{
+				Settings: &plugin.Settings{Engine: "postgresql"},
+				Queries: []*plugin.Query{{
+					Name:    "GetUserByEmail",
+					Cmd:     tt.cmd,
+					Text:    "SELECT email FROM users WHERE email = $1",
+					Columns: []*plugin.Column{emailCol},
+					Params:  tt.params,
+				}},
+			}
+			options := &opts.Options{QueryParameterLimit: &limit}
+			qs, err := buildQueries(req, options, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ret := qs[0].Ret.Name
+			for _, a := range qs[0].Arg.Pairs() {
+				if a.Name == ret {
+					t.Fatalf("return value %q shadows method parameter %q", ret, a.Name)
+				}
+			}
+		})
+	}
+}
