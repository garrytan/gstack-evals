 	metadata.CmdOne:       {},
 }
 
+// uniqueReturnName returns name, suffixed if necessary so that it does not
+// collide with any of the method's parameter names.
+func uniqueReturnName(name string, args []Argument) string {
+	taken := make(map[string]struct{}, len(args))
+	for _, a := range args {
+		taken[a.Name] = struct{}{}
+	}
+	candidate := name
+	for i := 2; ; i++ {
+		if _, ok := taken[escape(candidate)]; !ok {
+			return candidate
+		}
+		candidate = fmt.Sprintf("%s_%d", name, i)
+	}
+}
+
 func putOutColumns(query *plugin.Query) bool {
 	_, found := cmdReturnsData[query.Cmd]
 	return found
