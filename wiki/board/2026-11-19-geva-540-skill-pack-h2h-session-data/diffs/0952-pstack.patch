+	// a leading `//` would make the location protocol-relative, pointing at another origin.
+	// the `/.` dot segment is removed during resolution, so the path itself is preserved
+	const pathname = location.pathname.startsWith('//')
+		? `/.${location.pathname}`
+		: location.pathname;
