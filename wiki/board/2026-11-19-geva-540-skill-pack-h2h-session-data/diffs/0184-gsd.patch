diff --git a/test/sql/window/test_volatile_cse.test b/test/sql/window/test_volatile_cse.test
new file mode 100644
index 0000000..42ea856
--- /dev/null
+++ b/test/sql/window/test_volatile_cse.test
@@ -0,0 +1,70 @@
+# name: test/sql/window/test_volatile_cse.test
+# description: Identical volatile aggregate/window expressions must be evaluated independently
+# group: [window]
+
+statement ok
+PRAGMA enable_verification
+
+# window aggregate over a partition (rewritten into aggregate + self join)
+query I
+SELECT bool_or(id_a = id_b) FROM (
+	SELECT g,
+		any_value(uuid()::varchar) OVER (PARTITION BY g) AS id_a,
+		any_value(uuid()::varchar) OVER (PARTITION BY g) AS id_b
+	FROM (VALUES (1),(1),(2),(2)) t(g)
+);
+----
+false
+
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT any_value(random()) OVER (PARTITION BY range % 10) a,
+		any_value(random()) OVER (PARTITION BY range % 10) b
+	FROM range(1000)
+);
+----
+false
+
+# plain aggregates
+query I
+SELECT any_value(uuid()::varchar) = any_value(uuid()::varchar) FROM range(3);
+----
+false
+
+query I
+SELECT sum(random()) = sum(random()) FROM range(100);
+----
+false
+
+query I
+SELECT bool_or(a = b) FROM (
+	SELECT g, sum(random()) a, sum(random()) b FROM (SELECT range % 10 g FROM range(1000)) GROUP BY g
+);
+----
+false
+
+# window with volatile ORDER BY
+query I
+SELECT bool_or(r1 <> r2) FROM (
+	SELECT row_number() OVER (ORDER BY random()) r1, row_number() OVER (ORDER BY random()) r2
+	FROM range(1000)
+);
+----
+true
+
+# window with volatile PARTITION BY
+query I
+SELECT bool_or(a <> b) FROM (
+	SELECT sum(1) OVER (PARTITION BY (random() * 10)::INT) a, sum(1) OVER (PARTITION BY (random() * 10)::INT) b
+	FROM range(1000)
+);
+----
+true
+
+# non-volatile duplicates are still deduplicated and identical
+query I
+SELECT bool_and(a = b) FROM (
+	SELECT sum(range) OVER (PARTITION BY range % 3) a, sum(range) OVER (PARTITION BY range % 3) b FROM range(30)
+);
+----
+true
