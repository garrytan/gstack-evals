+#[cfg(test)]
+mod git_root_tests {
+    use super::*;
+
+    #[test]
+    fn broken_ancestor_gitfile_is_not_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let workspace = tmp.path().join("workspace");
+        let project = workspace.join("project");
+        std::fs::create_dir_all(&project).unwrap();
+        std::fs::write(workspace.join(".git"), "gitdir: ../missing/git-dir\n").unwrap();
+
+        let project_str = project.to_string_lossy().to_string();
+        assert_eq!(promote_to_git_root(&project_str), project_str);
+    }
+
+    #[test]
+    fn valid_gitfile_worktree_is_promoted_to_checkout_root() {
+        let tmp = tempfile::tempdir().unwrap();
+        let gitdir = tmp.path().join("repo.git").join("worktrees").join("wt");
+        std::fs::create_dir_all(&gitdir).unwrap();
+        let checkout = tmp.path().join("checkout");
+        let nested = checkout.join("src");
+        std::fs::create_dir_all(&nested).unwrap();
+        std::fs::write(checkout.join(".git"), "gitdir: ../repo.git/worktrees/wt\n").unwrap();
+
+        let nested_str = nested.to_string_lossy().to_string();
+        assert_eq!(
+            promote_to_git_root(&nested_str),
+            checkout.to_string_lossy().to_string()
+        );
+    }
+
+    #[test]
+    fn git_directory_is_promoted() {
+        let tmp = tempfile::tempdir().unwrap();
+        let repo = tmp.path().join("repo");
+        let nested = repo.join("a").join("b");
+        std::fs::create_dir_all(repo.join(".git")).unwrap();
+        std::fs::create_dir_all(&nested).unwrap();
+
+        let nested_str = nested.to_string_lossy().to_string();
+        assert_eq!(
+            promote_to_git_root(&nested_str),
+            repo.to_string_lossy().to_string()
+        );
+    }
+}
