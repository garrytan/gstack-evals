diff --git a/test/ares-test-parse-srv.cc b/test/ares-test-parse-srv.cc
index 6956beb..e55a913 100644
--- a/test/ares-test-parse-srv.cc
+++ b/test/ares-test-parse-srv.cc
@@ -118,6 +118,71 @@ TEST_F(LibraryTest, ParseSrvReplyMalformed) {
   ASSERT_EQ(nullptr, srv);
 }
 
+/* RFC 2782: "name compression is not to be used for this field" (TARGET) */
+static std::vector<byte> SrvCompressedTargetPacket() {
+  return {
+    0x12, 0x34,  // qid
+    0x84, // response + query + AA + not-TC + not-RD
+    0x00, // not-RA + not-Z + not-AD + not-CD + rc=NoError
+    0x00, 0x01,  // num questions
+    0x00, 0x01,  // num answer RRs
+    0x00, 0x00,  // num authority RRs
+    0x00, 0x00,  // num additional RRs
+    // Question (offset 12)
+    0x07, 'e', 'x', 'a', 'm', 'p', 'l', 'e',
+    0x03, 'c', 'o', 'm',
+    0x00,
+    0x00, 0x21,  // type SRV
+    0x00, 0x01,  // class IN
+    // Answer 1
+    0xC0, 0x0C,  // owner name: pointer to question (allowed)
+    0x00, 0x21,  // RR type SRV
+    0x00, 0x01,  // class IN
+    0x01, 0x02, 0x03, 0x04, // TTL
+    0x00, 0x0C,  // rdata length
+    0x00, 0x0A,  // priority
+    0x00, 0x14,  // weight
+    0x00, 0x1E,  // port
+    0x03, 's', 'r', 'v',
+    0xC0, 0x0C,  // TARGET: compression pointer -- not permitted
+  };
+}
+
+TEST_F(LibraryTest, ParseSrvReplyCompressedTargetRejected) {
+  std::vector<byte> data = SrvCompressedTargetPacket();
+
+  struct ares_srv_reply* srv = nullptr;
+  EXPECT_EQ(ARES_EBADNAME, ares_parse_srv_reply(data.data(), (int)data.size(), &srv));
+  EXPECT_EQ(nullptr, srv);
+  if (srv) ares_free_data(srv);
+}
+
+TEST_F(LibraryTest, DnsParseSrvCompressedTargetRejected) {
+  std::vector<byte> data = SrvCompressedTargetPacket();
+
+  ares_dns_record_t *dnsrec = nullptr;
+  EXPECT_NE(ARES_SUCCESS, ares_dns_parse(data.data(), data.size(), 0, &dnsrec));
+  EXPECT_EQ(nullptr, dnsrec);
+  if (dnsrec) ares_dns_record_destroy(dnsrec);
+}
+
+TEST_F(LibraryTest, DnsParseSrvUncompressedTargetOK) {
+  std::vector<byte> data = SrvCompressedTargetPacket();
+  /* Replace the trailing pointer with an inline "example.com" */
+  data.resize(data.size() - 2);
+  const byte tail[] = { 0x07, 'e', 'x', 'a', 'm', 'p', 'l', 'e',
+                        0x03, 'c', 'o', 'm', 0x00 };
+  data.insert(data.end(), tail, tail + sizeof(tail));
+  data[40] = (byte)(6 + 4 + sizeof(tail)); // fix rdlength low byte
+
+  struct ares_srv_reply* srv = nullptr;
+  ASSERT_EQ(ARES_SUCCESS, ares_parse_srv_reply(data.data(), (int)data.size(), &srv));
+  ASSERT_NE(nullptr, srv);
+  EXPECT_EQ("srv.example.com", std::string(srv->host));
+  EXPECT_EQ(30, srv->port);
+  ares_free_data(srv);
+}
