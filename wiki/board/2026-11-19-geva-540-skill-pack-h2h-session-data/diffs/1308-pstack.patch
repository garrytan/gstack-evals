+
+func TestGetURLPathTraversal(t *testing.T) {
+	baseURL := "https://api.good.com"
+	path := "/api/v1/users/{{.id}}"
+	pathParams := parameters.Parameters{parameters.NewStringParameter("id", "user id")}
+
+	rejected := []string{
+		"../../../admin/secrets",
+		"..",
+		".",
+		"123/../../admin",
+		"%2e%2e/%2e%2e/admin",
+		"%2E%2E%2F..%2Fadmin",
+		"..\\..\\admin",
+	}
+	for _, id := range rejected {
+		t.Run(id, func(t *testing.T) {
+			got, err := getURL(baseURL, path, pathParams, nil, nil, map[string]any{"id": id})
+			if err == nil {
+				t.Fatalf("expected traversal %q to be rejected, got URL %q", id, got)
+			}
+		})
+	}
+
+	allowed := map[string]string{
+		"123":       "https://api.good.com/api/v1/users/123",
+		"file.json": "https://api.good.com/api/v1/users/file.json",
+		"..hidden":  "https://api.good.com/api/v1/users/..hidden",
+		"a/b":       "https://api.good.com/api/v1/users/a/b",
+	}
+	for id, want := range allowed {
+		t.Run(id, func(t *testing.T) {
+			got, err := getURL(baseURL, path, pathParams, nil, nil, map[string]any{"id": id})
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if got != want {
+				t.Fatalf("expected %q, got %q", want, got)
+			}
+		})
+	}
+}
