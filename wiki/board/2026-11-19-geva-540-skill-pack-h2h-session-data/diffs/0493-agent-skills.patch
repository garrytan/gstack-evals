@@ -0,0 +1,53 @@
+package tools.jackson.databind.deser.merge;
+
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.databind.*;
+import tools.jackson.databind.exc.InvalidDefinitionException;
+import tools.jackson.databind.testutil.DatabindTestUtil;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+// Updating existing instances of local/anonymous classes should work since
+// no instantiation is needed; creating new instances should still fail.
+public class UpdateLocalClassTest extends DatabindTestUtil
+{
+    private final ObjectMapper MAPPER = newJsonMapper();
+
+    @Test
+    public void testUpdateAnonymousClassInstance() throws Exception
+    {
+        Object bean = new Object() {
+            public int value;
+            @Override public String toString() { return String.valueOf(value); }
+        };
+        Object result = MAPPER.readerForUpdating(bean).readValue("{\"value\": 2}");
+        assertSame(bean, result);
+        assertEquals("2", bean.toString());
+    }
+
+    @Test
+    public void testUpdateLocalClassInstance() throws Exception
+    {
+        class Local {
+            public int value;
+            public String name;
+        }
+        Local bean = new Local();
+        Local result = MAPPER.readerForUpdating(bean).readValue("{\"value\": 3, \"name\":\"x\"}");
+        assertSame(bean, result);
+        assertEquals(3, bean.value);
+        assertEquals("x", bean.name);
+    }
+
+    @Test
+    public void testCreateLocalClassInstanceFails() throws Exception
+    {
+        class Local {
+            public int value;
+        }
+        InvalidDefinitionException e = assertThrows(InvalidDefinitionException.class,
+                () -> MAPPER.readValue("{\"value\": 3}", Local.class));
+        verifyException(e, "local/anonymous");
+    }
+}
