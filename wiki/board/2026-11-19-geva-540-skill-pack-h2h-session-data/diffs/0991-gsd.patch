 // flatCols provides a method for the column's operation functions to flatten
 // and check the worksheet columns.
 func flatCols(col xlsxCol, cols []xlsxCol, replacer func(fc, c xlsxCol) xlsxCol) []xlsxCol {
+	// clampColRange restricts a column range to the valid worksheet column
+	// bounds, column ranges loaded from the workbook are untrusted and may
+	// exceed the maximum number of columns.
+	clampColRange := func(minVal, maxVal int) (int, int) {
+		return max(minVal, MinColumns), min(maxVal, MaxColumns)
+	}
 	var fc []xlsxCol
-	for i := col.Min; i <= col.Max; i++ {
+	flat := make(map[int]int)
+	minVal, maxVal := clampColRange(col.Min, col.Max)
+	for i := minVal; i <= maxVal; i++ {
 		var c xlsxCol
 		_ = deepcopy.Copy(&c, col)
 		c.Min, c.Max = i, i
+		flat[i] = len(fc)
 		fc = append(fc, c)
 	}
-	inFlat := func(colID int, cols []xlsxCol) (int, bool) {
-		for idx, c := range cols {
-			if c.Max == colID && c.Min == colID {
-				return idx, true
-			}
-		}
-		return -1, false
-	}
 	for _, column := range cols {
-		for i := column.Min; i <= column.Max; i++ {
-			if idx, ok := inFlat(i, fc); ok {
+		minVal, maxVal := clampColRange(column.Min, column.Max)
+		for i := minVal; i <= maxVal; i++ {
+			if idx, ok := flat[i]; ok {
 				fc[idx] = replacer(fc[idx], column)
 				continue
 			}
 			var c xlsxCol
 			_ = deepcopy.Copy(&c, column)
 			c.Min, c.Max = i, i
+			flat[i] = len(fc)
 			fc = append(fc, c)
 		}
 	}
