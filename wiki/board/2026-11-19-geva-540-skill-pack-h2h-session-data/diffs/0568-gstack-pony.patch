+// isGoWithWgDone returns true if the given statement is a go statement
+// running a function literal that contains a call to wg.Done, false otherwise.
+func (w *lintUseWaitGroupGo) isGoWithWgDone(stmt ast.Stmt) bool {
+	goStmt, ok := stmt.(*ast.GoStmt)
+	return ok && w.hasCallToWgDone(goStmt)
+}
+
+// isLoopWithGoWgDone returns true if the given statement is a for/range loop
+// whose body directly contains a go statement with a call to wg.Done
+// (not preceded by its own wg.Add), as in:
+//
+//	wg.Add(n)
+//	for range n {
+//		go func() {
+//			defer wg.Done()
+//			...
+//		}()
+//	}
+func (w *lintUseWaitGroupGo) isLoopWithGoWgDone(stmt ast.Stmt) bool {
+	var body *ast.BlockStmt
+	switch loop := stmt.(type) {
+	case *ast.ForStmt:
+		body = loop.Body
+	case *ast.RangeStmt:
+		body = loop.Body
+	default:
+		return false
+	}
+
+	for _, s := range body.List {
+		if w.isCallToWgAdd(s) {
+			return false // the loop body has its own wg.Add; it is analyzed on its own
+		}
+
+		if w.isGoWithWgDone(s) {
+			return true
+		}
+	}
+
+	return false
+}
