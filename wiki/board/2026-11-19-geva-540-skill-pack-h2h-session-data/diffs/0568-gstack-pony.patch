+// from https://github.com/kubernetes-sigs/kueue/pull/9892
+func useWaitGroupGoWithLoops(jobs int64) {
+	wg := sync.WaitGroup{}
+
+	wg.Add(int(jobs)) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+
+	for range int(jobs) {
+		go func() {
+			defer wg.Done()
+			doSomething()
+		}()
+	}
+
+	wg.Wait()
+
+	wg.Add(len(items)) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+	for i := 0; i < len(items); i++ {
+		doSomethingElse()
+		go func() {
+			doSomething(items[i])
+			wg.Done()
+		}()
+	}
+	wg.Wait()
+
+	// the loop body has its own wg.Add, only that one shall be reported
+	wg.Add(1)
+	doSomething()
+	for _, item := range items {
+		wg.Add(1) // MATCH /replace wg.Add()...go {...wg.Done()...} with wg.Go(...)/
+		go func() {
+			defer wg.Done()
+			doSomething(item)
+		}()
+	}
+	wg.Wait()
+
+	// no wg.Done in the goroutine
+	wg.Add(len(items))
+	for range items {
+		go func() {
+			doSomething()
+		}()
+	}
+}
