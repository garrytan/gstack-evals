--- a/packages/svelte/src/internal/client/runtime.js
+++ b/packages/svelte/src/internal/client/runtime.js
@@ -265,6 +265,22 @@ export function update_reaction(reaction) {
 
 	var flags = reaction.f;
 
+	if (reaction.ac !== null) {
+		// abort outside of the reactive context, so that listeners
+		// can safely update state (e.g. reset values) without
+		// triggering `state_unsafe_mutation` errors
+		active_reaction = null;
+		untracking = true;
+
+		try {
+			reaction.ac.abort(STALE_REACTION);
+		} finally {
+			active_reaction = previous_reaction;
+			untracking = previous_untracking;
+			reaction.ac = null;
+		}
+	}
+
 	new_deps = /** @type {null | Value[]} */ (null);
 	skipped_deps = 0;
 	untracked_writes = null;
@@ -277,11 +293,6 @@ export function update_reaction(reaction) {
 	untracking = false;
 	update_version = ++read_version;
 
-	if (reaction.ac !== null) {
-		reaction.ac.abort(STALE_REACTION);
-		reaction.ac = null;
-	}
-
 	try {
 		reaction.f |= REACTION_IS_UPDATING;
 		var fn = /** @type {Function} */ (reaction.fn);
diff --git a/packages/svelte/tests/runtime-runes/samples/get-abort-signal-derived-state-mutation/Child.svelte b/packages/svelte/tests/runtime-runes/samples/get-abort-signal-derived-state-mutation/Child.svelte
