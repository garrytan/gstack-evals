--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/get-abort-signal-derived-state-mutation/Child.svelte
@@ -0,0 +1,24 @@
+<script>
+	import { onMount, getAbortSignal } from 'svelte';
+
+	const { test } = $props();
+
+	onMount(() => {
+		const signal = getAbortSignal();
+
+		test.value = true;
+		signal.addEventListener('abort', () => {
+			test.value = false;
+		});
+	});
+
+	const value = $derived.by(() => {
+		const signal = getAbortSignal();
+		signal.addEventListener('abort', () => {
+			test.value = false;
+		});
+		return test.value;
+	});
+</script>
+
+{value}
