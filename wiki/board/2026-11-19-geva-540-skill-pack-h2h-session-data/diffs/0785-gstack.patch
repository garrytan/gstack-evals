+---
+'svelte': patch
+---
+
+fix: abort `getAbortSignal` signals outside of the reactive context to avoid false positive `state_unsafe_mutation` errors
diff --git a/packages/svelte/src/internal/client/runtime.js b/packages/svelte/src/internal/client/runtime.js
