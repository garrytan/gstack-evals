+    [Test]
+    public void Write8BitShouldStoreSignedSamplesAndReadBackUnsigned()
+    {
+        var unsignedData = new byte[] { 0x00, 0x7F, 0x80, 0xFF };
+        var ms = new MemoryStream();
+        using (var writer = new AiffFileWriter(ms, new WaveFormat(8000, 8, 1)))
+        {
+            writer.Write(unsignedData, 0, unsignedData.Length);
+        }
+
+        var file = ms.ToArray();
+        Assert.That(file[^unsignedData.Length..], Is.EqualTo(new byte[] { 0x80, 0xFF, 0x00, 0x7F }));
+
+        using var reader = new AiffFileReader(new MemoryStream(file));
+        var roundTripped = new byte[unsignedData.Length];
+        reader.ReadExactly(roundTripped);
+        Assert.That(roundTripped, Is.EqualTo(unsignedData));
+    }
