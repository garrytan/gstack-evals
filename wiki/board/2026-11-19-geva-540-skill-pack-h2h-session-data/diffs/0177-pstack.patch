+    [Test]
+    [Category("UnitTest")]
+    public void EightBitPcmIsReadAsSigned()
+    {
+        // first audio bytes of aiff-samplesize-8.aiff from the toisto AIFF test suite
+        byte[] audio = { 0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x0A, 0x80, 0x83, 0x85, 0x88, 0x8A, 0x8D, 0x8F, 0x92 };
+        float[] expected = { 0.078125f, 0.078125f, 0.078125f, 0.078125f, 0.078125f, 0.078125f, 0.078125f, 0.078125f,
+            -1f, -0.9765625f, -0.9609375f, -0.9375f, -0.921875f, -0.8984375f, -0.8828125f, -0.859375f };
+
+        using var reader = new AiffFileReader(new MemoryStream(BuildMono8BitAiff(audio)));
+        var samples = new float[audio.Length];
+        int read = reader.ToSampleProvider().Read(samples);
+
+        Assert.That(read, Is.EqualTo(audio.Length));
+        Assert.That(samples, Is.EqualTo(expected));
+    }
+
+    private static byte[] BuildMono8BitAiff(byte[] audio)
+    {
+        var ms = new MemoryStream();
+        var w = new BinaryWriter(ms);
+        void WriteBigEndian(uint v) => w.Write(new[] { (byte)(v >> 24), (byte)(v >> 16), (byte)(v >> 8), (byte)v });
+        w.Write("FORM"u8.ToArray());
+        WriteBigEndian((uint)(4 + 26 + 16 + audio.Length));
+        w.Write("AIFF"u8.ToArray());
+        w.Write("COMM"u8.ToArray());
+        WriteBigEndian(18);
+        w.Write(new byte[] { 0x00, 0x01 });
+        WriteBigEndian((uint)audio.Length);
+        w.Write(new byte[] { 0x00, 0x08 });
+        w.Write(new byte[] { 0x40, 0x0E, 0xAC, 0x44, 0, 0, 0, 0, 0, 0 });
+        w.Write("SSND"u8.ToArray());
+        WriteBigEndian((uint)(8 + audio.Length));
+        WriteBigEndian(0);
+        WriteBigEndian(0);
+        w.Write(audio);
+        return ms.ToArray();
+    }
+
