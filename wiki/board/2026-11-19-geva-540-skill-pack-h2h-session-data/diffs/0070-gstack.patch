+    static final class BinaryTypesTest extends RowCompactedSerializerTest {
+        public BinaryTypesTest() {
+            super(getRowSerializer(), getData());
+        }
+
+        private static InternalRow[] getData() {
+            return new GenericRow[] {
+                GenericRow.of(null, 1),
+                GenericRow.of(new byte[] {1, 2}, 2),
+                GenericRow.of(new byte[] {(byte) 0xFF}, 3)
+            };
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(RowType.of(DataTypes.VARBINARY(10), DataTypes.INT()));
+        }
+
+        private static MemorySlice slice(RowCompactedSerializer serializer, InternalRow row) {
+            return MemorySlice.wrap(serializer.serializeToBytes(row));
+        }
+
+        @Test
+        public void testSliceComparatorWithBinaryType() {
+            RowCompactedSerializer serializer = getRowSerializer();
+            Comparator<MemorySlice> comparator = serializer.createSliceComparator();
+
+            MemorySlice a = slice(serializer, GenericRow.of(new byte[] {1, 2}, 1));
+            MemorySlice a2 = slice(serializer, GenericRow.of(new byte[] {1, 2}, 1));
+            MemorySlice aPrefix = slice(serializer, GenericRow.of(new byte[] {1}, 1));
+            MemorySlice aLaterInt = slice(serializer, GenericRow.of(new byte[] {1, 2}, 2));
+            // unsigned ordering: 0xFF > 0x01
+            MemorySlice high = slice(serializer, GenericRow.of(new byte[] {(byte) 0xFF}, 0));
+            MemorySlice nul = slice(serializer, GenericRow.of(null, 0));
+
+            assertThat(comparator.compare(a, a2)).isEqualTo(0);
+            assertThat(comparator.compare(aPrefix, a)).isLessThan(0);
+            assertThat(comparator.compare(a, aLaterInt)).isLessThan(0);
+            assertThat(comparator.compare(a, high)).isLessThan(0);
+            assertThat(comparator.compare(high, a)).isGreaterThan(0);
+            assertThat(comparator.compare(nul, a)).isLessThan(0);
+
+            RowCompactedSerializer binarySerializer =
+                    new RowCompactedSerializer(RowType.of(DataTypes.BINARY(2)));
+            Comparator<MemorySlice> binaryComparator = binarySerializer.createSliceComparator();
+            assertThat(
+                            binaryComparator.compare(
+                                    slice(binarySerializer, GenericRow.of(new byte[] {0, 1})),
+                                    slice(binarySerializer, GenericRow.of(new byte[] {-128, 0}))))
+                    .isLessThan(0);
+        }
+    }
