+package test.org.springdoc.api.v31.app246;
+
+import java.util.Map;
+
+import io.swagger.v3.oas.annotations.Parameter;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestPart;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class HelloController {
+
+	@PostMapping(value = "/string", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
+	public String string(@Parameter(description = "A JSON object for file mapping", required = true) @RequestPart String fileMapping) {
+		return fileMapping;
+	}
+
+	@PostMapping(value = "/map", consumes = MediaType.MULTIPART_FORM_DATA_VALUE)
+	public String map(@Parameter(description = "A JSON object for file mapping", required = true) @RequestPart Map<String, Object> fileMapping) {
+		return fileMapping.toString();
+	}
+}
