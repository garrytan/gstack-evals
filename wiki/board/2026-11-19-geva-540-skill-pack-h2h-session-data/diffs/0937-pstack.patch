@@ -528,3 +528,22 @@ func BenchmarkDecryptAES256_CBCHMAC_1MB(b *testing.B) {
 func BenchmarkDecryptAES256_CBCHMAC_64MB(b *testing.B) {
 	benchDecryptCBCHMAC(b, 32, 67108864)
 }
+
+func TestOpenValidTagMalformedInput(t *testing.T) {
+	key := make([]byte, 32)
+	aead, _ := NewCBCHMAC(key, aes.NewCipher)
+	ctx := aead.(*cbcAEAD)
+	aad := []byte("aad")
+
+	cases := map[string]struct{ nonce, ciphertext []byte }{
+		"empty ciphertext": {make([]byte, 16), nil},
+		"short nonce":      {[]byte{}, make([]byte, 16)},
+		"long nonce":       {make([]byte, 32), make([]byte, 16)},
+	}
+	for name, c := range cases {
+		sealed := append(append([]byte{}, c.ciphertext...), ctx.computeAuthTag(aad, c.nonce, c.ciphertext)...)
+		if _, err := aead.Open(nil, c.nonce, sealed, aad); err == nil {
+			t.Errorf("%s: Open accepted malformed input", name)
+		}
+	}
+}
