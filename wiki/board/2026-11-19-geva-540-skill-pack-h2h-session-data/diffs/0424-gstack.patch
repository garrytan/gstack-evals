+        [Test]
+        public void FindRecommendations_WithConflictingRecommendations_AllFound()
+        {
+            // Arrange
+            using (var inst     = new DisposableKSP())
+            using (var repo     = new TemporaryRepository(
+                                      Relationships.RelationshipResolverTests.MergeWithDefaults(
+                                          @"{
+                                              ""identifier"": ""InstallingMod"",
+                                              ""recommends"": [
+                                                  { ""name"": ""RecA"" },
+                                                  { ""name"": ""RecB"" },
+                                                  { ""name"": ""RecC"" }
+                                              ],
+                                              ""suggests"": [
+                                                  { ""name"": ""SugA"" },
+                                                  { ""name"": ""SugB"" }
+                                              ]
+                                          }",
+                                          @"{
+                                              ""identifier"": ""RecA"",
+                                              ""conflicts"": [ { ""name"": ""RecB"" }, { ""name"": ""RecC"" } ]
+                                          }",
+                                          @"{
+                                              ""identifier"": ""RecB"",
+                                              ""conflicts"": [ { ""name"": ""RecA"" } ]
+                                          }",
+                                          @"{
+                                              ""identifier"": ""RecC""
+                                          }",
+                                          @"{
+                                              ""identifier"": ""SugA"",
+                                              ""conflicts"": [ { ""name"": ""SugB"" } ]
+                                          }",
+                                          @"{
+                                              ""identifier"": ""SugB""
+                                          }")
+                                          .ToArray()))
+            using (var repoData = new TemporaryRepositoryData(nullUser, repo.repo))
+            using (var regMgr   = RegistryManager.Instance(inst.KSP, repoData.Manager,
+                                                           new Repository[] { repo.repo }))
+            {
+                var registry = regMgr.registry;
+                CkanModule get(string ident)
+                    => registry.LatestAvailable(ident,
+                                                inst.KSP.StabilityToleranceConfig,
+                                                inst.KSP.VersionCriteria())!;
+                var toInstall = new CkanModule[] { get("InstallingMod") };
+
+                // Act
+                var result = ModuleInstaller.FindRecommendations(
+                                 inst.KSP, toInstall,
+                                 Array.Empty<CkanModule>(),
+                                 Array.Empty<CkanModule>(),
+                                 Array.Empty<CkanModule>(),
+                                 registry,
+                                 out Dictionary<CkanModule, Tuple<bool, List<string>>> recommendations,
+                                 out Dictionary<CkanModule, List<string>> suggestions,
+                                 out Dictionary<CkanModule, HashSet<string>> supporters);
+
+                // Assert
+                Assert.IsTrue(result);
+                CollectionAssert.AreEquivalent(new CkanModule[] { get("RecA"), get("RecB"), get("RecC") },
+                                               recommendations.Keys);
+                CollectionAssert.AreEquivalent(new CkanModule[] { get("SugA"), get("SugB") },
+                                               suggestions.Keys);
+            }
+        }
