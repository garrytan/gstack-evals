+// isEngineVersionExpression reports whether an engine.version value is a GitHub Actions
+// expression (e.g. "${{ inputs.engine-version }}") that must be resolved at runtime.
+// Such values must be passed to shell steps via environment variables rather than being
+// interpolated directly into the command line.
+func isEngineVersionExpression(version string) bool {
+	trimmed := strings.TrimSpace(version)
+	return strings.HasPrefix(trimmed, "${{") && strings.HasSuffix(trimmed, "}}") && isGitHubExpression(trimmed)
+}
