index c36ed08..beb5bf2 100644
--- a/pkg/workflow/engine_validation.go
+++ b/pkg/workflow/engine_validation.go
@@ -251,3 +251,25 @@ func (c *Compiler) validateSingleEngineSpecification(mainEngineSetting string, i
 
 	return "", fmt.Errorf("invalid engine configuration in included file, missing or invalid 'id' field. Expected string, object with 'id' field, or inline definition with 'runtime.id'.\n\nExample (string):\nengine: copilot\n\nExample (object with id):\nengine:\n  id: copilot\n  model: gpt-4\n\nExample (inline runtime definition):\nengine:\n  runtime:\n    id: codex\n\nSee: %s", constants.DocsEnginesURL)
 }
+
+// validateEngineVersion validates the engine.version field.
+// Plain version strings (e.g. "1.2.3", "latest") are accepted as-is. Values containing
+// GitHub Actions expression markers must consist of exactly one complete expression
+// (e.g. "${{ inputs.engine-version }}"). Expressions are passed to install steps via an
+// environment variable, so mixing literal text with an expression is rejected to keep the
+// compiled shell command injection-safe.
+func validateEngineVersion(config *EngineConfig) error {
+	if config == nil || config.Version == "" {
+		return nil
+	}
+	version := config.Version
+	if !strings.Contains(version, "${{") && !strings.Contains(version, "}}") {
+		return nil
+	}
+	trimmed := strings.TrimSpace(version)
+	if !isEngineVersionExpression(trimmed) || strings.Count(trimmed, "${{") != 1 || strings.Count(trimmed, "}}") != 1 {
+		return fmt.Errorf("invalid engine.version %q: when using a GitHub Actions expression, engine.version must be a single complete expression (e.g. \"${{ inputs.engine-version }}\").\n\nSee: %s", version, constants.DocsEnginesURL)
+	}
+	config.Version = trimmed
+	return nil
+}
diff --git a/pkg/workflow/engine_version_expression_test.go b/pkg/workflow/engine_version_expression_test.go
new file mode 100644
index 0000000..51f59c9
--- /dev/null
+++ b/pkg/workflow/engine_version_expression_test.go
@@ -0,0 +1,116 @@
+//go:build !integration
+
+package workflow
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestIsEngineVersionExpression(t *testing.T) {
+	tests := []struct {
+		version string
+		want    bool
+	}{
+		{"1.2.3", false},
+		{"latest", false},
+		{"", false},
+		{"${{ inputs.engine-version }}", true},
+		{"  ${{ inputs.engine-version }}  ", true},
+		{"1.0-${{ inputs.x }}", false},
+		{"${{ inputs.x }}; rm -rf /", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.version, func(t *testing.T) {
+			assert.Equal(t, tt.want, isEngineVersionExpression(tt.version))
+		})
+	}
+}
+
+func TestValidateEngineVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		wantErr bool
+	}{
+		{"empty", "", false},
+		{"literal", "1.2.3", false},
+		{"expression", "${{ inputs.engine-version }}", false},
+		{"mixed prefix", "v${{ inputs.engine-version }}", true},
+		{"trailing shell", "${{ inputs.v }}; echo pwned", true},
+		{"two expressions", "${{ inputs.a }}${{ inputs.b }}", true},
+		{"unbalanced", "${{ inputs.a", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := validateEngineVersion(&EngineConfig{Version: tt.version})
+			if tt.wantErr {
+				assert.Error(t, err)
+			} else {
+				assert.NoError(t, err)
+			}
+		})
+	}
+	assert.NoError(t, validateEngineVersion(nil))
+}
+
+func TestEngineVersionExpressionInstallSteps(t *testing.T) {
+	const expr = "${{ inputs.engine-version }}"
+	engines := []CodingAgentEngine{
+		NewCopilotEngine(),
+		NewClaudeEngine(),
+		NewCodexEngine(),
+		NewGeminiEngine(),
+	}
+	for _, engine := range engines {
+		t.Run(engine.GetID(), func(t *testing.T) {
+			workflowData := &WorkflowData{
+				Name:         "test",
+				EngineConfig: &EngineConfig{ID: engine.GetID(), Version: expr},
+			}
+			steps := engine.GetInstallationSteps(workflowData)
+			require.NotEmpty(t, steps)
+
+			var all strings.Builder
+			for _, step := range steps {
+				for _, line := range step {
+					all.WriteString(line + "\n")
+					if strings.Contains(line, "run:") {
+						assert.NotContains(t, line, "${{", "expression must not be interpolated into run command: %s", line)
+					}
+				}
+			}
+			out := all.String()
+			assert.Contains(t, out, "ENGINE_VERSION: "+expr, "expression should be passed via env var")
+			assert.Contains(t, out, `"${ENGINE_VERSION}"`, "run command should reference quoted env var")
+		})
+	}
+}
+
+func TestEngineVersionLiteralInstallStepsUnchanged(t *testing.T) {
+	workflowData := &WorkflowData{
+		Name:         "test",
+		EngineConfig: &EngineConfig{ID: "claude", Version: "1.2.3"},
+	}
+	steps := NewClaudeEngine().GetInstallationSteps(workflowData)
+	var all strings.Builder
+	for _, step := range steps {
+		all.WriteString(strings.Join(step, "\n"))
+	}
+	out := all.String()
+	assert.Contains(t, out, "npm install -g @anthropic-ai/claude-code@1.2.3")
+	assert.NotContains(t, out, "ENGINE_VERSION")
+}
+
+func TestExtractEngineConfigAcceptsVersionExpression(t *testing.T) {
+	c := NewCompiler()
+	_, config := c.ExtractEngineConfig(map[string]any{
+		"engine": map[string]any{"id": "copilot", "version": "${{ inputs.engine-version }}"},
+	})
+	require.NotNil(t, config)
+	assert.Equal(t, "${{ inputs.engine-version }}", config.Version)
+	assert.NoError(t, validateEngineVersion(config))
+}
