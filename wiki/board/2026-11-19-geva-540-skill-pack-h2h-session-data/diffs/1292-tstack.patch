+func validProxySegment(s string) bool {
+	return s != "" && s != "." && s != ".." && !strings.ContainsAny(s, "/\\")
+}
+
+func hasDotSegment(p string) bool {
+	for _, seg := range strings.FieldsFunc(p, func(r rune) bool { return r == '/' || r == '\\' }) {
+		if seg == "." || seg == ".." {
+			return true
+		}
+	}
+	return false
+}
+
 func buildProxyURL(host, kind, namespace, name, path, rawQuery string) (string, error) {
-	path, err := url.JoinPath(host, "api/v1/namespaces", namespace, kind, name, "proxy", path)
+	if !validProxySegment(kind) || !validProxySegment(namespace) || !validProxySegment(name) {
+		return "", errors.New("invalid proxy target")
+	}
+	if hasDotSegment(path) {
+		return "", errors.New("invalid proxy path")
+	}
+	base, err := url.JoinPath(host, "api/v1/namespaces", namespace, kind, name, "proxy")
+	if err != nil {
+		return "", err
+	}
+	baseURL, err := url.Parse(base)
+	if err != nil {
+		return "", err
+	}
+	path, err = url.JoinPath(base, path)
 	if err != nil {
 		return "", err
 	}
