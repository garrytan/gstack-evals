@@ -0,0 +1,52 @@
+package fsext
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestListDirectoryDotStarGitignore(t *testing.T) {
+	tempDir := t.TempDir()
+
+	oldWd, _ := os.Getwd()
+	require.NoError(t, os.Chdir(tempDir))
+	t.Cleanup(func() { os.Chdir(oldWd) })
+
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile("another.go", []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile(".hidden", []byte("test"), 0o644))
+
+	files, _, err := ListDirectory(".", nil, 0)
+	require.NoError(t, err)
+
+	var names []string
+	for _, f := range files {
+		names = append(names, filepath.Base(f))
+	}
+	require.ElementsMatch(t, []string{"example.txt", "another.go"}, names)
+}
+
+func TestGlobWithDoubleStarDotStarGitignore(t *testing.T) {
+	tempDir := t.TempDir()
+
+	oldWd, _ := os.Getwd()
+	require.NoError(t, os.Chdir(tempDir))
+	t.Cleanup(func() { os.Chdir(oldWd) })
+
+	require.NoError(t, os.WriteFile(".gitignore", []byte(".*\n"), 0o644))
+	require.NoError(t, os.WriteFile("example.txt", []byte("test"), 0o644))
+	require.NoError(t, os.WriteFile("another.go", []byte("test"), 0o644))
+
+	files, _, err := GlobWithDoubleStar("**/*", ".", 0)
+	require.NoError(t, err)
+
+	var names []string
+	for _, f := range files {
+		names = append(names, filepath.Base(f))
+	}
+	require.ElementsMatch(t, []string{"example.txt", "another.go"}, names)
+}
