diff --git a/pkg/cli/copilot_agent_test.go b/pkg/cli/copilot_agent_test.go
index 2829182..ce488d2 100644
--- a/pkg/cli/copilot_agent_test.go
+++ b/pkg/cli/copilot_agent_test.go
@@ -341,3 +341,30 @@ ERROR: Test error
 		t.Error("Expected tool calls to be extracted")
 	}
 }
+
+func TestParseCopilotCodingAgentLogMetricsIgnoresProse(t *testing.T) {
+	logContent := `
+The agent calls a tool to run the command, since each tool calls back on completion.
+This tool launches a subprocess for the build or tool misuse is reported with unified output.
+Calling the tool with no args is fine; executing tool calls in parallel is safe.
+Tool call: github_search
+Executing tool: startHttpServer
+Using tool: noop
+Calling: label_agent
+`
+	metrics := ParseCopilotCodingAgentLogMetrics(logContent, false)
+
+	got := make(map[string]int)
+	for _, tc := range metrics.ToolCalls {
+		got[tc.Name] = tc.CallCount
+	}
+	want := map[string]int{"github_search": 1, "startHttpServer": 1, "noop": 1, "label_agent": 1}
+	if len(got) != len(want) {
+		t.Fatalf("expected tools %v, got %v", want, got)
+	}
+	for name, count := range want {
+		if got[name] != count {
+			t.Errorf("expected %s called %d times, got %d (all: %v)", name, count, got[name], got)
+		}
+	}
+}
