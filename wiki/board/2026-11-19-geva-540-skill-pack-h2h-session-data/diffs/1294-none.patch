@@ -3,9 +3,11 @@ package kube
 import (
 	"context"
 	"errors"
+	"fmt"
 	"io"
 	"net/http"
 	"net/url"
+	"strings"
 
 	"github.com/gin-gonic/gin"
 	"k8s.io/client-go/rest"
@@ -60,21 +62,78 @@ func HandleProxy(c *gin.Context, client *K8sClient, kind, namespace, name, proxy
 	}
 }
 
-func buildProxyURL(host, kind, namespace, name, path, rawQuery string) (string, error) {
-	path, err := url.JoinPath(host, "api/v1/namespaces", namespace, kind, name, "proxy", path)
+func validateProxySegment(field, value string) error {
+	if value == "" || value == "." || value == ".." ||
+		strings.ContainsAny(value, "/\\?#%") {
+		return fmt.Errorf("invalid %s", field)
+	}
+	return nil
+}
+
+func buildProxyURL(host, kind, namespace, name, proxyPath, rawQuery string) (string, error) {
+	if err := validateProxySegment("kind", kind); err != nil {
+		return "", err
+	}
+	if err := validateProxySegment("namespace", namespace); err != nil {
+		return "", err
+	}
+	if err := validateProxySegment("name", name); err != nil {
+		return "", err
+	}
+
+	base, err := url.Parse(host)
 	if err != nil {
 		return "", err
 	}
 
-	query, err := url.ParseQuery(rawQuery)
+	prefix := strings.TrimSuffix(base.EscapedPath(), "/") + "/api/v1/namespaces/" +
+		url.PathEscape(namespace) + "/" + url.PathEscape(kind) + "/" + url.PathEscape(name) + "/proxy"
+
+	var b strings.Builder
+	b.WriteString(prefix)
+	if proxyPath != "" {
+		trimmed := strings.TrimPrefix(proxyPath, "/")
+		if trimmed != "" {
+			for _, seg := range strings.Split(trimmed, "/") {
+				// Route params may still be percent-encoded (raw path mode), so
+				// decode each segment before validating it and re-encode it.
+				dec, err := url.PathUnescape(seg)
+				if err != nil || dec == "." || dec == ".." || strings.ContainsAny(dec, "/\\") {
+					return "", fmt.Errorf("invalid proxy path")
+				}
+				b.WriteString("/")
+				b.WriteString(url.PathEscape(dec))
+			}
+		} else {
+			b.WriteString("/")
+		}
+	}
+	escapedPath := b.String()
+
+	unescapedPath, err := url.PathUnescape(escapedPath)
 	if err != nil {
 		return "", err
 	}
-	u, err := url.Parse(path)
+	unescapedPrefix, err := url.PathUnescape(prefix)
 	if err != nil {
 		return "", err
 	}
-	u.RawQuery = query.Encode()
+	if unescapedPath != unescapedPrefix && !strings.HasPrefix(unescapedPath, unescapedPrefix+"/") {
+		return "", fmt.Errorf("invalid proxy path")
+	}
+
+	query, err := url.ParseQuery(rawQuery)
+	if err != nil {
+		return "", err
+	}
+	u := &url.URL{
+		Scheme:   base.Scheme,
+		User:     base.User,
+		Host:     base.Host,
+		Path:     unescapedPath,
+		RawPath:  escapedPath,
+		RawQuery: query.Encode(),
+	}
 	return u.String(), nil
 }
 
