@@ -0,0 +1 @@
+Fix Service restore failing when last-applied-configuration has "healthCheckNodePort": null
diff --git a/pkg/restore/actions/service_action.go b/pkg/restore/actions/service_action.go
index 9de7522..9f27298 100644
--- a/pkg/restore/actions/service_action.go
+++ b/pkg/restore/actions/service_action.go
@@ -101,15 +101,19 @@ func deleteHealthCheckNodePort(service *corev1api.Service) error {
 			return errors.WithStack(err)
 		}
 
-		healthCheckNodePort, exist, err := unstructured.NestedFloat64(*appliedServiceUnstructured, "spec", "healthCheckNodePort")
-		if err != nil {
-			return errors.WithStack(err)
-		}
+		// A null value means the user did not specify a port, same as absent.
+		raw, exist, _ := unstructured.NestedFieldNoCopy(*appliedServiceUnstructured, "spec", "healthCheckNodePort")
+		if exist && raw != nil {
+			healthCheckNodePort, ok := raw.(float64)
+			if !ok {
+				return errors.Errorf(".spec.healthCheckNodePort accessor error: %v is of the type %T, expected float64", raw, raw)
+			}
 
-		// Found healthCheckNodePort in lastAppliedConfig annotation,
-		// and the value is not 0. No need to delete, return.
-		if exist && healthCheckNodePort != 0 {
-			return nil
+			// Found healthCheckNodePort in lastAppliedConfig annotation,
+			// and the value is not 0. No need to delete, return.
+			if healthCheckNodePort != 0 {
+				return nil
+			}
 		}
 	}
 
