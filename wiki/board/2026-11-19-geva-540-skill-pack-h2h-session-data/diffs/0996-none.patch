@@ -545,30 +545,38 @@ func (ws *xlsxWorksheet) setColWidth(minVal, maxVal int, width float64) {
 // flatCols provides a method for the column's operation functions to flatten
 // and check the worksheet columns.
 func flatCols(col xlsxCol, cols []xlsxCol, replacer func(fc, c xlsxCol) xlsxCol) []xlsxCol {
+	// clampRange limits the column range to the valid worksheet column
+	// boundaries, to avoid unbounded expansion of crafted column ranges.
+	clampRange := func(minVal, maxVal int) (int, int) {
+		if minVal < MinColumns {
+			minVal = MinColumns
+		}
+		if maxVal > MaxColumns {
+			maxVal = MaxColumns
+		}
+		return minVal, maxVal
+	}
 	var fc []xlsxCol
-	for i := col.Min; i <= col.Max; i++ {
+	index := make(map[int]int)
+	minVal, maxVal := clampRange(col.Min, col.Max)
+	for i := minVal; i <= maxVal; i++ {
 		var c xlsxCol
 		_ = deepcopy.Copy(&c, col)
 		c.Min, c.Max = i, i
+		index[i] = len(fc)
 		fc = append(fc, c)
 	}
-	inFlat := func(colID int, cols []xlsxCol) (int, bool) {
-		for idx, c := range cols {
-			if c.Max == colID && c.Min == colID {
-				return idx, true
-			}
-		}
-		return -1, false
-	}
 	for _, column := range cols {
-		for i := column.Min; i <= column.Max; i++ {
-			if idx, ok := inFlat(i, fc); ok {
+		minVal, maxVal := clampRange(column.Min, column.Max)
+		for i := minVal; i <= maxVal; i++ {
+			if idx, ok := index[i]; ok {
 				fc[idx] = replacer(fc[idx], column)
 				continue
 			}
 			var c xlsxCol
 			_ = deepcopy.Copy(&c, column)
 			c.Min, c.Max = i, i
+			index[i] = len(fc)
 			fc = append(fc, c)
 		}
 	}
