+// TestFetchRejectsSiblingDirectoryEscape covers GHSA-r5jh-q2mw-gcx4: a
+// sibling directory whose name begins with the shared volume path (e.g.
+// "/packages-extra" next to "/packages") must not be writable via Fetch.
+func TestFetchRejectsSiblingDirectoryEscape(t *testing.T) {
+	parent := t.TempDir()
+	vol := filepath.Join(parent, "packages")
+	sibling := filepath.Join(parent, "packages-extra")
+	require.NoError(t, os.MkdirAll(vol, 0750))
+	require.NoError(t, os.MkdirAll(sibling, 0750))
+	f := &Fetcher{logger: loggerfactory.GetLogger(), sharedVolumePath: vol}
+
+	pkg := &fv1.Package{}
+	pkg.Spec.Source = fv1.Archive{Literal: []byte("evil")}
+	for _, name := range []string{"../packages-extra/evil", "", "."} {
+		code, err := f.Fetch(t.Context(), pkg, FunctionFetchRequest{FetchType: fv1.FETCH_SOURCE, Filename: name})
+		require.Error(t, err, "filename %q", name)
+		assert.Equal(t, http.StatusBadRequest, code, "filename %q", name)
+	}
+	_, err := os.Stat(filepath.Join(sibling, "evil"))
+	assert.True(t, os.IsNotExist(err), "nothing may be written into the sibling directory")
+}
+
+func TestWriteSecretOrConfigMapRejectsEscapingKey(t *testing.T) {
+	t.Parallel()
+	dir := t.TempDir()
+	require.Error(t, writeSecretOrConfigMap(map[string][]byte{"..": []byte("x")}, filepath.Join(dir, "sub")))
+	require.NoError(t, os.MkdirAll(filepath.Join(dir, "sub"), 0750))
+	require.Error(t, writeSecretOrConfigMap(map[string][]byte{"../evil": []byte("x")}, filepath.Join(dir, "sub")))
+	_, err := os.Stat(filepath.Join(dir, "evil"))
+	assert.True(t, os.IsNotExist(err))
+}
diff --git a/pkg/utils/root.go b/pkg/utils/root.go
new file mode 100644
index 0000000..c31ff5f
--- /dev/null
+++ b/pkg/utils/root.go
@@ -0,0 +1,89 @@
+package utils
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+// rootRel validates that name is a local, relative path that stays inside
+// root once cleaned, and returns the cleaned relative path.
+func rootRel(root, name string) (string, error) {
+	if root == "" {
+		return "", errors.New("invalid safe directory")
+	}
+	if name == "" || !filepath.IsLocal(name) {
+		return "", fmt.Errorf("path %q is not under the safe directory %s", name, root)
+	}
+	rel := filepath.Clean(name)
+	if rel == "." {
+		return "", fmt.Errorf("path %q is not under the safe directory %s", name, root)
+	}
+	return rel, nil
+}
+
+// RootJoin joins name onto root, returning an error if name is absolute,
+// empty, or would escape root (e.g. via ".."). Unlike a lexical prefix check,
+// this enforces a path-component boundary, so a sibling such as
+// "/packages-extra" is never accepted as being under "/packages".
+//
+// RootJoin is purely lexical; use the other Root* helpers for filesystem
+// operations so that symlinks cannot be used to escape root either.
+func RootJoin(root, name string) (string, error) {
+	rel, err := rootRel(root, name)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(root, rel), nil
+}
+
+func withRoot(root, name string, fn func(r *os.Root, rel string) error) error {
+	rel, err := rootRel(root, name)
+	if err != nil {
+		return err
+	}
+	r, err := os.OpenRoot(root)
+	if err != nil {
+		return err
+	}
+	defer r.Close()
+	return fn(r, rel)
+}
+
+// RootStat stats name inside root through os.Root.
+func RootStat(root, name string) (fs.FileInfo, error) {
+	var fi fs.FileInfo
+	err := withRoot(root, name, func(r *os.Root, rel string) error {
+		var err error
+		fi, err = r.Stat(rel)
+		return err
+	})
+	return fi, err
+}
+
+// RootWriteFile writes data to name inside root through os.Root.
+func RootWriteFile(root, name string, data []byte, perm fs.FileMode) error {
+	return withRoot(root, name, func(r *os.Root, rel string) error {
+		return r.WriteFile(rel, data, perm)
+	})
+}
+
+// RootMkdirAll creates name (and any parents) inside root through os.Root.
+func RootMkdirAll(root, name string, perm fs.FileMode) error {
+	return withRoot(root, name, func(r *os.Root, rel string) error {
+		return r.MkdirAll(rel, perm)
+	})
+}
+
+// RootRename renames oldName to newName, both inside root, through os.Root.
+func RootRename(root, oldName, newName string) error {
+	newRel, err := rootRel(root, newName)
+	if err != nil {
+		return err
+	}
+	return withRoot(root, oldName, func(r *os.Root, oldRel string) error {
+		return r.Rename(oldRel, newRel)
+	})
+}
diff --git a/pkg/utils/root_test.go b/pkg/utils/root_test.go
new file mode 100644
index 0000000..440ebf9
--- /dev/null
+++ b/pkg/utils/root_test.go
@@ -0,0 +1,128 @@
+package utils
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// TestRootJoinRejectsSiblingPrefix reproduces GHSA-r5jh-q2mw-gcx4: a lexical
+// HasPrefix check accepted "/packages-extra/evil" as being under "/packages".
+func TestRootJoinRejectsSiblingPrefix(t *testing.T) {
+	parent := t.TempDir()
+	safe := filepath.Join(parent, "packages")
+	sibling := filepath.Join(parent, "packages-extra")
+	for _, d := range []string{safe, sibling} {
+		if err := os.MkdirAll(d, 0o750); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	bad := []string{
+		"",
+		".",
+		"../packages-extra/evil",
+		"../packages-extra",
+		"..",
+		"../../etc/passwd",
+		"foo/../../packages-extra/evil",
+		sibling + "/evil",
+		"/etc/passwd",
+	}
+	for _, name := range bad {
+		if p, err := RootJoin(safe, name); err == nil {
+			t.Errorf("RootJoin(%q, %q) = %q, want error", safe, name, p)
+		}
+	}
+
+	good := map[string]string{
+		"pkg":         filepath.Join(safe, "pkg"),
+		"pkg.tmp":     filepath.Join(safe, "pkg.tmp"),
+		"ns/name":     filepath.Join(safe, "ns", "name"),
+		"a/../b":      filepath.Join(safe, "b"),
+		"packages-xy": filepath.Join(safe, "packages-xy"),
+	}
+	for name, want := range good {
+		got, err := RootJoin(safe, name)
+		if err != nil {
+			t.Errorf("RootJoin(%q, %q) unexpected error: %v", safe, name, err)
+			continue
+		}
+		if got != want {
+			t.Errorf("RootJoin(%q, %q) = %q, want %q", safe, name, got, want)
+		}
+	}
+}
+
+func TestRootJoinRejectsEmptyRoot(t *testing.T) {
+	if _, err := RootJoin("", "pkg"); err == nil {
+		t.Fatal("expected error for empty root")
+	}
+}
+
+func TestRootFileOpsConfined(t *testing.T) {
+	parent := t.TempDir()
+	safe := filepath.Join(parent, "packages")
+	sibling := filepath.Join(parent, "packages-extra")
+	if err := os.MkdirAll(safe, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(sibling, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	// A symlink inside the root pointing at the sibling must not be followed.
+	if err := os.Symlink(sibling, filepath.Join(safe, "link")); err != nil {
+		t.Fatal(err)
+	}
+
+	if err := RootWriteFile(safe, "../packages-extra/evil", []byte("x"), 0o600); err == nil {
+		t.Error("RootWriteFile escaped via ..")
+	}
+	if err := RootWriteFile(safe, "link/evil", []byte("x"), 0o600); err == nil {
+		t.Error("RootWriteFile escaped via symlink")
+	}
+	if _, err := os.Stat(filepath.Join(sibling, "evil")); err == nil {
+		t.Fatal("file was written into sibling directory")
+	}
+	if err := RootMkdirAll(safe, "../packages-extra/dir", 0o750); err == nil {
+		t.Error("RootMkdirAll escaped via ..")
+	}
+	if err := RootMkdirAll(safe, "link/dir", 0o750); err == nil {
+		t.Error("RootMkdirAll escaped via symlink")
+	}
+	if err := os.WriteFile(filepath.Join(sibling, "secret"), []byte("s"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := RootStat(safe, "../packages-extra/secret"); err == nil {
+		t.Error("RootStat escaped via ..")
+	}
+	if _, err := RootStat(safe, "link/secret"); err == nil {
+		t.Error("RootStat escaped via symlink")
+	}
+
+	// Happy paths.
+	if err := RootMkdirAll(safe, "ns/name", 0o750); err != nil {
+		t.Fatalf("RootMkdirAll: %v", err)
+	}
+	if err := RootWriteFile(safe, "ns/name/key", []byte("v"), 0o600); err != nil {
+		t.Fatalf("RootWriteFile: %v", err)
+	}
+	if _, err := RootStat(safe, "ns/name/key"); err != nil {
+		t.Fatalf("RootStat: %v", err)
+	}
+	if err := RootRename(safe, "ns/name/key", "ns/name/key2"); err != nil {
+		t.Fatalf("RootRename: %v", err)
+	}
+	if err := RootRename(safe, "ns/name/key2", "../packages-extra/stolen"); err == nil {
+		t.Error("RootRename escaped via ..")
+	}
+	if _, err := os.Stat(filepath.Join(sibling, "stolen")); err == nil {
+		t.Fatal("file was renamed into sibling directory")
+	}
+}
+
+func TestDeleteOldPackagesRejectsSiblingPrefix(t *testing.T) {
+	if err := DeleteOldPackages("/packages-extra/evil", "SRC_PKG"); err == nil {
+		t.Fatal("expected error for sibling of /packages")
+	}
+}
