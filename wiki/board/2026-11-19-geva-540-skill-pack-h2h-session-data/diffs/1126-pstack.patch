+// stripTrailerValues keeps only the declared request trailer names.
+// Trailer values arrive after routing and header sanitization have run, and a
+// body-buffering middleware can populate them before the proxy clones the request.
+// A fresh map also detaches the outgoing trailers from the inbound map that net/http
+// fills at body EOF.
+func stripTrailerValues(req *http.Request) {
+	if req.Trailer == nil {
+		return
+	}
+
+	names := make(http.Header, len(req.Trailer))
+	for name := range req.Trailer {
+		names[name] = nil
+	}
+	req.Trailer = names
+}
