diff --git a/src/linker-script.cc b/src/linker-script.cc
index 51144b3..81541e8 100644
--- a/src/linker-script.cc
+++ b/src/linker-script.cc
@@ -249,9 +249,16 @@ std::string_view Script<E>::get_script_output_type() {
   }
 
   if (tok.size() >= 3 && (tok[0] == "INPUT" || tok[0] == "GROUP") &&
-      tok[1] == "(")
-    if (MappedFile *mf = resolve_path(tok[2], false))
-      return get_machine_type(ctx, rctx, mf);
+      tok[1] == "(") {
+    // Skip nested AS_NEEDED( ... ) wrappers to find the first file.
+    tok = tok.subspan(2);
+    while (tok.size() >= 2 && tok[0] == "AS_NEEDED" && tok[1] == "(")
+      tok = tok.subspan(2);
+
+    if (!tok.empty() && tok[0] != ")")
+      if (MappedFile *mf = resolve_path(tok[0], false))
+        return get_machine_type(ctx, rctx, mf);
+  }
   return "";
 }
 
diff --git a/test/linker-script7.sh b/test/linker-script7.sh
new file mode 100755
index 0000000..f86234f
--- /dev/null
+++ b/test/linker-script7.sh
@@ -0,0 +1,19 @@
+#!/bin/bash
+. $(dirname $0)/common.inc
+
+cat <<EOF | $CC -fPIC -o $t/a.o -c -xc -
+void foo() {}
+EOF
+
+$CC -B. -shared -o $t/libfoo.so $t/a.o
+
+cat <<EOF > $t/libbar.so
+INPUT(AS_NEEDED(-lfoo))
+EOF
+
+cat <<EOF | $CC -o $t/c.o -c -xc -
+int main() {}
+EOF
+
+./mold -o $t/exe -L$t -lbar $t/c.o
+./mold -o $t/exe -L$t $t/libbar.so $t/c.o
