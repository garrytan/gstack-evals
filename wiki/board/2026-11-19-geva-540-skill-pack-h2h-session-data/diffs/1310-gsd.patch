+// hasDotSegment reports whether the given path contains a "." or ".." segment,
+// including percent-encoded variants and backslash-separated segments.
+func hasDotSegment(p string) bool {
+	candidates := []string{p}
+	// Repeatedly decode to catch (multiply) percent-encoded dot segments.
+	cur := p
+	for i := 0; i < 3; i++ {
+		dec, err := url.PathUnescape(cur)
+		if err != nil || dec == cur {
+			break
+		}
+		candidates = append(candidates, dec)
+		cur = dec
+	}
+	for _, c := range candidates {
+		c = strings.ReplaceAll(c, "\\", "/")
+		for _, seg := range strings.Split(c, "/") {
+			if seg == "." || seg == ".." {
+				return true
+			}
+		}
+	}
+	return false
+}
