+func TestGetURLPathTraversal(t *testing.T) {
+	baseURL := "https://api.good.com"
+	path := "/api/v1/users/{{.id}}"
+	pathParams := parameters.Parameters{parameters.NewStringParameter("id", "user id")}
+
+	rejected := []string{
+		"../../../admin/secrets",
+		"..",
+		".",
+		"123/../../admin",
+		"%2e%2e/%2e%2e/admin",
+		"%2E%2E%2F%2E%2E%2Fadmin",
+		"%252e%252e/admin",
+		"..\\..\\admin",
+	}
+	for _, v := range rejected {
+		t.Run("reject "+v, func(t *testing.T) {
+			u, err := getURL(baseURL, path, pathParams, nil, nil, map[string]any{"id": v})
+			if err == nil {
+				t.Fatalf("expected error for %q, got URL %q", v, u)
+			}
+		})
+	}
+
+	allowed := map[string]string{
+		"123":     "https://api.good.com/api/v1/users/123",
+		"a.b":     "https://api.good.com/api/v1/users/a.b",
+		"...":     "https://api.good.com/api/v1/users/...",
+		"123/abc": "https://api.good.com/api/v1/users/123/abc",
+	}
+	for v, want := range allowed {
+		t.Run("allow "+v, func(t *testing.T) {
+			got, err := getURL(baseURL, path, pathParams, nil, nil, map[string]any{"id": v})
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if got != want {
+				t.Fatalf("got %q, want %q", got, want)
+			}
+		})
+	}
+}
