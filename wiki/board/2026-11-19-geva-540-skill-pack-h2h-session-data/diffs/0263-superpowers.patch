+++ b/internal/tools/semconvkit/templates/error_type_test.go.tmpl
@@ -5,6 +5,7 @@ package semconv // import "go.opentelemetry.io/otel/semconv/{{.TagVer}}"
 
 import (
 	"errors"
+	"fmt"
 	"testing"
 )
 
@@ -18,6 +19,15 @@ func TestErrorType(t *testing.T) {
 	check(t, custom(""), pkg+".ErrCustomType")                     // empty ErrorType, use concrete type.
 	check(t, wrapped(custom("wrapped-aborted")), "wrapped-aborted")
 	check(t, wrapped(custom("")), pkg+".wrappedErr") // empty ErrorType in chain, use concrete top-level type.
+
+	// fmt.Errorf wrappers are unwrapped to find a meaningful type.
+	check(t, fmt.Errorf("ctx: %w", errors.New("msg")), "*errors.errorString")
+	check(t, fmt.Errorf("outer: %w", fmt.Errorf("inner: %w", custom(""))), pkg+".ErrCustomType")
+	check(t, fmt.Errorf("outer: %w", wrapped(custom(""))), pkg+".wrappedErr")
+	check(t, fmt.Errorf("ctx: %w", custom("fmt-aborted")), "fmt-aborted")
+	check(t, fmt.Errorf("msg: %v", errors.New("msg")), "*errors.errorString") // no wrapping.
+	check(t, fmt.Errorf("ctx: %w", nil), "*fmt.wrapError")                    // nothing to unwrap to.
+	check(t, fmt.Errorf("%w %w", errors.New("a"), errors.New("b")), "*fmt.wrapErrors")
 }
 
