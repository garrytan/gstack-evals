@@ -5,6 +5,7 @@ package semconv // import "go.opentelemetry.io/otel/semconv/{{.TagVer}}"
 
 import (
 	"errors"
+	"fmt"
 	"reflect"
 
 	"go.opentelemetry.io/otel/attribute"
@@ -24,6 +25,11 @@ import (
 // [errors.As] is used. Otherwise, the returned attribute has a value derived
 // from the concrete type of err.
 //
+// When deriving the value from the concrete type, errors created by
+// [fmt.Errorf] with a single %w verb are unwrapped, as the wrapping type
+// (*fmt.wrapError) carries no meaningful type information. The type of the
+// first error in the chain that is not such a wrapper is used instead.
+//
 // The key of the returned attribute is [ErrorTypeKey].
 func ErrorType(err error) attribute.KeyValue {
 	if err == nil {
@@ -50,7 +56,7 @@ func errorType(err error) string {
 		// Fallback to reflection if the ErrorType method is not supported or
 		// returns an empty value.
 
-		t := reflect.TypeOf(err)
+		t := reflect.TypeOf(unwrapFmt(err))
 		pkg, name := t.PkgPath(), t.Name()
 		if pkg != "" && name != "" {
 			s = pkg + "." + name
@@ -64,3 +70,21 @@ func errorType(err error) string {
 	}
 	return s
 }
+
+// fmtWrapErrorType is the type of errors returned by [fmt.Errorf] when the
+// format contains a single %w verb.
+var fmtWrapErrorType = reflect.TypeOf(fmt.Errorf("%w", errors.New("")))
+
+// unwrapFmt unwraps err while it is a wrapping error created by [fmt.Errorf]
+// with a single %w verb. Those wrappers do not convey any meaningful type
+// information, so the type of the wrapped error is more useful.
+func unwrapFmt(err error) error {
+	for reflect.TypeOf(err) == fmtWrapErrorType {
+		inner := errors.Unwrap(err)
+		if inner == nil {
+			break
+		}
+		err = inner
+	}
+	return err
+}
