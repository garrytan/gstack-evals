+// removeSubjectsCoveredByWildcardManagers removes subjects from automation
+// policies that have no configuration other than their subjects, if those
+// subjects are covered by a wildcard subject in another policy that has
+// certificate managers configured (and the subject is not forced to be
+// automated individually). Otherwise, the more specific, empty policy would
+// be chosen at handshake-time, and since the name is covered by the wildcard
+// it is not managed individually, so no certificate would be found. Policies
+// that end up with no subjects are removed entirely.
+func removeSubjectsCoveredByWildcardManagers(aps []*caddytls.AutomationPolicy, forcedAutomatedNames map[string]struct{}) []*caddytls.AutomationPolicy {
+	coveredByWildcardManager := func(self int, subj string) bool {
+		for i, ap := range aps {
+			if i == self || len(ap.ManagersRaw) == 0 {
+				continue
+			}
+			for _, wc := range ap.SubjectsRaw {
+				if wc != subj && strings.Contains(wc, "*") && certmagic.MatchWildcard(subj, wc) {
+					return true
+				}
+			}
+		}
+		return false
+	}
+
+	result := make([]*caddytls.AutomationPolicy, 0, len(aps))
+	for i, ap := range aps {
+		if len(ap.SubjectsRaw) == 0 {
+			result = append(result, ap)
+			continue
+		}
+		emptyAP := &caddytls.AutomationPolicy{SubjectsRaw: ap.SubjectsRaw}
+		if !reflect.DeepEqual(ap, emptyAP) {
+			result = append(result, ap)
+			continue
+		}
+		var keep []string
+		for _, subj := range ap.SubjectsRaw {
+			if _, forced := forcedAutomatedNames[subj]; forced || !coveredByWildcardManager(i, subj) {
+				keep = append(keep, subj)
+			}
+		}
+		if len(keep) == 0 {
+			continue
+		}
+		ap.SubjectsRaw = keep
+		result = append(result, ap)
+	}
+	return result
+}
