+struct BlankTolerantMatch {
+    /// Byte range in the file from the first to the last matched line, without
+    /// the last line's terminator.
+    span: std::ops::Range<usize>,
+    /// `gaps[i]` holds the file's blank lines that follow the i-th non-blank
+    /// line of `old_string` inside the span.
+    gaps: Vec<Vec<String>>,
+    skipped_blanks: usize,
+}
+
+enum BlankTolerantOutcome {
+    Unique(BlankTolerantMatch),
+    Ambiguous(usize),
+    NotFound,
+}
+
+fn non_blank_lines(s: &str) -> Vec<&str> {
+    s.lines()
+        .map(str::trim_end)
+        .filter(|l| !l.is_empty())
+        .collect()
+}
+
+/// Compressed `ctx_read` modes drop blank lines, so an `old_string` copied from
+/// that output skips blank lines the file still has. Match the non-blank lines
+/// of `old_string` against consecutive non-blank file lines.
+fn find_blank_tolerant_match(content: &str, old_str: &str) -> BlankTolerantOutcome {
+    let needle = non_blank_lines(old_str);
+    if needle.len() < 2 {
+        return BlankTolerantOutcome::NotFound;
+    }
+
+    let mut lines: Vec<(usize, &str)> = Vec::new();
+    let mut offset = 0;
+    for raw in content.split_inclusive('\n') {
+        lines.push((offset, raw.trim_end_matches(['\n', '\r'])));
+        offset += raw.len();
+    }
+    let non_blank: Vec<usize> = (0..lines.len())
+        .filter(|&i| !lines[i].1.trim().is_empty())
+        .collect();
+
+    let starts: Vec<usize> = (0..non_blank.len().saturating_sub(needle.len() - 1))
+        .filter(|&s| {
+            needle
+                .iter()
+                .enumerate()
+                .all(|(k, n)| lines[non_blank[s + k]].1.trim_end() == *n)
+        })
+        .collect();
+
+    match starts.as_slice() {
+        [] => BlankTolerantOutcome::NotFound,
+        [s] => {
+            let matched = &non_blank[*s..*s + needle.len()];
+            let (first, last) = (matched[0], matched[matched.len() - 1]);
+            let gaps: Vec<Vec<String>> = matched
+                .windows(2)
+                .map(|w| {
+                    (w[0] + 1..w[1])
+                        .map(|i| lines[i].1.to_string())
+                        .collect()
+                })
+                .chain(std::iter::once(Vec::new()))
+                .collect();
+            let skipped_blanks = (last - first + 1) - needle.len();
+            if skipped_blanks == 0 {
+                return BlankTolerantOutcome::NotFound;
+            }
+            BlankTolerantOutcome::Unique(BlankTolerantMatch {
+                span: lines[first].0..lines[last].0 + lines[last].1.len(),
+                gaps,
+                skipped_blanks,
+            })
+        }
+        many => BlankTolerantOutcome::Ambiguous(many.len()),
+    }
+}
+
+/// Builds the replacement text for a blank-tolerant match. Lines that the edit
+/// leaves unchanged keep the blank lines that followed them in the file, so an
+/// edit made from a blank-stripped read does not also delete the file's blank lines.
+fn rebuild_with_file_blanks(
+    old_str: &str,
+    new_str: &str,
+    gaps: &[Vec<String>],
+    line_sep: &str,
+) -> String {
+    let old_lines = non_blank_lines(old_str);
+    let new_norm = new_str.replace("\r\n", "\n");
+    let new_lines: Vec<&str> = new_norm.lines().collect();
+
+    let mut out: Vec<&str> = Vec::new();
+    let mut content_end = 0;
+    for op in similar::capture_diff_slices(similar::Algorithm::Myers, &old_lines, &new_lines) {
+        match op {
+            similar::DiffOp::Equal {
+                old_index,
+                new_index,
+                len,
+            } => {
+                for k in 0..len {
+                    out.push(new_lines[new_index + k]);
+                    content_end = out.len();
+                    out.extend(gaps[old_index + k].iter().map(String::as_str));
+                }
+            }
+            similar::DiffOp::Insert {
+                new_index, new_len, ..
+            } => {
+                out.extend(&new_lines[new_index..new_index + new_len]);
+                content_end = out.len();
+            }
+            similar::DiffOp::Replace {
+                old_index,
+                old_len,
+                new_index,
+                new_len,
+            } => {
+                for k in 0..new_len {
+                    out.push(new_lines[new_index + k]);
+                    content_end = out.len();
+                    let gap = if old_len == new_len {
+                        Some(old_index + k)
+                    } else {
+                        (k + 1 == new_len).then(|| old_index + old_len - 1)
+                    };
+                    if let Some(g) = gap {
+                        out.extend(gaps[g].iter().map(String::as_str));
+                    }
+                }
+            }
+            similar::DiffOp::Delete { .. } => {}
+        }
+    }
+    out.truncate(content_end);
+    let mut rebuilt = out.join(line_sep);
+    if new_norm.ends_with('\n') && !old_str.ends_with('\n') {
+        rebuilt.push_str(line_sep);
+    }
+    rebuilt
+}
