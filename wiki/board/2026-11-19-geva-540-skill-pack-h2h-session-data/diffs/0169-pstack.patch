+    #[test]
+    fn edit_from_blank_stripped_read_succeeds_and_keeps_blank_lines() {
+        let src = "fn a() {\n    let x = 1;\n\n    let y = 2;\n\n    x + y\n}\n";
+        let f = make_temp(src);
+        let stripped = crate::core::compressor::aggressive_compress(src, Some("txt"));
+        assert!(!stripped.contains("\n\n"), "compressed read drops blank lines");
+        let old = "    let x = 1;\n    let y = 2;\n    x + y";
+        let new = "    let x = 10;\n    let y = 2;\n    x + y";
+        let (text, effect) = run_io(&mk_params(f.path(), old, new, false, false), "aggressive");
+        assert!(text.starts_with('\u{2713}'), "got: {text}");
+        assert!(matches!(effect, CacheEffect::Invalidate));
+        assert_eq!(
+            std::fs::read_to_string(f.path()).unwrap(),
+            "fn a() {\n    let x = 10;\n\n    let y = 2;\n\n    x + y\n}\n"
+        );
+    }
+
+    #[test]
+    fn blank_tolerant_match_drops_blank_of_deleted_line() {
+        let f = make_temp("a\n\nb\n\nc\n");
+        let (text, _) = run_io(&mk_params(f.path(), "a\nb\nc", "a\nc", false, false), "");
+        assert!(text.starts_with('\u{2713}'), "got: {text}");
+        assert_eq!(std::fs::read_to_string(f.path()).unwrap(), "a\n\nc\n");
+    }
+
+    #[test]
+    fn blank_tolerant_match_preserves_crlf() {
+        let f = make_temp("one\r\n\r\ntwo\r\nthree\r\n");
+        let (text, _) = run_io(&mk_params(f.path(), "one\ntwo", "one\ntwo!", false, false), "");
+        assert!(text.starts_with('\u{2713}'), "got: {text}");
+        assert_eq!(std::fs::read_to_string(f.path()).unwrap(), "one\r\n\r\ntwo!\r\nthree\r\n");
+    }
+
+    #[test]
