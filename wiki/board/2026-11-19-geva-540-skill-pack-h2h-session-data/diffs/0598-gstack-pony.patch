@@ -0,0 +1,12 @@
+import { tick } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	mode: ['async-server', 'client', 'hydrate'],
+	ssrHtml: `<p>No data</p>`,
+
+	async test({ assert, target }) {
+		await tick();
+		assert.htmlEqual(target.innerHTML, `<p>No data</p>`);
+	}
+});
diff --git a/packages/svelte/tests/runtime-runes/samples/async-const-destructure-blocker/main.svelte b/packages/svelte/tests/runtime-runes/samples/async-const-destructure-blocker/main.svelte
