+<script>
+	let d = $derived(await Promise.resolve({ data: 1, hasData: false }));
+	let showFetchCta = $derived(d.hasData);
+</script>
+
+{#if d}
+	{@const {data, hasData} = d}
+	{#if hasData}
+		<p>The Data: {data}</p>
+	{:else if showFetchCta}
+		<p>Fetch now</p>
+	{:else}
+		<p>No data</p>
+	{/if}
+{/if}
