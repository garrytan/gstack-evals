index 0000000..3717834
--- /dev/null
+++ b/openapi3/schema_circular_xof_test.go
@@ -0,0 +1,50 @@
+package openapi3
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestVisitJSONCircularXOF(t *testing.T) {
+	for _, kind := range []string{"allOf", "anyOf", "oneOf"} {
+		t.Run(kind, func(t *testing.T) {
+			s := &Schema{
+				Type:       &Types{"object"},
+				Properties: Schemas{"name": {Value: &Schema{Type: &Types{"string"}}}},
+			}
+			refs := SchemaRefs{{Value: s}}
+			switch kind {
+			case "allOf":
+				s.AllOf = refs
+			case "anyOf":
+				s.AnyOf = refs
+			case "oneOf":
+				s.OneOf = refs
+			}
+			require.NoError(t, s.Validate(context.Background()))
+			require.NoError(t, s.VisitJSON(map[string]any{"name": "test"}))
+			require.Error(t, s.VisitJSON(map[string]any{"name": 42}))
+			require.Error(t, s.VisitJSON("not an object"))
+		})
+	}
+
+	t.Run("indirect", func(t *testing.T) {
+		a := &Schema{Type: &Types{"string"}}
+		b := &Schema{AllOf: SchemaRefs{{Value: a}}}
+		a.AnyOf = SchemaRefs{{Value: b}}
+		require.NoError(t, a.VisitJSON("x"))
+		require.Error(t, a.VisitJSON(1.0))
+	})
+
+	t.Run("recursive data structure still validated", func(t *testing.T) {
+		node := &Schema{Type: &Types{"object"}}
+		node.Properties = Schemas{
+			"value": {Value: &Schema{Type: &Types{"integer"}}},
+			"next":  {Value: &Schema{AllOf: SchemaRefs{{Value: node}}}},
+		}
+		require.NoError(t, node.VisitJSON(map[string]any{"value": 1.0, "next": map[string]any{"value": 2.0}}))
+		require.Error(t, node.VisitJSON(map[string]any{"value": 1.0, "next": map[string]any{"value": "x"}}))
+	})
+}
