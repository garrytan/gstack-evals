@@ -0,0 +1,83 @@
+package openapi3filter
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestValidateRequestCircularXOF(t *testing.T) {
+	for _, kind := range []string{"allOf", "anyOf", "oneOf"} {
+		for _, typ := range []string{"object", "string", "array"} {
+			t.Run(kind+"/"+typ, func(t *testing.T) {
+				extra := ""
+				if typ == "object" {
+					extra = "\n      properties:\n        name: { type: string }"
+				}
+				if typ == "array" {
+					extra = "\n      items: { $ref: '#/components/schemas/Recursive' }"
+				}
+				spec := `
+openapi: '3.0.0'
+info: { title: t, version: '1.0' }
+paths:
+  /test:
+    get:
+      parameters:
+        - name: data
+          in: query
+          schema: { $ref: '#/components/schemas/Recursive' }
+        - name: deep
+          in: query
+          style: deepObject
+          schema: { $ref: '#/components/schemas/Recursive' }
+      responses: { '200': { description: OK } }
+components:
+  schemas:
+    Recursive:
+      type: ` + typ + `
+      ` + kind + `:
+        - $ref: '#/components/schemas/Recursive'` + extra + `
+`
+				loader := openapi3.NewLoader()
+				doc, err := loader.LoadFromData([]byte(spec))
+				require.NoError(t, err)
+				require.NoError(t, doc.Validate(loader.Context))
+				router, err := gorillamux.NewRouter(doc)
+				require.NoError(t, err)
+
+				for _, q := range []string{"data=x", "deep[name]=x", "data=a,b"} {
+					req, err := http.NewRequest(http.MethodGet, "http://example.com/test?"+q, nil)
+					require.NoError(t, err)
+					route, pathParams, err := router.FindRoute(req)
+					require.NoError(t, err)
+					// Must return (error or not) rather than overflowing the stack.
+					_ = ValidateRequest(context.Background(), &RequestValidationInput{
+						Request: req, PathParams: pathParams, Route: route,
+					})
+				}
+			})
+		}
+	}
+}
+
+func TestDecodeCircularXOFHelpers(t *testing.T) {
+	s := &openapi3.Schema{}
+	s.AnyOf = openapi3.SchemaRefs{{Value: s}}
+	ref := &openapi3.SchemaRef{Value: s}
+
+	d := &urlValuesDecoder{}
+	_, err := d.parseValue("x", ref)
+	require.ErrorIs(t, err, errCircularSchemaRef)
+
+	_, err = buildResObj(map[string]any{"a": "x"}, nil, "a", ref)
+	require.ErrorIs(t, err, errCircularSchemaRef)
+
+	_, _, err = decodeValue(&urlValuesDecoder{}, "a", &openapi3.SerializationMethod{Style: "form", Explode: true}, ref, false)
+	require.ErrorIs(t, err, errCircularSchemaRef)
+}
