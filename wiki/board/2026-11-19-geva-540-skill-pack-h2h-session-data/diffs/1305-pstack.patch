diff --git a/pkg/packet/bgp/bgp_update_underflow_test.go b/pkg/packet/bgp/bgp_update_underflow_test.go
new file mode 100644
index 0000000..e592c43
--- /dev/null
+++ b/pkg/packet/bgp/bgp_update_underflow_test.go
@@ -0,0 +1,36 @@
+package bgp
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func unknownExtendedAttr(valueLen int) []byte {
+	b := make([]byte, 4+valueLen)
+	b[0] = byte(BGP_ATTR_FLAG_OPTIONAL | BGP_ATTR_FLAG_TRANSITIVE | BGP_ATTR_FLAG_EXTENDED_LENGTH)
+	b[1] = 0xfe
+	binary.BigEndian.PutUint16(b[2:4], uint16(valueLen))
+	return b
+}
+
+func TestBGPUpdateDecodeAttributeLongerThanTotalPathAttributeLen(t *testing.T) {
+	data := []byte{0x00, 0x00, 0x00, 0x03}
+	data = append(data, unknownExtendedAttr(10)...)
+	data = append(data, unknownExtendedAttr(65520)...)
+	msg := &BGPUpdate{}
+	assert.NotPanics(t, func() {
+		assert.Error(t, msg.DecodeFromBytes(data))
+	})
+}
+
+func TestBGPUpdateDecodeWithdrawnRouteLongerThanWithdrawnRoutesLen(t *testing.T) {
+	data := []byte{
+		0x00, 0x01,
+		0x18, 0x0a, 0x00, 0x00,
+		0x00, 0x00,
+	}
+	msg := &BGPUpdate{}
+	assert.Error(t, msg.DecodeFromBytes(data))
+}
