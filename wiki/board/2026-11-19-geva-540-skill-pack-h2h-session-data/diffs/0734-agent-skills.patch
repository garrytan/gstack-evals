diff --git a/src/linker-script.cc b/src/linker-script.cc
index 51144b3..24d9f39 100644
--- a/src/linker-script.cc
+++ b/src/linker-script.cc
@@ -249,9 +249,17 @@ std::string_view Script<E>::get_script_output_type() {
   }
 
   if (tok.size() >= 3 && (tok[0] == "INPUT" || tok[0] == "GROUP") &&
-      tok[1] == "(")
-    if (MappedFile *mf = resolve_path(tok[2], false))
-      return get_machine_type(ctx, rctx, mf);
+      tok[1] == "(") {
+    // Skip over `AS_NEEDED (` to find the first file name, e.g.
+    // `INPUT ( AS_NEEDED ( -latomic ) )`
+    tok = tok.subspan(2);
+    while (tok.size() >= 2 && tok[0] == "AS_NEEDED" && tok[1] == "(")
+      tok = tok.subspan(2);
+
+    if (!tok.empty() && tok[0] != ")")
+      if (MappedFile *mf = resolve_path(tok[0], false))
+        return get_machine_type(ctx, rctx, mf);
+  }
   return "";
 }
 
diff --git a/test/linker-script7.sh b/test/linker-script7.sh
new file mode 100755
index 0000000..8eae17d
--- /dev/null
+++ b/test/linker-script7.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+. $(dirname $0)/common.inc
+
+# A linker script whose first INPUT entry is AS_NEEDED(...) must work
+# for machine type detection (GCC 16's libatomic_asneeded.so is like this).
+
+cat <<EOF | $CC -o $t/a.o -c -xc -fPIC -
+int foo() { return 42; }
+EOF
+
+$CC -B. -shared -o $t/libfoo.so -Wl,-soname,libfoo.so $t/a.o
+
+cat <<EOF > $t/libbar.so
+/* GNU ld script */
+INPUT ( AS_NEEDED ( -lfoo ) )
+EOF
+
+cat <<EOF | $CC -o $t/b.o -c -xc -
+int foo();
+int main() { return foo() != 42; }
+EOF
+
+./mold -o $t/c.so -shared -L$t $t/libbar.so
+./mold -o $t/d.so -shared -L$t $t/libbar.so $t/b.o
+readelf --dynamic $t/d.so | grep -F 'Shared library: [libfoo.so]'
+
+$CC -B. -o $t/exe -L$t $t/b.o $t/libbar.so
+LD_LIBRARY_PATH=$t $QEMU $t/exe
