diff --git a/pkg/workflow/engine_version_expression_test.go b/pkg/workflow/engine_version_expression_test.go
new file mode 100644
index 0000000..7b31501
--- /dev/null
+++ b/pkg/workflow/engine_version_expression_test.go
@@ -0,0 +1,95 @@
+//go:build !integration
+
+package workflow
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestEngineVersionExpressionInstallSteps verifies that engine.version values containing
+// GitHub Actions expressions are passed to installation steps via an environment variable
+// rather than interpolated directly into shell commands (injection safety).
+func TestEngineVersionExpressionInstallSteps(t *testing.T) {
+	const expr = "${{ inputs.engine-version }}"
+
+	tests := []struct {
+		name          string
+		engine        CodingAgentEngine
+		expectedRun   string
+		literalRunFmt string
+	}{
+		{
+			name:          "copilot",
+			engine:        NewCopilotEngine(),
+			expectedRun:   `run: ${RUNNER_TEMP}/gh-aw/actions/install_copilot_cli.sh "${ENGINE_VERSION}"`,
+			literalRunFmt: "run: ${RUNNER_TEMP}/gh-aw/actions/install_copilot_cli.sh 1.2.3",
+		},
+		{
+			name:          "claude",
+			engine:        NewClaudeEngine(),
+			expectedRun:   `run: npm install -g @anthropic-ai/claude-code@"${ENGINE_VERSION}"`,
+			literalRunFmt: "run: npm install -g @anthropic-ai/claude-code@1.2.3",
+		},
+		{
+			name:          "codex",
+			engine:        NewCodexEngine(),
+			expectedRun:   `run: npm install -g @openai/codex@"${ENGINE_VERSION}"`,
+			literalRunFmt: "run: npm install -g @openai/codex@1.2.3",
+		},
+		{
+			name:          "gemini",
+			engine:        NewGeminiEngine(),
+			expectedRun:   `run: npm install -g @google/gemini-cli@"${ENGINE_VERSION}"`,
+			literalRunFmt: "run: npm install -g @google/gemini-cli@1.2.3",
+		},
+	}
+
+	render := func(steps []GitHubActionStep) string {
+		var sb strings.Builder
+		for _, step := range steps {
+			sb.WriteString(strings.Join(step, "\n"))
+			sb.WriteString("\n")
+		}
+		return sb.String()
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name+"/expression", func(t *testing.T) {
+			data := &WorkflowData{Name: "test", EngineConfig: &EngineConfig{ID: tt.name, Version: expr}}
+			out := render(tt.engine.GetInstallationSteps(data))
+
+			assert.Contains(t, out, tt.expectedRun, "install command should reference env var")
+			assert.Contains(t, out, `ENGINE_VERSION: "${{ inputs.engine-version }}"`, "expression should be set via env")
+			for line := range strings.SplitSeq(out, "\n") {
+				if strings.Contains(line, "run:") {
+					assert.NotContains(t, line, "${{", "expression must not appear in a run command: %s", line)
+				}
+			}
+		})
+
+		t.Run(tt.name+"/literal", func(t *testing.T) {
+			data := &WorkflowData{Name: "test", EngineConfig: &EngineConfig{ID: tt.name, Version: "1.2.3"}}
+			out := render(tt.engine.GetInstallationSteps(data))
+
+			assert.Contains(t, out, tt.literalRunFmt, "literal versions should remain inline")
+			assert.NotContains(t, out, "ENGINE_VERSION", "literal versions should not use env var")
+		})
+	}
+}
+
+func TestExtractEngineConfigVersionExpression(t *testing.T) {
+	compiler := NewCompiler()
+	frontmatter := map[string]any{
+		"engine": map[string]any{
+			"id":      "copilot",
+			"version": "${{ inputs.engine-version }}",
+		},
+	}
+	_, config := compiler.ExtractEngineConfig(frontmatter)
+	require.NotNil(t, config)
+	assert.Equal(t, "${{ inputs.engine-version }}", config.Version)
+}
