+
+// engineVersionEnvVar is the environment variable used to pass an expression-based
+// engine version to installation steps without interpolating it into shell commands.
+const engineVersionEnvVar = "ENGINE_VERSION"
+
+// isEngineVersionExpression reports whether the engine version contains a GitHub Actions
+// expression (e.g. "${{ inputs.engine-version }}"). Such values are resolved at runtime
+// and must never be interpolated directly into a shell command.
+func isEngineVersionExpression(version string) bool {
+	return strings.Contains(version, "${{")
+}
