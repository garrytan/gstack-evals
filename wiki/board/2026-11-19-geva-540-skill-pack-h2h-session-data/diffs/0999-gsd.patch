+// Returns the end of the first `terminator` at or after `from`, or -1.
+//
+// The position of the last occurrence of each terminator is cached on the
+// state, so a construct whose terminator is absent from the rest of the input
+// fails in O(1) instead of rescanning the remaining input. Without that, a
+// paragraph of repeated unterminated openers (`<!--<!--...`) takes quadratic
+// time. On success the scan stops at the terminator, which is then consumed.
+function findTerminator (state: StateInline, terminator: string, from: number): number {
+  let cache = state.htmlTerminators
+  if (!cache) {
+    cache = state.htmlTerminators = {}
+  }
+
+  let last = cache[terminator]
+  if (last === undefined) {
+    last = cache[terminator] = state.src.lastIndexOf(terminator)
+  }
+
+  if (last < from) { return -1 }
+
+  return state.src.indexOf(terminator, from) + terminator.length
+}
+
+// Returns the length of the HTML comment, processing instruction,
+// declaration or CDATA section at `pos`, or 0 if there is none.
+function matchSpecial (state: StateInline, pos: number): number {
+  const src = state.src
+  let end = -1
+
+  if (src.startsWith('<!--', pos)) {
+    // <!-->, <!--->, or <!-- ... -->
+    if (src.startsWith('>', pos + 4)) return 5
+    if (src.startsWith('->', pos + 4)) return 6
+    end = findTerminator(state, '-->', pos + 4)
+  } else if (src.startsWith('<![CDATA[', pos)) {
+    end = findTerminator(state, ']]>', pos + 9)
+  } else if (src.charCodeAt(pos + 1) === 0x21/* ! */) {
+    if (!isLetter(src.charCodeAt(pos + 2))) return 0
+    end = findTerminator(state, '>', pos + 3)
+  } else if (src.charCodeAt(pos + 1) === 0x3F/* ? */) {
+    end = findTerminator(state, '?>', pos + 2)
+  } else {
+    return 0
+  }
+
+  return end < 0 ? 0 : end - pos
+}
