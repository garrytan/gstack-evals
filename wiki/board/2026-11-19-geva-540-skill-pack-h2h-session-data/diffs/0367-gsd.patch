+
+    [Fact]
+    public async Task MarkdownToHtmlAsyncShouldConvertMarkdown()
+    {
+        var services = new ServiceCollection();
+        services.AddOptions<MarkdownPipelineOptions>();
+        services.ConfigureMarkdownPipeline((pipeline) => pipeline.UseAdvancedExtensions());
+        services.AddScoped<IMarkdownService, DefaultMarkdownService>();
+        services.AddScoped<IShortcodeService, PassThroughShortcodeService>();
+
+        var orchardHelper = new TestOrchardHelper(new DefaultHttpContext
+        {
+            RequestServices = services.BuildServiceProvider(),
+        });
+
+        var result = await orchardHelper.MarkdownToHtmlAsync("This _is_ a ==test== markdown.", sanitize: false);
+
+        var html = result.ToString().ReplaceLineEndings(string.Empty);
+        Assert.Equal("<p>This <em>is</em> a <mark>test</mark> markdown.</p>", html);
+    }
+
+    private sealed class PassThroughShortcodeService : IShortcodeService
+    {
+        public ValueTask<string> ProcessAsync(string input, Context context = null) => ValueTask.FromResult(input);
+    }
+
+    private sealed class TestOrchardHelper : IOrchardHelper
+    {
+        public TestOrchardHelper(HttpContext httpContext)
+        {
+            HttpContext = httpContext;
+        }
+
+        public HttpContext HttpContext { get; }
+    }
