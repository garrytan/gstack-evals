+
+func TestSanitizeFilePath(t *testing.T) {
+	tests := []struct {
+		name    string
+		path    string
+		safedir string
+		wantErr bool
+	}{
+		{"child file", "/packages/foo", "/packages", false},
+		{"nested child", "/packages/a/b", "/packages", false},
+		{"safedir itself", "/packages", "/packages", false},
+		{"safedir trailing slash", "/packages/foo", "/packages/", false},
+		{"root safedir", "/foo", "/", false},
+		{"sibling with shared prefix", "/packages-extra/evil", "/packages", true},
+		{"sibling with shared prefix no dash", "/packagesevil", "/packages", true},
+		{"parent traversal", "/packages/../etc/passwd", "/packages", true},
+		{"outside dir", "/etc/passwd", "/packages", true},
+		{"empty path", "", "/packages", true},
+		{"empty safedir", "/packages/foo", "", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := SanitizeFilePath(tt.path, tt.safedir)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("SanitizeFilePath(%q, %q) = %q, err %v; wantErr %v", tt.path, tt.safedir, got, err, tt.wantErr)
+			}
+		})
+	}
+}
