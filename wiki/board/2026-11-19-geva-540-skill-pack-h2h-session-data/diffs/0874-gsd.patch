+export const steps = [{}, mount, reset, wait, reset, reset, wait];
+
+function mount(container: Element) {
+  container.querySelector<HTMLButtonElement>("#mount")!.click();
+}
+
+function reset(container: Element) {
+  container.querySelector<HTMLButtonElement>("#reset")!.click();
+}
+
+function wait() {
+  return new Promise((resolve) => setTimeout(resolve, 10));
+}
