diff --git a/pkg/packet/bgp/update_underflow_test.go b/pkg/packet/bgp/update_underflow_test.go
new file mode 100644
index 0000000..51adbd8
--- /dev/null
+++ b/pkg/packet/bgp/update_underflow_test.go
@@ -0,0 +1,32 @@
+package bgp
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestBGPUpdateDecodePathAttrLenUnderflow(t *testing.T) {
+	// TotalPathAttributeLen (3) is shorter than the first attribute (4 bytes).
+	data := []byte{0, 0, 0, 3}
+	data = append(data, 0x40, 1, 1, 0) // ORIGIN, 4 bytes
+	// A large unknown attribute so the wrapped pathlen reaches 2 with no data left.
+	attrLen := 65533 - 4
+	hdr := []byte{0xd0, 0xff, 0, 0}
+	binary.BigEndian.PutUint16(hdr[2:], uint16(attrLen))
+	data = append(data, hdr...)
+	data = append(data, make([]byte, attrLen)...)
+
+	assert.NotPanics(t, func() {
+		msg := &BGPUpdate{}
+		assert.Error(t, msg.DecodeFromBytes(data))
+	})
+}
+
+func TestBGPUpdateDecodeWithdrawnLenUnderflow(t *testing.T) {
+	// WithdrawnRoutesLen (1) is shorter than the first prefix (2 bytes).
+	data := []byte{0, 1, 8, 10, 0, 0}
+	msg := &BGPUpdate{}
+	assert.Error(t, msg.DecodeFromBytes(data))
+}
