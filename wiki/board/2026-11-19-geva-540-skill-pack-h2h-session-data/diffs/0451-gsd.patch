@@ -0,0 +1,83 @@
+//go:build cgo
+
+package embeddeddolt_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/storage/embeddeddolt"
+	"github.com/steveyegge/beads/internal/types"
+)
+
+// TestIgnoredTablesRecreatedOnOpen verifies that dolt_ignore'd wisp tables
+// missing from the working set (e.g. fresh clone or restored backup, where
+// schema_migrations says everything is applied) are recreated when the
+// embedded store is opened, so dep add / delete don't fail with
+// "table not found: wisp_dependencies".
+func TestIgnoredTablesRecreatedOnOpen(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	ctx := t.Context()
+
+	beadsDir := filepath.Join(t.TempDir(), ".beads")
+	dataDir := filepath.Join(beadsDir, "embeddeddolt")
+	const prefix = "it"
+
+	store, err := embeddeddolt.New(ctx, beadsDir, prefix, "main")
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if err := store.SetConfig(ctx, "issue_prefix", prefix); err != nil {
+		t.Fatalf("SetConfig: %v", err)
+	}
+	for _, id := range []string{"it-a", "it-b"} {
+		iss := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+		if err := store.CreateIssue(ctx, iss, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+	}
+	if err := store.Commit(ctx, "setup"); err != nil {
+		t.Fatalf("Commit: %v", err)
+	}
+	if err := store.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+
+	// Simulate a working set without the ignored tables.
+	db, cleanup, err := embeddeddolt.OpenSQL(ctx, dataDir, prefix, "main")
+	if err != nil {
+		t.Fatalf("OpenSQL: %v", err)
+	}
+	for _, tbl := range []string{"wisp_dependencies", "wisp_labels", "wisp_events", "wisp_comments", "wisps"} {
+		if _, err := db.ExecContext(ctx, "DROP TABLE IF EXISTS "+tbl); err != nil {
+			_ = cleanup()
+			t.Fatalf("DROP %s: %v", tbl, err)
+		}
+	}
+	if err := cleanup(); err != nil {
+		t.Fatalf("cleanup: %v", err)
+	}
+
+	store, err = embeddeddolt.New(ctx, beadsDir, prefix, "main")
+	if err != nil {
+		t.Fatalf("reopen New: %v", err)
+	}
+	t.Cleanup(func() { store.Close() })
+
+	dep := &types.Dependency{IssueID: "it-b", DependsOnID: "it-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency after reopen: %v", err)
+	}
+	if _, err := store.GetDependencies(ctx, "it-b"); err != nil {
+		t.Fatalf("GetDependencies: %v", err)
+	}
+	if err := store.DeleteIssue(ctx, "it-b"); err != nil {
+		t.Fatalf("DeleteIssue: %v", err)
+	}
+
+	// Wisp creation must work too (requires the wisps table).
+	w := &types.Issue{Title: "wisp", Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask, Ephemeral: true}
+	if err := store.CreateIssue(ctx, w, "tester"); err != nil {
+		t.Fatalf("CreateIssue wisp: %v", err)
+	}
+}
