+//go:build cgo
+
+package embeddeddolt
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+)
+
+// ignoredTables lists the dolt_ignore'd tables and their current (fully
+// migrated) schemas. Because these tables are ignored by Dolt they never
+// appear in commit history: a fresh clone, a database restored from backup,
+// or a new branch will not have them, even though schema_migrations records
+// the migrations that originally created them. They must therefore be
+// recreated whenever they are missing. (Embedded counterpart of
+// dolt.createIgnoredTables; see GH#2271.)
+//
+// Keep these in sync with the cumulative effect of the schema/*.up.sql
+// migrations touching wisp tables (0020, 0021, 0022, 0023, ...).
+var ignoredTables = []struct {
+	name   string
+	create string
+}{
+	{"wisps", `CREATE TABLE IF NOT EXISTS wisps (
+    id VARCHAR(255) PRIMARY KEY,
+    content_hash VARCHAR(64),
+    title VARCHAR(500) NOT NULL,
+    description TEXT NOT NULL DEFAULT '',
+    design TEXT NOT NULL DEFAULT '',
+    acceptance_criteria TEXT NOT NULL DEFAULT '',
+    notes TEXT NOT NULL DEFAULT '',
+    status VARCHAR(32) NOT NULL DEFAULT 'open',
+    priority INT NOT NULL DEFAULT 2,
+    issue_type VARCHAR(32) NOT NULL DEFAULT 'task',
+    assignee VARCHAR(255),
+    estimated_minutes INT,
+    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    created_by VARCHAR(255) DEFAULT '',
+    owner VARCHAR(255) DEFAULT '',
+    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    closed_at DATETIME,
+    closed_by_session VARCHAR(255) DEFAULT '',
+    external_ref VARCHAR(255),
+    spec_id VARCHAR(1024),
+    compaction_level INT DEFAULT 0,
+    compacted_at DATETIME,
+    compacted_at_commit VARCHAR(64),
+    original_size INT,
+    sender VARCHAR(255) DEFAULT '',
+    ephemeral TINYINT(1) DEFAULT 0,
+    no_history TINYINT(1) DEFAULT 0,
+    wisp_type VARCHAR(32) DEFAULT '',
+    pinned TINYINT(1) DEFAULT 0,
+    is_template TINYINT(1) DEFAULT 0,
+    mol_type VARCHAR(32) DEFAULT '',
+    work_type VARCHAR(32) DEFAULT 'mutex',
+    source_system VARCHAR(255) DEFAULT '',
+    metadata JSON DEFAULT (JSON_OBJECT()),
+    source_repo VARCHAR(512) DEFAULT '',
+    close_reason TEXT DEFAULT '',
+    event_kind VARCHAR(32) DEFAULT '',
+    actor VARCHAR(255) DEFAULT '',
+    target VARCHAR(255) DEFAULT '',
+    payload TEXT DEFAULT '',
+    await_type VARCHAR(32) DEFAULT '',
+    await_id VARCHAR(255) DEFAULT '',
+    timeout_ns BIGINT DEFAULT 0,
+    waiters TEXT DEFAULT '',
+    hook_bead VARCHAR(255) DEFAULT '',
+    role_bead VARCHAR(255) DEFAULT '',
+    agent_state VARCHAR(32) DEFAULT '',
+    last_activity DATETIME,
+    role_type VARCHAR(32) DEFAULT '',
+    rig VARCHAR(255) DEFAULT '',
+    due_at DATETIME,
+    defer_until DATETIME,
+    INDEX idx_wisps_status (status),
+    INDEX idx_wisps_priority (priority),
+    INDEX idx_wisps_issue_type (issue_type),
+    INDEX idx_wisps_assignee (assignee),
+    INDEX idx_wisps_created_at (created_at),
+    INDEX idx_wisps_spec_id (spec_id),
+    INDEX idx_wisps_external_ref (external_ref)
+)`},
+	{"wisp_labels", `CREATE TABLE IF NOT EXISTS wisp_labels (
+    issue_id VARCHAR(255) NOT NULL,
+    label VARCHAR(255) NOT NULL,
+    PRIMARY KEY (issue_id, label),
+    INDEX idx_wisp_labels_label (label)
+)`},
+	{"wisp_dependencies", `CREATE TABLE IF NOT EXISTS wisp_dependencies (
+    issue_id VARCHAR(255) NOT NULL,
+    depends_on_id VARCHAR(255) NOT NULL,
+    type VARCHAR(32) NOT NULL DEFAULT 'blocks',
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    created_by VARCHAR(255) DEFAULT '',
+    metadata JSON DEFAULT (JSON_OBJECT()),
+    thread_id VARCHAR(255) DEFAULT '',
+    PRIMARY KEY (issue_id, depends_on_id),
+    INDEX idx_wisp_dep_depends (depends_on_id),
+    INDEX idx_wisp_dep_type (type),
+    INDEX idx_wisp_dep_type_depends (type, depends_on_id)
+)`},
+	{"wisp_events", `CREATE TABLE IF NOT EXISTS wisp_events (
+    id CHAR(36) NOT NULL PRIMARY KEY DEFAULT (UUID()),
+    issue_id VARCHAR(255) NOT NULL,
+    event_type VARCHAR(32) NOT NULL,
+    actor VARCHAR(255) DEFAULT '',
+    old_value TEXT DEFAULT '',
+    new_value TEXT DEFAULT '',
+    comment TEXT DEFAULT '',
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    INDEX idx_wisp_events_issue (issue_id)
+)`},
+	{"wisp_comments", `CREATE TABLE IF NOT EXISTS wisp_comments (
+    id CHAR(36) NOT NULL PRIMARY KEY DEFAULT (UUID()),
+    issue_id VARCHAR(255) NOT NULL,
+    author VARCHAR(255) DEFAULT '',
+    text TEXT NOT NULL,
+    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
+    INDEX idx_wisp_comments_issue (issue_id)
+)`},
+}
+
+// ensureIgnoredTables makes sure the dolt_ignore patterns for wisp tables are
+// present and creates any dolt_ignore'd tables missing from the working set.
+// It is idempotent and cheap when all tables already exist.
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	existing := make(map[string]bool, len(ignoredTables))
+	rows, err := tx.QueryContext(ctx,
+		"SELECT table_name FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name IN ('wisps', 'wisp_labels', 'wisp_dependencies', 'wisp_events', 'wisp_comments')")
+	if err != nil {
+		return fmt.Errorf("listing ignored tables: %w", err)
+	}
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			_ = rows.Close()
+			return fmt.Errorf("listing ignored tables: %w", err)
+		}
+		existing[name] = true
+	}
+	_ = rows.Close()
+	if err := rows.Err(); err != nil {
+		return fmt.Errorf("listing ignored tables: %w", err)
+	}
+
+	var missing []int
+	for i, t := range ignoredTables {
+		if !existing[t.name] {
+			missing = append(missing, i)
+		}
+	}
+	if len(missing) == 0 {
+		return nil
+	}
+
+	// The dolt_ignore patterns must be in place before the tables are
+	// created, otherwise the new tables would be tracked (and swept into
+	// the next DOLT_ADD('-A')).
+	for _, pattern := range []string{"wisps", "wisp_%"} {
+		if _, err := tx.ExecContext(ctx, "REPLACE INTO dolt_ignore VALUES (?, true)", pattern); err != nil {
+			return fmt.Errorf("adding %q to dolt_ignore: %w", pattern, err)
+		}
+	}
+
+	for _, i := range missing {
+		t := ignoredTables[i]
+		if _, err := tx.ExecContext(ctx, t.create); err != nil {
+			return fmt.Errorf("creating ignored table %s: %w", t.name, err)
+		}
+	}
+	return nil
+}
