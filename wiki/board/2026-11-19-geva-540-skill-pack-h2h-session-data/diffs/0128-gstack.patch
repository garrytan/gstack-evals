+    /// Navigation emits Runtime.executionContextsCleared, so pre-navigation
+    /// context ids must stop validating and the set must not grow unbounded.
+    #[test]
+    fn navigation_prunes_stale_context_ids() {
+        let mut ctx = CdpContext::new();
+        ctx.isolated_worlds.push("utility".to_string());
+        let pre = ctx.next_isolated_context();
+        assert!(ctx.valid_context_ids.contains(&pre));
+
+        let mut last = Vec::new();
+        for _ in 0..50 {
+            emit_navigation_events(
+                &mut ctx, &None, "frame", "loader", "https://example.com/",
+                "page-1", &[], WaitUntil::Load, true,
+            );
+            last = ctx
+                .pending_events
+                .iter()
+                .filter(|e| e.method == "Runtime.executionContextCreated")
+                .filter_map(|e| e.params["context"]["id"].as_i64())
+                .collect();
+            ctx.pending_events.clear();
+        }
+
+        assert!(!ctx.valid_context_ids.contains(&pre), "stale isolated id still valid");
+        let mut expected: Vec<i64> = last.clone();
+        expected.sort();
+        let mut actual: Vec<i64> = ctx.valid_context_ids.iter().copied().collect();
+        actual.sort();
+        assert_eq!(actual, expected, "only live contexts may remain valid");
+        assert_eq!(actual.len(), 2);
+    }
