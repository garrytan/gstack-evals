diff --git a/packages/agents-realtime/test/realtimeSession.test.ts b/packages/agents-realtime/test/realtimeSession.test.ts
index e39df37..bfda652 100644
--- a/packages/agents-realtime/test/realtimeSession.test.ts
+++ b/packages/agents-realtime/test/realtimeSession.test.ts
@@ -301,3 +301,53 @@ describe('RealtimeSession', () => {
     expect(startEvents).toBe(2);
   });
 });
+
+describe('RealtimeSession config preservation', () => {
+  it('preserves session config (e.g. audio formats) when updating the agent', async () => {
+    const transport = new FakeTransport();
+    const agent = new RealtimeAgent({ name: 'A', handoffs: [] });
+    const session = new RealtimeSession(agent, {
+      transport,
+      config: {
+        inputAudioFormat: 'g711_ulaw',
+        outputAudioFormat: 'g711_ulaw',
+      },
+    });
+    await session.connect({ apiKey: 'test' });
+
+    await session.updateAgent(
+      agent.clone({ name: 'Bob', instructions: 'You are Bob.' }),
+    );
+
+    const update = transport.updateSessionConfigCalls.at(-1)!;
+    expect(update.inputAudioFormat).toBe('g711_ulaw');
+    expect(update.outputAudioFormat).toBe('g711_ulaw');
+    expect(update.instructions).toBe('You are Bob.');
+  });
+
+  it('preserves session config when handing off via tool call', async () => {
+    const transport = new FakeTransport();
+    const agentB = new RealtimeAgent({ name: 'B', instructions: 'I am B' });
+    const agentA = new RealtimeAgent({ name: 'A', handoffs: [agentB] });
+    const session = new RealtimeSession(agentA, {
+      transport,
+      config: { inputAudioFormat: 'g711_ulaw', outputAudioFormat: 'g711_ulaw' },
+    });
+    await session.connect({ apiKey: 'test' });
+
+    transport.emit('function_call', {
+      type: 'function_call',
+      name: 'transfer_to_B',
+      callId: 'c1',
+      arguments: '{}',
+    } as any);
+    await vi.waitFor(() =>
+      expect(transport.updateSessionConfigCalls.length).toBeGreaterThan(0),
+    );
+
+    const update = transport.updateSessionConfigCalls.at(-1)!;
+    expect(update.inputAudioFormat).toBe('g711_ulaw');
+    expect(update.outputAudioFormat).toBe('g711_ulaw');
+    expect(update.instructions).toBe('I am B');
+  });
+});
