+// validatePathParamValue rejects path parameter values that contain dot
+// segments ("." or ".."), which could otherwise be used to traverse outside
+// of the operator-configured path. Percent-encoded and backslash variants are
+// also rejected.
+func validatePathParamValue(v string) error {
+	candidates := []string{v}
+	decoded := v
+	for i := 0; i < 3; i++ {
+		d, err := url.PathUnescape(decoded)
+		if err != nil || d == decoded {
+			break
+		}
+		decoded = d
+		candidates = append(candidates, decoded)
+	}
+	for _, c := range candidates {
+		c = strings.ReplaceAll(c, "\\", "/")
+		for _, seg := range strings.Split(c, "/") {
+			if seg == "." || seg == ".." {
+				return fmt.Errorf("path traversal sequences are not allowed")
+			}
+		}
+	}
+	return nil
+}
