+func TestGetURLPathTraversal(t *testing.T) {
+	baseURL := "https://api.good.com"
+	path := "/api/v1/users/{{.id}}"
+	pathParams := parameters.Parameters{parameters.NewStringParameter("id", "id")}
+
+	bad := []string{"..", "../../../admin/secrets", "./x", "a/../../admin", "%2e%2e/admin", "%2E%2E%2Fadmin", "..\\admin", "%252e%252e/admin"}
+	for _, v := range bad {
+		if u, err := getURL(baseURL, path, pathParams, nil, nil, map[string]any{"id": v}); err == nil {
+			t.Errorf("expected error for %q, got url %q", v, u)
+		}
+	}
+	good := map[string]string{"123": "https://api.good.com/api/v1/users/123", "a..b": "https://api.good.com/api/v1/users/a..b"}
+	for v, want := range good {
+		got, err := getURL(baseURL, path, pathParams, nil, nil, map[string]any{"id": v})
+		if err != nil || got != want {
+			t.Errorf("for %q: got %q, %v; want %q", v, got, err, want)
+		}
+	}
