diff --git a/core/images/handlers_test.go b/core/images/handlers_test.go
index 5c4e54e..303c6ad 100644
--- a/core/images/handlers_test.go
+++ b/core/images/handlers_test.go
@@ -467,3 +467,48 @@ func TestDispatchCancellationWithNoHandlerError(t *testing.T) {
 	err := Dispatch(ctx, handler, nil, descs...)
 	require.ErrorIs(t, err, context.Canceled)
 }
+
+func TestWalkReferenceLimit(t *testing.T) {
+	// An index whose children all reference the same nested index amplifies
+	// exponentially with depth when duplicates are not counted.
+	const fanout, depth = 16, 8
+	levels := make([]ocispec.Descriptor, depth+1)
+	for i := range levels {
+		levels[i] = newDesc(fmt.Sprintf("level-%d", i))
+	}
+	graph := map[digest.Digest][]ocispec.Descriptor{}
+	for i := 0; i < depth; i++ {
+		children := make([]ocispec.Descriptor, fanout)
+		for j := range children {
+			children[j] = levels[i+1]
+		}
+		graph[levels[i].Digest] = children
+	}
+	var calls int
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls++
+		return graph[desc.Digest], nil
+	})
+	require.ErrorIs(t, Walk(context.Background(), handler, levels[0]), errdefs.ErrResourceExhausted)
+	assert.LessOrEqual(t, calls, maxReferences)
+
+	a, b := newDesc("a"), newDesc("b")
+	cycle := map[digest.Digest][]ocispec.Descriptor{a.Digest: {b}, b.Digest: {a}}
+	cyclic := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		return cycle[desc.Digest], nil
+	})
+	require.ErrorIs(t, Walk(context.Background(), cyclic, a), errdefs.ErrResourceExhausted)
+
+	root := newDesc("root")
+	exact := make([]ocispec.Descriptor, maxReferences-1)
+	for i := range exact {
+		exact[i] = newDesc(fmt.Sprintf("accept-%d", i))
+	}
+	accept := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		if desc.Digest == root.Digest {
+			return exact, nil
+		}
+		return nil, nil
+	})
+	require.NoError(t, Walk(context.Background(), accept, root))
+}
