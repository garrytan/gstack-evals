+
+// newHTTP3ReadTimeoutHandler enforces the entry point readTimeout on HTTP/3 requests.
+// Unlike HTTP/1 and HTTP/2, where the timeout is applied as a read deadline on the TCP connection,
+// there is no such connection for HTTP/3, so the deadline is enforced on the request body.
+func newHTTP3ReadTimeoutHandler(next http.Handler, readTimeout time.Duration) http.Handler {
+	if readTimeout <= 0 {
+		return next
+	}
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		if req.Body == nil || req.Body == http.NoBody {
+			next.ServeHTTP(rw, req)
+			return
+		}
+
+		body := newDeadlineBody(req.Body, readTimeout)
+		defer body.stop()
+
+		req.Body = body
+		next.ServeHTTP(rw, req)
+	})
+}
+
+// deadlineBody is a request body which is closed when the deadline expires.
+// Closing the HTTP/3 request body cancels the read side of the QUIC stream,
+// which unblocks any pending Read.
+type deadlineBody struct {
+	io.ReadCloser
+
+	timer *time.Timer
+
+	mu      sync.Mutex
+	expired bool
+}
+
+func newDeadlineBody(body io.ReadCloser, timeout time.Duration) *deadlineBody {
+	b := &deadlineBody{ReadCloser: body}
+	b.timer = time.AfterFunc(timeout, func() {
+		b.mu.Lock()
+		b.expired = true
+		b.mu.Unlock()
+
+		_ = b.ReadCloser.Close()
+	})
+
+	return b
+}
+
+func (b *deadlineBody) isExpired() bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	return b.expired
+}
+
+func (b *deadlineBody) Read(p []byte) (int, error) {
+	if b.isExpired() {
+		return 0, os.ErrDeadlineExceeded
+	}
+
+	n, err := b.ReadCloser.Read(p)
+	if err != nil && !errors.Is(err, io.EOF) && b.isExpired() {
+		return n, os.ErrDeadlineExceeded
+	}
+
+	return n, err
+}
+
+func (b *deadlineBody) Close() error {
+	b.timer.Stop()
+	return b.ReadCloser.Close()
+}
+
+func (b *deadlineBody) stop() {
+	b.timer.Stop()
+}
