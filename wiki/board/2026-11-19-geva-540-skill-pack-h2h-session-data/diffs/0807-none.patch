@@ -0,0 +1,18 @@
+import { tick } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	async test({ assert, target }) {
+		const input = /** @type {HTMLInputElement} */ (target.querySelector('input'));
+		const p = /** @type {HTMLElement} */ (target.querySelector('p'));
+
+		input.focus();
+		input.value = 'valuex';
+		input.dispatchEvent(new InputEvent('input', { bubbles: true }));
+		await tick();
+		await tick();
+
+		assert.equal(input.value, 'valuex');
+		assert.equal(p.textContent, 'valuex');
+	}
+});
diff --git a/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/main.svelte b/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/main.svelte
