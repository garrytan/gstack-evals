+<script>
+	class MyStore {
+		arr = $state([{ value: 'value' }]);
+		update = (x) => {
+			this.arr = this.arr.map(() => ({ value: x }));
+		};
+	}
+	const store = new MyStore();
+</script>
+
+{#each store.arr as obj}
+	<p>{obj.value}</p>
+	<input bind:value={() => obj.value, (x) => store.update(x)} />
+{/each}
