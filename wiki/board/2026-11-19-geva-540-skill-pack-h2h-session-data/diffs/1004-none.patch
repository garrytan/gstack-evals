+// Find first occurrence of `term` at or after `from`, caching results on
+// the state, so that repeated lookups of absent (or distant) terminators
+// don't rescan the same input over and over (prevents quadratic time).
+function findTerminator (state: StateInline, term: string, from: number): number {
+  const cached = state.htmlTerminators[term]
+  if (cached && cached[0] <= from && (cached[1] < 0 || cached[1] >= from)) {
+    return cached[1]
+  }
+  const found = state.src.indexOf(term, from)
+  state.htmlTerminators[term] = [from, found]
+  return found
+}
+
+// Match comment / processing instruction / declaration / cdata at `pos`.
+// Returns end position (exclusive), or -1 if no match.
+function matchSpecial (state: StateInline, pos: number): number {
+  const src = state.src
+
+  if (src.startsWith('<!--', pos)) {
+    // <!--> and <!--->
+    if (src.startsWith('>', pos + 4)) return pos + 5
+    if (src.startsWith('->', pos + 4)) return pos + 6
+    const end = findTerminator(state, '-->', pos + 4)
+    return end < 0 ? -1 : end + 3
+  }
+
+  if (src.startsWith('<![CDATA[', pos)) {
+    const end = findTerminator(state, ']]>', pos + 9)
+    return end < 0 ? -1 : end + 3
+  }
+
+  if (src.charCodeAt(pos + 1) === 0x21/* ! */) {
+    if (!isLetter(src.charCodeAt(pos + 2))) return -1
+    const end = findTerminator(state, '>', pos + 3)
+    return end < 0 ? -1 : end + 1
+  }
+
+  if (src.charCodeAt(pos + 1) === 0x3F/* ? */) {
+    const end = findTerminator(state, '?>', pos + 2)
+    return end < 0 ? -1 : end + 2
+  }
+
+  return -1
+}
