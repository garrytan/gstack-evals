+// Find first `term` occurrence at or after `from`. Results are cached on
+// state, so repeated lookups for absent or distant terminators don't rescan
+// the same text (which would be quadratic).
+function findTerminator (state: StateInline, term: string, from: number): number {
+  const cached = state.htmlTerminators[term]
+  if (cached && from >= cached[0] && (cached[1] < 0 || from <= cached[1])) {
+    return cached[1]
+  }
+  const found = state.src.indexOf(term, from)
+  state.htmlTerminators[term] = [from, found]
+  return found
+}
+
+// Returns end position of comment / processing instruction / declaration /
+// cdata starting at `pos`, or -1 if none.
+function matchSpecial (state: StateInline, pos: number): number {
+  const src = state.src
+
+  if (src.charCodeAt(pos + 1) === 0x3F/* ? */) {
+    const end = findTerminator(state, '?>', pos + 2)
+    return end < 0 ? -1 : end + 2
+  }
+
+  // here src[pos + 1] is '!'
+  if (src.startsWith('<!--', pos)) {
+    if (src.startsWith('<!-->', pos)) return pos + 5
+    if (src.startsWith('<!--->', pos)) return pos + 6
+    const end = findTerminator(state, '-->', pos + 4)
+    return end < 0 ? -1 : end + 3
+  }
+
+  if (src.startsWith('<![CDATA[', pos)) {
+    const end = findTerminator(state, ']]>', pos + 9)
+    return end < 0 ? -1 : end + 3
+  }
+
+  if (isLetter(src.charCodeAt(pos + 2))) {
+    const end = findTerminator(state, '>', pos + 3)
+    return end < 0 ? -1 : end + 1
+  }
+
+  return -1
+}
