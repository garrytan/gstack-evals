diff --git a/test/dom/serializer.test.js b/test/dom/serializer.test.js
index 4bd555a..286875a 100644
--- a/test/dom/serializer.test.js
+++ b/test/dom/serializer.test.js
@@ -620,3 +620,34 @@ describe('NodeList.toString', () => {
 		});
 	});
 });
+
+describe('element name validation with requireWellFormed (GHSA-w2rr-34g9-rvrj)', () => {
+	let doc;
+	beforeEach(() => {
+		doc = new DOMImplementation().createDocument(null, 'root', null);
+	});
+	test('default serialization emits createElement name verbatim', () => {
+		doc.documentElement.appendChild(doc.createElement('img src=x onerror="alert(1)"'));
+		expect(new XMLSerializer().serializeToString(doc)).toBe('<root><img src=x onerror="alert(1)"/></root>');
+	});
+	test.each(['img src=x onerror="alert(1)"', 'a><b', '1abc', 'a:b:c', ''])('throws for invalid element name %j', (name) => {
+		doc.documentElement.appendChild(doc.createElement(name));
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+	test.each(['a', 'svg', 'x:y', '_a-b.c'])('accepts valid element name %j', (name) => {
+		doc.documentElement.appendChild(doc.createElement(name));
+		expect(new XMLSerializer().serializeToString(doc, { requireWellFormed: true })).toBe(`<root><${name}/></root>`);
+	});
+	test('throws for invalid namespace prefix on element', () => {
+		const el = doc.createElementNS('urn:x', 'p:el');
+		el.prefix = 'a b';
+		doc.documentElement.appendChild(el);
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+	test('throws for invalid namespace prefix on attribute', () => {
+		const attr = doc.createAttributeNS('urn:x', 'p:at');
+		attr.prefix = 'a b';
+		doc.documentElement.setAttributeNodeNS(attr);
+		expectDOMException(() => new XMLSerializer().serializeToString(doc, { requireWellFormed: true }), 'InvalidStateError');
+	});
+});
