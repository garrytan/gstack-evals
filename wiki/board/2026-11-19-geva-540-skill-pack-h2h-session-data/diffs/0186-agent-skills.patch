diff --git a/test/sql/function/generic/test_volatile_aggregate_dedup.test b/test/sql/function/generic/test_volatile_aggregate_dedup.test
new file mode 100644
index 0000000..e4b2cea
--- /dev/null
+++ b/test/sql/function/generic/test_volatile_aggregate_dedup.test
@@ -0,0 +1,48 @@
+# name: test/sql/function/generic/test_volatile_aggregate_dedup.test
+# description: Identical aggregates/window functions over volatile expressions must not be deduplicated
+# group: [generic]
+
+statement ok
+PRAGMA enable_verification
+
+statement ok
+CREATE TABLE t AS SELECT range % 10 AS g FROM range(1000)
+
+# window aggregate (rewritten to aggregate + self join)
+query I
+SELECT count(*) FROM (
+	SELECT any_value(uuid()::varchar) OVER (PARTITION BY g) AS a,
+	       any_value(uuid()::varchar) OVER (PARTITION BY g) AS b
+	FROM t) WHERE a = b
+----
+0
+
+# window aggregate with framing (not rewritten)
+query I
+SELECT count(*) FROM (
+	SELECT first(uuid()::varchar) OVER (PARTITION BY g ORDER BY random() ROWS BETWEEN CURRENT ROW AND CURRENT ROW) AS a,
+	       first(uuid()::varchar) OVER (PARTITION BY g ORDER BY random() ROWS BETWEEN CURRENT ROW AND CURRENT ROW) AS b
+	FROM t) WHERE a = b
+----
+0
+
+# grouped aggregate
+query I
+SELECT count(*) FROM (
+	SELECT any_value(uuid()::varchar) AS a, any_value(uuid()::varchar) AS b
+	FROM t GROUP BY g) WHERE a = b
+----
+0
+
+query I
+SELECT count(*) FROM (
+	SELECT sum(random()) AS a, sum(random()) AS b
+	FROM t GROUP BY g) WHERE a = b
+----
+0
+
+# non-volatile duplicates are still fine
+query II
+SELECT sum(g), sum(g) FROM t
+----
+4500	4500
