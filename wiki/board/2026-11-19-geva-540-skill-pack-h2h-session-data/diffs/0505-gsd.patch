index 4048b35..356df18 100644
--- a/Terminal.Gui/ViewBase/Adornment/ShadowView.cs
+++ b/Terminal.Gui/ViewBase/Adornment/ShadowView.cs
@@ -179,8 +179,7 @@ internal class ShadowView : View
         {
             return newAttribute;
         }
-        List<View?> currentViewsUnderMouse = GetViewsUnderLocation (location, ViewportSettingsFlags.Transparent);
-        View? underView = currentViewsUnderMouse.LastOrDefault ();
+        View? underView = GetViewUnderShadow (location);
         attr = underView?.GetAttributeForRole (VisualRole.Normal) ?? Attribute.Default;
 
         newAttribute = new Attribute (ShadowStyle == ShadowStyle.Opaque ? Color.Black : attr.Background.GetDimmerColor (),
@@ -189,4 +188,68 @@ internal class ShadowView : View
 
         return newAttribute;
     }
+
+    /// <summary>
+    ///     Gets the deepest View under <paramref name="location"/> that is NOT the View casting this shadow (the
+    ///     <see cref="Adornment.Parent"/> of the <see cref="Margin"/> this shadow lives in), nor any of its adornments
+    ///     or SubViews (including this <see cref="ShadowView"/> itself).
+    /// </summary>
+    /// <remarks>
+    ///     The shadow is drawn within its caster's Frame, so a plain hit-test at <paramref name="location"/> finds the
+    ///     shadow (or its caster) itself. Using that view's attribute tints the shadow with the caster's own
+    ///     <see cref="Scheme"/> (e.g. the "Dialog" scheme), instead of reflecting what is actually beneath it.
+    /// </remarks>
+    private View? GetViewUnderShadow (Point location)
+    {
+        View? caster = (SuperView as Adornment)?.Parent;
+
+        List<View?> roots = [];
+
+        if (App?.SessionStack is { Count: > 0 } sessionStack)
+        {
+            // Topmost first
+            roots.AddRange (sessionStack.Select (r => r.Runnable as View));
+        }
+
+        if (App?.TopRunnableView is { } top && !roots.Contains (top))
+        {
+            roots.Add (top);
+        }
+
+        foreach (View? root in roots)
+        {
+            if (root is not { Visible: true })
+            {
+                continue;
+            }
+
+            View? underView = GetViewsUnderLocation (root, location, ViewportSettingsFlags.Transparent)
+                              .LastOrDefault (v => v is { } && !IsPartOf (v, caster) && !IsPartOf (v, this));
+
+            if (underView is { })
+            {
+                return underView;
+            }
+        }
+
+        return null;
+
+        static bool IsPartOf (View view, View? ancestor)
+        {
+            if (ancestor is null)
+            {
+                return false;
+            }
+
+            for (View? current = view; current is { }; current = current is Adornment adornment ? adornment.Parent : current.SuperView)
+            {
+                if (current == ancestor)
+                {
+                    return true;
+                }
+            }
+
+            return false;
+        }
+    }
 }
