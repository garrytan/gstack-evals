+    // True once the developer (or a subclass) has explicitly set SchemeName. When true, SetStyle will not
+    // override the SchemeName (e.g. MessageBox.ErrorQuery sets the Error scheme before running).
+    private bool _schemeNameExplicitlySet;
+
+    // True while SetStyle is applying the default SchemeName, so OnSchemeNameChanged can tell the
+    // difference between the default being applied and an explicit set.
+    private bool _applyingDefaultSchemeName;
+
+    /// <inheritdoc/>
+    protected override void OnSchemeNameChanged (ValueChangedEventArgs<string?> args)
+    {
+        base.OnSchemeNameChanged (args);
+
+        if (!_applyingDefaultSchemeName)
+        {
+            _schemeNameExplicitlySet = true;
+        }
+    }
+
     private void SetStyle ()
     {
         if (IsRunning)
         {
+            ApplyDefaultSchemeName (Schemes.Dialog);
             Arrangement |= ViewArrangement.Movable | ViewArrangement.Resizable | ViewArrangement.Overlapped;
         }
         else
         {
-            SchemeName = SchemeManager.SchemesToSchemeName (Schemes.Base);
+            ApplyDefaultSchemeName (Schemes.Base);
 
             // strip out movable and resizable
             Arrangement &= ~(ViewArrangement.Movable | ViewArrangement.Resizable);
         }
     }
 
+    private void ApplyDefaultSchemeName (Schemes scheme)
+    {
+        if (_schemeNameExplicitlySet)
+        {
+            return;
+        }
+
+        _applyingDefaultSchemeName = true;
+
+        try
+        {
+            SchemeName = SchemeManager.SchemesToSchemeName (scheme);
+        }
+        finally
+        {
+            _applyingDefaultSchemeName = false;
+        }
+    }
+
     // Dialogs are Modal and Focus is indicated by their Border. _drawingText ensures the
     // Text of the dialog (e.g. for a MessageBox) is always drawn using the Normal Attribute
     // instead of the Focus attribute.
diff --git a/Tests/UnitTestsParallelizable/Views/DialogSchemeTests.cs b/Tests/UnitTestsParallelizable/Views/DialogSchemeTests.cs
new file mode 100644
index 0000000..ff10d12
--- /dev/null
+++ b/Tests/UnitTestsParallelizable/Views/DialogSchemeTests.cs
@@ -0,0 +1,156 @@
+using UnitTests;
+
+namespace ViewsTests;
+
+/// <summary>
+///     Tests illustrating how <see cref="Dialog"/> and views using <c>SchemeName = "Dialog"</c> resolve and render
+///     their <see cref="Scheme"/>.
+/// </summary>
+public class DialogSchemeTests (ITestOutputHelper output)
+{
+    private static IApplication CreateApp (int width = 40, int height = 12)
+    {
+        IApplication app = Application.Create ();
+        app.Init (DriverRegistry.Names.ANSI);
+        app.Driver!.SetScreenSize (width, height);
+
+        return app;
+    }
+
+    [Fact]
+    public void Dialog_Not_Running_Uses_Base_SchemeName ()
+    {
+        using Dialog dialog = new ();
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Base), dialog.SchemeName);
+    }
+
+    // The documented behavior is that a Dialog "uses the Dialog color scheme when running".
+    [Fact]
+    public void Dialog_Running_Uses_Dialog_SchemeName ()
+    {
+        using IApplication app = CreateApp ();
+        using Dialog dialog = new () { Title = "T", Text = "Hello" };
+        dialog.AddButton (new Button { Title = "_OK" });
+
+        app.Begin (dialog);
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Dialog), dialog.SchemeName);
+        Assert.Equal (SchemeManager.GetScheme (Schemes.Dialog), dialog.GetScheme ());
+    }
+
+    [Fact]
+    public void Dialog_Running_Draws_With_Dialog_Scheme ()
+    {
+        using IApplication app = CreateApp ();
+        using Dialog dialog = new () { Title = "T", X = 0, Y = 0 };
+        dialog.Add (new Label { Text = "Hello" });
+        dialog.AddButton (new Button { Title = "_OK" });
+
+        app.Begin (dialog);
+        app.LayoutAndDraw ();
+
+        Attribute expected = SchemeManager.GetScheme (Schemes.Dialog).Normal;
+
+        // Top-left border corner and the Label's first cell (inside the border)
+        Assert.Equal (expected, app.Driver!.Contents! [0, 0].Attribute);
+        Assert.Equal ("H", app.Driver.Contents [1, 1].Grapheme);
+        Assert.Equal (expected, app.Driver.Contents [1, 1].Attribute);
+    }
+
+    [Fact]
+    public void Dialog_Subclass_Running_Uses_Dialog_SchemeName ()
+    {
+        using IApplication app = CreateApp ();
+        using Dialog<int> dialog = new () { Title = "T" };
+
+        app.Begin (dialog);
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Dialog), dialog.SchemeName);
+    }
+
+    [Fact]
+    public void Dialog_Explicit_SchemeName_Is_Preserved_When_Running ()
+    {
+        using IApplication app = CreateApp ();
+        using Dialog dialog = new () { Title = "T" };
+        dialog.SchemeName = SchemeManager.SchemesToSchemeName (Schemes.Error);
+
+        app.Begin (dialog);
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Error), dialog.SchemeName);
+    }
+
+    [Fact]
+    public void Dialog_Explicit_SchemeName_Is_Preserved_When_Not_Running ()
+    {
+        using Dialog dialog = new () { SchemeName = SchemeManager.SchemesToSchemeName (Schemes.Dialog) };
+
+        Assert.Equal (SchemeManager.SchemesToSchemeName (Schemes.Dialog), dialog.SchemeName);
+    }
+
+    /// <summary>
+    ///     A transparent shadow must be derived from what is *under* the shadow, never from the view casting it.
+    ///     The shadow's fallback used to find itself (the ShadowView) as the "view under", and so tinted the
+    ///     shadow using the casting view's own scheme (very visible with the "Dialog" scheme: a bright blue band).
+    /// </summary>
+    [Fact]
+    public void Dialog_Transparent_Shadow_Is_Not_Derived_From_Dialog_Scheme ()
+    {
+        using IApplication app = CreateApp ();
+        using Runnable top = new ();
+        top.SetScheme (new () { Normal = new (Color.White, Color.Black) });
+        app.Begin (top);
+
+        using Dialog dialog = new () { Title = "T", X = 0, Y = 0, SchemeName = "Dialog" };
+        dialog.ShadowStyle = ShadowStyle.Transparent;
+        dialog.Add (new Label { Text = "Hello" });
+        app.Begin (dialog);
+        app.LayoutAndDraw ();
+
+        AssertShadowColumnDerivedFrom (app, dialog, top.GetAttributeForRole (VisualRole.Normal), dialog.GetAttributeForRole (VisualRole.Normal));
+    }
+
+    [Fact]
+    public void View_With_Dialog_SchemeName_Transparent_Shadow_Is_Not_Derived_From_Own_Scheme ()
+    {
+        using IApplication app = CreateApp ();
+        using Runnable top = new ();
+        top.SetScheme (new () { Normal = new (Color.White, Color.Black) });
+
+        View view = new ()
+        {
+            X = 1,
+            Y = 1,
+            Width = 10,
+            Height = 4,
+            SchemeName = "Dialog",
+            BorderStyle = LineStyle.Single,
+            ShadowStyle = ShadowStyle.Transparent
+        };
+        top.Add (view);
+        app.Begin (top);
+        app.LayoutAndDraw ();
+
+        AssertShadowColumnDerivedFrom (app, view, top.GetAttributeForRole (VisualRole.Normal), view.GetAttributeForRole (VisualRole.Normal));
+    }
+
+    private void AssertShadowColumnDerivedFrom (IApplication app, View caster, Attribute under, Attribute casterNormal)
+    {
+        // The vertical shadow occupies the right-most column of the caster's frame (excluding the first row).
+        Rectangle frame = caster.FrameToScreen ();
+        int col = frame.Right - 1;
+        int row = frame.Y + 1;
+        Attribute actual = app.Driver!.Contents! [row, col].Attribute!.Value;
+
+        // ShadowView's fallback (used when the cell under the shadow has a dark background) is computed from the
+        // Normal attribute of the view under the shadow.
+        Attribute fromUnder = new (under.Background.GetDimmerColor (), under.Foreground.GetDimmerColor (0.25), under.Style);
+        Attribute fromCaster = new (casterNormal.Background.GetDimmerColor (), casterNormal.Foreground.GetDimmerColor (0.25), casterNormal.Style);
+
+        output.WriteLine ($"shadow cell [{row},{col}] = {actual}; fromUnder = {fromUnder}; fromCaster = {fromCaster}");
+
+        Assert.NotEqual (fromCaster, actual);
+        Assert.Equal (fromUnder, actual);
+    }
+}
