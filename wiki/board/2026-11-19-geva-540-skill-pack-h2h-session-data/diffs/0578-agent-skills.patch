+// metricLabels holds the label values attached to DNS metrics.
+type metricLabels struct {
+	values prometheus.Labels
+}
+
+func newMetricLabels(labels map[string]string) *metricLabels {
+	values := prometheus.Labels{}
+	for _, name := range dpapi.MetricLabelNames {
+		values[name] = labels[name]
+	}
+	return &metricLabels{values: values}
+}
+
+func (l *metricLabels) equal(other *metricLabels) bool {
+	for _, name := range dpapi.MetricLabelNames {
+		if l.values[name] != other.values[name] {
+			return false
+		}
+	}
+	return true
+}
+
+// deleteSeries removes series with given labels so stale label values
+// (e.g. before the DNS config with labels was received) are not exposed forever.
