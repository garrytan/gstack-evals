+
+// dnsMetricLabels returns labels that kuma-dp attaches to DNS proxy metrics.
+// They mirror the labels present on Envoy metrics so that DNS metrics can be
+// correlated with a workload without cross-metric joins.
+func dnsMetricLabels(proxy *core_xds.Proxy) map[string]string {
+	meta := proxy.Dataplane.GetMeta()
+	if meta == nil {
+		return nil
+	}
+	dpLabels := meta.GetLabels()
+	zone := dpLabels[mesh_proto.ZoneTag]
+	namespace := dpLabels[mesh_proto.KubeNamespaceTag]
+
+	labels := map[string]string{}
+	if workloadName := dpLabels[k8s_metadata.KumaWorkload]; workloadName != "" {
+		labels[dpapi.MetricLabelWorkload] = kri.Identifier{
+			ResourceType: workload_api.WorkloadType,
+			Mesh:         meta.GetMesh(),
+			Zone:         zone,
+			Namespace:    namespace,
+			Name:         workloadName,
+		}.String()
+	}
+	if namespace != "" {
+		labels[dpapi.MetricLabelNamespace] = namespace
+	}
+	if mesh := meta.GetMesh(); mesh != "" {
+		labels[dpapi.MetricLabelMesh] = mesh
+	}
+	if zone != "" {
+		labels[dpapi.MetricLabelZone] = zone
+	}
+	if len(labels) == 0 {
+		return nil
+	}
+	return labels
+}
