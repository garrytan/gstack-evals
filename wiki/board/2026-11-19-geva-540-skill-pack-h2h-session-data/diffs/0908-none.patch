diff --git a/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
new file mode 100644
index 0000000..7139db5
--- /dev/null
+++ b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
@@ -0,0 +1,70 @@
+'use strict';
+
+/**
+ * GHSA-x6m4-chr9-cg97 — host-realm error stacks leak absolute host paths
+ *
+ * ## Vulnerability
+ * Malformed source passed to sandbox `eval` / `Function` makes the host-side
+ * transformer throw a host-realm SyntaxError. Its `stack` is formatted by the
+ * host realm's prepareStackTrace and read through the bridge, bypassing the
+ * sandbox-side CallSite redaction (GHSA-v27g-jcqj-v8rw) and exposing absolute
+ * host paths of vm2, Node internals and the embedding application.
+ *
+ * ## Fix
+ *  - `lib/setup-sandbox.js`: transformer errors are re-created as
+ *    sandbox-realm errors (name + message only).
+ *  - `lib/bridge.js`: reads of `stack` on host objects (via `get` and
+ *    `getOwnPropertyDescriptor`) strip every frame line referencing a
+ *    path-like location.
+ */
+
+const assert = require('assert');
+const { VM, NodeVM } = require('../../../lib/main.js');
+
+function assertNoHostPaths(stack) {
+	assert.strictEqual(typeof stack, 'string');
+	assert.ok(!/\/|\\|node:|transformer|setup-sandbox/.test(stack), 'stack leaks host info: ' + stack);
+}
+
+describe('GHSA-x6m4-chr9-cg97 (host error stack path leak)', () => {
+	it('eval syntax error stack does not leak host paths (VM)', () => {
+		const r = new VM().run('var s; try { eval("@@@ catch") } catch (e) { s = [e.stack, e instanceof SyntaxError, e.message] } s;');
+		assertNoHostPaths(r[0]);
+		assert.strictEqual(r[1], true);
+		assert.strictEqual(r[2], "Unexpected character '@'");
+	});
+
+	it('Function syntax error stack does not leak host paths', () => {
+		const vm = new VM();
+		assertNoHostPaths(vm.run('var s; try { new Function("@@@ catch") } catch (e) { s = e.stack } s;'));
+		assertNoHostPaths(vm.run('var s; try { Function("a", "@@@ catch") } catch (e) { s = e.stack } s;'));
+	});
+
+	it('eval syntax error stack does not leak host paths with eval disabled', () => {
+		assertNoHostPaths(new VM({ eval: false }).run('var s; try { eval("@@@ catch") } catch (e) { s = e.stack } s;'));
+	});
+
+	it('async-disallowed VMError stack does not leak host paths', () => {
+		const r = new VM({ allowAsync: false }).run('var s; try { eval("async () => 1") } catch (e) { s = [e.name, e.stack] } s;');
+		assert.strictEqual(r[0], 'VMError');
+		assertNoHostPaths(r[1]);
+	});
+
+	it('eval syntax error stack does not leak host paths (NodeVM)', () => {
+		assertNoHostPaths(new NodeVM().run('var s; try { eval("@@@ catch") } catch (e) { s = e.stack } module.exports = s;'));
+	});
+
+	it('errors thrown by host functions have host frames stripped', () => {
+		const vm = new VM({
+			sandbox: {
+				f() {
+					throw new Error('x');
+				},
+			},
+		});
+		const r = vm.run('var s; try { f() } catch (e) { s = [e.stack, Object.getOwnPropertyDescriptor(e, "stack").value] } s;');
+		assertNoHostPaths(r[0]);
+		assertNoHostPaths(r[1]);
+		assert.ok(r[0].startsWith('Error: x'));
+	});
+});
