diff --git a/context.go b/context.go
index ec7fdd9..7b9aabc 100644
--- a/context.go
+++ b/context.go
@@ -165,21 +165,37 @@ func (c *Context) Scheme() string {
 	if c.IsTLS() {
 		return "https"
 	}
-	if scheme := c.request.Header.Get(HeaderXForwardedProto); scheme != "" {
+	// Proxy headers are client controllable, so only well-known schemes are accepted. Anything else would allow
+	// injecting arbitrary schemes (e.g. `javascript`) into URLs built from this value (redirects etc.).
+	if scheme, ok := sanitizeScheme(c.request.Header.Get(HeaderXForwardedProto)); ok {
 		return scheme
 	}
-	if scheme := c.request.Header.Get(HeaderXForwardedProtocol); scheme != "" {
+	if scheme, ok := sanitizeScheme(c.request.Header.Get(HeaderXForwardedProtocol)); ok {
 		return scheme
 	}
 	if ssl := c.request.Header.Get(HeaderXForwardedSsl); ssl == "on" {
 		return "https"
 	}
-	if scheme := c.request.Header.Get(HeaderXUrlScheme); scheme != "" {
+	if scheme, ok := sanitizeScheme(c.request.Header.Get(HeaderXUrlScheme)); ok {
 		return scheme
 	}
 	return "http"
 }
 
+// sanitizeScheme normalizes the given scheme and reports whether it is one of the allowed schemes
+// (`http`, `https`, `ws`, `wss`).
+func sanitizeScheme(scheme string) (string, bool) {
+	if scheme == "" {
+		return "", false
+	}
+	scheme = strings.ToLower(strings.TrimSpace(scheme))
+	switch scheme {
+	case "http", "https", "ws", "wss":
+		return scheme, true
+	}
+	return "", false
+}
