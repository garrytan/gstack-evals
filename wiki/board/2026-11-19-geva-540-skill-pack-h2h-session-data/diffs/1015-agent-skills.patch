diff --git a/context_test.go b/context_test.go
index 9376f0f..8b5ede2 100644
--- a/context_test.go
+++ b/context_test.go
@@ -1426,3 +1426,25 @@ func TestRouteInfo(t *testing.T) {
 	orgRI.Name = "changed"
 	assert.NotEqual(t, expect, c.RouteInfo())
 }
+
+func TestContext_Scheme_rejectsUntrustedHeaderValues(t *testing.T) {
+	headers := []string{HeaderXForwardedProto, HeaderXForwardedProtocol, HeaderXUrlScheme}
+	invalid := []string{"javascript", "data", "vbscript", "file", "ftp", "gopher", "https://evil.com/", "http evil", "javascript:alert(1)//"}
+	for _, h := range headers {
+		for _, v := range invalid {
+			c := &Context{request: &http.Request{Header: http.Header{h: []string{v}}}}
+			assert.Equal(t, "http", c.Scheme(), "header %s value %q", h, v)
+		}
+	}
+}
+
+func TestContext_Scheme_allowsKnownSchemes(t *testing.T) {
+	headers := []string{HeaderXForwardedProto, HeaderXForwardedProtocol, HeaderXUrlScheme}
+	valid := map[string]string{"http": "http", "https": "https", "ws": "ws", "wss": "wss", "HTTPS": "https", " https ": "https"}
+	for _, h := range headers {
+		for v, expect := range valid {
+			c := &Context{request: &http.Request{Header: http.Header{h: []string{v}}}}
+			assert.Equal(t, expect, c.Scheme(), "header %s value %q", h, v)
+		}
+	}
+}
