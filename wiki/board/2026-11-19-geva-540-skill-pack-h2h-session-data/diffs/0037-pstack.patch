+    @Test
+    @DisplayName("targeted user interrupt returns INTERRUPTED and leaves other sessions alone")
+    void targetedUserInterruptReturnsInterruptedReason() throws Exception {
+        InMemoryAgentStateStore store = new InMemoryAgentStateStore();
+        CountDownLatch subscribed = new CountDownLatch(2);
+        ReActAgent agent =
+                ReActAgent.builder()
+                        .name("asst")
+                        .sysPrompt("hi")
+                        .model(new DelayedFirstChunkModel(subscribed))
+                        .stateStore(store)
+                        .build();
+        RuntimeContext ctxA = RuntimeContext.builder().userId("u1").sessionId("sessA").build();
+        RuntimeContext ctxB = RuntimeContext.builder().userId("u1").sessionId("sessB").build();
+
+        CompletableFuture<Msg> interrupted =
+                agent.call(List.of(userMsg("hello-a")), ctxA)
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+        CompletableFuture<Msg> untouched =
+                agent.call(List.of(userMsg("hello-b")), ctxB)
+                        .subscribeOn(Schedulers.parallel())
+                        .toFuture();
+
+        assertTrue(subscribed.await(5, TimeUnit.SECONDS), "both model streams should start");
+        agent.interrupt("u1", "sessA", new UserMessage("stop"));
+
+        Msg reply = interrupted.get(5, TimeUnit.SECONDS);
+        assertEquals(GenerateReason.INTERRUPTED, reply.getGenerateReason());
+
+        Msg other = untouched.get(5, TimeUnit.SECONDS);
+        assertEquals("model reply", other.getTextContent());
+        assertEquals(GenerateReason.MODEL_STOP, other.getGenerateReason());
+
+        List<Msg> persisted = agent(store).getAgentState("u1", "sessA").getContext();
+        Msg recovery = persisted.get(persisted.size() - 1);
+        assertEquals(reply.getTextContent(), recovery.getTextContent());
+        assertEquals(
+                GenerateReason.INTERRUPTED,
+                recovery.getGenerateReason(),
+                "persisted recovery message should keep the INTERRUPTED reason");
+    }
+
     private static final class DelayedFirstChunkModel extends ChatModelBase {
         private final CountDownLatch subscribed;
 
