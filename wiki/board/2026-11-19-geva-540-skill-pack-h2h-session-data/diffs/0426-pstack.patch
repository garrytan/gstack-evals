+        [Test]
+        public void FindRecommendations_WithConflictingRecommendationsAndSuggestions_AllFound()
+        {
+            // Arrange
+            using (var inst     = new DisposableKSP())
+            using (var repo     = new TemporaryRepository(
+                                      Relationships.RelationshipResolverTests.MergeWithDefaults(
+                                          @"{
+                                              ""identifier"": ""InstallingMod"",
+                                              ""recommends"": [
+                                                  { ""name"": ""RecA"" },
+                                                  { ""name"": ""RecB"" },
+                                                  { ""name"": ""RecC"" }
+                                              ],
+                                              ""suggests"": [
+                                                  { ""name"": ""SugA"" },
+                                                  { ""name"": ""SugB"" }
+                                              ]
+                                          }",
+                                          @"{ ""identifier"": ""RecA"" }",
+                                          @"{
+                                              ""identifier"": ""RecB"",
+                                              ""conflicts"": [ { ""name"": ""RecA"" } ]
+                                          }",
+                                          @"{ ""identifier"": ""RecC"" }",
+                                          @"{ ""identifier"": ""SugA"" }",
+                                          @"{
+                                              ""identifier"": ""SugB"",
+                                              ""conflicts"": [ { ""name"": ""SugA"" } ]
+                                          }")
+                                          .ToArray()))
+            using (var repoData = new TemporaryRepositoryData(nullUser, repo.repo))
+            using (var regMgr   = RegistryManager.Instance(inst.KSP, repoData.Manager,
+                                                           new Repository[] { repo.repo }))
+            {
+                var registry = regMgr.registry;
+                CkanModule Latest(string ident)
+                    => registry.LatestAvailable(ident,
+                                                inst.KSP.StabilityToleranceConfig,
+                                                inst.KSP.VersionCriteria())!;
+                var toInstall = new CkanModule[] { Latest("InstallingMod") };
+
+                // Act
+                ModuleInstaller.FindRecommendations(
+                    inst.KSP, toInstall,
+                    toInstall,
+                    Array.Empty<CkanModule>(),
+                    Array.Empty<CkanModule>(),
+                    registry,
+                    out Dictionary<CkanModule, Tuple<bool, List<string>>> recommendations,
+                    out Dictionary<CkanModule, List<string>> suggestions,
+                    out Dictionary<CkanModule, HashSet<string>> supporters);
+
+                // Assert
+                CollectionAssert.AreEquivalent(new string[] { "RecA", "RecB", "RecC" },
+                                               recommendations.Keys.Select(m => m.identifier));
+                CollectionAssert.AreEquivalent(new string[] { "SugA", "SugB" },
+                                               suggestions.Keys.Select(m => m.identifier));
+                Assert.IsFalse(recommendations[Latest("RecA")].Item1);
+                Assert.IsFalse(recommendations[Latest("RecB")].Item1);
+                Assert.IsTrue(recommendations[Latest("RecC")].Item1);
+            }
+        }
