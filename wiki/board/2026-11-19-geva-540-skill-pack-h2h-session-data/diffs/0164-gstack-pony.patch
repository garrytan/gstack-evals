+/// Original spans of `content` whose non-blank lines equal (trailing-whitespace
+/// insensitive) the non-blank lines of `needle`, with any number of blank lines
+/// in between. Each span runs from the first to the last matched line.
+fn find_spans_ignoring_blank_lines<'a>(content: &'a str, needle: &str) -> Vec<&'a str> {
+    let needle_lines: Vec<&str> = needle
+        .lines()
+        .map(str::trim_end)
+        .filter(|l| !l.is_empty())
+        .collect();
+    if needle_lines.is_empty() {
+        return Vec::new();
+    }
+
+    // (start byte, end byte excluding line terminator, trimmed text)
+    let mut lines = Vec::new();
+    let mut offset = 0;
+    for raw in content.split_inclusive('\n') {
+        let body = raw.trim_end_matches(['\n', '\r']);
+        lines.push((offset, offset + body.len(), body.trim_end()));
+        offset += raw.len();
+    }
+
+    let mut spans = Vec::new();
+    let mut start = 0;
+    while start < lines.len() {
+        if lines[start].2 != needle_lines[0] {
+            start += 1;
+            continue;
+        }
+        let mut li = start;
+        let mut matched = true;
+        for nl in &needle_lines[1..] {
+            li += 1;
+            while li < lines.len() && lines[li].2.is_empty() {
+                li += 1;
+            }
+            if li >= lines.len() || lines[li].2 != *nl {
+                matched = false;
+                break;
+            }
+        }
+        if matched {
+            spans.push(&content[lines[start].0..lines[li].1]);
+            start = li + 1;
+        } else {
+            start += 1;
+        }
+    }
+    spans
