+// Regression test: a server with consec_failures > 0 must still reuse an
+// existing UDP connection rather than opening a new socket for every query.
+#define UDPREUSE_AFTER_FAILURE_CNT 16
+TEST_P(MockUDPChannelTest, UDPConnReuseAfterServerFailure) {
+  DNSPacket failrsp;
+  failrsp.set_response().set_aa().set_rcode(SERVFAIL)
+    .add_question(new DNSQuestion("fail.com", T_A));
+  ON_CALL(server_, OnRequest("fail.com", T_A))
+    .WillByDefault(SetReply(&server_, &failrsp));
+
+  DNSPacket rsp;
+  rsp.set_response().set_aa()
+    .add_question(new DNSQuestion("www.google.com", T_A))
+    .add_answer(new DNSARR("www.google.com", 100, {2, 3, 4, 5}));
+  ON_CALL(server_, OnRequest("www.google.com", T_A))
+    .WillByDefault(SetReply(&server_, &rsp));
+
+  // Put the server into a failed state (consec_failures > 0)
+  HostResult failresult;
+  ares_gethostbyname(channel_, "fail.com.", AF_INET, HostCallback, &failresult);
+  Process();
+  EXPECT_TRUE(failresult.done_);
+  EXPECT_EQ(ARES_ESERVFAIL, failresult.status_);
+
+  int rc = ARES_SUCCESS;
+  ares_set_socket_callback(channel_, SocketConnectCallback, &rc);
+  sock_cb_count = 0;
+
+  HostResult result[UDPREUSE_AFTER_FAILURE_CNT];
+  for (size_t i = 0; i < UDPREUSE_AFTER_FAILURE_CNT; i++) {
+    ares_gethostbyname(channel_, "www.google.com.", AF_INET, HostCallback,
+                       &result[i]);
+  }
+  Process();
+
+  // All parallel queries should share a single UDP socket
+  EXPECT_EQ(1, sock_cb_count);
+
+  for (size_t i = 0; i < UDPREUSE_AFTER_FAILURE_CNT; i++) {
+    std::stringstream ss;
+    EXPECT_TRUE(result[i].done_);
+    ss << result[i].host_;
+    EXPECT_EQ("{'www.google.com' aliases=[] addrs=[2.3.4.5]}", ss.str());
+  }
+}
+
