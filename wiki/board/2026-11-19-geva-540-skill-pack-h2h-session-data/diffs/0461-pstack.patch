 )
 
@@ -149,7 +151,7 @@ func (formatJSON) Unmarshal(data []byte, value any) error {
 
 // Marshal implements Format.Marshal.
 func (formatTOML) Marshal(value any) ([]byte, error) {
-	return toml.Marshal(value)
+	return pelletiertoml.Marshal(value)
 }
 
 // Name implements Format.Name.
@@ -159,9 +161,55 @@ func (formatTOML) Name() string {
 
 // Unmarshal implements Format.Unmarshal.
 func (formatTOML) Unmarshal(data []byte, value any) error {
-	decoder := toml.NewDecoder(bytes.NewReader(data))
-	decoder.DisallowUnknownFields()
-	return decoder.Decode(value)
+	metaData, err := toml.NewDecoder(bytes.NewReader(data)).Decode(value)
+	if err != nil {
+		return err
+	}
+	targetType := reflect.TypeOf(value)
+	for _, key := range metaData.Undecoded() {
+		if !tomlKeyIsUnderInterface(targetType, key) {
+			return fmt.Errorf("toml: unknown field %q", key.String())
+		}
+	}
+	return nil
+}
+
+// tomlKeyIsUnderInterface returns whether key is stored inside an interface
+// value of t. BurntSushi/toml does not mark keys below interface values as
+// decoded, so these keys are not unknown fields.
+func tomlKeyIsUnderInterface(t reflect.Type, key toml.Key) bool {
+	for _, component := range key {
+		for t.Kind() == reflect.Pointer || t.Kind() == reflect.Slice || t.Kind() == reflect.Array {
+			t = t.Elem()
+		}
+		switch t.Kind() {
+		case reflect.Interface:
+			return true
+		case reflect.Map:
+			t = t.Elem()
+		case reflect.Struct:
+			field, ok := tomlStructField(t, component)
+			if !ok {
+				return false
+			}
+			t = field.Type
+		default:
+			return false
+		}
+	}
+	return t.Kind() == reflect.Interface
+}
+
+// tomlStructField returns the field of t that BurntSushi/toml decodes name
+// into.
+func tomlStructField(t reflect.Type, name string) (reflect.StructField, bool) {
+	return t.FieldByNameFunc(func(fieldName string) bool {
+		field, _ := t.FieldByName(fieldName)
+		if tag, _, _ := strings.Cut(field.Tag.Get("toml"), ","); tag != "" {
+			return tag == name
+		}
+		return strings.EqualFold(fieldName, name)
+	})
 }
 
 // Name implements Format.Name.
