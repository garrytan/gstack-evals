+
+func Test_applyFieldOverriders_EmptyPatches(t *testing.T) {
+	obj := &unstructured.Unstructured{Object: map[string]interface{}{
+		"apiVersion": "v1",
+		"kind":       "ConfigMap",
+		"data": map[string]interface{}{
+			"config": "foo: bar\n",
+		},
+	}}
+	err := applyFieldOverriders(obj, []policyv1alpha1.FieldOverrider{{FieldPath: "/data/config"}})
+	if err == nil {
+		t.Fatalf("expected an error when neither YAML nor JSON is set")
+	}
+	if got := obj.Object["data"].(map[string]interface{})["config"]; got != "foo: bar\n" {
+		t.Fatalf("expected field to be untouched, got %q", got)
+	}
+}
