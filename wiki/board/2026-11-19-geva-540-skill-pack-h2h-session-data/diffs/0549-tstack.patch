+    [Test]
+    public void DedicatedThreadPool_ShouldStopThreads_WhenShutDown()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        Thread workerThread = null;
+        using var ran = new ManualResetEventSlim();
+        Assert.That(threadPool.RunInThread(() =>
+        {
+            workerThread = Thread.CurrentThread;
+            ran.Set();
+            return Task.CompletedTask;
+        }), Is.True);
+        Assert.That(ran.Wait(TimeSpan.FromSeconds(5)), Is.True);
+        Assert.That(workerThread.IsAlive, Is.True);
+
+        threadPool.Shutdown(waitForJobsToComplete: true);
+
+        Assert.That(workerThread.Join(TimeSpan.FromSeconds(5)), Is.True, "dedicated thread should exit after shutdown");
+    }
+
+    [Test]
+    public void DedicatedThreadPool_ShouldCompleteRunningAsyncJobs_WhenShutDownWithoutWaiting()
+    {
+        var threadPool = new DedicatedThreadPool { MaxConcurrency = 1 };
+        threadPool.Initialize();
+
+        var resume = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+        using var completed = new ManualResetEventSlim();
+        threadPool.RunInThread(async () =>
+        {
+            // continuation is scheduled on the (by then shut down) dedicated task scheduler
+            await resume.Task;
+            completed.Set();
+        });
+
+        threadPool.Shutdown(waitForJobsToComplete: false);
+        resume.SetResult(true);
+
+        Assert.That(completed.Wait(TimeSpan.FromSeconds(5)), Is.True);
+    }
+
