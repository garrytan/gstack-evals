diff --git a/tests/features/embeddables/nested-inline-embeddable-null-parent.test.ts b/tests/features/embeddables/nested-inline-embeddable-null-parent.test.ts
new file mode 100644
index 0000000..b9cd888
--- /dev/null
+++ b/tests/features/embeddables/nested-inline-embeddable-null-parent.test.ts
@@ -0,0 +1,49 @@
+import { Embeddable, Embedded, Entity, PrimaryKey, Property, ReflectMetadataProvider } from '@mikro-orm/decorators/legacy';
+import { MikroORM } from '@mikro-orm/sqlite';
+
+@Embeddable()
+class Inner {
+  @Property({ nullable: true })
+  value?: string;
+}
+
+@Embeddable()
+class Outer {
+  @Property({ nullable: true })
+  name?: string;
+
+  @Embedded(() => Inner, { nullable: true })
+  inner?: Inner | null;
+}
+
+@Entity()
+class Thing {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Outer, { nullable: true })
+  outer?: Outer | null;
+}
+
+let orm: MikroORM;
+
+beforeAll(async () => {
+  orm = await MikroORM.init({ entities: [Thing], dbName: ':memory:', metadataProvider: ReflectMetadataProvider });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+
+test('nested inline embeddable with null parent', async () => {
+  const t = orm.em.create(Thing, { outer: { name: 'a', inner: { value: 'b' } } });
+  await orm.em.flush();
+  t.outer = null;
+  await orm.em.flush();
+  orm.em.clear();
+  const t2 = await orm.em.findOneOrFail(Thing, t.id);
+  expect(t2.outer).toBeNull();
+  const t3 = orm.em.create(Thing, { outer: null });
+  await orm.em.flush();
+  orm.em.clear();
+  expect((await orm.em.findOneOrFail(Thing, t3.id)).outer).toBeNull();
+});
