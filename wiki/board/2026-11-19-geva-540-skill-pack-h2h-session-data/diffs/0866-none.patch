+type orderedKVs struct {
+	Keys   []string
+	Values []string
+}
+
+func (o *orderedKVs) UnmarshalTOML(node *unstable.Node) error {
+	if node.Kind != unstable.InlineTable {
+		return fmt.Errorf("expected inline table, got %s", node.Kind)
+	}
+	it := node.Children()
+	for it.Next() {
+		kv := it.Node()
+		var parts []string
+		k := kv.Key()
+		for k.Next() {
+			parts = append(parts, string(k.Node().Data))
+		}
+		o.Keys = append(o.Keys, strings.Join(parts, "."))
+		o.Values = append(o.Values, string(kv.Value().Data))
+	}
+	return nil
+}
+
+func TestUnmarshal_CustomUnmarshalerTables(t *testing.T) {
+	t.Run("root document", func(t *testing.T) {
+		var d orderedKVs
+		err := toml.NewDecoder(strings.NewReader("z = \"1\"\na.b = \"2\"\nc = 3\n")).
+			EnableUnmarshalerInterface().Decode(&d)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"z", "a.b", "c"}, d.Keys)
+		assert.Equal(t, []string{"1", "2", "3"}, d.Values)
+	})
+
+	t.Run("root document error is returned", func(t *testing.T) {
+		var d errUnmarshaler
+		err := toml.NewDecoder(strings.NewReader(`foo = "bar"`)).
+			EnableUnmarshalerInterface().Decode(&d)
+		assert.Error(t, err)
+	})
+
+	t.Run("not called when disabled", func(t *testing.T) {
+		var d errUnmarshaler
+		err := toml.NewDecoder(strings.NewReader(`foo = "bar"`)).Decode(&d)
+		assert.NoError(t, err)
+	})
+
+	t.Run("tables, pointers, array tables and maps", func(t *testing.T) {
+		type cfg struct {
+			A    string
+			T    orderedKVs
+			P    *orderedKVs
+			Arr  []orderedKVs
+			M    map[string]orderedKVs
+			Last int
+		}
+		doc := `
+A = "x"
+[T]
+b = "1"
+a = "2"
+[P]
+y = "3"
+[[Arr]]
+k = "4"
+[[Arr]]
+l = "5"
+[M.one]
+q = "6"
+`
+		var c cfg
+		err := toml.NewDecoder(strings.NewReader(doc)).
+			EnableUnmarshalerInterface().Decode(&c)
+		assert.NoError(t, err)
+		assert.Equal(t, "x", c.A)
+		assert.Equal(t, []string{"b", "a"}, c.T.Keys)
+		assert.Equal(t, []string{"1", "2"}, c.T.Values)
+		assert.Equal(t, []string{"y"}, c.P.Keys)
+		assert.Equal(t, 2, len(c.Arr))
+		assert.Equal(t, []string{"k"}, c.Arr[0].Keys)
+		assert.Equal(t, []string{"5"}, c.Arr[1].Values)
+		assert.Equal(t, []string{"q"}, c.M["one"].Keys)
+		assert.Equal(t, []string{"6"}, c.M["one"].Values)
+	})
+}
