+// tableUnmarshaler returns the unstable.Unmarshaler implemented by the table
+// target v (dereferencing and allocating pointers as needed), if the
+// unmarshaler interface is enabled.
+func (d *decoder) tableUnmarshaler(v reflect.Value) (unstable.Unmarshaler, bool) {
+	if !d.unmarshalerInterface || !v.IsValid() {
+		return nil, false
+	}
+
+	// Check the type first to avoid allocating pointers needlessly.
+	t := v.Type()
+	for t.Kind() == reflect.Ptr {
+		t = t.Elem()
+	}
+	if !reflect.PointerTo(t).Implements(unmarshalerType) {
+		return nil, false
+	}
+
+	for v.Kind() == reflect.Ptr {
+		if v.IsNil() && !v.CanSet() {
+			return nil, false
+		}
+		v = initAndDereferencePointer(v)
+	}
+
+	if !v.CanAddr() || !v.Addr().CanInterface() {
+		return nil, false
+	}
+	return v.Addr().Interface().(unstable.Unmarshaler), true
+}
+
+// handleKeyValuesUnmarshaler collects all the key-value expressions until the
+// end of the document or the next table, and provides them to u as a single
+// InlineTable node.
+func (d *decoder) handleKeyValuesUnmarshaler(u unstable.Unmarshaler) error {
+	var kvs []interface{}
+	for d.nextExpr() {
+		expr := d.expr()
+		if expr.Kind != unstable.KeyValue {
+			d.stashExpr()
+			break
+		}
+
+		_, err := d.seen.CheckExpression(expr)
+		if err != nil {
+			return err
+		}
+
+		// The parser reuses its buffers for each expression, so the
+		// expression needs to be copied before moving on.
+		kvs = append(kvs, unstablehook.NewInlineTable([]interface{}{expr}).(*unstable.Node).Child())
+	}
+
+	if err := d.p.Error(); err != nil {
+		return err
+	}
+
+	node := unstablehook.NewInlineTable(kvs).(*unstable.Node)
+	return u.UnmarshalTOML(node)
+}
