+}
diff --git a/unstable/copy.go b/unstable/copy.go
new file mode 100644
index 0000000..601a508
--- /dev/null
+++ b/unstable/copy.go
@@ -0,0 +1,58 @@
+package unstable
+
+import "github.com/pelletier/go-toml/v2/internal/unstablehook"
+
+func init() {
+	unstablehook.NewInlineTable = func(kvs []interface{}) interface{} {
+		nodes := make([]*Node, len(kvs))
+		for i, kv := range kvs {
+			nodes[i] = kv.(*Node)
+		}
+		return newInlineTable(nodes)
+	}
+}
+
+// newInlineTable deep-copies the given KeyValue nodes into a fresh backing
+// array, rooted at a synthetic InlineTable node.
+func newInlineTable(kvs []*Node) *Node {
+	r := &root{}
+	r.nodes = append(r.nodes, Node{Kind: InlineTable})
+	if len(kvs) > 0 {
+		first := kvs[0].Raw
+		last := kvs[len(kvs)-1].Raw
+		if last.Offset+last.Length >= first.Offset {
+			r.nodes[0].Raw = Range{Offset: first.Offset, Length: last.Offset + last.Length - first.Offset}
+		}
+	}
+
+	prev := -1
+	for _, kv := range kvs {
+		idx := copyNodeTree(r, kv)
+		if prev < 0 {
+			r.nodes[0].child = idx
+		} else {
+			r.nodes[prev].next = idx - prev
+		}
+		prev = idx
+	}
+	return &r.nodes[0]
+}
+
+// copyNodeTree appends a deep copy of n and its children to r and returns
+// the index of the copy. The next field of the copy is left to zero.
+func copyNodeTree(r *root, n *Node) int {
+	idx := len(r.nodes)
+	r.nodes = append(r.nodes, Node{Kind: n.Kind, Raw: n.Raw, Data: n.Data})
+
+	prev := -1
+	for c := n.Child(); c != nil; c = c.Next() {
+		cidx := copyNodeTree(r, c)
+		if prev < 0 {
+			r.nodes[idx].child = cidx - idx
+		} else {
+			r.nodes[prev].next = cidx - prev
+		}
+		prev = cidx
+	}
+	return idx
+}
