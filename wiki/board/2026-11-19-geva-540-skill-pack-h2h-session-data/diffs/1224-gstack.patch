@@ -1930,3 +1931,25 @@ func BenchmarkDecodeSFlowLayerPacket2(b *testing.B) {
 		sflow.DecodeFromBytes(SFlowTestPacket2[ /*eth*/ 14+ /*ipv4*/ 20+ /*udp*/ 8:], gopacket.NilDecodeFeedback)
 	}
 }
+
+func TestDecodeExtendedGatewayFlowRecordOversizedCounts(t *testing.T) {
+	build := func(words ...uint32) []byte {
+		b := make([]byte, 4*len(words))
+		for i, w := range words {
+			binary.BigEndian.PutUint32(b[4*i:], w)
+		}
+		return b
+	}
+	cases := map[string][]byte{
+		// ASPathCount=0, communitiesLength=0xFFFFFFFF
+		"communities": build(1003, 0, 1, 0x08080808, 0, 0, 0, 0, 0xFFFFFFFF),
+		// ASPathCount=1, path type=2, member count=0xFFFFFFFF
+		"aspath": build(1003, 0, 1, 0x08080808, 0, 0, 0, 1, 2, 0xFFFFFFFF),
+	}
+	for name, data := range cases {
+		d := data
+		if _, err := decodeExtendedGatewayFlowRecord(&d); err == nil {
+			t.Errorf("%s: expected error for oversized count", name)
+		}
+	}
+}
