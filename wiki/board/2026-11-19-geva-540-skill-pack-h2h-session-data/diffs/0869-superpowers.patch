+// unmarshalerTarget returns the unstable.Unmarshaler implemented by the table
+// target v, if any. Nil pointers are initialized when their element type
+// implements the interface.
+func unmarshalerTarget(v reflect.Value) (unstable.Unmarshaler, bool) {
+	for v.Kind() == reflect.Ptr {
+		if !reflect.PointerTo(v.Type().Elem()).Implements(unmarshalerType) &&
+			!v.Type().Elem().Implements(unmarshalerType) &&
+			v.Type().Elem().Kind() != reflect.Ptr {
+			return nil, false
+		}
+		v = initAndDereferencePointer(v)
+	}
+	if v.CanAddr() && v.Addr().CanInterface() {
+		if outi, ok := v.Addr().Interface().(unstable.Unmarshaler); ok {
+			return outi, true
+		}
+	}
