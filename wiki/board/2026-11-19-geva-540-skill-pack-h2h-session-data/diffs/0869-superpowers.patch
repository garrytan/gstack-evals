+
+type orderedKVs struct {
+	Keys []string
+}
+
+func (o *orderedKVs) UnmarshalTOML(node *unstable.Node) error {
+	if node.Kind != unstable.KeyValue {
+		return fmt.Errorf("expected KeyValue, got %s", node.Kind)
+	}
+	it := node.Key()
+	var parts []string
+	for it.Next() {
+		parts = append(parts, string(it.Node().Data))
+	}
+	o.Keys = append(o.Keys, strings.Join(parts, ".")+"="+string(node.Value().Data))
+	return nil
+}
+
+type failingTableUnmarshaler struct{}
+
+func (failingTableUnmarshaler) UnmarshalTOML(*unstable.Node) error {
+	return errors.New("custom failure")
+}
+
+func TestUnmarshal_CustomUnmarshalerTables(t *testing.T) {
+	t.Run("root document", func(t *testing.T) {
+		var o orderedKVs
+		err := toml.NewDecoder(strings.NewReader("foo = \"bar\"\nb.c = 1\na = 2")).
+			EnableUnmarshalerInterface().Decode(&o)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"foo=bar", "b.c=1", "a=2"}, o.Keys)
+	})
+
+	t.Run("tables and array tables", func(t *testing.T) {
+		var cfg struct {
+			T   orderedKVs
+			P   *orderedKVs
+			Arr []orderedKVs
+		}
+		input := "[T]\nz = 1\ny = 2\n[P]\nx = 3\n[[Arr]]\nw = 4\n[[Arr]]\nv = 5\n"
+		err := toml.NewDecoder(strings.NewReader(input)).
+			EnableUnmarshalerInterface().Decode(&cfg)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"z=1", "y=2"}, cfg.T.Keys)
+		assert.Equal(t, []string{"x=3"}, cfg.P.Keys)
+		assert.Equal(t, 2, len(cfg.Arr))
+		assert.Equal(t, []string{"w=4"}, cfg.Arr[0].Keys)
+		assert.Equal(t, []string{"v=5"}, cfg.Arr[1].Keys)
+	})
+
+	t.Run("error is propagated", func(t *testing.T) {
+		var f failingTableUnmarshaler
+		err := toml.NewDecoder(strings.NewReader(`foo = "bar"`)).
+			EnableUnmarshalerInterface().Decode(&f)
+		assert.Error(t, err)
+		assert.True(t, strings.Contains(err.Error(), "custom failure"))
+	})
+
+	t.Run("interface disabled", func(t *testing.T) {
+		var o orderedKVs
+		err := toml.NewDecoder(strings.NewReader(`foo = "bar"`)).Decode(&o)
+		assert.NoError(t, err)
+		assert.Equal(t, 0, len(o.Keys))
+	})
+}
