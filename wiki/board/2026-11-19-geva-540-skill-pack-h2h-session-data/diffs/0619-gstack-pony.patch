+// listBackupVaultTags returns all tags of a backup vault. The result is never nil on success,
+// so vaults without tags are still eligible for tag-based filtering.
+func listBackupVaultTags(ctx context.Context, client BackupVaultAPI, arn *string) (map[string]string, error) {
+	tags := map[string]string{}
+	paginator := backup.NewListTagsPaginator(client, &backup.ListTagsInput{ResourceArn: arn})
+	for paginator.HasMorePages() {
+		page, err := paginator.NextPage(ctx)
+		if err != nil {
+			return nil, err
+		}
+		for k, v := range page.Tags {
+			tags[k] = v
+		}
+	}
+	return tags, nil
+}
