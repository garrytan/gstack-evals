+// SetMetricsLabels sets constant labels (e.g. kuma_workload, mesh, k8s_kuma_io_namespace, kuma_io_zone)
+// on DNS metrics so they match labels added to Envoy metrics.
+func SetMetricsLabels(extraLabels map[string]string) {
+	if collector == nil {
+		return
+	}
+	var labels []*dto.LabelPair
+	for k, v := range extraLabels {
+		if k == "" || v == "" {
+			continue
+		}
+		labels = append(labels, &dto.LabelPair{Name: proto.String(sanitizeLabelName(k)), Value: proto.String(v)})
+	}
+	sort.Slice(labels, func(i, j int) bool { return labels[i].GetName() < labels[j].GetName() })
+	collector.mu.Lock()
+	collector.labels = labels
+	collector.mu.Unlock()
+}
+
+// labeledCollector is an unchecked collector which adds labels, that can change at runtime, to inner metrics.
+type labeledCollector struct {
+	mu     sync.RWMutex
+	labels []*dto.LabelPair
+	inner  []prometheus.Collector
+}
+
+func (c *labeledCollector) Describe(chan<- *prometheus.Desc) {}
+
+func (c *labeledCollector) Collect(ch chan<- prometheus.Metric) {
+	c.mu.RLock()
+	labels := c.labels
+	c.mu.RUnlock()
+	innerCh := make(chan prometheus.Metric)
+	go func() {
+		for _, in := range c.inner {
+			in.Collect(innerCh)
+		}
+		close(innerCh)
+	}()
+	for metric := range innerCh {
+		ch <- &labeledMetric{Metric: metric, labels: labels}
+	}
+}
+
+type labeledMetric struct {
+	prometheus.Metric
+	labels []*dto.LabelPair
+}
+
+func (l *labeledMetric) Write(out *dto.Metric) error {
+	if err := l.Metric.Write(out); err != nil {
+		return err
+	}
+	out.Label = append(out.Label, l.labels...)
+	sort.Slice(out.Label, func(i, j int) bool { return out.Label[i].GetName() < out.Label[j].GetName() })
+	return nil
+}
+
+func sanitizeLabelName(name string) string {
+	var b strings.Builder
+	for i, r := range name {
+		switch {
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r == '_':
+			b.WriteRune(r)
+		case r >= '0' && r <= '9':
+			if i == 0 {
+				b.WriteRune('_')
+			}
+			b.WriteRune(r)
+		default:
+			b.WriteRune('_')
+		}
+	}
+	return b.String()
+}
