+// metricMethod clamps the HTTP method to a fixed allowlist so that
+// attacker-controlled method strings cannot create unbounded label
+// cardinality in the Prometheus registry.
+func metricMethod(method string) string {
+	switch method {
+	case http.MethodGet, http.MethodPost, http.MethodPut, http.MethodDelete,
+		http.MethodOptions, http.MethodHead, http.MethodConnect, http.MethodTrace:
+		return method
+	default:
+		return "other"
+	}
+}
