+func TestMetricsMiddlewareClampsMethodLabel(t *testing.T) {
+	reg := prometheus.NewRegistry()
+	mw := newMetricsMiddleware(reg)
+	h := mw(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+
+	for _, m := range []string{"M1", "M2", "FOO", "get", http.MethodGet, http.MethodPatch} {
+		req := httptest.NewRequest(http.MethodGet, "/", nil)
+		req.Method = m
+		h.ServeHTTP(httptest.NewRecorder(), req)
+	}
+
+	mfs, err := reg.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	allowed := map[string]bool{"GET": true, "POST": true, "PUT": true, "DELETE": true,
+		"OPTIONS": true, "HEAD": true, "CONNECT": true, "TRACE": true, "other": true}
+	for _, mf := range mfs {
+		methods := map[string]bool{}
+		for _, metric := range mf.GetMetric() {
+			for _, l := range metric.GetLabel() {
+				if l.GetName() == "method" {
+					if !allowed[l.GetValue()] {
+						t.Errorf("%s: unexpected method label %q", mf.GetName(), l.GetValue())
+					}
+					methods[l.GetValue()] = true
+				}
+			}
+		}
+		if len(methods) != 2 || !methods["GET"] || !methods["other"] {
+			t.Errorf("%s: expected method labels {GET, other}, got %v", mf.GetName(), methods)
+		}
+	}
+}
