+        /// <summary>
+        /// Check whether a path is the same as or inside another path
+        /// </summary>
+        /// <param name="path">The path that might be inside the other one</param>
+        /// <param name="root">The path that might contain the other one</param>
+        /// <returns>True if path equals root or is a descendant of it, false otherwise</returns>
+        public static bool IsSameOrSubPathOf(string path, string root)
+        {
+            var normPath = NormalizePath(Path.GetFullPath(path));
+            var normRoot = NormalizePath(Path.GetFullPath(root));
+            return normPath.Equals(normRoot, Platform.PathComparison)
+                   || normPath.StartsWith(normRoot.EndsWith("/") ? normRoot
+                                                                  : normRoot + "/",
+                                          Platform.PathComparison);
+        }
+
     }
 }
