+func getBackupVaultTags(ctx context.Context, client BackupVaultAPI, arn *string) (map[string]string, error) {
+	tags := map[string]string{}
+	input := &backup.ListTagsInput{ResourceArn: arn}
+	for {
+		output, err := client.ListTags(ctx, input)
+		if err != nil {
+			return nil, err
+		}
+		for k, v := range output.Tags {
+			tags[k] = v
+		}
+		if output.NextToken == nil {
+			return tags, nil
+		}
+		input.NextToken = output.NextToken
+	}
+}
