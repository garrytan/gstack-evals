+    @Test
+    public void testExternalLink() {
+        StringWriter w = new StringWriter();
+        DocGenerator crdGenerator = new DocGenerator(ApiVersion.V1, 1, singletonList(ExternalLinkCrd.class), w, new KubeLinker("{KubeApiReferenceBase}"));
+        assertDoesNotThrow(() -> crdGenerator.generate(ExternalLinkCrd.class));
+        String s = w.toString();
+
+        // KubeLink still works
+        assertThat(s, containsString("|affinity" + System.lineSeparator() + "|{KubeApiReferenceBase}#affinity-v1-core[Affinity]"));
+        // ExternalLink uses the URL as is
+        assertThat(s, containsString("|toleration" + System.lineSeparator() + "|https://gateway-api.sigs.k8s.io/reference/spec/[Toleration]"));
+        // Externally linked types are not documented
+        assertThat(s, not(containsString("type-Toleration-")));
+        assertThat(s, not(containsString("type-Affinity-")));
+    }
+
+    @Test
+    public void testExternalLinkWithoutLinker() {
+        StringWriter w = new StringWriter();
+        DocGenerator crdGenerator = new DocGenerator(ApiVersion.V1, 1, singletonList(ExternalLinkCrd.class), w, null);
+        assertDoesNotThrow(() -> crdGenerator.generate(ExternalLinkCrd.class));
+        String s = w.toString();
+
+        // ExternalLink does not need a linker
+        assertThat(s, containsString("|toleration" + System.lineSeparator() + "|https://gateway-api.sigs.k8s.io/reference/spec/[Toleration]"));
+    }
 }
