+        [Test]
+        public void TestCreateCellUsesDefaultColumnStyle()
+        {
+            IWorkbook wb1 = _testDataProvider.CreateWorkbook();
+            ISheet sheet = wb1.CreateSheet();
+            ICellStyle columnStyle = wb1.CreateCellStyle();
+            columnStyle.FillForegroundColor = IndexedColors.Red.Index;
+            columnStyle.FillPattern = FillPattern.SolidForeground;
+            sheet.SetDefaultColumnStyle(1, columnStyle);
+
+            IRow row = sheet.CreateRow(1);
+            ClassicAssert.AreEqual(columnStyle.Index, row.CreateCell(1).CellStyle.Index, "column style applied");
+            ClassicAssert.AreNotEqual(columnStyle.Index, row.CreateCell(0).CellStyle.Index, "unstyled column keeps default style");
+
+            ICellStyle rowStyle = wb1.CreateCellStyle();
+            IRow styledRow = sheet.CreateRow(2);
+            styledRow.RowStyle = rowStyle;
+            ClassicAssert.AreEqual(rowStyle.Index, styledRow.CreateCell(1).CellStyle.Index, "row style wins over column style");
+
+            IWorkbook wb2 = _testDataProvider.WriteOutAndReadBack(wb1);
+            ClassicAssert.AreEqual(IndexedColors.Red.Index,
+                wb2.GetSheetAt(0).GetRow(1).GetCell(1).CellStyle.FillForegroundColor, "column style persisted");
+            wb2.Close();
+            wb1.Close();
+        }
+
