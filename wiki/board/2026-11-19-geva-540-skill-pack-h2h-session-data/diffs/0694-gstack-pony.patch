+using Quartz.Impl;
+using Quartz.Simpl;
+using Quartz.Spi;
+
+namespace Quartz.Tests.Unit.Core;
+
+[TestFixture]
+public class JobRunShellAsyncLocalTest
+{
+    private static readonly AsyncLocal<string> current = new();
+
+    [Test]
+    public async Task AsyncLocalSetInJobFactoryFlowsToJobExecution()
+    {
+        var factory = new StdSchedulerFactory(new System.Collections.Specialized.NameValueCollection
+        {
+            ["quartz.scheduler.instanceName"] = "AsyncLocalTest_" + Guid.NewGuid()
+        });
+        IScheduler scheduler = await factory.GetScheduler();
+        scheduler.JobFactory = new AsyncLocalJobFactory();
+        var job = JobBuilder.Create<CaptureJob>().UsingJobData("value", "tenant-001").Build();
+        var trigger = TriggerBuilder.Create().StartNow().Build();
+
+        CaptureJob.Result = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
+        await scheduler.ScheduleJob(job, trigger);
+        await scheduler.Start();
+        try
+        {
+            var completed = await Task.WhenAny(CaptureJob.Result.Task, Task.Delay(TimeSpan.FromSeconds(10)));
+            Assert.That(completed, Is.SameAs(CaptureJob.Result.Task));
+            Assert.That(await CaptureJob.Result.Task, Is.EqualTo("tenant-001"));
+        }
+        finally
+        {
+            await scheduler.Shutdown(false);
+        }
+    }
+
+    private sealed class AsyncLocalJobFactory : SimpleJobFactory
+    {
+        public override IJob NewJob(TriggerFiredBundle bundle, IScheduler scheduler)
+        {
+            current.Value = bundle.JobDetail.JobDataMap.GetString("value");
+            return base.NewJob(bundle, scheduler);
+        }
+    }
+
+    private sealed class CaptureJob : IJob
+    {
+        public static TaskCompletionSource<string> Result = null!;
+
+        public async ValueTask Execute(IJobExecutionContext context)
+        {
+            await Task.Yield();
+            Result.TrySetResult(current.Value);
+        }
+    }
+}
