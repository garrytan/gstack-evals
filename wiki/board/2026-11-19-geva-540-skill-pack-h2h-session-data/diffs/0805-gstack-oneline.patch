index 0000000..33313ac
--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/_config.js
@@ -0,0 +1,13 @@
+import { flushSync } from 'svelte';
+import { test } from '../../test';
+export default test({
+	async test({ assert, target }) {
+		const input = target.querySelector('input');
+		input.focus();
+		input.value = 'value1';
+		input.dispatchEvent(new InputEvent('input', { bubbles: true }));
+		flushSync();
+		assert.htmlEqual(target.querySelector('div').innerHTML, 'value1');
+		assert.equal(input.value, 'value1');
+	}
+});
diff --git a/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/main.svelte b/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/main.svelte
