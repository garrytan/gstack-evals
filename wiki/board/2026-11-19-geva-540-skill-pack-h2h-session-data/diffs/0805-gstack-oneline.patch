--- /dev/null
+++ b/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/main.svelte
@@ -0,0 +1,8 @@
+<script>
+	class MyStore {
+		arr = $state([{ value: "value" }])
+		update = (x) => { this.arr = this.arr.map(_ => ({ value: x })) }
+	}
+	const s = new MyStore();
+</script>
+{#each s.arr as obj}<div>{obj.value}</div><input bind:value={() => obj.value, (x) => s.update(x)} />{/each}
