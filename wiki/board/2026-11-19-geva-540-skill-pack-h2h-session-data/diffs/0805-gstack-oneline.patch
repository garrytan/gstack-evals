@@ -0,0 +1,5 @@
+---
+'svelte': patch
+---
+
+fix: update focused input bound with getter/setter when getter returns a stale value
diff --git a/packages/svelte/src/internal/client/dom/elements/bindings/input.js b/packages/svelte/src/internal/client/dom/elements/bindings/input.js
index 67e6ff1..3f29294 100644
--- a/packages/svelte/src/internal/client/dom/elements/bindings/input.js
+++ b/packages/svelte/src/internal/client/dom/elements/bindings/input.js
@@ -50,6 +50,13 @@ export function bind_value(input, get, set = get) {
 				input.selectionStart = start;
 				input.selectionEnd = Math.min(end, input.value.length);
 			}
+
+			// the input no longer reflects what the user typed (the getter may return a stale
+			// value, e.g. an each block item that has not yet been updated), so allow the
+			// render effect to update it once the batch is flushed
+			if (current_batch !== null) {
+				batches.delete(current_batch);
+			}
 		}
 	});
 
diff --git a/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/_config.js b/packages/svelte/tests/runtime-runes/samples/bind-value-each-getter-setter/_config.js
