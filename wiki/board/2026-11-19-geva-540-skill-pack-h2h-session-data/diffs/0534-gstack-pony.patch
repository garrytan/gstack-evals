+// Regression: progress must be persisted after every batch, not only the first.
+func TestDatasetServiceImpl_RunSnapshotItemJob_PersistsProgressEveryBatch(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+
+	mockRepo := mock_repo.NewMockIDatasetAPI(ctrl)
+	mockIConfig := confmocks.NewMockIConfig(ctrl)
+	mockILocker := lockmocks.NewMockILocker(ctrl)
+	service := &DatasetServiceImpl{
+		repo:     mockRepo,
+		retryCfg: mockIConfig.GetSnapshotRetry,
+		locker:   mockILocker,
+	}
+
+	mockIConfig.EXPECT().GetSnapshotRetry().Return(&conf.SnapshotRetry{}).AnyTimes()
+	mockRepo.EXPECT().GetVersion(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(&entity.DatasetVersion{ID: 1}, nil)
+	mockILocker.EXPECT().LockBackoffWithRenew(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(true, context.Background(), func() {}, nil)
+	gomock.InOrder(
+		mockRepo.EXPECT().ListItems(gomock.Any(), gomock.Any()).Return(nil, &pagination.PageResult{Cursor: "c1"}, nil),
+		mockRepo.EXPECT().ListItems(gomock.Any(), gomock.Any()).Return(nil, &pagination.PageResult{Cursor: "c2"}, nil),
+		mockRepo.EXPECT().ListItems(gomock.Any(), gomock.Any()).Return(nil, &pagination.PageResult{}, nil),
+	)
+	mockRepo.EXPECT().BatchUpsertItemSnapshots(gomock.Any(), gomock.Any()).Return(int64(0), nil).Times(3)
+	mockRepo.EXPECT().CountItemSnapshots(gomock.Any(), gomock.Any(), gomock.Any()).Return(int64(0), nil)
+
+	var cursors []string
+	mockRepo.EXPECT().PatchVersion(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn(
+		func(_ context.Context, patch, _ *entity.DatasetVersion, _ ...repo.Option) error {
+			cursors = append(cursors, patch.SnapshotProgress.Cursor)
+			return nil
+		}).Times(3)
+
+	err := service.RunSnapshotItemJob(context.Background(), &entity.JobRunMessage{
+		Type:  entity.DatasetSnapshotJob,
+		Extra: map[string]string{"version_id": "1"},
+	})
+	if err != nil {
+		t.Fatalf("RunSnapshotItemJob() error = %v", err)
+	}
+	if want := []string{"c1", "c2", ""}; fmt.Sprint(cursors) != fmt.Sprint(want) {
+		t.Errorf("persisted cursors = %q, want %q", cursors, want)
+	}
+}
