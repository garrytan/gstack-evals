+// resolveSendText picks the best available final text. The Codex backend
+// frequently sends a response.completed event with an empty output array, so
+// fall back to streamed output items, then to accumulated text deltas.
+func (c *Client) resolveSendText(
+	completedResp *responses.Response, outputItems []responses.ResponseOutputItemUnion, deltaText, doneText string,
+) string {
 	if completedResp != nil {
-		return c.ExtractText(completedResp), nil
+		if text := c.ExtractText(completedResp); text != "" {
+			return text
+		}
 	}
-
-	return builder.String(), nil
+	if len(outputItems) > 0 {
+		resp := responses.Response{Output: outputItems}
+		if text := c.ExtractText(&resp); text != "" {
+			return text
+		}
+	}
+	if deltaText != "" {
+		return deltaText
+	}
