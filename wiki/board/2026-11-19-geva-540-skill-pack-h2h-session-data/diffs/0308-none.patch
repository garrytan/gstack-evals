+func TestSendFallsBackWhenCompletedOutputIsEmpty(t *testing.T) {
+	cases := map[string][]map[string]any{
+		"deltas only": {
+			{"type": "response.output_text.delta", "delta": "hello "},
+			{"type": "response.output_text.delta", "delta": "from codex"},
+			{"type": "response.completed", "response": map[string]any{"output": []any{}}},
+		},
+		"output item done": {
+			{"type": "response.output_item.done", "item": map[string]any{
+				"type": "message",
+				"content": []any{
+					map[string]any{"type": "output_text", "text": "hello from codex", "annotations": []any{}},
+				},
+			}},
+			{"type": "response.completed", "response": map[string]any{"output": []any{}}},
+		},
+		"text done only": {
+			{"type": "response.output_text.done", "text": "hello from codex"},
+			{"type": "response.completed", "response": map[string]any{"output": []any{}}},
+		},
+	}
+
+	for name, events := range cases {
+		t.Run(name, func(t *testing.T) {
+			apiServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "text/event-stream")
+				for _, event := range events {
+					fmt.Fprintf(w, "data: %s\n\n", marshalJSON(t, event))
+				}
+				fmt.Fprint(w, "data: [DONE]\n\n")
+			}))
+			defer apiServer.Close()
+
+			client := newConfiguredTestClient(t, apiServer.URL, "acct_empty", testJWT("acct_empty", time.Now().Add(time.Hour)))
+			message, err := client.Send(context.Background(), []*chat.ChatCompletionMessage{
+				{Role: chat.ChatMessageRoleUser, Content: "Hello"},
+			}, &domain.ChatOptions{Model: "gpt-5.4"})
+			if err != nil {
+				t.Fatalf("Send() error = %v", err)
+			}
+			if message != "hello from codex" {
+				t.Fatalf("Send() = %q, want %q", message, "hello from codex")
+			}
+		})
+	}
+}
