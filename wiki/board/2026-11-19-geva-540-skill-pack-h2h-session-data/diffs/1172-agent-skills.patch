index 0000000..86262f9
--- /dev/null
+++ b/tests/unit/classes/node_helper_spec.js
@@ -0,0 +1,57 @@
+const NodeHelper = require("../../../js/node_helper");
+
+/**
+ * Creates a fake socket.io server that captures the catch-all handler.
+ * @returns {{io: object, emit: (notification: string, payload: object) => void}} fake io and a function to dispatch inbound notifications
+ */
+function createFakeIo () {
+	let onAnyHandler;
+	const io = {
+		of () {
+			return {
+				on (_event, cb) {
+					cb({ onAny (fn) { onAnyHandler = fn; } });
+				},
+				emit () {}
+			};
+		}
+	};
+	return { io, emit: (notification, payload) => onAnyHandler(notification, payload) };
+}
+
+describe("NodeHelper socket dispatcher", () => {
+	let savedConfig;
+
+	beforeEach(() => {
+		savedConfig = global.config;
+		process.env.SECRET_NODE_HELPER_TEST = "super-secret-value";
+	});
+
+	afterEach(() => {
+		global.config = savedConfig;
+		delete process.env.SECRET_NODE_HELPER_TEST;
+	});
+
+	for (const cors of ["disabled", "allowWhitelist", "allowAll"]) {
+		it(`does not expand SECRET_* placeholders in inbound payloads (cors=${cors})`, () => {
+			global.config = { hideConfigSecrets: true, cors };
+			const helper = new NodeHelper();
+			helper.setName("test_helper");
+			const received = [];
+			helper.socketNotificationReceived = (notification, payload) => received.push({ notification, payload });
+
+			const { io, emit } = createFakeIo();
+			helper.setSocketIO(io);
+
+			const payload = { instanceId: "**SECRET_NODE_HELPER_TEST**", nested: { url: "https://x/?k=**SECRET_NODE_HELPER_TEST**" } };
+			emit("INIT", payload);
+
+			expect(received).toHaveLength(1);
+			expect(received[0].payload).toEqual({
+				instanceId: "**SECRET_NODE_HELPER_TEST**",
+				nested: { url: "https://x/?k=**SECRET_NODE_HELPER_TEST**" }
+			});
+			expect(JSON.stringify(received[0].payload)).not.toContain("super-secret-value");
+		});
+	}
+});
