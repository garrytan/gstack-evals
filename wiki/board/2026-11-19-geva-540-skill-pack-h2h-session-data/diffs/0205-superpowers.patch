diff --git a/src/Riok.Mapperly/Helpers/EnumerableExtensions.cs b/src/Riok.Mapperly/Helpers/EnumerableExtensions.cs
index 02dc21e..5b00ba1 100644
--- a/src/Riok.Mapperly/Helpers/EnumerableExtensions.cs
+++ b/src/Riok.Mapperly/Helpers/EnumerableExtensions.cs
@@ -2,6 +2,28 @@ namespace Riok.Mapperly.Helpers;
 
 public static class EnumerableExtensions
 {
+    /// <summary>
+    /// Concatenates two sequences while skipping items of <paramref name="other"/>
+    /// which are already contained (by reference) in the resulting sequence.
+    /// This is used to include configurations from multiple sources
+    /// which may share the same (transitively included) configuration instances.
+    /// </summary>
+    public static IReadOnlyCollection<T> ConcatDistinctByReference<T>(this IEnumerable<T> enumerable, IEnumerable<T>? other)
+        where T : class
+    {
+        var seen = new HashSet<T>(ReferenceEqualityComparer.Instance);
+        var result = new List<T>();
+        foreach (var item in enumerable.Concat(other ?? []))
+        {
+            if (seen.Add(item))
+            {
+                result.Add(item);
+            }
+        }
+
+        return result;
+    }
+
