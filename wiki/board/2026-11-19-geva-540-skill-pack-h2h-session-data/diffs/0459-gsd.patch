diff --git a/internal/chezmoi/format.go b/internal/chezmoi/format.go
index 341ac66..49d505c 100644
--- a/internal/chezmoi/format.go
+++ b/internal/chezmoi/format.go
@@ -10,6 +10,7 @@ import (
 	"slices"
 	"strings"
 
+	burntsushitoml "github.com/BurntSushi/toml"
 	"github.com/goccy/go-yaml"
 	"github.com/pelletier/go-toml/v2"
 	"github.com/tailscale/hujson"
@@ -158,10 +159,25 @@ func (formatTOML) Name() string {
 }
 
 // Unmarshal implements Format.Unmarshal.
+//
+// github.com/BurntSushi/toml is used for unmarshaling because it supports TOML
+// v1.1.0, whereas github.com/pelletier/go-toml/v2 only supports TOML v1.0.0.
 func (formatTOML) Unmarshal(data []byte, value any) error {
-	decoder := toml.NewDecoder(bytes.NewReader(data))
-	decoder.DisallowUnknownFields()
-	return decoder.Decode(value)
+	metaData, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(value)
+	if err != nil {
+		return err
+	}
+	// Generic types accept all fields, so there can be no unknown fields.
+	// Furthermore, github.com/BurntSushi/toml reports keys in nested tables
+	// as undecoded when decoding into generic types.
+	switch value.(type) {
+	case *any, *[]any, *map[string]any:
+		return nil
+	}
+	if undecoded := metaData.Undecoded(); len(undecoded) > 0 {
+		return fmt.Errorf("toml: unknown field %q", undecoded[0].String())
+	}
+	return nil
 }
 
 // Name implements Format.Name.
