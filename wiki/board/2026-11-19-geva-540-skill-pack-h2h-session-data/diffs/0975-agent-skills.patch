+			d = int(r-'A') + 1
 		} else if r >= 'a' && r <= 'z' {
-			col += int(r-'a'+1) * multi
+			d = int(r-'a') + 1
 		} else {
 			return -1, newInvalidColumnNameError(name)
 		}
-		multi *= 26
+		if !overflow {
+			if col = col*26 + d; col > MaxColumns {
+				overflow = true
+			}
+		}
 	}
-	if col > MaxColumns {
+	if overflow {
 		return -1, ErrColumnNumber
 	}
 	return col, nil
