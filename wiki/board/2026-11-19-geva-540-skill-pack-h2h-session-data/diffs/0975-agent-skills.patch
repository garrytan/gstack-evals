+func TestColumnOverflowWorksheetNoPanic(t *testing.T) {
+	for sheetData, expected := range map[string]error{
+		`<sheetData><row r="0"><c r="VGWQHXLSDVIKWV1" t="inlineStr"><is><t>pwn</t></is></c></row></sheetData>`:              nil,
+		`<sheetData><row r="1"><c r="XFD1"/><c r="VGWQHXLSDVIKWV1" t="inlineStr"><is><t>pwn</t></is></c></row></sheetData>`: ErrColumnNumber,
