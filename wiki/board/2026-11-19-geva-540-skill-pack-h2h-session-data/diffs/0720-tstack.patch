 func (p *OAuthProxy) isTrustedIP(req *http.Request) bool {
-	// RemoteAddr @ means unix socket
+	// No trusted IPs configured, nothing to check.
+	if p.trustedIPs == nil {
+		return false
+	}
+
+	// RemoteAddr @ means unix socket, which has no source IP. Without a real
+	// client IP parser (--reverse-proxy) there is nothing to compare against.
