+func TestTrustedIPsUnixSocketDoesNotLogError(t *testing.T) {
+	for _, trustedIPs := range [][]string{nil, {"127.0.0.1"}} {
+		opts := baseTestOptions()
+		opts.TrustedIPs = trustedIPs
+		assert.NoError(t, validation.Validate(opts))
+
+		proxy, err := NewOAuthProxy(opts, func(string) bool { return true })
+		assert.NoError(t, err)
+
+		buf := &bytes.Buffer{}
+		logger.SetErrOutput(buf)
+		req, _ := http.NewRequest("GET", "/", nil)
+		req.RemoteAddr = "@"
+		assert.False(t, proxy.isTrustedIP(req))
+		logger.SetErrOutput(os.Stderr)
+
+		assert.NotContains(t, buf.String(), "Error obtaining real IP")
+	}
