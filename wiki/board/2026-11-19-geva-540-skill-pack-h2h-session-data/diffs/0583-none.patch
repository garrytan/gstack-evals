diff --git a/app/kuma-dp/pkg/dataplane/selfmetrics/selfmetrics.go b/app/kuma-dp/pkg/dataplane/selfmetrics/selfmetrics.go
new file mode 100644
index 0000000..b99baa9
--- /dev/null
+++ b/app/kuma-dp/pkg/dataplane/selfmetrics/selfmetrics.go
@@ -0,0 +1,98 @@
+// Package selfmetrics contains the Prometheus registry used for metrics
+// emitted by the kuma-dp process itself (e.g. DNS proxy metrics).
+//
+// Unlike Envoy or application metrics, these metrics are not scraped and
+// translated through the OpenTelemetry pipeline, so they don't automatically
+// receive the extra labels (like `kuma_workload`) configured by MeshMetric.
+// The LabelingGatherer adds those labels when the metrics are gathered.
+package selfmetrics
+
+import (
+	"sort"
+	"sync"
+
+	"github.com/prometheus/client_golang/prometheus"
+	io_prometheus_client "github.com/prometheus/client_model/go"
+	"github.com/prometheus/otlptranslator"
+)
+
+// Registry is the registry where metrics emitted by kuma-dp itself should be registered.
+var Registry = prometheus.NewRegistry()
+
+// DefaultGatherer gathers metrics from Registry and decorates them with extra labels.
+var DefaultGatherer = NewLabelingGatherer(Registry)
+
+// LabelingGatherer wraps a Gatherer and adds a configurable set of labels
+// to every gathered metric. Labels already present on a metric are not overridden.
+type LabelingGatherer struct {
+	gatherer prometheus.Gatherer
+	mu       sync.RWMutex
+	labels   []*io_prometheus_client.LabelPair
+}
+
+var _ prometheus.Gatherer = &LabelingGatherer{}
+
+func NewLabelingGatherer(gatherer prometheus.Gatherer) *LabelingGatherer {
+	return &LabelingGatherer{gatherer: gatherer}
+}
+
+// SetLabels replaces the set of labels added to the gathered metrics.
+// Label names are normalized to be Prometheus compliant (e.g. "kuma.workload" -> "kuma_workload"),
+// the same way OpenTelemetry attributes are translated for Envoy and application metrics.
+func (g *LabelingGatherer) SetLabels(labels map[string]string) {
+	namer := otlptranslator.LabelNamer{}
+	byName := map[string]string{}
+	for k, v := range labels {
+		if v == "" {
+			continue
+		}
+		name, err := namer.Build(k)
+		if err != nil {
+			continue
+		}
+		byName[name] = v
+	}
+	pairs := make([]*io_prometheus_client.LabelPair, 0, len(byName))
+	for name, value := range byName {
+		pairs = append(pairs, &io_prometheus_client.LabelPair{Name: &name, Value: &value})
+	}
+	sort.Slice(pairs, func(i, j int) bool { return pairs[i].GetName() < pairs[j].GetName() })
+
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.labels = pairs
+}
+
+func (g *LabelingGatherer) Gather() ([]*io_prometheus_client.MetricFamily, error) {
+	families, err := g.gatherer.Gather()
+
+	g.mu.RLock()
+	extra := g.labels
+	g.mu.RUnlock()
+
+	if len(extra) == 0 {
+		return families, err
+	}
+
+	for _, family := range families {
+		for _, metric := range family.GetMetric() {
+			existing := map[string]struct{}{}
+			for _, l := range metric.GetLabel() {
+				existing[l.GetName()] = struct{}{}
+			}
+			for _, l := range extra {
+				if _, ok := existing[l.GetName()]; ok {
+					continue
+				}
+				metric.Label = append(metric.Label, &io_prometheus_client.LabelPair{
+					Name:  l.Name,
+					Value: l.Value,
+				})
+			}
+			sort.Slice(metric.Label, func(i, j int) bool {
+				return metric.Label[i].GetName() < metric.Label[j].GetName()
+			})
+		}
+	}
+	return families, err
+}
diff --git a/app/kuma-dp/pkg/dataplane/selfmetrics/selfmetrics_test.go b/app/kuma-dp/pkg/dataplane/selfmetrics/selfmetrics_test.go
new file mode 100644
index 0000000..62d476f
--- /dev/null
+++ b/app/kuma-dp/pkg/dataplane/selfmetrics/selfmetrics_test.go
@@ -0,0 +1,80 @@
+package selfmetrics_test
+
+import (
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/prometheus/client_golang/prometheus"
+
+	"github.com/kumahq/kuma/v2/app/kuma-dp/pkg/dataplane/selfmetrics"
+)
+
+var _ = Describe("LabelingGatherer", func() {
+	labelsOf := func(g prometheus.Gatherer) map[string]string {
+		families, err := g.Gather()
+		Expect(err).ToNot(HaveOccurred())
+		Expect(families).To(HaveLen(1))
+		Expect(families[0].GetMetric()).To(HaveLen(1))
+		result := map[string]string{}
+		for _, l := range families[0].GetMetric()[0].GetLabel() {
+			result[l.GetName()] = l.GetValue()
+		}
+		return result
+	}
+
+	It("should add extra labels to gathered metrics", func() {
+		// given
+		registry := prometheus.NewRegistry()
+		histogram := prometheus.NewHistogram(prometheus.HistogramOpts{
+			Name: "kuma_dp_dns_request_duration_seconds",
+		})
+		registry.MustRegister(histogram)
+		histogram.Observe(1)
+		gatherer := selfmetrics.NewLabelingGatherer(registry)
+
+		// then no labels by default
+		Expect(labelsOf(gatherer)).To(BeEmpty())
+
+		// when
+		gatherer.SetLabels(map[string]string{
+			"kuma.workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"k8s_kuma_io_namespace": "kuma-demo",
+			"kuma_io_zone":          "zone-1",
+			"mesh":                  "default",
+			"empty":                 "",
+		})
+
+		// then
+		Expect(labelsOf(gatherer)).To(Equal(map[string]string{
+			"kuma_workload":         "kri_wl_default_zone-1_kuma-demo_demo-app_",
+			"k8s_kuma_io_namespace": "kuma-demo",
+			"kuma_io_zone":          "zone-1",
+			"mesh":                  "default",
+		}))
+
+		// when labels are reset
+		gatherer.SetLabels(nil)
+
+		// then
+		Expect(labelsOf(gatherer)).To(BeEmpty())
+	})
+
+	It("should not override existing labels", func() {
+		// given
+		registry := prometheus.NewRegistry()
+		counter := prometheus.NewCounter(prometheus.CounterOpts{
+			Name:        "some_counter",
+			ConstLabels: prometheus.Labels{"mesh": "original"},
+		})
+		registry.MustRegister(counter)
+		gatherer := selfmetrics.NewLabelingGatherer(registry)
+
+		// when
+		gatherer.SetLabels(map[string]string{"mesh": "other", "kuma.workload": "wl"})
+
+		// then
+		Expect(labelsOf(gatherer)).To(Equal(map[string]string{
+			"mesh":          "original",
+			"kuma_workload": "wl",
+		}))
+	})
+})
