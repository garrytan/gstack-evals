+// countReachableInTx runs the recursive cycle-detection CTE over unionQuery and
+// returns how many times target is reachable from start.
+func countReachableInTx(ctx context.Context, tx *sql.Tx, unionQuery, start, target string) (int, error) {
+	var reachable int
+	//nolint:gosec // G201: unionQuery built from caller-controlled table names
+	err := tx.QueryRowContext(ctx, fmt.Sprintf(`
+		WITH RECURSIVE reachable AS (
+			SELECT ? AS node, 0 AS depth
+			UNION ALL
+			SELECT d.depends_on_id, r.depth + 1
+			FROM reachable r
+			JOIN (%s) d ON d.issue_id = r.node
+			WHERE r.depth < 100
+		)
+		SELECT COUNT(*) FROM reachable WHERE node = ?
+	`, unionQuery), start, target).Scan(&reachable)
+	return reachable, err
+}
+
+// dependencyTableExistsInTx reports whether the given table can be queried.
+func dependencyTableExistsInTx(ctx context.Context, tx *sql.Tx, table string) bool {
+	//nolint:gosec // G201: table is a caller-controlled constant
+	rows, err := tx.QueryContext(ctx, fmt.Sprintf("SELECT 1 FROM %s LIMIT 0", table))
+	if err != nil {
+		return false
+	}
+	_ = rows.Close()
+	return true
+}
