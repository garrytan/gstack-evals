+// ensureIgnoredTables re-creates the dolt_ignore'd wisp tables (wisps,
+// wisp_labels, wisp_dependencies, wisp_events, wisp_comments) if they are
+// missing. Because these tables are ignored by Dolt they live only in the
+// working set, so they are not restored by clones, branch checkouts, or
+// databases whose schema_migrations were backfilled. migrateUp's fast path
+// would otherwise never recreate them. Safe to call repeatedly.
+func ensureIgnoredTables(ctx context.Context, tx *sql.Tx) error {
+	exists := func(table string) bool {
+		rows, err := tx.QueryContext(ctx, "SELECT 1 FROM `"+table+"` LIMIT 0")
+		if err != nil {
+			return false
+		}
+		_ = rows.Close()
+		return true
+	}
+	run := func(name string) error {
+		data, err := upMigrations.ReadFile("schema/" + name)
+		if err != nil {
+			return fmt.Errorf("reading migration %s: %w", name, err)
+		}
+		if q := strings.TrimSpace(string(data)); q != "" {
+			if _, err := tx.ExecContext(ctx, q); err != nil {
+				return fmt.Errorf("migration %s failed: %w", name, err)
+			}
+		}
+		return nil
+	}
+
+	wispsMissing := !exists("wisps")
+	var auxMissing bool
+	for _, t := range []string{"wisp_labels", "wisp_dependencies", "wisp_events", "wisp_comments"} {
+		if !exists(t) {
+			auxMissing = true
+			break
+		}
+	}
+	if !wispsMissing && !auxMissing {
+		return nil
+	}
+	depsMissing := !exists("wisp_dependencies")
+
+	// Make sure the tables are ignored before creating them so they are
+	// never staged/committed.
+	var ignored int
+	if err := tx.QueryRowContext(ctx, "SELECT COUNT(*) FROM dolt_ignore WHERE pattern IN ('wisps', 'wisp_%')").Scan(&ignored); err != nil || ignored < 2 {
+		if err := run("0019_wisps_dolt_ignore.up.sql"); err != nil {
+			return err
+		}
+	}
+
+	if wispsMissing {
+		if err := run("0020_create_wisps.up.sql"); err != nil {
+			return err
+		}
+		// Apply later column additions to the freshly created wisps table.
+		if _, err := tx.ExecContext(ctx, "ALTER TABLE wisps ADD COLUMN no_history TINYINT(1) DEFAULT 0"); err != nil {
+			return fmt.Errorf("adding no_history to wisps: %w", err)
+		}
+	}
+	if auxMissing {
+		if err := run("0021_create_wisp_auxiliary.up.sql"); err != nil {
+			return err
+		}
+	}
+	if depsMissing {
+		if err := run("0022_wisp_dep_type_index.up.sql"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
