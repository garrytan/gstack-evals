+//go:build cgo
+
+package embeddeddolt_test
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/steveyegge/beads/internal/storage/embeddeddolt"
+	"github.com/steveyegge/beads/internal/types"
+)
+
+var wispTables = []string{"wisp_comments", "wisp_events", "wisp_dependencies", "wisp_labels", "wisps"}
+
+func createTwoTasks(t *testing.T, te *testEnv, s *embeddeddolt.EmbeddedDoltStore, prefix string) {
+	t.Helper()
+	for _, id := range []string{prefix + "-a", prefix + "-b"} {
+		iss := &types.Issue{ID: id, Title: id, Status: types.StatusOpen, Priority: 2, IssueType: types.TypeTask}
+		if err := s.CreateIssue(t.Context(), iss, "tester"); err != nil {
+			t.Fatalf("CreateIssue %s: %v", id, err)
+		}
+	}
+}
+
+// TestIgnoredTablesRecreatedOnOpen verifies that dolt_ignore'd wisp tables
+// missing from the working set are recreated when the store is opened.
+func TestIgnoredTablesRecreatedOnOpen(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	te := newTestEnv(t, "ig")
+	ctx := t.Context()
+	createTwoTasks(t, te, te.store, "ig")
+	if err := te.store.Commit(ctx, "issues"); err != nil {
+		t.Fatalf("Commit: %v", err)
+	}
+	if err := te.store.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+
+	for _, tbl := range wispTables {
+		te.exec(t, ctx, "DROP TABLE IF EXISTS "+tbl)
+	}
+
+	store, err := embeddeddolt.New(ctx, filepath.Dir(te.dataDir), "ig", "main")
+	if err != nil {
+		t.Fatalf("reopen: %v", err)
+	}
+	t.Cleanup(func() { store.Close() })
+	te.store = store
+
+	for _, tbl := range wispTables {
+		var n int
+		te.queryScalar(t, ctx, "SELECT COUNT(*) FROM "+tbl, nil, &n)
+	}
+
+	dep := &types.Dependency{IssueID: "ig-b", DependsOnID: "ig-a", Type: types.DepBlocks}
+	if err := store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency: %v", err)
+	}
+	if err := store.DeleteIssue(ctx, "ig-b"); err != nil {
+		t.Fatalf("DeleteIssue: %v", err)
+	}
+}
+
+// TestDependencyOpsTolerateMissingWispDependencies verifies that dependency
+// operations do not fail hard when wisp_dependencies is absent.
+func TestDependencyOpsTolerateMissingWispDependencies(t *testing.T) {
+	skipUnlessEmbeddedDolt(t)
+	te := newTestEnv(t, "mw")
+	ctx := t.Context()
+	createTwoTasks(t, te, te.store, "mw")
+
+	te.exec(t, ctx, "DROP TABLE IF EXISTS wisp_dependencies")
+
+	dep := &types.Dependency{IssueID: "mw-b", DependsOnID: "mw-a", Type: types.DepBlocks}
+	if err := te.store.AddDependency(ctx, dep, "tester"); err != nil {
+		t.Fatalf("AddDependency: %v", err)
+	}
+	if _, err := te.store.GetDependencies(ctx, "mw-b"); err != nil {
+		t.Fatalf("GetDependencies: %v", err)
+	}
+	if _, err := te.store.GetDependents(ctx, "mw-a"); err != nil {
+		t.Fatalf("GetDependents: %v", err)
+	}
+	// Cycle detection must still work using the remaining table.
+	back := &types.Dependency{IssueID: "mw-a", DependsOnID: "mw-b", Type: types.DepBlocks}
+	if err := te.store.AddDependency(ctx, back, "tester"); err == nil {
+		t.Fatal("expected cycle error")
+	}
+}
