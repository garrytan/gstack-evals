diff --git a/pkg/utils/utils.go b/pkg/utils/utils.go
index 72b57f2..f613ae0 100644
--- a/pkg/utils/utils.go
+++ b/pkg/utils/utils.go
@@ -301,8 +301,17 @@ func SanitizeFilePath(path string, safedir string) (string, error) {
 	if normalizedPath != path {
 		return "", errors.New("invalid path")
 	}
-	// check if the path is under the safe directory
-	if !strings.HasPrefix(normalizedPath, safedir) {
+	// check if the path is under the safe directory, enforcing a path
+	// separator boundary so that sibling directories sharing the same
+	// prefix (e.g. /packages-extra vs /packages) are rejected.
+	cleanSafeDir := filepath.Clean(safedir)
+	rel, err := filepath.Rel(cleanSafeDir, normalizedPath)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) ||
+		filepath.IsAbs(rel) {
+		return "", fmt.Errorf("path %s is not under the safe directory %s", normalizedPath, safedir)
+	}
+	if normalizedPath != cleanSafeDir &&
+		!strings.HasPrefix(normalizedPath, strings.TrimSuffix(cleanSafeDir, string(filepath.Separator))+string(filepath.Separator)) {
 		return "", fmt.Errorf("path %s is not under the safe directory %s", normalizedPath, safedir)
 	}
 	return normalizedPath, nil
