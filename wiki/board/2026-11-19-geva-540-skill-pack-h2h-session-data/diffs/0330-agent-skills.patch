diff --git a/src/test/java/io/github/hectorvent/floci/services/eventbridge/EventBridgeResourcesIntegrationTest.java b/src/test/java/io/github/hectorvent/floci/services/eventbridge/EventBridgeResourcesIntegrationTest.java
