+    @Test
+    public void testProcessTextLinesInsertsSpacesForTightWordGaps() {
+        StaticContainers.setIsIgnoreCharactersWithoutUnicode(false);
+        StaticContainers.setIsDataLoader(true);
+        List<IObject> contents = new ArrayList<>();
+        contents.add(new TextChunk(new BoundingBox(0, 10.0, 300.0, 50.0, 310.0), "Evolution", 10, 300.0));
+        contents.add(new TextChunk(new BoundingBox(0, 51.5, 300.0, 61.5, 310.0), "Of", 10, 300.0));
+        contents.add(new TextChunk(new BoundingBox(0, 63.0, 300.0, 93.0, 310.0), "Search", 10, 300.0));
+
+        contents = TextLineProcessor.processTextLines(contents);
+
+        Assertions.assertEquals(1, contents.size());
+        Assertions.assertEquals("Evolution Of Search", ((TextLine) contents.get(0)).getValue());
+    }
