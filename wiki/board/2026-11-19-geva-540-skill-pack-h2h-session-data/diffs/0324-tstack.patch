+package io.github.hectorvent.floci.services.eventbridge;
+
+import io.quarkus.test.junit.QuarkusTest;
+import io.restassured.RestAssured;
+import io.restassured.config.EncoderConfig;
+import io.restassured.http.ContentType;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static io.restassured.RestAssured.given;
+import static org.hamcrest.Matchers.*;
+
+/**
+ * End-to-end: PutEvents with Resources → rule matching on resources → SQS target receives envelope.
+ */
+@QuarkusTest
+class EventBridgeIntegrationTest {
+
+    private static final String EVENTS_CT = "application/x-amz-json-1.1";
+    private static final String SQS_CT = "application/x-amz-json-1.0";
+    private static final String QUEUE_NAME = "eb-resources-test-queue";
+    private static final String QUEUE_ARN = "arn:aws:sqs:us-east-1:000000000000:" + QUEUE_NAME;
+
+    @BeforeAll
+    static void configureRestAssured() {
+        RestAssured.config = RestAssured.config().encoderConfig(
+                EncoderConfig.encoderConfig()
+                        .encodeContentTypeAs(EVENTS_CT, ContentType.TEXT)
+                        .encodeContentTypeAs(SQS_CT, ContentType.TEXT));
+    }
+
+    @Test
+    void resourcesAreMatchedAndForwardedToSqsTarget() {
+        String queueUrl = given()
+                .contentType(SQS_CT)
+                .header("X-Amz-Target", "AmazonSQS.CreateQueue")
+                .body("{\"QueueName\":\"" + QUEUE_NAME + "\"}")
+        .when().post("/")
+        .then().statusCode(200)
+                .extract().jsonPath().getString("QueueUrl");
+
+        events("PutRule", """
+                {"Name":"eb-resources-rule","State":"ENABLED",
+                 "EventPattern":"{\\"resources\\":[\\"custom:resource:1\\"]}"}
+                """);
+        events("PutTargets", """
+                {"Rule":"eb-resources-rule","Targets":[{"Id":"q","Arn":"%s"}]}
+                """.formatted(QUEUE_ARN));
+
+        // Non-matching resources: must not be delivered
+        events("PutEvents", """
+                {"Entries":[{"Source":"my.app","DetailType":"T","Detail":"{\\"n\\":1}",
+                  "Resources":["custom:resource:2"]}]}
+                """);
+        // Matching resources: delivered with resources forwarded
+        events("PutEvents", """
+                {"Entries":[{"Source":"my.app","DetailType":"T","Detail":"{\\"n\\":2}",
+                  "Resources":["custom:resource:1","custom:resource:x"]}]}
+                """);
+
+        String body = given()
+                .contentType(SQS_CT)
+                .header("X-Amz-Target", "AmazonSQS.ReceiveMessage")
+                .body("{\"QueueUrl\":\"" + queueUrl + "\",\"MaxNumberOfMessages\":10}")
+        .when().post("/")
+        .then().statusCode(200)
+                .body("Messages", hasSize(1))
+                .extract().jsonPath().getString("Messages[0].Body");
+
+        io.restassured.path.json.JsonPath msg = new io.restassured.path.json.JsonPath(body);
+        org.hamcrest.MatcherAssert.assertThat(msg.getList("resources"),
+                contains("custom:resource:1", "custom:resource:x"));
+        org.hamcrest.MatcherAssert.assertThat(msg.getInt("detail.n"), equalTo(2));
+    }
+
+    private static void events(String action, String body) {
+        given()
+                .contentType(EVENTS_CT)
+                .header("X-Amz-Target", "AWSEvents." + action)
+                .body(body)
+        .when().post("/")
+        .then().statusCode(200);
+    }
+}
