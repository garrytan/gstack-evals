 	"github.com/tailscale/hujson"
@@ -158,10 +160,100 @@ func (formatTOML) Name() string {
 }
 
 // Unmarshal implements Format.Unmarshal.
+//
+// github.com/BurntSushi/toml is used for decoding as it supports TOML v1.1.0,
+// whereas github.com/pelletier/go-toml/v2 only supports TOML v1.0.0.
 func (formatTOML) Unmarshal(data []byte, value any) error {
-	decoder := toml.NewDecoder(bytes.NewReader(data))
-	decoder.DisallowUnknownFields()
-	return decoder.Decode(value)
+	metadata, err := burntsushitoml.NewDecoder(bytes.NewReader(data)).Decode(value)
+	if err != nil {
+		return err
+	}
+	// Emulate pelletier/go-toml/v2's DisallowUnknownFields. BurntSushi/toml
+	// reports all keys decoded into maps and interfaces as undecoded, so only
+	// consider keys that do not correspond to a field in a struct.
+	var unknownKeys []string
+	valueType := reflect.TypeOf(value)
+	for _, key := range metadata.Undecoded() {
+		if isUnknownTOMLKey(valueType, key) {
+			unknownKeys = append(unknownKeys, key.String())
+		}
+	}
+	if len(unknownKeys) > 0 {
+		return fmt.Errorf("toml: unknown fields: %s", strings.Join(unknownKeys, ", "))
+	}
+	return nil
+}
+
+// isUnknownTOMLKey returns true if key does not correspond to a struct field
+// when decoding into a value of type t.
+func isUnknownTOMLKey(t reflect.Type, key burntsushitoml.Key) bool {
+	for _, piece := range key {
+		t = derefTOMLType(t)
+		switch t.Kind() {
+		case reflect.Struct:
+			fieldType, ok := findTOMLStructField(t, piece)
+			if !ok {
+				return true
+			}
+			t = fieldType
+		case reflect.Map:
+			t = t.Elem()
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+// derefTOMLType removes pointers, arrays, and slices from t, as arrays of
+// tables do not add pieces to TOML keys.
+func derefTOMLType(t reflect.Type) reflect.Type {
+	for {
+		switch t.Kind() {
+		case reflect.Array, reflect.Pointer, reflect.Slice:
+			t = t.Elem()
+		default:
+			return t
+		}
+	}
+}
+
+// findTOMLStructField returns the type of the field in struct type t matching
+// name, using the same rules as github.com/BurntSushi/toml.
+func findTOMLStructField(t reflect.Type, name string) (reflect.Type, bool) {
+	var caseInsensitiveMatch reflect.Type
+	for i := range t.NumField() {
+		field := t.Field(i)
+		if !field.IsExported() && !field.Anonymous {
+			continue
+		}
+		tag := field.Tag.Get("toml")
+		if tag == "-" {
+			continue
+		}
+		fieldName, _, _ := strings.Cut(tag, ",")
+		if field.Anonymous && fieldName == "" {
+			if embeddedType := derefTOMLType(field.Type); embeddedType.Kind() == reflect.Struct {
+				if fieldType, ok := findTOMLStructField(embeddedType, name); ok {
+					return fieldType, true
+				}
+				continue
+			}
+		}
+		if !field.IsExported() {
+			continue
+		}
+		if fieldName == "" {
+			fieldName = field.Name
+		}
+		if fieldName == name {
+			return field.Type, true
+		}
+		if caseInsensitiveMatch == nil && strings.EqualFold(fieldName, name) {
+			caseInsensitiveMatch = field.Type
+		}
+	}
+	return caseInsensitiveMatch, caseInsensitiveMatch != nil
 }
 
 // Name implements Format.Name.
