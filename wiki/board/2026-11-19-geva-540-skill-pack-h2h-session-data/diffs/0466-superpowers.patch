+
+func TestFormatTOMLV1_1(t *testing.T) {
+	data := []byte(`
+inline = {
+    a = "\e\x41",
+    b = 1,
+}
+time = 07:32
+`)
+	var actual map[string]any
+	assert.NoError(t, FormatTOML.Unmarshal(data, &actual))
+	assert.Equal(t, map[string]any{
+		"a": "\x1bA",
+		"b": int64(1),
+	}, actual["inline"].(map[string]any))
+}
+
+func TestFormatTOMLUnknownFields(t *testing.T) {
+	type Inner struct {
+		Known string `toml:"known"`
+	}
+	type Embedded struct {
+		Embedded string
+	}
+	type T struct {
+		Embedded
+		Inner  Inner
+		Inners []Inner
+		Map    map[string]any
+		Any    any
+	}
+	for _, tc := range []struct {
+		name        string
+		data        string
+		expectedErr string
+	}{
+		{name: "known", data: "embedded = \"x\"\n[inner]\nknown = \"x\"\n[[inners]]\nknown = \"x\"\n[map.a]\nb = 1\n[any]\nc = 1\n"},
+		{name: "unknown_top_level", data: "unknown = 1\n", expectedErr: "toml: unknown fields: unknown"},
+		{name: "unknown_nested", data: "[inner]\nunknown = 1\n", expectedErr: "toml: unknown fields: inner.unknown"},
+		{name: "unknown_array_of_tables", data: "[[inners]]\nunknown = 1\n", expectedErr: "toml: unknown fields: inners.unknown"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var actual T
+			err := FormatTOML.Unmarshal([]byte(tc.data), &actual)
+			if tc.expectedErr != "" {
+				assert.EqualError(t, err, tc.expectedErr)
+			} else {
+				assert.NoError(t, err)
+			}
+		})
+	}
+}
