+func TestDeadlineBody(t *testing.T) {
+	t.Run("body read before the deadline", func(t *testing.T) {
+		body := newDeadlineBody(io.NopCloser(strings.NewReader("hello")), time.Second)
+		t.Cleanup(func() { _ = body.Close() })
+
+		content, err := io.ReadAll(body)
+		require.NoError(t, err)
+		assert.Equal(t, "hello", string(content))
+	})
+
+	t.Run("stalled body is unblocked at the deadline", func(t *testing.T) {
+		reader, writer := io.Pipe()
+		t.Cleanup(func() { _ = writer.Close() })
+
+		body := newDeadlineBody(reader, 100*time.Millisecond)
+		t.Cleanup(func() { _ = body.Close() })
+
+		start := time.Now()
+		_, err := io.ReadAll(body)
+		assert.ErrorIs(t, err, os.ErrDeadlineExceeded)
+		assert.Less(t, time.Since(start), 2*time.Second)
+	})
+}
