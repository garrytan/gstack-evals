+// withReadTimeout enforces the respondingTimeouts.readTimeout on HTTP/3 requests.
+// On TCP, the read timeout is applied as a deadline on the connection,
+// which does not exist for QUIC streams, so it has to be enforced on the request body.
+func withReadTimeout(next http.Handler, timeout time.Duration) http.Handler {
+	if timeout <= 0 {
+		return next
+	}
+
+	return http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {
+		if req.Body != nil && req.Body != http.NoBody {
+			body := newDeadlineBody(req.Body, timeout)
+			defer body.stop()
+
+			req.Body = body
+		}
+
+		next.ServeHTTP(rw, req)
+	})
+}
+
+// deadlineBody is a request body which fails reads with os.ErrDeadlineExceeded once the timeout has elapsed.
+// On expiry, the underlying body is closed, which cancels the QUIC stream read and unblocks any pending Read.
+type deadlineBody struct {
+	io.ReadCloser
+
+	timer    *time.Timer
+	timedOut atomic.Bool
+}
+
+func newDeadlineBody(body io.ReadCloser, timeout time.Duration) *deadlineBody {
+	b := &deadlineBody{ReadCloser: body}
+	b.timer = time.AfterFunc(timeout, func() {
+		b.timedOut.Store(true)
+		_ = b.ReadCloser.Close()
+	})
+
+	return b
+}
+
+func (b *deadlineBody) Read(p []byte) (int, error) {
+	if b.timedOut.Load() {
+		return 0, os.ErrDeadlineExceeded
+	}
+
+	n, err := b.ReadCloser.Read(p)
+	if err != nil && b.timedOut.Load() {
+		return n, os.ErrDeadlineExceeded
+	}
+
+	if errors.Is(err, io.EOF) {
+		// The whole body has been read, the deadline does not apply anymore.
+		b.stop()
+	}
+
+	return n, err
+}
+
+func (b *deadlineBody) Close() error {
+	b.stop()
+	return b.ReadCloser.Close()
+}
+
+func (b *deadlineBody) stop() {
+	b.timer.Stop()
+}
