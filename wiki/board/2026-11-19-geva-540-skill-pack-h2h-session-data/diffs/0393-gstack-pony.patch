+
+func TestFromLogEvent_GroupedFragmentsMatchAsString(t *testing.T) {
+	notificationLog := FromLogEvent(container.LogEvent{
+		Type: container.LogTypeGroup,
+		Message: []container.LogFragment{
+			{Message: "INFO lote de 1000 registros (Total: 710000)"},
+			{Message: "\x1b[32mINFO\x1b[0m lote de 1000 registros (Total: 711000)"},
+		},
+	})
+
+	assert.Equal(t, "INFO lote de 1000 registros (Total: 710000)\nINFO lote de 1000 registros (Total: 711000)", notificationLog.Message)
+
+	program, err := expr.Compile(`message contains "registros"`, expr.Env(types.NotificationLog{}), expr.AsBool())
+	require.NoError(t, err)
+	assert.True(t, (&Subscription{LogProgram: program}).MatchesLog(notificationLog))
+}
