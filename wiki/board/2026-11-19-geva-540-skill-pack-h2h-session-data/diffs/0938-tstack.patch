diff --git a/cipher/cbc_hmac_empty_test.go b/cipher/cbc_hmac_empty_test.go
new file mode 100644
index 0000000..d0ca63b
--- /dev/null
+++ b/cipher/cbc_hmac_empty_test.go
@@ -0,0 +1,33 @@
+package josecipher
+
+import (
+	"crypto/aes"
+	"testing"
+)
+
+func TestOpenEmptyCiphertextNoPanic(t *testing.T) {
+	key := make([]byte, 32)
+	aead, err := NewCBCHMAC(key, aes.NewCipher)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := aead.(*cbcAEAD)
+	nonce := make([]byte, 16)
+	// Valid tag over an empty ciphertext body.
+	tag := ctx.computeAuthTag(nil, nonce, nil)
+	if _, err := aead.Open(nil, nonce, tag, nil); err == nil {
+		t.Error("expected error for empty ciphertext")
+	}
+	// Wrong nonce size with valid tag.
+	badNonce := make([]byte, 3)
+	ct := append(make([]byte, 16), ctx.computeAuthTag(nil, badNonce, make([]byte, 16))...)
+	if _, err := aead.Open(nil, badNonce, ct, nil); err == nil {
+		t.Error("expected error for bad nonce size")
+	}
+}
+
+func TestUnpadEmptyBuffer(t *testing.T) {
+	if _, err := unpadBuffer([]byte{}, 16); err == nil {
+		t.Error("expected error")
+	}
+}
