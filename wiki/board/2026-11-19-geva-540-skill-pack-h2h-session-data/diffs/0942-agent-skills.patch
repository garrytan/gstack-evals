+package openapi3filter_test
+
+import (
+	"bytes"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestArrayItemsNil(t *testing.T) {
+	const spec = `
+openapi: 3.1.0
+info: {title: t, version: 1.0.0}
+paths:
+  /f:
+    post:
+      requestBody:
+        required: true
+        content:
+          application/x-www-form-urlencoded:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /upload:
+    post:
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /hdr:
+    get:
+      responses:
+        '200':
+          description: ok
+          headers:
+            X-Tags:
+              schema: {type: array}
+  /p/{ids}:
+    get:
+      parameters:
+        - name: ids
+          in: path
+          required: true
+          schema: {type: array}
+        - name: q
+          in: query
+          schema: {type: array}
+        - name: deep
+          in: query
+          style: deepObject
+          explode: true
+          schema:
+            type: object
+            properties:
+              arr: {type: array}
+      responses:
+        '200': {description: ok}
+`
+	loader := openapi3.NewLoader()
+	doc, err := loader.LoadFromData([]byte(spec))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(loader.Context))
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+
+	opts := &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc}
+	validate := func(t *testing.T, req *http.Request) error {
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+		return openapi3filter.ValidateRequest(loader.Context, &openapi3filter.RequestValidationInput{
+			Request: req, PathParams: pathParams, Route: route, Options: opts,
+		})
+	}
+
+	t.Run("urlencoded", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodPost, "/f", strings.NewReader("tags=a"))
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+		require.NotPanics(t, func() { require.Error(t, validate(t, req)) })
+	})
+
+	t.Run("multipart", func(t *testing.T) {
+		var buf bytes.Buffer
+		w := multipart.NewWriter(&buf)
+		require.NoError(t, w.WriteField("tags", "a"))
+		require.NoError(t, w.Close())
+		req, _ := http.NewRequest(http.MethodPost, "/upload", &buf)
+		req.Header.Set("Content-Type", w.FormDataContentType())
+		require.NotPanics(t, func() { require.Error(t, validate(t, req)) })
+	})
+
+	t.Run("path and query params", func(t *testing.T) {
+		for _, u := range []string{"/p/1,2", "/p/1?q=a,b", "/p/1?deep[arr][0]=a"} {
+			req, _ := http.NewRequest(http.MethodGet, u, nil)
+			require.NotPanics(t, func() { require.Error(t, validate(t, req)) }, u)
+		}
+	})
+
+	t.Run("response header", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/hdr", nil)
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+		require.NotPanics(t, func() {
+			err := openapi3filter.ValidateResponse(loader.Context, &openapi3filter.ResponseValidationInput{
+				RequestValidationInput: &openapi3filter.RequestValidationInput{
+					Request: req, PathParams: pathParams, Route: route, Options: opts,
+				},
+				Status: http.StatusOK,
+				Header: http.Header{"X-Tags": []string{"a,b"}},
+				Body:   io.NopCloser(strings.NewReader("")),
+			})
+			require.Error(t, err)
+		})
+	})
+}
