@@ -0,0 +1,61 @@
+package openapi3
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCircularXOfVisitJSONDoesNotOverflow(t *testing.T) {
+	ctx := context.Background()
+	for _, combinator := range []string{"allOf", "anyOf", "oneOf", "not", "only-allOf", "items"} {
+		t.Run(combinator, func(t *testing.T) {
+			s := &Schema{}
+			if combinator != "only-allOf" && combinator != "items" {
+				s.Type = &Types{"object"}
+				s.Properties = Schemas{"name": {Value: &Schema{Type: &Types{"string"}}}}
+			}
+			ref := SchemaRefs{{Value: s}}
+			switch combinator {
+			case "allOf", "only-allOf":
+				s.AllOf = ref
+			case "anyOf":
+				s.AnyOf = ref
+			case "oneOf":
+				s.OneOf = ref
+			case "not":
+				s.Not = ref[0]
+			case "items":
+				s.Items = ref[0]
+			}
+			require.NoError(t, s.Validate(ctx))
+			_ = s.IsEmpty()
+			for _, opts := range [][]SchemaValidationOption{nil, {VisitAsRequest()}, {VisitAsResponse()}, {MultiErrors()}} {
+				_ = s.VisitJSON(map[string]any{"name": "test"}, opts...)
+				_ = s.VisitJSON(nil, opts...)
+				_ = s.VisitJSON([]any{[]any{}}, opts...)
+			}
+		})
+	}
+}
+
+func TestCircularIndirectAllOfVisitJSON(t *testing.T) {
+	a := &Schema{Type: &Types{"object"}, Required: []string{"name"}}
+	b := &Schema{AllOf: SchemaRefs{{Ref: "#/components/schemas/A", Value: a}}}
+	a.AllOf = SchemaRefs{{Ref: "#/components/schemas/B", Value: b}}
+	require.NoError(t, a.VisitJSON(map[string]any{"name": "x"}))
+	require.Error(t, a.VisitJSON(map[string]any{}))
+	require.Error(t, b.VisitJSON("not an object"))
+}
+
+func TestRecursivePropertiesStillValidated(t *testing.T) {
+	// Legitimate recursive data structure: the same schema applies at each nesting level.
+	node := &Schema{Type: &Types{"object"}}
+	node.Properties = Schemas{
+		"value": {Value: &Schema{Type: &Types{"integer"}}},
+		"next":  {Value: &Schema{AllOf: SchemaRefs{{Value: node}}}},
+	}
+	require.NoError(t, node.VisitJSON(map[string]any{"value": 1.0, "next": map[string]any{"value": 2.0, "next": map[string]any{"value": 3.0}}}))
+	require.Error(t, node.VisitJSON(map[string]any{"value": 1.0, "next": map[string]any{"value": 2.0, "next": map[string]any{"value": "bad"}}}))
+}
