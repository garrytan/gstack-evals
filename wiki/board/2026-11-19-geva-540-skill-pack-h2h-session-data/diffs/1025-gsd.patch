+package openapi3filter
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestCircularXOfRequestValidationDoesNotOverflow(t *testing.T) {
+	for _, combinator := range []string{"allOf", "anyOf", "oneOf"} {
+		for _, typ := range []string{"type: object", "type: string", ""} {
+			t.Run(combinator+"/"+typ, func(t *testing.T) {
+				spec := `
+openapi: '3.0.0'
+info: { title: Circular, version: '1.0' }
+paths:
+  /test:
+    get:
+      parameters:
+        - name: data
+          in: query
+          schema: { $ref: '#/components/schemas/Recursive' }
+        - name: arr
+          in: query
+          schema:
+            type: array
+            items: { $ref: '#/components/schemas/Recursive' }
+        - name: obj
+          in: query
+          style: deepObject
+          explode: true
+          schema:
+            type: object
+            properties:
+              p: { $ref: '#/components/schemas/Recursive' }
+      responses: { '200': { description: OK } }
+    post:
+      requestBody:
+        content:
+          application/x-www-form-urlencoded:
+            schema: { $ref: '#/components/schemas/Recursive' }
+      responses: { '200': { description: OK } }
+components:
+  schemas:
+    Recursive:
+      ` + typ + `
+      ` + combinator + `:
+        - $ref: '#/components/schemas/Recursive'
+      properties:
+        name: { type: string }
+`
+				loader := openapi3.NewLoader()
+				doc, err := loader.LoadFromData([]byte(spec))
+				require.NoError(t, err)
+				require.NoError(t, doc.Validate(loader.Context))
+				router, err := gorillamux.NewRouter(doc)
+				require.NoError(t, err)
+
+				for _, req := range []*http.Request{
+					mustReq(t, http.MethodGet, "/test?data=x", ""),
+					mustReq(t, http.MethodGet, "/test?arr=x,y", ""),
+					mustReq(t, http.MethodGet, "/test?obj[p]=x&obj[p][name]=y", ""),
+					mustReq(t, http.MethodPost, "/test", url.Values{"name": {"x"}}.Encode()),
+				} {
+					route, pathParams, err := router.FindRoute(req)
+					require.NoError(t, err)
+					_ = ValidateRequest(context.Background(), &RequestValidationInput{
+						Request: req, PathParams: pathParams, Route: route,
+					})
+				}
+			})
+		}
+	}
+}
+
+func mustReq(t *testing.T, method, target, body string) *http.Request {
+	req, err := http.NewRequest(method, "http://example.com"+target, strings.NewReader(body))
+	require.NoError(t, err)
+	if body != "" {
+		req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	}
+	return req
+}
