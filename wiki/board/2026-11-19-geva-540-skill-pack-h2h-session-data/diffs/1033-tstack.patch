+func TestMetricsMethodLabelBounded(t *testing.T) {
+	y := newTestServer(t, &mockDB{}, 1, false)
+	h := y.HTTPHandler()
+
+	for _, m := range []string{"M1", "M2", "M3", "FOO", "get"} {
+		req, err := http.NewRequest(m, "/", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		h.ServeHTTP(httptest.NewRecorder(), req)
+	}
+
+	n, err := testutil.GatherAndCount(y.Registry, "yopass_http_requests_total", "yopass_http_request_duration_seconds")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 2 {
+		t.Fatalf("Expected arbitrary methods to collapse into a single series per metric; got %d series", n)
+	}
+
+	families, err := y.Registry.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range families {
+		if !strings.HasPrefix(f.GetName(), "yopass_http_") {
+			continue
+		}
+		for _, m := range f.GetMetric() {
+			for _, l := range m.GetLabel() {
+				if l.GetName() == "method" && l.GetValue() != "other" {
+					t.Fatalf("Expected method label %q; got %q", "other", l.GetValue())
+				}
+			}
+		}
+	}
+}
