@@ -0,0 +1,22 @@
+import { tick } from 'svelte';
+import { test } from '../../test';
+
+export default test({
+	async test({ assert, target }) {
+		const input = /** @type {HTMLInputElement} */ (target.querySelector('input'));
+		const div = /** @type {HTMLDivElement} */ (target.querySelector('div'));
+		input.focus();
+
+		input.value = 'value1';
+		input.dispatchEvent(new Event('input', { bubbles: true }));
+		await tick();
+		assert.equal(div.textContent, 'value1');
+		assert.equal(input.value, 'value1');
+
+		input.value = 'value12';
+		input.dispatchEvent(new Event('input', { bubbles: true }));
+		await tick();
+		assert.equal(div.textContent, 'value12');
+		assert.equal(input.value, 'value12');
+	}
+});
