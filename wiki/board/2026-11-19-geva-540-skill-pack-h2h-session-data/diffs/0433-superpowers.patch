diff --git a/pkg/workflow/engine_version_expression_test.go b/pkg/workflow/engine_version_expression_test.go
new file mode 100644
index 0000000..d9cf60a
--- /dev/null
+++ b/pkg/workflow/engine_version_expression_test.go
@@ -0,0 +1,120 @@
+//go:build !integration
+
+package workflow
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/github/gh-aw/pkg/testutil"
+)
+
+// TestEngineVersionExpressionInstallSteps verifies that an engine.version given as a
+// GitHub Actions expression is passed to install steps via an env var, never inlined
+// into the shell command (which would allow shell injection).
+func TestEngineVersionExpressionInstallSteps(t *testing.T) {
+	const expr = "${{ inputs.engine-version }}"
+
+	tests := []struct {
+		name        string
+		steps       []GitHubActionStep
+		expectedRun string
+	}{
+		{
+			name:        "npm install",
+			steps:       GenerateNpmInstallSteps("@anthropic-ai/claude-code", expr, "Install Claude Code CLI", "claude", false),
+			expectedRun: `run: npm install -g @anthropic-ai/claude-code@"${ENGINE_VERSION}"`,
+		},
+		{
+			name:        "copilot installer",
+			steps:       GenerateCopilotInstallerSteps(expr, "Install GitHub Copilot CLI"),
+			expectedRun: `run: ${RUNNER_TEMP}/gh-aw/actions/install_copilot_cli.sh "${ENGINE_VERSION}"`,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if len(tt.steps) != 1 {
+				t.Fatalf("expected 1 step, got %d", len(tt.steps))
+			}
+			content := strings.Join(tt.steps[0], "\n")
+			if !strings.Contains(content, tt.expectedRun) {
+				t.Errorf("expected run line %q in:\n%s", tt.expectedRun, content)
+			}
+			if !strings.Contains(content, `ENGINE_VERSION: "`+expr+`"`) {
+				t.Errorf("expected ENGINE_VERSION env var with expression in:\n%s", content)
+			}
+			for _, line := range tt.steps[0] {
+				if strings.Contains(line, "run:") && strings.Contains(line, "${{") {
+					t.Errorf("expression must not appear in run line: %s", line)
+				}
+			}
+		})
+	}
+}
+
+// TestEngineVersionLiteralInstallSteps verifies literal versions are unchanged (backward compatible).
+func TestEngineVersionLiteralInstallSteps(t *testing.T) {
+	npm := strings.Join(GenerateNpmInstallSteps("@openai/codex", "1.2.3", "Install Codex CLI", "codex", false)[0], "\n")
+	if !strings.Contains(npm, "run: npm install -g @openai/codex@1.2.3") || strings.Contains(npm, "ENGINE_VERSION") {
+		t.Errorf("unexpected npm step for literal version:\n%s", npm)
+	}
+	cp := strings.Join(GenerateCopilotInstallerSteps("1.2.3", "Install GitHub Copilot CLI")[0], "\n")
+	if !strings.Contains(cp, "install_copilot_cli.sh 1.2.3") || strings.Contains(cp, "ENGINE_VERSION") {
+		t.Errorf("unexpected copilot step for literal version:\n%s", cp)
+	}
+}
+
+// TestEngineVersionExpressionCompile compiles a workflow_call workflow for each engine
+// with an expression-valued engine.version and checks the lock file output.
+func TestEngineVersionExpressionCompile(t *testing.T) {
+	for _, engine := range []string{"copilot", "claude", "codex", "gemini"} {
+		t.Run(engine, func(t *testing.T) {
+			tempDir := testutil.TempDir(t, "test-*")
+			workflowsDir := filepath.Join(tempDir, ".github", "workflows")
+			if err := os.MkdirAll(workflowsDir, 0755); err != nil {
+				t.Fatal(err)
+			}
+			md := `---
+on:
+  workflow_call:
+    inputs:
+      engine-version:
+        type: string
+        default: "1.0.0"
+engine:
+  id: ` + engine + `
+  version: ${{ inputs.engine-version }}
+permissions:
+  contents: read
+---
+Hello
+`
+			workflowPath := filepath.Join(workflowsDir, "test.md")
+			if err := os.WriteFile(workflowPath, []byte(md), 0644); err != nil {
+				t.Fatal(err)
+			}
+			if err := NewCompiler().CompileWorkflow(workflowPath); err != nil {
+				t.Fatalf("compile failed: %v", err)
+			}
+			lock, err := os.ReadFile(filepath.Join(workflowsDir, "test.lock.yml"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			lockStr := string(lock)
+			if !strings.Contains(lockStr, `ENGINE_VERSION: "${{ inputs.engine-version }}"`) {
+				t.Errorf("expected ENGINE_VERSION env var in lock file")
+			}
+			if !strings.Contains(lockStr, `"${ENGINE_VERSION}"`) {
+				t.Errorf("expected install command to reference ${ENGINE_VERSION}")
+			}
+			for _, line := range strings.Split(lockStr, "\n") {
+				if strings.Contains(line, "run:") && strings.Contains(line, "inputs.engine-version") {
+					t.Errorf("expression interpolated into run line: %s", line)
+				}
+			}
+		})
+	}
+}
