+package org.opendataloader.pdf.hybrid;
+
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.verapdf.wcag.algorithms.entities.IObject;
+import org.verapdf.wcag.algorithms.entities.SemanticParagraph;
+import org.verapdf.wcag.algorithms.entities.content.TextChunk;
+import org.verapdf.wcag.algorithms.entities.content.TextLine;
+import org.verapdf.wcag.algorithms.entities.geometry.BoundingBox;
+import org.verapdf.wcag.algorithms.semanticalgorithms.containers.StaticContainers;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+public class BackendTextSpaceRestorerTest {
+
+    @Test
+    public void restoresSpacesInConcatenatedText() {
+        List<String> reference = Arrays.asList(
+            "Traditional search relies on keyword matching, retrieving exact keywords or phrases entered by the user, but often yields",
+            "irrelevant results if the keywords are not precise, lacking context and intent understanding.");
+        String backend = "Traditionalsearchreliesonkeywordmatching,retrievingexactkeywordsorphrasesenteredbytheuser,butoftenyields "
+            + "irrelevantresultsifthekeywordsarenotprecise,lackingcontextandintentunderstanding.";
+        Assertions.assertEquals(
+            "Traditional search relies on keyword matching, retrieving exact keywords or phrases entered by the user, but often yields "
+                + "irrelevant results if the keywords are not precise, lacking context and intent understanding.",
+            BackendTextSpaceRestorer.restoreSpaces(backend, reference));
+    }
+
+    @Test
+    public void restoresSpacesAcrossMergedLines() {
+        List<String> reference = Arrays.asList("Evolution Of Search", "Lexical Search:");
+        Assertions.assertEquals("Evolution Of Search Lexical Search:",
+            BackendTextSpaceRestorer.restoreSpaces("EvolutionOfSearch LexicalSearch:", reference));
+    }
+
+    @Test
+    public void keepsTextWithCorrectSpacesUnchanged() {
+        String text = "Lorem ipsum dolor sit amet";
+        Assertions.assertSame(text,
+            BackendTextSpaceRestorer.restoreSpaces(text, Collections.singletonList("Lorem ipsum dolor sit amet")));
+    }
+
+    @Test
+    public void doesNotSplitInsideWords() {
+        // "ab" occurs in the reference only across "a band", which does not end on a word boundary.
+        Assertions.assertEquals("ab",
+            BackendTextSpaceRestorer.restoreSpaces("ab", Collections.singletonList("a band")));
+        Assertions.assertEquals("other wise",
+            BackendTextSpaceRestorer.restoreSpaces("otherwise", Collections.singletonList("other wise")));
+    }
+
+    @Test
+    public void ignoresUnmatchedTokens() {
+        Assertions.assertEquals("Completelydifferent",
+            BackendTextSpaceRestorer.restoreSpaces("Completelydifferent", Collections.singletonList("Other words here")));
+    }
+
+    @Test
+    public void ignoresLetterSpacedReference() {
+        Assertions.assertEquals("HELLO",
+            BackendTextSpaceRestorer.restoreSpaces("HELLO", Collections.singletonList("H E L L O")));
+    }
+
+    @Test
+    public void doesNotSplitHyphenatedLineEnd() {
+        Assertions.assertEquals("under-standing",
+            BackendTextSpaceRestorer.restoreSpaces("under-standing", Arrays.asList("under-", "standing")));
+    }
+
+    @Test
+    public void restoresSpacesInBackendParagraphUsingJavaChunks() {
+        StaticContainers.setIsIgnoreCharactersWithoutUnicode(false);
+        StaticContainers.setIsDataLoader(true);
+
+        List<IObject> javaContents = new ArrayList<>();
+        double x = 72;
+        for (String word : new String[]{"Traditional", "search", "relies", "on", "keywords"}) {
+            double width = word.length() * 5.0;
+            javaContents.add(new TextChunk(new BoundingBox(0, x, 700, x + width, 711), word, 11, 702));
+            x += width + 3.0;
+        }
+
+        TextChunk backendChunk = new TextChunk(new BoundingBox(0, 70, 698, 400, 712),
+            "Traditionalsearchreliesonkeywords", 12, 12);
+        backendChunk.adjustSymbolEndsToBoundingBox(null);
+        SemanticParagraph paragraph = new SemanticParagraph();
+        paragraph.add(new TextLine(backendChunk));
+        List<IObject> backendContents = new ArrayList<>(Collections.singletonList(paragraph));
+
+        BackendTextSpaceRestorer.restoreSpaces(backendContents, javaContents);
+
+        Assertions.assertEquals("Traditional search relies on keywords", paragraph.getValue());
+    }
+}
