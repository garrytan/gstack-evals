+
+// existingTablesInTx returns the subset of tables that exist and are
+// queryable within tx, preserving order.
+//
+//nolint:gosec // G201: table names are caller-controlled constants
+func existingTablesInTx(ctx context.Context, tx *sql.Tx, tables []string) []string {
+	var out []string
+	for _, t := range tables {
+		rows, err := tx.QueryContext(ctx, fmt.Sprintf("SELECT 1 FROM %s LIMIT 0", t))
+		if err != nil {
+			if isTableNotExistError(err) {
+				continue
+			}
+			// Unknown error: keep the table so the real query surfaces it.
+			out = append(out, t)
+			continue
+		}
+		_ = rows.Close()
+		out = append(out, t)
+	}
+	return out
+}
