diff --git a/src/paths.ts b/src/paths.ts
new file mode 100644
index 0000000..e00c620
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,69 @@
+import { existsSync, realpathSync } from 'fs';
+import { basename, isAbsolute, relative, resolve, sep, win32, posix } from 'path';
+
+// Path confinement for caller-supplied (i.e. untrusted MCP argument) paths.
+// Everything browse-mcp writes on behalf of a tool call must stay under a
+// fixed data root (relocatable via BROWSE_MCP_HOME), never at an arbitrary
+// location chosen by the caller.
+
+function isInside(root: string, target: string): boolean {
+  const rel = relative(root, target);
+  return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));
+}
+
+// Deepest existing ancestor, resolved through symlinks, with the
+// not-yet-existing tail re-appended.
+function realish(p: string): string {
+  let cur = p;
+  const tail: string[] = [];
+  while (!existsSync(cur)) {
+    const parent = resolve(cur, '..');
+    if (parent === cur) break;
+    tail.unshift(basename(cur));
+    cur = parent;
+  }
+  let real = cur;
+  try {
+    real = realpathSync(cur);
+  } catch {
+    /* keep lexical */
+  }
+  return tail.length ? resolve(real, ...tail) : real;
+}
+
+/**
+ * Resolve `sub` (relative) under `root`. Rejects absolute paths (POSIX,
+ * Windows drive, or UNC) and anything that escapes the root lexically or via
+ * an existing symlink. Returns the absolute lexical path.
+ */
+export function confinePath(root: string, sub: string | undefined, label = 'path'): string {
+  const absRoot = resolve(root);
+  if (sub === undefined || sub === null || sub === '') return absRoot;
+  if (typeof sub !== 'string') throw new Error(`${label} must be a string`);
+  if (sub.includes('\0')) throw new Error(`${label} contains a NUL byte`);
+  if (posix.isAbsolute(sub) || win32.isAbsolute(sub) || /^[A-Za-z]:/.test(sub)) {
+    throw new Error(
+      `${label} must be relative to ${absRoot}; absolute paths are not allowed (got ${JSON.stringify(sub)})`,
+    );
+  }
+  // Treat both separators as separators so "a\..\..\x" can't slip by on POSIX.
+  const normalized = sub.split(/[\\/]+/).join(sep);
+  const target = resolve(absRoot, normalized);
+  if (!isInside(absRoot, target)) {
+    throw new Error(`${label} ${JSON.stringify(sub)} would escape ${absRoot}`);
+  }
+  if (!isInside(realish(absRoot), realish(target))) {
+    throw new Error(`${label} ${JSON.stringify(sub)} would escape ${absRoot} via a symlink`);
+  }
+  return target;
+}
+
+/** Reduce an untrusted filename to a bare basename; fall back when unusable. */
+export function safeBasename(name: string | undefined | null, fallback: string): string {
+  const raw = String(name ?? '').replace(/\0/g, '');
+  if (/[\\/]$/.test(raw)) return fallback;
+  const parts = raw.split(/[\\/]+/);
+  const b = (parts[parts.length - 1] ?? '').trim();
+  if (!b || b === '.' || b === '..' || /^[A-Za-z]:$/.test(b)) return fallback;
+  return b;
+}
