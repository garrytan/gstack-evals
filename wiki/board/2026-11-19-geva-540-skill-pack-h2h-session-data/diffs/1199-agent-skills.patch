@@ -0,0 +1,60 @@
+import { describe, it, expect, beforeAll, afterAll } from 'vitest';
+import { createServer, type Server } from 'http';
+import { mkdtempSync, existsSync, readdirSync } from 'fs';
+import { tmpdir } from 'os';
+import { join, dirname } from 'path';
+import { fetchFallback } from '../src/download.js';
+
+let server: Server;
+let base = '';
+
+beforeAll(async () => {
+  server = createServer((req, res) => {
+    if (req.url === '/redirect') {
+      res.writeHead(302, { location: 'http://blocked.invalid/payload.sh' });
+      return res.end();
+    }
+    if (req.url === '/redirect-local') {
+      res.writeHead(302, { location: '/..%2F..%2Fevil.sh' });
+      return res.end();
+    }
+    res.writeHead(200, { 'content-type': 'text/plain' });
+    res.end('payload');
+  });
+  await new Promise<void>((r) => server.listen(0, '127.0.0.1', () => r()));
+  const addr = server.address() as { port: number };
+  base = `http://127.0.0.1:${addr.port}`;
+});
+
+afterAll(() => new Promise<void>((r) => server.close(() => r())));
+
+describe('fetchFallback', () => {
+  it('refuses URLs outside the origin fence', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'bmcp-dl-'));
+    await expect(
+      fetchFallback(`${base}/a.txt`, dir, { allowed: ['example.com'], blocked: [] }),
+    ).rejects.toThrow(/origin fence/i);
+    expect(readdirSync(dir)).toEqual([]);
+  });
+
+  it('refuses redirects that leave the origin fence', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'bmcp-dl-'));
+    await expect(
+      fetchFallback(`${base}/redirect`, dir, { allowed: ['127.0.0.1'], blocked: [] }),
+    ).rejects.toThrow(/origin fence/i);
+    expect(readdirSync(dir)).toEqual([]);
+  });
+
+  it('writes allowed fetches inside the target dir only', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'bmcp-dl-'));
+    const r = await fetchFallback(`${base}/a.txt`, dir, { allowed: ['127.0.0.1'], blocked: [] });
+    expect(dirname(r.path)).toBe(dir);
+    expect(existsSync(r.path)).toBe(true);
+  });
+
+  it('keeps encoded traversal in the URL path inside the target dir', async () => {
+    const dir = mkdtempSync(join(tmpdir(), 'bmcp-dl-'));
+    const r = await fetchFallback(`${base}/redirect-local`, dir, { allowed: [], blocked: [] });
+    expect(dirname(r.path)).toBe(dir);
+  });
+});
diff --git a/test/paths.test.ts b/test/paths.test.ts
new file mode 100644
index 0000000..50eb559
--- /dev/null
+++ b/test/paths.test.ts
@@ -0,0 +1,98 @@
+import { describe, it, expect } from 'vitest';
+import { join, resolve, sep } from 'path';
+import { mkdtempSync, symlinkSync, mkdirSync } from 'fs';
+import { tmpdir } from 'os';
+import { confinePath, safeBasename } from '../src/paths.js';
+import { resolveDownloadDir, DOWNLOAD_DIR } from '../src/download.js';
+import { resolveStatePath, STATE_DIR } from '../src/state.js';
+
+describe('confinePath', () => {
+  const root = resolve(tmpdir(), 'bmcp-root');
+
+  it('returns the root when no sub-path is given', () => {
+    expect(confinePath(root, undefined)).toBe(root);
+    expect(confinePath(root, '')).toBe(root);
+  });
+
+  it('resolves relative sub-paths inside the root', () => {
+    expect(confinePath(root, 'a/b')).toBe(join(root, 'a', 'b'));
+  });
+
+  it('rejects absolute paths', () => {
+    expect(() => confinePath(root, '/etc')).toThrow(/absolute/i);
+    expect(() => confinePath(root, 'C:\\Windows')).toThrow(/absolute/i);
+    expect(() => confinePath(root, '\\\\server\\share')).toThrow(/absolute/i);
+  });
+
+  it('rejects .. escapes', () => {
+    expect(() => confinePath(root, '..')).toThrow(/escape/i);
+    expect(() => confinePath(root, '../x')).toThrow(/escape/i);
+    expect(() => confinePath(root, 'a/../../x')).toThrow(/escape/i);
+    expect(() => confinePath(root, 'a\\..\\..\\x')).toThrow(/escape/i);
+  });
+
+  it('rejects an existing symlink inside the root that points outside', () => {
+    const r = mkdtempSync(join(tmpdir(), 'bmcp-sym-'));
+    const outside = mkdtempSync(join(tmpdir(), 'bmcp-out-'));
+    mkdirSync(join(r, 'ok'));
+    symlinkSync(outside, join(r, 'link'));
+    expect(confinePath(r, 'ok')).toBe(join(r, 'ok'));
+    expect(() => confinePath(r, 'link')).toThrow(/escape/i);
+    expect(() => confinePath(r, 'link/deeper')).toThrow(/escape/i);
+  });
+});
+
+describe('safeBasename', () => {
+  it('strips directory components', () => {
+    expect(safeBasename('../../.bashrc', 'x')).toBe('.bashrc');
+    expect(safeBasename('/etc/cron.d/evil', 'x')).toBe('evil');
+    expect(safeBasename('..\\..\\evil.bat', 'x')).toBe('evil.bat');
+  });
+
+  it('falls back for empty or dot names', () => {
+    expect(safeBasename('', 'download.bin')).toBe('download.bin');
+    expect(safeBasename('..', 'download.bin')).toBe('download.bin');
+    expect(safeBasename('.', 'download.bin')).toBe('download.bin');
+    expect(safeBasename('a/', 'download.bin')).toBe('download.bin');
+  });
+});
+
+describe('resolveDownloadDir', () => {
+  it('defaults to the download root', () => {
+    expect(resolveDownloadDir(undefined)).toBe(resolve(DOWNLOAD_DIR));
+  });
+
+  it('allows sub-directories of the download root', () => {
+    expect(resolveDownloadDir('reports')).toBe(join(resolve(DOWNLOAD_DIR), 'reports'));
+  });
+
+  it('rejects arbitrary absolute save_dir', () => {
+    expect(() => resolveDownloadDir('/tmp/evil')).toThrow();
+    expect(() => resolveDownloadDir(join(DOWNLOAD_DIR, '..'))).toThrow();
+  });
+
+  it('rejects traversal out of the download root', () => {
+    expect(() => resolveDownloadDir('../../.config/autostart')).toThrow();
+  });
+});
+
+describe('resolveStatePath confinement', () => {
+  it('allows a relative path inside the state dir', () => {
+    expect(resolveStatePath({ path: 'sub/s.json' })).toBe(
+      join(resolve(STATE_DIR), 'sub', 's.json'),
+    );
+  });
+
+  it('rejects absolute paths', () => {
+    expect(() => resolveStatePath({ path: '/root/.bashrc' })).toThrow();
+    expect(() => resolveStatePath({ path: 'C:/tmp/s.json' })).toThrow();
+  });
+
+  it('rejects traversal', () => {
+    expect(() => resolveStatePath({ path: '../../.bashrc' })).toThrow();
+  });
+
+  it('rejects the state dir itself', () => {
+    expect(() => resolveStatePath({ path: '.' })).toThrow();
+  });
+});
