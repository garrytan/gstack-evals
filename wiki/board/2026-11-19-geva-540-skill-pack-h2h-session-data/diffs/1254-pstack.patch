@@ -0,0 +1,97 @@
+package httpserver
+
+import (
+	"archive/zip"
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sort"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func setupBulkACL(t *testing.T) *FileServer {
+	dir := t.TempDir()
+	protected := filepath.Join(dir, "protected")
+	require.NoError(t, os.MkdirAll(filepath.Join(protected, "hidden"), 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(protected, "secret.txt"), []byte("top secret"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(protected, "blocked.txt"), []byte("blocked"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(protected, "hidden", "x.txt"), []byte("hidden"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "public.txt"), []byte("public"), 0644))
+
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := `{"auth":"admin:` + string(hash) + `","block":["blocked.txt","hidden/"]}`
+	require.NoError(t, os.WriteFile(filepath.Join(protected, ".goshs"), []byte(acl), 0644))
+
+	fs, cleanup := newTestFileServer(t, dir)
+	t.Cleanup(cleanup)
+	return fs
+}
+
+func bulkZipNames(t *testing.T, body []byte) []string {
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	var names []string
+	for _, f := range zr.File {
+		names = append(names, f.Name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func TestBulkDownload_ACLRequiresAuth(t *testing.T) {
+	fs := setupBulkACL(t)
+	for _, target := range []string{"/protected/secret.txt", "/protected/blocked.txt", "/protected", "/"} {
+		r := httptest.NewRequest(http.MethodGet, "/?bulk&file="+target, nil)
+		w := httptest.NewRecorder()
+		fs.handler(w, r)
+		require.Equal(t, http.StatusUnauthorized, w.Code, target)
+		require.NotContains(t, w.Body.String(), "top secret", target)
+	}
+}
+
+func TestBulkDownload_ACLAuthorizedHonorsBlock(t *testing.T) {
+	fs := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/", nil)
+	r.SetBasicAuth("admin", "admin")
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, []string{"protected/secret.txt", "public.txt"}, bulkZipNames(t, w.Body.Bytes()))
+
+	zr, err := zip.NewReader(bytes.NewReader(w.Body.Bytes()), int64(w.Body.Len()))
+	require.NoError(t, err)
+	for _, f := range zr.File {
+		if f.Name == "protected/secret.txt" {
+			rc, err := f.Open()
+			require.NoError(t, err)
+			content, _ := io.ReadAll(rc)
+			rc.Close()
+			require.Equal(t, "top secret", string(content))
+		}
+	}
+}
+
+func TestBulkDownload_ACLWrongPassword(t *testing.T) {
+	fs := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected/secret.txt", nil)
+	r.SetBasicAuth("admin", "wrong")
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+}
+
+func TestBulkDownload_PublicFileUnaffected(t *testing.T) {
+	fs := setupBulkACL(t)
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/public.txt", nil)
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Equal(t, []string{"public.txt"}, bulkZipNames(t, w.Body.Bytes()))
+}
