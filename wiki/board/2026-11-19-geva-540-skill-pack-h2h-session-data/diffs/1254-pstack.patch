 }
+
+type bulkEntry struct {
+	path string
+	info os.FileInfo
+}
+
+// collectBulkEntries walks the requested paths and returns every file the
+// requester may read under the effective .goshs ACLs, mirroring doDir and
+// sendFile. Authorization must complete before the zip stream starts, since a
+// 401 cannot be sent once the body is being written.
+func (fs *FileServer) collectBulkEntries(w http.ResponseWriter, req *http.Request, roots []string) ([]bulkEntry, bool) {
+	var entries []bulkEntry
+	authorized := make(map[string]bool)
+	webroot := filepath.Clean(fs.Webroot)
+
+	for _, root := range roots {
+		denied := false
+		err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
+			if err != nil {
+				return err
+			}
+			if info.IsDir() {
+				if path == webroot {
+					return nil
+				}
+				parentConfig, err := fs.findSpecialFile(filepath.Dir(path))
+				if err != nil {
+					logger.Errorf("error reading file based access config: %+v", err)
+				}
+				if slices.Contains(parentConfig.Block, info.Name()+"/") {
+					return filepath.SkipDir
+				}
+				return nil
+			}
+
+			if info.Name() == ".goshs" {
+				return nil
+			}
+
+			acl, err := fs.findEffectiveACL(filepath.Dir(path))
+			if err != nil {
+				logger.Errorf("error reading file based access config: %+v", err)
+			}
+			if !authorized[acl.Auth] {
+				if !fs.applyCustomAuth(w, req, acl) {
+					denied = true
+					return filepath.SkipAll
+				}
+				authorized[acl.Auth] = true
+			}
+			if slices.Contains(acl.Block, info.Name()) {
+				return nil
+			}
+
+			entries = append(entries, bulkEntry{path: path, info: info})
+			return nil
+		})
+		if denied {
+			return nil, false
+		}
+		if err != nil {
+			logger.Errorf("creating zip file: %+v", err)
+		}
+	}
+
+	return entries, true
+}
+
+func (fs *FileServer) addToZip(resultZip *zip.Writer, entry bulkEntry) error {
+	// disable G304 (CWE-22): Potential file inclusion via variable
+	// #nosec G304
+	file, err := os.Open(entry.path)
+	if err != nil {
+		return err
+	}
+	// disable G307 (CWE-703): Deferring unsafe method "Close" on type "*os.File"
+	// #nosec G307
+	defer file.Close()
+
+	// Strip the webroot so the zip holds paths relative to it
+	zippath := strings.ReplaceAll(entry.path, fs.Webroot, "")
+	header := &zip.FileHeader{
+		Name:     zippath[1:],
+		Method:   zip.Deflate,
+		Modified: entry.info.ModTime(),
+	}
+	f, err := resultZip.CreateHeader(header)
+	if err != nil {
+		return err
+	}
+
+	_, err = io.Copy(f, file)
+	return err
+}
