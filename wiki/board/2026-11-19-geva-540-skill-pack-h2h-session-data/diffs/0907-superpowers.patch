+/**
+ * Strip the host-realm stack from an error before it is handed to the sandbox.
+ *
+ * SECURITY (GHSA-x6m4-chr9-cg97): errors thrown by the host-side transformer
+ * (e.g. SyntaxError from `eval("@@@")` / `new Function("@@@")`) or by
+ * checkAsync are host-realm errors. Their `.stack` is formatted by the host
+ * prepareStackTrace and contains absolute host paths (vm2 lib files, Node
+ * internals, the embedding application). The sandbox-side redaction never
+ * runs on host errors, so replace the stack with just `name: message`.
+ *
+ * @private
+ */
+function stripHostStack(e) {
+	if (e === null || (typeof e !== 'object' && typeof e !== 'function')) return e;
+	let header;
+	try {
+		const name = e.name;
+		const message = e.message;
+		const nameStr = typeof name === 'string' ? name : 'Error';
+		const messageStr = typeof message === 'string' ? message : '';
+		header = messageStr ? `${nameStr}: ${messageStr}` : nameStr;
+	} catch (ex) {
+		header = 'Error';
+	}
+	try {
+		Object.defineProperty(e, 'stack', {
+			__proto__: null,
+			value: header,
+			writable: true,
+			enumerable: false,
+			configurable: true,
+		});
+	} catch (ex) {
+		return new VMError(header);
+	}
+	return e;
+}
+
 function transformAndCheck(args, code, isAsync, isGenerator, allowAsync) {
-	const ret = transformer(args, code, isAsync, isGenerator, undefined);
-	checkAsync(allowAsync || !ret.hasAsync);
-	return ret.code;
+	try {
+		const ret = transformer(args, code, isAsync, isGenerator, undefined);
+		checkAsync(allowAsync || !ret.hasAsync);
+		return ret.code;
+	} catch (e) {
+		throw stripHostStack(e);
+	}
 }
 
