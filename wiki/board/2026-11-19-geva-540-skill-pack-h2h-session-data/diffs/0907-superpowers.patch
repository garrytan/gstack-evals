diff --git a/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
new file mode 100644
index 0000000..43aaf6e
--- /dev/null
+++ b/test/ghsa/GHSA-x6m4-chr9-cg97/repro.js
@@ -0,0 +1,49 @@
+'use strict';
+
+/**
+ * GHSA-x6m4-chr9-cg97 — Host path disclosure via transformer SyntaxError stack
+ *
+ * `eval("@@@")` / `new Function("@@@")` inside the sandbox makes the
+ * host-side transformer throw a host-realm SyntaxError. Reading `.stack`
+ * through the bridge used the host formatter, leaking absolute host paths.
+ *
+ * Fix: `transformAndCheck` (lib/vm.js) replaces the stack of any error it
+ * throws with just `name: message` before it reaches the sandbox.
+ */
+
+const assert = require('assert');
+const path = require('path');
+const { VM, NodeVM } = require('../../../lib/main.js');
+
+const libDir = path.resolve(__dirname, '../../../lib');
+
+function assertNoLeak(stack) {
+	assert.strictEqual(typeof stack, 'string');
+	assert.ok(!stack.includes(libDir), `stack leaks host path: ${stack}`);
+	assert.ok(!/transformer\.js|setup-sandbox\.js|vm\.js:\d|node:/.test(stack), `stack leaks host frames: ${stack}`);
+}
+
+describe('GHSA-x6m4-chr9-cg97 (transformer error stack leaks host paths)', () => {
+	it('eval syntax error in VM', () => {
+		const r = new VM().run('var s; try { eval("@@@ catch") } catch (e) { s = [e instanceof SyntaxError, e.message, e.stack] } s;');
+		assert.strictEqual(r[0], true);
+		assert.strictEqual(r[1], "Unexpected character '@'");
+		assertNoLeak(r[2]);
+	});
+
+	it('Function constructor syntax error in VM', () => {
+		const s = new VM().run('var s; try { new Function("@@@ catch") } catch (e) { s = e.stack } s;');
+		assertNoLeak(s);
+	});
+
+	it('async not available error in VM', () => {
+		const s = new VM({ allowAsync: false }).run('var s; try { eval("async () => 1") } catch (e) { s = e.stack } s;');
+		assert.ok(s.includes('Async not available'));
+		assertNoLeak(s);
+	});
+
+	it('eval syntax error in NodeVM', () => {
+		const s = new NodeVM().run('try { eval("@@@ catch") } catch (e) { module.exports = e.stack }');
+		assertNoLeak(s);
+	});
+});
