+// arrayItems returns the items schema of an array schema.
+// OpenAPI 3.1 allows omitting items, but decoding needs to know the item type.
+func arrayItems(schemaRef *openapi3.SchemaRef) (*openapi3.SchemaRef, error) {
+	if items := schemaRef.Value.Items; items != nil && items.Value != nil {
+		return items, nil
+	}
+	return nil, &ParseError{Kind: KindOther, Reason: "array schema without items is not supported for decoding"}
+}
