+package openapi3filter_test
+
+import (
+	"bytes"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/getkin/kin-openapi/openapi3"
+	"github.com/getkin/kin-openapi/openapi3filter"
+	"github.com/getkin/kin-openapi/routers/gorillamux"
+)
+
+func TestArraySchemaWithoutItemsDoesNotPanic(t *testing.T) {
+	const spec = `
+openapi: 3.1.0
+info: {title: t, version: 1.0.0}
+paths:
+  /form:
+    post:
+      requestBody:
+        required: true
+        content:
+          application/x-www-form-urlencoded:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /upload:
+    post:
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              properties:
+                tags: {type: array}
+      responses:
+        '200': {description: ok}
+  /query:
+    get:
+      parameters:
+        - {name: tags, in: query, schema: {type: array}}
+        - {name: X-Tags, in: header, schema: {type: array}}
+        - name: deep
+          in: query
+          style: deepObject
+          explode: true
+          schema:
+            type: object
+            properties:
+              list: {type: array}
+      responses:
+        '200':
+          description: ok
+          headers:
+            X-Tags:
+              schema: {type: array}
+`
+	loader := openapi3.NewLoader()
+	doc, err := loader.LoadFromData([]byte(spec))
+	require.NoError(t, err)
+	require.NoError(t, doc.Validate(loader.Context))
+	router, err := gorillamux.NewRouter(doc)
+	require.NoError(t, err)
+
+	opts := &openapi3filter.Options{AuthenticationFunc: openapi3filter.NoopAuthenticationFunc}
+	input := func(req *http.Request) *openapi3filter.RequestValidationInput {
+		route, pathParams, err := router.FindRoute(req)
+		require.NoError(t, err)
+		return &openapi3filter.RequestValidationInput{Request: req, PathParams: pathParams, Route: route, Options: opts}
+	}
+
+	var body bytes.Buffer
+	mw := multipart.NewWriter(&body)
+	require.NoError(t, mw.WriteField("tags", "a"))
+	require.NoError(t, mw.Close())
+
+	requests := map[string]func() *http.Request{
+		"urlencoded body": func() *http.Request {
+			req, _ := http.NewRequest(http.MethodPost, "/form", strings.NewReader("tags=a"))
+			req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+			return req
+		},
+		"multipart body": func() *http.Request {
+			req, _ := http.NewRequest(http.MethodPost, "/upload", bytes.NewReader(body.Bytes()))
+			req.Header.Set("Content-Type", mw.FormDataContentType())
+			return req
+		},
+		"query param": func() *http.Request {
+			req, _ := http.NewRequest(http.MethodGet, "/query?tags=a", nil)
+			return req
+		},
+		"header param": func() *http.Request {
+			req, _ := http.NewRequest(http.MethodGet, "/query", nil)
+			req.Header.Set("X-Tags", "a,b")
+			return req
+		},
+		"deepObject param": func() *http.Request {
+			req, _ := http.NewRequest(http.MethodGet, "/query?deep[list][0]=a", nil)
+			return req
+		},
+	}
+	for name, newReq := range requests {
+		t.Run(name, func(t *testing.T) {
+			require.NotPanics(t, func() {
+				err := openapi3filter.ValidateRequest(loader.Context, input(newReq()))
+				require.ErrorContains(t, err, "array schema without items")
+			})
+		})
+	}
+
+	t.Run("response header", func(t *testing.T) {
+		req, _ := http.NewRequest(http.MethodGet, "/query", nil)
+		require.NotPanics(t, func() {
+			err := openapi3filter.ValidateResponse(loader.Context, &openapi3filter.ResponseValidationInput{
+				RequestValidationInput: input(req),
+				Status:                 http.StatusOK,
+				Header:                 http.Header{"X-Tags": []string{"a,b"}},
+				Body:                   io.NopCloser(strings.NewReader("")),
+			})
+			require.ErrorContains(t, err, "array schema without items")
+		})
+	})
+}
