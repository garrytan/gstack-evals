@@ -96,11 +96,45 @@ func ListenFailedScenarios(wg *sync.WaitGroup, specDirs []string) {
 	}()
 }
 
+// lastNewlyFailed holds the item added by the most recent failed scenario attempt,
+// if it was not already present. It is removed again if a retry of that scenario passes.
+var lastNewlyFailed *failedItemKey
+
+type failedItemKey struct {
+	itemName string
+	item     string
+}
+
 func prepareScenarioFailedMetadata(res *result.ScenarioResult, sce *gauge.Scenario, executionInfo *gauge_messages.ExecutionInfo) {
+	specPath := executionInfo.GetCurrentSpec().GetFileName()
+	failedScenario := util.RelPathToProjectRoot(specPath)
+	key := failedItemKey{itemName: specPath, item: fmt.Sprintf("%s:%v", failedScenario, sce.Span.Start)}
+	isRetry := executionInfo.GetCurrentScenario().GetRetries().GetCurrentRetry() > 0
 	if res.GetFailed() {
-		specPath := executionInfo.GetCurrentSpec().GetFileName()
-		failedScenario := util.RelPathToProjectRoot(specPath)
-		failedMeta.addFailedItem(specPath, fmt.Sprintf("%s:%v", failedScenario, sce.Span.Start))
+		if isRetry && lastNewlyFailed != nil && *lastNewlyFailed == key {
+			return
+		}
+		alreadyPresent := failedMeta.failedItemsMap[key.itemName][key.item]
+		failedMeta.addFailedItem(key.itemName, key.item)
+		if alreadyPresent {
+			lastNewlyFailed = nil
+		} else {
+			lastNewlyFailed = &key
+		}
+		return
+	}
+	if isRetry && lastNewlyFailed != nil && *lastNewlyFailed == key {
+		failedMeta.removeFailedItem(key.itemName, key.item)
+	}
+	lastNewlyFailed = nil
+}
+
+func (m *failedMetadata) removeFailedItem(itemName string, item string) {
+	if items, ok := m.failedItemsMap[itemName]; ok {
+		delete(items, item)
+		if len(items) == 0 {
+			delete(m.failedItemsMap, itemName)
+		}
 	}
 }
 
