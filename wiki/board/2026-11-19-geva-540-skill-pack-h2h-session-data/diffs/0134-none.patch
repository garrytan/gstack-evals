     use super::*;
     use crate::dispatch::CdpContext;
 
+    #[test]
+    fn navigation_prunes_stale_context_ids() {
+        let mut ctx = CdpContext::new();
+        let pre_nav = ctx.next_isolated_context();
+        assert!(ctx.valid_context_ids.contains(&pre_nav));
+
+        let mut last_live = Vec::new();
+        for _ in 0..50 {
+            let before = ctx.next_isolated_context_id;
+            emit_navigation_events(
+                &mut ctx, &None, "F", "L", "https://example.com/", "p1", &[],
+                WaitUntil::Load, true,
+            );
+            last_live = (before..ctx.next_isolated_context_id).collect();
+        }
+
+        // Stale pre-navigation contexts are rejected after executionContextsCleared.
+        assert!(!ctx.valid_context_ids.contains(&pre_nav));
+        assert!(!ctx.valid_context_ids.contains(&1));
+        // Re-emitted default context + freshly minted worlds remain valid.
+        assert!(ctx.valid_context_ids.contains(&2));
+        for id in &last_live {
+            assert!(ctx.valid_context_ids.contains(id));
+        }
+        // Bounded: no growth across navigations.
+        assert_eq!(ctx.valid_context_ids.len(), 1 + last_live.len());
+    }
