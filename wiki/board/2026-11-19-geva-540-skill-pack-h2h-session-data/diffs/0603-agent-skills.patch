+    [Test]
+    public void TestDayLightSavingEndWith2HourIntervalShouldStayOnWallClockGrid()
+    {
+        var timeZoneInfo = TZConvert.GetTimeZoneInfo("Central European Standard Time");
+
+        var trigger = DailyTimeIntervalScheduleBuilder.Create()
+            .OnEveryDay()
+            .StartingDailyAt(TimeOfDay.HourAndMinuteOfDay(0, 0))
+            .EndingDailyAt(TimeOfDay.HourAndMinuteOfDay(8, 0))
+            .WithIntervalInHours(2)
+            .InTimeZone(timeZoneInfo)
+            .Build();
+
+        var after = new DateTimeOffset(2020, 10, 24, 23, 0, 0, TimeSpan.FromHours(2));
+        var fireTimes = new List<DateTimeOffset>();
+        for (int i = 0; i < 5; i++)
+        {
+            after = trigger.GetFireTimeAfter(after)!.Value;
+            fireTimes.Add(after);
+        }
+
+        Assert.That(fireTimes, Is.EqualTo(new[]
+        {
+            new DateTimeOffset(2020, 10, 25, 0, 0, 0, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 10, 25, 2, 0, 0, TimeSpan.FromHours(2)),
+            new DateTimeOffset(2020, 10, 25, 4, 0, 0, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 10, 25, 6, 0, 0, TimeSpan.FromHours(1)),
+            new DateTimeOffset(2020, 10, 25, 8, 0, 0, TimeSpan.FromHours(1)),
+        }));
+    }
