+    /// <summary>
+    /// Converts a wall clock time in the trigger's time zone to a <see cref="DateTimeOffset"/>.
+    /// For ambiguous times (clocks set back) the earliest occurrence not before <paramref name="notBefore"/> is chosen,
+    /// invalid times (clocks set forward) are shifted forward by the zone's adjustment.
+    /// </summary>
+    private DateTimeOffset ResolveLocalTime(DateTime localTime, DateTimeOffset notBefore)
+    {
+        localTime = DateTime.SpecifyKind(localTime, DateTimeKind.Unspecified);
+        if (TimeZone.IsAmbiguousTime(localTime))
+        {
+            // larger offset means earlier instant
+            foreach (TimeSpan offset in TimeZone.GetAmbiguousTimeOffsets(localTime).OrderByDescending(x => x))
+            {
+                DateTimeOffset candidate = new DateTimeOffset(localTime, offset);
+                if (candidate >= notBefore)
+                {
+                    return candidate;
+                }
+            }
+        }
+
+        return new DateTimeOffset(localTime, TimeZoneUtil.GetUtcOffset(localTime, TimeZone));
+    }
