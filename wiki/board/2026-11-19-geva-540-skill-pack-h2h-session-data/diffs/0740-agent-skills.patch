+++ b/test/UnitTest/Components/RadioListGenericTest.cs
@@ -226,6 +226,32 @@ public class RadioListGenericTest : BootstrapBlazorTestBase
         cut.Contains("btn active bg-danger");
     }
 
+    [Fact]
+    public void IsOutline_Ok()
+    {
+        var cut = Context.RenderComponent<RadioListGeneric<EnumEducation>>(pb =>
+        {
+            pb.Add(a => a.IsButton, true);
+            pb.Add(a => a.IsOutline, true);
+            pb.Add(a => a.Color, Color.Danger);
+            pb.Add(a => a.Items, typeof(EnumEducation).ToSelectList<EnumEducation>());
+            pb.Add(a => a.Value, EnumEducation.Middle);
+        });
+        cut.Contains("radio-list btn-group is-outline");
+        cut.Contains("btn btn-outline-danger active");
+        Assert.Equal(2, cut.FindAll(".btn-outline-danger").Count);
+        Assert.Single(cut.FindAll(".btn.active"));
+        cut.DoesNotContain("bg-danger");
+
+        cut.SetParametersAndRender(pb =>
+        {
+            pb.Add(a => a.IsOutline, false);
+        });
+        cut.DoesNotContain("is-outline");
+        cut.DoesNotContain("btn-outline-danger");
+        cut.Contains("btn active bg-danger");
+    }
+
     [Fact]
     public void ShowBorder_Ok()
     {
