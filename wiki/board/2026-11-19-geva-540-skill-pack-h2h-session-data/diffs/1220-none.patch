+func TestHandshakeMessageServerKeyExchangeEcdhePskEmptyAfterHint(t *testing.T) {
+	for _, data := range [][]byte{{0x00, 0x00}, {0x00, 0x01, 0xaa}, {0x00, 0x00, 0x03}} {
+		m := &MessageServerKeyExchange{
+			KeyExchangeAlgorithm: types.KeyExchangeAlgorithmPsk | types.KeyExchangeAlgorithmEcdhe,
+		}
+		if err := m.Unmarshal(data); err == nil {
+			t.Fatalf("expected error for %v", data)
+		}
+	}
