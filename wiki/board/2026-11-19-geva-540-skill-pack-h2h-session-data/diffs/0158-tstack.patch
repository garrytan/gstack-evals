-        public static char GetAlternateDashChar() => '‐'; // Unicode En Dash (\u2010)
+        public static char GetAlternateDashChar() => '‐'; // Unicode Hyphen (\u2010)
+
+        private static readonly char[] NonAsciiDialogDashes = { '‐', '–' }; // Hyphen, En Dash
 
         public string FixDashesAndSpaces(string input)
         {
+            var normalized = NormalizeStartDashes(input);
+            if (normalized != input && IsDialog(normalized.SplitToLines()))
