         public string FixDashesAndSpaces(string input, Paragraph p, Paragraph prev)
         {
+            var normalized = NormalizeStartDashes(input);
+            if (normalized != input && IsDialog(normalized.SplitToLines(), p, prev))
+            {
+                input = normalized;
+            }
+
             return FixSpaces(FixDashes(input, p, prev));
         }
 
+        /// <summary>
+        /// Replace non-ASCII dashes (hyphen/en dash) at the start of lines with a normal ASCII dash.
+        /// </summary>
+        private static string NormalizeStartDashes(string input)
+        {
+            if (string.IsNullOrEmpty(input) || input.IndexOfAny(NonAsciiDialogDashes) < 0)
+            {
+                return input;
+            }
+
+            var lines = input.SplitToLines();
+            for (var i = 0; i < lines.Count; i++)
+            {
+                var line = lines[i];
+                var pre = GetStartTags(line);
+                var rest = line.Remove(0, pre.Length);
+                var trimmed = rest.TrimStart();
+                if (trimmed.Length > 0 && Array.IndexOf(NonAsciiDialogDashes, trimmed[0]) >= 0)
+                {
+                    lines[i] = pre + rest.Substring(0, rest.Length - trimmed.Length) + GetDashChar() + trimmed.Substring(1);
+                }
+            }
+
+            return string.Join(Environment.NewLine, lines);
+        }
+
