 impl FindInlinableParameters {
+    /// Marks a parameter as not inlinable. This is used for references in
+    /// positions that the inliner does not rewrite, such as case clause guards
+    /// and bit array pattern sizes. If we inlined a parameter referenced there,
+    /// the assignment would be removed but the reference would remain, leaving
+    /// an unbound variable in the generated code.
+    fn register_non_inlinable_reference(&mut self, name: &EcoString, location: SrcSpan) {
+        _ = self.parameters.remove(&(name.clone(), location));
+    }
+
     fn register_reference(&mut self, name: &EcoString, location: SrcSpan) {
         let key = (name.clone(), location);
 
@@ -1004,7 +1013,7 @@ impl<'ast> Visit<'ast> for FindInlinableParameters {
         _type_: &'ast Arc<Type>,
         location: &'ast SrcSpan,
     ) {
-        self.register_reference(name, *location);
+        self.register_non_inlinable_reference(name, *location);
     }
 
     fn visit_typed_bit_array_size_variable(
@@ -1019,7 +1028,7 @@ impl<'ast> Visit<'ast> for FindInlinableParameters {
             None => return,
         };
         if let ValueConstructorVariant::LocalVariable { location, .. } = variant {
-            self.register_reference(name, *location);
+            self.register_non_inlinable_reference(name, *location);
         }
     }
 
@@ -1364,6 +1373,13 @@ impl FunctionToInlinable {
     }
 
     fn clause(&mut self, clause: &TypedClause) -> Option<InlinableClause> {
+        // Guards and alternative patterns are not represented in inlinable
+        // clauses, so we cannot inline functions which use them without
+        // changing their behaviour.
+        if clause.guard.is_some() || !clause.alternative_patterns.is_empty() {
+            return None;
+        }
+
         let pattern = clause
             .pattern
             .iter()
