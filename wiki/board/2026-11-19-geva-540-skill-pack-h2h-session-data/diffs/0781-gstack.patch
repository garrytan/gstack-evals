+#[test]
+fn parameter_used_in_case_guard_is_not_inlined() {
+    assert_erl!(
+        ("gleam_stdlib", "gleam/result", RESULT_MODULE),
+        "
+import gleam/result
+
+pub fn main(x, y) {
+  use ssl <- result.map(x)
+  case y {
+    _ if ssl -> 1
+    _ -> 2
+  }
+}
+"
+    );
+}
+
+#[test]
+fn parameter_used_in_bit_array_pattern_size_is_not_inlined() {
+    assert_erl!(
+        ("gleam_stdlib", "gleam/result", RESULT_MODULE),
+        "
+import gleam/result
+
+pub fn main(x, y) {
+  use size <- result.map(x)
+  case y {
+    <<a:size(size)>> -> a
+    _ -> 2
+  }
+}
+"
+    );
+}
