diff --git a/src/paths.ts b/src/paths.ts
new file mode 100644
index 0000000..fe7a3cd
--- /dev/null
+++ b/src/paths.ts
@@ -0,0 +1,43 @@
+import { isAbsolute, resolve, relative, sep, win32, posix } from 'path';
+
+/**
+ * Resolve a caller-supplied relative path under `root`, refusing anything that
+ * could escape it: absolute paths (POSIX or Windows-style), drive letters,
+ * `~`, NUL bytes, and `..` traversal. Returns an absolute path inside `root`.
+ */
+export function confinePath(root: string, sub: string | undefined, label = 'path'): string {
+  const base = resolve(root);
+  if (sub === undefined || sub === null || sub === '') return base;
+  if (typeof sub !== 'string') throw new Error(`Invalid ${label}: must be a string`);
+  if (sub.includes('\0')) throw new Error(`Invalid ${label}: contains NUL byte`);
+  if (
+    isAbsolute(sub) ||
+    posix.isAbsolute(sub) ||
+    win32.isAbsolute(sub) ||
+    /^[A-Za-z]:/.test(sub) ||
+    sub.startsWith('~')
+  ) {
+    throw new Error(
+      `Invalid ${label} ${JSON.stringify(sub)}: absolute paths are not allowed; it must be relative to ${base}`,
+    );
+  }
+  const parts = sub.split(/[\\/]+/);
+  if (parts.includes('..')) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(sub)}: ".." segments are not allowed`);
+  }
+  const out = resolve(base, sub);
+  const rel = relative(base, out);
+  if (rel === '..' || rel.startsWith('..' + sep) || isAbsolute(rel)) {
+    throw new Error(`Invalid ${label} ${JSON.stringify(sub)}: escapes ${base}`);
+  }
+  return out;
+}
+
+/** Reduce an untrusted filename to a safe bare basename. */
+export function safeFilename(name: string | undefined, fallback = 'download.bin'): string {
+  let n = (name ?? '').replace(/\0/g, '');
+  n = n.split(/[\\/]+/).pop() ?? '';
+  n = n.replace(/^[A-Za-z]:/, '').trim();
+  if (!n || n === '.' || n === '..' || /^\.+$/.test(n)) return fallback;
+  return n;
+}
