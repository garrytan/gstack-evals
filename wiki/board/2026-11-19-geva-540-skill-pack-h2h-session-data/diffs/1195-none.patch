diff --git a/test/paths.test.ts b/test/paths.test.ts
new file mode 100644
index 0000000..5c4e468
--- /dev/null
+++ b/test/paths.test.ts
@@ -0,0 +1,41 @@
+import { describe, it, expect } from 'vitest';
+import { join, resolve } from 'path';
+import { confinePath, safeFilename } from '../src/paths.js';
+
+const root = resolve('/tmp/bmcp-root');
+
+describe('confinePath', () => {
+  it('returns the root for empty input', () => {
+    expect(confinePath(root, undefined)).toBe(root);
+    expect(confinePath(root, '')).toBe(root);
+  });
+  it('allows relative subdirectories', () => {
+    expect(confinePath(root, 'a/b')).toBe(join(root, 'a', 'b'));
+  });
+  it('rejects absolute paths and traversal', () => {
+    for (const bad of [
+      '/etc',
+      'C:\\x',
+      'C:/x',
+      '\\\\srv\\share',
+      '..',
+      '../x',
+      'a/../../x',
+      'a\\..\\..\\x',
+      '~/x',
+      'a\0b',
+    ]) {
+      expect(() => confinePath(root, bad)).toThrow();
+    }
+  });
+});
+
+describe('safeFilename', () => {
+  it('reduces to a basename', () => {
+    expect(safeFilename('../../.bashrc')).toBe('.bashrc');
+    expect(safeFilename('a\\b\\c.txt')).toBe('c.txt');
+    expect(safeFilename('C:evil.exe')).toBe('evil.exe');
+    expect(safeFilename('..')).toBe('download.bin');
+    expect(safeFilename('')).toBe('download.bin');
+  });
+});
