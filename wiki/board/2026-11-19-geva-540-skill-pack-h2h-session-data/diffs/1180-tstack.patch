diff --git a/packages/mcp-tools/src/tools/jobs/space-to-space-migration/safeOptions.ts b/packages/mcp-tools/src/tools/jobs/space-to-space-migration/safeOptions.ts
new file mode 100644
index 0000000..b54126a
--- /dev/null
+++ b/packages/mcp-tools/src/tools/jobs/space-to-space-migration/safeOptions.ts
@@ -0,0 +1,29 @@
+/**
+ * Options accepted by contentful-export / contentful-import that control where
+ * requests (carrying the server's management token) are sent, or that load
+ * additional options from disk. These must never be supplied by tool callers.
+ */
+const UNSAFE_MIGRATION_OPTIONS = [
+  'host',
+  'hostDelivery',
+  'proxy',
+  'rawProxy',
+  'insecure',
+  'port',
+  'basePath',
+  'httpAgent',
+  'httpsAgent',
+  'config',
+  'managementToken',
+  'accessToken',
+] as const;
+
+export function stripUnsafeMigrationOptions<T extends Record<string, unknown>>(
+  args: T,
+): Omit<T, (typeof UNSAFE_MIGRATION_OPTIONS)[number]> {
+  const safe: Record<string, unknown> = { ...args };
+  for (const key of UNSAFE_MIGRATION_OPTIONS) {
+    delete safe[key];
+  }
+  return safe as Omit<T, (typeof UNSAFE_MIGRATION_OPTIONS)[number]>;
+}
