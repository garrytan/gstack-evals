+// getBackupVaultTags retrieves all tags for a backup vault.
+func getBackupVaultTags(ctx context.Context, client BackupVaultAPI, vaultArn *string) (map[string]string, error) {
+	if vaultArn == nil {
+		return nil, nil
+	}
+
+	tags := make(map[string]string)
+	paginator := backup.NewListTagsPaginator(client, &backup.ListTagsInput{
+		ResourceArn: vaultArn,
+	})
+	for paginator.HasMorePages() {
+		page, err := paginator.NextPage(ctx)
+		if err != nil {
+			return nil, err
+		}
+		for k, v := range page.Tags {
+			tags[k] = v
+		}
+	}
+	return tags, nil
+}
+
