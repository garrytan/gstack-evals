diff --git a/bindgen-tests/tests/headers/default-alias-style-new-type-constants.h b/bindgen-tests/tests/headers/default-alias-style-new-type-constants.h
new file mode 100644
index 0000000..0e50b9f
--- /dev/null
+++ b/bindgen-tests/tests/headers/default-alias-style-new-type-constants.h
@@ -0,0 +1,14 @@
+// bindgen-flags: --default-alias-style=new_type --normal-alias=Boom
+
+typedef unsigned int Foo;
+static const Foo Foo_A = 1;
+
+// Plain macros and non-typedef constants must not be wrapped.
+#define FooBar 0x00000000
+#define NegConst -1
+static const unsigned int Plain = 3;
+static const float PlainFloat = 2.5;
+
+// Explicitly a plain type alias: not wrapped.
+typedef unsigned int Boom;
+static const Boom Boom_A = 2;
