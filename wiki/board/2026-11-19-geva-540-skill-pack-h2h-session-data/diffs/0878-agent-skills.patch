+
+function isAssignmentToNames(node: t.Node, names: Set<string>) {
+  switch (node.type) {
+    case "AssignmentExpression":
+      return patternContainsNames(node.left, names);
+    case "UpdateExpression":
+      return patternContainsNames(node.argument, names);
+    case "ForInStatement":
+    case "ForOfStatement":
+      return (
+        node.left.type !== "VariableDeclaration" &&
+        patternContainsNames(node.left, names)
+      );
+    default:
+      return false;
+  }
+}
+
+function patternContainsNames(node: t.Node, names: Set<string>): boolean {
+  let found = false;
+  forEachIdentifier(node, (id) => {
+    if (names.has(id.name)) found = true;
+  });
+  return found;
+}
