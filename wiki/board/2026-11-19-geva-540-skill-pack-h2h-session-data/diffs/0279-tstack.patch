diff --git a/tests/features/embeddables/nested-inline-null.test.ts b/tests/features/embeddables/nested-inline-null.test.ts
new file mode 100644
index 0000000..81053d7
--- /dev/null
+++ b/tests/features/embeddables/nested-inline-null.test.ts
@@ -0,0 +1,72 @@
+import { MikroORM } from '@mikro-orm/sqlite';
+import {
+  Embeddable,
+  Embedded,
+  Entity,
+  PrimaryKey,
+  Property,
+  ReflectMetadataProvider,
+} from '@mikro-orm/decorators/legacy';
+
+@Embeddable()
+class Geo {
+  @Property({ nullable: true })
+  lat?: number;
+}
+
+@Embeddable()
+class Address {
+  @Property({ nullable: true })
+  city?: string;
+
+  @Embedded(() => Geo, { nullable: true })
+  geo?: Geo | null;
+}
+
+@Entity()
+class User {
+  @PrimaryKey()
+  id!: number;
+
+  @Embedded(() => Address, { nullable: true })
+  address?: Address | null;
+}
+
+let orm: MikroORM;
+
+beforeAll(async () => {
+  orm = await MikroORM.init({
+    metadataProvider: ReflectMetadataProvider,
+    dbName: ':memory:',
+    entities: [User],
+  });
+  await orm.schema.create();
+});
+
+afterAll(() => orm.close(true));
+
+test('nested inline embeddable with null parent', async () => {
+  orm.em.create(User, { id: 1, address: null });
+  await orm.em.flush();
+  orm.em.clear();
+  const u1 = await orm.em.findOneOrFail(User, 1);
+  expect(u1.address).toBeNull();
+
+  u1.address = { city: 'c', geo: { lat: 1 } } as Address;
+  await orm.em.flush();
+  orm.em.clear();
+  const u2 = await orm.em.findOneOrFail(User, 1);
+  expect(u2.address).toMatchObject({ city: 'c', geo: { lat: 1 } });
+
+  u2.address = null;
+  await orm.em.flush();
+  orm.em.clear();
+  const u3 = await orm.em.findOneOrFail(User, 1);
+  expect(u3.address).toBeNull();
+
+  const u4 = new User();
+  u4.id = 2;
+  u4.address = null;
+  orm.em.persist(u4);
+  await orm.em.flush();
+});
