+    static final class BinaryKeyTest extends RowCompactedSerializerTest {
+        public BinaryKeyTest() {
+            super(getRowSerializer(), getData());
+        }
+
+        private static InternalRow[] getData() {
+            return new InternalRow[] {
+                GenericRow.of(new byte[] {1, 2}, new byte[] {3}),
+                GenericRow.of(new byte[] {(byte) 0x80}, null)
+            };
+        }
+
+        private static RowCompactedSerializer getRowSerializer() {
+            return new RowCompactedSerializer(
+                    RowType.of(DataTypes.BINARY(2), DataTypes.VARBINARY(10)));
+        }
+
+        private static MemorySlice slice(RowCompactedSerializer serializer, InternalRow row) {
+            return MemorySlice.wrap(serializer.serializeToBytes(row));
+        }
+
+        @Test
+        public void testSliceComparatorOrdersBinaryFieldsUnsignedLexicographic() {
+            RowCompactedSerializer serializer = getRowSerializer();
+            Comparator<MemorySlice> comparator = serializer.createSliceComparator();
+
+            MemorySlice a = slice(serializer, GenericRow.of(new byte[] {1, 2}, new byte[] {5}));
+            MemorySlice aCopy =
+                    slice(serializer, GenericRow.of(new byte[] {1, 2}, new byte[] {5}));
+            MemorySlice b = slice(serializer, GenericRow.of(new byte[] {1, 3}, new byte[] {0}));
+            // 0x80 is negative as a signed byte, but must sort after 0x7F unsigned
+            MemorySlice high =
+                    slice(serializer, GenericRow.of(new byte[] {(byte) 0x80, 0}, new byte[0]));
+            MemorySlice low =
+                    slice(serializer, GenericRow.of(new byte[] {0x7F, 0}, new byte[0]));
+            // second field: prefix sorts before longer value
+            MemorySlice prefix = slice(serializer, GenericRow.of(new byte[] {1, 2}, new byte[] {5}));
+            MemorySlice longer =
+                    slice(serializer, GenericRow.of(new byte[] {1, 2}, new byte[] {5, 0}));
+            MemorySlice nullSecond = slice(serializer, GenericRow.of(new byte[] {1, 2}, null));
+
+            assertThat(comparator.compare(a, aCopy)).isZero();
+            assertThat(comparator.compare(a, b)).isNegative();
+            assertThat(comparator.compare(b, a)).isPositive();
+            assertThat(comparator.compare(low, high)).isNegative();
+            assertThat(comparator.compare(high, low)).isPositive();
+            assertThat(comparator.compare(prefix, longer)).isNegative();
+            assertThat(comparator.compare(nullSecond, prefix)).isNegative();
+        }
+    }
