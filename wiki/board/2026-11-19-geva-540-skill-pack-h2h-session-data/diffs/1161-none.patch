+// Check that symlink targets from untrusted remotes can't escape the root
+func TestSymlinkUnsafeTarget(t *testing.T) {
+	ctx := context.Background()
+	outside := t.TempDir()
+	dir := t.TempDir()
+	fRaw, err := NewFs(ctx, "local", dir, configmap.Simple{"links": "true"})
+	require.NoError(t, err)
+	f := fRaw.(*Fs)
+
+	put := func(remote, contents string) error {
+		src := object.NewStaticObjectInfo(remote, time.Now(), int64(len(contents)), true, nil, nil)
+		_, err := f.Put(ctx, bytes.NewBufferString(contents), src)
+		return err
+	}
+
+	// Safe relative links are allowed
+	require.NoError(t, put("a/b/ok.rclonelink", "../c/file"))
+	require.NoError(t, put("a/up.rclonelink", ".."))
+	require.NoError(t, put("a/b/y.rclonelink", "../.."))
+
+	for _, target := range []string{
+		outside,
+		"/etc",
+		"..",
+		"../x",
+		"a/../../x",
+		"y/../..",
+		"y/..",
+	} {
+		t.Run(target, func(t *testing.T) {
+			if target == "y/.." || target == "y/../.." {
+				assert.Error(t, put("a/b/pwn.rclonelink", target))
+			} else {
+				assert.Error(t, put("pwn.rclonelink", target))
+			}
+		})
+	}
+	_, err = os.Lstat(filepath.Join(dir, "pwn"))
+	assert.True(t, os.IsNotExist(err))
+	_, err = os.Lstat(filepath.Join(dir, "a", "b", "pwn"))
+	assert.True(t, os.IsNotExist(err))
+
+	// A file written under the rejected link must stay inside dir
+	require.Error(t, put("pwn.rclonelink", outside))
+	require.NoError(t, put("pwn/authorized_keys", "pwned"))
+	_, err = os.Stat(filepath.Join(outside, "authorized_keys"))
+	assert.True(t, os.IsNotExist(err))
+	data, err := os.ReadFile(filepath.Join(dir, "pwn", "authorized_keys"))
+	require.NoError(t, err)
+	assert.Equal(t, "pwned", string(data))
+}
