+// checkSymlinkTarget checks that the symlink target supplied by the
+// remote is relative and does not escape the root of the Fs.
+//
+// The symlink target comes from untrusted remote data so we must not
+// allow it to point outside of the destination otherwise subsequent
+// writes through the symlink could land anywhere on the filesystem.
+func (o *Object) checkSymlinkTarget(target string) error {
+	if target == "" {
+		return errors.New("empty symlink target")
+	}
+	if strings.ContainsRune(target, 0) {
+		return errors.New("symlink target contains NUL byte")
+	}
+	osTarget := filepath.FromSlash(target)
+	if filepath.IsAbs(osTarget) || filepath.VolumeName(osTarget) != "" || strings.HasPrefix(osTarget, string(filepath.Separator)) || strings.HasPrefix(target, "/") {
+		return fmt.Errorf("symlink target %q is absolute", target)
+	}
+	// Only allow ".." as leading components. A ".." after a normal
+	// component could be traversing a symlink, which would make the
+	// lexical check below unreliable.
+	seenNormal := false
+	for _, part := range strings.Split(filepath.ToSlash(osTarget), "/") {
+		switch part {
+		case "", ".":
+		case "..":
+			if seenNormal {
+				return fmt.Errorf("symlink target %q contains \"..\" after a path component", target)
+			}
+		default:
+			seenNormal = true
+		}
+	}
+	// Resolve the real locations of the root and the directory
+	// containing the link so symlinks in the path can't be used to
+	// escape.
+	root, err := filepath.Abs(o.fs.root)
+	if err != nil {
+		return err
+	}
+	if realRoot, err := filepath.EvalSymlinks(root); err == nil {
+		root = realRoot
+	}
+	dir, err := filepath.Abs(filepath.Dir(o.path))
+	if err != nil {
+		return err
+	}
+	dir, err = filepath.EvalSymlinks(dir)
+	if err != nil {
+		return fmt.Errorf("failed to resolve symlink directory: %w", err)
+	}
+	if !isWithin(root, dir) {
+		return fmt.Errorf("symlink directory %q is outside of the root", dir)
+	}
+	if !isWithin(root, filepath.Join(dir, osTarget)) {
+		return fmt.Errorf("symlink target %q points outside of the root", target)
+	}
+	return nil
+}
+
+// isWithin returns true if path is root or inside root
+func isWithin(root, path string) bool {
+	rel, err := filepath.Rel(filepath.Clean(root), filepath.Clean(path))
+	if err != nil {
+		return false
+	}
+	return !(rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) || filepath.IsAbs(rel))
+}
