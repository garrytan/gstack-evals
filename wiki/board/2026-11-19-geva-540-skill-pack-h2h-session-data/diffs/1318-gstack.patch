+package hugolib
+
+import (
+	"strings"
+	"testing"
+
+	qt "github.com/frankban/quicktest"
+)
+
+func TestSecurityAllowContentHTML(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+SECURITY
+-- content/p1.html --
+---
+title: p1
+---
+<script>alert(1)</script>
+-- content/p2.md --
+---
+title: p2
+---
+Markdown.
+-- layouts/single.html --
+{{ .Content }}
+-- layouts/list.html --
+List.
+`
+
+	b, err := TestE(t, strings.ReplaceAll(files, "SECURITY", ""))
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+
+	b = Test(t, strings.ReplaceAll(files, "SECURITY", "[security]\nallowContent = ['.*']"))
+	b.AssertFileContent("public/p1/index.html", "<script>alert(1)</script>")
+	b.AssertFileContent("public/p2/index.html", "Markdown.")
+}
+
+func TestSecurityAllowContentHTMLContentAdapter(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ["taxonomy", "term", "rss", "sitemap"]
+SECURITY
+-- content/_content.gotmpl --
+{{ $.AddPage (dict "path" "p1" "title" "p1" "content" (dict "mediaType" "text/html" "value" "<script>alert(1)</script>")) }}
+{{ $.AddPage (dict "path" "p2" "title" "p2" "content" (dict "mediaType" "text/markdown" "value" "Markdown.")) }}
+-- layouts/single.html --
+{{ .Content }}
+-- layouts/list.html --
+List.
+`
+
+	b, err := TestE(t, strings.ReplaceAll(files, "SECURITY", ""))
+	b.Assert(err, qt.IsNotNil)
+	b.Assert(err.Error(), qt.Contains, `"text/html" is not whitelisted in policy "security.allowContent"`)
+
+	b = Test(t, strings.ReplaceAll(files, "SECURITY", "[security]\nallowContent = ['.*']"))
+	b.AssertFileContent("public/p1/index.html", "<script>alert(1)</script>")
+	b.AssertFileContent("public/p2/index.html", "Markdown.")
+}
