+        private static bool IsSameOrWithin(string path, string parent)
+        {
+            var fullPath   = TrimmedFullPath(path);
+            var fullParent = TrimmedFullPath(parent);
+            return fullPath.Equals(fullParent, Platform.PathComparison)
+                || fullPath.StartsWith(fullParent + Path.DirectorySeparatorChar,
+                                       Platform.PathComparison);
+        }
+
+        private static string TrimmedFullPath(string path)
+            => Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar,
+                                              Path.AltDirectorySeparatorChar);
+
         // Select only paths within subdir, prune prefixes
         private static IEnumerable<string> SubPaths(string parent, string[] paths)
             => paths.Where(p => p.StartsWith($"{parent}/", Platform.PathComparison))
