+    /// Regression: `old_string` copied from a compressed `ctx_read` view
+    /// (aggressive strips blank lines + comments and halves indentation) must
+    /// still apply, and must not drop the hidden lines or the real indentation.
+    #[test]
+    fn edit_from_aggressive_view_preserves_hidden_lines() {
+        let original = "import os\n\n\ndef foo(x):\n    # compute the thing\n    y = x + 1\n\n    return y\n\n\ndef bar():\n    return foo(2)\n";
+        let view = crate::core::compressor::aggressive_compress(original, Some("py"));
+        assert!(!view.contains(original), "precondition: view is lossy");
+        let old = "def foo(x):\n  y = x + 1\n  return y";
+        assert!(view.contains(old), "precondition: old_string is in the view");
+        let f = make_temp(original);
+        let mut cache = SessionCache::new();
+        let new = "def foo(x):\n  y = x + 2\n  z = y * 3\n  return z";
+        let result = handle(&mut cache, &mk_params(f.path(), old, new, false, false));
+        assert!(result.starts_with('✓'), "edit should apply: {result}");
+        let content = std::fs::read_to_string(f.path()).unwrap();
+        assert_eq!(
+            content,
+            "import os\n\n\ndef foo(x):\n    # compute the thing\n    y = x + 2\n\n    z = y * 3\n    return z\n\n\ndef bar():\n    return foo(2)\n"
+        );
+    }
+
