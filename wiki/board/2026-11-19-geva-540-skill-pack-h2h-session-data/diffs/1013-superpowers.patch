diff --git a/context.go b/context.go
index ec7fdd9..895af2a 100644
--- a/context.go
+++ b/context.go
@@ -165,21 +165,31 @@ func (c *Context) Scheme() string {
 	if c.IsTLS() {
 		return "https"
 	}
-	if scheme := c.request.Header.Get(HeaderXForwardedProto); scheme != "" {
+	if scheme, ok := sanitizeScheme(c.request.Header.Get(HeaderXForwardedProto)); ok {
 		return scheme
 	}
-	if scheme := c.request.Header.Get(HeaderXForwardedProtocol); scheme != "" {
+	if scheme, ok := sanitizeScheme(c.request.Header.Get(HeaderXForwardedProtocol)); ok {
 		return scheme
 	}
 	if ssl := c.request.Header.Get(HeaderXForwardedSsl); ssl == "on" {
 		return "https"
 	}
-	if scheme := c.request.Header.Get(HeaderXUrlScheme); scheme != "" {
+	if scheme, ok := sanitizeScheme(c.request.Header.Get(HeaderXUrlScheme)); ok {
 		return scheme
 	}
 	return "http"
 }
 
+// sanitizeScheme normalizes a scheme value taken from a request header and reports whether it is one of the
+// allowed schemes (http, https, ws, wss). Header values are client controlled and must not be trusted verbatim.
+func sanitizeScheme(scheme string) (string, bool) {
+	switch s := strings.ToLower(strings.TrimSpace(scheme)); s {
+	case "http", "https", "ws", "wss":
+		return s, true
+	}
+	return "", false
+}
