+func TestContext_Scheme_RejectsUntrustedValues(t *testing.T) {
+	tests := []struct {
+		header string
+		value  string
+		expect string
+	}{
+		{HeaderXForwardedProto, "javascript", "http"},
+		{HeaderXForwardedProto, "data", "http"},
+		{HeaderXForwardedProto, "file", "http"},
+		{HeaderXForwardedProto, " HTTPS ", "https"},
+		{HeaderXForwardedProto, "wss", "wss"},
+		{HeaderXForwardedProtocol, "vbscript", "http"},
+		{HeaderXForwardedProtocol, "ws", "ws"},
+		{HeaderXUrlScheme, "gopher", "http"},
+		{HeaderXUrlScheme, "https://evil.com/", "http"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.header+"="+tt.value, func(t *testing.T) {
+			c := &Context{request: &http.Request{Header: http.Header{tt.header: []string{tt.value}}}}
+			assert.Equal(t, tt.expect, c.Scheme())
+		})
+	}
+}
