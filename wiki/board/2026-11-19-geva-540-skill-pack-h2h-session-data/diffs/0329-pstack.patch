+package io.github.hectorvent.floci.services.eventbridge;
+
+import io.quarkus.test.junit.QuarkusTest;
+import io.restassured.RestAssured;
+import io.restassured.config.EncoderConfig;
+import io.restassured.http.ContentType;
+import io.restassured.path.json.JsonPath;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import static io.restassured.RestAssured.given;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.*;
+
+@QuarkusTest
+class EventBridgeIntegrationTest {
+
+    private static final String EVENTS_CONTENT_TYPE = "application/x-amz-json-1.1";
+    private static final String SQS_CONTENT_TYPE = "application/x-amz-json-1.0";
+    private static final String QUEUE_NAME = "eb-resources-queue";
+    private static final String QUEUE_ARN = "arn:aws:sqs:us-east-1:000000000000:" + QUEUE_NAME;
+
+    @BeforeAll
+    static void configureRestAssured() {
+        RestAssured.config = RestAssured.config().encoderConfig(
+            EncoderConfig.encoderConfig()
+                .encodeContentTypeAs(EVENTS_CONTENT_TYPE, ContentType.TEXT)
+                .encodeContentTypeAs(SQS_CONTENT_TYPE, ContentType.TEXT)
+        );
+    }
+
+    @Test
+    void resourcesAreMatchedAndForwardedToSqsTarget() {
+        String queueUrl = given()
+            .contentType(SQS_CONTENT_TYPE)
+            .header("X-Amz-Target", "AmazonSQS.CreateQueue")
+            .body("{\"QueueName\":\"" + QUEUE_NAME + "\"}")
+        .when()
+            .post("/")
+        .then()
+            .statusCode(200)
+            .extract().path("QueueUrl");
+
+        events("PutRule", """
+            {"Name":"eb-resources-rule","EventPattern":"{\\"resources\\":[\\"custom:resource:1\\"]}"}
+            """);
+        events("PutTargets", """
+            {"Rule":"eb-resources-rule","Targets":[{"Id":"q","Arn":"%s"}]}
+            """.formatted(QUEUE_ARN));
+        events("PutEvents", """
+            {"Entries":[
+              {"Source":"my.app","DetailType":"T","Detail":"{\\"n\\":\\"skip\\"}","Resources":["custom:resource:2"]},
+              {"Source":"my.app","DetailType":"T","Detail":"{\\"n\\":\\"keep\\"}","Resources":["custom:resource:1","custom:resource:x"]}
+            ]}
+            """);
+
+        String body = given()
+            .contentType(SQS_CONTENT_TYPE)
+            .header("X-Amz-Target", "AmazonSQS.ReceiveMessage")
+            .body("{\"QueueUrl\":\"" + queueUrl + "\",\"MaxNumberOfMessages\":10}")
+        .when()
+            .post("/")
+        .then()
+            .statusCode(200)
+            .body("Messages", hasSize(1))
+            .extract().path("Messages[0].Body");
+
+        JsonPath event = new JsonPath(body);
+        assertThat(event.getString("detail.n"), equalTo("keep"));
+        assertThat(event.getList("resources"),
+                contains("custom:resource:1", "custom:resource:x"));
+    }
+
+    private static void events(String action, String body) {
+        given()
+            .contentType(EVENTS_CONTENT_TYPE)
+            .header("X-Amz-Target", "AWSEvents." + action)
+            .body(body)
+        .when()
+            .post("/")
+        .then()
+            .statusCode(200);
+    }
+}
