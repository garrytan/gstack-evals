@@ -636,6 +642,34 @@ func (s *Store) resolveWritePath(name string) (string, error) {
 	return path, nil
 }
 
+// ensureNoSymlink walks each component of rel under base and returns
+// ErrPathTraversalDisallowed if any existing component is a symlink.
+// Walking stops at the first non-existent component, since the remaining
+// components will be created as regular directories / files.
+func ensureNoSymlink(base, rel string) error {
+	if rel == "." || rel == "" {
+		return nil
+	}
+	current := base
+	for _, part := range strings.Split(rel, string(filepath.Separator)) {
+		if part == "" || part == "." {
+			continue
+		}
+		current = filepath.Join(current, part)
+		fi, err := os.Lstat(current)
+		if err != nil {
+			if os.IsNotExist(err) {
+				return nil
+			}
+			return err
+		}
+		if fi.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("%s: %w", current, ErrPathTraversalDisallowed)
+		}
+	}
+	return nil
+}
