diff --git a/content/file/file_symlink_test.go b/content/file/file_symlink_test.go
new file mode 100644
index 0000000..8d1ea2f
--- /dev/null
+++ b/content/file/file_symlink_test.go
@@ -0,0 +1,64 @@
+//go:build !windows
+
+package file
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+func TestStore_Push_DisallowSymlinkTraversal(t *testing.T) {
+	root := t.TempDir()
+	workingDir := filepath.Join(root, "work")
+	outside := filepath.Join(root, "outside")
+	if err := os.MkdirAll(workingDir, 0777); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(outside, 0777); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(workingDir, "out")); err != nil {
+		t.Fatal(err)
+	}
+
+	s, err := New(workingDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+
+	content := []byte("pwned")
+	for _, name := range []string{"out/pwn.txt", "out"} {
+		desc := ocispec.Descriptor{
+			MediaType:   "test",
+			Digest:      digest.FromBytes(content),
+			Size:        int64(len(content)),
+			Annotations: map[string]string{ocispec.AnnotationTitle: name},
+		}
+		err = s.Push(context.Background(), desc, bytes.NewReader(content))
+		if !errors.Is(err, ErrPathTraversalDisallowed) {
+			t.Errorf("Push(%q) error = %v, want %v", name, err, ErrPathTraversalDisallowed)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(outside, "pwn.txt")); !os.IsNotExist(err) {
+		t.Fatalf("file written outside working dir: %v", err)
+	}
+
+	// control: normal nested path still works
+	desc := ocispec.Descriptor{
+		MediaType:   "test",
+		Digest:      digest.FromBytes(content),
+		Size:        int64(len(content)),
+		Annotations: map[string]string{ocispec.AnnotationTitle: "in/ok.txt"},
+	}
+	if err := s.Push(context.Background(), desc, bytes.NewReader(content)); err != nil {
+		t.Fatalf("Push() error = %v", err)
+	}
+}
