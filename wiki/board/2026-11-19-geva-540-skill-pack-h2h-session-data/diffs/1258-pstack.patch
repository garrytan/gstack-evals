+// go test -run Test_Proxy_Balancer_Forward_Overrides_Spoofed_X_Real_IP
+func Test_Proxy_Balancer_Forward_Overrides_Spoofed_X_Real_IP(t *testing.T) {
+	t.Parallel()
+
+	app := fiber.New()
+
+	_, addr := createProxyTestServerIPv4(t, func(c fiber.Ctx) error {
+		var values []string
+		for _, v := range c.Request().Header.PeekAll("X-Real-IP") {
+			values = append(values, string(v))
+		}
+		return c.SendString(strings.Join(values, ","))
+	})
+
+	app.Use(BalancerForward([]string{addr}))
+
+	req := httptest.NewRequest(fiber.MethodGet, "/", http.NoBody)
+	req.Header.Set("X-Real-IP", "10.0.0.1")
+	resp, err := app.Test(req)
+	require.NoError(t, err)
+	require.Equal(t, fiber.StatusOK, resp.StatusCode)
+
+	b, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+
+	require.Equal(t, "0.0.0.0", string(b))
+}
