+
+func newIndexDesc(id string) ocispec.Descriptor {
+	return ocispec.Descriptor{
+		Digest:    digest.FromString(id),
+		MediaType: ocispec.MediaTypeImageIndex,
+		Size:      1,
+	}
+}
+
+// TestDispatchDedupesIndexGraph ensures that an index graph where every level
+// references the same child index many times is not expanded exponentially.
+func TestDispatchDedupesIndexGraph(t *testing.T) {
+	const (
+		levels = 8
+		fanout = 10
+	)
+	nodes := make([]ocispec.Descriptor, levels+1)
+	for i := range nodes {
+		nodes[i] = newIndexDesc(fmt.Sprintf("level-%d", i))
+	}
+	nodes[levels] = newDesc("leaf")
+
+	var calls atomic.Int32
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		calls.Add(1)
+		for i := 0; i < levels; i++ {
+			if desc.Digest == nodes[i].Digest {
+				children := make([]ocispec.Descriptor, fanout)
+				for j := range children {
+					children[j] = nodes[i+1]
+				}
+				return children, nil
+			}
+		}
+		return nil, nil
+	})
+
+	require.ErrorIs(t, Dispatch(context.Background(), handler, nil, nodes[0]), errdefs.ErrResourceExhausted,
+		"Dispatch visits every reference so the amplified graph exceeds the reference limit")
+
+	calls.Store(0)
+	require.NoError(t, DispatchUnique(context.Background(), handler, nil, nodes[0]))
+	// Each index is handled once; the leaf is referenced fanout times.
+	assert.Equal(t, int32(levels+fanout), calls.Load())
+}
+
+func TestDispatchDepthLimit(t *testing.T) {
+	var calls atomic.Int32
+	handler := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		n := calls.Add(1)
+		return []ocispec.Descriptor{newIndexDesc(fmt.Sprintf("chain-%d", n))}, nil
+	})
+	for _, dispatch := range []func(context.Context, Handler, *semaphore.Weighted, ...ocispec.Descriptor) error{Dispatch, DispatchUnique} {
+		calls.Store(0)
+		err := dispatch(context.Background(), handler, nil, newIndexDesc("chain-0"))
+		require.ErrorIs(t, err, errdefs.ErrResourceExhausted)
+		assert.Equal(t, int32(maxDepth), calls.Load())
+	}
+
+	// A graph exactly maxDepth levels deep is accepted.
+	exact := HandlerFunc(func(ctx context.Context, desc ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		n := calls.Add(1)
+		if n >= maxDepth {
+			return nil, nil
+		}
+		return []ocispec.Descriptor{newIndexDesc(fmt.Sprintf("exact-%d", n))}, nil
+	})
+	calls.Store(0)
+	require.NoError(t, DispatchUnique(context.Background(), exact, nil, newIndexDesc("exact-0")))
+}
