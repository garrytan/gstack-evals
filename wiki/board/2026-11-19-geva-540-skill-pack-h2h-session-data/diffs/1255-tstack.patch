 		logger.LogRequest(req, http.StatusOK, fs.Verbose, fs.Webhook, body)
 	}
 }
+
+// fsSkipDir is filepath.SkipDir (aliased because the walker shadows filepath)
+var fsSkipDir = filepath.SkipDir
+
+// isBlockedForBulk reports whether path is hidden by the block list of the
+// effective ACL of its parent directory, or is a .goshs ACL file.
+func (fs *FileServer) isBlockedForBulk(path string, isDir bool) bool {
+	name := filepath.Base(path)
+	if !isDir && name == ".goshs" {
+		return true
+	}
+	parentACL, err := fs.findEffectiveACL(filepath.Dir(path))
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+	}
+	if isDir {
+		return slices.Contains(parentACL.Block, name+"/")
+	}
+	return slices.Contains(parentACL.Block, name)
+}
+
+// bulkEntryAllowed reports whether the request may read path inside a bulk
+// download, honoring the effective .goshs ACL (auth and block list).
+func (fs *FileServer) bulkEntryAllowed(req *http.Request, path string, isDir bool) bool {
+	if filepath.Clean(path) != filepath.Clean(fs.Webroot) && fs.isBlockedForBulk(path, isDir) {
+		return false
+	}
+	aclDir := filepath.Dir(path)
+	if isDir {
+		aclDir = path
+	}
+	acl, err := fs.findEffectiveACL(aclDir)
+	if err != nil {
+		logger.Errorf("error reading file based access config: %+v", err)
+		return false
+	}
+	return checkACLCredentials(req, acl)
+}
+
+// checkACLCredentials validates the request's basic auth against acl without
+// writing a response.
+func checkACLCredentials(req *http.Request, acl configFile) bool {
+	if acl.Auth == "" {
+		return true
+	}
+	username, password, ok := req.BasicAuth()
+	if !ok {
+		return false
+	}
+	user, passwordHash, ok := strings.Cut(acl.Auth, ":")
+	if !ok {
+		return false
+	}
+	return username == user && checkPasswordHash(password, passwordHash)
+}
