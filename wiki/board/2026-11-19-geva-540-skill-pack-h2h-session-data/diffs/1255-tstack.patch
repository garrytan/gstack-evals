@@ -0,0 +1,80 @@
+package httpserver
+
+import (
+	"archive/zip"
+	"bytes"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/crypto/bcrypt"
+)
+
+func setupBulkACL(t *testing.T) (*FileServer, func()) {
+	dir := t.TempDir()
+	prot := filepath.Join(dir, "protected")
+	require.NoError(t, os.Mkdir(prot, 0755))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "secret.txt"), []byte("topsecret"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, "blocked.txt"), []byte("blocked"), 0644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "public.txt"), []byte("public"), 0644))
+	hash, err := bcrypt.GenerateFromPassword([]byte("admin"), bcrypt.MinCost)
+	require.NoError(t, err)
+	acl := fmt.Sprintf(`{"auth":"admin:%s","block":["blocked.txt"]}`, string(hash))
+	require.NoError(t, os.WriteFile(filepath.Join(prot, ".goshs"), []byte(acl), 0644))
+	return newTestFileServer(t, dir)
+}
+
+func zipNames(t *testing.T, body []byte) map[string]string {
+	zr, err := zip.NewReader(bytes.NewReader(body), int64(len(body)))
+	require.NoError(t, err)
+	out := map[string]string{}
+	for _, f := range zr.File {
+		rc, err := f.Open()
+		require.NoError(t, err)
+		b, _ := io.ReadAll(rc)
+		rc.Close()
+		out[f.Name] = string(b)
+	}
+	return out
+}
+
+func TestBulkDownload_EnforcesACLAuth(t *testing.T) {
+	fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+
+	for _, q := range []string{"/?bulk&file=/protected/secret.txt", "/?bulk&file=/protected/blocked.txt", "/?bulk&file=/protected"} {
+		w := httptest.NewRecorder()
+		fs.handler(w, httptest.NewRequest(http.MethodGet, q, nil))
+		require.Equal(t, http.StatusUnauthorized, w.Code, q)
+		require.NotContains(t, w.Body.String(), "topsecret")
+	}
+}
+
+func TestBulkDownload_ACLAuthorizedHonorsBlock(t *testing.T) {
+	fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+
+	r := httptest.NewRequest(http.MethodGet, "/?bulk&file=/protected&file=/protected/blocked.txt", nil)
+	r.SetBasicAuth("admin", "admin")
+	w := httptest.NewRecorder()
+	fs.handler(w, r)
+	require.Equal(t, http.StatusOK, w.Code)
+	files := zipNames(t, w.Body.Bytes())
+	require.Equal(t, map[string]string{"protected/secret.txt": "topsecret"}, files)
+}
+
+func TestBulkDownload_RecursiveSkipsProtectedSubdir(t *testing.T) {
+	fs, cleanup := setupBulkACL(t)
+	defer cleanup()
+
+	w := httptest.NewRecorder()
+	fs.handler(w, httptest.NewRequest(http.MethodGet, "/?bulk&file=/", nil))
+	require.Equal(t, http.StatusOK, w.Code)
+	files := zipNames(t, w.Body.Bytes())
+	require.Equal(t, map[string]string{"public.txt": "public"}, files)
+}
