{
  "schema_version": 1,
  "id": "stacks-r1",
  "title": "GSTA-167 no-loss cohort: 29 review blockers on 14 gstack PRs, plus catalog cases from lanes/review-replay/catalog/public",
  "kind": "noloss",
  "development_only": true,
  "purpose": "Development suite for review variants: does a variant keep the blockers gstack's old /ship review caught on 14 public gstack PRs, replayed at each PR's pass-1 head? Every arm GSTA-167 ran was judged on it in the open, so it ranks variants and catches large losses, but a release claim needs a cohort frozen before the variant is built and a reference run in the same window. Catalog cases add one unit and one blocker each; deserved CRITICAL counts toward blocking recall, INFORMATIONAL toward over-blocking, unsettled toward detection only.",
  "sealed": false,
  "catalogs": [
    "lanes/review-replay/catalog/noloss",
    "lanes/review-replay/catalog/public"
  ],
  "sources": [
