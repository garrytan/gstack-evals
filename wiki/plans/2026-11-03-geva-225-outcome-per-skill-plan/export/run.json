      "new_plan_sha256": "182918be9f1bcd9747d22786f117fe16426dd7960238e4acfa6e7fe58e8ab244"
    },
    {
      "decision": "autoplan-20261103023817-r2-d6",
      "title": "High: autoplan's told arm names no kind, voice count or gate setting; the before pin predates R66's kinds and the 5.0x price assumes the full panel [autoplan-20261103023817-ceo-r2-native-5]",
      "chosen": "a",
      "text": "apply the fix to the plan: Freeze autoplan's told invocation in O1: the kind (crews now run --kind feature on features), the phases scope chooses, the outside voice and its model, the gate answer, and the exact slash line per pin. Meter that configuration on admission sessions before autoplan's place, size and MDD in the wave-1 table are fixed, align the four-way stand-in with it, and name the configuration in every autoplan verdict. If the after pin's default kind differs, the prereg says which one it tests and why.",
      "gate_rev": 2,
      "status": "incorporated",
      "at": "2026-11-03T16:05:59.492Z",
      "item": "d6",
      "phase": "ceo",
      "plan_sha256": "9ff6fb7a6baa6820279f73c74f80c30c892348350cbf98578f0a20111e71b283",
