  "guards": [
    {
      "id": "rig-docker-tier",
      "when": [
        "src/trial/**",
        "src/adapters/**",
        "src/runner/**",
        "src/rig/**",
        "lanes/**",
        "schema/**",
        "docker/**",
        "bun.lock",
        "package.json",
        "gate/manifest.json",
        "tests/trial/**",
        "tests/adapters/**",
        "tests/proxy/**",
        "tests/rig/**",
        ".github/workflows/rig.yml"
      ],
      "command": "GSTACK_EVALS_DOCKER=1 bun test tests/rig",
      "fix": "run GSTACK_EVALS_DOCKER=1 bun test tests/rig on a machine with Docker and fix what fails (docs/rig.md)",
      "timeout_s": 1800
    }
  ],
  "strays": {
    "allow": [
      "lanes",
      "policy",
      "tables",
      "tasks",
      "coverage",
      "spikes",
      "docker"
    ]
  },
  "run_profiles": {
    "ci-carry/checks": {
      "workflow": "ci.yml",
      "events": [
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": [
        "checks"
      ],
      "artifact": "tested-tree",
      "os": "Linux"
    }
  },
  "ship_lanes_from": {
    "bun test": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "git ls-tree -r --name-only HEAD | grep -Ei '(^|/)[^/]+[._](test|spec)\\.([cm]?[jt]s|[jt]sx)$' | grep -Ev '(^|/)(\\.[^/]*|node_modules)/'"
    },
    "bun run typecheck": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "echo 'check:bun run typecheck'"
    },
    "bun run errors:check": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "echo 'check:bun run errors:check'"
    },
    "bun run wiki:check": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "echo 'check:bun run wiki:check'"
    }
  },
  "sealed": {
    "paths": [
      "**/heldout*/**",
      "**/Heldout*/**",
      "**/HeldOut*/**",
      "**/HELDOUT*/**",
      "**/held-out*/**",
      "**/Held-out*/**",
      "**/Held-Out*/**",
      "**/HELD-OUT*/**",
      "**/held_out*/**",
      "**/hold-out*/**",
      "**/holdout*/**",
      "**/Holdout*/**",
      "**/HoldOut*/**",
      "**/HOLDOUT*/**",
      "**/sealed*/**",
      "**/Sealed*/**",
      "**/SEALED*/**",
      "**/protected*/**",
      "**/Protected*/**",
      "**/PROTECTED*/**",
      "**/*.sealed",
      "**/*.sealed.*",
      "**/*.Sealed",
      "**/*.Sealed.*",
      "**/*.SEALED",
      "**/*.SEALED.*"
    ],
    "transcripts": [
      "**/runs/**"
    ],
    "answer_markers": [
      "\\bSEALED(?: [A-Z]+)+:",
      "\\bSEALED[:](?! (?:(?:clear|refused|warned|error|no-policy) findings=\\d+ commits=\\d+(?: |$)|(?:clear|refused|error)$|not checked \\(exit (?:\\d+|null)\\)$))",
      "\\bSEALED[:] (?:clear|refused|warned|error|no-policy) findings=\\d+ commits=\\d+ (?!(?:skipped=\\d+ )?visibility=(?:public|private|unknown \\(counted public\\)) waived=\\d+(?: exempt=\\d+)?(?: unchecked=\\d+)? policy=)",
      "\\bSEALED[:] \\S+ findings=\\d+ commits=\\d+ (?:[a-z]+=\\w+ (?:\\(counted public\\) )?)*policy=(?!(?:[\\w.-]+/[\\w./-]+(?: \\+ (?:commit|pushed) [\\da-f]{12})?|(?:commit|pushed) [\\da-f]{12}|no sealed key on [\\w./-]+ or [\\w./-]+)$)"
    ],
    "seed_patterns": [
      "\\b(?:sealed|holdout|rotation)_seed\\s*[=:]\\s*[\"']?[0-9A-Za-z]{4,}"
    ],
    "local_paths": true,
    "visibility": "public"
  }
}
