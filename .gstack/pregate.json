{
  "$schema": "https://github.com/garrytan/gstack/docs/pregate.md#pregate-v1",
  "runner": "bun test {files}",
  "allowlist": [
    {
      "finding": "env.kv",
      "paths": [
        "quick/laneb/runner/agent/laneb_agent.py"
      ],
      "pattern": "\\(str\\(path\\), st\\.st_size, st\\.st_mtime_ns\\)\\s*$",
      "reason": "a file-digest cache key tuple in sha256_file, not a credential"
    }
  ],
  "dependencies": {
    "bin/gstack-evals": [
      "tests/cli.test.ts"
    ],
    "VERSION": [
      "tests/cli.test.ts"
    ],
    "docs/errors.md": [
      "tests/errors.test.ts"
    ],
    "lanes/review-noloss/arm.schema.json": [
      "tests/noloss/contract.test.ts"
    ],
    "lanes/review-noloss/suites/**": [
      "tests/noloss/catalog.test.ts"
    ],
    "lanes/outcome-skills/**": [
      "tests/outcome-skills/autoplan.test.ts",
      "tests/outcome-skills/clean-room.test.ts",
      "tests/outcome-skills/exposure.test.ts",
      "tests/outcome-skills/registry.test.ts",
      "tests/outcome-skills/told.test.ts"
    ],
    "tests/outcome-skills/fixtures/**": [
      "tests/outcome-skills/exposure.test.ts"
    ],
    "lanes/real-outcome/**": [
      "tests/real-outcome/agent-units.test.ts",
      "tests/real-outcome/agent.test.ts",
      "tests/real-outcome/arms.test.ts",
      "tests/real-outcome/sandbox.test.ts"
    ],
    "lanes/outcome-skills/mutation/**": [
      "tests/outcome-skills/mutation-docker.test.ts",
      "tests/outcome-skills/mutation.test.ts"
    ],
    "tests/real-outcome/*.py": [
      "tests/real-outcome/agent-units.test.ts",
      "tests/real-outcome/agent.test.ts"
    ],
    "tests/real-outcome/fixtures/**": [
      "tests/real-outcome/agent.test.ts"
    ],
    "tests/stats/fixtures/**": [
      "tests/stats/outcome-decision.test.ts"
    ],
    "src/errors/codes.ts": [
      "tests/errors.test.ts"
    ],
    "src/runner/proxy/**": [
      "tests/proxy/metering-proxy.test.ts"
    ],
    "src/runner/pricing/**": [
      "tests/proxy/metering-proxy.test.ts"
    ],
    ".gstack/pregate.json": [
      "tests/wiki.test.ts",
      "tests/sealed.test.ts",
      "tests/ci/ci-tree.test.ts"
    ],
    ".gstack/sealed-allow.tsv": [
      "tests/sealed.test.ts"
    ],
    "wiki/**": [
      "tests/wiki.test.ts"
    ],
    ".github/workflows/**": [
      "tests/ci/ci-tree.test.ts"
    ],
    "package.json": [],
    "bun.lock": [],
    "tsconfig.json": [],
    "src/**/.gitkeep": [],
    "quick/replay/**": [
      "quick/replay/replay.test.ts"
    ],
    "docs/benchmarks/2026-11-parity-sd-estimate/**": [
      "tests/parity-sd-estimate.test.ts"
    ],
    "docs/benchmarks/2026-11-lanea-shakedown/**": [
      "tests/lanea-shakedown-tasks.test.ts"
    ],
    "quick/laneb/**": [
      "quick/laneb/tests/agent.test.ts",
      "quick/laneb/tests/analysis-load.test.ts",
      "quick/laneb/tests/analysis.test.ts",
      "quick/laneb/tests/grid.test.ts",
      "quick/laneb/tests/launch.test.ts",
      "quick/laneb/tests/ledger-serve.test.ts",
      "quick/laneb/tests/placebo.test.ts",
      "quick/laneb/tests/proxy-accounting.test.ts",
      "quick/laneb/tests/proxy-paths.test.ts",
      "quick/laneb/tests/proxy-states.test.ts",
      "quick/laneb/tests/r3.test.ts",
      "quick/laneb/tests/runner.test.ts",
      "quick/laneb/tests/stacks.test.ts",
      "quick/laneb/tests/vm-run.test.ts"
    ],
    "quick/lanea-quick/**": [
      "quick/lanea-quick/test/grade.test.ts",
      "quick/lanea-quick/test/ledger-usage.test.ts",
      "quick/lanea-quick/test/plan.test.ts",
      "quick/lanea-quick/test/proxy.test.ts",
      "quick/lanea-quick/test/runrules.test.ts",
      "quick/lanea-quick/test/usersim.test.ts"
    ],
    "docker/**": [
      "tests/trial/recipe.test.ts",
      "tests/trial/image.test.ts",
      "tests/cli/doctor.test.ts"
    ],
    "tests/trial/review/fixtures/**": [
      "tests/trial/review/findings.test.ts",
      "tests/trial/review/run.test.ts"
    ],
    "tests/trial/fixtures/**": [
      "tests/trial/grader.test.ts"
    ]
  },
  "guards": [
    {
      "id": "rig-docker-tier",
      "when": [
        "src/trial/**",
        "src/adapters/**",
        "src/runner/**",
        "src/rig/**",
        "lanes/**",
        "schema/**",
        "docker/**",
        "bun.lock",
        "package.json",
        "gate/manifest.json",
        "tests/trial/**",
        "tests/adapters/**",
        "tests/proxy/**",
        "tests/rig/**",
        ".github/workflows/rig.yml"
      ],
      "command": "GSTACK_EVALS_DOCKER=1 bun test tests/rig",
      "fix": "run GSTACK_EVALS_DOCKER=1 bun test tests/rig on a machine with Docker and fix what fails (docs/rig.md)",
      "timeout_s": 1800
    }
  ],
  "strays": {
    "allow": [
      "lanes",
      "policy",
      "tables",
      "tasks",
      "coverage",
      "spikes",
      "docker"
    ]
  },
  "run_profiles": {
    "ci-carry/checks": {
      "workflow": "ci.yml",
      "events": [
        "pull_request",
        "workflow_dispatch"
      ],
      "jobs": [
        "checks"
      ],
      "artifact": "tested-tree",
      "os": "Linux"
    }
  },
  "ship_lanes_from": {
    "bun test": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "git ls-tree -r --name-only HEAD | grep -Ei '(^|/)[^/]+[._](test|spec)\\.([cm]?[jt]s|[jt]sx)$' | grep -Ev '(^|/)(\\.[^/]*|node_modules)/'"
    },
    "bun run typecheck": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "echo 'check:bun run typecheck'"
    },
    "bun run errors:check": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "echo 'check:bun run errors:check'"
    },
    "bun run wiki:check": {
      "profiles": [
        "ci-carry/checks"
      ],
      "inventory": "echo 'check:bun run wiki:check'"
    }
  },
  "sealed": {
    "paths": [
      "**/heldout*/**",
      "**/Heldout*/**",
      "**/HeldOut*/**",
      "**/HELDOUT*/**",
      "**/held-out*/**",
      "**/Held-out*/**",
      "**/Held-Out*/**",
      "**/HELD-OUT*/**",
      "**/held_out*/**",
      "**/hold-out*/**",
      "**/holdout*/**",
      "**/Holdout*/**",
      "**/HoldOut*/**",
      "**/HOLDOUT*/**",
      "**/sealed*/**",
      "**/Sealed*/**",
      "**/SEALED*/**",
      "**/protected*/**",
      "**/Protected*/**",
      "**/PROTECTED*/**",
      "**/*.sealed",
      "**/*.sealed.*",
      "**/*.Sealed",
      "**/*.Sealed.*",
      "**/*.SEALED",
      "**/*.SEALED.*"
    ],
    "transcripts": [
      "**/runs/**"
    ],
    "answer_markers": [
      "\\bSEALED(?: [A-Z]+)+:",
      "\\bSEALED[:](?! (?:(?:clear|refused|warned|error|no-policy) findings=\\d+ commits=\\d+(?: |$)|(?:clear|refused|error)$|not checked \\(exit (?:\\d+|null)\\)$))",
      "\\bSEALED[:] (?:clear|refused|warned|error|no-policy) findings=\\d+ commits=\\d+ (?!(?:skipped=\\d+ )?visibility=(?:public|private|unknown \\(counted public\\)) waived=\\d+(?: exempt=\\d+)?(?: unchecked=\\d+)? policy=)",
      "\\bSEALED[:] \\S+ findings=\\d+ commits=\\d+ (?:[a-z]+=\\w+ (?:\\(counted public\\) )?)*policy=(?!(?:[\\w.-]+/[\\w./-]+(?: \\+ (?:commit|pushed) [\\da-f]{12})?|(?:commit|pushed) [\\da-f]{12}|no sealed key on [\\w./-]+ or [\\w./-]+)$)"
    ],
    "seed_patterns": [
      "\\b(?:sealed|holdout|rotation)_seed\\s*[=:]\\s*[\"']?[0-9A-Za-z]{4,}"
    ],
    "local_paths": true,
    "visibility": "public"
  }
}
