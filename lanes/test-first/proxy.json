{
  "routes": {
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "key_env": "ANTHROPIC_API_KEY",
      "auth": "x-api-key",
      "count_tokens": "forward"
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api",
      "key_env": "OPENROUTER_API_KEY",
      "auth": "bearer",
      "count_tokens": "estimate"
    },
    "openai": {
      "base_url": "https://api.openai.com",
      "key_env": "OPENAI_API_KEY",
      "auth": "bearer",
      "count_tokens": "estimate"
    }
  },
  "models": {
    "claude-opus-5-5": {
      "route": "anthropic",
      "upstream_model": "claude-opus-5-5",
      "price_per_mtok": {
        "input": 4,
        "output": 20,
        "cache_write_5m": 5,
        "cache_write_1h": 8,
        "cache_read": 0.2
      }
    },
    "particle-1": {
      "route": "openrouter",
      "upstream_model": "particle-ai/particle-1",
      "price_per_mtok": {
        "input": 0.25,
        "output": 1,
        "cache_write_5m": 0.25,
        "cache_write_1h": 0.25,
        "cache_read": 0.03
      },
      "body_overrides": {
        "provider": {
          "only": [
            "particle-ai"
          ],
          "allow_fallbacks": false
        }
      }
    },
    "gpt-6.2-sol": {
      "route": "openai",
      "upstream_model": "gpt-6.2-sol",
      "bound_bytes_per_token": 3,
      "output_cap_tokens": 32000,
      "price_per_mtok": {
        "input": 2,
        "output": 10,
        "cache_write_5m": 2.5,
        "cache_write_1h": 2.5,
        "cache_read": 0.1
      },
      "long_prompt": {
        "over_tokens": 272000,
        "price_per_mtok": {
          "input": 4,
          "output": 15,
          "cache_write_5m": 5,
          "cache_write_1h": 5,
          "cache_read": 0.2
        }
      }
    }
  }
}
