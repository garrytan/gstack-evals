# Harness mechanics D1 (pre-data amendment) and D7 (found in Stage 1). prepare-run.ts appends these lines after Lane B's
# runtime-copy.Dockerfile in every arm's task image, none and plain-2 included, when L1's profile names this file
# (TASK_SETUP). Both testbed env prefixes go first on PATH (D2: on miniconda and /opt/conda images the env's python3 and
# pytest come before the base env's). WORKDIR /testbed comes before the RUN: some task images set no WORKDIR, and it also
# makes /testbed the directory Claude Code, the snapshot strip and CHECKS_TRUST start in. The RUN first strips history
# past the base commit (D7): 12 of Stage 1's 40 task images held the upstream fix, hidden tests included, behind tags. It
# refuses a tree that borrows objects (alternates), or holds a nested .git or a submodule git directory that is not a
# submodule checked out at the commit the base pins for it or past it. A submodule shipped past its pin is checked out
# at the pin (py-pdf__pdfly-219's). Then, in the tree and in each submodule against its pinned commit, it deletes
# every ref whose commit is not the base or an ancestor (replace refs always), FETCH_HEAD, ORIG_HEAD and the other
# pseudo refs, linked worktrees and .keep marks, expires the reflogs, prunes with gc, and refuses the build if any ref
# or commit past the base is left. Then a local bare origin gets main at the base commit (D1), so
# gstack-checks finds a pregate context. The verifier is built from the pristine image, so grading is untouched. The
# task-fit screen, the fit probe, the dry run and the build check read this file; nothing copies it. HM_ORIGIN is unset
# in every build; keyless tests set it.
ENV PATH=/opt/miniconda3/envs/testbed/bin:/opt/conda/envs/testbed/bin:$PATH
WORKDIR /testbed
RUN export GIT_NO_REPLACE_OBJECTS=1; d7() { echo "fatal: D7 history refused: $1" >&2; exit 1; }; alt() { { [ ! -s "$1/objects/info/alternates" ] && [ ! -s "$1/objects/info/http-alternates" ]; } || d7 "$2 borrows objects through an alternates file"; }; s7() { g=$1; b=$2; git --git-dir="$g" for-each-ref --format='%(refname)' > "$g/hm-d7-refs" || d7 "could not read the refs of $3"; while read -r r; do case "$r" in refs/replace/*) git --git-dir="$g" update-ref --no-deref -d "$r" ;; *) { c=$(git --git-dir="$g" rev-parse -q --verify "$r^{commit}") && git --git-dir="$g" merge-base --is-ancestor "$c" "$b"; } || git --git-dir="$g" update-ref --no-deref -d "$r" ;; esac || d7 "could not delete $r in $3"; done < "$g/hm-d7-refs"; rm -rf "$g/hm-d7-refs" "$g/worktrees" "$g/FETCH_HEAD" "$g/ORIG_HEAD" "$g/MERGE_HEAD" "$g/CHERRY_PICK_HEAD" "$g/REVERT_HEAD" "$g/BISECT_HEAD" "$g/AUTO_MERGE" "$g"/objects/pack/*.keep; { git --git-dir="$g" reflog expire --expire=now --all && git --git-dir="$g" -c gc.cruftPacks=false gc --prune=now --quiet; } || d7 "could not prune $3"; L=$(git --git-dir="$g" for-each-ref --format='%(refname)' | while read -r r; do { c=$(git --git-dir="$g" rev-parse -q --verify "$r^{commit}") && git --git-dir="$g" merge-base --is-ancestor "$c" "$b"; } || echo "$r"; done); [ -z "$L" ] || d7 "refs past the base remain in $3: $L"; git --git-dir="$g" rev-list "$b" | LC_ALL=C sort > "$g/hm-d7-base"; n=$(git --git-dir="$g" cat-file --batch-all-objects --batch-check='%(objecttype) %(objectname)' | sed -n 's/^commit //p' | LC_ALL=C sort | LC_ALL=C comm -23 - "$g/hm-d7-base" | wc -l); rm -f "$g/hm-d7-base"; [ "$n" -eq 0 ] || d7 "$n commits in $3 are not the base or its ancestors"; }; { B=$(git rev-parse -q --verify 'HEAD^{commit}') && G=$(git rev-parse --absolute-git-dir); } || d7 "the tree has no base commit"; alt "$G" "the tree"; git ls-tree -r HEAD | awk '$2 == "commit"' > "$G/hm-d7-subs" || d7 "could not read the base tree"; : > "$G/hm-d7-ok"; : > "$G/hm-d7-paths"; : > "$G/hm-d7-dirs"; while read -r m t s p; do [ -e "$p/.git" ] || continue; S=$(git -C "$p" rev-parse --absolute-git-dir) || d7 "the submodule at $p has no git directory"; h=$(git -C "$p" rev-parse -q --verify 'HEAD^{commit}'); [ "$h" = "$s" ] || { git -C "$p" merge-base --is-ancestor "$s" "$h" 2>/dev/null || d7 "the submodule at $p is neither at the commit the base pins nor past it"; [ -z "$(git -C "$p" status --porcelain --untracked-files=no)" ] || d7 "the submodule at $p has local changes past the commit the base pins"; }; [ -z "$(git -C "$p" ls-tree -r HEAD | awk '$2 == "commit"')" ] || d7 "the submodule at $p holds a submodule"; alt "$S" "the submodule at $p"; echo "$s $p" >> "$G/hm-d7-ok"; echo "$p" >> "$G/hm-d7-paths"; echo "$S" >> "$G/hm-d7-dirs"; done < "$G/hm-d7-subs"; find . -path ./.git -prune -o -name .git -print > "$G/hm-d7-nested"; while read -r d; do q=${d#./}; grep -qxF "${q%/.git}" "$G/hm-d7-paths" || d7 "the tree holds a nested .git that is not a submodule the base pins"; done < "$G/hm-d7-nested"; if [ -d "$G/modules" ]; then find "$G/modules" -type f -name HEAD > "$G/hm-d7-heads"; while read -r h; do d=${h%/HEAD}; [ -d "$d/objects" ] || continue; grep -qxF "$d" "$G/hm-d7-dirs" || d7 "the tree holds a submodule git directory the base does not check out"; done < "$G/hm-d7-heads"; fi; s7 "$G" "$B" "the tree"; while read -r s p <&3; do [ "$(git -C "$p" rev-parse -q --verify 'HEAD^{commit}')" = "$s" ] || git -C "$p" checkout -q --detach "$s" || d7 "could not check out the submodule at $p at the commit the base pins"; s7 "$(git -C "$p" rev-parse --absolute-git-dir)" "$s" "the submodule at $p"; done 3< "$G/hm-d7-ok"; rm -f "$G/hm-d7-subs" "$G/hm-d7-ok" "$G/hm-d7-paths" "$G/hm-d7-dirs" "$G/hm-d7-nested" "$G/hm-d7-heads"; O="${HM_ORIGIN:-/opt/hm-origin.git}"; if git remote get-url origin >/dev/null 2>&1; then echo "D1 origin refused: the task tree has an origin remote already" >&2; exit 1; fi && git init -q --bare "$O" && git push -q "$O" HEAD:refs/heads/main && git remote add origin "$O" && git fetch -q origin && git remote set-head origin main
