{
  "routes": {
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "key_env": "ANTHROPIC_API_KEY",
      "auth": "x-api-key",
      "count_tokens": "forward"
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api",
      "key_env": "OPENROUTER_API_KEY",
      "auth": "bearer",
      "count_tokens": "estimate"
    }
  },
  "models": {
    "claude-opus-5-5": {
      "route": "anthropic",
      "upstream_model": "claude-opus-5-5",
      "price_per_mtok": {
        "input": 4,
        "output": 20,
        "cache_write_5m": 5,
        "cache_write_1h": 8,
        "cache_read": 0.2
      }
    },
    "claude-haiku-5-5": {
      "route": "anthropic",
      "upstream_model": "claude-haiku-5-5",
      "price_per_mtok": {
        "input": 0.1,
        "output": 0.5,
        "cache_write_5m": 0.125,
        "cache_write_1h": 0.2,
        "cache_read": 0.01
      },
      "long_prompt": {
        "over_tokens": 100000,
        "price_per_mtok": {
          "input": 0.5,
          "output": 2.5,
          "cache_write_5m": 0.625,
          "cache_write_1h": 1,
          "cache_read": 0.05
        }
      }
    },
    "deepseek-v4.1-flash-1017": {
      "route": "openrouter",
      "upstream_model": "deepseek/deepseek-v4.1-flash-1017",
      "price_per_mtok": {
        "input": 0.3,
        "output": 1.2,
        "cache_write_5m": 0.3,
        "cache_write_1h": 0.3,
        "cache_read": 0.006
      },
      "body_overrides": {
        "provider": {
          "only": [
            "deepseek"
          ],
          "allow_fallbacks": false
        }
      }
    },
    "claude-sonnet-5-5": {
      "route": "anthropic",
      "upstream_model": "claude-sonnet-5-5",
      "price_per_mtok": {
        "input": 2,
        "output": 10,
        "cache_write_5m": 2.5,
        "cache_write_1h": 4,
        "cache_read": 0.1
      }
    },
    "particle-1": {
      "route": "openrouter",
      "upstream_model": "particle-ai/particle-1",
      "price_per_mtok": {
        "input": 0.25,
        "output": 1,
        "cache_write_5m": 0.25,
        "cache_write_1h": 0.25,
        "cache_read": 0.03
      },
      "body_overrides": {
        "provider": {
          "only": [
            "particle-ai"
          ],
          "allow_fallbacks": false
        }
      }
    }
  }
}
